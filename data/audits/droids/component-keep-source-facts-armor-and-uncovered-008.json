  "findings": [
    {
      "id": "K008-FACTOR",
      "severity": "CRITICAL",
      "scope": "All 13 armor items",
      "finding": "Printed base armor numerics align with raw code but published size factors differ from current shared Garage helper in seven of nine sizes; no actual quote/carry-weight certification."
    },
    {
      "id": "K008-STACK",
      "severity": "HIGH",
      "scope": "Built-in and worn armor",
      "finding": "Built-in armor Reflex bonus does not stack with worn armor Reflex bonus."
    },
    {
      "id": "K008-ACP",
      "severity": "HIGH",
      "scope": "Built-in armor",
      "finding": "Nonproficient built-in armor ACP affects attack rolls AND Acrobatics, Climb, Endurance, Initiative, Jump, Stealth, Swim. Relevant Armor Proficiency negates."
    },
    {
      "id": "K008-SPEED",
      "severity": "HIGH",
      "scope": "Built-in armor",
      "finding": "Built-in armor does not reduce normal movement speed; heavy armor limits run to 3x."
    },
    {
      "id": "K008-BLASTER",
      "severity": "HIGH",
      "scope": "Crystadurium",
      "finding": "Reduce blaster damage by one point per die, NOT generic DR."
    },
    {
      "id": "K008-HEAT",
      "severity": "HIGH",
      "scope": "Duravlex",
      "finding": "+10 equipment Fortitude only for fire and extreme heat."
    },
    {
      "id": "K008-STATIONARY",
      "severity": "MEDIUM",
      "scope": "Stationary",
      "finding": "No locomotion system; 0-price raw state is not proof of free purchasable part."
    },
    {
      "id": "K008-CONCEAL-PRICE",
      "severity": "BLOCKER",
      "scope": "Concealed Item",
      "finding": "Selected item and host must inform composite cost; printed x2 grouping/GM variation unresolved, do not invent price."
    },
    {
      "id": "K008-CONCEAL-EFFECT",
      "severity": "MEDIUM",
      "scope": "Concealed Item",
      "finding": "Conditionally +5 Stealth for partially exposed weapon, size modifier, +10 Deception; fully hidden not visible; swift deployment."
    },
    {
      "id": "K008-SELFDESTRUCT",
      "severity": "HIGH",
      "scope": "Self-Destruct System",
      "finding": "Published cost max explosion damage x20 credits / x0.1 kg; overlay only gives no price/weight and default zero is unsafe."
    }
  ],
