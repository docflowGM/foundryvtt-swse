    "searchLayer": "Threats of the Galaxy_djvu.txt",
    "visualAuthority": "SAGA EDITION - Threats of the Galaxy.pdf",
    "repoRole": "comparison-only",
    "ammoRule": "Ammunition type and capacity are certified primarily from weapon descriptions and explicit ammo stat blocks, not from table omission or repo defaults."
  },
  "schemaDelta": {
    "contractVersion": "weapon-authority-schema-v2.9-ammo-payload-separation",
    "schemaDecision": "SCHEMA_BUMP_REQUIRED",
    "principle": "Threats closes the weapon pass by making ammunition and shot capacity first-class ranged-weapon authority and by separating delivery-system attack mechanics from loaded-munition payload mechanics.",
    "requiredEdits": [
      {
        "id": "first-class-ammo",
        "path": "canonicalStats.ammo",
        "change": "Add ranged-weapon ammo authority with type, capacityShots, consumption/reload facts, and source-status. Pure melee weapons use ammo:null; hybrid weapons may carry ammo only for explicit ranged firing profiles.",
        "requiredBy": [
          "Light Concussion Missile Launcher",
          "all prior ranged weapons during v2.9 normalization"
        ]
      },
      {
        "id": "delivery-system-vs-payload",
        "path": "canonicalStats.ammo.damageSource / payloadDerived / acceptedPayloadFamily",
        "change": "Separate launcher attack mechanics from damage/effects supplied by loaded ammunition. Launchers must not persist payload damage as intrinsic launcher base damage unless the source says the launcher itself supplies or modifies that damage.",
        "requiredBy": [
          "Light Concussion Missile Launcher",
          "Core Grenade Launcher",
          "Clone Wars Wrist Rocket Launcher",
          "Scum and Villainy Micro Grenade Launcher and Electronet relationships"
        ]
      },
      {
        "id": "payload-multiplier",
        "path": "canonicalStats.payloadProfiles[].damageMultiplier",
        "change": "Permit payload profiles to carry a post-dice numeric multiplier, parallel to attackProfiles[].damageMultiplier.",
        "requiredBy": [
          "Light Concussion Missile 4d10x2"
        ]
      }
    ],
    "backwardNormalization": "Add canonicalStats.ammo to all 209 Phase 2 source claims using certified description/resource facts. Do not infer ammunition or capacity merely from a weapon family. Preserve existing resource/resourceProfiles during transition; ammo becomes the first-class ranged ammunition view.",
    "runtimeBoundary": "Canonical authority stores accepted ammunition family/type and published capacity. Actor-owned weapon instances later store currentShots and loadedAmmoRef/current payload; those are mutable runtime state, not source authority."
  },
  "counts": {
    "canonicalWeaponClaims": 4,
    "repoPresent": 3,
    "repoMissing": 1,
    "meleeClaims": 2,
    "rangedClaims": 2,
    "deliverySystemClaims": 1,
    "nativeStunClaims": 1
  },
  "verification": {
    "Datadagger": "p.13 visually verified",
    "Light Concussion Missile Launcher": "p.134 visually verified",
    "Sonic Stunner": "p.146 visually verified",
    "Sith Sword": "p.159 visually verified",
    "hardReconciliation": "2 melee + 2 ranged = 4",
    "repoReconciliation": "3 present + 1 missing = 4"
  },
  "bookLocalGuardrails": [
    "Do not update a rolling/master weapon authority from this package.",
    "Do not mutate production packs, runtime/template schema, actors, feats, talents, or equipment records during certification.",
    "Do not create Datadagger during this phase.",
    "Repo fields are comparison evidence only.",
    "Do not treat Light Concussion Missile Launcher 4d10x2 as intrinsic launcher damage; the Light Concussion Missile owns the payload damage.",
    "Do not invent launcher loaded capacity; Threats only states one missile is fired per attack.",
    "Do not flatten Sonic Stunner native 3d6 stun into lethal base damage.",
    "Do not infer Sonic Stunner ammo type or capacity; this entry does not publish them.",
    "Do not preserve repo Sith Sword 2d8/6000/kinetic/Critical 19-20 against the published Threats entry.",
    "Lightwhip is already certified under Jedi Academy and is not a new Threats identity here.",
    "Saberdart Launcher appears as NPC possession without an independent published weapon entry and remains excluded from the character-scale weapon census."
  ],
