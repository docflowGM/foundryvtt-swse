  "findings": [
    {
      "id": "6B-001",
      "severity": "CRITICAL",
      "kind": "PROGRESSION_WRONG_CHOICE",
      "classes": [
        "Officer"
      ],
      "source": "Core p.221, Table 12-11",
      "evidence": "Published Officer progression grants Share Talent at levels 2,4,6,8,10 and Command Cover once at level 2; repository instead adds normal talent_choice at even levels and repeated Command Cover +1..+5, without Share Talent.",
      "recommendation": "Model five typed share-talent selections and one Command Cover grant; preserve normal talent choices only at odd levels."
    },
    {
      "id": "6B-002",
      "severity": "HIGH",
      "kind": "MISSING_ENTRY_REQUIREMENT",
      "classes": [
        "Jedi Knight"
      ],
      "source": "Core p.218, Requirements",
      "evidence": "Printed special prerequisite requires having built one's own lightsaber; data/prestige-class-prerequisites.json omits it.",
      "recommendation": "Add a verifiable construction requirement or explicit GM adjudication gate; avoid assuming merely owning a lightsaber is sufficient."
    },
    {
      "id": "6B-003",
      "severity": "HIGH",
      "kind": "MISSING_ENTRY_REQUIREMENT",
      "classes": [
        "Independent Droid"
      ],
      "source": "TFU p.47, Requirements",
      "evidence": "Printed Special: Droids only; prerequisite JSON includes heuristic processor and Use Computer but not droid-only.",
      "recommendation": "Add typed droid-only requirement; test organic actor denied."
    },
    {
      "id": "6B-004",
      "severity": "HIGH",
      "kind": "INCOMPLETE_ENTRY_REQUIREMENT",
      "classes": [
        "Martial Arts Master"
      ],
      "source": "Galaxy at War p.32, Requirements",
      "evidence": "Printed feats require Martial Arts I, Martial Arts II, Melee Defense, and at least one from an enumerated list of martial arts style feats. JSON lacks a structured OR list and only says '1 Martial Arts Feat' in prose.",
      "recommendation": "Encode all published style feats in a typed OR group and verify Martial Arts I/II prerequisite chain."
    },
    {
      "id": "6B-005",
      "severity": "HIGH",
      "kind": "MALFORMED_PROGRESSION",
      "classes": [
        "Improviser"
      ],
      "source": "Rebellion Era p.41, Table 2-2",
      "evidence": "Published Contraband is a single feature at levels 2,4,6,8,10 with amounts 2k,4k,6k,8k,10k; repo splits labels around commas into two features and also emits 3k,5k,7k,9k odd-level fragments.",
      "recommendation": "Fix generator/parser, not just emitted DB; use one typed feature at the five printed levels."
    },
    {
      "id": "6B-006",
      "severity": "MEDIUM",
      "kind": "DUPLICATED_ONE_TIME_FEATURE",
      "classes": [
        "Force Disciple"
      ],
      "source": "Core p.215, Table 12-7",
      "evidence": "Prophet appears as a first-level class feature in printed table; repo includes Prophet in class_feature entries at levels 1-5. Published ability describes per-level benefit, which must not be confused with repeat grants.",
      "recommendation": "Grant Prophet once; derive its per-level benefit from class level advancement."
    },
    {
      "id": "6B-007",
      "severity": "MEDIUM",
      "kind": "DUPLICATED_SCALING_FEATURE",
      "classes": [
        "Crime Lord"
      ],
      "source": "Core pp.209-210, Table 12-4 and Command Cover",
      "evidence": "Command Cover is granted at level 2 and its magnitude is computed from adjacent allies and half class level; repo repeats Command Cover +1..+5 at even levels.",
      "recommendation": "Represent Command Cover as one scaling feature, not five independently stacking grants; retain Crime Lord talent choices at every level."
    },
    {
      "id": "6B-008",
      "severity": "MEDIUM",
      "kind": "MALFORMED_FEATURE_LABEL",
      "classes": [
        "Infiltrator"
      ],
      "source": "TFU p.49, Table 3-4",
      "evidence": "Printed Unarmed Stun increases by +1 die, +2 dice, +3 dice; repository labels contain +1d_, +2d_, +3d_ placeholders.",
      "recommendation": "Use canonical feature labels and typed dice-count scaling."
    },
    {
      "id": "6B-009",
      "severity": "MEDIUM",
      "kind": "SOURCE_FEATURE_LABEL",
      "classes": [
        "Master Privateer"
      ],
      "source": "TFU pp.51-52, Piracy",
      "evidence": "Printed feature is called Piracy; repo labels the level-1 class feature 'Lure of Piracy'. Both concern loss of further privateer progression after falling to the dark side.",
      "recommendation": "Canonicalize displayed name; encode ongoing class advancement restriction separately."
    },
    {
      "id": "6B-010",
      "severity": "HIGH",
      "kind": "ONGOING_CLASS_ACCESS_CONDITION",
      "classes": [
        "Sith Apprentice",
        "Sith Lord"
      ],
      "source": "Core pp.223-224, Requirements",
      "evidence": "Published classes lose access to their class features if Dark Side Score falls below Wisdom; the prerequisite JSON records full DSP as an entry requirement but not an ongoing class-feature suspension policy.",
      "recommendation": "Add actor-state-based suspend/resume policy; do not remove earned levels or talents."
    },
    {
      "id": "6B-011",
      "severity": "MEDIUM",
      "kind": "ONGOING_CLASS_ACCESS_CONDITION",
      "classes": [
        "Corporate Agent"
      ],
      "source": "KOTOR p.42, Employment Required",
      "evidence": "Source prohibits gaining new Corporate Agent levels while not employed by a major interstellar corporation. Entry JSON contains employment as prose but does not itself express an ongoing leveling gate.",
      "recommendation": "Model eligibility for subsequent levels separately from first-level entry."
    },
    {
      "id": "6B-012",
      "severity": "MEDIUM",
      "kind": "ONGOING_CLASS_ACCESS_CONDITION",
      "classes": [
        "Master Privateer"
      ],
      "source": "TFU p.52, Piracy",
      "evidence": "Source bars additional Master Privateer levels once lost to the dark side; entry JSON has no typed ongoing condition.",
      "recommendation": "Enforce at later level-up, without stripping existing levels."
    },
    {
      "id": "6B-013",
      "severity": "LOW",
      "kind": "LEGACY_TREE_PROJECTION",
      "classes": [
        "Assassin",
        "Infiltrator"
      ],
      "source": "Scum p.29; TFU p.49",
      "evidence": "Raw talent_trees mixes names GenoHaradan/Bothan SpyNet with IDs, but canonical talentTreeSourceIds resolves both correctly.",
      "recommendation": "Normalize legacy raw field through generator without disturbing canonical IDs."
    }
  ],
