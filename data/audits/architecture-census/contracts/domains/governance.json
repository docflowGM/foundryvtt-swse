  "findings": [
    {
      "id": "F-GOV-001",
      "category": "unimplemented",
      "severity": "high",
      "status": "confirmed",
      "title": "A-02 has no runtime enforcement: MutationInterceptor context is write-only",
      "affectedFiles": [
        "scripts/governance/mutation/MutationInterceptor.js",
        "scripts/governance/actor-engine/actor-engine.js"
      ],
      "evidence": [
        "scripts/governance/mutation/MutationInterceptor.js:99",
        "scripts/governance/mutation/MutationInterceptor.js:156",
        "scripts/governance/mutation/MutationInterceptor.js:186",
        "scripts/governance/mutation/MutationInterceptor.js:192",
        "scripts/governance/actor-engine/actor-engine.js:1061"
      ],
      "observed": "ActorEngine sets/clears a global context around each write; nothing outside MutationInterceptor reads hasContext/_isAuthorized (git grep). No preUpdate hook checks it. A nested ActorEngine call clears the outer context (single slot, not a stack). Comments claim enforcement via Sentinel/secureActorUpdate, which does not exist.",
      "intendedOwnership": "A-02 enforced or at least detected at runtime in dev/strict.",
      "contractRef": "A-02; CR-GOV-01/02",
      "proposedSolution": "Owner decision: (a) add a DEV/STRICT-only preUpdateActor/preUpdateItem/preCreate/preDelete observer that reports writes without context (make context a depth counter), or (b) remove the enforcement wording and rely on the census probe + CI ratchet (A-P3). Either way fix the single-slot nesting.",
      "alternatives": "(b) is cheaper and matches the current evidence model.",
      "dependencies": [
        "B-ACT",
        "A-P3"
      ],
      "ownerDecisionRequired": true,
      "rulesQuestion": false,
      "regressionTests": "Unit: direct actor.update in STRICT mode emits a Sentinel report; nested ActorEngine calls keep outer context.",
      "foundryAcceptance": "Run with sentinelMode DEV in a live world and confirm report volume is usable.",
      "scope": "M",
      "simplificationBenefit": "Turns A-02 from convention into a measurable gate.",
      "risk": "Low (observer only).",
      "perfImpact": "low"
    },
