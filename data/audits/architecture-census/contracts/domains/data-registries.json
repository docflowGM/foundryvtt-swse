        "scripts/data/prerequisite-checker.js:3110"
      ],
      "observed": "getTotalLevel returns system.level ?? 1; getBaseAttackBonus returns the max of 12 stored/derived candidate paths (system.bab.*, system.derived.bab.*, system.combat.bab.*) and a value computed from class state. A stale stored value larger than the derived BAB wins (max), so a prerequisite can pass on stale data. Used at 4 call sites.",
      "intendedOwnership": "Level from actor-core level-split; BAB from derived state (actor-core) or, for draft actors, from progression draft state passed explicitly.",
      "contractRef": "A-01; CR-DAT-01",
      "proposedSolution": "Read BAB from system.derived.bab (single path) for committed actors and from the pending/draft projection for drafts; read level via level-split getTotalLevel. Keep the draft fallback behaviour behind an explicit \"draft\" input.",
      "alternatives": "",
      "dependencies": [
        "B-ACT",
        "progression contract"
      ],
      "ownerDecisionRequired": false,
      "rulesQuestion": false,
      "regressionTests": "Prereq tests with stale system.bab > derived.bab must fail the check; draft actor tests unchanged.",
      "foundryAcceptance": "Level-up prerequisite screens.",
      "scope": "M",
      "simplificationBenefit": "One BAB/level authority.",
      "risk": "Medium (progression).",
      "perfImpact": "none"
