  "findings": [
    {
      "id": "F-ROL-001",
      "category": "duplicate-authority",
      "severity": "medium",
      "status": "confirmed",
      "title": "Local skill-total formulas in the rolls domain",
      "affectedFiles": [
        "scripts/rolls/roll-config.js",
        "scripts/rolls/custom-skill-roller.js",
        "scripts/rolls/skills.js"
      ],
      "evidence": [
        "scripts/rolls/roll-config.js:732",
        "scripts/rolls/roll-config.js:749",
        "scripts/rolls/roll-config.js:753",
        "scripts/rolls/custom-skill-roller.js:27",
        "scripts/rolls/custom-skill-roller.js:35",
        "scripts/rolls/skills.js:423"
      ],
      "observed": "getSkillTotal returns a locally rebuilt component total (ability + half level + trained + focus + misc) for useTheForce, and otherwise prefers derived totals with a component fallback. calculateCustomSkillBonus computes ability + 5 trained + 5 focus + floor(system.level/2) + misc. skills.calculateSkillModifier (exported, no importer) omits half level entirely. The derived skill pipeline (actor-core/ABL) is the authority for normal skills.",
      "intendedOwnership": "Skill totals from the derived skill pipeline; dialogs display the derived total and its breakdown.",
      "contractRef": "A-01; R-ROL-04/06",
      "proposedSolution": "Delete calculateSkillModifier (dead). Make the UTF dialog base read the derived UTF total plus an explicit breakdown (the comment says duplicate passive effects were the reason; fix duplication in the derived pipeline instead - see F-ACT-015). Custom skills: compute in the derived pipeline; the half-level source is a deferred rules question (deferredRules).",
      "alternatives": "",
      "dependencies": [
        "B-ACT F-ACT-015"
      ],
      "ownerDecisionRequired": true,
      "rulesQuestion": true,
      "regressionTests": "Parity tests: dialog base == derived total for every skill incl. UTF; custom skill fixtures.",
      "foundryAcceptance": "Roll dialogs in Foundry.",
      "scope": "M",
      "simplificationBenefit": "One skill-total authority.",
      "risk": "Medium.",
      "perfImpact": "none"
    },
