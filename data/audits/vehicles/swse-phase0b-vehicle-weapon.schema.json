{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "swse.vehicle-weapon.phase0b.draft-0.5",
  "title": "SWSE Phase 0-B — vehicle weapon definition (draft v0.5)",
  "description": "Sourcebook-derived reusable intrinsic weapons; separate from mounts, gunner attack modifiers, fire groups, and mutable owned ammunition. Phase 0-B research only. v0.5 uses sparse optional nested profile data, not placeholder null substructures.",
