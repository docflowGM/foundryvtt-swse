                  "type": [
                    "string",
                    "integer",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": [
                      "string",
                      "integer",
                      "number",
                      "boolean"
                    ]
                  }
                }
              ]
            },
            "scale": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "character",
                "starship",
                "neither",
                null
              ]
            },
            "status": {
              "const": "structured"
            }
          },
          "required": [
            "node",
            "subject",
            "attribute",
            "operator",
            "value",
            "scale",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "All conditions must hold",
          "properties": {
            "node": {
              "const": "all"
