          "description": "Published or normalized numerical value, never inferred without marking derivation"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "Physical unit, e.g. kg, metric-ton, m, days, months, years, credits, squares, km/h"
