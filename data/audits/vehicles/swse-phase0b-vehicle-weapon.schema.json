      "const": "swse.vehicle-weapon.phase0b.draft-0.5"
    },
    "weaponKey": {
      "type": [
        "string",
        "null"
      ],
      "description": "Stable canonical weapon identity key"
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical weapon name"
    },
    "sourceEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Source claim",
        "properties": {
          "book": {
            "type": [
              "string",
              "null"
            ],
            "description": "Published source book"
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Published printed page"
          },
