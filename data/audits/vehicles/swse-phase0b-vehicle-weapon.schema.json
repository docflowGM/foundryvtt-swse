            "children",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "At least one condition holds",
          "properties": {
            "node": {
              "const": "any"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/conditionAst"
              },
              "minItems": 1
            },
            "status": {
              "const": "structured"
            }
          },
          "required": [
            "node",
            "children",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Logical negation",
          "properties": {
            "node": {
              "const": "not"
            },
            "child": {
              "$ref": "#/$defs/conditionAst"
