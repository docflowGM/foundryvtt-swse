    "conditionAst": {
      "description": "Typed rule predicate; unresolved nodes deliberately fail the certification gate, but remain schema-valid for draft transcription.",
      "oneOf": [
        {
          "type": "object",
          "description": "Explicit atomic claim with a defined context vocabulary",
          "properties": {
            "node": {
