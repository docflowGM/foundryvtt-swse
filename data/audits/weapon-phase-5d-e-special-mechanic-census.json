{
  "schemaVersion": 1,
  "phase": "5D-E",
  "purpose": "Deterministic classification of every structured special mechanic of every offered canonical attack form (by structure, not name).",
  "taxonomy": {
    "activation-effect": {
      "policy": "DEFER",
      "timing": "on-attack",
      "note": "activated empowerment (Force Point / swift action) with own cost"
    },
    "attack-modifier-auto": {
      "policy": "AUTO",
      "timing": "on-attack",
      "note": "conditional attack modifier whose condition is observable from the actor/target"
    },
    "attack-modifier-prompt": {
      "policy": "PROMPT",
      "timing": "on-attack",
      "note": "conditional attack modifier whose condition is not observable; answered once and stored"
    },
    "attack-resolution": {
      "policy": "AUTO",
      "timing": "on-attack",
      "note": "selected form defense (reflex/fortitude/will) -- already consumed through targetContext.defenseType"
    },
    "bonus-damage-rider": {
      "policy": "AUTO",
      "timing": "after-threshold",
      "note": "separate immediate damage event dealt after the triggering damage proves its threshold / condition-track result; never re-triggers riders"
    },
    "conditional-damage": {
      "policy": "AUTO",
      "timing": "on-damage-roll",
      "note": "weapon-declared damage term that applies under a structural attack fact (point-blank range / adjacent target); composed once in the existing damage composition"
    },
    "critical-bonus-damage": {
      "policy": "AUTO",
      "timing": "on-critical",
      "note": "critical hit adds a formula after the critical multiplier (composition critical bonus)"
    },
    "critical-die-replace": {
      "policy": "AUTO",
      "timing": "on-critical",
      "note": "critical hit replaces the base die size (composition base)"
    },
    "ct-overwhelming-stun": {
      "policy": "AUTO",
      "timing": "after-damage",
      "note": "stun damage >= current HP shifts the condition track (existing CT infrastructure)"
    },
    "ct-rider": {
      "policy": "AUTO",
      "timing": "after-damage",
      "note": "condition-track shift executed at Apply Damage through CombatTargetEffectAdapter"
    },
    "ct-rider-prompt": {
      "policy": "PROMPT",
      "timing": "after-damage",
      "note": "condition-track rider whose trigger cannot be evaluated automatically; answered once and stored"
    },
    "damage-multiplier": {
      "policy": "AUTO",
      "timing": "on-damage-roll",
      "note": "multiplies the weapon base damage dice through the existing damage composition"
    },
    "damage-rider": {
      "policy": "AUTO",
      "timing": "on-damage-roll",
      "note": "separately rolled typed damage component applied in the same damage event"
    },
    "defensive-interaction": {
      "policy": "DEFER",
      "timing": "continuous",
      "note": "modifies the wielder's defenses/Use the Force checks rather than this single attack"
    },
    "delayed-damage": {
      "policy": "AUTO",
      "timing": "time-delay",
      "note": "one delayed damage instance queued through the existing RecurringDamageEngine (start of the target's next turn)"
    },
    "display-note": {
      "policy": "DISPLAY_ONLY",
      "timing": "continuous",
      "note": "informational statement with no effect on resolving the single attack (e.g. concealed shot origin)"
    },
    "dr-conditional": {
      "policy": "PROMPT",
      "timing": "on-attack",
      "note": "DR is ignored only under a stated condition the runtime cannot observe; answered once and stored"
    },
    "dr-ignore": {
      "policy": "AUTO",
      "timing": "on-damage-roll",
      "note": "form ignores damage reduction: the packet component is tagged bypass-dr and the existing DR resolver honors it"
    },
    "firing-constraint": {
      "policy": "VALIDATION_ONLY",
      "timing": "on-attack",
      "note": "limits shots per round/reload; checked against the existing multi-attack/ammo rules (Phase 5D-F)"
    },
    "grab-grapple": {
      "policy": "DEFER",
      "timing": "on-hit",
      "note": "grapple/net/snare state machine (existing grapple system; multi-step workflow)"
    },
    "multi-attack-interaction": {
      "policy": "AUTO",
      "timing": "on-attack",
      "note": "attack modifier that applies while Double/Triple Attack, Rapid Shot or Rapid Strike is in use (Phase 5D-F: consumed at attack time from the active multi-attack shape)"
    },
    "native-stun": {
      "policy": "AUTO",
      "timing": "on-attack",
      "note": "form deals stun damage by default (damage mode)"
    },
    "payload-delegation": {
      "policy": "AUTO",
      "timing": "on-damage-roll",
      "note": "payload rules come from the loaded canonical grenade (delegateLoadedPayload); the launcher applies only its own adjustment"
    },
    "payload-effect": {
      "policy": "DEFER",
      "timing": "on-hit",
      "note": "effect-only payload (flash/gas/toxin) without complete structure"
    },
    "persistent-effect": {
      "policy": "DEFER",
      "timing": "turn-start",
      "note": "delayed/recurring effect resolved at a later turn boundary"
    },
    "persistent-poison": {
      "policy": "AUTO",
      "timing": "until-cured",
      "note": "persistent secondary-attack toxin run by the existing PoisonEngine (instance, recurrence, treatment, termination)"
    },
    "poison-delivery": {
      "policy": "AUTO",
      "timing": "after-damage",
      "note": "a poison coating selected on the owned weapon is delivered by PoisonEngine only when the attack deals damage; the weapon capability alone creates no poison"
    },
    "prepared-attack": {
      "policy": "AUTO",
      "timing": "on-attack",
      "note": "swift-action preparation / bracing: CONSUMED by the owned fire-state (FireStateStore.primePreparedAttack / previewReadiness, Phase 5D-G / 5D-I-A); classified AUTO so the census stops reporting a superseded deferral"
    },
    "return-recovery": {
      "policy": "DEFER",
      "timing": "on-attack",
      "note": "return/recovery threshold with no structured effect or action"
    },
    "special-action": {
      "policy": "DEFER",
      "timing": "on-attack",
      "note": "replaces the attack with another action (Pin/Trip/Venom Spit) -- refused, not substituted"
    },
    "status-condition": {
      "policy": "DEFER",
      "timing": "after-damage",
      "note": "status condition (prone/disabled/concealment) with no single existing setter"
    },
    "status-effect": {
      "policy": "AUTO",
      "timing": "after-damage",
      "note": "status / timed effect created on the target through ActorEngine.createActiveEffects with weapon provenance and a turn-owner lifecycle"
    },
    "target-class-damage": {
      "policy": "AUTO",
      "timing": "after-damage",
      "note": "per-target damage scaling by structural target class (droid / vehicle / device / object vs organic) at packet finalization; composes with the existing area hit / miss / Evasion path"
    },
    "threshold-adjustment": {
      "policy": "AUTO",
      "timing": "after-mitigation",
      "note": "the attack lowers/raises the target's EFFECTIVE damage threshold for this damage event only (stored threshold untouched)"
    },
    "unclassified": {
      "policy": "DEFER",
      "timing": "on-attack",
      "note": "structured mechanic with no recognized family; surfaced, never silently dropped"
    }
  },
