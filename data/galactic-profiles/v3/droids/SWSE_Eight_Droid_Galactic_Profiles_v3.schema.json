{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swse.local/schema/galactic-droid-profiles-v3.schema.json",
  "title": "SWSE Galactic Droid Profiles v3 (staged custom heroic droids)",
  "description": "Droid-only staged authoring/compilation input. Structural checks are not V2 canonical quotes, entitlement validation, host approval, or actor finalization. Do not publish as ready to play.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "source",
    "compatibility",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "format": {
      "const": "swse.galactic-profiles.v3"
    },
    "source": {
      "type": "object"
    },
    "compatibility": {
      "type": "object"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "profileId",
          "revision",
          "catalog",
          "identity",
          "build",
          "optionalRules",
          "certification",
          "provenance"
        ],
        "properties": {
          "schemaVersion": {
            "const": 3
          },
          "profileId": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "catalog": {
            "type": "object",
            "required": [
              "name",
              "archetype",
              "description",
              "imagePath",
              "classKey",
              "roleTags"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "archetype": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "imagePath": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "classKey": {
                "enum": [
                  "scout",
                  "soldier",
                  "noble",
                  "scoundrel"
                ]
              },
              "roleTags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "identity": {
            "type": "object",
            "required": [
              "level",
              "participantKind",
              "rulesTrack",
              "classRef",
              "speciesRef",
              "speciesPublication"
            ],
            "properties": {
              "level": {
                "const": 1
              },
              "participantKind": {
                "const": "droid"
              },
              "rulesTrack": {
                "const": "heroic-droid"
              },
              "classRef": {
                "type": "object",
                "properties": {
                  "sourceRef": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "pack": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id"
                    ]
                  },
                  "canonicalIdCandidate": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "resolution": {
                    "type": "string"
                  }
                },
                "required": [
                  "sourceRef",
                  "resolution"
                ]
              },
              "speciesRef": {
                "type": "null"
              },
              "backgroundRef": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "sourceRef": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "pack": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id"
                    ]
                  },
                  "canonicalIdCandidate": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "resolution": {
                    "type": "string"
                  }
                },
                "required": [
                  "sourceRef",
                  "resolution"
                ]
              },
              "speciesPublication": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "const": "notApplicableDroid"
                  }
                }
              }
            }
          },
          "build": {
            "type": "object",
            "required": [
              "attributes",
              "skills",
              "feats",
              "talents",
              "forcePowers",
              "languages",
              "startingPackage",
              "droid"
            ],
            "properties": {
              "attributes": {
                "type": "object",
                "required": [
                  "basis",
                  "scores",
                  "preDegreeAndSizeScores"
                ],
                "properties": {
                  "basis": {
                    "type": "string"
                  },
                  "scores": {
                    "type": "object",
                    "required": [
                      "str",
                      "dex",
                      "con",
                      "int",
                      "wis",
                      "cha"
                    ],
                    "properties": {
                      "str": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "dex": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "con": {
                        "type": "null"
                      },
                      "int": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "wis": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "cha": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      }
                    }
                  },
                  "preDegreeAndSizeScores": {
                    "type": "object",
                    "required": [
                      "str",
                      "dex",
                      "int",
                      "wis",
                      "cha",
                      "con"
                    ],
                    "properties": {
                      "str": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "dex": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "con": {
                        "type": "null"
                      },
                      "int": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "wis": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "cha": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      }
                    }
                  }
                }
              },
              "skills": {
                "type": "object",
                "required": [
                  "trained"
                ],
                "properties": {
                  "trained": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "canonicalKeyCandidate",
                        "sourceEntry",
                        "resolution"
                      ]
                    }
                  }
                }
              },
              "feats": {
                "type": "object",
                "required": [
                  "sourceSelections",
                  "grantDirectlyFromSourceCandidates"
                ],
                "properties": {
                  "sourceSelections": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "displayName",
                        "sourceCandidates",
                        "entitlement"
                      ]
                    }
                  },
                  "grantDirectlyFromSourceCandidates": {
                    "const": false
                  }
                }
              },
              "talents": {
                "type": "object",
                "required": [
                  "classSlot",
                  "generalSlotWhenTalentWikiEnabled",
                  "additionalSourceEntries"
                ],
                "properties": {
                  "classSlot": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "generalSlotWhenTalentWikiEnabled": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "additionalSourceEntries": {
                    "type": "array"
                  }
                }
              },
              "forcePowers": {
                "type": "object",
                "required": [
                  "sourceSelections"
                ],
                "properties": {
                  "sourceSelections": {
                    "type": "array",
                    "items": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "sourceRef": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "name": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "pack": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "id"
                          ]
                        },
                        "canonicalIdCandidate": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "resolution": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "sourceRef",
                        "resolution"
                      ]
                    },
                    "maxItems": 0
                  }
                }
              },
              "languages": {
                "type": "object",
                "required": [
                  "legacyKnownLanguages"
                ],
                "properties": {
                  "legacyKnownLanguages": {
                    "type": "array"
                  }
                }
              },
              "startingPackage": {
                "type": "object",
                "required": [
                  "items",
                  "wallet",
                  "budgetAccounting",
                  "duplicateProtection",
                  "startingClassCredits"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "item",
                        "quantity",
                        "displayName"
                      ],
                      "properties": {
                        "item": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "sourceRef": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "name": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "pack": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                }
                              },
                              "required": [
                                "id"
                              ]
                            },
                            "canonicalIdCandidate": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "resolution": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "sourceRef",
                            "resolution"
                          ]
                        },
                        "quantity": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "displayName": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "wallet": {
                    "type": "object",
                    "required": [
                      "mode",
                      "credits",
                      "allowZero"
                    ],
                    "properties": {
                      "mode": {
                        "const": "finalNetBalance"
                      },
                      "credits": {
                        "type": "number",
                        "minimum": 0
                      },
                      "allowZero": {
                        "const": true
                      }
                    }
                  },
                  "budgetAccounting": {
                    "const": "prePurchasedLegalByUserAssumption"
                  },
                  "duplicateProtection": {
                    "type": "string"
                  },
                  "startingClassCredits": {
                    "type": "object",
                    "required": [
                      "dice",
                      "preselectedDiceResults",
                      "initial",
                      "purchasesTotal",
                      "remaining"
                    ],
                    "properties": {
                      "dice": {
                        "const": "3d4"
                      },
                      "preselectedDiceResults": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 4
                        }
                      },
                      "initial": {
                        "type": "number",
                        "minimum": 0
                      },
                      "purchasesTotal": {
                        "type": "number",
                        "minimum": 0
                      },
                      "remaining": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                }
              },
              "droid": {
                "type": "object",
                "required": [
                  "creationMode",
                  "droidDegree",
                  "droidSize",
                  "isDroid",
                  "droidSystems",
                  "hardware",
                  "behavioralRestrictions"
                ],
                "properties": {
                  "creationMode": {
                    "const": "custom"
                  },
                  "droidDegree": {
                    "enum": [
                      "1st-degree",
                      "2nd-degree",
                      "3rd-degree",
                      "4th-degree",
                      "5th-degree"
                    ]
                  },
                  "droidSize": {
                    "enum": [
                      "small",
                      "medium"
                    ]
                  },
                  "isDroid": {
                    "const": true
                  },
                  "chassis": {
                    "type": "null"
                  },
                  "droidCalculationMode": {
                    "const": "playable-derived"
                  },
                  "droidSystems": {
                    "type": "object",
                    "required": [
                      "locomotion",
                      "processor",
                      "appendages",
                      "accessories",
                      "locomotionEnhancements",
                      "appendageEnhancements"
                    ],
                    "properties": {
                      "locomotion": {
                        "type": "object",
                        "required": [
                          "id"
                        ]
                      },
                      "processor": {
                        "type": "object",
                        "required": [
                          "id"
                        ]
                      },
                      "appendages": {
                        "type": "array",
                        "minItems": 2
                      },
                      "accessories": {
                        "type": "array"
                      },
                      "locomotionEnhancements": {
                        "type": "array"
                      },
                      "appendageEnhancements": {
                        "type": "array"
                      }
                    }
                  },
                  "hardware": {
                    "type": "object",
                    "required": [
                      "budgetCredits",
                      "spentCredits",
                      "remainingCredits",
                      "lineItems",
                      "mustRequoteAtCommit",
                      "v2QuoteStatus"
                    ],
                    "properties": {
                      "budgetCredits": {
                        "const": 1000
                      },
                      "spentCredits": {
                        "const": 1000
                      },
                      "remainingCredits": {
                        "const": 0
                      },
                      "allowClassCreditsOverflow": {
                        "const": false
                      },
                      "lineItems": {
                        "type": "array",
                        "minItems": 4,
                        "items": {
                          "type": "object",
                          "required": [
                            "sourceId",
                            "category",
                            "costCredits",
                            "grantAuthority"
                          ]
                        }
                      },
                      "mustRequoteAtCommit": {
                        "type": "string",
                        "minLength": 1
                      },
                      "v2QuoteStatus": {
                        "const": "pendingExecution"
                      }
                    }
                  },
                  "behavioralRestrictions": {
                    "type": "object",
                    "required": [
                      "degree",
                      "nonviolenceInhibitor",
                      "obedienceInhibitor",
                      "mustBeEnforcedByV2"
                    ],
                    "properties": {
                      "degree": {
                        "enum": [
                          "1st-degree",
                          "2nd-degree",
                          "3rd-degree",
                          "4th-degree",
                          "5th-degree"
                        ]
                      },
                      "nonviolenceInhibitor": {
                        "type": "boolean"
                      },
                      "obedienceInhibitor": {
                        "type": "boolean"
                      },
                      "mustBeEnforcedByV2": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          },
          "optionalRules": {
            "type": [
              "object",
              "null"
            ]
          },
          "certification": {
            "type": "object",
            "required": [
              "status",
              "publishableAsReadyToPlay",
              "issues"
            ],
            "properties": {
              "status": {
                "const": "staticRAWAndSourceChecksPassedPendingV2"
              },
              "publishableAsReadyToPlay": {
                "const": false
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "provenance": {
            "type": "object",
            "required": [
              "sourceFile",
              "legacyId",
              "sourceCommit"
            ],
            "properties": {
              "sourceFile": {
                "type": "string"
              },
              "legacyId": {
                "type": "string"
              },
              "sourceCommit": {
                "const": "b5e2a7514e0d5ea695a4dcf420d7a028c7c4208d"
              }
            }
          }
        }
      }
    }
  }
}
