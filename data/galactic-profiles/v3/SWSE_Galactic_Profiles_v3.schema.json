{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swse.local/schema/galactic-profiles-v3.schema.json",
  "title": "SWSE Galactic Profiles v3 (authoring/compilation input)",
  "description": "Structural validation only. A runtime V2 compiler and published Saga RAW prerequisite checks are additionally required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "source",
    "compatibility",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "format": {
      "const": "swse.galactic-profiles.v3"
    },
    "source": {
      "type": "object"
    },
    "compatibility": {
      "type": "object"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "profileId",
          "revision",
          "catalog",
          "identity",
          "build",
          "optionalRules",
          "certification",
          "provenance"
        ],
        "properties": {
          "schemaVersion": {
            "const": 3
          },
          "profileId": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "catalog": {
            "type": "object",
            "required": [
              "name",
              "archetype",
              "description",
              "imagePath",
              "classKey",
              "roleTags"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "archetype": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "imagePath": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "classKey": {
                "type": "string"
              },
              "roleTags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "identity": {
            "type": "object",
            "required": [
              "level",
              "participantKind",
              "rulesTrack",
              "classRef",
              "speciesRef",
              "speciesPublication"
            ],
            "properties": {
              "level": {
                "const": 1
              },
              "participantKind": {
                "enum": [
                  "heroic",
                  "nonheroic",
                  "beast"
                ]
              },
              "rulesTrack": {
                "enum": [
                  "heroic",
                  "nonheroic"
                ]
              },
              "classRef": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "sourceRef": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "pack": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id"
                    ]
                  },
                  "canonicalIdCandidate": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "resolution": {
                    "type": "string"
                  }
                },
                "required": [
                  "sourceRef",
                  "resolution"
                ]
              },
              "speciesRef": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "sourceRef": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "pack": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id"
                    ]
                  },
                  "canonicalIdCandidate": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "resolution": {
                    "type": "string"
                  }
                },
                "required": [
                  "sourceRef",
                  "resolution"
                ]
              },
              "backgroundRef": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "sourceRef": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "pack": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id"
                    ]
                  },
                  "canonicalIdCandidate": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "resolution": {
                    "type": "string"
                  }
                },
                "required": [
                  "sourceRef",
                  "resolution"
                ]
              },
              "speciesPublication": {
                "type": "object"
              }
            }
          },
          "build": {
            "type": "object",
            "required": [
              "attributes",
              "skills",
              "feats",
              "talents",
              "forcePowers",
              "languages",
              "startingPackage"
            ],
            "properties": {
              "attributes": {
                "type": "object",
                "required": [
                  "basis",
                  "scores"
                ],
                "properties": {
                  "basis": {
                    "type": "string"
                  },
                  "scores": {
                    "type": "object",
                    "required": [
                      "str",
                      "dex",
                      "con",
                      "int",
                      "wis",
                      "cha"
                    ],
                    "properties": {
                      "str": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "dex": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "con": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "int": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "wis": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      },
                      "cha": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 50
                      }
                    }
                  }
                }
              },
              "skills": {
                "type": "object",
                "required": [
                  "trained"
                ],
                "properties": {
                  "trained": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "canonicalKeyCandidate",
                        "sourceEntry",
                        "resolution"
                      ]
                    }
                  }
                }
              },
              "feats": {
                "type": "object",
                "required": [
                  "sourceSelections",
                  "grantDirectlyFromSourceCandidates"
                ],
                "properties": {
                  "sourceSelections": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "displayName",
                        "sourceCandidates",
                        "entitlement"
                      ]
                    }
                  },
                  "grantDirectlyFromSourceCandidates": {
                    "const": false
                  }
                }
              },
              "talents": {
                "type": "object",
                "required": [
                  "classSlot",
                  "generalSlotWhenTalentWikiEnabled",
                  "additionalSourceEntries"
                ],
                "properties": {
                  "classSlot": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "generalSlotWhenTalentWikiEnabled": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "additionalSourceEntries": {
                    "type": "array"
                  }
                }
              },
              "forcePowers": {
                "type": "object",
                "required": [
                  "sourceSelections"
                ],
                "properties": {
                  "sourceSelections": {
                    "type": "array",
                    "items": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "sourceRef": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "name": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "pack": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "id"
                          ]
                        },
                        "canonicalIdCandidate": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "resolution": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "sourceRef",
                        "resolution"
                      ]
                    }
                  }
                }
              },
              "languages": {
                "type": "object",
                "required": [
                  "legacyKnownLanguages"
                ],
                "properties": {
                  "legacyKnownLanguages": {
                    "type": "array"
                  }
                }
              },
              "startingPackage": {
                "type": "object",
                "required": [
                  "items",
                  "wallet",
                  "budgetAccounting",
                  "duplicateProtection"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "item",
                        "quantity",
                        "displayName"
                      ],
                      "properties": {
                        "item": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "sourceRef": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "name": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "pack": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                }
                              },
                              "required": [
                                "id"
                              ]
                            },
                            "canonicalIdCandidate": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "resolution": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "sourceRef",
                            "resolution"
                          ]
                        },
                        "quantity": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "displayName": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "wallet": {
                    "type": "object",
                    "required": [
                      "mode",
                      "credits",
                      "allowZero"
                    ],
                    "properties": {
                      "mode": {
                        "const": "finalNetBalance"
                      },
                      "credits": {
                        "type": "number",
                        "minimum": 0
                      },
                      "allowZero": {
                        "const": true
                      }
                    }
                  },
                  "budgetAccounting": {
                    "const": "prePurchasedLegalByUserAssumption"
                  },
                  "duplicateProtection": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "optionalRules": {
            "type": [
              "object",
              "null"
            ]
          },
          "certification": {
            "type": "object",
            "required": [
              "status",
              "publishableAsReadyToPlay",
              "issues"
            ],
            "properties": {
              "status": {
                "const": "pendingV2Certification"
              },
              "publishableAsReadyToPlay": {
                "const": false
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "provenance": {
            "type": "object",
            "required": [
              "sourceFile",
              "legacyId",
              "sourceCommit"
            ],
            "properties": {
              "sourceFile": {
                "type": "string"
              },
              "legacyId": {
                "type": "string"
              },
              "sourceCommit": {
                "const": "b5e2a7514e0d5ea695a4dcf420d7a028c7c4208d"
              }
            }
          }
        }
      }
    }
  }
}
