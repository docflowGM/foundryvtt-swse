{{!--
  surface-workbench.hbs
  Item Customization Workbench rendered inline inside the holopad shell.

  Uses WorkbenchSurfaceAdapter to render the canonical workbench-content.hbs
  partial (the same content the standalone ItemCustomizationWorkbench window
  uses) and inject it as contentHtml. This surface provides its own
  stage/screen chrome around that content — the Holopad shell is the outer
  frame, so the inline path does not embed the full standalone application
  frame a second time.

  vm:
    id           — 'workbench'
    title        — 'Armory // Customization'
    contentHtml  — pre-rendered canonical workbench-content.hbs partial
    vm.*         — full ItemCustomizationWorkbench _prepareContext() output
    error        — error message if initialization failed
--}}

<div class="swse-shell-surface swse-shell-surface--workbench"
     data-shell-region="surface-workbench"
     data-surface-id="{{vm.id}}">

  {{#if vm.error}}
  {{!-- Error state --}}
  <div class="swse-shell-surface__body swse-shell-surface__error">
    <i class="fas fa-exclamation-triangle"></i>
    <span>{{vm.error}}</span>
  </div>

  {{else if vm.contentHtml}}
  {{!-- Canonical workbench content, hosted inline: the shell surface is the
       outer frame, and this provides the same stage/screen chrome the
       standalone window uses (minus the standalone-only tablet bezel), not
       a second nested application frame. --}}
  <div class="swse-item-customization-workbench swse-shell-surface__body">
    <div class="swse-customization-stage swse-datapad swse-ui-shell swse-sheet-ui" data-theme="{{vm.vm.themeKey}}" data-motion-style="{{vm.vm.motionStyle}}" style="{{{vm.vm.themeStyleInline}}}; {{{vm.vm.motionStyleInline}}};">
      <div class="swse-customization-screen" data-application-content>
        {{{vm.contentHtml}}}
      </div>
    </div>
  </div>

  {{else}}
  {{!-- Loading state --}}
  <div class="swse-shell-surface__body swse-shell-surface__body--loading">
    <div class="swse-shell-launching">
      <div class="swse-shell-launching__icon"><i class="fas fa-spinner fa-spin"></i></div>
      <div class="swse-shell-launching__label">{{localize "SWSE.ShellUI.LoadingCustomizationWorkshop"}}</div>
    </div>
  </div>
  {{/if}}

</div>
