{{!--
  shell-overlay-layer.hbs
  Shell overlay layer — centered modal above the current surface.

  Container type: OVERLAY

  Overlay IDs and their rendered content:
    upgrade-single-item  → single item upgrade panel
    character-validation → read-only character validation report (header `!`)
    confirm-*            → short confirmation dialog
    warning-*            → warning / invalid-action notice

  vm: overlay view model from ShellSurfaceRegistry.buildOverlayVm()
  overlayId: the active overlay identifier
--}}

<div class="swse-shell-overlay-backdrop"
     data-shell-region="overlay-backdrop">

  <div class="swse-shell-overlay"
       data-shell-region="overlay"
       data-overlay-id="{{overlayId}}"
       role="dialog"
       aria-modal="true">

    {{!-- ─── Single-Item Upgrade ──────────────────────────────────────── --}}
    {{#if (eq overlayId "upgrade-single-item")}}

    <div class="swse-shell-overlay__header">
      <span class="swse-shell-overlay__title">
        <i class="fas fa-tools"></i>
        {{vm.title}}
      </span>
      <button class="swse-shell-overlay__close"
              data-shell-action="close-overlay"
              type="button"
              title="{{localize 'SWSE.ShellUI.Close'}}">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <div class="swse-shell-overlay__body swse-shell-overlay__body--upgrade">
      {{#if vm.error}}
        <div class="swse-shell-overlay__error">
          <i class="fas fa-exclamation-triangle"></i>
          <span>{{vm.error}}</span>
        </div>
      {{else}}
        {{> "systems/foundryvtt-swse/templates/apps/upgrade/upgrade-app.hbs"
            vm=vm.vm}}
      {{/if}}
    </div>

    {{/if}}

    {{!-- ─── Character Validation (header `!`; read-only report) ─────────── --}}
    {{#if (eq overlayId "character-validation")}}

    <div class="swse-shell-overlay__header">
      <span class="swse-shell-overlay__title">
        <i class="fas fa-clipboard-check"></i>
        {{vm.title}}
      </span>
      <button class="swse-shell-overlay__close"
              data-shell-action="close-overlay"
              type="button"
              title="{{localize 'SWSE.ShellUI.Close'}}">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <div class="swse-shell-overlay__body swse-shell-overlay__body--validation">
      {{#if vm.error}}
        <div class="swse-shell-overlay__error">
          <i class="fas fa-exclamation-triangle"></i>
          <span>{{vm.error}}</span>
        </div>
      {{else}}
        {{#if vm.hasFindings}}
        <table class="swse-validation-table">
          <thead>
            <tr><th>Error</th><th>Explanation</th><th>Resolve</th><th><span class="swse-visually-hidden">Ignore</span></th></tr>
          </thead>
          <tbody>
            {{#each vm.findings as |finding|}}
            <tr class="swse-validation-row swse-validation-row--{{finding.severity}}" data-finding-id="{{finding.id}}">
              <td class="swse-validation-cell--error">{{finding.title}}</td>
              <td class="swse-validation-cell--explanation">{{finding.explanation}}</td>
              <td class="swse-validation-cell--resolve">
                {{#if finding.resolve.label}}
                <button type="button" class="swse-btn swse-btn--primary" data-action="resolve-finding" data-finding-id="{{finding.id}}">{{finding.resolve.label}}</button>
                {{/if}}
              </td>
              <td class="swse-validation-cell--ignore">
                <button type="button" class="swse-validation-ignore" data-action="ignore-finding" data-finding-id="{{finding.id}}" title="Ignore this warning" aria-label="Ignore this warning">&times;</button>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{/if}}
        {{#unless vm.hasFindings}}
          <p class="swse-validation-note">No character issues need attention.</p>
        {{/unless}}
        {{#if vm.notes.length}}
          <section class="swse-validation-notes">
            <h4>Cannot be verified (informational)</h4>
            {{#each vm.notes as |note|}}<p>{{note.text}}</p>{{/each}}
          </section>
        {{/if}}
        {{#if vm.ignored.length}}
          <section class="swse-validation-notes">
            <h4>Ignored warnings ({{vm.ignored.length}})</h4>
            {{#each vm.ignored as |entry|}}
            <p>{{entry.title}} &mdash; {{entry.explanation}}
              <button type="button" class="swse-btn" data-action="restore-finding" data-finding-id="{{entry.id}}" title="Show this warning again">Restore</button></p>
            {{/each}}
          </section>
        {{/if}}
        {{#if vm.hasStaleIgnored}}
          <section class="swse-validation-notes">
            <p>Some ignored warnings no longer apply (resolved or changed).
              <button type="button" class="swse-btn" data-action="restore-finding" data-finding-id="{{vm.staleIgnoredIds}}" data-prune-stale="true">Clear</button></p>
          </section>
        {{/if}}
        {{#if vm.repairs.length}}
          <section class="swse-validation-notes">
            <h4>Suggested repairs (never applied automatically)</h4>
            {{#each vm.repairs as |repair|}}<p><strong>{{repair.label}}</strong>{{#if repair.detail}} &mdash; {{repair.detail}}{{/if}}</p>{{/each}}
          </section>
        {{/if}}
        {{#if vm.isGM}}{{#if vm.engineFindings.length}}
          <section class="swse-validation-notes swse-validation-notes--gm">
            <h4>GM diagnostics (validation tooling, not a character error)</h4>
            {{#each vm.engineFindings as |finding|}}<p><code>{{finding.code}}</code> {{finding.message}}</p>{{/each}}
          </section>
        {{/if}}{{/if}}
      {{/if}}
    </div>

    {{/if}}

    {{!-- ─── Game Session Composer ───────────────────────────────────────── --}}
    {{#if (eq overlayId "game-session-composer")}}

    <div class="swse-shell-overlay__header">
      <span class="swse-shell-overlay__title">
        <i class="fas fa-dice"></i>
        {{#if vm.selectedGame}}{{localize "SWSE.ShellUI.ConfigureGameSession" game=vm.selectedGame.title}}{{else}}{{localize "SWSE.ShellUI.ConfigureTable"}}{{/if}}
      </span>
      <button class="swse-shell-overlay__close"
              data-shell-action="close-overlay"
              type="button"
              title="{{localize 'SWSE.ShellUI.Close'}}">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <div class="swse-shell-overlay__body swse-shell-overlay__body--composer">
      {{#if vm.error}}
        <div class="swse-shell-overlay__error">
          <i class="fas fa-exclamation-triangle"></i>
          <span>{{vm.error}}</span>
        </div>
      {{else}}
        {{> "systems/foundryvtt-swse/templates/shell/partials/games/session-composer.hbs"
            vm=vm}}
      {{/if}}
    </div>

    <div class="swse-shell-overlay__footer">
      <button class="swse-btn swse-btn--secondary"
              data-shell-action="close-overlay"
              type="button">
        {{localize "SWSE.ShellUI.Cancel"}}
      </button>
    </div>

    {{/if}}

    {{!-- ─── Confirmation Dialog (vm.confirmLabel is set for confirm-* overlays) ─ --}}
    {{#if vm.confirmLabel}}

    <div class="swse-shell-overlay__header">
      <span class="swse-shell-overlay__title">
        <i class="fas fa-question-circle"></i>
        {{vm.title}}
      </span>
    </div>

    <div class="swse-shell-overlay__body swse-shell-overlay__body--confirm">
      <p class="swse-shell-overlay__message">{{vm.message}}</p>
    </div>

    <div class="swse-shell-overlay__footer">
      <button class="swse-btn swse-btn--secondary"
              data-shell-overlay-action="cancel"
              type="button">
        {{vm.cancelLabel}}
      </button>
      <button class="swse-btn {{#if vm.isDangerous}}swse-btn--danger{{else}}swse-btn--primary{{/if}}"
              data-shell-overlay-action="confirm"
              type="button">
        {{vm.confirmLabel}}
      </button>
    </div>

    {{/if}}

    {{!-- ─── Warning Notice (vm.dismissLabel is set for warning-* overlays) ──── --}}
    {{#if vm.dismissLabel}}

    <div class="swse-shell-overlay__header">
      <span class="swse-shell-overlay__title">
        <i class="fas fa-exclamation-triangle"></i>
        {{vm.title}}
      </span>
      <button class="swse-shell-overlay__close"
              data-shell-action="close-overlay"
              type="button">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <div class="swse-shell-overlay__body swse-shell-overlay__body--warning">
      <p class="swse-shell-overlay__message">{{vm.message}}</p>
    </div>

    <div class="swse-shell-overlay__footer">
      <button class="swse-btn swse-btn--primary"
              data-shell-action="close-overlay"
              type="button">
        {{vm.dismissLabel}}
      </button>
    </div>

    {{/if}}

  </div>
</div>
