<div class="attr-mentor-dialog">
  <div class="attr-mentor-dialog__header">
    <div>
      <h2>Suggested {{methodLabel}} Builds</h2>
      <p>{{intro}}</p>
    </div>
    <button type="button" class="prog-btn prog-btn--secondary" data-action="close-dialog">Close</button>
  </div>

  <div class="attr-mentor-dialog__cards">
    {{!-- All candidates show final scores and modifiers. Expanding a build
          reveals each attribute's full breakdown and its advice below. --}}
    {{#each builds}}
      <section class="attr-mentor-card {{#if recommended}}is-recommended{{/if}}" data-build-card>
        <div class="attr-mentor-card__head">
          <div class="attr-mentor-card__intro">
            <div class="attr-mentor-card__title-row">
              <h3>{{title}}</h3>
              {{#if recommended}}<span class="attr-mentor-card__recommended">Recommended</span>{{/if}}
            </div>
            <p class="attr-mentor-card__subtitle">{{subtitle}}</p>
          </div>
          <div class="attr-mentor-card__actions">
            {{#if pointBuySpent}}
              <span class="attr-mentor-card__budget">{{pointBuySpent}} / {{../pointBuyPool}} points</span>
            {{else}}
              <span class="attr-mentor-card__budget">{{poolSource}}</span>
            {{/if}}
            <button type="button" class="prog-btn prog-btn--primary" data-build-apply="{{id}}">Apply Build</button>
          </div>
        </div>

        <div class="attr-mentor-card__stats">
          {{#each displayRows}}
            <div class="attr-mentor-stat swse-ability-surface swse-ability-surface--{{id}}" data-ability="{{id}}">
              <div class="attr-mentor-stat__label swse-ability-label swse-ability-label--{{id}}" data-ability="{{id}}">{{label}}</div>
              {{!-- Collapsed: the two numbers players need for a quick comparison. --}}
              <div class="attr-mentor-stat__compact">
                <div class="attr-mentor-stat__compact-values">
                  <span class="attr-mentor-stat__final">{{final}}</span>
                  <span class="attr-mentor-stat__mod swse-signed-number {{modifierClass}}">({{modifier}})</span>
                </div>
                <div class="attr-mentor-stat__compact-labels">
                  <span>Total</span><span>Mod</span>
                </div>
              </div>

              {{!-- Expanded: each caption lives directly below its own number. --}}
              <div class="attr-mentor-stat__breakdown">
                <div class="attr-mentor-stat__breakdown-values">
                  <span class="attr-mentor-stat__base">{{base}}</span>
                  <span class="attr-mentor-stat__species swse-signed-number {{speciesModClass}}">{{speciesModFormatted}}</span>
                  <span class="attr-mentor-stat__final">{{final}}</span>
                  <span class="attr-mentor-stat__mod swse-signed-number {{modifierClass}}">{{modifier}}</span>
                </div>
                <div class="attr-mentor-stat__breakdown-labels">
                  <span>Base</span><span>Species</span><span>Total</span><span>Mod</span>
                </div>
              </div>
            </div>
          {{/each}}
        </div>

        <button type="button"
                class="attr-mentor-card__toggle"
                data-build-toggle
                id="attr-mentor-build-tab-{{@index}}"
                aria-controls="attr-mentor-build-panel-{{@index}}"
                aria-expanded="false">
          <span>Why this build? <span class="attr-mentor-card__toggle-hint">Reasons, cautions &amp; forecast</span></span>
          <i class="fas fa-chevron-down attr-mentor-card__chevron" aria-hidden="true"></i>
        </button>
      </section>
    {{/each}}

    {{!-- The explanation appears AFTER all build previews. Opening the first
          build never pushes the second or third choice out of sight. --}}
    <div class="attr-mentor-dialog__explanations">
      {{#each builds}}
        <div class="attr-mentor-card__body"
             data-build-panel
             id="attr-mentor-build-panel-{{@index}}"
             role="region"
             aria-labelledby="attr-mentor-build-tab-{{@index}}"
             hidden>
          <div class="attr-mentor-card__explanation-title">
            Why {{title}}?
          </div>
          <div class="attr-mentor-card__details-grid">
            <div class="attr-mentor-detail-group">
              <div class="attr-mentor-detail-group__label">Reasons</div>
              <ul>
                {{#each reasons}}
                  <li>{{this}}</li>
                {{else}}
                  <li>No additional reasons provided.</li>
                {{/each}}
              </ul>
            </div>

            <div class="attr-mentor-detail-group">
              <div class="attr-mentor-detail-group__label">Cautions</div>
              <ul>
                {{#each cautions}}
                  <li>{{this}}</li>
                {{else}}
                  <li>No major caution beyond the normal tradeoff of specializing.</li>
                {{/each}}
              </ul>
            </div>

            <div class="attr-mentor-detail-group">
              <div class="attr-mentor-detail-group__label">Forecast</div>
              <ul>
                {{#each forecasts}}
                  <li>{{this}}</li>
                {{else}}
                  <li>This build keeps your next few steps flexible without overcommitting.</li>
                {{/each}}
              </ul>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  </div>
</div>
