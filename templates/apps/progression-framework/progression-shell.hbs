{{!--
  progression-shell.hbs
  Root template for the ProgressionShell.

  TWO RENDER MODES controlled by `isIntroMode`:

  INTRO MODE (isIntroMode = true)
    The shell renders as a clean boot/splash stage with no furniture.
    Only the work-surface fills the inner frame — no mentor rail, no step
    chips, no footer. The outer datapad frame (window chrome) persists.
    The intro's own Continue button is the sole action.

  NORMAL MODE (isIntroMode = false)
    6 named regions — all present:
      mentor-rail     Always visible; collapsible to portrait strip
      progress-rail   Step indicators
      utility-bar     Search/filter/sort; always present; collapsible
      work-surface    Primary step interaction area
      details-panel   Selected item details; always mounted; empty state when nothing focused
      action-footer   Back / Center status / Next/Confirm
      modal-host      In-shell modal stack
--}}

<div class="swse-datapad progression-shell swse-ui-shell swse-sheet-ui swse-progression-shell swse-prog-v2-shell prog-holo {{#if isProcessing}}is-processing{{/if}}"
     data-application-content
     data-step-id="{{currentDescriptor.stepId}}"
     data-theme="{{themeKey}}"
     data-motion-style="{{motionStyle}}"
     onpointerenter="import('/systems/foundryvtt-swse/scripts/apps/progression-framework/shell/progression-layout-observer.js').then(m=>m.observeProgressionLayout(this)); import('/systems/foundryvtt-swse/scripts/apps/progression-framework/shell/progression-rail-resizer.js').then(m=>m.hydrateProgressionRailSizes(this))"
     onfocusin="import('/systems/foundryvtt-swse/scripts/apps/progression-framework/shell/progression-layout-observer.js').then(m=>m.observeProgressionLayout(this)); import('/systems/foundryvtt-swse/scripts/apps/progression-framework/shell/progression-rail-resizer.js').then(m=>m.hydrateProgressionRailSizes(this))"
     style="{{{themeStyleInline}}}; {{{motionStyleInline}}};">
<div class="swse-screen">

{{#if isIntroMode}}

  {{!-- ======================================================================
    INTRO MODE — Boot/splash takeover.
    Single work-surface fills the entire shell interior.
    No mentor rail, no progress rail, no footer. Same outer frame.
  ======================================================================= --}}
  <div class="prog-intro-stage" data-region="work-surface">
    {{#if workSurfaceHtml}}
      {{{workSurfaceHtml}}}
    {{/if}}
  </div>

{{else}}

  {{!-- ======================================================================
    NORMAL MODE — Full shell furniture.
  ======================================================================= --}}

  {{!-- ======================================================================
    MENTOR NARRATOR — dedicated mentor rail with portrait + translated dialogue
  ======================================================================= --}}
  <div data-region="mentor-rail"
       data-collapsed="{{mentorCollapsed}}"
       data-mood="{{mentor.mood}}">
    {{#if parts.mentorRail}}
      {{{parts.mentorRail}}}
    {{else}}
      {{> "systems/foundryvtt-swse/templates/components/narrator.hbs"
          label=mentor.name
          avatar=mentor.portrait
          text=mentor.currentDialogue
      }}
    {{/if}}
  </div>{{!-- /mentor-rail --}}

  {{!-- ======================================================================
    HUD STATUS BAR — Session, mode, step meta (using foundation component)
  ======================================================================= --}}
  {{#if hudTags}}
  {{> "systems/foundryvtt-swse/templates/components/hud.hbs"
      title=(localize "SWSE.Progression.Shell.CharacterCreation")
      left=(array hudTags.modeTag hudTags.actorTag)
      right=(array hudTags.stageTag)
  }}

  <div class="prog-phase-banner">
    <div class="prog-phase-banner__title">{{localize "SWSE.Progression.Shell.TrainingMatrix"}}</div>
    <div class="prog-phase-banner__subtitle">{{localize "SWSE.Progression.Shell.TrainingMatrixSubtitle"}}</div>
  </div>
  {{/if}}

  {{!-- ======================================================================
    MAIN COLUMN — progress-rail (horizontal tabs) + utility-bar + content-row + action-footer
  ======================================================================= --}}
  <div class="prog-main-column">

    {{!-- ====================================================================
      PROGRESS RAIL — compact horizontal step progression
    ==================================================================== --}}
    <div data-region="progress-rail"
         data-collapsed="{{progressRailCollapsed}}">
      {{{parts.progressRail}}}
    </div>{{!-- /progress-rail --}}

    {{!-- ====================================================================
      DIAGNOSTIC BANNERS — Phase 8 hydration diagnostics (errors/warnings)
    ==================================================================== --}}
    {{> "systems/foundryvtt-swse/templates/apps/progression-framework/diagnostic-banner.hbs"}}

    {{!-- ====================================================================
      CONTENT ROW — summary-panel (left) + resizer + work-surface + resizer + details-panel
    ==================================================================== --}}
    <div class="prog-content-row" data-summary-collapsed="{{summaryPanelCollapsed}}">
      {{#if hasCollapsedTopRail}}
        <div class="prog-collapsed-rail-tray" aria-label="Collapsed progression rails">
          {{#if mentorCollapsed}}
            <button class="prog-collapsed-rail-tray__btn swse-ui-button" data-action="toggle-mentor" type="button" title="Restore mentor rail">
              <i class="fas fa-chevron-down"></i><span>Mentor</span>
            </button>
          {{/if}}
          {{#if progressRailCollapsed}}
            <button class="prog-collapsed-rail-tray__btn swse-ui-button" data-action="toggle-progress-rail" type="button" title="Restore step rail">
              <i class="fas fa-chevron-down"></i><span>Steps</span>
            </button>
          {{/if}}
          {{#if utilityBarCollapsed}}
            <button class="prog-collapsed-rail-tray__btn swse-ui-button" data-action="toggle-utility-bar" type="button" title="Restore utility rail">
              <i class="fas fa-chevron-down"></i><span>Tools</span>
            </button>
          {{/if}}
        </div>
      {{/if}}
      {{#if summaryPanelCollapsed}}
        <button class="prog-summary-restore swse-ui-button" data-action="toggle-summary-panel" type="button" title="Restore summary rail">
          <i class="fas fa-chevron-right"></i><span>Summary</span>
        </button>
      {{/if}}
      <div class="prog-content-gridline prog-content-gridline--h"></div>
      <div class="prog-content-gridline prog-content-gridline--v"></div>

      {{!-- ==================================================================
        SUMMARY PANEL — left column, compact build snapshot
      ================================================================== --}}
      <aside data-region="summary-panel"
             data-collapsed="{{summaryPanelCollapsed}}">

        <button class="prog-summary-panel__collapse swse-ui-button" data-action="toggle-summary-panel" type="button"
                title="{{#if summaryPanelCollapsed}}Restore summary rail{{else}}Collapse summary rail{{/if}}">
          <i class="fas fa-chevron-{{#if summaryPanelCollapsed}}right{{else}}left{{/if}}"></i>
          <span>{{#if summaryPanelCollapsed}}Summary{{else}}Hide{{/if}}</span>
        </button>

        <div class="prog-summary-panel__body">
        {{> "systems/foundryvtt-swse/templates/apps/progression-framework/summary-panel/summary-panel-body.hbs"}}
        </div>

      </aside>{{!-- /summary-panel --}}

      <div class="prog-rail-resizer prog-rail-resizer--summary"
           data-rail="summary"
           role="separator"
           aria-orientation="vertical"
           aria-label="Resize summary rail"
           tabindex="0"
           onpointerdown="import('/systems/foundryvtt-swse/scripts/apps/progression-framework/shell/progression-rail-resizer.js').then(m=>m.startProgressionRailResize(event,this))"
           onkeydown="import('/systems/foundryvtt-swse/scripts/apps/progression-framework/shell/progression-rail-resizer.js').then(m=>m.handleProgressionRailResizerKey(event,this))"
           ondblclick="import('/systems/foundryvtt-swse/scripts/apps/progression-framework/shell/progression-rail-resizer.js').then(m=>m.resetProgressionRailResize(event,this))"></div>

      {{!-- ==================================================================
        WORK SURFACE — center column, primary step interaction
      ================================================================== --}}
      <div data-region="work-surface">

        {{!-- PHASE 1 UX: Step context indicator --}}
        {{#if stepContext}}
        <div class="prog-step-context-banner">
          <span class="prog-step-counter">{{stepContext.displayText}}</span>
          {{#if currentDescriptor.label}}
            <span class="prog-step-label">— {{currentDescriptor.label}}</span>
          {{/if}}
        </div>
        {{/if}}

        {{!-- Inline utility rail: step search/filter/sort now lives at the top of the body rail. --}}
        <div class="prog-inline-utility-region"
             data-region="utility-bar"
             data-collapsed="{{utilityBarCollapsed}}"
             data-mode="{{utilityBarConfig.mode}}">
          {{{parts.utilityBar}}}
        </div>{{!-- /utility-bar --}}

        {{!-- Phase 2: stable mount boundary for JUST the plugin-generated body,
             so a scoped work-surface repaint can replace this wrapper's
             innerHTML without destroying the step-context banner or the
             nested utility-bar region above it. --}}
        <div data-prog-region-body="work-surface">
        {{#if workSurfaceHtml}}
          {{{workSurfaceHtml}}}
        {{else}}
          <div class="prog-work-placeholder swse-card-schema swse-card-schema--choice swse-card-schema--placeholder">
            {{#if currentDescriptor}}
              <div class="prog-work-placeholder__header prog-heading">
                <i class="fas {{currentDescriptor.icon}}"></i>
                {{currentDescriptor.label}}
                {{#if currentDescriptor.isConditional}}
                  <span class="prog-chip prog-chip--warning">
                    {{localize "SWSE.Progression.Shell.EngineUnlocked"}}
                  </span>
                {{/if}}
              </div>
              <p class="prog-work-placeholder__hint">
                {{localize "SWSE.Progression.Shell.StepOf" current=(add currentStepIndex 1) total=totalSteps}}
                {{#if currentDescriptor.isConditional}}
                  — {{localize "SWSE.Progression.Shell.UnlockedBy" reason=currentDescriptor.unlockReason}}
                {{/if}}
              </p>
              {{#if lastError}}
                <div class="prog-work-placeholder__error">
                  <i class="fas fa-exclamation-triangle"></i>
                  {{lastError.message}}
                </div>
              {{/if}}
            {{else}}
              <p class="prog-work-placeholder__empty">{{localize "SWSE.Progression.Shell.NoStepsAvailable"}}</p>
            {{/if}}
          </div>
        {{/if}}
        </div>{{!-- /[data-prog-region-body="work-surface"] --}}

      </div>{{!-- /work-surface --}}

      <div class="prog-rail-resizer prog-rail-resizer--details"
           data-rail="details"
           role="separator"
           aria-orientation="vertical"
           aria-label="Resize details rail"
           tabindex="0"
           onpointerdown="import('/systems/foundryvtt-swse/scripts/apps/progression-framework/shell/progression-rail-resizer.js').then(m=>m.startProgressionRailResize(event,this))"
           onkeydown="import('/systems/foundryvtt-swse/scripts/apps/progression-framework/shell/progression-rail-resizer.js').then(m=>m.handleProgressionRailResizerKey(event,this))"
           ondblclick="import('/systems/foundryvtt-swse/scripts/apps/progression-framework/shell/progression-rail-resizer.js').then(m=>m.resetProgressionRailResize(event,this))"></div>

      {{!-- ==================================================================
        DETAILS PANEL — always mounted on desktop; empty state when nothing focused
      ================================================================== --}}
      <div data-region="details-panel" class="prog-details-panel-no-frame">

        {{#if detailsPanelHtml}}
          {{{detailsPanelHtml}}}
        {{else}}
          <div class="prog-details-placeholder prog-details-placeholder--no-frame swse-card-schema swse-card-schema--enumerated swse-card-schema--placeholder">
            {{#if focusedItem}}
              <div class="prog-details-placeholder__name prog-heading">
                {{focusedItem.name}}
              </div>
              <div class="prog-details-placeholder__content">
                <p>{{focusedItem.description}}</p>
              </div>
            {{else}}
              {{#if currentDescriptor}}
                <div class="prog-details-placeholder__empty">
                  <i class="fas {{currentDescriptor.icon}} prog-details-placeholder__empty-icon"></i>
                  <p>Select an item to see details.</p>
                </div>
              {{/if}}
            {{/if}}
          </div>
        {{/if}}

      </div>{{!-- /details-panel --}}

    </div>{{!-- /content-row --}}


    {{!-- ====================================================================
      ACTION FOOTER — Back | Step Chips | Confirm
      Three-column grid: nav anchor | step chips | confirm anchor
      Step chips use SVG frame backgrounds per state (current/complete/locked/warning).
      data-font-mode controls label font-family: 'standard' | 'aurabesh'
    ==================================================================== --}}
    <div data-region="action-footer" class="swse-ui-frame swse-progression-footer-frame">
      {{> "systems/foundryvtt-swse/templates/apps/progression-framework/action-footer.hbs"}}
    </div>{{!-- /action-footer --}}

  </div>{{!-- /main-column --}}


  {{!-- ======================================================================
    MODAL HOST — in-shell modal stack
  ======================================================================= --}}
  <div data-region="modal-host"></div>

{{/if}}{{!-- /isIntroMode --}}

</div>{{!-- /swse-screen --}}
</div>{{!-- /swse-datapad progression-shell --}}
