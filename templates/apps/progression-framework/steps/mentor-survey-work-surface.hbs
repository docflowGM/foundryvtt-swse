<div class="prog-l1-survey-shell">
  <section class="prog-l1-survey-stage">
    <div class="prog-l1-survey-stage__mentor-frame">
      <div class="prog-l1-survey-stage__mentor-lines"></div>
      <div class="prog-l1-survey-stage__mentor-portrait prog-holo-media prog-holo-media--portrait">
        {{{mentorPortraitMarkup}}}
        <div class="prog-l1-survey-stage__mentor-scan"></div>
        <div class="prog-l1-survey-stage__mentor-nameplate">
          <span class="prog-l1-survey-stage__mentor-name">{{mentorName}}</span>
          {{#if mentorTitle}}<span class="prog-l1-survey-stage__mentor-title">{{mentorTitle}}</span>{{/if}}
        </div>
      </div>
    </div>

    <div class="prog-l1-survey-stage__dialogue-panel" data-phase="{{phase}}">
      <div class="prog-l1-survey-stage__header">
        <div>
          <div class="prog-l1-survey-stage__eyebrow">Mentor Interview{{#if preview}} · EDITORIAL PREVIEW (not approved content){{/if}}</div>
          <h2 class="prog-l1-survey-stage__title">{{title}}</h2>
          <div class="prog-l1-survey-stage__subtitle">Optional. You can skip any question, or the whole interview.</div>
        </div>
        {{#if progressDots.length}}
        <div class="prog-l1-survey-stage__progress" aria-label="Interview progress">
          {{#each progressDots}}<span class="prog-l1-survey-stage__progress-dot {{#if isDone}}is-done{{/if}} {{#if isActive}}is-active{{/if}}"></span>{{/each}}
        </div>
        {{/if}}
      </div>

      {{#if (eq phase "unavailable")}}
      <div class="prog-l1-survey-stage__dialogue-text is-intro">{{unavailableText}}</div>
      {{/if}}

      {{#if (eq phase "skipped")}}
      <div class="prog-l1-survey-stage__dialogue-text is-intro">You skipped the interview. Nothing was recorded.</div>
      <div class="prog-l1-survey-stage__command-row">
        <button type="button" class="swse-btn swse-ui-button swse-btn--secondary prog-l1-survey-stage__command" data-action="msurvey-retake">Take the interview</button>
      </div>
      {{/if}}

      {{#if (eq phase "question")}}
      <div class="prog-l1-survey-stage__question-block">
        <div class="prog-l1-survey-stage__question-kicker">Question {{questionNumber}} of {{totalQuestions}}</div>
        {{#if view.mentorIntro}}<div class="prog-l1-survey-stage__dialogue-text" data-l1-survey-dialogue-text>{{view.mentorIntro}}</div>{{/if}}
        {{#if view.situation}}<div class="prog-l1-survey-stage__dialogue-text" data-l1-survey-dialogue-text>{{view.situation}}</div>{{/if}}
        {{#if view.prompt}}<div class="prog-l1-survey-stage__dialogue-text" data-l1-survey-dialogue-text>{{view.prompt}}</div>{{/if}}
        {{#if staleNotice}}<div class="prog-l1-survey-stage__subtitle">{{staleNotice}}</div>{{/if}}
      </div>
      <div class="prog-l1-survey-stage__choices">
        {{#each view.options}}
        <button type="button" class="prog-l1-survey-stage__choice {{#if (eq this.optionId ../selectedOptionId)}}is-selected{{/if}}"
                data-action="msurvey-choose" data-question-id="{{../view.questionId}}" data-option-id="{{this.optionId}}" data-seq="{{../seq}}">
          <span class="prog-l1-survey-stage__choice-copy"><span class="prog-l1-survey-stage__choice-label">{{this.text}}</span></span>
        </button>
        {{/each}}
        {{#if view.page.hasMore}}
        <button type="button" class="prog-l1-survey-stage__choice" data-action="msurvey-more" data-question-id="{{view.questionId}}" data-seq="{{seq}}">
          <span class="prog-l1-survey-stage__choice-copy"><span class="prog-l1-survey-stage__choice-label">{{view.page.moreText}}</span></span>
        </button>
        {{/if}}
      </div>
      <div class="prog-l1-survey-stage__command-row">
        {{#if canGoBack}}<button type="button" class="swse-btn swse-ui-button swse-btn--secondary prog-l1-survey-stage__command" data-action="msurvey-back" data-seq="{{seq}}">Previous question</button>{{/if}}
        {{#if reconfirm}}<button type="button" class="swse-btn swse-ui-button swse-btn--secondary prog-l1-survey-stage__command" data-action="msurvey-reconfirm" data-question-id="{{view.questionId}}" data-seq="{{seq}}">Keep my earlier answer</button>{{/if}}
        <button type="button" class="swse-btn swse-ui-button swse-btn--secondary prog-l1-survey-stage__command" data-action="msurvey-skip-question" data-question-id="{{view.questionId}}" data-seq="{{seq}}">Skip this question</button>
        <button type="button" class="swse-btn swse-ui-button swse-btn--secondary prog-l1-survey-stage__command" data-action="msurvey-skip-survey" data-seq="{{seq}}">Skip the interview</button>
      </div>
      {{/if}}

      {{#if (eq phase "ready")}}
      <div class="prog-l1-survey-stage__dialogue-text is-complete">That is everything I wanted to ask. Finish when you are ready, or go back and change an answer.</div>
      <div class="prog-l1-survey-stage__command-row">
        <button type="button" class="swse-btn swse-ui-button swse-btn--secondary prog-l1-survey-stage__command" data-action="msurvey-back" data-seq="{{seq}}">Previous question</button>
        <button type="button" class="swse-btn swse-ui-button swse-btn--advance-ready prog-l1-survey-stage__command" data-action="msurvey-finish" data-seq="{{seq}}">Finish the interview</button>
      </div>
      {{/if}}

      {{#if (eq phase "complete")}}
      <div class="prog-l1-survey-stage__dialogue-text is-complete">Thank you. Your answers are noted and will be saved when you finish creating your character.</div>
      <div class="prog-l1-survey-stage__command-row">
        <button type="button" class="swse-btn swse-ui-button swse-btn--secondary prog-l1-survey-stage__command" data-action="msurvey-change">Change my answers</button>
        <button type="button" class="swse-btn swse-ui-button swse-btn--secondary prog-l1-survey-stage__command" data-action="msurvey-retake">Start over</button>
      </div>
      {{/if}}
    </div>
  </section>
</div>
