<div class="prog-galactic-profile prog-galactic-profile--review gpux gpux-review">
  <header class="gpux-header">
    <div>
      <div class="gpux-eyebrow">Galactic Profiles / Character Creation</div>
      <h2>Review your starting character</h2>
      <p>See what the preset proposes, and what the rules engine still needs you to choose.</p>
    </div>
    <span class="gpux-stage" aria-label="Profile review, stage two of two">02 / 02</span>
  </header>

  {{#if template}}
    <section class="gpux-review-layout">
      <article class="gpux-review-primary">
        <div class="gpux-identity-row">
          <div class="gpux-review-photo holo-img"><img src="{{template.image}}" alt="{{template.name}}" /></div>
          <div class="gpux-identity-copy">
            <div class="gpux-eyebrow">{{template.className}} / {{template.species}}</div>
            <h3>{{template.archetype}}</h3>
            <p>{{template.description}}</p>
            <label class="gpux-name-label" for="gpux-character-name">Character name</label>
            <input id="gpux-character-name" type="text" data-profile-character-name maxlength="64"
              value="{{characterName}}" placeholder="Enter character name" autocomplete="off" />
          </div>
        </div>

        {{#if template.blocked.length}}
          <section class="gpux-validation is-blocked" role="alert" aria-label="Profile unavailable">
            <h4><i class="fas fa-triangle-exclamation"></i> This preset needs correction</h4>
            <p>This starting package contains unresolved rules or source data. You cannot apply it until the preset itself is corrected. You can return to the gallery and choose another character.</p>
            <details>
              <summary>Show technical validation reasons</summary>
              <ul>{{#each template.blocked}}
                <li>{{text}}{{#if detail}} <code>{{detail}}</code>{{/if}}</li>
              {{/each}}</ul>
            </details>
          </section>
        {{/if}}

        <section class="gpux-review-summary" aria-label="Authored profile preview">
          <h4>Starting build preview</h4>
          <p class="gpux-caption">These are the profile's authored choices, not a promise of unearned grants. The V2 compiler determines what can actually be applied.</p>
          <div class="gpux-review-basics">
            <span><small>Class</small><strong>{{template.className}}</strong></span>
            <span><small>Species</small><strong>{{template.species}}</strong></span>
            <span><small>Background</small><strong>{{template.background}}</strong></span>
            <span><small>Credits</small><strong>{{template.credits}}</strong></span>
          </div>
          <div class="gpux-abilities gpux-review-abilities">
            {{#each template.abilities}}
              <span class="gpux-ability"><b>{{label}}</b><strong>{{score}}</strong><small class="mod-{{modClass}}">{{mod}}</small></span>
            {{/each}}
          </div>
          <details class="gpux-package-details">
            <summary>View proposed skills, feats, talents and equipment</summary>
            <div class="gpux-package-grid">
              <div><h5>Trained skills ({{template.skills.length}})</h5><p>{{#each template.skills}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p></div>
              <div><h5>Feats ({{template.feats.length}})</h5><p>{{#each template.feats}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p></div>
              <div><h5>Talents ({{template.talents.length}})</h5><p>{{#each template.talents}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p></div>
              <div><h5>Force powers ({{template.forcePowers.length}})</h5><p>{{#each template.forcePowers}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p></div>
              <div class="gpux-wide"><h5>Equipment ({{template.equipment.length}})</h5><p>{{#each template.equipment}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p></div>
            </div>
          </details>
        </section>

        {{#if template.reconciliationNotes.length}}
          <details class="gpux-reconciliation">
            <summary>Rules reconciliation notes ({{template.reconciliationNotes.length}})</summary>
            <ul>{{#each template.reconciliationNotes}}<li>{{this}}</li>{{/each}}</ul>
          </details>
        {{/if}}
      </article>

      <aside class="gpux-review-next" aria-label="Next steps">
        <div class="gpux-eyebrow">What happens next?</div>
        {{#if template.openCount}}
          <h3>{{template.openCount}} {{#if template.isApplied}}remaining{{else}}expected{{/if}} choices</h3>
          <p>The V2 progression engine will guide you to the choices this preset does not satisfy.</p>
          <ol class="gpux-work-list">
            {{#each template.openBusiness}}
              <li>
                {{#if ../template.isApplied}}
                  <button type="button" data-action="profile-resolve" data-profile-business-target="{{stepId}}" class="gpux-work-link">
                    <strong>{{label}}</strong><span>{{detail}}</span><em>Open</em>
                  </button>
                {{else}}
                  <div class="gpux-work-static"><strong>{{label}}</strong><span>{{detail}}</span></div>
                {{/if}}
              </li>
            {{/each}}
          </ol>
        {{else}}
          <h3>No additional choices identified</h3>
          <p>If the profile validates, it can proceed to the normal final confirmation.</p>
        {{/if}}

        {{#if template.mentorLine}}
          <div class="gpux-mentor-line"><strong>Mentor</strong><blockquote>{{template.mentorLine}}</blockquote></div>
        {{/if}}

        {{#if template.canApply}}
          <button type="button" class="gpux-apply" data-action="profile-apply"
            {{#if template.isApplied}}aria-pressed="true"{{/if}}>
            <i class="fas {{#if template.isApplied}}fa-check{{else}}fa-id-card{{/if}}"></i>
            {{#if template.isApplied}}Profile applied{{else}}Apply profile and continue{{/if}}
          </button>
          <p class="gpux-caption">This fills a draft. Your actor is not created until final confirmation.</p>
        {{else}}
          <button type="button" class="gpux-apply" disabled aria-disabled="true">Profile unavailable</button>
          <button type="button" class="gpux-back-to-gallery" data-action="previous-step">Choose another profile</button>
        {{/if}}
      </aside>
    </section>
  {{else}}
    <section class="gpux-validation is-blocked" role="alert">
      <h3>No profile selected</h3>
      <p>Choose a profile in the gallery before continuing.</p>
      <button type="button" class="gpux-back-to-gallery" data-action="previous-step">Return to gallery</button>
    </section>
  {{/if}}
</div>
