<div class="prog-galactic-profile prog-galactic-profile--archetype gpux">
  <header class="gpux-header">
    <div>
      <div class="gpux-eyebrow">Galactic Profiles / Character Creation</div>
      <h2>Choose your path</h2>
      <p>Explore the profiles below. Select the character concept you want to play.</p>
    </div>
    <span class="gpux-stage" aria-label="Profile selection, stage one of two">01 / 02</span>
  </header>

  <div class="gpux-toolbar">
    <nav class="gpux-class-filters" aria-label="Browse profiles by starting class">
      <button type="button" class="gpux-filter {{#if allClassesBrowsing}}is-active{{/if}}"
        data-action="profile-filter-class" data-profile-class-id="all"
        aria-pressed="{{#if allClassesBrowsing}}true{{else}}false{{/if}}">
        All classes <small>{{allProfileCount}}</small>
      </button>
      {{#each classes}}
        <button type="button" class="gpux-filter {{#if browsing}}is-active{{/if}}"
          data-action="profile-filter-class" data-profile-class-id="{{id}}"
          aria-pressed="{{#if browsing}}true{{else}}false{{/if}}">
          {{name}} <small>{{count}}</small>
        </button>
      {{/each}}
    </nav>
    <label class="gpux-search">
      <span class="sr-only">Search Galactic Profiles</span>
      <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
      <input type="search" data-profile-gallery-search value="{{gallerySearch}}"
        placeholder="Search profiles, species or roles" autocomplete="off" />
    </label>
  </div>

  <div class="gpux-browser-layout">
    <section class="gpux-gallery" aria-label="Available Galactic Profiles">
      <header class="gpux-gallery-heading">
        <div><strong>{{browseLabel}}</strong><span>Click an illustrated profile to preview it</span></div>
        <span data-profile-gallery-results aria-live="polite">{{totalProfiles}} profiles found</span>
      </header>
      <div class="gpux-cards">
        {{#each archetypes}}
          <button type="button"
            class="gpux-card prog-profile-archetype-card {{#if selected}}is-selected{{/if}}"
            data-action="profile-select-template" data-profile-template-id="{{id}}"
            data-profile-search-text="{{searchText}}"
            aria-pressed="{{#if selected}}true{{else}}false{{/if}}"
            aria-label="{{archetype}}. {{className}}. {{description}}">
            <span class="gpux-card-art holo-img" aria-hidden="true">
              <img src="{{image}}" alt="" loading="lazy" decoding="async" />
            </span>
            <span class="gpux-card-info">
              <strong>{{archetype}}</strong>
              <em>{{className}}{{#if species}} / {{species}}{{/if}}</em>
            </span>
            {{#if selected}}
              <span class="gpux-card-selected" aria-hidden="true"><i class="fas fa-check"></i> Selected</span>
            {{/if}}
          </button>
        {{/each}}
      </div>
      {{#unless allProfileCount}}
        <p class="gpux-empty" role="status">No Galactic Profiles are available for this character type.</p>
      {{/unless}}
      <p class="gpux-empty" data-profile-gallery-empty hidden>No profiles match this search. Clear your search or choose another class.</p>
    </section>

    <aside class="gpux-preview" aria-label="Selected Galactic Profile preview">
      {{#if selectedPreview}}
        <div class="gpux-eyebrow">Your selected character concept</div>
        <h3>{{selectedPreview.archetype}}</h3>
        <p class="gpux-preview-class">{{selectedPreview.className}}{{#if selectedPreview.species}} / {{selectedPreview.species}}{{/if}}</p>
        <p class="gpux-description">{{selectedPreview.description}}</p>
        {{#if selectedPreview.roles}}
          <div class="gpux-tags" aria-label="Character roles">
            {{#each selectedPreview.roles}}<span>{{this}}</span>{{/each}}
          </div>
        {{/if}}
        <h4>Starting attributes</h4>
        <div class="gpux-abilities">
          {{#each selectedPreview.abilities}}
            <span class="gpux-ability"><b>{{label}}</b><strong>{{score}}</strong><small class="mod-{{modClass}}">{{mod}}</small></span>
          {{/each}}
        </div>
        {{#if selectedPreview.quote}}
          <div class="gpux-mentor-line">
            <strong>Mentor's insight</strong>
            <blockquote>{{selectedPreview.quote}}</blockquote>
          </div>
        {{/if}}
        <p class="gpux-next-hint"><i class="fas fa-check-circle"></i> Profile selected. Choose <strong>Next</strong> below to review its starting package.</p>
      {{else}}
        <div class="gpux-preview-empty">
          <i class="fas fa-id-card" aria-hidden="true"></i>
          <h3>Select a profile</h3>
          <p>Choose an illustrated card to see its abilities, playstyle and mentor guidance here.</p>
        </div>
      {{/if}}
    </aside>
  </div>
</div>
