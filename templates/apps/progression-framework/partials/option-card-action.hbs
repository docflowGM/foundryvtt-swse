{{!--
  Progression option-card action.

  Every conventional candidate card carries this control, so a player who
  already knows what they want never has to route through the detail rail
  first. The card body stays the inspection control (focus-item); this is the
  commit control.

  Presentation only. It renders a button carrying the step's OWN canonical
  action — `action` defaults to commit-item because that is what every detail
  rail already uses, and steps with a specialised canonical action
  (increment-quantity, select-language, enter-tree) pass theirs instead. There
  is therefore exactly one commit route per step, not a parallel one.

  It decides NOTHING about legality. Whether a feat, talent, power, technique,
  secret or maneuver may be taken is the owning step's judgement; this renders
  the state that step supplies. Adding a prerequisite check here would create a
  second, silently diverging copy of the rules.

  Bespoke interaction steps — Attributes, Skills — keep their purpose-built
  controls and deliberately do not use this partial.

  The shell's double-click handler prefers a card's marked action, which makes
  this control the single source of truth for what double-clicking a card does.

  Parameters:
    action     canonical data-action (default: commit-item)
    itemId     value for data-item-id
    idAttr     optional extra identity attribute name (e.g. "data-power-id")
    idValue    value for idAttr
    name       candidate name, used to build the aria-label
    verb       aria/label verb (default "Select")
    label      explicit label override
    title      tooltip carrying the step-specific meaning
    state      owned | granted | locked | unavailable | maximum | again
               (drives both the label and the state class)
    selected   currently chosen
    deselect   selected AND removable through the same action
    disabled   render disabled
    useEnabled pass with `enabled` when the step supplies a can-act flag
    enabled    when useEnabled is set, falsy renders the control disabled
    icon       optional Font Awesome class
    compact    tighter styling for dense rows
--}}
<button type="button"
        class="prog-btn prog-btn--small progression-option-card__select{{#if compact}} progression-option-card__select--compact{{/if}}{{#if selected}} prog-btn--selected{{/if}}{{#if state}} progression-option-card__select--{{state}}{{/if}}"
        data-action="{{#if action}}{{action}}{{else}}commit-item{{/if}}"
        {{#if itemId}}data-item-id="{{itemId}}"{{/if}}
        {{#if idAttr}}{{idAttr}}="{{idValue}}"{{/if}}
        data-card-action="true"
        data-card-action-state="{{#if state}}{{state}}{{else}}{{#if deselect}}deselect{{else}}{{#if selected}}selected{{else}}select{{/if}}{{/if}}{{/if}}"
        {{#if title}}title="{{title}}"{{/if}}
        aria-label="{{#if verb}}{{verb}}{{else}}Select{{/if}}{{#if name}} {{name}}{{/if}}"
        {{#if disabled}}disabled aria-disabled="true"{{else}}{{#if useEnabled}}{{#unless enabled}}disabled aria-disabled="true"{{/unless}}{{/if}}{{/if}}>
  {{#if icon}}<i class="{{icon}}" aria-hidden="true"></i> {{/if}}
  {{~#if label}}{{label}}
  {{~else}}
    {{~#if state}}
      {{~#if (eq state "owned")}}OWNED
      {{~else if (eq state "granted")}}GRANTED
      {{~else if (eq state "locked")}}LOCKED
      {{~else if (eq state "unavailable")}}UNAVAILABLE
      {{~else if (eq state "maximum")}}MAXIMUM
      {{~else if (eq state "again")}}SELECT AGAIN
      {{~else}}SELECT{{/if}}
    {{~else}}
      {{~#if deselect}}DESELECT{{else}}{{#if selected}}SELECTED{{else}}SELECT{{/if}}{{/if}}
    {{~/if}}
  {{~/if}}
</button>
