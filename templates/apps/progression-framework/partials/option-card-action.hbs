{{!--
  Universal progression option-card action.

  Every selectable candidate carries this control, so a player who already knows
  what they want never has to route through the detail rail first. The card body
  stays the inspection control (focus-item); this is the commit control.

  It is presentation only and adds no selection logic: it renders a button
  carrying the step's OWN canonical action. `action` defaults to commit-item
  because that is what every detail rail already uses, and steps with a
  specialised canonical action (skill-train, select-language,
  increment-quantity, enter-tree) pass theirs instead. There is therefore exactly
  one commit route per step, not a parallel one.

  The shell's double-click handler prefers a card's nested action button, which
  makes this control the single source of truth for what double-clicking a card
  does.

  Label/state are derived here rather than at each call site so the vocabulary
  stays consistent. Only `eq` is used as a subexpression helper — it is one of
  the repo's registered helpers.

  Parameters:
    action     canonical data-action (default: commit-item)
    itemId     value for data-item-id
    idAttr     optional extra identity attribute name (e.g. "data-skill-key")
    idValue    value for idAttr
    name       candidate name, used to build the aria-label
    verb       aria/label verb (default "Select")
    label      explicit label override
    title      tooltip carrying the step-specific meaning ("Train this skill")
    selected   currently chosen
    deselect   selected AND removable through the same action
    disabled   render disabled
    useEnabled pass with `enabled` when the step already computes a can-add flag
    enabled    when useEnabled is set, falsy renders the control disabled
    state      explicit state override:
               select | selected | deselect | locked | owned | granted | unavailable
--}}
<button type="button"
        class="prog-btn prog-btn--small progression-option-card__select{{#if selected}} prog-btn--selected{{/if}}"
        data-action="{{#if action}}{{action}}{{else}}commit-item{{/if}}"
        {{#if itemId}}data-item-id="{{itemId}}"{{/if}}
        {{#if idAttr}}{{idAttr}}="{{idValue}}"{{/if}}
        data-card-action="true"
        data-card-action-state="{{#if state}}{{state}}{{else}}{{#if deselect}}deselect{{else}}{{#if selected}}selected{{else}}select{{/if}}{{/if}}{{/if}}"
        {{#if title}}title="{{title}}"{{/if}}
        aria-label="{{#if verb}}{{verb}}{{else}}Select{{/if}}{{#if name}} {{name}}{{/if}}"
        {{#if disabled}}disabled aria-disabled="true"{{else}}{{#if useEnabled}}{{#unless enabled}}disabled aria-disabled="true"{{/unless}}{{/if}}{{/if}}>
  {{#if label}}{{label}}{{else}}{{#if deselect}}DESELECT{{else}}{{#if selected}}SELECTED{{else}}SELECT{{/if}}{{/if}}{{/if}}
</button>
