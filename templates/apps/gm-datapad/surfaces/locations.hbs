<div class="gm-datapad-page gm-datapad-locations swse-gm-locations gm-v2-surface gm-v2-surface--locations gm-phase5-locations gm-location-ux" data-shell-surface="locations" data-gm-surface="locations">
  <header class="gm-datapad-page-header swse-locations-hero gm-phase5-location-hero gm-location-ux-hero gm-location-page-header">
    <div class="gm-phase5-location-hero__copy gm-location-page-heading">
      <span class="gm-location-eyebrow">Campaign Hub · Astrogation Registry</span>
      <h2>{{surface.pageTitle}}</h2>
      <p>{{surface.pageDescription}}</p>
    </div>
    <div class="swse-location-stat-grid gm-phase5-location-metrics gm-location-page-metrics" aria-label="Location registry summary">
      <div class="gm-location-page-metric"><span>Locations</span><strong>{{surface.locationManager.stats.total}}</strong></div>
      <div class="gm-location-page-metric"><span>Revealed</span><strong>{{surface.locationManager.stats.revealedCount}}</strong></div>
      <div class="gm-location-page-metric"><span>Unresolved Leads</span><strong>{{surface.locationManager.stats.leadDiscoveryCount}}</strong></div>
      <div class="gm-location-page-metric"><span>Scenes</span><strong>{{surface.locationManager.stats.withScenes}}</strong></div>
    </div>
  </header>

  <section class="gm-location-command-deck gm-location-command-deck--primary">
    <button type="button" class="gm-location-command-card gm-location-command-card--import" data-location-action="open-import-modal">
      <span class="gm-phase5-location-eyebrow">Quick Library</span>
      <strong>Import Location</strong>
      <p>Open a guided importer for {{surface.locationManager.library.summary.total}} quick planets. Import one or more with starter POIs and Atlas facts.</p>
      <em>{{surface.locationManager.library.summary.unimportedVisible}} matching unimported · {{surface.locationManager.library.summary.totalRecordCount}} possible records</em>
    </button>
    <button type="button" class="gm-location-command-card gm-location-command-card--create" data-location-action="new">
      <span class="gm-phase5-location-eyebrow">Creation Wizard</span>
      <strong>New Location</strong>
      <p>Build a planet, city, POI, base, ship, station, or strange site through a guided modal wizard.</p>
      <em>No blank dropdowns. Pick answers step by step.</em>
    </button>
    {{#if surface.locationManager.selected}}
      <button type="button" class="gm-location-command-card gm-location-command-card--edit" data-location-action="edit" data-location-id="{{surface.locationManager.selected.id}}">
        <span class="gm-phase5-location-eyebrow">Selected Dossier</span>
        <strong>Edit {{surface.locationManager.selected.name}}</strong>
        <p>Open this location in the guided wizard, then reveal, activate, or link it to Jobs/Intel/Scenes.</p>
        <em>{{surface.locationManager.selected.revealLabel}} · {{surface.locationManager.selected.typeLabel}}</em>
      </button>
    {{/if}}
  </section>

  <section class="gm-location-library-strip">
    <div>
      <span class="gm-phase5-location-eyebrow">Quick Location Library</span>
      <h3>{{surface.locationManager.library.summary.visible}} quick planets ready</h3>
      <p>These are not imported Atlas records yet. Use <strong>Import Location</strong> to choose one or more, or use the visible cards below as a preview of what the modal will offer.</p>
    </div>
    <div class="gm-location-library-strip__cards">
      {{#each surface.locationManager.library.previewCards}}
        <button type="button" class="gm-location-library-preview {{#if imported}}is-imported{{/if}}" data-location-action="open-import-modal">
          <strong>{{name}}</strong>
          <span>{{typeLabel}} · {{recordLabel}}</span>
        </button>
      {{else}}
        <span class="gm-location-library-preview is-empty">No quick library matches current filters.</span>
      {{/each}}
    </div>
  </section>

  <section class="swse-location-panel gm-phase5-location-panel gm-location-lead-queue">
    <div class="swse-location-panel-head gm-phase5-location-panel-head">
      <div>
        <span class="gm-phase5-location-eyebrow">Atlas Operations</span>
        <h3>Atlas Lead Queue</h3>
      </div>
      <span class="swse-location-chip">{{surface.locationManager.leadQueue.length}} unresolved</span>
    </div>
    {{#each surface.locationManager.leadQueue}}
      <div class="gm-location-fact-row gm-location-lead-row {{#if isSelectedLocation}}is-selected-location{{/if}}">
        <strong>{{factTitle}}</strong>
        <span>{{actorName}} at <button type="button" class="gm-location-linked-row" data-location-action="lead-select-location" data-location-id="{{locationId}}">{{locationName}}</button></span>
        <span>{{skillLabel}} DC {{dc}}{{#if checkLabel}} ({{checkLabel}}){{/if}} · discovered {{updatedLabel}}</span>
        <div>
          <button type="button" data-location-action="lead-create-intel" data-actor-id="{{actorId}}" data-discovery-id="{{id}}">Create Intel</button>
          <button type="button" data-location-action="lead-create-job" data-actor-id="{{actorId}}" data-discovery-id="{{id}}">Create Job</button>
          {{#if hasRevealLinks}}
            <button type="button" data-location-action="lead-reveal-links" data-actor-id="{{actorId}}" data-discovery-id="{{id}}">Reveal Links</button>
          {{/if}}
          <button type="button" class="danger" data-location-action="lead-resolve" data-actor-id="{{actorId}}" data-discovery-id="{{id}}">Resolve</button>
        </div>
      </div>
    {{else}}
      <p class="swse-empty-state">No unresolved Atlas leads.</p>
    {{/each}}
  </section>

  <section class="gm-location-workbench">
    <aside class="gm-location-browser">
      <section class="swse-location-panel gm-phase5-location-panel gm-location-browser-filters">
        <div class="swse-location-panel-head gm-phase5-location-panel-head">
          <div>
            <span class="gm-phase5-location-eyebrow">Navigator</span>
            <h3>Find Locations</h3>
          </div>
          <span class="swse-location-chip">{{surface.locationManager.cards.length}} shown</span>
        </div>
        <label class="swse-location-field swse-location-field--wide">
          <span>Search</span>
          <input type="search" value="{{surface.locationManager.filters.search}}" data-location-filter="search" placeholder="planet, city, POI, faction, tag..." />
        </label>
        <div class="gm-location-filter-section">
          <span>Category</span>
          <div class="gm-location-filter-pills">
            {{#each surface.locationManager.categoryFilterButtons}}
              <button type="button" class="gm-location-filter-pill {{#if selected}}is-active{{/if}}" data-location-filter-button data-filter-key="category" data-filter-value="{{value}}">{{label}}</button>
            {{/each}}
          </div>
        </div>
        <div class="gm-location-filter-section">
          <span>Type</span>
          <div class="gm-location-filter-pills gm-location-filter-pills--scroll">
            {{#each surface.locationManager.typeFilterButtons}}
              <button type="button" class="gm-location-filter-pill {{#if selected}}is-active{{/if}}" data-location-filter-button data-filter-key="type" data-filter-value="{{value}}">{{label}}</button>
            {{/each}}
          </div>
        </div>
        <div class="gm-location-filter-section">
          <span>Reveal</span>
          <div class="gm-location-filter-pills">
            {{#each surface.locationManager.revealFilterButtons}}
              <button type="button" class="gm-location-filter-pill {{#if selected}}is-active{{/if}}" data-location-filter-button data-filter-key="revealState" data-filter-value="{{value}}">{{label}}</button>
            {{/each}}
          </div>
        </div>
        <div class="gm-location-filter-section">
          <span>Quick Filter</span>
          <div class="gm-location-filter-pills">
            {{#each surface.locationManager.specialFilterButtons}}
              <button type="button" class="gm-location-filter-pill {{#if selected}}is-active{{/if}}" data-location-filter-button data-filter-key="special" data-filter-value="{{value}}">{{label}}</button>
            {{/each}}
          </div>
        </div>
      </section>

      <section class="swse-location-panel gm-phase5-location-panel gm-location-browser-list">
        <div class="swse-location-panel-head gm-phase5-location-panel-head">
          <div>
            <span class="gm-phase5-location-eyebrow">Registry</span>
            <h3>Location Library</h3>
          </div>
        </div>
        {{#if surface.locationManager.hasVisibleLocations}}
          <div class="gm-location-card-stack" role="list">
            {{#each surface.locationManager.cards}}
              <button type="button"
                      class="swse-location-card gm-location-registry-card {{revealClass}} {{#if activeForParty}}is-party-active{{/if}} {{depthClass}} {{#if selected}}is-selected{{/if}} {{#if isCurrent}}is-current{{/if}} {{#if isHidden}}is-hidden{{/if}}"
                      data-location-action="select"
                      data-location-id="{{id}}"
                      data-swse-drag-kind="location" data-swse-drag-id="{{id}}" data-swse-drag-name="{{name}}" data-swse-drag-type="{{type}}" data-swse-drag-source="locations"
                      role="listitem">
                <div class="gm-location-registry-card-main">
                  <span class="gm-location-registry-icon" aria-hidden="true"><i class="{{iconClass}}"></i></span>
                  <div class="gm-location-registry-copy">
                    <strong>{{name}}</strong>
                    <span>{{typeLabel}}{{#if parentName}} · {{parentName}}{{/if}}</span>
                  </div>
                  {{#if isCurrent}}
                    <span class="gm-location-current-marker" title="Party is currently here" aria-label="Party is currently here">
                      <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                    </span>
                  {{/if}}
                </div>
                <div class="gm-location-registry-card-footer">
                  <span class="gm-location-status-chip {{revealClass}}">{{revealLabel}}</span>
                  <span class="gm-location-registry-summary">{{npcCount}} NPCs · {{jobCount}} Jobs</span>
                </div>
              </button>
            {{/each}}
          </div>
        {{else}}
          {{#if surface.locationManager.filtersProducedNoMatches}}
            <div class="swse-empty-state gm-phase5-location-empty">
              <h3>No locations match your filters</h3>
              <p>{{surface.locationManager.stats.importedCount}} location(s) are imported, but none match the current search/category/type/reveal filters.</p>
              <div class="gm-location-empty-actions">
                <button type="button" class="swse-mini-button primary" data-location-action="clear-location-filters">Clear Filters</button>
              </div>
            </div>
          {{else}}
            <div class="swse-empty-state gm-phase5-location-empty gm-location-compendium-drop" data-location-library-drop-zone>
              <h3>No locations found</h3>
              <p>Import a quick location, create one with the guided wizard, or drag a record from the <strong>Locations - Quick Library</strong> compendium onto this panel.</p>
              <p class="gm-location-empty-hint">Drop a quick-location Journal here to import it immediately, or use Import Location for multi-select.</p>
              <div class="gm-location-empty-actions">
                <button type="button" class="swse-mini-button primary" data-location-action="open-import-modal">Import Location</button>
                <button type="button" class="swse-mini-button" data-location-action="new">New Location</button>
              </div>
            </div>
          {{/if}}
        {{/if}}
      </section>
    </aside>

    <main class="gm-location-detail">
      {{#if surface.locationManager.selected}}
        {{#with surface.locationManager.selected}}
          {{!-- ============================================================
               IDENTITY — campaign-hub header for the selected Location.
               ============================================================ --}}
          <section class="swse-location-panel gm-phase5-location-panel gm-location-identity swse-drop-zone" data-location-drop-zone data-location-id="{{this.identity.id}}">
            <div class="gm-location-identity-copy">
              {{#if this.identity.parent}}
                <button type="button" class="gm-location-breadcrumb" data-location-action="select" data-location-id="{{this.identity.parent.id}}">
                  {{this.identity.parent.name}} <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </button>
              {{/if}}
              <div class="gm-location-title-row">
                <h3>{{this.identity.name}}</h3>
                {{#if this.currentSituation.partyHere}}
                  <span class="gm-location-party-here"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Party Here</span>
                {{/if}}
              </div>
              <div class="gm-location-subtitle">{{this.identity.typeLabel}}{{#if this.identity.regionLabel}} · {{this.identity.regionLabel}}{{/if}}</div>
              <div class="gm-location-identity-chips">
                <span class="chip {{this.identity.revealTone}}">{{this.identity.revealLabel}}</span>
                {{#each this.identity.tags}}<span class="chip">{{this}}</span>{{/each}}
              </div>
              {{#if this.identity.summary}}
                <p class="gm-location-summary">{{this.identity.summary}}</p>
              {{else}}
                <p class="gm-location-summary is-muted">No player-facing summary yet. Edit this location to add Atlas text.</p>
              {{/if}}
              <p class="swse-location-help">Drop Factions, NPC dossiers, Actors, Scenes, Journals, Intel, or Jobs on this header to link them.</p>
            </div>
            <div class="gm-location-identity-actions swse-location-editor-actions">
              <button type="button" class="swse-mini-button primary" data-location-action="edit" data-location-id="{{this.identity.id}}"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit in Wizard</button>
              {{#if this.currentSituation.isRevealed}}
                <button type="button" data-location-action="hide" data-location-id="{{this.identity.id}}"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> GM Only</button>
              {{else}}
                <button type="button" data-location-action="reveal" data-location-id="{{this.identity.id}}"><i class="fa-solid fa-eye" aria-hidden="true"></i> Reveal</button>
              {{/if}}
              {{#unless this.currentSituation.partyHere}}
                <button type="button" data-location-action="set-party-location" data-location-id="{{this.identity.id}}"><i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i> Set Active</button>
              {{/unless}}
              <button type="button" data-location-action="create-intel" data-location-id="{{this.identity.id}}">Create Intel</button>
              <button type="button" data-location-action="create-job" data-location-id="{{this.identity.id}}">Create Job</button>
              <button type="button" class="danger" data-location-action="delete" data-location-id="{{this.identity.id}}">Delete</button>
            </div>
          </section>

          {{!-- ============================================================
               CURRENT SITUATION — live campaign state at a glance.
               ============================================================ --}}
          <section class="gm-location-section gm-location-current-situation">
            <header class="gm-location-section-header">
              <div><span class="gm-location-section-eyebrow">Live Campaign State</span><h4>Current Situation</h4></div>
            </header>
            <div class="gm-location-situation-grid">
              <div class="gm-location-situation-item {{#if this.currentSituation.partyHere}}is-active{{/if}}">
                <span class="gm-location-situation-icon" aria-hidden="true"><i class="fa-solid fa-users"></i></span>
                <div><span>Party</span><strong>{{#if this.currentSituation.partyHere}}Currently Here{{else}}Elsewhere{{/if}}</strong></div>
              </div>
              <div class="gm-location-situation-item">
                <span class="gm-location-situation-icon" aria-hidden="true"><i class="fa-solid fa-flag"></i></span>
                <div><span>Control</span><strong>{{#if this.currentSituation.controllingFaction}}{{this.currentSituation.controllingFaction.name}}{{else}}Unclaimed{{/if}}</strong></div>
              </div>
              <div class="gm-location-situation-item">
                <span class="gm-location-situation-icon" aria-hidden="true"><i class="fa-solid fa-clipboard-list"></i></span>
                <div><span>Jobs</span><strong>{{this.currentSituation.activeJobCount}} active</strong></div>
              </div>
              <div class="gm-location-situation-item">
                <span class="gm-location-situation-icon" aria-hidden="true"><i class="fa-solid fa-satellite-dish"></i></span>
                <div><span>Leads</span><strong>{{this.currentSituation.unresolvedLeadCount}} unresolved</strong></div>
              </div>
              <div class="gm-location-situation-item">
                <span class="gm-location-situation-icon" aria-hidden="true"><i class="fa-solid fa-crosshairs"></i></span>
                <div><span>Encounters</span><strong>{{this.currentSituation.encounterSeedCount}} prepared</strong></div>
              </div>
              <div class="gm-location-situation-item {{#if this.currentSituation.sceneReady}}is-ready{{/if}}">
                <span class="gm-location-situation-icon" aria-hidden="true"><i class="fa-solid fa-map"></i></span>
                <div><span>Scene</span><strong>{{#if this.currentSituation.sceneReady}}Ready{{else}}Not Prepared{{/if}}</strong></div>
              </div>
            </div>
          </section>

          {{!-- ============================================================
               CAMPAIGN RELATIONSHIPS — Factions / Contacts&NPCs / Jobs /
               Intel & Leads. Four distinct authorities, four distinct cards.
               ============================================================ --}}
          <section class="gm-location-section">
            <header class="gm-location-section-header">
              <div><span class="gm-location-section-eyebrow">Connected Campaign State</span><h4>Campaign Relationships</h4></div>
            </header>
            <div class="gm-location-relationship-grid">
              <article class="gm-location-relationship-card">
                <header><div><i class="fa-solid fa-people-group" aria-hidden="true"></i><span>Factions Present</span></div><strong>{{this.relationships.factions.length}}</strong></header>
                <div class="gm-location-relationship-list">
                  {{#each this.relationships.factions}}
                    <div class="gm-location-relationship-row {{#if this.isController}}is-controller{{/if}} {{#unless this.missing}}is-navigable{{/unless}}" data-faction-id="{{this.id}}">
                      <span class="gm-location-relationship-avatar" aria-hidden="true"><i class="fa-solid fa-flag"></i></span>
                      <div class="gm-location-relationship-copy"><strong>{{this.name}}</strong><span>{{this.roleLabel}}</span></div>
                      {{#unless this.missing}}
                        <button type="button" class="gm-location-row-action nav" title="Open {{this.name}} in Factions" aria-label="Open {{this.name}} in Factions" data-location-action="open-faction" data-faction-id="{{this.id}}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
                      {{/unless}}
                      <button type="button" class="gm-location-row-action danger" title="Unlink faction" aria-label="Unlink {{this.name}}" data-location-action="remove-link" data-location-id="{{../identity.id}}" data-link-kind="faction" data-link-value="{{this.id}}"><i class="fa-solid fa-link-slash" aria-hidden="true"></i></button>
                    </div>
                  {{else}}
                    <div class="gm-location-relationship-empty">No faction presence established.</div>
                  {{/each}}
                </div>
              </article>
              <article class="gm-location-relationship-card">
                <header><div><i class="fa-solid fa-user-group" aria-hidden="true"></i><span>Contacts &amp; NPCs</span></div><strong>{{this.relationships.contacts.length}}</strong></header>
                <div class="gm-location-relationship-list">
                  {{#each this.relationships.contacts}}
                    <div class="gm-location-relationship-row {{#if this.missing}}is-missing{{else}}is-navigable{{/if}}" data-contact-id="{{this.id}}" data-actor-uuid="{{this.actorUuid}}">
                      <span class="gm-location-relationship-avatar" aria-hidden="true"><i class="fa-solid fa-user"></i></span>
                      <div class="gm-location-relationship-copy"><strong>{{this.name}}</strong><span>{{this.roleLabel}}</span></div>
                      {{#unless this.missing}}
                        <button type="button" class="gm-location-row-action nav" title="Open {{this.name}}" aria-label="Open {{this.name}}" data-location-action="open-contact" data-contact-kind="{{this.kind}}" data-contact-id="{{this.id}}" data-actor-uuid="{{this.actorUuid}}" data-faction-id="{{this.factionId}}" data-missing="false"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
                      {{/unless}}
                      {{#if this.canUnlink}}
                        <button type="button" class="gm-location-row-action danger" title="Unlink actor" aria-label="Unlink {{this.name}}" data-location-action="remove-link" data-location-id="{{../identity.id}}" data-link-kind="actor" data-link-value="{{this.actorUuid}}"><i class="fa-solid fa-link-slash" aria-hidden="true"></i></button>
                      {{else}}
                        <button type="button" class="gm-location-row-action danger" title="Unlink contact" aria-label="Unlink {{this.name}}" data-location-action="remove-link" data-location-id="{{../identity.id}}" data-link-kind="contact" data-link-value="{{this.id}}"><i class="fa-solid fa-link-slash" aria-hidden="true"></i></button>
                      {{/if}}
                    </div>
                  {{else}}
                    <div class="gm-location-relationship-empty">No contacts or NPCs linked here.</div>
                  {{/each}}
                </div>
              </article>
              <article class="gm-location-relationship-card">
                <header><div><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i><span>Jobs Here</span></div><strong>{{this.relationships.jobs.length}}</strong></header>
                <div class="gm-location-relationship-list">
                  {{#each this.relationships.jobs}}
                    <div class="gm-location-relationship-row {{#if this.missing}}is-missing{{else}}is-navigable{{/if}}" data-job-id="{{this.id}}">
                      <span class="gm-location-relationship-avatar" aria-hidden="true"><i class="fa-solid fa-file-contract"></i></span>
                      <div class="gm-location-relationship-copy"><strong>{{this.title}}</strong><span>{{this.statusLabel}}{{#if this.clientLabel}} · {{this.clientLabel}}{{/if}}</span></div>
                      {{#unless this.missing}}
                        <button type="button" class="gm-location-row-action nav" title="Open {{this.title}} in Job Board" aria-label="Open {{this.title}} in Job Board" data-location-action="open-job" data-job-id="{{this.id}}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
                      {{/unless}}
                      <button type="button" class="gm-location-row-action danger" title="Unlink job" aria-label="Unlink {{this.title}}" data-location-action="remove-link" data-location-id="{{../identity.id}}" data-link-kind="job" data-link-value="{{this.id}}"><i class="fa-solid fa-link-slash" aria-hidden="true"></i></button>
                    </div>
                  {{else}}
                    <div class="gm-location-relationship-empty">No Jobs are currently linked to this Location.</div>
                  {{/each}}
                </div>
              </article>
              <article class="gm-location-relationship-card">
                <header><div><i class="fa-solid fa-satellite-dish" aria-hidden="true"></i><span>Intel &amp; Leads</span></div><strong>{{this.relationships.intel.length}} / {{this.relationships.leads.length}}</strong></header>
                <div class="gm-location-relationship-group">
                  <span class="gm-location-relationship-subheading">Intel</span>
                  {{#each this.relationships.intel}}
                    <div class="gm-location-relationship-row {{#if this.missing}}is-missing{{else}}is-navigable{{/if}}" data-intel-id="{{this.id}}">
                      <span class="gm-location-relationship-avatar" aria-hidden="true"><i class="fa-solid fa-file-waveform"></i></span>
                      <div class="gm-location-relationship-copy"><strong>{{this.title}}</strong><span>{{this.statusLabel}}</span></div>
                      {{#unless this.missing}}
                        <button type="button" class="gm-location-row-action nav" title="Open {{this.title}} in Intel" aria-label="Open {{this.title}} in Intel" data-location-action="open-intel" data-intel-id="{{this.id}}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
                      {{/unless}}
                      <button type="button" class="gm-location-row-action danger" title="Unlink intel" aria-label="Unlink {{this.title}}" data-location-action="remove-link" data-location-id="{{../identity.id}}" data-link-kind="intel" data-link-value="{{this.id}}"><i class="fa-solid fa-link-slash" aria-hidden="true"></i></button>
                    </div>
                  {{else}}
                    <div class="gm-location-relationship-empty compact">No linked Intel.</div>
                  {{/each}}
                </div>
                <div class="gm-location-relationship-group">
                  <span class="gm-location-relationship-subheading">Unresolved Leads</span>
                  {{#each this.relationships.leads}}
                    <div class="gm-location-relationship-row" data-lead-id="{{this.id}}">
                      <span class="gm-location-relationship-avatar" aria-hidden="true"><i class="fa-solid fa-circle-question"></i></span>
                      <div class="gm-location-relationship-copy"><strong>{{this.factTitle}}</strong><span>{{#if this.actorName}}{{this.actorName}}{{else}}Campaign discovery{{/if}}</span></div>
                      <button type="button" class="gm-location-row-action danger" title="Resolve lead" aria-label="Resolve lead {{this.factTitle}}" data-location-action="lead-resolve" data-actor-id="{{this.actorId}}" data-discovery-id="{{this.id}}"><i class="fa-solid fa-check" aria-hidden="true"></i></button>
                    </div>
                  {{else}}
                    <div class="gm-location-relationship-empty compact">No unresolved leads.</div>
                  {{/each}}
                </div>
              </article>
            </div>
          </section>

          {{!-- ============================================================
               PREPARATION — Encounter Seeds and Scenes/Map. The GM's
               "what can happen here" space, kept separate from the campaign
               relationship cards above.
               ============================================================ --}}
          <section class="gm-location-section">
            <header class="gm-location-section-header">
              <div><span class="gm-location-section-eyebrow">GM Preparation</span><h4>Encounters &amp; Scenes</h4></div>
            </header>
            <div class="gm-location-preparation-grid">
              <article class="gm-location-panel">
                <header class="gm-location-panel-header">
                  <div><i class="fa-solid fa-crosshairs" aria-hidden="true"></i><span>Encounter Seeds</span></div>
                  <strong>{{this.preparation.encounterSeeds.length}}</strong>
                </header>
                <div class="gm-location-panel-body">
                  {{#each this.preparation.encounterSeeds}}
                    <div class="gm-location-encounter-row" data-seed-id="{{this.id}}">
                      <div class="gm-location-encounter-copy">
                        <strong>{{this.name}}</strong>
                        <span>{{this.categoryLabel}} · {{this.sourceLabel}}{{#if this.hasActor}} · {{this.actorLabel}}{{#if this.actorUnverifiable}}{{else}}{{#unless this.actorResolved}} (unresolved){{/unless}}{{/if}}{{/if}}</span>
                      </div>
                      <button type="button" class="gm-location-row-action danger" title="Remove encounter seed" aria-label="Remove {{this.name}}" data-location-action="remove-seed" data-location-id="{{../identity.id}}" data-seed-id="{{this.id}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                    </div>
                  {{else}}
                    <div class="gm-location-panel-empty">No encounter seeds prepared.</div>
                  {{/each}}
                  <details class="gm-location-optional-fields">
                    <summary>Add Encounter Seed</summary>
                    <form data-encounter-seed-form>
                      <input type="hidden" name="locationId" value="{{this.identity.id}}" />
                      <label class="swse-location-field swse-location-field--wide"><span>Name</span><input name="seedName" placeholder="Encounter Seed" /></label>
                      <div class="swse-location-field-grid">
                        <label class="swse-location-field"><span>Category</span><select name="seedCategory">{{#each ../surface.locationManager.seedCategoryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                        <label class="swse-location-field"><span>Role</span><input name="seedRole" placeholder="Guard, patrol, boss..." /></label>
                        <label class="swse-location-field"><span>Quantity</span><input name="seedQuantity" value="1" placeholder="1 or a dice formula, e.g. 1d4" /></label>
                      </div>
                      <label class="swse-location-field swse-location-field--wide"><span>Actor UUID (optional — used when staging tokens)</span><input name="seedUuid" placeholder="Actor.xxxxxxxx or Compendium.pack.id" /></label>
                      <label class="swse-location-field swse-location-field--wide"><span>Token Image (optional — overrides the Actor's own image when staged)</span><input name="seedImg" placeholder="icons/svg/mystery-man.svg" /></label>
                      <label class="swse-location-field swse-location-field--wide"><span>Notes</span><input name="seedNotes" /></label>
                      <button type="submit" class="swse-mini-button primary">Add Seed</button>
                    </form>
                  </details>
                </div>
                {{#if this.preparation.canStageEncounterSeeds}}
                  <footer class="gm-location-panel-footer">
                    <button type="button" class="btn sm primary" data-location-action="stage-encounter-seeds" data-location-id="{{this.identity.id}}"><i class="fa-solid fa-play" aria-hidden="true"></i> Stage Encounter Seeds</button>
                  </footer>
                {{else}}
                  {{#if this.preparation.stageBlockedReason}}
                    <footer class="gm-location-panel-footer is-muted">{{this.preparation.stageBlockedReason}}</footer>
                  {{/if}}
                {{/if}}
              </article>
              <article class="gm-location-panel">
                <header class="gm-location-panel-header">
                  <div><i class="fa-solid fa-map" aria-hidden="true"></i><span>Scenes &amp; Maps</span></div>
                  <strong>{{this.preparation.scenes.length}}</strong>
                </header>
                <div class="gm-location-panel-body">
                  {{#each this.preparation.scenes}}
                    <div class="gm-location-scene-row {{#unless this.unverifiable}}{{#unless this.resolved}}is-broken-link{{/unless}}{{/unless}}" data-scene-uuid="{{this.uuid}}">
                      <div class="gm-location-scene-copy">
                        <strong>{{this.label}}</strong>
                        <span>{{#if this.unverifiable}}Compendium-sourced{{else}}{{#if this.isPrimary}}Primary{{else}}Linked{{/if}}{{#if this.isActive}} · Active{{/if}}{{/if}}</span>
                      </div>
                      <div class="gm-location-scene-actions">
                        {{#if this.canOpen}}
                          <button type="button" class="gm-location-row-action" title="Open Scene" aria-label="Open {{this.label}}" data-location-action="open-scene" data-location-id="{{../identity.id}}"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></button>
                        {{/if}}
                        {{#if this.canActivate}}
                          <button type="button" class="gm-location-row-action" title="Activate Scene" aria-label="Activate {{this.label}}" data-location-action="activate-scene" data-location-id="{{../identity.id}}"><i class="fa-solid fa-play" aria-hidden="true"></i></button>
                        {{/if}}
                        <button type="button" class="gm-location-row-action danger" title="Unlink Scene" aria-label="Unlink {{this.label}}" data-location-action="remove-link" data-location-id="{{../identity.id}}" data-link-kind="scene" data-link-value="{{this.uuid}}"><i class="fa-solid fa-link-slash" aria-hidden="true"></i></button>
                      </div>
                    </div>
                  {{else}}
                    <div class="gm-location-panel-empty">No Scene linked.</div>
                  {{/each}}
                </div>
                <footer class="gm-location-panel-footer">
                  {{#if this.preparation.canCreateScene}}
                    <button type="button" class="btn sm" data-location-action="create-scene" data-location-id="{{this.identity.id}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> Create Scene</button>
                  {{else}}
                    {{#if this.preparation.sceneCreationBlockedReason}}
                      <span class="gm-location-blocked-reason">{{this.preparation.sceneCreationBlockedReason}}</span>
                    {{/if}}
                  {{/if}}
                </footer>
              </article>
            </div>
          </section>

          {{!-- ============================================================
               WORLD DETAIL — progressive disclosure for deep Location-owned
               data: Child Locations, Atlas Facts, Environment/Notes.
               ============================================================ --}}
          <section class="gm-location-section">
            <header class="gm-location-section-header">
              <div><span class="gm-location-section-eyebrow">Location-Owned Data</span><h4>World Detail</h4></div>
            </header>
            <div class="gm-location-world-grid">
              <details class="gm-location-world-panel" open>
                <summary><span><i class="fa-solid fa-sitemap" aria-hidden="true"></i> Child Locations</span><strong>{{this.world.children.length}}</strong></summary>
                <div class="gm-location-world-panel-body">
                  {{#each this.world.children}}
                    <button type="button" class="gm-location-child-row" data-location-action="select" data-location-id="{{this.id}}">
                      <span><strong>{{this.name}}</strong><small>{{this.typeLabel}}</small></span>
                      <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                    </button>
                  {{else}}
                    <div class="gm-location-panel-empty">No child Locations.</div>
                  {{/each}}
                </div>
              </details>
              <details class="gm-location-world-panel" open>
                <summary><span><i class="fa-solid fa-book-open" aria-hidden="true"></i> Atlas Facts</span><strong>{{this.world.atlasFacts.length}}</strong></summary>
                <div class="gm-location-world-panel-body">
                  {{#each this.world.atlasFacts}}
                    <article class="gm-location-fact-row" data-fact-id="{{this.id}}">
                      <header>
                        <strong>{{this.title}}</strong>
                        <span class="chip {{this.revealTone}}">{{this.revealLabel}}</span>
                      </header>
                      <span>{{this.categoryLabel}} · {{this.outputLabel}}</span>
                      {{#if this.teaser}}<p>{{this.teaser}}</p>{{/if}}
                      {{#if this.checkLabel}}<small>{{this.checkLabel}}</small>{{/if}}
                      <div>
                        <button type="button" data-location-action="fact-intel" data-location-id="{{../identity.id}}" data-fact-id="{{this.id}}">Intel</button>
                        <button type="button" data-location-action="fact-job" data-location-id="{{../identity.id}}" data-fact-id="{{this.id}}">Job</button>
                        <button type="button" data-location-action="remove-fact" data-location-id="{{../identity.id}}" data-fact-id="{{this.id}}">Remove</button>
                      </div>
                    </article>
                  {{else}}
                    <div class="gm-location-panel-empty">No Atlas Facts recorded.</div>
                  {{/each}}
                  <details class="gm-location-optional-fields">
                    <summary>Add Atlas Fact</summary>
                    <form data-atlas-fact-form>
                      <input type="hidden" name="locationId" value="{{this.identity.id}}" />
                      <label class="swse-location-field swse-location-field--wide"><span>Title</span><input name="factTitle" placeholder="New Atlas Fact" /></label>
                      <label class="swse-location-field swse-location-field--wide"><span>Teaser (shown before the check succeeds)</span><input name="factTeaser" /></label>
                      <label class="swse-location-field swse-location-field--wide"><span>Body (revealed on success)</span><textarea name="factBody" rows="2"></textarea></label>
                      <div class="swse-location-field-grid">
                        <label class="swse-location-field"><span>Category</span><select name="factCategory">{{#each ../surface.locationManager.factCategoryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                        <label class="swse-location-field"><span>Skill</span><select name="factSkill">{{#each ../surface.locationManager.skillOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                        <label class="swse-location-field"><span>DC</span><input type="number" name="factDc" value="15" min="0" /></label>
                        <label class="swse-location-field"><span>Reveal State</span><select name="factRevealState">{{#each ../surface.locationManager.editorRevealOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                        <label class="swse-location-field"><span>Reveal Mode</span><select name="factRevealMode">{{#each ../surface.locationManager.factRevealModeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      </div>
                      <label class="swse-location-field"><span>On success, create</span><select name="leadOutput">{{#each ../surface.locationManager.leadOutputOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                      <details class="gm-location-optional-fields">
                        <summary>Advanced reveal &amp; output options</summary>
                        <label class="swse-location-field swse-location-field--wide"><span>Check Label (overrides the default Skill/DC summary)</span><input name="factCheckLabel" placeholder="e.g. Perception DC 20" /></label>
                        <label class="swse-location-field swse-location-field--wide"><span>Multiple checks (one per line: skill|dc|label — overrides Skill/DC above if filled in)</span><textarea name="factChecksText" rows="2" placeholder="knowledgeGalacticLore|15|Local history&#10;perception|20|Spot the marking"></textarea></label>
                        <label class="swse-location-field swse-location-field--wide"><span>Tags (comma-separated)</span><input name="factTags" placeholder="sith, ruins, underworld" /></label>
                        <div class="swse-location-field-grid">
                          <label class="swse-location-field"><input type="checkbox" name="leadCreateJob" /> Create a Job draft</label>
                          <label class="swse-location-field"><input type="checkbox" name="leadCreateIntel" /> Create an Intel draft</label>
                        </div>
                        <label class="swse-location-field swse-location-field--wide"><span>Job Title</span><input name="leadJobTitle" /></label>
                        <label class="swse-location-field swse-location-field--wide"><span>Job Objective</span><input name="leadJobObjective" /></label>
                        <label class="swse-location-field"><span>Job Reward (credits)</span><input type="number" name="leadRewardCredits" value="0" min="0" /></label>
                        <label class="swse-location-field swse-location-field--wide"><span>Intel Title</span><input name="leadIntelTitle" /></label>
                        <label class="swse-location-field swse-location-field--wide"><span>Reveal Location ids on success (comma-separated)</span><input name="leadRevealLocationIds" /></label>
                        <label class="swse-location-field swse-location-field--wide"><span>Reveal Faction ids on success (comma-separated)</span><input name="leadRevealFactionIds" /></label>
                        <label class="swse-location-field swse-location-field--wide"><span>Reveal Contact ids on success (comma-separated)</span><input name="leadRevealContactIds" /></label>
                      </details>
                      <button type="submit" class="swse-mini-button primary">Save Atlas Fact</button>
                    </form>
                  </details>
                </div>
              </details>
              <details class="gm-location-world-panel">
                <summary><span><i class="fa-solid fa-mountain-sun" aria-hidden="true"></i> Environment &amp; Notes</span></summary>
                <div class="gm-location-world-panel-body">
                  {{#if this.world.environment.hazards}}<div class="gm-location-world-copy"><span>Hazards</span><p>{{this.world.environment.hazards}}</p></div>{{/if}}
                  {{#if this.world.environment.rumors}}<div class="gm-location-world-copy"><span>Rumors</span><p>{{this.world.environment.rumors}}</p></div>{{/if}}
                  {{#if this.world.environment.commerceNotes}}<div class="gm-location-world-copy"><span>Commerce</span><p>{{this.world.environment.commerceNotes}}</p></div>{{/if}}
                  {{#if this.world.environment.travelNotes}}<div class="gm-location-world-copy"><span>Travel</span><p>{{this.world.environment.travelNotes}}</p></div>{{/if}}
                  {{#if this.world.publicSummary}}<div class="gm-location-world-copy"><span>Public Summary</span><p>{{this.world.publicSummary}}</p></div>{{/if}}
                  {{#if this.world.gmNotes}}<div class="gm-location-world-copy is-gm-only"><span><i class="fa-solid fa-lock" aria-hidden="true"></i> GM Notes</span><p>{{this.world.gmNotes}}</p></div>{{/if}}
                  {{#if this.raw.linkedJournalUuid}}
                    <div class="gm-location-world-copy">
                      <span>Journal</span>
                      <p>{{this.raw.linkedJournalUuid}} <button type="button" class="danger" data-location-action="remove-link" data-location-id="{{this.identity.id}}" data-link-kind="journal" data-link-value="{{this.raw.linkedJournalUuid}}">Unlink</button></p>
                    </div>
                  {{/if}}
                </div>
              </details>
            </div>
          </section>
        {{/with}}
      {{else}}
        <section class="swse-location-panel gm-phase5-location-panel gm-location-empty-detail gm-location-compendium-drop" data-location-library-drop-zone>
          <span class="gm-phase5-location-eyebrow">No Selection</span>
          <h3>Import or create the first location</h3>
          <p>Locations are easier as modal workflows: import from the Quick Library, create a new record step by step, or drag a quick-location Journal from the compendium onto this panel.</p>
          <div class="swse-location-editor-actions">
            <button type="button" class="swse-mini-button primary" data-location-action="open-import-modal">Import Location</button>
            <button type="button" class="swse-mini-button" data-location-action="new">New Location</button>
          </div>
        </section>
      {{/if}}
    </main>
  </section>

  {{#if surface.locationManager.modal.isImport}}
    <div class="gm-location-modal-layer" data-location-modal="import">
      <form class="gm-location-modal gm-location-modal--import gm-location-wizard" data-location-import-form data-location-wizard="import" data-current-page="1">
        <header class="gm-location-modal-head">
          <div>
            <span class="gm-phase5-location-eyebrow">Quick Locations Compendium</span>
            <h3>Import Locations</h3>
            <p>Pick one or more planets from the library, choose import options, then confirm.</p>
          </div>
          <button type="button" class="gm-location-modal-close" data-location-action="close-modal">×</button>
        </header>

        <div class="gm-location-wizard-steps">
          <span class="is-active" data-wizard-step-indicator="1">1 Browse</span>
          <span data-wizard-step-indicator="2">2 Options</span>
          <span data-wizard-step-indicator="3">3 Import</span>
        </div>

        <section class="gm-location-wizard-page is-active" data-wizard-page="1">
          <section class="gm-location-modal-stats">
            <div><strong>{{surface.locationManager.library.summary.total}}</strong><span>planets</span></div>
            <div><strong>{{surface.locationManager.library.summary.visible}}</strong><span>shown</span></div>
            <div><strong>{{surface.locationManager.library.summary.visibleRecordCount}}</strong><span>records if imported</span></div>
            <div><strong>{{surface.locationManager.library.summary.imported}}</strong><span>imported</span></div>
          </section>
          <section class="gm-location-modal-filters gm-location-modal-filters--friendly">
            <label class="swse-location-field">
              <span>Search Library</span>
              <input type="search" value="{{surface.locationManager.filters.librarySearch}}" data-location-filter="librarySearch" placeholder="Tatooine, water, Sith, underworld, temple..." />
            </label>
            <div class="gm-location-filter-section">
              <span>Biome / Theme</span>
              <div class="gm-location-filter-pills gm-location-filter-pills--scroll">
                {{#each surface.locationManager.libraryBiomeButtons}}
                  <button type="button" class="gm-location-filter-pill {{#if selected}}is-active{{/if}}" data-location-filter-button data-filter-key="libraryBiome" data-filter-value="{{value}}">{{label}}</button>
                {{/each}}
              </div>
            </div>
            <div class="gm-location-filter-section">
              <span>Category</span>
              <div class="gm-location-filter-pills">
                {{#each surface.locationManager.libraryCategoryButtons}}
                  <button type="button" class="gm-location-filter-pill {{#if selected}}is-active{{/if}}" data-location-filter-button data-filter-key="libraryCategory" data-filter-value="{{value}}">{{label}}</button>
                {{/each}}
              </div>
            </div>
            <button type="button" class="swse-mini-button" data-location-action="clear-library-filters">Clear Filters</button>
          </section>
          <section class="gm-location-import-list">
            {{#each surface.locationManager.library.cards}}
              <label class="gm-location-import-card {{#if imported}}is-imported{{/if}}">
                <input type="checkbox" name="seedIds" value="{{id}}" {{#if checked}}checked{{/if}} {{#if imported}}disabled{{/if}} />
                <div>
                  <strong>{{name}}</strong>
                  <span>{{categoryLabel}} · {{typeLabel}} · {{region}}</span>
                  <p>{{summary}}</p>
                  <small>{{recordLabel}} · {{biomeLabels}}</small>
                </div>
                {{#if imported}}<em>Imported</em>{{else}}<em>Select</em>{{/if}}
              </label>
            {{else}}
              <div class="gm-location-modal-empty">
                <h4>No quick locations match those filters.</h4>
                <p>Clear filters or search a broader term such as desert, city, water, Jedi, Sith, underworld, or frontier.</p>
              </div>
            {{/each}}
          </section>
        </section>

        <section class="gm-location-wizard-page" data-wizard-page="2">
          <div class="gm-location-choice-section">
            <span class="gm-phase5-location-eyebrow">Import Contents</span>
            <label class="gm-location-toggle-card"><input type="checkbox" name="includeChildren" checked /> Include starter sites / POIs</label>
            <label class="gm-location-toggle-card"><input type="checkbox" name="includeAtlasFacts" checked /> Include starter Atlas facts and leads</label>
            <label class="gm-location-toggle-card"><input type="checkbox" name="knownToPlayers" /> Start as known to players</label>
          </div>
          <div class="gm-location-choice-section">
            <span class="gm-phase5-location-eyebrow">Initial Reveal State</span>
            <div class="gm-location-choice-grid gm-location-choice-grid--compact">
              {{#each surface.locationManager.editorRevealOptions}}
                <label class="gm-location-choice"><input type="radio" name="revealState" value="{{value}}" {{#if selected}}checked{{/if}} /> <strong>{{label}}</strong></label>
              {{/each}}
            </div>
          </div>
        </section>

        <section class="gm-location-wizard-page" data-wizard-page="3">
          <div class="gm-location-review-card">
            <h4>Ready to import</h4>
            <p>Selected planets will be imported as GM-owned location records. Existing records are skipped instead of overwritten.</p>
            <ul>
              <li>Use <strong>Import Selected</strong> for checked planets.</li>
              <li>Use <strong>Import All Shown</strong> for the current filtered list.</li>
              <li>Imported locations can be edited immediately from the registry.</li>
            </ul>
          </div>
        </section>

        <footer class="gm-location-modal-foot">
          <button type="button" data-location-action="close-modal">Cancel</button>
          <button type="button" data-location-action="wizard-back" data-wizard-target="import">Back</button>
          <button type="button" class="primary" data-location-action="wizard-next" data-wizard-target="import">Next</button>
          <button type="button" data-location-action="import-library-visible-now">Import All Shown</button>
          <button type="submit" class="primary">Import Selected</button>
        </footer>
      </form>
    </div>
  {{/if}}

  {{#if surface.locationManager.modal.isCreate}}
    <div class="gm-location-modal-layer" data-location-modal="create">
      <form class="gm-location-modal gm-location-modal--create gm-location-wizard" data-location-form data-location-wizard="create" data-current-page="1">
        <header class="gm-location-modal-head">
          <div>
            <span class="gm-phase5-location-eyebrow">Location Wizard</span>
            <h3>{{#if surface.locationManager.selected}}Edit Location{{else}}New Location{{/if}}</h3>
            <p>Answer the steps. No blank dropdowns, no hidden popup windows.</p>
          </div>
          <button type="button" class="gm-location-modal-close" data-location-action="close-modal">×</button>
        </header>
        <input type="hidden" name="id" value="{{surface.locationManager.editor.id}}" />

        <div class="gm-location-wizard-steps">
          <span class="is-active" data-wizard-step-indicator="1">1 Identity</span>
          <span data-wizard-step-indicator="2">2 Placement</span>
          <span data-wizard-step-indicator="3">3 Visibility</span>
          <span data-wizard-step-indicator="4">4 Notes</span>
        </div>

        <section class="gm-location-wizard-page is-active" data-wizard-page="1">
          <label class="swse-location-field swse-location-field--wide"><span>Name</span><input name="name" value="{{surface.locationManager.editor.name}}" placeholder="Tatooine, Mos Eisley, Docking Bay 94..." /></label>
          <div class="gm-location-choice-section"><span class="gm-phase5-location-eyebrow">Category</span><div class="gm-location-choice-grid gm-location-choice-grid--compact">{{#each surface.locationManager.editorCategoryOptions}}<label class="gm-location-choice"><input type="radio" name="category" value="{{value}}" {{#if selected}}checked{{/if}} /> <strong>{{label}}</strong></label>{{/each}}</div></div>
          <div class="gm-location-choice-section"><span class="gm-phase5-location-eyebrow">Type</span><div class="gm-location-choice-grid">{{#each surface.locationManager.editorTypeOptions}}<label class="gm-location-choice"><input type="radio" name="type" value="{{value}}" {{#if selected}}checked{{/if}} /> <strong>{{label}}</strong></label>{{/each}}</div></div>
          <div class="gm-location-choice-section"><span class="gm-phase5-location-eyebrow">Scale</span><div class="gm-location-choice-grid gm-location-choice-grid--compact">{{#each surface.locationManager.editorScaleOptions}}<label class="gm-location-choice"><input type="radio" name="scale" value="{{value}}" {{#if selected}}checked{{/if}} /> <strong>{{label}}</strong></label>{{/each}}</div></div>
        </section>

        <section class="gm-location-wizard-page" data-wizard-page="2">
          <div class="swse-location-field-grid">
            <label class="swse-location-field"><span>Region</span><input name="region" value="{{surface.locationManager.editor.raw.region}}" placeholder="Outer Rim" /></label>
            <label class="swse-location-field"><span>Sector</span><input name="sector" value="{{surface.locationManager.editor.raw.sector}}" placeholder="Arkanis Sector" /></label>
            <label class="swse-location-field"><span>System</span><input name="system" value="{{surface.locationManager.editor.raw.system}}" placeholder="Tatoo System" /></label>
            <label class="swse-location-field"><span>Coordinates</span><input name="coordinates" value="{{surface.locationManager.editor.raw.coordinates}}" placeholder="R-16 / GM notes" /></label>
          </div>
          <label class="swse-location-field swse-location-field--wide"><span>Parent Location ID</span><input name="parentLocationId" value="{{surface.locationManager.editor.raw.parentLocationId}}" list="gm-location-parent-options" placeholder="Leave blank for standalone, or type/select an existing location id" /></label>
          <datalist id="gm-location-parent-options">{{#each surface.locationManager.locationOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</datalist>
          <label class="swse-location-field swse-location-field--wide"><span>Controller Faction ID</span><input name="controllingFactionId" value="{{surface.locationManager.editor.raw.controllingFactionId}}" list="gm-location-faction-options" placeholder="Optional controlling faction" /></label>
          <datalist id="gm-location-faction-options">{{#each surface.locationManager.factionOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</datalist>
        </section>

        <section class="gm-location-wizard-page" data-wizard-page="3">
          <div class="gm-location-choice-section"><span class="gm-phase5-location-eyebrow">Reveal State</span><div class="gm-location-choice-grid gm-location-choice-grid--compact">{{#each surface.locationManager.editorRevealOptions}}<label class="gm-location-choice"><input type="radio" name="revealState" value="{{value}}" {{#if selected}}checked{{/if}} /> <strong>{{label}}</strong></label>{{/each}}</div></div>
          <div class="gm-phase5-toggle-row">
            <label class="gm-location-toggle-card"><input type="checkbox" name="knownToPlayers" {{#if surface.locationManager.editor.raw.knownToPlayers}}checked{{/if}} /> Known to players / Atlas-visible</label>
            <label class="gm-location-toggle-card"><input type="checkbox" name="activeForParty" {{#if surface.locationManager.editor.raw.activeForParty}}checked{{/if}} /> Active party location</label>
          </div>
          <label class="swse-location-field swse-location-field--wide"><span>Image</span><input name="image" value="{{surface.locationManager.editor.raw.image}}" placeholder="icons/svg/planet.svg or asset path" /></label>
          <label class="swse-location-field swse-location-field--wide"><span>Tags</span><input name="tags" value="{{surface.locationManager.editor.tags}}" placeholder="outer rim, underworld, desert" /></label>
        </section>

        <section class="gm-location-wizard-page" data-wizard-page="4">
          <label class="swse-location-field swse-location-field--wide"><span>Public Atlas Summary</span><textarea name="publicSummary" rows="4">{{surface.locationManager.editor.raw.publicSummary}}</textarea></label>
          <label class="swse-location-field swse-location-field--wide"><span>GM Notes</span><textarea name="gmNotes" rows="4">{{surface.locationManager.editor.raw.gmNotes}}</textarea></label>
          <details class="gm-location-optional-fields"><summary>Advanced links and map fields</summary>
            <label class="swse-location-field"><span>Faction IDs</span><input name="factionIds" value="{{surface.locationManager.editor.factionIdsText}}" /></label>
            <label class="swse-location-field"><span>Named NPC/contact IDs</span><input name="contactIds" value="{{surface.locationManager.editor.contactIdsText}}" /></label>
            <label class="swse-location-field"><span>Actor UUIDs</span><textarea name="npcActorUuids" rows="2">{{surface.locationManager.editor.npcActorUuidsText}}</textarea></label>
            <label class="swse-location-field"><span>Intel IDs</span><textarea name="linkedIntelIds" rows="2">{{surface.locationManager.editor.linkedIntelIdsText}}</textarea></label>
            <label class="swse-location-field"><span>Job IDs</span><textarea name="linkedJobIds" rows="2">{{surface.locationManager.editor.linkedJobIdsText}}</textarea></label>
            <label class="swse-location-field"><span>Linked Scene UUID</span><input name="mapSceneUuid" value="{{surface.locationManager.editor.mapSceneUuid}}" /></label>
            <label class="swse-location-field"><span>Map Image Path</span><input name="mapImagePath" value="{{surface.locationManager.editor.mapImagePath}}" /></label>
            <input type="hidden" name="linkedSceneUuids" value="{{surface.locationManager.editor.linkedSceneUuidsText}}" />
            <input type="hidden" name="linkedJournalUuid" value="{{surface.locationManager.editor.raw.linkedJournalUuid}}" />
            <input type="hidden" name="mapDefaultGrid" value="{{surface.locationManager.editor.mapDefaultGrid}}" />
            <input type="hidden" name="mapDefaultPadding" value="{{surface.locationManager.editor.mapDefaultPadding}}" />
            <input type="hidden" name="mapDefaultWidth" value="{{surface.locationManager.editor.mapDefaultWidth}}" />
            <input type="hidden" name="mapDefaultHeight" value="{{surface.locationManager.editor.mapDefaultHeight}}" />
            <input type="hidden" name="mapNotes" value="{{surface.locationManager.editor.mapNotes}}" />
            <input type="hidden" name="hazards" value="{{surface.locationManager.editor.raw.hazards}}" />
            <input type="hidden" name="rumors" value="{{surface.locationManager.editor.raw.rumors}}" />
            <input type="hidden" name="commerceNotes" value="{{surface.locationManager.editor.raw.commerceNotes}}" />
            <input type="hidden" name="travelNotes" value="{{surface.locationManager.editor.raw.travelNotes}}" />
          </details>
        </section>

        <footer class="gm-location-modal-foot">
          <button type="button" data-location-action="close-modal">Cancel</button>
          <button type="button" data-location-action="wizard-back" data-wizard-target="create">Back</button>
          <button type="button" class="primary" data-location-action="wizard-next" data-wizard-target="create">Next</button>
          <button type="submit" class="primary">Save Location</button>
        </footer>
      </form>
    </div>
  {{/if}}

  {{#if surface.locationManager.modal.isDelete}}
    <div class="gm-location-modal-layer" data-location-modal="delete">
      <section class="gm-location-modal gm-location-modal--delete">
        <header class="gm-location-modal-head">
          <div>
            <span class="gm-phase5-location-eyebrow">Confirm Registry Delete</span>
            <h3>Delete Location?</h3>
            <p>This removes only the GM Location registry record. Child locations are reparented to standalone.</p>
          </div>
          <button type="button" class="gm-location-modal-close" data-location-action="close-modal">×</button>
        </header>
        <div class="gm-location-delete-card">
          <strong>{{surface.locationManager.modal.deleteLocationName}}</strong>
          <span>{{surface.locationManager.modal.deleteLocationId}}</span>
        </div>
        <footer class="gm-location-modal-foot">
          <button type="button" data-location-action="close-modal">Cancel</button>
          <button type="button" class="danger" data-location-action="confirm-delete" data-location-id="{{surface.locationManager.modal.deleteLocationId}}">Delete Location</button>
        </footer>
      </section>
    </div>
  {{/if}}
</div>
