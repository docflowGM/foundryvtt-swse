{{!--
  item-customization-workbench.hbs
  Standalone frame for ItemCustomizationWorkbench.

  This wraps the canonical workbench-content.hbs partial in the stage/screen
  device chrome needed when the workbench renders as its own ApplicationV2
  window (PARTS.body.template). The Holopad-hosted path
  (templates/shell/partials/surface-workbench.hbs) wraps the exact same
  partial in equivalent chrome instead — there is only one workbench UI body.
--}}
<div class="swse-customization-stage swse-datapad swse-ui-shell swse-sheet-ui" data-theme="{{themeKey}}" data-motion-style="{{motionStyle}}" style="{{{themeStyleInline}}}; {{{motionStyleInline}}};">
  <div class="swse-customization-screen" data-application-content>
    {{> "systems/foundryvtt-swse/templates/apps/customization/partials/workbench-content.hbs"}}
  </div>
</div>
