{{!--
  Droid Build Status Card — Phase 7

  Compact source-provenance chip + missing-systems warnings for the Systems tab.
  Visible for all droid types; adapts content based on source classification.

  Data consumed:
    droid.sourceStatus — {
      buildSource, sourceLabel,
      isImported, isConverted, isManualOrLegacy,
      importedFrom, convertedFrom,
      garageRecommended, hasConfiguration,
      validationMessages[], hasValidationMessages
    }
    droid.garage.canOpenGarage — owner permission flag

  Rendered unconditionally so the source badge always appears; the warning
  list and Garage CTA render only when there is content to show.
--}}
{{#if droid.sourceStatus}}
<div class="swse-droid-status-card swse-panel">
  <div class="swse-droid-status-header">
    <span class="swse-droid-source-badge swse-droid-source-{{droid.sourceStatus.buildSource}}">
      {{droid.sourceStatus.sourceLabel}}
    </span>
    {{#if droid.sourceStatus.importedFrom}}
      <span class="swse-droid-status-origin">from: {{droid.sourceStatus.importedFrom}}</span>
    {{else if droid.sourceStatus.convertedFrom}}
      <span class="swse-droid-status-origin">converted from: {{droid.sourceStatus.convertedFrom}}</span>
    {{/if}}
  </div>

  {{#if droid.sourceStatus.hasValidationMessages}}
    <ul class="swse-droid-validation-list">
      {{#each droid.sourceStatus.validationMessages as |msg|}}
        <li class="swse-droid-validation-item swse-droid-validation-{{msg.severity}}">{{msg.text}}</li>
      {{/each}}
    </ul>
  {{/if}}

  {{#if droid.sourceStatus.garageRecommended}}
    {{#if droid.garage.canOpenGarage}}
      <div class="swse-droid-garage-cta">
        <span class="swse-droid-garage-cta-text">{{localize "SWSE.ActorUI.GarageCanCompleteThisBuild"}}</span>
        <button type="button" class="edit-droid-systems holo-btn small" aria-label="{{localize 'SWSE.ActorUI.OpenGarageToConfigureDroidSystems'}}">
          <i class="fa-solid fa-screwdriver-wrench"></i> {{localize "SWSE.ActorUI.OpenGarage"}}
        </button>
      </div>
    {{/if}}
  {{/if}}

  {{#if droid.garage.canConvert}}
    <div class="swse-droid-garage-cta swse-droid-conversion-cta">
      <span class="swse-droid-garage-cta-text">{{localize "SWSE.ActorUI.StockImportDetectedConvertItIntoAGarage"}}</span>
      <button type="button" class="convert-to-custom-droid holo-btn small" aria-label="{{localize 'SWSE.ActorUI.ConvertStockDroidToCustomGarageBuild'}}">
        <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "SWSE.ActorUI.ConvertStockDroid"}}
      </button>
    </div>
  {{/if}}

  {{!--
    PHASE 3 — Droid Stock-Statblock Authority.
    Distinct from the "Convert Stock Droid" CTA above (which targets the
    unrelated, unreachable legacy full-custom-Garage-build conversion — see
    docs/audits/droid-stock-statblock-authority-phase-3.md). This section
    governs only the lightweight calculation-mode flip: does the droid use
    its published statblock totals (BAB/defenses/Initiative/Damage
    Threshold/attacks), or normal derived math. Nonowners/non-GMs see the
    status badge but no action buttons.
  --}}
  {{#if droid.stockStatblockControls.visible}}
    <div class="swse-droid-statblock-mode-card">
      <div class="swse-droid-status-header">
        <span class="swse-droid-source-badge swse-droid-statblock-mode-{{droid.stockStatblockControls.mode}}">
          {{droid.stockStatblockControls.modeLabel}}
        </span>
        {{#if droid.stockStatblockControls.sourceName}}
          <span class="swse-droid-status-origin">source: {{droid.stockStatblockControls.sourceName}}</span>
        {{/if}}
      </div>

      {{#if droid.stockStatblockControls.canAct}}
        <div class="swse-droid-statblock-actions">
          {{#if droid.stockStatblockControls.isStock}}
            <button type="button" class="holo-btn small" data-action="inspect-droid-conversion" aria-label="Inspect what converting this droid to playable mode would change">
              <i class="fa-solid fa-magnifying-glass-chart"></i> Inspect Conversion
            </button>
            {{#if droid.stockStatblockControls.canConvert}}
              <button type="button" class="holo-btn small" data-action="convert-droid-to-playable" aria-label="Convert this droid to playable derived mode">
                <i class="fa-solid fa-wand-magic-sparkles"></i> Convert to Playable
              </button>
            {{/if}}
          {{else}}
            <button type="button" class="holo-btn small" data-action="view-original-droid-statblock" aria-label="View this droid's original published statblock">
              <i class="fa-solid fa-file-import"></i> View Original Statblock
            </button>
            {{#if droid.stockStatblockControls.canRollback}}
              <button type="button" class="holo-btn small" data-action="rollback-droid-conversion" aria-label="Roll back this droid to its published statblock">
                <i class="fa-solid fa-clock-rotate-left"></i> Roll Back Conversion
              </button>
            {{/if}}
          {{/if}}
        </div>
      {{/if}}
    </div>
  {{/if}}
</div>
{{/if}}
