{{!-- One anatomy-driven appendage slot tile. Presentation only (equipment-workspace-context.js): the slot list, occupant, state label
     and shared-grip partners all come from the resolved anatomy + occupancy assignments; nothing is decided here. --}}
<button type="button"
  class="swse-eqw__slot{{#if slot.empty}} is-empty{{else}} is-occupied is-tone-{{slot.occupant.tone}}{{/if}}{{#if slot.unavailable}} is-unavailable{{/if}}{{#if slot.conflict}} is-conflict{{/if}}{{#if slot.occupant.shared}} is-shared{{/if}}{{#if slot.occupant.activated}} is-activated{{/if}}"
  data-eqw-slot="{{slot.id}}" data-eqw-slot-label="{{slot.label}}"
  {{#if slot.occupant}}data-eqw-slot-item="{{slot.occupant.itemId}}"{{/if}}
  {{#if slot.unavailable}}aria-disabled="true" title="{{slot.label}} is {{slot.stateLabel}}"{{/if}}
  aria-pressed="false">
  <span class="swse-eqw__slot-head">
    <i class="fa-solid {{slot.glyph}}" aria-hidden="true"></i>
    <span class="swse-eqw__slot-name">{{slot.label}}</span>
    {{#if slot.occupant.activated}}<span class="swse-eqw__led is-on" title="Activated"><span class="swse-eqw__sr">Activated</span></span>{{/if}}
    {{#if slot.conflict}}<span class="swse-eqw__flag is-conflict">Conflict</span>{{/if}}
    {{#if slot.stateLabel}}{{#unless slot.unavailable}}<span class="swse-eqw__flag">{{slot.stateLabel}}</span>{{/unless}}{{/if}}
  </span>
  {{#if slot.occupant}}
    <span class="swse-eqw__slot-body">
      {{> "systems/foundryvtt-swse/templates/actors/character/v2-concept/partials/panels/equipment-art.hbs" art=slot.occupant.art size="md"}}
      <span class="swse-eqw__slot-copy">
        <strong class="swse-eqw__slot-item">{{slot.occupant.name}}</strong>
        <span class="swse-eqw__state is-{{slot.occupant.tone}}">{{#if slot.occupant.stateLabel}}{{slot.occupant.stateLabel}}{{else}}{{slot.occupant.purposeLabel}}{{/if}}</span>
      </span>
    </span>
    {{#if slot.occupant.shared}}<span class="swse-eqw__grip-tag"><i class="fa-solid fa-link" aria-hidden="true"></i> Shared with {{slot.occupant.withSlotLabels}}</span>{{/if}}
    {{#if slot.occupant.damageLabel}}<span class="swse-eqw__readout"><b>{{slot.occupant.attackLabel}}</b> hit · <b>{{slot.occupant.damageLabel}}</b> dmg</span>{{/if}}
  {{else}}
    <span class="swse-eqw__socket">
      <i class="fa-solid {{#if slot.unavailable}}fa-ban{{else}}fa-plus{{/if}}" aria-hidden="true"></i>
      <span>{{#if slot.unavailable}}{{slot.stateLabel}}{{else}}Empty{{/if}}</span>
    </span>
  {{/if}}
</button>
