{{!-- One anatomy-driven appendage socket. Presentation only (equipment-workspace-context.js): the slot list, occupant, state label and
     shared-grip partners all come from the resolved anatomy + occupancy assignments. An item held across several appendages is shown in
     full on its anchor socket (first appendage in the assignment's own order); the other sockets read "occupied by" so the weapon never
     appears duplicated. --}}
<button type="button"
  class="swse-eqw__slot{{#if slot.empty}} is-empty{{else}} is-occupied is-tone-{{slot.occupant.tone}}{{#if slot.occupant.isAnchor}} is-anchor{{else}} is-linked{{/if}}{{/if}}{{#if slot.unavailable}} is-unavailable{{/if}}{{#if slot.conflict}} is-conflict{{/if}}{{#if slot.occupant.shared}} is-shared{{/if}}{{#if slot.occupant.activated}} is-activated{{/if}}"
  data-eqw-slot="{{slot.id}}" data-eqw-slot-label="{{slot.label}}"
  {{#if slot.occupant}}data-eqw-slot-item="{{slot.occupant.itemId}}"{{/if}}
  {{#if slot.unavailable}}aria-disabled="true" title="{{slot.label}} is {{slot.stateLabel}}"{{/if}}
  aria-pressed="false">
  <span class="swse-eqw__slot-label">
    <i class="fa-solid {{slot.glyph}}" aria-hidden="true"></i>
    <span class="swse-eqw__slot-name">{{slot.label}}</span>
    {{#if slot.occupant.activated}}<span class="swse-eqw__led is-on" title="Activated"><span class="swse-eqw__sr">Activated</span></span>{{/if}}
    {{#if slot.conflict}}<span class="swse-eqw__flag is-conflict">Conflict</span>{{/if}}
    {{#if slot.stateLabel}}{{#unless slot.unavailable}}<span class="swse-eqw__flag">{{slot.stateLabel}}</span>{{/unless}}{{/if}}
  </span>
  {{#if slot.occupant}}
    {{#if slot.occupant.isAnchor}}
      <span class="swse-eqw__slot-body">
        {{> "systems/foundryvtt-swse/templates/actors/character/v2-concept/partials/panels/equipment-art.hbs" art=slot.occupant.art size="md"}}
        <span class="swse-eqw__slot-copy">
          <strong class="swse-eqw__slot-item">{{slot.occupant.name}}</strong>
          <span class="swse-eqw__state is-{{slot.occupant.tone}}">{{#if slot.occupant.stateLabel}}{{slot.occupant.stateLabel}}{{else}}{{slot.occupant.purposeLabel}}{{/if}}</span>
        </span>
      </span>
      {{#if slot.occupant.shared}}<span class="swse-eqw__grip-tag"><i class="fa-solid fa-link" aria-hidden="true"></i> Held with {{slot.occupant.withSlotLabels}}</span>{{/if}}
      {{#if slot.occupant.damageLabel}}<span class="swse-eqw__readout"><b>{{slot.occupant.attackLabel}}</b> to hit · <b>{{slot.occupant.damageLabel}}</b></span>{{/if}}
    {{else}}
      <span class="swse-eqw__linked">
        <i class="fa-solid fa-link" aria-hidden="true"></i>
        <span><strong>Occupied</strong><small>by {{slot.occupant.name}}</small></span>
      </span>
    {{/if}}
  {{else}}
    <span class="swse-eqw__open">{{#if slot.unavailable}}{{slot.stateLabel}}{{else}}Empty{{/if}}</span>
  {{/if}}
</button>
