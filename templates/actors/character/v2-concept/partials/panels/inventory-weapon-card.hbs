<article class="swse-concept-loadout-card swse-concept-loadout-card--weapon" data-item-id="{{entry.id}}">
  <div class="swse-concept-loadout-card__header">
    <div>
      <strong>{{entry.name}}</strong>
      <small>Weapon</small>
    </div>
    <span class="swse-concept-chip swse-concept-chip--accent">{{#if entry.isNaturalWeapon}}Natural{{else}}{{#if entry.weaponReadiness}}{{entry.weaponReadiness.stateLabel}}{{else}}Equipped{{/if}}{{/if}}</span>
  </div>

  <div class="swse-concept-loadout-card__stats">
    <div>
      <span>Attack</span>
      <strong class="{{entry.attackTotalClass}}">{{#if entry.hasAttackProfile}}{{numberFormat entry.attackTotal decimals=0 sign=true}}{{else}}—{{/if}}</strong>
    </div>
    <div>
      <span>Damage</span>
      <strong>{{#if entry.damageFormula}}{{entry.damageFormula}}{{else}}—{{/if}}</strong>
    </div>
    <div>
      <span>Crit</span>
      <strong>{{#if entry.critRange}}{{entry.critRange}}x{{entry.critMult}}{{else}}—{{/if}}</strong>
    </div>
  </div>

  <div class="swse-concept-loadout-card__meta">
    <span>Qty {{entry.quantity}}</span>
    <span>{{#if entry.weight}}{{numberFormat entry.weight decimals=1}} kg{{else}}No weight{{/if}}</span>
    <span>{{numberFormat entry.value decimals=0}} cr</span>
  </div>
  {{#if entry.weaponReadiness}}
    <div class="swse-weapon-state-strip">
      <span class="swse-weapon-state {{#if entry.weaponReadiness.drawn}}swse-weapon-state--ready{{else}}swse-weapon-state--stowed{{/if}}">{{entry.weaponReadiness.stateLabel}}</span>
      {{#if entry.weaponReadiness.isLightsaber}}<span class="swse-weapon-state {{#if entry.weaponReadiness.activated}}swse-weapon-state--active{{else}}swse-weapon-state--inactive{{/if}}">Blade {{entry.weaponReadiness.bladeStateLabel}}</span>{{/if}}
      {{#if entry.weaponConfiguration}}<span class="swse-weapon-state swse-weapon-state--mode">{{entry.weaponConfiguration.currentLabel}}</span>{{/if}}
    </div>
  {{/if}}

  {{#if entry.alchemy.hasAlchemy}}
    <div class="swse-alchemy-badge-row" title="Alchemical modifications tracked on this item">
      {{#each entry.alchemy.badges as |badge|}}
        <span class="swse-concept-chip swse-concept-chip--alchemy {{badge.tone}}">&#9959; {{badge.label}}</span>
      {{/each}}
    </div>
  {{/if}}

  <div class="swse-concept-ledger-row__actions">
    {{#if entry.virtual}}
      <button type="button" class="swse-concept-btn swse-concept-btn--primary" data-action="roll-unarmed-attack">Roll</button>
    {{else}}
      <button type="button" class="swse-concept-btn swse-concept-btn--primary swse-weapon-control swse-weapon-control--attack" data-action="roll-attack" data-weapon-id="{{entry.id}}">Roll</button>
      {{#if entry.weaponReadiness.canToggleActivated}}<button type="button" class="swse-concept-btn swse-weapon-control swse-weapon-control--activation {{#if entry.weaponReadiness.activated}}is-active{{/if}}" data-action="toggle-activated" data-item-id="{{entry.id}}">{{entry.weaponReadiness.activationLabel}}</button>{{/if}}
      {{#if entry.weaponConfiguration}}<button type="button" class="swse-concept-btn swse-weapon-control swse-weapon-control--configuration" data-action="change-weapon-configuration" data-item-id="{{entry.id}}">Configure</button>{{/if}}
      {{#if entry.weaponReadiness.canDrawStow}}<button type="button" class="swse-concept-btn swse-weapon-control swse-weapon-control--readiness {{#if entry.weaponReadiness.drawn}}is-ready{{else}}is-inactive{{/if}}" data-action="toggle-weapon-readiness" data-item-id="{{entry.id}}"{{#if entry.weaponReadiness.stowBlocked}} disabled title="Deactivate the lightsaber before stowing it."{{/if}}>{{entry.weaponReadiness.drawStowLabel}}</button>{{/if}}
      {{#if entry.canEdit}}<button type="button" class="swse-concept-btn swse-edit-only" data-action="edit" data-item-id="{{entry.id}}">Edit</button>{{else}}<button type="button" class="swse-concept-btn" data-action="open-item" data-item-id="{{entry.id}}">Inspect</button>{{/if}}
      {{#if entry.canOpenForceAlchemy}}<button type="button" class="swse-concept-btn swse-concept-btn--alchemy" data-action="force-alchemy" data-item-id="{{entry.id}}">Alchemy</button>{{/if}}
    {{/if}}
  </div>
</article>
