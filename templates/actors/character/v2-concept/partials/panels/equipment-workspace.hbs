{{!-- Equipment workspace (Gear tab). Presentation only: every value comes from conceptLayout.gear.workspace (equipment-workspace-context.js).
     Every state-changing control reuses an existing data-action handled by the sheet (InventoryEngine / FireStateStore / customization router),
     or a data-eqw-* control handled by equipment-workspace-ui.js, which only calls the same authorities.
     Visual language: the sheet's own concept panel primitives (.swse-concept-panel / __header / __title, .swse-concept-btn) plus
     styles/sheets/equipment-workspace.css, which reads the live sheet theme tokens. --}}
{{#with conceptLayout.gear.workspace as |ws|}}
<section class="swse-eqw" data-eqw aria-label="Equipment workspace">
  {{#if ws.notices.length}}
  <div class="swse-eqw__bulletins" role="list">
    {{#each ws.notices as |n|}}
      <p class="swse-eqw__notice is-{{n.tone}}" role="listitem"><i class="fa-solid {{#if (eq n.tone 'conflict')}}fa-circle-exclamation{{else if (eq n.tone 'info')}}fa-circle-info{{else}}fa-triangle-exclamation{{/if}}" aria-hidden="true"></i><span>{{n.text}}</span></p>
    {{/each}}
  </div>
  {{/if}}

  <div class="swse-eqw__layout">
    <div class="swse-eqw__main">

      {{!-- REGION A: character equipment. Slots come from the actor's resolved anatomy; the figure arrangement is presentation only. --}}
      <section class="swse-concept-panel swse-eqw__panel swse-eqw__figure" aria-labelledby="eqw-figure-title">
        <header class="swse-concept-panel__header swse-eqw__panel-head">
          <h3 class="swse-concept-panel__title" id="eqw-figure-title">Loadout</h3>
          {{#if ws.anatomy}}
            <span class="swse-eqw__meta"><span class="swse-eqw__led{{#if ws.anatomy.resolved}} is-on{{else}} is-warn{{/if}}" aria-hidden="true"></span>{{#if ws.anatomy.kindLabel}}{{ws.anatomy.kindLabel}} · {{/if}}{{ws.appendageCount}} appendage{{#unless (eq ws.appendageCount 1)}}s{{/unless}} · {{ws.anatomy.statusLabel}}</span>
          {{/if}}
        </header>

        <div class="swse-eqw__rig{{#unless ws.hasSlots}} is-slotless{{/unless}}">
          <div class="swse-eqw__bay swse-eqw__bay--left" role="group" aria-label="Hands and appendages">
            {{#each ws.slotsLeft as |slot|}}{{> "systems/foundryvtt-swse/templates/actors/character/v2-concept/partials/panels/equipment-slot.hbs" slot=slot}}{{/each}}
          </div>

          <figure class="swse-eqw__core" aria-label="{{ws.portrait.name}}">
            <div class="swse-eqw__holo{{#unless ws.portrait.src}} is-glyph{{/unless}}">
              <i class="fa-solid {{ws.portrait.glyph}}" aria-hidden="true"></i>
              {{#if ws.portrait.src}}<img src="{{ws.portrait.src}}" alt="" loading="lazy" decoding="async" data-eqw-img>{{/if}}
            </div>
          </figure>

          <div class="swse-eqw__bay swse-eqw__bay--right" role="group" aria-label="Hands and appendages (continued)">
            {{#each ws.slotsRight as |slot|}}{{> "systems/foundryvtt-swse/templates/actors/character/v2-concept/partials/panels/equipment-slot.hbs" slot=slot}}{{/each}}
          </div>

          {{#if ws.hasGrips}}
            {{!-- items held across more than one appendage (from the occupancy assignments): drawn as a beam joining the bays --}}
            <ul class="swse-eqw__bridge" aria-label="Items held in more than one appendage">
              {{#each ws.grips as |g|}}<li><span class="swse-eqw__beam" aria-hidden="true"></span><span class="swse-eqw__bridge-label"><i class="fa-solid fa-link" aria-hidden="true"></i><strong>{{g.name}}</strong><small>{{g.count}} appendages · {{g.slotLabels}}</small></span><span class="swse-eqw__beam" aria-hidden="true"></span></li>{{/each}}
            </ul>
          {{/if}}

          <div class="swse-eqw__stations" role="group" aria-label="Worn and installed">
            {{#each ws.stations as |st|}}
              <button type="button" class="swse-eqw__station{{#if st.empty}} is-empty{{else}} is-occupied{{/if}}{{#if st.primary.activated}} is-activated{{/if}}" data-eqw-station="{{st.tab}}" aria-pressed="false">
                {{#if st.primary}}
                  {{> "systems/foundryvtt-swse/templates/actors/character/v2-concept/partials/panels/equipment-art.hbs" art=st.primary.art size="sm"}}
                {{else}}
                  <span class="swse-eqw__art swse-eqw__art--sm is-glyph is-socket" aria-hidden="true"><i class="fa-solid {{st.glyph}}"></i></span>
                {{/if}}
                <span class="swse-eqw__station-copy">
                  <span class="swse-eqw__slot-name">{{st.label}}</span>
                  {{#if st.primary}}
                    <strong>{{st.primary.name}}{{#if st.extra}} <span class="swse-eqw__qty">+{{st.extra}}</span>{{/if}}</strong>
                    <span class="swse-eqw__state is-{{st.primary.status.tone}}">{{st.primary.status.label}}</span>
                  {{else}}<strong class="is-dim">None</strong>{{/if}}
                </span>
              </button>
            {{/each}}
          </div>
        </div>
        {{#unless ws.hasSlots}}<p class="swse-eqw__empty">No usable hands or appendages are established for this actor, so no hand slots are shown (see the notice above).</p>{{/unless}}
      </section>

      {{!-- REGION B: inventory manifest --}}
      <section class="swse-concept-panel swse-eqw__panel swse-eqw__browser" aria-labelledby="eqw-inv-title">
        <header class="swse-concept-panel__header swse-eqw__panel-head">
          <h3 class="swse-concept-panel__title" id="eqw-inv-title">Inventory</h3>
          <span class="swse-eqw__context" data-eqw-context hidden></span>
          <button type="button" class="swse-eqw__clear" data-eqw-clear hidden><i class="fa-solid fa-xmark" aria-hidden="true"></i> Clear</button>
        </header>
        <div class="swse-eqw__tabs" role="tablist" aria-label="Inventory categories">
          {{#each ws.tabs as |tab|}}
            <button type="button" role="tab" class="swse-eqw__tab" data-eqw-tab="{{tab.id}}" aria-selected="{{#if (eq tab.id 'all')}}true{{else}}false{{/if}}"><i class="fa-solid {{tab.icon}}" aria-hidden="true"></i><span>{{tab.label}}</span><span class="swse-eqw__count">{{tab.count}}</span></button>
          {{/each}}
        </div>
        <div class="swse-eqw__tools">
          <label class="swse-eqw__search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><span class="swse-eqw__sr">Search inventory</span><input type="search" data-eqw-search placeholder="Search manifest…" autocomplete="off" spellcheck="false"></label>
          <label class="swse-eqw__toggle" data-eqw-incompat-toggle hidden><input type="checkbox" data-eqw-show-incompatible><span>Show incompatible (<span data-eqw-incompat-count>0</span>)</span></label>
        </div>

        <ul class="swse-eqw__list" data-eqw-list role="list">
          {{#each ws.items as |it|}}
            <li class="swse-eqw__row is-tone-{{it.status.tone}}" data-eqw-row="{{it.id}}" data-eqw-cat="{{it.category}}" data-eqw-text="{{it.searchText}}">
              <button type="button" class="swse-eqw__row-main" data-eqw-select="{{it.id}}" aria-pressed="false">
                {{> "systems/foundryvtt-swse/templates/actors/character/v2-concept/partials/panels/equipment-art.hbs" art=it.art size="sm"}}
                <span class="swse-eqw__row-copy">
                  <strong>{{it.name}}{{#if it.showQuantity}} <span class="swse-eqw__qty">×{{it.quantity}}</span>{{/if}}</strong>
                  <small>{{it.typeLabel}}{{#if it.heldInLabel}} · {{it.heldInLabel}}{{/if}}{{#if it.ammoLabel}} · {{it.ammoLabel}}{{/if}}</small>
                </span>
                <span class="swse-eqw__state is-{{it.status.tone}}">{{it.status.label}}</span>
                <span class="swse-eqw__verdict" data-eqw-verdict hidden></span>
              </button>
            </li>
          {{/each}}
        </ul>
        <p class="swse-eqw__empty" data-eqw-empty {{#if ws.hasItems}}hidden{{/if}}>{{#if ws.hasItems}}Nothing matches this category and search.{{else}}No gear logged. Use the add controls above to create weapons, armor or gear.{{/if}}</p>
      </section>
    </div>

    {{!-- REGION C + D: item inspector with contextual operations --}}
    <aside class="swse-concept-panel swse-eqw__panel swse-eqw__inspector" aria-label="Item inspector" data-eqw-inspector>
      <div class="swse-eqw__inspector-empty" data-eqw-detail-empty>
        <span class="swse-eqw__art swse-eqw__art--lg is-glyph is-socket" aria-hidden="true"><i class="fa-solid fa-crosshairs"></i></span>
        <strong>No item selected</strong>
        <p>Choose a hand to see the weapons that fit it, or choose any item to inspect it, use it, and manage its modifications.</p>
      </div>

      {{#each ws.items as |it|}}
      <article class="swse-eqw__detail" data-eqw-detail="{{it.id}}" hidden>
        <header class="swse-eqw__detail-head">
          {{> "systems/foundryvtt-swse/templates/actors/character/v2-concept/partials/panels/equipment-art.hbs" art=it.art size="lg"}}
          <div class="swse-eqw__detail-id">
            <span class="swse-eqw__kicker">{{it.typeLabel}}{{#if it.gripLabel}} · {{it.gripLabel}}{{/if}}</span>
            <h3>{{it.name}}</h3>
            <p class="swse-eqw__chips">
              <span class="swse-eqw__state is-{{it.status.tone}}">{{it.status.label}}</span>
              {{#if it.isWeapon}}{{#if it.attackReady}}<span class="swse-eqw__state is-ready">Can attack</span>{{else}}<span class="swse-eqw__state is-stowed">Cannot attack</span>{{/if}}{{/if}}
              {{#if it.activated}}<span class="swse-eqw__state is-ready">Activated</span>{{/if}}
              {{#if it.heldInLabel}}<span class="swse-eqw__state is-held"><i class="fa-solid fa-hand" aria-hidden="true"></i> {{it.heldInLabel}}</span>{{/if}}
            </p>
          </div>
        </header>
        {{#if it.status.reason}}<p class="swse-eqw__reason"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{it.status.reason}}</p>{{/if}}

        <div class="swse-eqw__itabs" role="tablist" aria-label="Inspector sections">
          <button type="button" role="tab" class="swse-eqw__itab" data-eqw-itab="details" aria-selected="true">Details</button>
          <button type="button" role="tab" class="swse-eqw__itab" data-eqw-itab="operations" aria-selected="false">Operations</button>
          <button type="button" role="tab" class="swse-eqw__itab" data-eqw-itab="mods" aria-selected="false">Mods{{#if it.hasModifications}} <span class="swse-eqw__count">{{it.modifications.length}}</span>{{/if}}</button>
        </div>

        {{!-- DETAILS: authoritative values already computed elsewhere; nothing recalculated --}}
        <div class="swse-eqw__pane" data-eqw-pane="details">
          <dl class="swse-eqw__facts">
            {{#if it.isWeapon}}
              {{#if it.attack}}
                <div class="is-key"><dt>Attack</dt><dd>{{#if it.attack.hasProfile}}{{numberFormat it.attack.attackTotal decimals=0 sign=true}}{{else}}—{{/if}}</dd></div>
                <div class="is-key"><dt>Damage</dt><dd>{{#if it.attack.damageFormula}}{{it.attack.damageFormula}}{{else}}—{{/if}}</dd></div>
                <div><dt>Crit</dt><dd>{{#if it.attack.critRange}}{{it.attack.critRange}}×{{it.attack.critMult}}{{else}}—{{/if}}</dd></div>
                <div><dt>Range</dt><dd>{{#if it.attack.rangeLabel}}{{it.attack.rangeLabel}}{{else}}—{{/if}}</dd></div>
              {{else}}
                <div class="swse-eqw__wide"><dt>Attack profile</dt><dd>Shown once the weapon has an attack entry (draw it to see it).</dd></div>
              {{/if}}
              {{#if it.ammoLabel}}<div><dt>Ammunition</dt><dd>{{it.ammoLabel}}</dd></div>{{/if}}
              {{#if it.gripLabel}}<div><dt>Grip</dt><dd>{{it.gripLabel}}</dd></div>{{/if}}
              {{#if it.weaponReadiness.isLightsaber}}<div><dt>Blade</dt><dd>{{it.weaponReadiness.bladeStateLabel}}</dd></div>{{/if}}
              {{#if it.weaponConfiguration}}<div><dt>Configuration</dt><dd>{{it.weaponConfiguration.currentLabel}}</dd></div>{{/if}}
              {{#if it.weaponPowerSource}}<div class="swse-eqw__wide"><dt>Power source</dt><dd>{{it.weaponPowerSource.requirementLabel}} · {{it.weaponPowerSource.stateLabel}}</dd></div>{{/if}}
            {{/if}}
            {{#if it.armorStats}}
              <div class="is-key"><dt>Reflex</dt><dd>{{numberFormat it.armorStats.reflexBonus decimals=0 sign=true}}</dd></div>
              <div class="is-key"><dt>Fortitude</dt><dd>{{numberFormat it.armorStats.fortitudeBonus decimals=0 sign=true}}</dd></div>
              <div><dt>Type</dt><dd>{{it.armorStats.armorTypeLabel}}</dd></div>
              <div><dt>Max Dex</dt><dd>{{it.armorStats.maxDexLabel}}</dd></div>
              <div><dt>Check penalty</dt><dd>{{it.armorStats.armorCheckPenalty}}</dd></div>
              <div><dt>Speed penalty</dt><dd>{{it.armorStats.speedPenalty}}</dd></div>
              {{#if it.isEnergyShield}}<div><dt>Shield rating</dt><dd>{{it.currentSR}} / {{it.shieldRating}}</dd></div>{{/if}}
            {{/if}}
            {{#if it.implantStatusLabel}}<div><dt>Implant</dt><dd>{{it.implantStatusLabel}}</dd></div>{{/if}}
            <div><dt>Quantity</dt><dd>{{it.quantity}}</dd></div>
            <div><dt>Weight</dt><dd>{{#if it.weight}}{{numberFormat it.weight decimals=1}} kg{{else}}—{{/if}}</dd></div>
            <div><dt>Value</dt><dd>{{numberFormat it.value decimals=0}} cr</dd></div>
          </dl>
          {{#if it.tags.length}}<p class="swse-eqw__tags">{{#each it.tags as |tag|}}<span class="swse-eqw__tag">{{tag}}</span>{{/each}}</p>{{/if}}
        </div>

        {{!-- OPERATIONS (REGION D): only controls the item supports; each is an existing authority entry point.
             Grouping into primary / secondary is visual only; handlers and their order of authority are unchanged. --}}
        <div class="swse-eqw__pane" data-eqw-pane="operations" hidden>
          <div class="swse-eqw__ops">
            <div class="swse-eqw__ops-primary">
              {{#if it.isWeapon}}
                {{#if it.weaponReadiness}}
                  {{#if it.weaponReadiness.canDrawAndIgnite}}<button type="button" class="swse-concept-btn swse-concept-btn--primary" data-action="draw-and-ignite-lightsaber" data-item-id="{{it.id}}"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Draw &amp; Ignite</button>{{/if}}
                  {{#if it.weaponReadiness.canDrawStow}}<button type="button" class="swse-concept-btn swse-concept-btn--primary" data-action="toggle-weapon-readiness" data-item-id="{{it.id}}"{{#if it.weaponReadiness.stowBlocked}} disabled title="Deactivate the lightsaber before stowing it."{{/if}}><i class="fa-solid fa-hand" aria-hidden="true"></i> {{it.weaponReadiness.drawStowLabel}}</button>{{/if}}
                {{/if}}
              {{else}}
                {{#if it.canToggleEquip}}
                  {{#if it.isImplant}}
                    <button type="button" class="swse-concept-btn swse-concept-btn--primary" data-action="toggle-implant-installed" data-item-id="{{it.id}}"><i class="fa-solid fa-microchip" aria-hidden="true"></i> {{#if it.equipped}}Remove{{else}}Install{{/if}}</button>
                  {{else}}
                    <button type="button" class="swse-concept-btn swse-concept-btn--primary" data-action="equip" data-item-id="{{it.id}}"><i class="fa-solid {{#if it.armorStats}}fa-user-shield{{else}}fa-check{{/if}}" aria-hidden="true"></i> {{#if it.equipped}}{{#if it.armorStats}}Remove{{else}}Unequip{{/if}}{{else}}{{#if it.armorStats}}Wear{{else}}Equip{{/if}}{{/if}}</button>
                  {{/if}}
                {{/if}}
              {{/if}}
            </div>
            <div class="swse-eqw__ops-secondary">
              {{#if it.isWeapon}}
                {{#if it.weaponReadiness}}
                  {{#if it.weaponReadiness.canToggleActivated}}<button type="button" class="swse-concept-btn {{#if it.weaponReadiness.activated}}is-active{{/if}}" data-action="toggle-activated" data-item-id="{{it.id}}"><i class="fa-solid fa-power-off" aria-hidden="true"></i> {{it.weaponReadiness.activationLabel}}</button>{{/if}}
                  {{#if it.weaponReadiness.canReconcile}}<button type="button" class="swse-concept-btn" data-action="reconcile-weapon-transaction" data-item-id="{{it.id}}" title="An equipment change on this weapon did not finish (GM only)."><i class="fa-solid fa-rotate" aria-hidden="true"></i> Resolve</button>{{/if}}
                {{/if}}
                {{#if it.ammoLabel}}<button type="button" class="swse-concept-btn" data-eqw-action="reload" data-item-id="{{it.id}}"><i class="fa-solid fa-battery-full" aria-hidden="true"></i> Reload</button>{{/if}}
                {{#if it.weaponConfiguration}}<button type="button" class="swse-concept-btn" data-action="change-weapon-configuration" data-item-id="{{it.id}}"><i class="fa-solid fa-sliders" aria-hidden="true"></i> {{it.weaponConfiguration.currentLabel}}</button>{{/if}}
                {{#if it.weaponPowerSource}}<button type="button" class="swse-concept-btn" data-action="set-power-source" data-item-id="{{it.id}}" title="{{it.weaponPowerSource.title}}"><i class="fa-solid fa-plug" aria-hidden="true"></i> Power: {{it.weaponPowerSource.stateLabel}}</button>{{/if}}
                <button type="button" class="swse-concept-btn swse-eqw__attack" data-action="roll-attack" data-weapon-id="{{it.id}}"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i> Attack…</button>
              {{else}}
                {{#if it.canToggleEquip}}{{#if it.isImplant}}<button type="button" class="swse-concept-btn" data-action="toggle-implant-active" data-item-id="{{it.id}}"><i class="fa-solid fa-power-off" aria-hidden="true"></i> {{#if it.isActiveImplant}}Deactivate{{else}}Activate{{/if}}</button>{{/if}}{{/if}}
                {{#if it.canToggleActivated}}<button type="button" class="swse-concept-btn {{#if it.activated}}is-active{{/if}}" data-action="toggle-activated" data-item-id="{{it.id}}"><i class="fa-solid fa-power-off" aria-hidden="true"></i> {{it.activationLabel}}</button>{{/if}}
              {{/if}}
            </div>
          </div>

          {{#if it.isWeapon}}
            {{!-- slot-first and item-first placement share one panel; filled by equipment-workspace-ui.js from the coordinator's read-only plan --}}
            <div class="swse-eqw__placement" data-eqw-placement="{{it.id}}" aria-live="polite"></div>
          {{/if}}
        </div>

        {{!-- MODIFICATIONS: installed instances come from the customization authority; managing them opens the existing workbench --}}
        <div class="swse-eqw__pane" data-eqw-pane="mods" hidden>
          {{#if it.hasModifications}}
            <ul class="swse-eqw__mods">{{#each it.modifications as |m|}}<li><i class="fa-solid fa-gear" aria-hidden="true"></i><strong>{{m.name}}</strong><span class="swse-eqw__state{{#if m.provisional}} is-warn{{else}} is-held{{/if}}">{{#if m.provisional}}Provisional · effects not automated{{else}}{{m.state}}{{/if}}</span></li>{{/each}}</ul>
          {{else}}
            <p class="swse-eqw__empty-note"><i class="fa-solid fa-gears" aria-hidden="true"></i> No modifications installed.</p>
          {{/if}}
          {{#if it.alchemy.hasAlchemy}}<p class="swse-eqw__tags">{{#each it.alchemy.badges as |badge|}}<span class="swse-eqw__tag">&#9959; {{badge.label}}</span>{{/each}}</p>{{/if}}
          <div class="swse-eqw__ops-secondary">
            {{#if it.canCustomize}}<button type="button" class="swse-concept-btn swse-concept-btn--primary" data-action="configure" data-item-id="{{it.id}}"><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> Modification workshop</button>{{/if}}
            {{#if it.canOpenForceAlchemy}}<button type="button" class="swse-concept-btn" data-action="force-alchemy" data-item-id="{{it.id}}"><i class="fa-solid fa-flask" aria-hidden="true"></i> Alchemy</button>{{/if}}
          </div>
        </div>

        <footer class="swse-eqw__detail-foot">
          {{#if it.canEdit}}<button type="button" class="swse-eqw__admin swse-edit-only" data-action="edit" data-item-id="{{it.id}}"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit</button>{{else}}<button type="button" class="swse-eqw__admin" data-action="open-item" data-item-id="{{it.id}}"><i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i> Item sheet</button>{{/if}}
          {{#if it.canEdit}}<button type="button" class="swse-eqw__admin swse-edit-only" data-action="sell-item" data-item-id="{{it.id}}"><i class="fa-solid fa-coins" aria-hidden="true"></i> Sell</button>{{/if}}
          {{#if it.canDelete}}<button type="button" class="swse-eqw__admin is-danger swse-edit-only" data-action="delete" data-item-id="{{it.id}}"><i class="fa-solid fa-trash" aria-hidden="true"></i> Delete</button>{{/if}}
        </footer>
      </article>
      {{/each}}
    </aside>
  </div>
</section>
{{/with}}
