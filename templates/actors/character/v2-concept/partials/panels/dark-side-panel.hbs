<section class="swse-concept-panel swse-concept-panel--ledger">
  <header class="swse-concept-panel__header">
    <div>
      <h3 class="swse-concept-panel__title">Dark Side Score</h3>
      <p class="swse-concept-panel__hint">Clickable dark side track using the existing score setter.</p>
    </div>
    <div class="swse-concept-ledger-row__actions">
      <span class="swse-concept-chip swse-concept-chip--{{#if darkSidePanel.danger}}warn{{else}}neutral{{/if}}">{{darkSidePanel.value}} / {{darkSidePanel.max}}</span>
    </div>
  </header>

  <div class="swse-concept-dsp-track {{#if darkSidePanel.danger}}is-danger{{/if}}">
    {{#each darkSidePanel.segments as |segment|}}
      <button type="button"
              class="swse-concept-dsp-track__segment {{#if segment.filled}}filled{{/if}} {{#if segment.current}}is-current{{/if}} {{#unless ../darkSidePanel.canEdit}}swse-concept-dsp-track__segment--readonly{{/unless}}"
              data-action="set-dark-side-score"
              data-index="{{segment.index}}"
              aria-label="{{#if ../darkSidePanel.canEdit}}Set Dark Side Score to {{segment.index}}{{else}}Dark Side Score {{segment.index}}{{/if}}"
              {{#if segment.current}}aria-current="true"{{/if}}
              title="{{#if ../darkSidePanel.canEdit}}Set Dark Side Score to {{segment.index}}{{else}}{{../darkSidePanel.readOnlyReason}}{{/if}}"
              {{#unless ../darkSidePanel.canEdit}}disabled aria-disabled="true"{{/unless}}>
        <span>{{segment.index}}</span>
      </button>
    {{/each}}
  </div>
</section>
