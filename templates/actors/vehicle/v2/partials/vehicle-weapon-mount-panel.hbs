<section class="swse-vehicle-panel">
  <header class="swse-vehicle-panel-header">
    <h3 class="swse-vehicle-panel-title">{{panel.title}}</h3>
  </header>

  <div class="swse-vehicle-panel-body">
    <div class="swse-vehicle-weapon-list">
      {{#each panel.mounts as |mount|}}
        <div class="swse-vehicle-weapon-card {{#if mount.parseConfidence}}is-{{mount.parseConfidence}}{{/if}}">
          <div class="swse-vehicle-weapon-titlebar">
            <h4 class="swse-vehicle-weapon-name">{{mount.name}}</h4>
            <span class="swse-vehicle-weapon-chip">{{mount.arc}}</span>
            {{#if mount.parseConfidence}}
              <span class="swse-vehicle-weapon-confidence is-{{mount.parseConfidence}}">{{mount.parseConfidence}}</span>
            {{/if}}
          </div>

          <div class="swse-vehicle-weapon-meta">
            {{#if mount.gunner}}
              <span class="swse-vehicle-weapon-chip">
                <span class="swse-vehicle-weapon-stat-label">{{localize "SWSE.ActorUI.Gunner"}}</span>
                {{mount.gunner}}
              </span>
            {{/if}}
            {{#if mount.fireControl}}
              <span class="swse-vehicle-weapon-chip">
                <span class="swse-vehicle-weapon-stat-label">{{localize "SWSE.ActorUI.FireControl"}}</span>
                {{mount.fireControl}}
              </span>
            {{/if}}
          </div>

          <div class="swse-vehicle-weapon-statline">
            {{#if mount.attackSummary}}
              <div class="swse-vehicle-weapon-stat">
                <span class="swse-vehicle-weapon-stat-label">{{localize "SWSE.ActorUI.Attack"}}</span>
                <span class="swse-vehicle-weapon-stat-value">{{mount.attackSummary}}</span>
              </div>
            {{/if}}
            {{#if mount.damageSummary}}
              <div class="swse-vehicle-weapon-stat">
                <span class="swse-vehicle-weapon-stat-label">{{localize "SWSE.ActorUI.Damage"}}</span>
                <span class="swse-vehicle-weapon-stat-value">{{mount.damageSummary}}</span>
              </div>
            {{/if}}
            {{#if mount.rangeSummary}}
              <div class="swse-vehicle-weapon-stat">
                <span class="swse-vehicle-weapon-stat-label">{{localize "SWSE.ActorUI.Range"}}</span>
                <span class="swse-vehicle-weapon-stat-value">{{mount.rangeSummary}}</span>
              </div>
            {{/if}}
          </div>

          {{#if mount.actions}}
            <div class="swse-vehicle-weapon-actions">
              {{#each mount.actions as |action|}}
                <button type="button"
                        class="swse-vehicle-action-btn"
                        data-action="vehicle-crew-skill"
                        data-station="{{action.stationKey}}"
                        data-skill="{{action.key}}"
                        data-weapon-id="{{mount.weaponId}}"
                        data-use="{{action.use}}"
                        data-label="{{mount.name}}">
                  {{action.use}}
                </button>
              {{/each}}
            </div>
          {{/if}}

          {{#if mount.operatorAmbiguous}}
            <div class="swse-vehicle-weapon-operator-warning">Ambiguous operator: multiple gunner stations exist. Select which one operates this weapon.</div>
          {{else if mount.operatorBroken}}
            <div class="swse-vehicle-weapon-operator-warning">Mapped operator station no longer exists on this vehicle. Select a new one.</div>
          {{else if mount.operatorUnmapped}}
            <div class="swse-vehicle-weapon-operator-warning">No {{mount.crewRole}} station exists on this vehicle.</div>
          {{/if}}

          {{#if mount.editable}}
            <div class="swse-vehicle-weapon-operator-mapping">
              <label class="swse-vehicle-weapon-stat-label" for="operator-station-{{mount.weaponId}}">{{localize "SWSE.ActorUI.OperatorStation"}}</label>
              <select id="operator-station-{{mount.weaponId}}"
                      class="swse-vehicle-weapon-operator-select"
                      data-action="vehicle-weapon-station-select"
                      data-weapon-id="{{mount.weaponId}}">
                <option value="">Auto ({{mount.crewRole}})</option>
                {{#each mount.stationOptions as |option|}}
                  <option value="{{option.key}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                {{/each}}
              </select>
            </div>
          {{else if mount.operatorStationKey}}
            <div class="swse-vehicle-weapon-chip">{{localize "SWSE.ActorUI.OperatorStation"}}: {{mount.operatorStationKey}}</div>
          {{/if}}

          {{#if mount.linkedGroup}}
            <div style="margin-top: 0.45rem; padding-top: 0.45rem; border-top: 1px solid rgba(255,255,255,0.08); font-size: 0.72rem; color: var(--swse-vehicle-text-muted);">
              <span style="text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700;">{{localize "SWSE.ActorUI.Linked"}}</span> {{mount.linkedGroup}}
            </div>
          {{/if}}

          {{#if mount.rawSource}}
            <div class="swse-vehicle-weapon-raw">
              <span style="font-size: 0.65rem; text-transform: uppercase; color: var(--swse-vehicle-text-dim); letter-spacing: 0.08em; margin-bottom: 0.2rem;">{{localize "SWSE.ActorUI.Source2"}}</span>
              <div style="font-size: 0.75rem; color: var(--swse-vehicle-text-muted); font-family: monospace;">{{mount.rawSource}}</div>
            </div>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </div>
</section>
