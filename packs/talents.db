{"_id":"b37ac074a7e8de58","name":"Instruction","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per encounter, as a standard action, you can boost the competence of one of your allies within 6 squares. That individual gains the ability to make a single skill check using your skill modifier (except Use the Force); this skill check must be made before the end of the encounter, or the benefit is lost. You can select this talent multiple times. Each time you do so, you gain one additional use of this talent per encounter.","description":{"value":"Once per encounter, as a standard action, you can boost the competence of one of your allies within 6 squares. That individual gains the ability to make a single skill check using your skill modifier (except Use the Force); this skill check must be made before the end of the encounter, or the benefit is lost. You can select this talent multiple times. Each time you do so, you gain one additional use of this talent per encounter."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","treeId":"d65a4816379802ee","tags":["force","positioning","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"instruction","name":"Instruction","label":"Instruction","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, one ally within 6 squares can make one skill check using your skill modifier, except Use the Force, before the end of the encounter.","notes":"Once per encounter, one ally within 6 squares can make one skill check using your skill modifier, except Use the Force, before the end of the encounter.","relatedSkills":[{"skill":"Skill Check"}],"resources":["Once per encounter per selection"],"requiredContext":[],"targetHint":"One ally within 6 squares","spendAction":true,"ruleData":{}}],"manualResolution":true,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Ideologue","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"Once per encounter, as a standard action, you can boost the competence of one of your allies within 6 squares.","source":"Force Unleashed Campaign Guide","page":25},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.instruction","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.425Z","detectedPredicates":["turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Follower/dependent-actor subsystem or GM/player managed","note":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals."}}}}
