{"_id":"4764dc69f0d11695","name":"Vehicle Focus","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Wisdom 13","benefit":"Choose a single type of vehicle from the following list: airspeeder, capital ship, space transport, speeder, starfighter, or walker. When you are the pilot or gunner of that type of vehicle, you gain +2 to all attack rolls with a vehicle weapon, and may take 10 on any Pilot checks made while piloting that type of vehicle, even when you are otherwise unable to.","description":{"value":"Choose a single type of vehicle from the following list: airspeeder, capital ship, space transport, speeder, starfighter, or walker. When you are the pilot or gunner of that type of vehicle, you gain +2 to all attack rolls with a vehicle weapon, and may take 10 on any Pilot checks made while piloting that type of vehicle, even when you are otherwise unable to."},"class":"9c9989c34714f920","costNumeric":null,"category":"Ace Pilot","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"wis","min":13}],"_source":"canonical-csv"},"treeId":"b17c1515c06361d6","tags":["vehicle","pilot","skills","reliability","precision","ranged","targeting"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"requiresSelectedChoice":true,"choiceMetaStatus":"phase14_persistent_choice_seeded","phase16VehicleStarshipCleanup":{"status":"metadata_or_gm_player_managed","owner":"GM/player or future vehicle subsystem","notes":"No truthful automatic runtime owner in this pass; stale migrated modifiers/effects removed if present."}},"choiceMeta":{"resolution":"immediate","required":true,"status":"phase14_persistent_choice_seeded","choiceKind":"vehicle_type","repeatable":true,"storagePath":"flags.swse.choices.vehicle_focus_type","choiceSource":"fixed","optionRegistry":"data/feat-choice-options.json#choiceKinds.vehicle_type"},"summary":"Choose a vehicle type; while piloting or gunning it, gain +2 vehicle-weapon attacks and may take 10 on Pilot checks.","source":"Starships of the Galaxy","page":17},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.vehicle_focus","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.411Z","detectedPredicates":[]}}}
