{"_id":"8e1ee6d1c756450f96d4d5eaa9657e47","name":"Embrace the Dark Side","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Channel Aggression, Channel Anger.","benefit":"Whenever you use a Force Power with the [Dark Side] descriptor, you may reroll your Use the Force check, but you must accept the result of the reroll, even if it is worse.\n\nUpon choosing this Talent, you can no longer use Force Powers with the [Light Side] descriptor.","description":{"value":"Whenever you use a Force Power with the [Dark Side] descriptor, you may reroll your Use the Force check, but you must accept the result of the reroll, even if it is worse.\n\nUpon choosing this Talent, you can no longer use Force Powers with the [Light Side] descriptor."},"costNumeric":null,"treeId":"96ef43a3054dcb58","tags":["dark_side","force","force_capacity","force_power_synergy","light_side","resource_spend","use_the_force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"force_suite_prompt","staticSheetPolicy":"exclude","manualResolution":false,"modifiers":[],"notes":"Reroll Use the Force check when using [Dark Side] Force power; keep reroll.","combatActions":[{"id":"embrace-the-dark-side","name":"Embrace the Dark Side","label":"Embrace the Dark Side","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Whenever you use a Force Power with the [Dark Side] descriptor, you may reroll your Use the Force check, but you must accept the result of the reroll, even if it is worse.","notes":"Whenever you use a Force Power with the [Dark Side] descriptor, you may reroll your Use the Force check, but you must accept the result of the reroll, even if it is worse.","relatedSkills":[{"skill":"Use the Force"}],"resources":["Use the Force check"],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[],"requiresRuntimeContext":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Dark Side Devotee","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":0,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."},"source":"talent-backcheck","combatActionId":"embrace-the-dark-side","sithTalentAction":"embraceTheDarkSide"},"talent_tree":"Dark Side Devotee","tree":"Dark Side Devotee","category":"Dark Side Devotee","implementationStatus":"implemented","automationBoundary":"supported","summary":"Whenever you use a Force Power with the [Dark Side] descriptor, you may reroll your Use the Force check, but you must accept the result of the reroll, even if it is worse.","source":"Saga Edition Core Rulebook","page":213},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.embrace_the_dark_side","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.421Z","detectedPredicates":[],"forcePrestigeCleanup":{"phase":"T9","status":"manual_or_runtime","scope":"force_suite_prompt"}}}}
{"_id":"8e4475b0f99633f3","name":"Gambler","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You gain a +2 competence bonus on Wisdom checks when you Gamble. You can select this Talent multiple times; each time you take this Talent, the competence bonus increases by +2.","description":{"value":"You gain a +2 competence bonus on Wisdom checks when you Gamble. You can select this Talent multiple times; each time you take this Talent, the competence bonus increases by +2."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","treeId":"cee9b9398682b7d0","tags":["force"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"modifiers":[]},"summary":"You gain a +2 competence bonus on Wisdom checks when you Gamble. You can select this Talent multiple times; each time you take this Talent, the competence bonus increases by +2.","source":"Saga Edition Core Rulebook","page":46},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.gambler"}}}
{"_id":"8eace9d86fc60711","name":"Lifesaver","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Bodyguard's Sacrifice","benefit":"Once per encounter as a reaction, when an ally takes damage that equals or exceeds its damage threshold or reduces it to 0 hit points, you can move up to your speed provided you end your movement adjacent to that ally. This movement provokes attacks of opportunity as normal, you take all of the damage that triggered this talent's use, and your ally takes no damage.","description":{"value":"Once per encounter as a reaction, when an ally takes damage that equals or exceeds its damage threshold or reduces it to 0 hit points, you can move up to your speed provided you end your movement adjacent to that ally. This movement provokes attacks of opportunity as normal, you take all of the damage that triggered this talent's use, and your ally takes no damage."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.7505fbdd592c04fd","name":"Bodyguard's Sacrifice"}],"_source":"canonical-csv"},"treeId":"c92c2cbc79b8a515","tags":["damage_reduction","mobility","positioning","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action_reference","applicationScope":"martial_protector_arena_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","combatActions":[{"id":"lifesaver-t30-reference","name":"Lifesaver","label":"Lifesaver","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter as a Reaction, when an ally takes damage that equals or exceeds its Damage Threshold or reduces it to 0 Hit Points, you can move up to your speed provided you end your movement adjacent to that ally. This movement provokes Attacks of Opportunity as normal, you take all of the damage that triggered this Talent's use, and your ally takes no damage.","notes":"Once per encounter as a Reaction, when an ally takes damage that equals or exceeds its Damage Threshold or reduces it to 0 Hit Points, you can move up to your speed provided you end your movement adjacent to that ally. This movement provokes Attacks of Opportunity as normal, you take all of the damage that triggered this Talent's use, and your ally takes no damage.","relatedSkills":[],"resources":["Once per encounter","Ally context","Adjacent positioning","Damage Threshold context"],"requiredContext":["Valid adjacent creature/ally positioning","Triggering attack/damage result confirmed","Reaction timing available","Encounter use available","Protected ally and damage-transfer context confirmed"],"targetHint":"GM/player adjudicated target or context","spendAction":false,"ruleData":{}}],"rules":[],"phase30MartialProtectorArenaCleanup":{"phase":"T30","tree":"Protection","status":"reviewed_manual_or_runtime_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"T30 removed unsafe passive rows from martial/protector/arena/species leftovers and surfaced action, reaction, recovery, cover, and attack-rider context as truthful cards/rules."}},"summary":"Once per encounter as a reaction, when an ally takes damage that equals or exceeds its damage threshold or reduces it to 0 hit points, you can move up to your speed provided you end your movement adjacent to that ally.","source":"Legacy Era Campaign Guide","page":41},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.lifesaver","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.421Z","detectedPredicates":["proximity.ally-nearby","turn.once-per-round"]}}}
{"_id":"8ed7b1889b1416d4","name":"Terrify","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Frighten, Inspire Fear I, Inspire Fear II","benefit":"As a standard action, you can make a Persuasion check against a target that is within your line of sight and that is also affected by your Inspire Fear talent. If you equal or exceed the target's Will Defense, then on its next turn the target must spend at least one move action to move away from you. If the target is somehow prevented from doing so, then the penalty from Inspire Fear doubles until the start of your next turn. This is a mind-affecting fear effect.","description":{"value":"As a standard action, you can make a Persuasion check against a target that is within your line of sight and that is also affected by your Inspire Fear talent. If you equal or exceed the target's Will Defense, then on its next turn the target must spend at least one move action to move away from you. If the target is somehow prevented from doing so, then the penalty from Inspire Fear doubles until the start of your next turn. This is a mind-affecting fear effect."},"class":"324631ca844a88be","costNumeric":null,"category":"Crime Lord","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.71bc6b43ab504b90","name":"Inspire Fear II"},{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.50273d5ce8f84c31","name":"Frighten"}],"_source":"canonical-csv"},"treeId":"c1be604242cb328f","tags":["force","force_control","mobility","skills","social","fear","mind-affecting","minion","intimidation"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"hunter_pursuit_fear_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals.","combatActions":[{"id":"terrify","name":"Terrify","label":"Terrify","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Standard Action, you can make a Persuasion check against a target that is within your line of sight and that is also affected by your Inspire Fear Talent. If you equal or exceed the target's Will Defense, then on its next turn the target must spend at least one Move Action to move away from you. If the target is somehow prevented from doing so, then the penalty from the Inspire Fear Talent doubles until the start of your next turn. This is a Mind-Affecting Fear effect.","notes":"As a Standard Action, you can make a Persuasion check against a target that is within your line of sight and that is also affected by your Inspire Fear Talent. If you equal or exceed the target's Will Defense, then on its next turn the target must spend at least one Move Action to move away from you. If the target is somehow prevented from doing so, then the penalty from the Inspire Fear Talent doubles until the start of your next turn. This is a Mind-Affecting Fear effect.","relatedSkills":[{"skill":"persuasion","when":"Against target Will Defense"}],"resources":["Mind-affecting fear"],"requiredContext":["Target within line of sight","Target affected by required fear talent if applicable"],"targetHint":"One target","spendAction":true,"ruleData":{}}],"phase26HunterPursuitFearCleanup":{"phase":"T26","tree":"Infamy","status":"combat_action_card","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals."}},"summary":"As a standard action, you can make a Persuasion check against a target that is within your line of sight and that is also affected by your Inspire Fear talent.","source":"Scum and Villainy","page":27},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.terrify","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.421Z","detectedPredicates":[],"talentHunterPursuitFearCleanup":{"phase":"T26","tree":"Infamy","status":"combat_action_card"}}}}
{"_id":"8f388280e0d1b244","name":"Hasty Withdrawal","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a swift action once per turn, you target a number of allies equal to your Charisma bonus (minimum 1). Each targeted ally must be within 12 squares of you and in your line of sight. Each ally you target can take the withdraw action immediately as a free action. The normal rules for withdrawing otherwise apply (see page 153 of the Saga Edition core rulebook).","description":{"value":"As a swift action once per turn, you target a number of allies equal to your Charisma bonus (minimum 1). Each targeted ally must be within 12 squares of you and in your line of sight. Each ally you target can take the withdraw action immediately as a free action. The normal rules for withdrawing otherwise apply (see page 153 of the Saga Edition core rulebook)."},"class":"30b9cd24b80ebf46","costNumeric":null,"category":"Officer","treeId":"61b74c82cb56876c","tags":["action_economy","mobility","precision","skills","stealth","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"hasty-withdrawal","name":"Hasty Withdrawal","label":"Hasty Withdrawal","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per turn, choose allies up to your Charisma bonus (minimum 1) within 12 squares and line of sight. Each chosen ally can immediately Withdraw as a Free Action.","notes":"Once per turn, choose allies up to your Charisma bonus (minimum 1) within 12 squares and line of sight. Each chosen ally can immediately Withdraw as a Free Action.","relatedSkills":[],"resources":["Once per turn"],"requiredContext":[],"targetHint":"Eligible allies within 12 squares","spendAction":true,"ruleData":{}}],"manualResolution":true,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Fugitive Commander","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"As a swift action once per turn, you target a number of allies equal to your Charisma bonus (minimum 1).","source":"Legacy Era Campaign Guide","page":42},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hasty_withdrawal","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.421Z","detectedPredicates":[],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Follower/dependent-actor subsystem or GM/player managed","note":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals."}}}}
{"_id":"8f64ec5c81784b2d","name":"Tyia Adept","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":"As a swift action, you can spend a Force Point to designate one nondroid ally within 12 squares of you and in your line of sight. Until the end of your next turn, whenever you or the targeted ally takes damage from any source, you take half of the damage and your ally takes half of the damage. This halving of damage takes place before the damage is compared to your respective damage thresholds.","benefit":"As a swift action, you can spend a Force Point to designate one nondroid ally within 12 squares of you and in your line of sight. Until the end of your next turn, whenever you or the targeted ally takes damage from any source, you take half of the damage and your ally takes half of the damage. This halving of damage takes place before the damage is compared to your respective damage thresholds.","class":"","category":"","costNumeric":null,"treeId":"9a5efe5d0e9b43a1","tags":["action_economy","condition_removal","dark_side","defense","droid","force","force_capacity","force_control","force_offense","force_point_spend","force_power_synergy","meditation","mobility","positioning","reaction","resource_spend","support","swift_action","use_the_force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"reaction_or_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"modifiers":[],"combatActions":[{"id":"tyia-adept","name":"Tyia Adept","label":"Tyia Adept","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"When an ally within 12 squares of you and in your line of sight takes damage or moves down the Condition Track by any means, you can designate a different ally within 12 squares of you and in your line of sight as a Reaction. The ally you designate gain Bonus Hit Points equal to 5 + your Charisma modifier (minimum +1). Damage is subtracted from Bonus Hit Points first, and any Bonus Hit Points remaining at the end of the encounter are lost. Prerequisite: You can designate an ally within 12 squares of you and in your line of sight once per turn as a Swift Action; that ally immediately takes its Second Wind if it has not yet done so in this encounter. Whenever you are targeted by a Force Power with the [Dark Side] descriptor, you can spend a Force Point as a Reaction to give the creature that used that Force Power against you a penalty on its Use the Force check to activate the power equal to its Dark Side Score. You can choose to have any Force Power you activate deal Stun Damage instead of normal damage. As a Swift Action, you can spend a Force Point to designate one non-Droid ally within 12 squares of you and in your line of sight. Until the end of your next turn, whenever you or the targeted ally takes damage from any source, you take half of the damage and your ally takes half of the damage. This halving of damage takes place before the damage is compared to your respective Damage Thresholds.","notes":"When an ally within 12 squares of you and in your line of sight takes damage or moves down the Condition Track by any means, you can designate a different ally within 12 squares of you and in your line of sight as a Reaction. The ally you designate gain Bonus Hit Points equal to 5 + your Charisma modifier (minimum +1). Damage is subtracted from Bonus Hit Points first, and any Bonus Hit Points remaining at the end of the encounter are lost. Prerequisite: You can designate an ally within 12 squares of you and in your line of sight once per turn as a Swift Action; that ally immediately takes its Second Wind if it has not yet done so in this encounter. Whenever you are targeted by a Force Power with the [Dark Side] descriptor, you can spend a Force Point as a Reaction to give the creature that used that Force Power against you a penalty on its Use the Force check to activate the power equal to its Dark Side Score. You can choose to have any Force Power you activate deal Stun Damage instead of normal damage. As a Swift Action, you can spend a Force Point to designate one non-Droid ally within 12 squares of you and in your line of sight. Until the end of your next turn, whenever you or the targeted ally takes damage from any source, you take half of the damage and your ally takes half of the damage. This halving of damage takes place before the damage is compared to your respective Damage Thresholds.","relatedSkills":[{"skill":"Use the Force"}],"resources":["Force Point context","Second Wind context","Condition Track context","Force Power Suite context"],"requiredContext":["Line of sight confirmed by GM/player","Ally context confirmed","Target context confirmed"],"targetHint":"GM/player adjudicated target or affected creature(s)","spendAction":true,"ruleData":{},"reactionTrigger":"GM_ADJUDICATED_REACTION_WINDOW"}],"rules":[],"notes":"T28 removed unsafe migrated modifier/effect data. This talent depends on Force-suite, target, equipment, ally, encounter, or table-position context and is surfaced as a truthful manual/runtime card rather than a passive actor mutation.","phase28ForceMicrotraditionCleanup":{"phase":"T28","tree":"Tyia Adept","status":"reviewed_contextual_or_manual_card","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Force/special-tradition microtree cleanup. Unsafe always-on rows were removed; final bonuses/effects require player/GM or future dedicated runtime owner."}},"summary":"As a swift action, you can spend a Force Point to designate one nondroid ally within 12 squares of you and in your line of sight.","source":"Jedi Academy Training Manual","page":87},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.421Z","detectedPredicates":["attack.when-hit","proximity.ally-nearby"]}}}
{"_id":"8fe560a110d8f4ee","name":"It's a Trap!","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You are skilled at sensing the plans of enemy naval officers and counteracting them. Once per encounter as a reaction, you can grant the pilot of any single vehicle within line of sight (including a vehicle you are commanding) an immediate move action.","description":{"value":"You are skilled at sensing the plans of enemy naval officers and counteracting them. Once per encounter as a reaction, you can grant the pilot of any single vehicle within line of sight (including a vehicle you are commanding) an immediate move action."},"class":"30b9cd24b80ebf46","costNumeric":null,"category":"Officer","treeId":"057a978a7dc1d5a7","tags":["action_economy","mobility"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Vehicle/crew systems or GM/player managed","notes":"Vehicle/crew/tactical effects need vehicle, commander, gunner, pilot, line-of-sight, or target context not available to static actor prep.","combatActions":[{"id":"its-a-trap","name":"It's a Trap","label":"It's a Trap","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, grant the pilot of one vehicle within line of sight an immediate Move Action.","notes":"Once per encounter, grant the pilot of one vehicle within line of sight an immediate Move Action.","relatedSkills":[],"resources":["Once per encounter","Vehicle command"],"requiredContext":[],"targetHint":"One vehicle pilot within line of sight","spendAction":true,"ruleData":{}}],"manualResolution":true,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Naval Officer","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"Once per encounter as a reaction, grant the pilot of one visible vehicle an immediate move action.","source":"Starships of the Galaxy","page":18},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.its_a_trap","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.421Z","detectedPredicates":["turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Vehicle/crew systems or GM/player managed","note":"Vehicle/crew/tactical effects need vehicle, commander, gunner, pilot, line-of-sight, or target context not available to static actor prep."}}}}
{"_id":"8ff0ec89e13b6d51","name":"Psychometry","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Farseeing, Force Perception","benefit":"When you use the farseeing Force power, you can choose to target an object you hold instead of a character or creature. You can look into the targeted object's past, up to a maximum of 5 years per your character level. Any information gained about the object's past is based on the thoughts and emotions of the person holding or carrying the object at the time you perceive, which can skew the results of the vision.","description":"When you use the farseeing Force power, you can choose to target an object you hold instead of a character or creature. You can look into the targeted object's past, up to a maximum of 5 years per your character level. Any information gained about the object's past is based on the thoughts and emotions of the person holding or carrying the object at the time you perceive, which can skew the results of the vision.","costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.a358402a9fc26c02","name":"Force Perception"}],"_source":"canonical-csv"},"treeId":"d6b4331c0e31f7e3","tags":["force","initiative","pilot","precognition","senses"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"psychometry","name":"Psychometry","label":"Psychometry","actionType":"full-round","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Target an object you hold; read impressions up to 5 years per level.","notes":"Target an object you hold; read impressions up to 5 years per level.","relatedSkills":[],"resources":["Read object impressions"],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Sense","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"Use farseeing on a held object to perceive up to 5 years of its past per character level through its prior holder's impressions.","source":"Clone Wars Campaign Guide","page":53},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.psychometry","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.421Z","detectedPredicates":[],"forceTalentCleanup":{"phase":"T22","tree":"Sense","status":"combat_action_card"}}}}
{"_id":"902c2cef66cf4df6","name":"Reap Retribution","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"If you take damage from the use of a Force Power, until the end of the encounter you deal an extra 2 points of damage against the creature that used the Force Power against you.","description":"If you take damage from the use of a Force Power, until the end of the encounter you deal an extra 2 points of damage against the creature that used the Force Power against you.","class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"36f18f3e974feb33","tags":["force","force_offense","light_side"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"modifiers":[],"combatActions":[{"id":"reap-retribution","name":"Reap Retribution","label":"Reap Retribution","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"If you take damage from the use of a Force Power, until the end of the encounter you deal an extra 2 points of damage against the creature that used the Force Power against you.","notes":"If you take damage from the use of a Force Power, until the end of the encounter you deal an extra 2 points of damage against the creature that used the Force Power against you.","relatedSkills":[],"resources":["Encounter duration"],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}},{"id":"reap-retribution-damage-rider","name":"Reap Retribution","label":"Reap Retribution","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"When the Reap Retribution trigger is valid, opt in to add its damage rider to the appropriate attack. Confirm timing/trigger at the table.","notes":"When the Reap Retribution trigger is valid, opt in to add its damage rider to the appropriate attack. Confirm timing/trigger at the table.","relatedSkills":[],"resources":["+2 damage rider"],"requir