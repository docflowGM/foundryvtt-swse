{"_id":"2931a9052148e79a","name":"Creeping Approach","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Trained in the Stealth skill","benefit":"As a swift action, you can designate a single opponent within 12 squares that is unaware of you as the target of this talent. Until the beginning of your next turn, that target may not make Perception checks to notice you, even if you enter the target's line of sight. If you or any of your allies attack the target, the effect of this talent ends.","description":{"value":"As a swift action, you can designate a single opponent within 12 squares that is unaware of you as the target of this talent. Until the beginning of your next turn, that target may not make Perception checks to notice you, even if you enter the target's line of sight. If you or any of your allies attack the target, the effect of this talent ends."},"class":"e647ee8f065e1d19","costNumeric":null,"category":"Infiltrator","treeId":"7c7a8730e1b4381a","tags":["perception","positioning","skills","stealth","infiltration","pursuit","stun"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"hunter_pursuit_fear_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals.","phase26HunterPursuitFearCleanup":{"phase":"T26","tree":"Infiltration","status":"combat_action_card","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals."},"combatActions":[{"id":"creeping-approach","name":"Creeping Approach","label":"Creeping Approach","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Swift Action, you can designate a single opponent within 12 squares that is unaware of you as the target of this Talent. Until the beginning of your next turn, that target may not make Perception checks to notice you, even if you enter the target's line of sight. If you or any of your allies attack the target, the effect of this Talent ends.","notes":"As a Swift Action, you can designate a single opponent within 12 squares that is unaware of you as the target of this Talent. Until the beginning of your next turn, that target may not make Perception checks to notice you, even if you enter the target's line of sight. If you or any of your allies attack the target, the effect of this Talent ends.","relatedSkills":[{"skill":"stealth"}],"resources":["Target unaware of you","Target cannot make Perception to notice you until next turn"],"requiredContext":["Target within 12 squares","Target unaware of you"],"targetHint":"One unaware opponent","spendAction":true,"ruleData":{}}]},"summary":"As a swift action, you can designate a single opponent within 12 squares that is unaware of you as the target of this talent.","source":"Force Unleashed Campaign Guide","page":49},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.creeping_approach","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.406Z","detectedPredicates":[],"talentHunterPursuitFearCleanup":{"phase":"T26","tree":"Infiltration","status":"combat_action_card"}}}}
{"_id":"294bad1c8a7b4132","name":"Make a Break for It","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Spacehound, Stellar Warrior","benefit":"Once per encounter, while on or in a vehicle, you can move up to one-half your speed or move the vehicle up to one-half its speed if you are the pilot, as a swift action. This movement does not provoke attacks of opportunity.","description":"Once per encounter, while on or in a vehicle, you can move up to one-half your speed or move the vehicle up to one-half its speed if you are the pilot, as a swift action. This movement does not provoke attacks of opportunity.","class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.f92583cf04620d84","name":"Stellar Warrior"}],"_source":"canonical-csv"},"treeId":"5ea8c79492d40713","tags":["mobility"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"make-a-break-for-it","name":"Make a Break for It","label":"Make a Break for It","actionType":"move","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter while aboard a vehicle, move without provoking attacks of opportunity.","notes":"Once per encounter while aboard a vehicle, move without provoking attacks of opportunity.","resources":["Once per encounter","Aboard vehicle"]}],"phase16VehicleStarshipCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual combat action card in the action economy UI."}},"summary":"Once per encounter, while on or in a vehicle, you can move up to one-half your speed or move the vehicle up to one-half its speed if you are the pilot, as a swift action.","source":"Scum and Villainy","page":16},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.make_a_break_for_it","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.406Z","detectedPredicates":["turn.once-per-round"]}}}
{"_id":"299c45ac33bf1485","name":"Visionary Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"farseeing, WatchCircle Initiate","benefit":"As a reaction, you can make a Use the Force check after you or an ally within 12 squares misses with a melee or ranged attack, removing one use of the farseeing Force power from your active suite (as though you had activated the power). If your check result equals or exceeds the Will Defense of the target of that missed attack, the attacker can reroll the missed attack roll. This counts as using the farseeing Force power against that target, but this talent replaces the normal rules and effect of that power. Any attack can only be affected by this talent once (thus, multiple characters cannot use this talent on the same attack to allow multiple rerolls). You take a cumulative -5 penalty on Use the Force checks until the beginning of your next turn when you use this talent.","description":{"value":"As a reaction, you can make a Use the Force check after you or an ally within 12 squares misses with a melee or ranged attack, removing one use of the farseeing Force power from your active suite (as though you had activated the power). If your check result equals or exceeds the Will Defense of the target of that missed attack, the attacker can reroll the missed attack roll. This counts as using the farseeing Force power against that target, but this talent replaces the normal rules and effect of that power. Any attack can only be affected by this talent once (thus, multiple characters cannot use this talent on the same attack to allow multiple rerolls). You take a cumulative -5 penalty on Use the Force checks until the beginning of your next turn when you use this talent."},"class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.ab9f1497d0b2d7c2","name":"WatchCircle Initiate"}],"_source":"canonical-csv"},"treeId":"e99cfa9db8493573","tags":["force","force_offense","light_side","positioning","support","reaction"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"visionary-attack","name":"Visionary Attack","label":"Visionary Attack","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"reaction","useLabel":"React / Note","description":"After you or an ally within 12 squares misses, roll Use the Force and expend Farseeing to grant a reroll/benefit as described.","notes":"After you or an ally within 12 squares misses, roll Use the Force and expend Farseeing to grant a reroll/benefit as described.","relatedSkills":[{"skill":"Use the Force"}],"resources":["Use the Force check"],"requiredContext":["Reaction timing must be valid"],"targetHint":"","spendAction":true,"ruleData":{"reactionKey":"visionaryAttack","trigger":"ON_ATTACK_MISSED"}}],"rules":[],"mechanicsMode":"contextual","applicationScope":"force_lightsaber_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":false,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Jedi Consular","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":1,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."},"reactionKey":"visionaryAttack","grantedReactions":["visionaryAttack"],"implementationNote":"Implemented through ConsularTalentActions.promptVisionaryAttack and the combat action tracker."},"implementationNote":"Implemented through ConsularTalentActions.promptVisionaryAttack and the combat action tracker.","summary":"As a reaction, you can make a Use the Force check after you or an ally within 12 squares misses with a melee or ranged attack, removing one use of the farseeing Force power from your active suite (as though you had activated the power).","source":"Knights of the Old Republic Campaign Guide","page":24},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.visionary_attack","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.406Z","detectedPredicates":[]}}}
{"_id":"29ae5a7db772d779","name":"Waveform","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Order of Shasa","talentTree":"Order of Shasa","tree":"Order of Shasa","treeId":"d2e4cd882822dcf2","prerequisites":"","description":{"value":"Taking cues from Manaan's oceans, you know how to emulate wave action using the Force. As a swift action, when you use a telekinetic Force power (that is, a power affected by the Telekinetic Power or Telekinetic Savant talents), you manipulate the particles of the environment around you to add to the force of impact, allowing you to add your Charisma modifier to any damage dealt (minimum +1)."},"benefit":"Taking cues from Manaan's oceans, you know how to emulate wave action using the Force. As a swift action, when you use a telekinetic Force power (that is, a power affected by the Telekinetic Power or Telekinetic Savant talents), you manipulate the particles of the environment around you to add to the force of impact, allowing you to add your Charisma modifier to any damage dealt (minimum +1).","class":"","category":"","costNumeric":null,"source":"Knights of the Old Republic Campaign Guide","tags":["force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"waveform","name":"Waveform","label":"Waveform","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Taking cues from Manaan's oceans, you know how to emulate wave action using The Force. As a Swift Action, when you use a Telekinetic Force Power (that is, a Force Power with the [Telekinetic] descriptor), you manipulate the particles of the environment around you to add to the force of the impact, allowing you to add your Charisma modifier to any damage dealt (minimum +1).","notes":"Taking cues from Manaan's oceans, you know how to emulate wave action using The Force. As a Swift Action, when you use a Telekinetic Force Power (that is, a Force Power with the [Telekinetic] descriptor), you manipulate the particles of the environment around you to add to the force of the impact, allowing you to add your Charisma modifier to any damage dealt (minimum +1).","relatedSkills":[{"skill":"Use the Force"}],"resources":["When using Telekinetic Force Power, add Charisma modifier to damage"],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Order of Shasa","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"Taking cues from Manaan's oceans, you know how to emulate wave action using the Force.","page":61},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"sourcePatch":"force-tradition-and-jedi-guardian-membership","forceTalentCleanup":{"phase":"T22","tree":"Order of Shasa","status":"combat_action_card"}}}}
{"_id":"29f73c36cabdeaf5","name":"Hyperdriven","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per day while aboard a Starship, you can add your Class Level as a bonus on a single attack roll, Skill Check, or Ability Check. The decision to add this bonus can be made after the result of the check is known.","description":{"value":"Once per day while aboard a Starship, you can add your Class Level as a bonus on a single attack roll, Skill Check, or Ability Check. The decision to add this bonus can be made after the result of the check is known."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","treeId":"5ea8c79492d40713","tags":["vehicle","space","skills","ability_enhancement","precision","scaling","reliability"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"hyperdriven","name":"Hyperdriven","label":"Hyperdriven","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per day while aboard a starship, after seeing the roll result, add your class level to one attack roll, skill check, or ability check.","notes":"Once per day while aboard a starship, after seeing the roll result, add your class level to one attack roll, skill check, or ability check.","resources":["Once per day","Aboard starship"]}],"phase16VehicleStarshipCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual combat action card in the action economy UI."}},"summary":"Once per day while aboard a Starship, you can add your Class Level as a bonus on a single attack roll, Skill Check, or Ability Check.","source":"Saga Edition Core Rulebook","page":47},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hyperdriven","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.406Z","detectedPredicates":[]}}}
