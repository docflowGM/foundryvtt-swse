{"_id":"46946e7208f1cf05","name":"Six Questions","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Spynet Agent","benefit":"You have mastered the basic Bothan philosophy of Six Questions to glean more information from contacts through fewer questions. As a swift action, you can make a Knowledge (galactic lore) check against a DC equal to 15 + the target's CL. If the check is successful, you learn a target character's level, classes, and ability scores, and the target's available Force Points and Destiny Points.","description":{"value":"You have mastered the basic Bothan philosophy of Six Questions to glean more information from contacts through fewer questions. As a swift action, you can make a Knowledge (galactic lore) check against a DC equal to 15 + the target's CL. If the check is successful, you learn a target character's level, classes, and ability scores, and the target's available Force Points and Destiny Points."},"costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.648d9634a3795988","name":"Spynet Agent"}],"_source":"canonical-csv"},"treeId":"d20682671d035cef","tags":["action_economy","force","investigation","knowledge","resources","social","social_network","swift_action","target-designation"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"hunter_pursuit_fear_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals.","phase26HunterPursuitFearCleanup":{"phase":"T26","tree":"Bothan Spynet","status":"combat_action_card","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Revi