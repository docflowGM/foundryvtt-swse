{"_id":"a0ace6dcc1c67d48","name":"Elusive Target","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When fighting an opponent or multiple opponents in melee, other opponents attempting to target you with ranged attacks take a -5 penalty. This penalty is in addition to the normal -5 penalty for firing into melee, making the penalty to target you -10.","description":{"value":"When fighting an opponent or multiple opponents in melee, other opponents attempting to target you with ranged attacks take a -5 penalty. This penalty is in addition to the normal -5 penalty for firing into melee, making the penalty to target you -10."},"class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"10c843cef8ce2798","tags":["force","force_offense","light_side","melee","positioning","ranged"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"attacker_penalty_manual","staticSheetPolicy":"manual_only","manualResolution":true,"notes":"Ranged attackers take a penalty when you are engaged in melee. This is an enemy attack penalty, not a self attack/defense bonus; punt until target/attacker context owns it.","modifiers":[]},"talent_tree":"Jedi Guardian","talentTree":"Jedi Guardian","tree":"Jedi Guardian","source":"Saga Edition Core Rulebook","summary":"When fighting an opponent or multiple opponents in melee, other opponents attempting to target you with ranged attacks take a -5 penalty.","page":40},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.elusive_target","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.423Z","detectedPredicates":["attack.with-melee","attack.with-ranged"],"jediTreeCleanup":{"phase":"T7","status":"manual_or_contextual","reason":"Ranged attackers take a penalty when you are engaged in melee. This is an enemy attack penalty, not a self attack/defense bonus; punt until target/attacker context owns it."},"so