{"_id":"e54ecc0ff06e61f3","name":"Lightsaber Throw","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can hurl a lightsaber as a standard action, treating it as a thrown weapon. You are considered proficient with the thrown lightsaber, and you apply the normal range penalties to the attack roll (see Table 8-5: Range Penalties). The thrown lightsaber deals normal weapon damage if it hits.\n\nIf your target is no more than 6 squares away, you can pull your lightsaber back to your hand as a swift action by making a DC 20 Use the Force check,","description":{"value":"You can hurl a lightsaber as a standard action, treating it as a thrown weapon. You are considered proficient with the thrown lightsaber, and you apply the normal range penalties to the attack roll (see Table 8-5: Range Penalties). The thrown lightsaber deals normal weapon damage if it hits.\n\nIf your target is no more than 6 squares away, you can pull your lightsaber back to your hand as a swift action by making a DC 20 Use the Force check,"},"class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"2359c05ff13f3feb","tags":["action_economy","battlefield_control","force","force_control","force_defense","force_offense","lightsaber","melee","mobility","positioning","ranged"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"active_attack_helper","applicationScope":"lightsaber_throw_runtime","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":false,"engineOwner":"Force suite / Force roll flow","conditionSummary":"Lightsaber Throw: standard action thrown lightsaber option, proficiency while thrown, and swift return with Use the Force DC 20 if within 6 squares.","recommendedAction":"Needs a thrown-lightsaber attack option and return prompt; do not apply any Reflex bonus.","modifiers":[]},"talent_tree":"Lightsaber Combat","talentTree":"Lightsaber Combat","tree":"Lightsaber Combat","summary":"You can hurl a lightsaber as a standard action, treating it as a thrown weapon.","source":"Saga Edition Core Rulebook","page":41},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.lightsaber_throw","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.431Z","detectedPredicates":["defense.reflex","attack.with-ranged"],"lightsaberTalentImplementation":{"status":"runtime_action_or_contextual","updated":"2026-06-11"}}}}
{"_id":"e58a8ad63c1d8771","name":"Connections","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You are able to obtain licensed, restricted, military, or illegal equipment without having to pay a licensing fee or endure a background check, provided the total cost of the desired equipment is equal to or less than your character level x 1,000 credits. In addition, when obtaining equipment or services through the black market, you reduce the black market cost multiplier by 1. See Restricted Items (page 118) for details.","description":{"value":"You are able to obtain licensed, restricted, military, or illegal equipment without having to pay a licensing fee or endure a background check, provided the total cost of the desired equipment is equal to or less than your character level x 1,000 credits. In addition, when obtaining equipment or services through the black market, you reduce the black market cost multiplier by 1. See Restricted Items (page 118) for details."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","treeId":"b5bb4154688c66ab","tags":["force","skills","social","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual_or_future_runtime","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed","notes":"Procurement/store/legal access talent; not a combat modifier. GM/store flow should honor licensing/background-check bypass up to character level x 1,000 credits.","phase23SocialCommanderCleanup":{"phase":"T23","tree":"Lineage","status":"reviewed_manual_or_future_runtime","cardsAdded":0,"notes":"Procurement/store/legal access talent; not a combat modifier. GM/store flow should honor licensing/background-check bypass up to character level x 1,000 credits."}},"summary":"You are able to obtain licensed, restricted, military, or illegal e