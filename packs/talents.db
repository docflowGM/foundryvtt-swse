{"_id":"ddece484fcea9c84","name":"Medical Miracle","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a standard action, you can make a DC 20 Treat Injury check on an adjacent target. If the check is successful, that target immediately uses its second wind, even if it is above half hit points. If the target has already expended all of its second winds for the day, this talent has no effect.","description":{"value":"As a standard action, you can make a DC 20 Treat Injury check on an adjacent target. If the check is successful, that target immediately uses its second wind, even if it is above half hit points. If the target has already expended all of its second winds for the day, this talent has no effect."},"class":"06f4d9029debf827","costNumeric":null,"category":"Medic","treeId":"61725c845d26ade0","tags":["healing","positioning","skills","standard_action","support","survivability","teamwork","treat_injury"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"medical-miracle","name":"Medical Miracle","label":"Medical Miracle","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Make a DC 20 Treat Injury check on an adjacent target; on success, the target immediately uses Second Wind even if above half Hit Points.","notes":"If the target has no Second Winds remaining for the day, this talent has no effect.","relatedSkills":[{"skill":"Treat Injury","dc":20}],"resources":["Consumes target Second Wind"],"requiredContext":["Adjacent target","Target has a Second Wind remaining"],"targetHint":"One adjacent creature"}],"phase18MedicalBiotechCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual action-economy card; no passive bonus is applied automatically."}},"summary":"As a standard action, you can make a DC 20 Treat Injury check on an adjacent target.","source":"Force Unleashed Campaign Guide","page":54},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.medical_miracle","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":["attack.when-hit"]}}}
{"_id":"ddf81a7bb146ed87","name":"Extreme Explosion","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Skilled Demolitionist, Shaped Explosion","benefit":"You know how to set large charges and use dozens of charges for extremely large explosions. You increase the blast radius of any mines or explosives by 1 square.","description":{"value":"You know how to set large charges and use dozens of charges for extremely large explosions. You increase the blast radius of any mines or explosives by 1 square."},"class":"de3f367749b82fcf","costNumeric":null,"category":"Saboteur","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.7ab4fcbe5a8b7714","name":"Shaped Explosion"}],"_source":"canonical-csv"},"treeId":"8897a36d59662ee9","tags":["positioning"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase17TechEngineeringCleanup":{"status":"cleaned_future_runtime_context","owner":"future_explosive_area_resolver","notes":"Adds +1 square burst radius only for mines/explosives; removed unsafe item Active Effect."}},"summary":"You know how to set large charges and use dozens of charges for extremely large explosions.","source":"Force Unleashed Campaign Guide","page":57},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.extreme_explosion","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":[]}}}
{"_id":"de751f28fc269c85","name":"Intimidating Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Presence, trained in Persuasion","benefit":"Once per encounter, as a reaction, you can make a Persuasion check to intimidate one creature that has made a melee or ranged attack against you if that creature is within line of sight. If you succeed, you impose a —5 penalty to that attack roll. If the target is higher level than you, it gains a +5 bonus to its Will Defense against the Intimidating Defense.\n\nThis is a mind-affecting effect.","description":{"value":"Once per encounter, as a reaction, you can make a Persuasion check to intimidate one creature that has made a melee or ranged attack against you if that creature is within line of sight. If you succeed, you impose a —5 penalty to that attack roll. If the target is higher level than you, it gains a +5 bonus to its Will Defense against the Intimidating Defense.\n\nThis is a mind-affecting effect."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.ec8f2ba706cc2c05","name":"Presence"}],"_source":"canonical-csv"},"treeId":"8375b9b26b679901","tags":["skills","social"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed target context","notes":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists.","combatActions":[{"id":"intimidating-defense","name":"Intimidating Defense","label":"Intimidating Defense","actionType":"reaction","cost":1,"manualResolution":false,"resolutionMode":"auto","useLabel":"Roll / Use","description":"Once per encounter, when a creature within line of sight makes a melee or ranged attack against you, make a Persuasion check to Intimidate. On success, impose a -5 penalty to that attack roll.","notes":"Once per encounter, when a creature within line of sight makes a melee or ranged attack against you, make a Persuasion check to Intimidate. On success, impose a -5 penalty to that attack roll.","relatedSkills":[{"skill":"persuasion","when":"Intimidate vs attacker Will Defense"}],"resources":["Once per encounter","Mind-affecting","Higher-level target gains +5 Will Defense"],"requiredContext":["Incoming melee or ranged attack against you","Attacker is within line of sight"],"targetHint":"Incoming attacker","spendAction":true,"ruleData":{},"skillKey":"persuasion","reactionKey":"intimidatingDefense","reactionTrigger":"ON_ATTACK_DECLARED"}],"manualResolution":false,"reactionKeys":["intimidatingDefense"],"reactions":[{"key":"intimidatingDefense","trigger":"ON_ATTACK_DECLARED","source":"Intimidating Defense"}],"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Influence","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"Once per encounter, as a reaction, you can make a Persuasion check to intimidate one creature that has made a melee or ranged attack against you if that creature is within line of sight.","source":"Knights of the Old Republic Campaign Guide","page":26},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.intimidating_defense","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":["defense.will","turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"GM/player managed target context","note":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists."}}}}
{"_id":"ded0046215380b0c","name":"Defensive Protection","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can spend a Force Point as a reaction and add the results of the Force Point roll to any one of your defenses, or to one of the defenses of an adjacent ally. This bonus lasts until the beginning of your next turn.","description":{"value":"You can spend a Force Point as a reaction and add the results of the Force Point roll to any one of your defenses, or to one of the defenses of an adjacent ally. This bonus lasts until the beginning of your next turn."},"class":"b5bed5d1b5f42958","costNumeric":null,"category":"Scout","treeId":"ab2c265c4b2f54f6","tags":["force","force_defense","positioning","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"You can spend a Force Point as a reaction and add the results of the Force Point roll to any one of your defenses, or to one of the defenses of an adjacent ally.","source":"Legacy Era Campaign Guide","page":30},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.defensive_protection","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":["proximity.ally-nearby"]}}}
{"_id":"df1bdd9ca78ad14d","name":"Link","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can lend your strength in the Force to another character, creating a bond between you through which the Force flows. As a standard action, you can designate one willing ally within 12 squares of you and in your line of sight, This ally must be trained in the Use the Force skill. As long as you remain within 12 squares of each other, you can aid each other on Use the Force checks as a reaction. However, the character using the aid another reaction takes a -5 penalty on all Use the Force checks until the end of his next turn. This link lasts until the end of the encounter, or until you or your ally ends the link (a free action). You can have only one active link at a time.","description":"You can lend your strength in the Force to another character, creating a bond between you through which the Force flows. As a standard action, you can designate one willing ally within 12 squares of you and in your line of sight, This ally must be trained in the Use the Force skill. As long as you remain within 12 squares of each other, you can aid each other on Use the Force checks as a reaction. However, the character using the aid another reaction takes a -5 penalty on all Use the Force checks until the end of his next turn. This link lasts until the end of the encounter, or until you or your ally ends the link (a free action). You can have only one active link at a time.","costNumeric":null,"treeId":"6ac3416fb6aada56","tags":["action_economy","force","light_side","skill_substitution","support","telekinesis","telepathy"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"link","name":"Link","label":"Link","actionType":"free","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"This lasts until the end of the encounter, or until you or your ally ends the (a Free Action). You can have only one active at a time. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual","notes":"This lasts until the end of the encounter, or until you or your ally ends the (a Free Action). You can have only one active at a time. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual","relatedSkills":[],"resources":[],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Alter","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"You can lend your strength in the Force to another character, creating a bond between you through which the Force flows.","source":"Jedi Academy Training Manual","page":15},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.link","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":[],"forceTalentCleanup":{"phase":"T22","tree":"Alter","status":"combat_action_card"}}}}
{"_id":"df40e8294bd43fe7","name":"Sentinel's Gambit","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per encounter, as a swift action, you can designate an adjacent enemy with a Dark Side Score of 1 or higher as the target of this talent. The designated enemy loses its Dexterity bonus to Reflex Defense against your attacks until the end of your next turn.","description":"Once per encounter, as a swift action, you can designate an adjacent enemy with a Dark Side Score of 1 or higher as the target of this talent. The designated enemy loses its Dexterity bonus to Reflex Defense against your attacks until the end of your next turn.","class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"36f18f3e974feb33","tags":["dark_side","force","light_side"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"sentinels-gambit","name":"Sentinel's Gambit","label":"Sentinel's Gambit","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, as a Swift Action, you can designate an adjacent opponent with a Dark Side Score of 1 or higher as the target of this Talent. The designated opponent loses its Dexterity bonus to Reflex Defense against your attacks until the end of your next turn.","notes":"Once per encounter, as a Swift Action, you can designate an adjacent opponent with a Dark Side Score of 1 or higher as the target of this Talent. The designated opponent loses its Dexterity bonus to Reflex Defense against your attacks until the end of your next turn.","relatedSkills":[],"resources":["Once per encounter"],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{}}],"rules":[],"mechanicsMode":"contextual","applicationScope":"force_lightsaber_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true,"phase27JediLightsaberMysticCleanup":{"phas