{"_id":"d18f6de464dc42cf","name":"Commander's Prerogative","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Trained in the Initiative skill","description":{"value":"During the first round of combat after the surprise round, if any, you can take your turn before any of your allies, but you must use either the share talent prestige class ability or a talent from the Commando, Leadership, or Military Tactics talent trees as part of your turn. On the subsequent round, return to your normal place in initiative."},"benefit":"During the first round of combat after the surprise round, if any, you can take your turn before any of your allies, but you must use either the share talent prestige class ability or a talent from the Commando, Leadership, or Military Tactics talent trees as part of your turn. On the subsequent round, return to your normal place in initiative.","class":"","category":"","costNumeric":null,"treeId":"9253ace716c3e966","tags":["action_economy","ally_support","morale","positioning","skills","support","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual_or_future_runtime","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Vehicle/crew systems or GM/player managed","notes":"Initiative-order exception for first combat round; left as table/initiative runtime context, not a passive modifier.","phase23SocialCommanderCleanup":{"phase":"T23","tree":"Military Tactics","status":"reviewed_manual_or_future_runtime","cardsAdded":0,"notes":"Initiative-order exception for first combat round; left as table/initiative runtime context, not a passive modifier."}},"summary":"During the first round of combat after the surprise round, if any, you can take your turn before any of your allies, but you must use either the share talent prestige class ability or a talent from the Commando, Leadership, or Military Tactics talent trees as part of your turn.","source":"Unknown Regions","page":31},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":["defense.will","turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Vehicle/crew systems or GM/player managed","note":"Vehicle/crew/tactical effects need vehicle, commander, gunner, pilot, line-of-sight, or target context not available to static actor prep."}}}}
{"_id":"d1c2e9bdbb58b715","name":"Fleet Deployment","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Charisma 13","benefit":"As a full-round action, you can designate a number of vehicles equal to your class level and within your line of sight. Those vehicles may immediately move a number of squares equal to their speed.","description":{"value":"As a full-round action, you can designate a number of vehicles equal to your class level and within your line of sight. Those vehicles may immediately move a number of squares equal to their speed."},"class":"30b9cd24b80ebf46","costNumeric":null,"category":"Officer","treeId":"057a978a7dc1d5a7","tags":["action_economy","mobility","positioning","ranged","scaling"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Vehicle/crew systems or GM/player managed","notes":"Vehicle/crew/tactical effects need vehicle, commander, gunner, pilot, line-of-sight, or target context not available to static actor prep.","combatActions":[{"id":"fleet-deployment","name":"Fleet Deployment","label":"Fleet Deployment","actionType":"full-round","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Designate vehicles up to your Officer class level within line of sight. Those vehicles may immediately move a number of squares equal to their speed.","notes":"Designate vehicles up to your Officer class level within line of sight. Those vehicles may immediately move a number of squares equal to their speed.","relatedSkills":[],"resources":["Vehicle command"],"requiredContext":[],"targetHint":"Vehicles within line of sight","spendAction":true,"ruleData":{}}],"manualResolution":true,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Naval Officer","status":"combat_action_c