{"_id":"224906e573330bf2","name":"Starship Raider","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Spacehound","benefit":"You gain a +1 bonus on attack rolls made while aboard a Starship. This bonus applies to attacks made with Starship Weapons, as well as personal weapons used aboard a Starship.","description":{"value":"You gain a +1 bonus on attack rolls made while aboard a Starship. This bonus applies to attacks made with Starship Weapons, as well as personal weapons used aboard a Starship."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.fe0c3a64ca460542","name":"Spacehound"}],"_source":"canonical-csv"},"treeId":"5ea8c79492d40713","tags":["vehicle","space","precision"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"modifiers":[],"rules":[{"type":"ATTACK_OPTION","id":"starship-raider","label":"Starship Raider","control":"passive","requiresContextFlags":["aboardStarship"],"attackModifier":1,"summary":"Gain +1 on attack rolls made while aboard a starship. Requires the roll context to confirm aboardStarship."}],"phase16VehicleStarshipCleanup":{"status":"contextual_runtime_rule","owner":"CombatOptionResolver / attack pipeline","notes":"Curated vehicle/starship contextual rule; does not modify static actor totals."}},"summary":"You gain a +1 bonus on attack rolls made while aboard a Starship. This bonus applies to attacks made with Starship Weapons, as well as personal weapons used aboard a Starship.","source":"Saga Edition Core Rulebook","page":47},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.starship_raider"}}}
