{"_id":"5cd160036d6bba05","name":"Just What Is Needed","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You have a knack for finding the best quality replacement parts for broken Equipment. Whenever you use the Repair application of the Mechanics skill, you restore an extra 1d8 Hit Points with a successful Mechanics check, in addition to what you would normally restore.\n\nIf you use the Aid Another Action to assist an ally with Repairs, that ally also Repairs an extra 1d8 Hit Points with a successful Mechanics check. Any ally can only benefit from this Talent once per Mechanics check, regardless of how many allies with this Talent aid on the check.","description":{"value":"You have a knack for finding the best quality replacement parts for broken Equipment. Whenever you use the Repair application of the Mechanics skill, you restore an extra 1d8 Hit Points with a successful Mechanics check, in addition to what you would normally restore.\n\nIf you use the Aid Another Action to assist an ally with Repairs, that ally also Repairs an extra 1d8 Hit Points with a successful Mechanics check. Any ally can only benefit from this Talent once per Mechanics check, regardless of how many allies with this Talent aid on the check."},"class":"db019dfbb271cdf6","costNumeric":null,"category":"Improviser","treeId":"a0d6323d6c1bf911","tags":["control","equipment","jury_rig","mechanics","repair","skills","tech"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase17TechEngineeringCleanup":{"status":"cleaned_future_runtime_context","owner":"future_repair_resolver","notes":"Adds 1d8 repair healing on Repair/Aid Another contexts; removed unsafe repair Active Effect."}},"summary":"You have a knack for finding the best quality replacement parts for broken Equipment.","source":"Rebellion Era Campaign Guide","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.just_what_is_needed","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.413Z","detectedPredicates":["attack.when-hit"]}}}
