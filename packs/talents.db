uble your Strength bonus to the next melee damage roll you make before the end of your turn.","page":56},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"sourcePatch":"force-tradition-and-jedi-guardian-membership","forceTalentCleanup":{"phase":"T22","tree":"Believer Disciple","status":"combat_action_card"}}}}
