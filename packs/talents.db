{"_id":"89a8c710bb68901c","name":"Dark Healing Field","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Dark Healing, Improved Dark Healing","benefit":"You can spend a Force Point to heal wounds by drawing life energy from up to three targeted creatures within 12 squares of you. Once per encounter, make a Use the Force check. If the attack equals or exceeds a target's Fortitude Defense, the target takes 1d6 damage per class level. You heal half the total damage dealt (cumulative from all targets). If the attack fails, the targets take half damage and you heal that amount.","description":{"value":"You can spend a Force Point to heal wounds by drawing life energy from up to three targeted creatures within 12 squares of you. Once per encounter, make a Use the Force check. If the attack equals or exceeds a target's Fortitude Defense, the target takes 1d6 damage per class level. You heal half the total damage dealt (cumulative from all targets). If the attack fails, the targets take half damage and you heal that amount."},"class":"1ba03b2d00245906","costNumeric":null,"category":"Sith Apprentice","treeId":"d1037bc7a08ea80b","tags":["dark_side","force","force_offense","force_point_spend","force_support","healing","medicine","positioning","resource_spend","skills","support","use_the_force"],"executionModel":"ACTIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_encounter_action","applicationScope":"multi_target_force_point_healing","staticSheetPolicy":"exclude","manualResolution":false,"requiresRuntimeContext":true,"contributesGenericBonus":false,"modifiers":[],"notes":"Once per encounter, spend a Force Point to make Use the Force checks against up to three targets within 12 squares, dealing Sith-level d6 Force damage and healing half the total damage dealt.","combatActions":[{"id":"dark-healing-field","name":"Dark Healing Field","label":"Dark Healing Field","actionType":"standard","cost":1,"manualResolution":false,"resolutionMode":"sithTalent","useLabel":"Use","description":"You can spend a Force Point to heal wounds by drawing life energy from up to three targeted creatures within 12 squares of you. Once per encounter, you can make a Use the Force check. If the check result equals or exceeds a target's Fortitude Defense, the target takes 1d6 points of Force damage per every Sith Apprentice and Sith Lord Class Level you possess.\n\nYou heal half the total damage dealt (cumulative from all targets). If the attack fails, the target takes half damage, and you heal that amount.","notes":"Once per encounter, spend a Force Point to make Use the Force checks against up to three targets within 12 squares, dealing Sith-level d6 Force damage and healing half the total damage dealt.","relatedSkills":["useTheForce"],"resources":["Force Point","Use the Force","Fortitude Defense"],"requiredContext":[],"spendAction":true,"ruleData":{"sithTalentAction":"darkHealingField"}}],"rules":[],"sithTalentBackcheck":{"phase":"sith-dark-side-batch","status":"implemented_or_runtime_card","source":"user-pasted-rules-text","talismanUiDeferred":false}},"talent_tree":"Sith","tree":"Sith","summary":"You can spend a Force Point to heal wounds by drawing life energy from up to three targeted creatures within 12 squares of you.","source":"Knights of the Old Republic Campaign Guide","page":40},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.dark_healing_field","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.420Z","detectedPredicates":["turn.once-per-round"],"forcePrestigeCleanup":{"phase":"T9","status":"manual_or_runtime","scope":"runtime_force_power_action"},"sithTalentBackcheck":{"source":"user-pasted-rules-text","implemented":true,"uiDeferred":false,"action":"darkHealingField"}}}}
