{"_id":"4559e2e975f552fa","name":"Coordinated Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Commanding Officer","benefit":"Each of your Followers gains the Coordinated Attack Feat, provided he or she meets the prerequisite. If your Follower later meets the prerequisite for the Feat, they gain the Feat at that time.","description":{"value":"Each of your Followers gains the Coordinated Attack Feat, provided he or she meets the prerequisite. If your Follower later meets the prerequisite for the Feat, they gain the Feat at that time."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.bd34fd5bbc4a14fb","name":"Commanding Officer"}],"_source":"canonical-csv"},"treeId":"781feba15dc9e42f","tags":["followers","minion","ally_support","support","teamwork","tactics"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"staticSheetPolicy":"exclude","applicationScope":"social_commander_runtime_context","requiresRuntimeContext":true,"requiresSelectedChoice":false,"mechanicsMode":"manual_or_future_runtime","notes":"Follower feat-granting talent; belongs to follower subsystem.","phase23SocialCommanderCleanup":{"phase":"T23","tree":"Squad Leader","status":"reviewed_manual_or_future_runtime","cardsAdded":0,"notes":"Follower feat-granting talent; belongs to follower subsystem."}},"summary":"Each of your Followers gains the Coordinated Attack Feat, provided he or she meets the prerequisite. If your Follower later meets the prerequisite for the Feat, they gain the Feat at that time.","source":"Clone Wars Campaign Guide","page":26},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.coordinated_tactics","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.411Z","detectedPredicates":[]}}}
{"_id":"456a0aa44da5105c","name":"Disarming Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Improved Disarm, Intelligence 13, Weapon Specialization with the chosen weapon","benefit":"Choose a single exotic weapon or weapon group with which you are proficient. You ignore a target's armor bonus to Reflex Defense when disarming with such a weapon. Additionally, as a free action, once per encounter, you can grant yourself a +10 bonus on your attack roll when attempting to disarm an opponent while using such a weapon.","description":{"value":"Choose a single exotic weapon or weapon group with which you are proficient. You ignore a target's armor bonus to Reflex Defense when disarming with such a weapon. Additionally, as a free action, once per encounter, you can grant yourself a +10 bonus on your attack roll when attempting to disarm an opponent while using such a weapon."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"int","min":13},{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.869168cd679ee5d1","name":"Weapon Specialization"}],"_source":"canonical-csv"},"treeId":"2e9265a596cc43f7","tags":["armor"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"requiresSelectedChoice":true,"choiceMetaStatus":"phase14_persistent_choice_seeded"},"choiceMeta":{"resolution":"immediate","required":true,"status":"phase14_persistent_choice_seeded","choiceKind":"weapon_group_or_exotic","repeatable":true,"storagePath":"flags.swse.choices.disarming_attack_weapon","choiceSource":"prerequisiteDerived","optionRegistry":"data/feat-choice-options.json#choiceKinds.weapon_group_or_exotic","derivesFrom":["weapon_proficiency"],"consumes":"weapon_proficiency","provides":"weapon_group_or_exotic"},"summary":"Choose a single exotic weapon or weapon group with which you are proficient.","source":"Knights of the Old Republic Campaign Guide","page":29},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.disarming_attack","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.411Z","detectedPredicates":["defense.reflex","turn.once-per-round"]}}}
{"_id":"458647466717fcc2","name":"Numbing Poison","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Malkite Techniques","benefit":"Any target you poison is automatically denied its Dexterity bonus to its Reflex Defense for as long as it remains poisoned.","description":{"value":"Any target you poison is automatically denied its Dexterity bonus to its Reflex Defense for as long as it remains poisoned."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.744c2eaaa48e15af","name":"Malkite Techniques"}],"_source":"canonical-csv"},"treeId":"c55b003333ff082d","tags":["poison","medical","science"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"numbing-poison","name":"Numbing Poison","label":"Numbing Poison","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Any target you Poison is automatically denied its Dexterity bonus to its Reflex Defense, for a long as it remains Poisoned.","notes":"Targets you poison are denied Dexterity bonus to Reflex Defense while they remain poisoned. Apply this to the poisoned target state, not as a passive bonus on the talent owner.","relatedSkills":[{"skill":"Treat Injury"}],"resources":["Poisoned target","Dexterity bonus denied while poisoned"],"requiredContext":["Target is poisoned by you"],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[],"mechanicsMode":"combat_action_reference","applicationScope":"runtime_skill_crafting_medical_computer_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase29TechMedicalMicrotreeCleanup":{"phase":"T29","tree":"Malkite Poisoner","status":"reviewed_manual_or_runtime_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Tech/medical/science micr