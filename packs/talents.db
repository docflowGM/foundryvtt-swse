{"_id":"69da2f9701ef65b4","name":"Teräs Käsi Mastery","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Teräs Käsi Basics, Martial Arts I, Martial Arts II, Martial Arts III","benefit":"If you make only unarmed attacks during a full attack action, you can take the full attack action as a standard action instead of a full-round action.","description":{"value":"If you make only unarmed attacks during a full attack action, you can take the full attack action as a standard action instead of a full-round action."},"costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.67bddb17ae2770f3","name":"Teräs Käsi Basics"}],"_source":"canonical-csv"},"treeId":"ba726f623e42f849","tags":["action_economy","counterattack","martial_arts","melee_defense","offense_melee","standard_action","sustained_damage","unarmed","melee","natural_weapon"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"action_economy_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"phase20MartialArtsMasterCleanup":{"status":"combat_action_card_and_future_executor_rule","owner":"AbilityCombatActionResolver; future FullAttackExecutor","notes":"Adds a standard-action launcher/reference for unarmed-only Full Attack. Final automated execution should be delegated to the future FullAttackExecutor.","naturalWeaponPolicy":"Treat species natural weapons as unarmed-family attacks for this talent batch."},"combatActions":[{"id":"teras-kasi-mastery-full-attack","name":"Teras Kasi Mastery: Full Attack","label":"Teras Kasi Mastery: Full Attack","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Take a Full Attack as a Standard Action when every attack in that Full Attack is an unarmed or natural weapon attack. Use the Full Attack sequence manually until the full attack executor owns automated unarmed-only standard-action sequences.","notes":"Take a Full Attack as a Standard Action when every attack in that Full Attack is an unarmed or natural weapon attack. Use the Full Attack sequence manually until the full attack executor owns automated unarmed-only standard-action sequences.","relatedSkills":[{"skill":"Attack Roll","when":"Full Attack sequence"}],"resources":["Unarmed/natural weapon attacks only"],"requiredContext":["All attacks in the Full Attack must be unarmed or natural weapon attacks"],"targetHint":"Full Attack target(s)"}],"actionEconomyRules":[{"type":"FULL_ATTACK_AS_STANDARD","id":"teras-kasi-mastery-full-attack-as-standard","requiresUnarmedOnly":true,"includesNaturalWeapons":true,"description":"When making only unarmed or natural weapon attacks as a full attack, take that Full Attack as a Standard Action."}]},"summary":"A full attack made only with unarmed attacks can be taken as a standard action.","source":"Threats of the Galaxy","page":53},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.teras_kasi_mastery","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":[]}}}
{"_id":"6a52361527b64513","name":"Entangler","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"When grabbing a target, you take a -2 penalty to your attack roll (instead of the normal -5 penalty). Until the target breaks the grab, it takes a -5 penalty to attack rolls, including those made with natural and light weapons (instead of the normal -2 penalty)."},"benefit":"When grabbing a target, you take a -2 penalty to your attack roll (instead of the normal -5 penalty). Until the target breaks the grab, it takes a -5 penalty to attack rolls, including those made with natural and light weapons (instead of the normal -2 penalty).","class":"","category":"","costNumeric":null,"treeId":"67fdd8dce9abd6c1","tags":["control","entangle","positioning","restrain","grab","grapple","natural_weapon"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"grappleRules":[{"type":"GRAB_ATTACK_PENALTY_OVERRIDE","penalty":-2,"normalPenalty":-5,"source":"Entangler"}],"combatActions":[{"id":"entangler-grab","name":"Entangler: Grab","label":"Entangler: Grab","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Use the Grab action with a -2 attack penalty instead of the normal -5. Until the target breaks the Grab, it takes a -5 penalty to attack rolls, including natural and light weapons.","notes":"Use the Grab action with a -2 attack penalty instead of the normal -5. Until the target breaks the Grab, it takes a -5 penalty to attack rolls, including natural and light weapons.","relatedSkills":[{"skill":"Attack Roll","when":"Grab action"},{"skill":"Grapple","when":"Maintain/resolve the grab"}],"resources":["Grab penalty becomes -2"]}],"mechanicsMode":"runtime_context","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"phase21BrawlerShockboxerCleanup":{"status":"runtime_grapple_hook","owner":"CombatOptionResolver / ReactionEngine / GrapplingSystem","notes":"GrapplingSystem reads this talent by name for Grab attack penalty reduction; the target attack penalty remains a manual state/rider.","naturalWeaponPolicy":"Treat species natural weapons as unarmed-family attacks when the source text affects unarmed attacks."}},"summary":"Reduce your grab attack penalty to -2 and increase the grabbed target's attack penalty to -5.","source":"Galaxy of Intrigue","page":23},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":[]}}}
{"_id":"6a66ba6e0834dd6f","name":"Born Leader","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per encounter, as a Swift Action, you grant all allies within your line of sight a +1 insight bonus on attack rolls. This effect lasts for as long as they remain within line of sight of you. An ally loses this bonus immediately if line of sight is broken or you are unconscious or dead.","description":{"value":"Once per encounter, as a Swift Action, you grant all allies within your line of sight a +1 insight bonus on attack rolls. This effect lasts for as long as they remain within line of sight of you. An ally loses this bonus immediately if line of sight is broken or you are unconscious or dead."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","treeId":"5964237d22681dc0","tags":["armor","support","sustained_damage"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"born-leader","name":"Born Leader","label":"Born Leader","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, grant allies within line of sight a +1 insight bonus on attack rolls while they remain within line of sight and you remain conscious/alive.","notes":"Once per encounter, grant allies within line of sight a +1 insight bonus on attack rolls while they remain within line of sight and you remain conscious/alive.","relatedSkills":[],"resources":["Once per encounter","Insight bonus"],"requiredContext":[],"