{"_id":"ef3ec55015c60bda","name":"Channel Aggression","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"If you succeed on an attack against a Flanked opponent, or any target that is denied its Dexterity bonus to Reflex Defense, you may spend a Force Point as a Free Action to deal additional damage to the target equal to 1d6 per Class Level (maximum 10d6).","description":{"value":"If you succeed on an attack against a Flanked opponent, or any target that is denied its Dexterity bonus to Reflex Defense, you may spend a Force Point as a Free Action to deal additional damage to the target equal to 1d6 per Class Level (maximum 10d6)."},"class":"289fcf920ef0e184","costNumeric":null,"category":"Dark Side Devotee","treeId":"96ef43a3054dcb58","tags":["action_economy","condition_removal","damage_reduction","dark_side","force","force_capacity","force_control","force_offense","force_point_spend","force_support","force_training","light_side","mechanics","medicine","melee","mobility","precision","resource_spend","skills","stealth","support","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"runtime_damage_rider","staticSheetPolicy":"exclude","manualResolution":false,"modifiers":[],"notes":"Free Action Force Point extra damage after hitting flanked/dex-denied target; target state is punted.","combatActions":[{"id":"channel-aggression","name":"Channel Aggression","label":"Channel Aggression","actionType":"free","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"If you succeed on an attack against a Flanked opponent, or any target that is denied its Dexterity bonus to Reflex Defense, you may spend a Force Point as a Free Action to deal additional damage to the target equal to 1d6 per Class Level (maximum 10d6).","notes":"If you succeed on an attack against a Flanked opponent, or any target that is denied its Dexterity bonus to Reflex Defense, you may spend a Force Point as a Free Action to deal additional damage to the target equal to 1d6 per Class Level (maximum 10d6).","relatedSkills":[{"skill":"Attack Roll"}],"resources":["Force Point context"],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{}}],"rules":[],"requiresRuntimeContext":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Dark Side Devotee","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":0,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."},"source":"talent-backcheck","combatActionId":"channel-aggression","sithTalentAction":"channelAggression"},"talent_tree":"Dark Side Devotee","tree":"Dark Side Devotee","implementationStatus":"implemented","automationBoundary":"supported","summary":"If you succeed on an attack against a Flanked opponent, or any target that is denied its Dexterity bonus to Reflex Defense, you may spend a Force Point as a Free Action to deal additional damage to the target equal to 1d6 per Class...","source":"Saga Edition Core Rulebook","page":213},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.channel_aggression","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.432Z","detectedPredicates":["attack.when-hit","attack.with-melee","movement.while-moving"],"forcePrestigeCleanup":{"phase":"T9","status":"manual_or_runtime","scope":"runtime_damage_rider"}}}}
