{"_id":"b66c142c79341858","name":"Veiled Biotech","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Trained in Stealth","benefit":"You gain a +10 competence bonus on Deception and Stealth checks made to conceal any biotechnology or any biotech implants you possess. Additionally, you may draw a concealed biotech item or weapon as a swift action instead of a standard action; if you then make an attack with that biotech weapon before the end of your turn, your opponent loses its Dexterity bonus to Reflex Defense against the first attack you make with that weapon.","description":{"value":"You gain a +10 competence bonus on Deception and Stealth checks made to conceal any biotechnology or any biotech implants you possess. Additionally, you may draw a concealed biotech item or weapon as a swift action instead of a standard action; if you then make an attack with that biotech weapon before the end of your turn, your opponent loses its Dexterity bonus to Reflex Defense against the first attack you make with that weapon."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"6d2ac22d9fcf402f"}],"_source":"canonical-csv"},"treeId":"33c3210fcac8c664","tags":["action_economy","mobility","skills","social","stealth"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"veiled-biotech-draw","name":"Veiled Biotech: Draw Concealed Biotech","label":"Veiled Biotech: Draw Concealed Biotech","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Draw a concealed Biotech item or weapon as a Swift Action; if you attack with that Biotech weapon before the end of your turn, the first attack denies the opponent its Dexterity bonus to Reflex Defense.","notes":"Track the concealment bonus and the first-attack denied-Dex rider manually.","relatedSkills":[{"skill":"Deception"},{"skill":"Stealth"},{"skill":"Attack Roll"}],"resources":["Concealed Biotech item/weapon","First attack before end of turn"],"targetHint":"One opponent attacked with the drawn Biotech weapon"}],"phase18MedicalBiotechCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual action-economy card; no passive bonus is applied automatically."}},"summary":"You gain a +10 competence bonus on Deception and Stealth checks made to conceal any biotechnology or any biotech implants you possess.","source":"Legacy Era Campaign Guide","page":30},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.veiled_biotech","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.425Z","detectedPredicates":[]}}}
{"_id":"b6e600188cf5597f","name":"Bayonet Master","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Gun Club","benefit":"When you take a full attack action, you can treat a ranged weapon with a bayonet as a double melee weapon. You can attack with the bayonet and club a target with your ranged weapon (as with the Gun Club talent), ignoring the normal penalties for attacking with both ends of a double weapon.","description":{"value":"When you take a full attack action, you can treat a ranged weapon with a bayonet as a double melee weapon. You can attack with the bayonet and club a target with your ranged weapon (as with the Gun Club talent), ignoring the normal penalties for attacking with both ends of a double weapon."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.bff3997bbdecc98a","name":"Gun Club"}],"_source":"canonical-csv"},"treeId":"67fdd8dce9abd6c1","tags":["positioning","ranged","full_attack","double_weapon"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"bayonet-master-full-attack","name":"Bayonet Master: Full Attack","label":"Bayonet Master: Full Attack","actionType":"full-round","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"When taking a Full Attack Action with a ranged weapon fitted with a bayonet or vibrobayonet, treat it as a double weapon and ignore the normal penalties for attacking with both ends. Use this card until the FullAttackExecutor has a bayonet-as-double-weapon package.","notes":"When taking a Full Attack Action with a ranged weapon fitted with a bayonet or vibrobayonet, treat it as a double weapon and ignore the normal penalties for attacking with both ends. Use this card until the FullAttackExecutor has a bayonet-as-double-weapon package.","relatedSkills":[{"skill":"Attack Roll","when":"Bayonet and weapon-as-club attacks"}],"resources":["Requires ranged weapon with bayonet/vibrobayonet","Requires Gun Club"]}],"mechanicsMode":"combat_action","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"phase21BrawlerShockboxerCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Bayonet-as-double-weapon requires a specialized FullAttackExecutor package; safe card for now, no passive modifier.","naturalWeaponPolicy":"Treat species natural weapons as unarmed-family attacks when the source text affects unarmed attacks."}},"summary":"When you take a full attack action, you can treat a ranged weapon with a bayonet as a double melee weapon.","source":"Clone Wars Campaign Guide","page":26},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.bayonet_master","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.425Z","detectedPredicates":["attack.with-ranged"]}}}
{"_id":"b6e75c52f5d66ade","name":"Wild Sense","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Charm Beast","benefit":"As a swift action once per turn, you can make a Use the Force check to touch the mind of a beast with an indifferent or better attitude toward you, provided it is within 12 squares of you and in your line of sight. When you do so, the beast makes an immediate active Perception check, and you are considered to perceive everything that the beast does, including noticing targets, as though you had made the check. Additionally, until the end of your turn, you are considered to have line of sight to anything the beast has line of sight to.","description":{"value":"As a swift action once per turn, you can make a Use the Force check to touch the mind of a beast with an indifferent or better attitude toward you, provided it is within 12 squares of you and in your line of sight. When you do so, the beast makes an immediate active Perception check, and you are considered to perceive everything that the beast does, including noticing targets, as though you had made the check. Additionally, until the end of your turn, you are considered to have line of sight to anything the beast has line of sight to."},"class":"289fcf920ef0e184","costNumeric":null,"category":"Force Adept","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.bab9a1ce285f98b9","name":"Charm Beast"}],"_source":"canonical-csv"},"treeId":"ed899f9f41fc1391","tags":["action_economy","beast","beast_companion","exploration","force","force_capacity","force_training","nature","perception","positioning","skills","support","survival","swift_action","use_the_force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"survival_exploration_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Swift beast-sense card; no attack modifier applies.","phase25SurvivalExplorationCleanup":{"phase":"T25","tree":"Beastwarden","status":"combat_action_card","notes":"Swift beast-sense card; no attack modifier applies."},"combatActions":[{"id":"wild-sense","name":"Wild Sense","label":"Wild Sense","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Swift Action once per turn, you can make a Use the Force check to touch the mind of a Beast with an Indifferent or better Attitude toward you, provided it is within 12 squares of you and in your line of sight. When you do so, the Beast makes an immediate active Perception check, and you are considered to perceive everything the Beast does, including noticing targets, as though you had made the check.","notes":"As a Swift Action once per turn, you can make a Use the Force check to touch the mind of a Beast with an Indifferent or better Attitude toward you, provided it is within 12 squares of you and in your line of sight. When you do so, the Beast makes an immediate active Perception check, and you are considered to perceive everything the Beast does, including noticing targets, as though you had made the check.","relatedSkills":[{"skill":"useTheForce","when":"touch beast mind"},{"skill":"perception","when":"beast makes active Perception check"}],"resources":["Once per turn","Beast within 12 squares","Line of sight"],"requiredContext":["Beast has Indifferent or better attitude","Beast is within 12 squares and line of sight"],"targetHint":"Friendly/Indifferent beast","spendAction":true,"ruleData":{}}],"source":"talent-backcheck","combatActionId":"wild-sense","sithTalentAction":"wildSense","manualResolution":false},"talent_tree":"Beastwarden","tree":"Beastwarden","implementationStatus":"implemented","automationBoundary":"supported","summary":"As a swift action once per turn, you can make a Use the Force check to touch the mind of a beast with an indifferent or better attitude toward you, provided it is within 12 squares of you and in your line of sight.","source":"Jedi Academy Training Manual","page":18},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.wild_sense","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.425Z","detectedPredicates":[]}}}
{"_id":"b788095a71a47be7","name":"Riposte","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Block, base attack bonus +5","benefit":"As a reaction once per encounter, make a lightsaber attack against a being whose attack you negate using the Block lightsaber combat talent (page 41 of the Saga Edition core rulebook). Only non-area melee attacks can be riposted in this manner; you cannot use this talent when negating the damage from melee area attacks (such as those made with the Whirlwind Attack feat).","description":{"value":"As a reaction once per encounter, make a lightsaber attack against a being whose attack you negate using the Block lightsaber combat talent (page 41 of the Saga Edition core rulebook). Only non-area melee attacks can be riposted in this manner; you cannot use this talent when negating the damage from melee area attacks (such as those made with the Whirlwind Attack feat)."},"class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.9379daa94a228c04","name":"Block"},{"type":"bab","min":5}],"_source":"canonical-csv"},"treeId":"2359c05ff13f3feb","tags":["force","force_offense"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[{"target":"attack","value":0,"type":"untyped","predicates":[],"enabled":false,"priority":500,"description":"[REQUIRES MANUAL MAPPING] Riposte"}],"mechanicsMode":"triggered_once_per_encounter_attack","applicationScope":"block_success_runtime","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true},"talent_tree":"Lightsaber Combat","talentTree":"Lightsaber Combat","tree":"Lightsaber Combat","summary":"As a reaction once per encounter, make a lightsaber attack against a being whose attack you negate using the Block lightsaber combat talent (page 41 of the Saga Edition core rulebook).","source":"Knights of the Old Republic Campaign Guide","page":25},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.riposte","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.425Z","detectedPredicates":[],"lightsaberTalentImplementation":{"status":"runtime_action_or_contextual","updated":"2026-06-11"}}}}
