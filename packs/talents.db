{"_id":"6315a1a7aaf758d5","name":"Hidden Attacker","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Trained in Stealth","benefit":"Your shots seem to come from nowhere. Whenever you use the snipe application of the Stealth skill, you do so as a swift action instead of a move action.","description":{"value":"Your shots seem to come from nowhere. Whenever you use the snipe application of the Stealth skill, you do so as a swift action instead of a move action."},"class":"b5bed5d1b5f42958","costNumeric":null,"category":"Scout","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"6d2ac22d9fcf402f"}],"_source":"fix5F-canonical"},"treeId":"089933380b40ce20","tags":["action_economy","mobility","skills","stealth","survival","exploration","vehicle","pilot","space"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"survival_exploration_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Snipe action economy improvement; no Stealth modifier.","phase25SurvivalExplorationCleanup":{"phase":"T25","tree":"Hyperspace Explorer","status":"action_economy_reference","notes":"Snipe action economy improvement; no Stealth modifier."},"combatActions":[{"id":"hidden-attacker-snipe","name":"Hidden Attacker: Snipe as Swift","label":"Hidden Attacker: Snipe as Swift","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Your shots seem to come from nowhere. Whenever you use the Snipe application of the Stealth skill, you do so as a Swift Action instead of a Move Action.","notes":"Your shots seem to come from nowhere. Whenever you use the Snipe application of the Stealth skill, you do so as a Swift Action instead of a Move Action.","relatedSkills":[{"skill":"stealth","when