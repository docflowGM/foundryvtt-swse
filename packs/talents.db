{"_id":"5218d5971b78119b","name":"Empower Weapon","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You may spend a Force Point to empower a melee weapon. Empowering the weapon takes a Full-Round Action. From that point forward, the Empowered Weapon deals an additional die of damage, but only when wielded by you.\n\nFor example, an empowered Lightsaber deals 3d8 points of damage, instead of 2d8 points of damage. Others who wield the weapon do not gain the bonus damage die.","description":{"value":"You may spend a Force Point to empower a melee weapon. Empowering the weapon takes a Full-Round Action. From that point forward, the Empowered Weapon deals an additional die of damage, but only when wielded by you.\n\nFor example, an empowered Lightsaber deals 3d8 points of damage, instead of 2d8 points of damage. Others who wield the weapon do not gain the bonus damage die."},"class":"289fcf920ef0e184","costNumeric":null,"category":"Force Adept","treeId":"01e443d93e47f9c4","tags":["action_economy","alchemy","crafting","empowerment","force","force_capacity","force_control","force_offense","force_point_spend","force_training","lightsaber","melee","mobility","offense_melee","positioning","ranged","resource_spend","support","sustained_damage"],"executionModel":"ACTIVE","subType":"TALENT_ACTION","abilityMeta":{"modifiers":[],"combatActions":[{"id":"empower-weapon","name":"Empower Weapon","actionType":"full-round","requiredTalent":"Empower Weapon","description":"You may spend a Force Point to empower a melee weapon. Empowering the weapon takes a Full-Round Action. From that point forward, the Empowered Weapon deals an additional die of damage, but only when wielded by you.","resolutionMode":"forceAdeptTalent","spendAction":true,"effects":[],"resources":["Force Point","Melee Weapon"],"notes":"Spend a Force Point as a Full-Round Action to empower a melee weapon; damage roller reads the stored extra damage die for that actor/weapon.","manualResolution":false,"relatedSkills":["useTheForce"],"forceAdeptTalentAction":"empowerWeapon","label":"Empower Weapon","useLabel":"Use"}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Force Item","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."},"actionType":"full-round","resolutionMode":"forceAdeptTalent","forceAdeptTalentAction":"empowerWeapon","implementationDeferred":false},"summary":"You may spend a Force Point to empower a melee weapon. Empowering the weapon takes a Full-Round Action.","source":"Saga Edition Core Rulebook","page":214},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.empower_weapon","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.412Z","detectedPredicates":["attack.when-hit","proximity.ally-nearby"],"forceTalentCleanup":{"phase":"T22","tree":"Force Item","status":"combat_action_card"},"backchecked":true,"lastBackcheck":"force-adept-force-item-batch"}}}
{"_id":"5242623648114830","name":"Critical Skill Success","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"Whenever you roll a natural 20 on a skill check, choose one other skill. Once before the end of your next turn, you can choose to gain a +5 competence bonus to a check with that skill as a free action."},"benefit":"Whenever you roll a natural 20 on a skill check, choose one other skill. Once before the end of your next turn, you can choose to gain a +5 competence bonus to a check with that skill as a free action.","class":"","category":"","costNumeric":null,"treeId":"04a6f32128cc4b98","talent_tree":"Superior Skills","source":"Galaxy of Intrigue","page":21,"tags":["critical_hit","critical_success","force","precision","scaling","skill-mastery","skill_mastery","skills","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed","notes":"The talent requires target, ally, line-of-sight, action timing, encounter state, or GM judgment and should not alter permanent actor values.","combatActions":[{"id":"critical-skill-success-t31-reference","name":"Critical Skill Success","label":"Critical Skill Success","actionType":"free","cost":0,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Whenever you roll a Natural 20 on a Skill Check, choose one other Skill. Once before the end of your next turn, you can choose to gain a +5 competence bonus to a check with that Skill as a Free Action.","notes":"Whenever you roll a Natural 20 on a Skill Check, choose one other Skill. Once before the end of your next turn, you can choose to gain a +5 competence bonus to a check with that Skill as a Free Action.","relatedSkills":[],"resources":[],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"critical-skill-success-t31-context","label":"Critical Skill Success","summary":"Whenever you roll a Natural 20 on a Skill Check, choose one other Skill. Once before the end of your next turn, you can choose to gain a +5 competence bonus to a check with that Skill as a Free Action."}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Superior Skills","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."}},"repeatable":false,"summary":"After a natural 20 on a skill check, gain a one-use +5 competence bonus to another skill before the end of your next turn."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.412Z","detectedPredicates":["attack.when-hit"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"GM/player managed","note":"The talent requires target, ally, line-of-sight, action timing, encounter state, or GM judgment and should not alter permanent actor values."}}}}
{"_id":"52a4914cca90cc4d","name":"Guaranteed Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Dual Weapon Mastery I","benefit":"If you are wielding two pistols and make a single ranged attack with one of those pistols as a standard action, even if you miss you deal damage equal to half your heroic level to the target. This consumes a single shot from the weapon not making the attack, and the weapon you attack with uses as many shots as required by the attack.","description":{"value":"If you are wielding two pistols and make a single ranged attack with one of those pistols as a standard action, even if you miss you deal damage equal to half your heroic level to the target. This consumes a single shot from the weapon not making the attack, and the weapon you attack with uses as many shots as required by the attack."},"class":"162d866ba36fce69","costNumeric":null,"category":"Gunslinger","treeId":"ed77ab2e234089ed","tags":["ranged"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Future CombatOptionResolver / action-card / reaction prompt / damage-resolution hook","notes":"Reviewed in T12. Removed legacy static/passive modifier data; this talent is a real combat mechanic but needs runtime context and should not mutate permanent sheet totals.","combatActions":[{"id":"guaranteed-shot","name":"Guaranteed Shot","label":"Guaranteed Shot","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"When wielding two pistols and making a single ranged attack with one pistol as a Standard Action, deal half Heroic Level damage on a miss and consume one shot from the other pistol.","notes":"When wielding two pistols and making a single ranged attack with one pistol as a Standard Action, deal half Heroic Level damage on a miss and consume one shot from the other pistol.","relatedSkills":[],"resources":["Standard Action","Wielding two pistols","Miss damage = half Heroic Level"],"requiredContext":[],"targetHint":""}],"manualResolution":true,"phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Pistoleer","status":"reviewed","notes":"Reviewed in tactical ranged/military cleanup."}},"summary":"If you are wielding two pistols and make a single ranged attack with one of those pistols as a standard action, even if you miss you deal damage equal to half your heroic level to the target.","source":"Scum and Villainy","page":28},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.guaranteed_shot","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.412Z","detectedPredicates":[]}}}
{"_id":"52f51a77fd60f56f","name":"Debilitating Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"If you aim before making a ranged attack and the attack hits, move the target -1 step along the condition track in addition to dealing damage.","description":{"value":"If you aim before making a ranged attack and the attack hits, move the target -1 step along the condition track in addition to dealing damage."},"class":"162d866ba36fce69","costNumeric":null,"category":"Gunslinger","treeId":"cb6f775cd227a3e3","tags":["action_economy","condition_removal","damage_reduction","force","force_control","force_defense","force_offense","mobility","positioning","precision","ranged","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Future CombatOptionResolver / action-card / reaction prompt / damage-resolution hook","notes":"Reviewed in T12. Removed legacy static/passive modifier data; this talent is a real combat mechanic but needs runtime context and should not mutate permanent sheet totals."},"summary":"After aiming, a successful ranged hit also moves the target -1 condition step.","source":"Saga Edition Core Rulebook","page":216},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.debilitating_shot","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.412Z","detectedPredicates":["defense.against-ranged","defense.reflex","attack.when-hit","attack.with-ranged","turn.once-per-round"]}}}
{"_id":"5319a796f2c4ff64","name":"Fool's Luck","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a standard action, you can spend a Force Point to gain one of the following benefits for the rest of the encounter: a +1 luck bonus on attack rolls, a +5 luck bonus on skill checks, or a +1 luck bonus to all your defenses.","description":{"value":"As a standard action, you can spend a Force Point to gain one of the following benefits for the rest of the encounter: a +1 luck bonus on attack rolls, a +5 luck bonus on skill checks, or a +1 luck bonus to all your defenses."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","treeId":"cee9b9398682b7d0","tags":["action_economy","precision"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"Spend a Force Point for an encounter-long luck bonus to attacks, skills, or defenses.","source":"Saga Edition Core Rulebook","page":46},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.fools_luck","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.412Z","detectedPredicates":["attack.when-hit","turn.once-per-round"]}}}
{"_id":"533867af3de50833","name":"Damaging Deception","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Cunning Distraction","benefit":"As a standard action, you can make a Deception check against the Will Defense of any target within your line of sight that can see, hear, and understand you. If successful, the next attack made by one of your allies against that target deals 2 additional dice of damage.","description":{"value":"As a standard action, you can make a Deception check against the Will Defense of any target within your line of sight that can see, hear, and understand you. If successful, the next attack made by one of your allies against that target deals 2 additional dice of damage."},"class":"8da58194b3d58041","costNumeric":null,"category":"Charlatan","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.3340f268613c0349","name":"Cunning Distraction"}],"_source":"canonical-csv"},"treeId":"ab9b75bc19f8e983","tags":["control","deception","skills","social","standard_action","stealth","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"combat_action_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"AbilityCombatActionResolver + character sheet combat actions tab; final resolution remains manual until the relevant target/minion/action-sequence executor exists.","notes":"Reviewed in phase T15. This talent depends on target identity, ally/minion state, line of sight, positioning, encounter timing, or GM adjudication. It should not mutate permanent actor sheet totals.","combatActions":[{"id":"damaging-deception","name":"Damaging Deception","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","relatedSkills":[{"skill":"Deception","when":"Against target Will Defense"}],"res