{"_id":"3f8f5305eabc525e","name":"Walk the Line","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Disruptive.","benefit":"As a Standard Action, you can do or say something that catches your enemies off guard. All opponents within 6 squares of you, and within your line of sight take a -2 penalty to their Defenses until the start of your next turn. The penalty is negated if line of sight is broken.","description":{"value":"As a Standard Action, you can do or say something that catches your enemies off guard. All opponents within 6 squares of you, and within your line of sight take a -2 penalty to their Defenses until the start of your next turn. The penalty is negated if line of sight is broken."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.91b335f8565b90ef","name":"Disruptive"}],"_source":"canonical-csv"},"treeId":"67b59e020c1660eb","tags":["control","battlefield_control","positioning","standard_action","action_economy","setup"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"As a Standard Action, you can do or say something that catches your enemies off guard.","source":"Saga Edition Core Rulebook","page":46},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.walk_the_line","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.409Z","detectedPredicates":[]}}}
