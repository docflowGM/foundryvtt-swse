{"_id":"51a8e7a193955f11","name":"Power of Hatred","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Incite Rage","benefit":"Once per encounter as a swift action, you can inflame the passions of your allies. Each ally within your line of sight who has fewer than half its normal hit points gains bonus hit points equal to your character level. Damage is subtracted from the bonus hit points first, and any bonus hit points remaining at the end of the encounter go away. Bonus hit points from different sources do not stack.","description":{"value":"Once per encounter as a swift action, you can inflame the passions of your allies. Each ally within your line of sight who has fewer than half its normal hit points gains bonus hit points equal to your character level. Damage is subtracted from the bonus hit points first, and any bonus hit points remaining at the end of the encounter go away. Bonus hit points from different sources do not stack."},"class":"1ba03b2d00245906","costNumeric":null,"category":"Sith Apprentice","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.b8a9dd4c950a96f5","name":"Incite Rage"}],"_source":"canonical-csv"},"treeId":"4d5ac20318ef56b6","tags":["action_economy","dark_side","force","swift_action"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","manualResolution":false,"modifiers":[],"notes":"Once-per-encounter swift action grants nearby/visible low-HP allies temporary HP.","requiresRuntimeContext":true,"requiresSelectedChoice":false,"combatActions":[{"name":"Power of Hatred","actionType":"swift","requiredTalent":"Power of Hatred","description":"Once per encounter as a Swift Action, you can inflame the passions of your allies. Each ally within your line of sight who has fewer than half its normal Hit Points gains bonus Hit Points equal to your Character Level. Damage is subtracted from the bonus Hit Points first, and any bonus Hit Points remaining at the end of the encounter go away. Bonus Hit Points from multiple sources do not stack.","resolutionMode":"sithTalent","spendAction":true,"effects":[],"resources":["Once per encounter","Temporary HP","Below half HP"],"notes":"Targets selected eligible allies and grants temporary HP equal to your character level when below half normal HP. Bonus HP do not stack.","manualResolution":false,"relatedSkills":[],"sithTalentAction":"powerOfHatred","id":"power-of-hatred","label":"Power of Hatred"}],"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Sith Commander","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."},"contributesGenericBonus":false},"summary":"Once per encounter as a swift action, you can inflame the passions of your allies.","source":"Legacy Era Campaign Guide","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.power_of_hatred","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.412Z","detectedPredicates":["attack.when-hit","turn.once-per-round"],"forcePrestigeCleanup":{"phase":"T9","status":"manual_or_runtime","scope":"runtime_ally_buff"}}}}
{"_id":"51ee1b777709cc4e","name":"Security Slicer","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Trained in the Mechanics skill","benefit":"You are an expert in electronic security. When you make a Mechanics check to disable a security system, you can do so without the help of a security kit. Additionally, something goes wrong only when you fail the Mechanics check by 10 or more.","description":{"value":"You are an expert in electronic security. When you make a Mechanics check to disable a security system, you can do so without the help of a security kit. Additionally, something goes wrong only when you fail the Mechanics check by 10 or more."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"745a5686d6f21e8c"}],"_source":"fix5F-canonical"},"treeId":"64874e65579e4cf4","tags":["tech","use_computer"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"security-slicer","name":"Security Slicer","label":"Security Slicer","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"You are an expert in electronic security. When you make a Mechanics check to Disable Device, you can do so without the help of a Security Kit. Additionally, something goes wrong only when you fail the Mechanics check by 10 or more.","notes":"Disable Device reference. You can disable electronic security without a Security Kit; something goes wrong only on failure by 10 or more.","relatedSkills":[{"skill":"Mechanics"}],"resources":["Disable Device","No Security Kit required","Mishap only fail by 10+"],"requiredContext":["Electronic security / device disable attempt"],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[],"mechanicsMode":"combat_action_reference","applicationScope":"runtime_skill_crafting_medical_computer_context","staticSheetPolicy":