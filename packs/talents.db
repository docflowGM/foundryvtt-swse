{"_id":"d4fe49ef1701891e","name":"Dark Side Master","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Dark Side Adept.","benefit":"As Dark Side Adept (see above), except that you can spend a Force Point and keep the better of the two Use the Force checks,","description":{"value":"As Dark Side Adept (see above), except that you can spend a Force Point and keep the better of the two Use the Force checks,"},"class":"1ba03b2d00245906","costNumeric":null,"category":"Sith Apprentice","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.cfdd73f3d939799d","name":"Dark Side Adept"}],"_source":"canonical-csv"},"treeId":"d1037bc7a08ea80b","tags":["dark_side","force","force_point_spend","resource_spend","use_the_force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_force_power_reroll_force_point_upgrade","applicationScope":"dark_side_force_power_activation","staticSheetPolicy":"exclude","manualResolution":false,"requiresRuntimeContext":true,"contributesGenericBonus":false,"modifiers":[],"notes":"Reroll Use the Force checks to activate [Dark Side] Force Powers and may spend a Force Point to keep the better result.","combatActions":[{"id":"dark-side-master","name":"Dark Side Master","label":"Dark Side Master","actionType":"passive","cost":0,"manualResolution":false,"resolutionMode":"sithTalent","useLabel":"Use","description":"Force Powers that are strongly tied to the Dark Side flow through you more easily. You can reroll any Use the Force check made when activating Force Powers with the [Dark Side] descriptor, and can spend a Force Point to keep the better of the two results.","notes":"Reroll Use the Force checks to activate [Dark Side] Force Powers and may spend a Force Point to keep the better result.","relatedSkills":["useTheForce"],"resources":["[Dark Side] Force Power","Force Point optional"],"requiredContext":[],"spendAction":false,"ruleData":{"s