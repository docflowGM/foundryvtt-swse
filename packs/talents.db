{"_id":"42f9f503f5e26de7","name":"Focused Warrior","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Your training makes you confident and disciplined in combat. When you successfully deal damage to an opponent in combat, you gain a +5 morale bonus to Will Defense until the start of your next turn. You lose this bonus to Will Defense if you are surprised or flat-footed for any reason.","description":{"value":"Your training makes you confident and disciplined in combat. When you successfully deal damage to an opponent in combat, you gain a +5 morale bonus to Will Defense until the start of your next turn. You lose this bonus to Will Defense if you are surprised or flat-footed for any reason."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","treeId":"4007fa87192b5884","tags":["ambush"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"modifiers":[]},"summary":"Your training makes you confident and disciplined in combat.","source":"Force Unleashed Campaign Guide","page":29},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.focused_warrior"}}}
{"_id":"430b73348460715e","name":"Cantina Brawler","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"While flanked, you gain a +2 bonus to your attack rolls and damage rolls.","description":{"value":"While flanked, you gain a +2 bonus to your attack rolls and damage rolls."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","treeId":"67fdd8dce9abd6c1","tags":["action_economy","ambush","melee","positioning","support","sustained_damage","unarmed","natural_weapon","flanking"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"rules":[{"type":"ATTACK_OPTION","id":"cantinaBrawlerFlanked","label":"Cantina Brawler (while flanked)","control":"toggle","requiresUnarmed":true,"attackModifier":2,"damageModifier":2,"summary":"Toggle only while you are flanked. Applies to Unarmed Strike and species natural weapons."}],"mechanicsMode":"runtime_context","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"phase21BrawlerShockboxerCleanup":{"status":"runtime_attack_option","owner":"CombatOptionResolver / ReactionEngine / GrapplingSystem","notes":"+2 attack and damage is contextual while flanked, so it is an opt-in attack option on unarmed-family rolls instead of a passive sheet bonus.","naturalWeaponPolicy":"Treat species natural weapons as unarmed-family attacks when the source text affects unarmed attacks."}},"summary":"While flanked, you gain a +2 bonus to your attack rolls and damage rolls.","source":"Scum and Villainy","page":17},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.cantina_brawler","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.409Z","detectedPredicates":["defense.reflex","attack.with-melee","proximity.ally-nearby"]}}}
