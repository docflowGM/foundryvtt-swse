{"_id":"a6ad65c1275faa33","name":"Force Treatment","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can make a Use the Force check in the place of a Treat Injury check. You are considered trained in the Treat Injury skill. If you are entitled to a Treat Injury check reroll, you can reroll your Use the Force check instead (subject to the same circumstances and limitations).","description":{"value":"You can make a Use the Force check in the place of a Treat Injury check. You are considered trained in the Treat Injury skill. If you are entitled to a Treat Injury check reroll, you can reroll your Use the Force check instead (subject to the same circumstances and limitations)."},"class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"a2a7a376e4905da9","tags":["force","light_side","skills"],"executionModel":"ACTIVE","subType":"TALENT_ACTION","abilityMeta":{"mechanicsMode":"conditional_or_metadata","applicationScope":"skill_substitution_treat_injury","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"engineOwner":"TalentActionLinker / skill-use action","conditionSummary":"Use Use the Force in place of Treat Injury; rerolls transfer to the UtF check.","recommendedAction":"Do not mark Treat Injury trained globally; use the linked Use the Force substitution action.","modifiers":[],"status":"talent_backcheck_user_text_2026_06_11","description":"Use Use the Force in place of Treat Injury; rerolls transfer to the UtF check.","requiresSelectedChoice":false,"metadataPhase":"jedi-prestige-talent-backcheck","metadataNotes":"Updated from user-provided source text; non-automatable targeting/LOS/session adjudication remains GM/player confirmed.","rules":[{"type":"TALENT_RULE","id":"force_treatment","label":"Force Treatment","summary":"Use Use the Force in place of Treat Injury; rerolls transfer to the UtF check.","action":"use-the-force-check","mode":"skill_substitution_treat_injury","text":"You can make a Use the Force check in place of a Treat Injury check. You are considered Trained in the Treat Injury Skill for purposes of using this Talent. If you are entitled to a Treat Injury check reroll, you can reroll your Use the Force check instead (subject to the same circumstances and limitations)."}],"actionType":"standard","resolutionMode":"forceAdeptTalent","forceAdeptTalentAction":"forceTreatment","combatActions":[{"id":"force-treatment","name":"Force Treatment","actionType":"standard","requiredTalent":"Force Treatment","description":"You can make a Use the Force check in place of a Treat Injury check. You are considered Trained in the Treat Injury Skill. If you are entitled to a Treat Injury check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations).","resolutionMode":"forceAdeptTalent","spendAction":true,"effects":[],"resources":["Use the Force","Treat Injury"],"notes":"Use Use the Force in place of Treat Injury; administer First Aid, Treat Disease, Treat Poison, and Treat Radiation without Medical Kit or Medpac.","manualResolution":false,"relatedSkills":["useTheForce"],"forceAdeptTalentAction":"forceTreatment","label":"Force Treatment","useLabel":"Use"}],"implementationDeferred":false},"effect":"You can make a Use the Force check in place of a Treat Injury check. You are considered Trained in the Treat Injury Skill for purposes of using this Talent. If you are entitled to a Treat Injury check reroll, you can reroll your Use the Force check instead (subject to the same circumstances and limitations).","shortSummary":"Use Use the Force in place of Treat Injury; rerolls transfer to the UtF check.","prerequisite":"","prerequisitesText":"","grantsActions":[],"summary":"Use Use the Force instead of Treat Injury, count as trained, and use applicable Treat Injury rerolls on the Force check.","source":"Clone Wars Campaign Guide","page":41},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id"