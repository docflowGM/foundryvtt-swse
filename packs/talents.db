{"_id":"7505fbdd592c04fd","name":"Bodyguard's Sacrifice","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a reaction, you can interfere with any successful attack against an adjacent ally. You can choose to take any or all of that attack's damage, and the remainder is dealt to the target as normal. Once you use this talent, you may not use it again until the end of your next turn.","description":{"value":"As a reaction, you can interfere with any successful attack against an adjacent ally. You can choose to take any or all of that attack's damage, and the remainder is dealt to the target as normal. Once you use this talent, you may not use it again until the end of your next turn."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","treeId":"c92c2cbc79b8a515","tags":["action_economy","damage_reduction","mobility","positioning","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action_reference","applicationScope":"martial_protector_arena_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","combatActions":[{"id":"bodyguards-sacrifice-t30-reference","name":"Bodyguard's Sacrifice","label":"Bodyguard's Sacrifice","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Reaction, you can interfere with any successful attack against an adjacent ally. You can choose to take any or all of that attack's damage, and the remainder is dealt to the target as normal. Once you use this Talent, you may not use it again until the end of your next turn.","notes":"As a Reaction, you can interfere with any successful attack against an adjacent ally. You can choose to take any or all of that attack's damage, and the remainder is dealt to the target as normal. Once you use this Talent, you may not use it again until the end of your next turn.","relatedSkills":[],"resources":["Until your next turn","Ally context","Adjacent positioning"],"requiredContext":["Valid adjacent creature/ally positioning","Triggering attack/damage result confirmed","Reaction timing available","Protected ally and damage-transfer context confirmed"],"targetHint":"GM/player adjudicated target or context","spendAction":false,"ruleData":{}}],"rules":[],"phase30MartialProtectorArenaCleanup":{"phase":"T30","tree":"Protection","status":"reviewed_manual_or_runtime_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"T30 removed unsafe passive rows from martial/protector/arena/species leftovers and surfaced action, reaction, recovery, cover, and attack-rider context as truthful cards/rules."}},"summary":"As a reaction, you can interfere with any successful attack against an adjacent ally.","source":"Legacy Era Campaign Guide","page":40},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.bodyguards_sacrifice","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.416Z","detectedPredicates":["attack.when-hit","proximity.ally-nearby","turn.once-per-round"]}}}
{"_id":"76352a9b615287f8","name":"Protection","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Double Agent","benefit":"As a standard action, you can designate one ally and make a Persuasion check, comparing the result against the Will Defense of all enemies in your line of sight who can hear and understand you. If your check result equals or exceeds a target's Will Defense, that target cannot attack the ally you designated until the beginning of your next turn.","description":{"value":"As a standard action, you can designate one ally and make a Persuasion check, comparing the result against the Will Defense of all enemies in your line of sight who can hear and understand you. If your check result equals or exceeds a target's Will Defense, that target cannot attack the ally you designated until the beginning of your next turn."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.35cd0efb3aae31c7","name":"Double Agent"}],"_source":"canonical-csv"},"treeId":"4dc70f924e7794ac","tags":["skills","social","support","intrigue","ally_support","battlefield_control"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"protection-t31-reference","name":"Protection","label":"Protection","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Standard Action, you can designate one ally and make a Persuasion check, comp