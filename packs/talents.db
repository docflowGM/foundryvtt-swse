{"_id":"32df92c3114b5c94","name":"Accurate Blow","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Choose one Exotic Weapon (Melee) or one of the following Weapon Groups in which you are proficient: Advanced Melee Weapons, Lightsabers, or Simple Weapons (Melee). When you make a Melee Attack with a Weapon from the chosen group and the attack roll exceeds the target's Reflex Defense by 5 or more, you deal +1 die of damage with the attack.","description":{"value":"Choose one Exotic Weapon (Melee) or one of the following Weapon Groups in which you are proficient: Advanced Melee Weapons, Lightsabers, or Simple Weapons (Melee). When you make a Melee Attack with a Weapon from the chosen group and the attack roll exceeds the target's Reflex Defense by 5 or more, you deal +1 die of damage with the attack."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","treeId":"fad8118981c532f0","tags":["melee"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":true,"modifiers":[],"implementedBy":"Future CombatOptionResolver / action-card / reaction prompt / damage-resolution hook","notes":"Reviewed in T12. Removed legacy static/passive modifier data; this talent is a real combat mechanic but needs runtime context and should not mutate permanent sheet totals.","choiceMetaStatus":"phase14_persistent_choice_seeded"},"choiceMeta":{"resolution":"immediate","required":true,"status":"phase14_persistent_choice_seeded","choiceKind":"melee_weapon_or_group","repeatable":true,"storagePath":"flags.swse.choices.accurate_blow_weapon","choiceSource":"prerequisiteDerived","optionRegistry":"data/feat-choice-options.json#choiceKinds.melee_weapon_or_group","derivesFrom":["weapon_proficiency"],"consumes":"weapon_proficiency","provides":"melee_weapon_or_group"},"summary":"Choose one Exotic Weapon (Melee) or one of the following Weapon Groups in which you are proficient: Advanced Melee Weapons, Lightsabers, or Simple Weapons (Melee).","source":"Clone Wars Campaign Guide","page":39},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.accurate_blow","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.407Z","detectedPredicates":["defense.against-melee","defense.reflex","attack.with-melee"]}}}
{"_id":"3331d4b2b88e446f","name":"Resist the Dark Side","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Dark Side Sense","benefit":"You gain a +5 Force bonus to all Defense scores against Force powers with the [dark side] descriptor and Force powers originating from any dark Force-user whose Dark Side Score equals their Wisdom score.","description":"You gain a +5 Force bonus to all Defense scores against Force powers with the [dark side] descriptor and Force powers originating from any dark Force-user whose Dark Side Score equals their Wisdom score.","class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.e885f64758f5e2bd","name":"Dark Side Sense"}],"_source":"canonical-csv"},"treeId":"36f18f3e974feb33","tags":["dark_side","force","force_defense","light_side","scaling"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"force_context_manual","staticSheetPolicy":"manual_only","manualResolution":true,"notes":"Conditional +5 Force bonus to defenses only against dark side Force powers or powers from dark Force-users. The current system does not reliably know that descriptor/source at static prep; apply at the table or through a future Force-context resolver.","modifiers":[],"combatActions":[{"id":"resist-the-dark-side","name":"Resist the Dark Side","label":"Resist the Dark Side","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"You gain a +5 Force bonus to all Defense scores against Force Powers with the [Dark Side] descriptor, and Force Powers originating from any dark Force-user (that is, any Force-use whose Dark Side Score equals their Wisdom score).","notes":"You gain a +5 Force bonus to all Defense scores against Force Powers with the [Dark Side] descriptor, and Force Powers originating from any dark Force-user (that is, any Force-use whose Dark Side Score equals their Wisdom score).","relatedSkills":[],"resources":[],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[],"requiresRuntimeContext":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Jedi Sentinel","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":0,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."}},"talent_tree":"Jedi Sentinel","slug":"resist-the-dark-side","summary":"Gain +5 Force to all defenses against dark-side powers and powers from fully dark Force-users.","source":"Saga Edition Core Rulebook","page":41},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.resist_the_dark_side","jediTreeCleanup":{"phase":"T7","status":"manual_or_contextual","reason":"Conditional +5 Force bonus to defenses only against dark side Force powers or powers from dark Force-users. The current system does not reliably know that descriptor/source at static prep; apply at the table or through a future Force-context resolver."}}}}
{"_id":"3340f268613c0349","name":"Cunning Distraction","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When you successfully feint an opponent in combat, you can immediately move up to one-half your speed as a reaction.","description":{"value":"When you successfully feint an opponent in combat, you can immediately move up to one-half your speed as a reaction."},"class":"8da58194b3d58041","costNumeric":null,"category":"Charlatan","treeId":"ab9b75bc19f8e983","tags":["action_economy","control","deception","skills","social","stealth","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"combat_action_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"AbilityCombatActionResolver + character sheet combat actions tab; final resolution remains manual until the relevant target/minion/action-sequence executor exists.","notes":"Reviewed in phase T15. This talent depends on target identity, ally/minion state, line of sight, positioning, encounter timing, or GM adjudication. It should not mutate permanent actor sheet totals.","combatActions":[{"id":"cunning-distraction","name":"Cunning Distraction","actionType":"free","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","relatedSkills":[],"resources":[],"requiredContext":["Successful Feint"],"notes":"After you successfully Feint an opponent in combat, immediately move up to one-half your speed.","description":"After you successfully Feint an opponent in combat, immediately move up to one-half your speed.","targetHint":"Self"}]},"summary":"When you successfully feint an opponent in combat, you can immediately move up to one-half your speed as a reaction.","source":"Scum and Villainy","page":31},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.cunning_distraction","mig