{"_id":"3038f4c26de19e39","name":"Greater Weapon Focus (Lightsabers)","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Weapon Focus (lightsabers) feat (see page 89),","benefit":"You gain a +1 bonus on melee attack rolls with Lightsabers. This bonus stacks with the bonus granted by the Weapon Focus (Lightsabers) feat.","description":"You gain a +1 bonus on melee attack rolls with Lightsabers. This bonus stacks with the bonus granted by the Weapon Focus (Lightsabers) feat.","class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"b3c5d90b5036f39b","tags":["lightsaber","melee"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"passive_lightsaber_melee_attack_bonus","applicationScope":"lightsaber_melee_attack_roll","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":false,"rules":[{"type":"WEAPON_ATTACK_BONUS","weaponGroups":["lightsabers"],"requiresAttackType":"melee","value":1,"label":"Greater Weapon Focus (Lightsabers)"}]},"summary":"You gain a +1 bonus on melee attack rolls with Lightsabers. This bonus stacks with the bonus granted by the Weapon Focus (Lightsabers) feat.","source":"Saga Edition Core Rulebook","page":218},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.greater_weapon_focus_lightsabers","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.407Z","detectedPredicates":[]}}}
{"_id":"317400e9ea2b66c7","name":"Multiattack Proficiency (lightsabers)","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2.","description":"Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2.","class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"b3c5d90b5036f39b","tags":["action_economy","dual_wield","force","force_control","force_offense","light_side","lightsaber","melee","mobility"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"repeatable_multiattack_penalty_reduction","applicationScope":"lightsaber_full_attack_penalty_math","staticSheetPolicy":"include","requiresRuntimeContext":true,"manualResolution":false,"repeatable":true,"rankValue":2,"weaponGroups":["lightsabers"]},"summary":"Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you reduce the penalty on your attack rolls by 2.","source":"Saga Edition Core Rulebook","page":218},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.multiattack_proficiency_lightsabers","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.407Z","detectedPredicates":[]}}}
{"_id":"319c5ded54dbc4e6","name":"Electronic Forgery","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Trained in the Use Computer skill","benefit":"You can use your Use Computer modifier in place of your Deception modifier to create a deceptive appearance with forged electronic documents.","description":{"value":"You can use your Use Computer modifier in place of your Deception modifier to create a deceptive appearance with forged electronic documents."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"usecomputer"}],"_source":"fix5F-canonical"},"treeId":"64874e65579e4cf4","tags":["skills","slicing","social","tech","use_computer"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"electronic-forgery","name":"Electronic Forgery","label":"Electronic Forgery","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"You can use your Use Computer modifier in place of your Deception modifier to create a deceptive appearance with forged electronic documents.","notes":"Use Computer may replace Deception only for forged electronic documents/deceptive electronic appearances. Do not globally replace all Deception checks.","relatedSkills":[{"skill":"Use Computer"},{"skill":"Deception"}],"resources":["Electronic document forgery","Use Computer substitution"],"requiredContext":["Creating deceptive electronic documents"],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[],"mechanicsMode":"combat_action_reference","applicationScope":"runtime_skill_crafting_medical_computer_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase29TechMedicalMicrotreeCleanup":{"phase":"T29","tree":"Slicer","status":"reviewed_manual_or_runtime_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEf