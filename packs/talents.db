{"_id":"da6a06aaf630376d","name":"Man Down","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Whenever an ally within 6 squares is reduced to 0 hit points, you can immediately move up to your speed toward that ally as a reaction. This movement does not provoke attacks of opportunity.","description":{"value":"Whenever an ally within 6 squares is reduced to 0 hit points, you can immediately move up to your speed toward that ally as a reaction. This movement does not provoke attacks of opportunity."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","treeId":"67fdd8dce9abd6c1","tags":["damage_reduction","mobility","positioning","support","reaction","movement"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"man-down-reaction","name":"Man Down","label":"Man Down","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"When an ally within 6 squares is reduced to 0 Hit Points, immediately move up to your speed toward that ally. This movement does not provoke attacks of opportunity.","notes":"When an ally within 6 squares is reduced to 0 Hit Points, immediately move up to your speed toward that ally. This movement does not provoke attacks of opportunity.","resources":["Trigger: ally within 6 squares reduced to 0 HP"],"targetHint":"Downed ally"}],"mechanicsMode":"combat_action","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"phase21BrawlerShockboxerCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Trigger depends on ally HP event and map position; surfaced as a reaction card.","naturalWeaponPolicy":"Treat species natural weapons as unarmed-family attacks when the source text affects unarmed attacks."}},"summary":"Whenever an ally within 6 squares is reduced to 0 hit points, you can immediately move up to your speed toward that ally as a reaction.","source":"Scum and Villainy","page":18},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.man_down","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":["proximity.ally-nearby"]}}}
{"_id":"da891615bb87a9e6","name":"Breach Cover","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When you fire or throw a Weapon with a Burst or Splash radius at a target with Cover, you ignore that Cover.","description":{"value":"When you fire or throw a Weapon with a Burst or Splash radius at a target with Cover, you ignore that Cover."},"class":"b85240cf77cf95eb","costNumeric":null,"category":"Military Engineer","treeId":"e32009b1b0aee8c9","tags":["burst_damage","ranged"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"rules":[{"type":"ATTACK_OPTION","id":"breach-cover","label":"Breach Cover","control":"passive","requiresAreaAttack":true,"suppresses":["coverBonus"],"summary":"When firing or throwing a burst/splash area weapon at a target with cover, ignore that cover bonus."}],"phase17TechEngineeringCleanup":{"status":"contextual_runtime_rule","owner":"CombatOptionResolver / attack pipeline","notes":"Curated contextual attack rule; suppresses cover only when the attack context is an area/burst/splash attack."}},"summary":"When you fire or throw a Weapon with a Burst or Splash radius at a target with Cover, you ignore that Cover.","source":"Clone Wars Campaign Guide","page":45},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.breach_cover","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":[]}}}
{"_id":"da9e6511f3ae8435","name":"System Hit","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Expert Gunner.","benefit":"Whenever you deal damage to a Vehicle that equals or exceeds its Damage Threshold, you move that Vehicle an additional -1 step on the Condition Track.","description":{"value":"Whenever you deal damage to a Vehicle that equals or exceeds its Damage Threshold, you move that Vehicle an additional -1 step on the Condition Track."},"class":"9c9989c34714f920","costNumeric":null,"category":"Ace Pilot","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.befaa195df06b274","name":"Expert Gunner"}],"_source":"canonical-csv"},"treeId":"43ead399d82b8142","tags":["condition_removal","force","force_offense"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase16VehicleStarshipCleanup":{"status":"metadata_or_gm_player_managed","owner":"GM/player or future vehicle subsystem","notes":"No truthful automatic runtime owner in this pass; stale migrated modifiers/effects removed if present."}},"summary":"Whenever you deal damage to a Vehicle that equals or exceeds its Damage Threshold, you move that Vehicle an additional -1 step on the Condition Track.","source":"Saga Edition Core Rulebook","page":207},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.system_hit","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":[]}}}
{"_id":"db14070064e54a04","name":"Expanded Sensors","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"If you or any of your Droid allies has line of sight to, and is aware of, a target, all Droid allies that can hear and understand you are also considered to have line of sight (but not necessarily line of effect) to that target."},"benefit":"If you or any of your Droid allies has line of sight to, and is aware of, a target, all Droid allies that can hear and understand you are also considered to have line of sight (but not necessarily line of effect) to that target.","class":"","category":"","costNumeric":null,"treeId":"9688ed3500084dca","tags":["action_economy","defense","droid","durability","mobility","sensors","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase19DroidCleanup":{"status":"cleaned_future_runtime_context","owner":"future_droid_line_of_sight_network_resolver","tree":"Droid Commander","notes":"Unsafe migrated modifiers removed; talent requires a dedicated future runtime context before automation.","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0}},"summary":"If you or any of your Droid allies has line of sight to, and is aware of, a target, all Droid allies that can hear and understand you are also considered to have line of sight (but not necessarily line of effect) to...","source":"Clone Wars Campaign Guide","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":[]}}}
{"_id":"dbe08a93276b6c25","name":"Inspire Wrath","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Impel Ally I, Impel Ally II","benefit":"As a standard action, you can designate a target to be the object of your allies' wrath. While your allies have line of sight to the target or until the target is unconscious or dead, your allies gain a +2 morale bonus on attack rolls against the target and a +2 morale bonus on skill checks against that target. You can designate a new target on any round by using another standard action. You can only use this talent against one opponent at a time.","description":{"value":"As a standard action, you can designate a target to be the object of your allies' wrath. While your allies have line of sight to the target or until the target is unconscious or dead, your allies gain a +2 morale bonus on attack rolls against the target and a +2 morale bonus on skill checks against that target. You can designate a new target on any round by using another standard action. You can only use this talent against one opponent at a time."},"class":"324631ca844a88be","costNumeric":null,"category":"Crime Lord","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.b11a87e70f957ed2","name":"Impel Ally II"}],"_source":"canonical-csv"},"treeId":"560cc7994b357a0d","tags":["ally_support","support","teamwork","morale","standard_action","action_economy","target-designation","targeting","skills","precision"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"combat_action_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"AbilityCombatActionResolver + character sheet combat actions tab; final resolution remains manual until the relevant target/minion/action-sequence executor exists.","notes":"Reviewed in phase T15. This talent depends on target identity, ally/minion state, line of sight, positioning, encounter timing, or GM adjudication. It should not mutate permanent actor sheet totals.","combatActions":[{"id":"inspire-wrath","name":"Inspire Wrath","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","relatedSkills":[],"resources":[],"requiredContext":["Allies with line of sight","One target"],"notes":"Designate one target. While your allies have line of sight to you, they gain +2 morale bonus on attack rolls and skill checks against that target until you are unconscious/dead or designate a new target.","description":"Designate one target. While your allies have line of sight to you, they gain +2 morale bonus on attack rolls and skill checks against that target until you are unconscious/dead or designate a new target.","targetHint":"One enemy"}]},"summary":"As a standard action, you can designate a target to be the object of your allies' wrath.","source":"Scum and Villainy","page":27},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_wrath","nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Follower/dependent-actor subsystem or GM/player managed","note":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals."}}}}
{"_id":"dbfcec98f38c8e2f","name":"Ignore Armor","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per encounter, when you make a melee attack, you can ignore any Armor or Equipment bonuses granted by your target's Armor.","description":{"value":"Once per encounter, when you make a melee attack, you can ignore any Armor or Equipment bonuses granted by your target's Armor."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","treeId":"fad8118981c532f0","tags":["armor","melee"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Future CombatOptionResolver / action-card / reaction prompt / damage-resolution hook","notes":"Reviewed in T12. Removed legacy static/passive modifier data; this talent is a real combat mechanic but needs runtime context and should not mutate permanent sheet totals."},"summary":"Once per encounter, when you make a melee attack, you can ignore any Armor or Equipment bonuses granted by your target's Armor.","source":"Clone Wars Campaign Guide","page":40},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.ignore_armor","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":["attack.with-melee","turn.once-per-round"]}}}
{"_id":"dc61d67946b1c1d6","name":"Bigger Bang","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Improvised Device","benefit":"Whenever you create a grenade with the Improvised Device talent, the grenade deals an additional die of damage when used.","description":{"value":"Whenever you create a grenade with the Improvised Device talent, the grenade deals an additional die of damage when used."},"class":"db019dfbb271cdf6","costNumeric":null,"category":"Improviser","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.84d4e92693185028","name":"Improvised Device"}],"_source":"canonical-csv"},"treeId":"7f37422819d7be6f","tags":["control","equipment","jury_rig","tech"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase17TechEngineeringCleanup":{"status":"cleaned_future_runtime_context","owner":"future_improvised_device_attack_resolver","notes":"Adds one damage die only to damage from an Improvised Device; removed unsafe generic damage Active Effect."}},"summary":"Grenades made with Improvised Device deal +1 damage die.","source":"Rebellion Era Campaign Guide","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.bigger_bang","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":[]}}}
{"_id":"dd488c2dc43d14ab","name":"Unsettling Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Force Interrogation","benefit":"You can spend a Force Point as a standard action to create an aura of unsettling discomfort around you. You make a Use the Force check when you activate this talent and compare the check result to the Will Defense of any creature that comes within 6 squares of you. If your Use the Force check result exceeds the creature's Will Defense, that target takes a -2 penalty on attack rolls and skill checks while within 6 squares of you. This aura lasts for the remainder of the encounter.","description":{"value":"You can spend a Force Point as a standard action to create an aura of unsettling discomfort around you. You make a Use the Force check when you activate this talent and compare the check result to the Will Defense of any creature that comes within 6 squares of you. If your Use the Force check result exceeds the creature's Will Defense, that target takes a -2 penalty on attack rolls and skill checks while within 6 squares of you. This aura lasts for the remainder of the encounter."},"class":"289fcf920ef0e184","costNumeric":null,"category":"Force Adept","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.2acaa4620d396fe9","name":"Force Interrogation"}],"_source":"canonical-csv"},"treeId":"a6ee1a0c534cbc73","tags":["force","force_capacity","force_offense","force_point_spend","force_training","positioning","resource_spend","standard_action","use_the_force","persuasion"],"executionModel":"ACTIVE","subType":"ACTION","abilityMeta":{"mechanicsMode":"runtime_or_contextual","applicationScope":"force_adept_talent_runtime","staticSheetPolicy":"exclude","manualResolution":false,"modifiers":[],"notes":"Force Point aura with Use the Force check versus Will; encounter aura needs active-effect workflow.","combatActions":[{"id":"unsettling-presence","name":"Unsettling Presence","label":"Unsettling Presence","actionType":"standard","cost":1,"manualResolution":false,"resolutionMode":"forceAdeptTalent","useLabel":"Use","description":"You can spend a Force Point as a Standard Action to create an aura of unsettling discomfort around you. You make a Use the Force check when you activate this Talent and compare the check result to the Will Defense of any creature that comes within 6 squares of you.\n\nIf your Use the Force check result equals or exceeds the creature's Will Defense, that target takes a -2 penalty on attack rolls and Skill Checks while within 6 squares of you. This aura lasts for the remainder of the encounter.","notes":"Spend a Force Point and roll Use the Force; selected targets that fail are flagged with the attack penalty. Range/LoS remains adjudicated.","relatedSkills":["useTheForce"],"resources":["Force Point","Use the Force","Aura"],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{"forceAdeptTalentAction":"unsettlingPresence"},"forceAdeptTalentAction":"unsettlingPresence"}],"rules":[{"type":"AURA_EFFECT","id":"unsettling-presence-aura","label":"Unsettling Presence","radiusSquares":6,"attackPenalty":-2,"skillPenalty":-2,"duration":"encounter","summary":"You can spend a Force Point as a Standard Action to create an aura of unsettling discomfort around you. You make a Use the Force check when you activate this Talent and compare the check result to the Will Defense of any creature that comes within 6 squares of you.\n\nIf your Use the Force check result equals or exceeds the creature's Will Defense, that target takes a -2 penalty on attack rolls and Skill Checks while within 6 squares of you. This aura lasts for the remainder of the encounter."}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Imperial Inquisitor","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."},"requiresRuntimeContext":true,"backcheckNotes":{"phase":"force-mystic-telepath-backcheck","source":"user-pasted rules text","descriptionUpdated":true,"runtimeAction":"unsettlingPresence"}},"summary":"You can spend a Force Point as a standard action to create an aura of unsettling discomfort around you.","source":"Force Unleashed Campaign Guide","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.unsettling_presence","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":[],"forcePrestigeCleanup":{"phase":"T9","status":"manual_or_runtime","scope":"runtime_aura_prompt"}}}}
{"_id":"dd69400f0069f846","name":"Improved Skirmisher","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Skirmisher","benefit":"When you move at least 2 squares before your attack and end your move in a different square from where you started, you gain a +1 bonus to all your defenses until the start of your next turn.","description":{"value":"When you move at least 2 squares before your attack and end your move in a different square from where you started, you gain a +1 bonus to all your defenses until the start of your next turn."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.7b23e0812d6a8985","name":"Skirmisher"}],"_source":"canonical-csv"},"treeId":"67b59e020c1660eb","tags":["mobility","positioning"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"modifiers":[]},"summary":"When you move at least 2 squares before your attack and end your move in a different square from where you started, you gain a +1 bonus to all your defenses until the start of your next turn.","source":"Scum and Villainy","page":15},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_skirmisher"}}}
