{"_id":"f3a1542edd5f4259","name":"Dedicated Protector","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Harm's Way","description":{"value":"Once per encounter, you can designate one ally within 6 squares of you. Until the end of the encounter, that ally gains a +1 morale bonus to Reflex Defense as long as it remains adjacent to you. Any individual can only be the target of this talent once per encounter."},"benefit":"Once per encounter, you can designate one ally within 6 squares of you. Until the end of the encounter, that ally gains a +1 morale bonus to Reflex Defense as long as it remains adjacent to you. Any individual can only be the target of this talent once per encounter.","class":"","category":"","costNumeric":null,"treeId":"798ed0945cbdac1c","tags":["action_economy","ally_support","battlefield_control","condition_removal","damage_reduction","defense","evasion","mobility","positioning","shields","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals."},"summary":"Once per encounter, designate a nearby ally to gain +1 morale Reflex while adjacent to you for the encounter.","source":"Galaxy of Intrigue","page":24},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.433Z","detectedPredicates":["proximity.ally-nearby","turn.once-per-round","target.is-flanked"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Follower/dependent-actor subsystem or GM/player managed","note":"Ally/follower/minion effec