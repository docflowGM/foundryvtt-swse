{"_id":"c80edefd9c32ad02","name":"Reduce Mobility","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When you score a critical hit with a melee or ranged attack, you reduce the target's speed by half until it is fully healed (at maximum hit points).","description":{"value":"When you score a critical hit with a melee or ranged attack, you reduce the target's speed by half until it is fully healed (at maximum hit points)."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","treeId":"71e99c646b18d85c","tags":["action_economy","damage_reduction","heavy_weapon","medicine","melee","mobility","positioning","precision","ranged","scaling","skills","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"critical_hit_rider","staticSheetPolicy":"exclude","manualResolution":false,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","rules":[{"type":"CRITICAL_RIDER","id":"reduce-mobility-critical","label":"Reduce Mobility","targetEffectsOnCritical":[{"type":"speedMultiplier","value":0.5,"duration":"untilFullyHealed"}]}],"phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Critical Master","status":"reviewed","notes":"Reviewed in tactical ranged/military cleanup."}},"summary":"When you score a critical hit with a melee or ranged attack, you reduce the target's speed by half until it is fully healed (at maximum hit points).","source":"Force Unleashed Campaign Guide","page":42},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.reduce_mobility","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.427Z","detectedPredicates":["defense.against-ranged","defense.against-melee","defense.reflex","attack.when-hit","attack.with-melee","attack.with-ranged"]}}}
{"_id":"c83f18465c3b9d91","name":"Revenge","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Dark Presence; Power of the Dark Side","benefit":"Whenever an ally of equal or higher level than you is killed or reduced to 0 hit points within your line of sight, you gain a +2 Force bonus on attack rolls and damage rolls until the end of the encounter. Force bonuses do not stack, so multiple fallen allies do not increase the bonus.","description":"Whenever an ally of equal or higher level than you is killed or reduced to 0 hit points within your line of sight, you gain a +2 Force bonus on attack rolls and damage rolls until the end of the encounter. Force bonuses do not stack, so multiple fallen allies do not increase the bonus.","costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.606e14c428f1d159","name":"Dark Presence"}],"_source":"canonical-csv"},"treeId":"de95d37c72b1c4cd","tags":["damage_reduction","dark_side","force","force_multiplier","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"revenge","name":"Revenge","label":"Revenge","actionType":"free","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Gain +2 attack and +2 damage if an ally of equal or higher level dies or is reduced to 0 hp within line of sight.","notes":"Gain +2 attack and +2 damage if an ally of equal or higher level dies or is reduced to 0 hp within line of sight.","relatedSkills":[],"resources":["Trigger: ally of equal/higher level reduced to 0 HP or killed in line of sight"],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Dark Side","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"When an equal-or-higher-level ally falls in sight, gain +2 Force to attacks and damage for the encounter.","source":"Saga Edition Core Rulebook","page":101},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.revenge","forceTalentCleanup":{"phase":"T22","tree":"Dark Side","status":"combat_action_card"}}}}
{"_id":"c87b8389c8ca6ea9","name":"Consular's Vitality","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Jedi during the Clone Wars learn to call upon the Force not only for their own strength but also to aid the clone troopers and other allies under their command. Once per round as a swift action, you grant one ally within 12 squares of you (and in your line of sight) bonus hit points equal to 5 + your Charisma modifier. These bonus hit points last until the beginning of your next turn (at which point any remaining bonus hit points are lost), and any damage dealt to that ally comes out of bonus hit points first. You take a -5 penalty on all Use the Force checks until the beginning of your next turn.","description":"Jedi during the Clone Wars learn to call upon the Force not only for their own strength but also to aid the clone troopers and other allies under their command. Once per round as a swift action, you grant one ally within 12 squares of you (and in your line of sight) bonus hit points equal to 5 + your Charisma modifier. These bonus hit points last until the beginning of your next turn (at which point any remaining bonus hit points are lost), and any damage dealt to that ally comes out of bonus hit points first. You take a -5 penalty on all Use the Force checks until the beginning of your next turn.","class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"e99cfa9db8493573","tags":["action_economy","force","force_offense","light_side","lightsaber","melee","mobility"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"consulars-vitality","name":"Consular's Vitality","label":"Consular's Vitality","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per round as a Swift Action, you grant one ally within 12 squares of you (and within your line of sight) Bonus Hit Points equal to 5 + your Charisma modifier.","notes":"Once per round as a Swift Action, you grant one ally within 12 squares of you (and within your line of sight) Bonus Hit Points equal to 5 + your Charisma modifier.","relatedSkills":[],"resources":["Once per round"],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{}}],"rules":[],"mechanicsMode":"contextual","applicationScope":"force_lightsaber_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Jedi Consular","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":1,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."}},"summary":"Once per round as a Swift Action, grant an ally Bonus Hit Points equal to 5 + your Charisma modifier; take -5 on UTF until your next turn.","source":"Clone Wars Campaign Guide","page":21},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.consulars_vitality","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.427Z","detectedPredicates":[],"runtimeImplemented":true,"implementationNote":"Implemented through ConsularTalentActions and the combat action tracker."}}}
{"_id":"c8bf9ab9d1f8588a","name":"Greater Dark Side Talisman","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Dark Side Talisman","benefit":"As Dark Side Talisman (above), except that the talisman’s Force bonus extends to all three of your defenses (Reflex, Fortitude, and Will).","description":{"value":"As Dark Side Talisman (above), except that the talisman’s Force bonus extends to all three of your defenses (Reflex, Fortitude, and Will)."},"class":"289fcf920ef0e184","costNumeric":null,"category":"Dark Side Devotee","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.e96812723ff4eb04","name":"Dark Side Talisman"}],"_source":"canonical-csv"},"treeId":"96ef43a3054dcb58","tags":["action_economy","dark_side","force","force_capacity","force_defense","force_point_spend","force_training","light_side","resource_spend","sustained_damage","talisman"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"modifiers":[],"combatActions":[{"id":"greater-dark-side-talisman","name":"Greater Dark Side Talisman","label":"Greater Dark Side Talisman","actionType":"full-round","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"You can spend a Force Point to imbue a Weapon or some other portable object with the Dark Side of The Force, creating a Talisman that grants you protection from the Light Side. Creating the Greater Dark Side Talisman takes a Full-Round Action.","notes":"You can spend a Force Point to imbue a Weapon or some other portable object with the Dark Side of The Force, creating a Talisman that grants you protection from the Light Side. Creating the Greater Dark Side Talisman takes a Full-Round Action.","relatedSkills":[],"resources":["Force Point context"],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{}}],"rules":[],"mechanicsMode":"contextual","applicationScope":"force_lightsaber_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Dark Side Devotee","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":1,"removedLegacyModifierRows":3,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."},"source":"talent-backcheck","combatActionId":"greater-dark-side-talisman","sithTalentAction":"greaterDarkSideTalisman"},"talent_tree":"Dark Side Devotee","tree":"Dark Side Devotee","implementationStatus":"ui-deferred","automationBoundary":"manual","summary":"As Dark Side Talisman (above), except that the talisman’s Force bonus extends to all three of your defenses (Reflex, Fortitude, and Will).","source":"Jedi Academy Training Manual","page":17},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.greater_dark_side_talisman"}}}
{"_id":"c913aa5322934cfd","name":"Buried Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":"You can spend a Force Point as a standard action to become immune to detection by the Force for 1 hour. During this time, you always avoid detection by characters who are using the sense force application of the Use the Force skill, and you cannot be the target of the farseeing power. You may use this as a reaction to another character attempting to locate you with Sense Force (but before the character locates you), and if you make a Use the Force check this power’s effect immediately ends.","benefit":"You can spend a Force Point as a standard action to become immune to detection by the Force for 1 hour. During this time, you always avoid detection by characters who are using the sense force application of the Use the Force skill, and you cannot be the target of the farseeing power. You may use this as a reaction to another character attempting to locate you with Sense Force (but before the character locates you), and if you make a Use the Force check this power’s effect immediately ends.","class":"","category":"","costNumeric":null,"treeId":"754907ded50d4f46","tags":["action_economy","concealment","force","force_defense","force_offense","force_point_spend","mobility","offense_ranged","positioning","ranged","resource_spend","scaling","stealth","swift_action","use_the_force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"combat_action_or_force_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"modifiers":[],"combatActions":[{"id":"buried-presence","name":"Buried Presence","label":"Buried Presence","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"When you use either the Talent or the Vanish Talent, you affect one other willing adjacent target, granting it the effect of that Talent as well. You can select this Talent multiple times. Each time you do so, it increases the number of adjacent willing targets you affect by one. You can spend a Force Point as a Swift Action to substitute your Use the Force modifier for your ranged attack bonus when making attacks with a ranged weapon until the beginning of your next turn. You can make a Use the Force check as a Swift Action to vanish from the sight of a single target within line of sight. If the result of your Use the Force check exceeds the target's Will Defense, you gain Total Concealment from that target until the beginning of your next turn, or until you make an attack roll or Skill Check against the target.","notes":"When you use either the Talent or the Vanish Talent, you affect one other willing adjacent target, granting it the effect of that Talent as well. You can select this Talent multiple times. Each time you do so, it increases the number of adjacent willing targets you affect by one. You can spend a Force Point as a Swift Action to substitute your Use the Force modifier for your ranged attack bonus when making attacks with a ranged weapon until the beginning of your next turn. You can make a Use the Force check as a Swift Action to vanish from the sight of a single target within line of sight. If the result of your Use the Force check exceeds the target's Will Defense, you gain Total Concealment from that target until the beginning of your next turn, or until you make an attack roll or Skill Check against the target.","relatedSkills":[{"skill":"Use the Force"},{"skill":"Attack Roll"}],"resources":["Force Point context"],"requiredContext":["Adjacency/position confirmed by GM/player","Line of sight confirmed by GM/player","Target context confirmed"],"targetHint":"GM/player adjudicated target or affected creature(s)","spendAction":true,"ruleData":{}}],"rules":[],"notes":"T28 removed unsafe migrated modifier/effect data. This talent depends on Force-suite, target, equipment, ally, encounter, or table-position context and is surfaced as a truthful manual/runtime card rather than a passive actor mutation.","phase28ForceMicrotraditionCleanup":{"phase":"T28","tree":"Agent Of Ossus","status":"reviewed_contextual_or_manual_card","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Force/special-tradition microtree cleanup. Unsafe always-on rows were removed; final bonuses/effects require player/GM or future dedicated runtime owner."}},"summary":"You can spend a Force Point as a standard action to become immune to detection by the Force for 1 hour.","source":"Force Unleashed Campaign Guide","page":92},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.427Z","detectedPredicates":["defense.will","attack.with-ranged"]}}}
{"_id":"c93a9e38c432551b","name":"Cleanse Mind","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per turn as a swift action, you can remove one ongoing mind-affecting effect (such as the effects of Demand Surrender or Weaken Resolve talents, or the effect of being moved to the end of the condition track by the Adept Negotiator talent, or the ongoing effects of the mind trick Force power) from a single allied target within line of sight.","description":"Once per turn as a swift action, you can remove one ongoing mind-affecting effect (such as the effects of Demand Surrender or Weaken Resolve talents, or the effect of being moved to the end of the condition track by the Adept Negotiator talent, or the ongoing effects of the mind trick Force power) from a single allied target within line of sight.","class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"e99cfa9db8493573","tags":["force","force_control","light_side","mobility","support","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"cleanse-mind","name":"Cleanse Mind","label":"Cleanse Mind","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per turn as a Swift Action, you can remove one ongoing Mind-Affecting effect (such as the effects of Demand Surrender or Weaken Resolve Talents, or the effect of being moved to the end of the Condition Track by the Adept Negotiator Talent, or the ongoing effects of the Mind Trick Force Power) from a single allied target within line of sight.","notes":"Once per turn as a Swift Action, you can remove one ongoing Mind-Affecting effect (such as the effects of Demand Surrender or Weaken Resolve Talents, or the effect of being moved to the end of the Condition Track by the Adept Negotiator Talent, or the ongoing effects of the Mind Trick Force Power) from a single allied target within line of sight.","relatedSkills":[],"resources":["Once per turn"],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{}}],"rules":[],"mechanicsMode":"contextual","applicationScope":"force_lightsaber_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Jedi Consular","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":1,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."}},"summary":"As a swift action once per turn, remove one ongoing mind-affecting effect from an allied target within line of sight.","source":"Force Unleashed Campaign Guide","page":24},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.cleanse_mind","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.427Z","detectedPredicates":[],"runtimeImplemented":true,"implementationNote":"Implemented through ConsularTalentActions and the combat action tracker."}}}
{"_id":"c95b1077ab31f9b0","name":"Sokan","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Acrobatic Recovery","benefit":"You may take 10 on Acrobatics checks to tumble even when distracted or threatened. Additionally, each threatened or occupied square that you tumble through only counts as 1 square of movement.","description":"You may take 10 on Acrobatics checks to tumble even when distracted or threatened. Additionally, each threatened or occupied square that you tumble through only counts as 1 square of movement.","class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"2bc2572e852832e4","tags":["lightsaber","melee","positioning","force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"sokan","name":"Sokan","label":"Sokan","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"You may Take 10 on Acrobatics checks to Tumble, even when distracted or threatened. Additionally, each threatened or occupied square that you Tumble through only counts as 1 square of movement.","notes":"You may Take 10 on Acrobatics checks to Tumble, even when distracted or threatened. Additionally, each threatened or occupied square that you Tumble through only counts as 1 square of movement.","relatedSkills":[{"skill":"Acrobatics"}],"resources":[],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[],"mechanicsMode":"contextual","applicationScope":"force_lightsaber_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Lightsaber Forms","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":1,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."}},"talent_tree":"Lightsaber Forms","tree":"Lightsaber Forms","summary":"Take 10 when tumbling under pressure, and threatened/occupied squares cost only 1 square of movement.","source":"Saga Edition Core Rulebook","page":219},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.sokan","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.427Z","detectedPredicates":[],"lightsaberFormImplementation":{"status":"active-form-only","rule":"Only one Lightsaber Form can be active at a time; inactive forms grant no benefits.","updated":"2026-06-11"}}}}
{"_id":"c980750800b91061","name":"Stay in the Fight","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Stalwart Subordinates","benefit":"As a swift action, you remove one mind-affecting or fear effect currently affecting an ally within 12 squares of you and in your line of sight. When you do so, you also grant the target a number of bonus hit points equal to 10 + your class level.","description":"As a swift action, you remove one mind-affecting or fear effect currently affecting an ally within 12 squares of you and in your line of sight. When you do so, you also grant the target a number of bonus hit points equal to 10 + your class level.","class":"30b9cd24b80ebf46","costNumeric":null,"category":"Officer","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.d9ffff2586cd259b","name":"Stalwart Subordinates"}],"_source":"canonical-csv"},"treeId":"61b74c82cb56876c","tags":["mobility","positioning","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"stay-in-the-fight","name":"Stay in the Fight","label":"Stay in the Fight","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Remove one mind-affecting or fear effect from an ally within 12 squares and line of sight and grant hit points equal to 10 + your class level.","notes":"Remove one mind-affecting or fear effect from an ally within 12 squares and line of sight and grant hit points equal to 10 + your class level.","relatedSkills":[],"resources":["Mind-affecting/fear removal"],"requiredContext":[],"targetHint":"One ally within 12 squares and line of sight","spendAction":true,"ruleData":{}}],"manualResolution":true,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Fugitive Commander","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"As a swift action, you remove one mind-affecting or fear effect currently affecting an ally within 12 squares of you and in your line of sight.","source":"Legacy Era Campaign Guide","page":42},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.stay_in_the_fight","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.427Z","detectedPredicates":["attack.when-hit"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Follower/dependent-actor subsystem or GM/player managed","note":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals."}}}}
{"_id":"ca30265867f3dcb1","name":"Krath Surge","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"Once per encounter, using rudimentary Sith sorcery, you channel dark side energy in a manner that boosts one use of a Force power. As a swift action, you can add 1 die of damage (if the power deals damage) or extend the range of the power by 6 squares (if it has a range beyond yourself or a single target). Using this talent automatically adds the [dark side] descriptor to the power used."},"benefit":"Once per encounter, using rudimentary Sith sorcery, you channel dark side energy in a manner that boosts one use of a Force power. As a swift action, you can add 1 die of damage (if the power deals damage) or extend the range of the power by 6 squares (if it has a range beyond yourself or a single target). Using this talent automatically adds the [dark side] descriptor to the power used.","class":"","category":"","costNumeric":null,"treeId":"d29a7261c1be4b83","talent_tree":"Krath","source":"Knights of the Old Republic Campaign Guide","page":60,"tags":["damage","dark_side","force","force_power","once-per-encounter","swift_action"],"executionModel":"ACTIVE","subType":"TALENT_ACTION","abilityMeta":{"mechanicsMode":"choice_required","applicationScope":"encounter_limited_force_power_enhancement","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"requiresSelectedChoice":true,"usesPerEncounter":1,"modifiers":[],"notes":"Enhances one use of a Force Power: either +1 damage die when it deals damage, or +6 squares of range when it has a range beyond the user or a single target. Neither benefit applies globally, and the enhanced use gains the [Dark Side] descriptor.","combatActions":[{"id":"krath-surge","name":"Krath Surge","actionType":"swift","requiredTalent":"Krath Surge","description":"Once per encounter, as a Swift Action, you can enhance a single use of a Force Power. Either add one die of damage when the Force Power deals damage, or extend its range by 6 squares if the Force Power has a range beyond the user or a single target. The affected Force Power gains the [Dark Side] descriptor.","resolutionMode":"manual","spendAction":true,"effects":[],"resources":["Force Power Suite"],"notes":"Swift Action, once per encounter. Choose one benefit for a single Force Power use; that use gains the [Dark Side] descriptor.","manualResolution":true,"relatedSkills":["useTheForce"],"label":"Krath Surge","useLabel":"Use"}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"krath-surge-krath-context","label":"Krath Surge","summary":"Once per encounter, as a Swift Action, you can enhance a single use of a Force Power. Either add one die of damage when the Force Power deals damage, or extend its range by 6 squares if the Force Power has a range beyond the user or a single target. The affected Force Power gains the [Dark Side] descriptor."}]},"activationChoiceMeta":{"resolution":"on_use","required":true,"choiceKind":"krath_surge_benefit","choiceKey":"krath_surge_benefit","label":"Krath Surge Enhancement","prompt":"Choose how Krath Surge enhances this Force Power use.","options":[{"id":"damage","label":"Add one damage die (Force Power must deal damage)"},{"id":"range","label":"Extend range by 6 squares (Force Power must have a range beyond the user or a single target)"}]},"summary":"Once per encounter, using rudimentary Sith sorcery, you channel dark side energy in a manner that boosts one use of a Force power."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"ca79321246ae6986","name":"Sprint","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When you use the Run action, you can move up to five times your Speed (instead of up to four times).","description":{"value":"When you use the Run action, you can move up to five times your Speed (instead of up to four times)."},"class":"b5bed5d1b5f42958","costNumeric":null,"category":"Scout","treeId":"9b06340233eb3cdd","tags":["mobility","survival","exploration"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"survival_exploration_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Run multiplier changed to x5; no permanent Speed mutation.","phase25SurvivalExplorationCleanup":{"phase":"T25","tree":"Survivor","status":"movement_reference","notes":"Run multiplier changed to x5; no permanent Speed mutation."},"combatActions":[{"id":"sprint-run-reference","name":"Sprint","label":"Sprint","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"When you use the Run action, you can move up to five times your Speed (instead of up to four times).","notes":"When you use the Run action, you can move up to five times your Speed (instead of up to four times).","relatedSkills":[],"resources":["Run action: x5 Speed instead of x4"],"requiredContext":["Using Run action"],"targetHint":"","spendAction":false,"ruleData":{}}],"movementRules":[{"type":"RUN_MULTIPLIER","id":"sprint","value":5}]},"summary":"When you use the Run action, you can move up to five times your Speed (instead of up to four times).","source":"Saga Edition Core Rulebook","page":50},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.sprint","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.427Z","detectedPredicates":[]}}}
{"_id":"cad07bbaa57634c0","name":"Castigate","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You deliver a scathing rebuke against a target to erode its will and fill it with doubt. Make a Persuasion check as a standard action against the target's Will Defense. If successful, impose a -2 penalty to all the target's Defenses until the end of your next turn. You can use this ability only against targets that can clearly hear you and understand your language.","description":{"value":"You deliver a scathing rebuke against a target to erode its will and fill it with doubt. Make a Persuasion check as a standard action against the target's Will Defense. If successful, impose a -2 penalty to all the target's Defenses until the end of your next turn. You can use this ability only against targets that can clearly hear you and understand your language."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","treeId":"e91cc675fbf9ba6e","tags":["skills","social","intrigue","deception","control"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed target context","notes":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists.","combatActions":[{"id":"castigate-t31-reference","name":"Castigate","label":"Castigate","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"You deliver a scathing rebuke against a target to erode its will and fill it with doubt. Make a Persuasion check as a Standard Action against the target's Will Defense. If successful, you impose a -2 penalty to all the target's Defenses until the end of your next turn.","notes":"You deliver a scathing rebuke against a target to erode its will and fill it with doubt. Make a Persuasion check as a Standard Action against the target's Will Defense. If successful, you impose a -2 penalty to all the target's Defenses until the end of your next turn.","relatedSkills":[{"skill":"Persuasion"}],"resources":["Target context"],"requiredContext":["Valid target confirmed"],"targetHint":"GM/player adjudicated target or context","spendAction":true,"ruleData":{}}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"castigate-t31-context","label":"Castigate","summary":"You deliver a scathing rebuke against a target to erode its will and fill it with doubt. Make a Persuasion check as a Standard Action against the target's Will Defense. If successful, you impose a -2 penalty to all the target's Defenses until the end of your next turn."}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Disgrace","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."}},"summary":"You deliver a scathing rebuke against a target to erode its will and fill it with doubt.","source":"Scum and Villainy","page":14},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.castigate","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.428Z","detectedPredicates":["defense.will"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"GM/player managed target context","note":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists."}}}}
{"_id":"cae4f000dcfddd99","name":"Swift Strider","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Long Stride, Sidestep","benefit":"You can use each of the following actions once per encounter as a standard action. Blurring Burst: As a move action move up to your speed and gain a +2 bonus to your Reflex Defense until the end of the encounter. Sudden Assault: Make a charge attack against an enemy within range as a standard action; you take no penalty to your Reflex Defense for this attack. Weaving Stride: Move up to your speed as a move action; you gain a cumulative +2 dodge bonus to Reflex Defense for each attack of opportunity made against you during this movement, lasting until the beginning of your next turn.","description":{"value":"You can use each of the following actions once per encounter as a standard action. Blurring Burst: As a move action move up to your speed and gain a +2 bonus to your Reflex Defense until the end of the encounter. Sudden Assault: Make a charge attack against an enemy within range as a standard action; you take no penalty to your Reflex Defense for this attack. Weaving Stride: Move up to your speed as a move action; you gain a cumulative +2 dodge bonus to Reflex Defense for each attack of opportunity made against you during this movement, lasting until the beginning of your next turn."},"class":"b5bed5d1b5f42958","costNumeric":null,"category":"Scout","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.b4ae0f26326cdf71","name":"Sidestep"}],"_source":"canonical-csv"},"treeId":"7c47d36dc1f77d9c","tags":["mobility"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"Once each per encounter, move for a lasting Reflex bonus, charge without the Reflex penalty, or build Reflex bonuses from attacks of opportunity during movement.","source":"Scum and Villainy","page":17},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.swift_strider","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.428Z","detectedPredicates":["turn.once-per-round"]}}}
{"_id":"cb018e0f620614fd","name":"Hunt the Hunter","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When you use a Standard Action to actively look for hidden enemies, you can make a single melee or ranged attack against any one enemy you notice with your Perception check.","description":{"value":"When you use a Standard Action to actively look for hidden enemies, you can make a single melee or ranged attack against any one enemy you notice with your Perception check."},"class":"b5bed5d1b5f42958","costNumeric":null,"category":"Scout","treeId":"127a55c242e031f2","tags":["perception","skills","detection","awareness","stealth","recon","standard_action","action_economy","melee","ranged"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"When you use a Standard Action to actively look for hidden enemies, you can make a single melee or ranged attack against any one enemy you notice with your Perception check.","source":"Clone Wars Campaign Guide","page":25},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hunt_the_hunter","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.428Z","detectedPredicates":[]}}}
{"_id":"cb0dcc59f7ced910","name":"Strength Implant","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per encounter as a standard action, you can give one adjacent living creature a strength implant. The target must be willing to receive this implant, which allows the target to deal +1 die of damage whenever it hits with a melee attack until the end of the encounter.\n\nThe following talents all grant effects that last until the end of the encounter. At the end of the encounter, any target that benefits from one or more of these talents immediately moves -3 steps down the condition track, and the condition becomes persistent. The persistent condition can only be removed after 8 hours of rest, or by performing successful surgery (as per the application of the Treat Injury skill) on the target.","description":{"value":"Once per encounter as a standard action, you can give one adjacent living creature a strength implant. The target must be willing to receive this implant, which allows the target to deal +1 die of damage whenever it hits with a melee attack until the end of the encounter.\n\nThe following talents all grant effects that last until the end of the encounter. At the end of the encounter, any target that benefits from one or more of these talents immediately moves -3 steps down the condition track, and the condition becomes persistent. The persistent condition can only be removed after 8 hours of rest, or by performing successful surgery (as per the application of the Treat Injury skill) on the target."},"class":"557e1a5ec72166fd","costNumeric":null,"category":"Shaper","treeId":"d8a71a6c5b2b7581","tags":["ability_enhancement","action_economy","biotech","crafting","equipment","healing","implant","melee","offense_melee","positioning","standard_action","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"strength-implant","name":"Strength Implant","label":"Strength Implant","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, give one adjacent willing living creature +1 weapon die of damage when it hits with melee attacks until the encounter ends.","notes":"Apply the extra melee weapon die manually to the recipient for the rest of the encounter.","resources":["Once per encounter","Encounter duration","Melee attacks only"],"requiredContext":["Adjacent willing living creature"],"targetHint":"One adjacent willing living creature"}],"phase18MedicalBiotechCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual action-economy card; no passive bonus is applied automatically."}},"summary":"Once per encounter as a standard action, you can give one adjacent living creature a strength implant.","source":"Legacy Era Campaign Guide","page":47},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.strength_implant","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.428Z","detectedPredicates":["attack.when-hit","attack.with-melee","turn.once-per-round"]}}}
{"_id":"cb3bbc1e7d8829e9","name":"Break Program","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Trained in Use Computer","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"usecomputer"}],"_source":"scavengers-guide-to-droids-p28"},"description":{"value":"You can use your ability to circumvent behavioral inhibitors to temporarily break the programming of a droid that you have a data link with. Make a Use Computer check opposed by the droid's Will Defense. Breaking the droid's programming overrides its behavioral inhibitors for a number of rounds equal to your Intelligence bonus."},"benefit":"You can use your ability to circumvent behavioral inhibitors to temporarily break the programming of a droid that you have a data link with. Make a Use Computer check opposed by the droid's Will Defense. Breaking the droid's programming overrides its behavioral inhibitors for a number of rounds equal to your Intelligence bonus.","class":"","category":"Droid","costNumeric":null,"treeId":"b968ecab63bc4cf4","talent_tree":"Elite Droid","source":"Scavenger's Guide to Droids","page":29,"tags":["droid","opposed_check","use_computer"],"executionModel":"ACTIVE","subType":"TALENT_ACTION","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"targeted_droid_behavioral_inhibitor_override","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"modifiers":[],"notes":"Requires a target Droid with a data link. Opposed Use Computer vs the target’s Will Defense; on success the override lasts a number of rounds equal to the user’s Intelligence bonus. It never disables behavioral inhibitors generally.","combatActions":[{"id":"break-program","name":"Break Program","label":"Break Program","actionType":"standard","requiredTalent":"Break Program","description":"You can circumvent the behavioral inhibitors of another Droid, temporarily breaking its programming. The target Droid must have a data link with you. Make a Use Computer check opposed by the target Droid's Will Defense. If your check succeeds, you override the target's behavioral inhibitors for a number of rounds equal to your Intelligence bonus.","resolutionMode":"manual","spendAction":true,"effects":[],"resources":["Data Link"],"notes":"Opposed Use Computer check against the target Droid’s Will Defense.","manualResolution":true,"relatedSkills":["useComputer"],"useLabel":"Use"}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"break-program-elite-droid-context","label":"Break Program","summary":"You can circumvent the behavioral inhibitors of another Droid, temporarily breaking its programming. The target Droid must have a data link with you. Make a Use Computer check opposed by the target Droid's Will Defense. If your check succeeds, you override the target's behavioral inhibitors for a number of rounds equal to your Intelligence bonus."}]},"summary":"You can use your ability to circumvent behavioral inhibitors to temporarily break the programming of a droid that you have a data link with."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"cb4984135c665c4b","name":"Twin Weapon Mastery","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Whenever you use the Twin Weapon Style talent, you can move 2 squares between each attack. This movement does not provoke attacks of opportunity.","description":{"value":"Whenever you use the Twin Weapon Style talent, you can move 2 squares between each attack. This movement does not provoke attacks of opportunity."},"class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"7db97c2c7ebca579","tags":["force","force_control","force_offense","light_side","mobility","positioning"],"executionModel":"ACTIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"twin-weapon-mastery","name":"Twin Weapon Mastery","label":"Twin Weapon Mastery","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Whenever you use the Twin Weapon Style Talent, you can move 2 squares between each attack. This movement does not provoke Attacks of Opportunity.","notes":"Whenever you use the Twin Weapon Style Talent, you can move 2 squares between each attack. This movement does not provoke Attacks of Opportunity.","relatedSkills":[],"resources":[],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[{"type":"TALENT_RULE","id":"twin_weapon_mastery","label":"Twin Weapon Mastery","summary":"Move 2 squares between Twin Weapon Style attacks without provoking attacks of opportunity.","action":"twin-weapon-style","mode":"between_attacks_movement","text":"Whenever you use the Twin Weapon Style Talent, you can move 2 squares between each attack. This movement does not provoke Attacks of Opportunity."}],"mechanicsMode":"action_or_contextual","applicationScope":"between_attacks_movement","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Je