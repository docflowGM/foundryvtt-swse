{"_id":"d1fd547124c1901c","name":"Force Persuasion","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Adept Negotiator.","benefit":"You can use your Use the Force modifier instead of your Persuasion check modifier when making a Persuasion check. You are considered Trained in the Persuasion skill. If you are entitled to a Persuasion check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations).","description":"You can use your Use the Force modifier instead of your Persuasion check modifier when making a Persuasion check. You are considered Trained in the Persuasion skill. If you are entitled to a Persuasion check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations).","class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.7acc479dee2d3b10","name":"Adept Negotiator"}],"_source":"canonical-csv"},"treeId":"e99cfa9db8493573","tags":["force","light_side","skills","social"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"force-persuasion","name":"Force Persuasion","label":"Force Persuasion","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"You can use your Use the Force modifier instead of your Persuasion check modifier when making a Persuasion check. You are considered Trained in the Persuasion skill. If you are entitled to a Persuasion check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations).","notes":"You can use your Use the Force modifier instead of your Persuasion check modifier when making a Persuasion check. You are considered Trained in the Persuasion skill. If you are entitled to a Persuasion check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations).","relatedSkills":[{"skill":"Use the Force"},{"skill":"Persuasion"}],"resources":["Use the Force check","Persuasion check"],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}},{"id":"force-persuasion-skill-substitution","name":"Force Persuasion","label":"Force Persuasion","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Use the Force can substitute for Persuasion when better, and Persuasion is treated as trained. The derived skill calculator now owns this instead of an embedded Active Effect.","notes":"Use the Force can substitute for Persuasion when better, and Persuasion is treated as trained. The derived skill calculator now owns this instead of an embedded Active Effect.","relatedSkills":[{"skill":"Use the Force"},{"skill":"Persuasion"}],"resources":["Persuasion trained","Use the Force substitution"],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[],"mechanicsMode":"derived_skill_substitution","applicationScope":"persuasion_skill_derivation","staticSheetPolicy":"derived_skill_only","requiresRuntimeContext":true,"manualResolution":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Jedi Consular","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":2,"removedLegacyModifierRows":1,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."},"skillSubstitutions":[{"from":"useTheForce","to":"persuasion","useIfBetter":true}]},"summary":"You can use your Use the Force modifier instead of your Persuasion check modifier when making a Persuasion check.","source":"Saga Edition Core Rulebook","page":40},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_persuasion","migratedToState":true,"m