{"_id":"6e3c1c77acfb0141","name":"Improved Jury-Rig","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can use the Jury-Rig application of the Mechanics Skill as a Standard Action instead of as a Full-Round Action. Additionally, you are not required to make a Skill Check to successfully Jury-Rig a device or Vehicle, and the device or Vehicle moves +3 steps on the Condition Track instead of +2.","description":{"value":"You can use the Jury-Rig application of the Mechanics Skill as a Standard Action instead of as a Full-Round Action. Additionally, you are not required to make a Skill Check to successfully Jury-Rig a device or Vehicle, and the device or Vehicle moves +3 steps on the Condition Track instead of +2."},"class":"db019dfbb271cdf6","costNumeric":null,"category":"Improviser","treeId":"7f37422819d7be6f","tags":["action_economy","control","equipment","jury_rig","mobility","pilot","standard_action","tech","vehicle"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"improved-jury-rig","name":"Improved Jury-Rig","label":"Improved Jury-Rig","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Use Jury-Rig as a Standard Action instead of a Full-Round Action, with no skill check required; the device or vehicle moves +3 steps on the condition track instead of +2.","notes":"Use Jury-Rig as a Standard Action instead of a Full-Round Action, with no skill check required; the device or vehicle moves +3 steps on the condition track instead of +2.","relatedSkills":[{"skill":"Mechanics","when":"Jury-Rig"}],"resources":[],"requiredContext":[],"targetHint":"Device or vehicle"}],"phase17TechEngineeringCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual action-economy card. Automation can be added later without inventing passive bonuses."}},"summary":"You can use the Jury-Rig application of the Mechanics Skill as a Standard Action instead of as a Full-Round Action.","source":"Rebellion Era Campaign Guide","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_jury_rig","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":[]}}}
{"_id":"6ea04b7286133846","name":"Sniping Assassin","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When you make a ranged attack against a target that is not at point blank range, you add half your class level to your damage roll.","description":{"value":"When you make a ranged attack against a target that is not at point blank range, you add half your class level to your damage roll."},"class":"74fa04f5afb5f6e1","costNumeric":null,"category":"Assassin","treeId":"186daeee7bd65a69","tags":["action_economy","armor","mobility","offense_ranged","positioning","precision_damage","ranged","sniper","stealth","pursuit"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Future CombatOptionResolver / action-card / reaction prompt / damage-resolution hook","notes":"Reviewed in T12. Removed legacy static/passive modifier data; this talent is a real combat mechanic but needs runtime context and should not mutate permanent sheet totals.","combatActions":[{"id":"sniping-assassin-t31-reference","name":"Sniping Assassin","label":"Sniping Assassin","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"When you make a ranged attack against a target that is not at Point-Blank Range, you add half your Class Level to your damage roll.","notes":"When you make a ranged attack against a target that is not at Point-Blank Range, you add half your Class Level to your damage roll.","relatedSkills":[],"resources":["Target context"],"requiredContext":["Valid target confirmed"],"targetHint":"GM/player adjudicated target or context","spendAction":false,"ruleData":{}}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"sniping-assassin-t31-context","label":"Sniping Assassin","summary":"When you make a ranged attack against a target that is not at Point-Blank Range, you add half your Class Level to your damage roll."}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Assassin","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."}},"summary":"When you make a ranged attack against a target that is not at point blank range, you add half your class level to your damage roll.","source":"Scum and Villainy","page":29},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.sniping_assassin","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":["defense.reflex","attack.with-ranged","turn.once-per-round"]}}}
{"_id":"6ecfeff647f8764e","name":"Inspire Loyalty","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You gain a single Follower. Choose either the aggressive, defensive, or utility Follower Template for your follower, generating the follower's statistics based on the rules found in the Followers section. This Follower gains one Armor Proficiency Feat of your choice and becomes Trained in the Perception skill. The Follower must meet the prerequisites for the Armor Proficiency Feat you select.\n\nYou can select this Talent multiple times. Each time you do, you gain one additional Follower (maximum of 3 Followers).","description":{"value":"You gain a single Follower. Choose either the aggressive, defensive, or utility Follower Template for your follower, generating the follower's statistics based on the rules found in the Followers section. This Follower gains one Armor Proficiency Feat of your choice and becomes Trained in the Perception skill. The Follower must meet the prerequisites for the Armor Proficiency Feat you select.\n\nYou can select this Talent multiple times. Each time you do, you gain one additional Follower (maximum of 3 Followers)."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","treeId":"be2e649cbb7332fa","tags":["action_economy","force","force_control","force_defense","force_offense","melee","mobility","positioning","ranged","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action_reference","applicationScope":"martial_protector_arena_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"FOLLOWER_TALENT_CONFIG + follower-hooks + FollowerCreator/MinionCreator","notes":"This talent grants a dependent actor slot. The follower/minion subsystem already owns slot creation; passive modifiers would be wrong.","combatActions":[{"id":"inspire-loyalty-t30-reference","name":"Inspire Loyalty","label":"Inspire Loyalty","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"You gain a single Follower. Choose either the aggressive, defensive, or utility Follower Template for your follower, generating the follower's statistics based on the rules found in the Followers section. This Follower gains one Armor Proficiency Feat of your choice and becomes Trained in the Perception skill. The Follower must meet the prerequisites for the Armor Proficiency Feat you select.","notes":"You gain a single Follower. Choose either the aggressive, defensive, or utility Follower Template for your follower, generating the follower's statistics based on the rules found in the Followers section. This Follower gains one Armor Proficiency Feat of your choice and becomes Trained in the Perception skill. The Follower must meet the prerequisites for the Armor Proficiency Feat you select.","relatedSkills":[],"resources":["Follower context"],"requiredContext":["Follower workflow/ownership confirmed"],"targetHint":"GM/player adjudicated target or context","spendAction":false,"ruleData":{}}],"rules":[],"manualResolution":true,"phase30MartialProtectorArenaCleanup":{"phase":"T30","tree":"Loyal Protector","status":"reviewed_manual_or_runtime_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"T30 removed unsafe passive rows from martial/protector/arena/species leftovers and surfaced action, reaction, recovery, cover, and attack-rider context as truthful cards/rules."}},"summary":"You gain a single Follower.","source":"Clone Wars Campaign Guide","page":23},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_loyalty","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":["defense.against-ranged","defense.against-melee","attack.with-melee","attack.with-ranged","proximity.ally-nearby","turn.on-current-turn","turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"implemented_follower_slot_owner","owner":"FOLLOWER_TALENT_CONFIG + follower-hooks + FollowerCreator/MinionCreator","note":"This talent grants a dependent actor slot. The follower/minion subsystem already owns slot creation; passive modifiers would be wrong."}}}}
{"_id":"6ef0900cd62869e7","name":"Surprising Weapons","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Whenever you successfully hit an enemy with an amphistaff, thud bug, or razor bug, and your attack roll also exceeds the target's Will Defense, that target is considered flat-footed against you until the end of your next turn.","description":{"value":"Whenever you successfully hit an enemy with an amphistaff, thud bug, or razor bug, and your attack roll also exceeds the target's Will Defense, that target is considered flat-footed against you until the end of your next turn."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","treeId":"33c3210fcac8c664","tags":["biotech","melee","ranged","will_defense","precision","control","setup"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase18MedicalBiotechCleanup":{"status":"cleaned_future_runtime_context","owner":"future_post_hit_target_state_resolver","notes":"Requires comparing a qualifying attack roll against target Will Defense before applying flat-footed state."}},"summary":"Whenever you successfully hit an enemy with an amphistaff, thud bug, or razor bug, and your attack roll also exceeds the target's Will Defense, that target is considered flat-footed against you until the end of your next turn.","source":"Legacy Era Campaign Guide","page":29},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.surprising_weapons","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":["defense.will"]}}}
{"_id":"6ef413a824474491","name":"Target Acquisition","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"Once per encounter, as a swift action, designate an enemy target within line of sight as an acquired target. You gain a +1 circumstance bonus to attack rolls and damage rolls for all attacks against that target until the end of the encounter, as long as the target remains within your line of sight."},"benefit":"Once per encounter, as a swift action, designate an enemy target within line of sight as an acquired target. You gain a +1 circumstance bonus to attack rolls and damage rolls for all attacks against that target until the end of the encounter, as long as the target remains within your line of sight.","class":"","category":"","costNumeric":null,"treeId":"73814706c00849c6","tags":["action_economy","condition_removal","perception","ranged","reaction","setup","skills","stealth","support","targeting"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"target-acquisition-designate","name":"Target Acquisition: Designate Target","label":"Target Acquisition: Designate Target","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, designate an enemy target within line of sight as an acquired target. Toggle the Target Acquisition attack option on attacks against that target while line of sight remains.","notes":"The attack/damage bonus is contextual to the acquired target and line of sight. The attack option is exposed so the player can opt in only when the target is valid.","relatedSkills":[{"skill":"Attack Roll"}],"resources":["Once per encounter","Acquired target","+1 attack and damage vs target"],"targetHint":"One enemy in line of sight"}],"rules":[{"type":"ATTACK_OPTION","id":"target-acquisition","label":"Target Acquisition","control":"flag","attackModifier":1,"damageModifier":1,"summary":"Toggle only when attacking the acquired target while it remains in line of sight."}],"phase19DroidCleanup":{"status":"contextual_attack_option_and_action_card","owner":"CombatOptionResolver + AbilityCombatActionResolver","tree":"4thdegree Droid","notes":"Swift designation card plus opt-in attack option for valid acquired-target attacks.","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0}},"summary":"Once per encounter, as a swift action, designate an enemy target within line of sight as an acquired target.","source":"Scavenger's Guide to Droids","page":27},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":["turn.once-per-round"]}}}
{"_id":"6f6cd1c453dc1828","name":"Concentrate All Fire","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":null,"benefit":"When you use the aid another action to aid an ally's attack roll with a vehicle weapon, if the attack hits, it deals +1 die of damage. Any ally can only benefit from this talent once per attack roll regardless of how many allies with this talent aid on the attack.","description":"When you use the aid another action to aid an ally's attack roll with a vehicle weapon, if the attack hits, it deals +1 die of damage. Any ally can only benefit from this talent once per attack roll regardless of how many allies with this talent aid on the attack.","class":"9c9989c34714f920","costNumeric":null,"category":"Ace Pilot","treeId":"5f355ad4093d2bf8","tags":["support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"concentrate-all-fire","name":"Concentrate All Fire","label":"Concentrate All Fire","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"When aiding another vehicle attack, the aided attack deals +1 die of damage on a hit. A given ally can benefit only once per attack.","notes":"When aiding another vehicle attack, the aided attack deals +1 die of damage on a hit. A given ally can benefit only once per attack.","resources":["Aid another","Vehicle attack"]}],"phase16VehicleStarshipCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual combat action card in the action economy UI."}},"summary":"When your Aid Another helps an ally's vehicle-weapon attack hit, that attack deals +1 damage die; only one such bonus applies.","source":"Rebellion Era Campaign Guide","page":40},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.concentrate_all_fire","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":[]}}}
{"_id":"6f7fa0ea2ad38e50","name":"Mask Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Iron Knight","talentTree":"Iron Knight","tree":"Iron Knight","treeId":"a7dc5adf97fd6a67","prerequisites":"","description":{"value":"As a swift action, you become immune to the Sense Force application of the Use the Force skill, and appear to be nothing more than a regular droid in the Force. If you make a Use the Force check or use any Force power or Force talent, this effect immediately ends."},"benefit":"As a swift action, you become immune to the Sense Force application of the Use the Force skill, and appear to be nothing more than a regular droid in the Force. If you make a Use the Force check or use any Force power or Force talent, this effect immediately ends.","class":"","category":"","costNumeric":null,"source":"Jedi Academy Training Manual","tags":["force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"mask-presence","name":"Mask Presence","label":"Mask Presence","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Swift Action, you become immune to the Sense Force application of the Use the Force skill, and appear to be nothing more than a regular Droid in The Force. If you make a Use the Force check or use any Force Power or Force Talent, this effect immediately ends.","notes":"As a Swift Action, you become immune to the Sense Force application of the Use the Force skill, and appear to be nothing more than a regular Droid in The Force. If you make a Use the Force check or use any Force Power or Force Talent, this effect immediately ends.","relatedSkills":[{"skill":"Use the Force"}],"resources":[],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Iron Knight","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"As a swift action, you become immune to the Sense Force application of the Use the Force skill, and appear to be nothing more than a regular droid in the Force.","page":79},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"sourcePatch":"force-tradition-and-jedi-guardian-membership","forceTalentCleanup":{"phase":"T22","tree":"Iron Knight","status":"combat_action_card"}}}}
{"_id":"6fdbdd17eba93006","name":"Ultra Resilient","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"You have advanced subroutines that make you more resistant to the effect of damage. Once per encounter, as a reaction, you can increase your damage threshold with a bonus equal to your Independent Droid level."},"benefit":"You have advanced subroutines that make you more resistant to the effect of damage. Once per encounter, as a reaction, you can increase your damage threshold with a bonus equal to your Independent Droid level.","class":"","category":"Droid","costNumeric":null,"treeId":"b968ecab63bc4cf4","talent_tree":"Elite Droid","source":"Scavenger's Guide to Droids","page":29,"tags":["damage_threshold","droid","once-per-encounter","reaction","survivability"],"executionModel":"ACTIVE","subType":"TALENT_ACTION","abilityMeta":{"mechanicsMode":"active_reaction","applicationScope":"encounter_limited_damage_threshold_bonus","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"usesPerEncounter":1,"modifiers":[],"notes":"Reaction, once per encounter. Raises Damage Threshold by the actor’s Independent Droid level for that damage resolution only; it never raises the sheet’s standing Damage Threshold.","combatActions":[{"id":"ultra-resilient","name":"Ultra Resilient","label":"Ultra Resilient","actionType":"reaction","cost":1,"requiredTalent":"Ultra Resilient","description":"Once per encounter, as a Reaction, you can increase your Damage Threshold by a bonus equal to your Independent Droid level.","resolutionMode":"manual","spendAction":true,"effects":[],"notes":"Temporary Damage Threshold bonus equal to Independent Droid level.","manualResolution":true,"useLabel":"Use"}],"temporaryBonus":{"target":"damageThreshold","formula":"independentDroidLevel","duration":"reaction","usesPerEncounter":1},"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"ultra-resilient-elite-droid-context","label":"Ultra Resilient","summary":"Once per encounter, as a Reaction, you can increase your Damage Threshold by a bonus equal to your Independent Droid level."}]},"summary":"You have advanced subroutines that make you more resistant to the effect of damage."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"6fe17dc4f0f03c12","name":"Lightsaber Specialist","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Masterwork Lightsaber","benefit":"Whenever you are armed with a lightsaber that you built, you gain a +2 morale bonus on Use the Force checks made to use the Block and Deflect talents.","description":{"value":"Whenever you are armed with a lightsaber that you built, you gain a +2 morale bonus on Use the Force checks made to use the Block and Deflect talents."},"class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"76ecaa09bb7619cb","tags":["force","light_side","lightsaber","melee"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"conditional_or_metadata","applicationScope":"built_lightsaber_block_deflect_bonus","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true,"engineOwner":"Block-Deflect flow / lightsaber construction context","conditionSummary":"Gain +2 morale bonus on Use the Force checks to Block and Deflect with a lightsaber you built.","recommendedAction":"Needs self-built lightsaber context in Block/Deflect prompts; no generic action flag.","modifiers":[],"status":"talent_backcheck_user_text_2026_06_11","description":"Gain +2 morale bonus on Use the Force checks to Block and Deflect with a lightsaber you built.","requiresSelectedChoice":false,"metadataPhase":"jedi-prestige-talent-backcheck","metadataNotes":"Updated from user-provided source text; non-automatable targeting/LOS/session adjudication remains GM/player confirmed.","rules":[{"type":"TALENT_RULE","id":"lightsaber_specialist","label":"Lightsaber Specialist","summary":"Gain +2 morale bonus on Use the Force checks to Block and Deflect with a lightsaber you built.","action":"block-deflect-reaction","mode":"built_lightsaber_block_deflect_bonus","text":"Whenever you are armed with a Lightsaber that you built, you gain a +2 morale bonus on Use the Force checks made to use the Block and Deflect Talents."}]},"effect":"Whenever you are armed with a Lightsaber that you built, you gain a +2 morale bonus on Use the Force checks made to use the Block and Deflect Talents.","shortSummary":"Gain +2 morale bonus on Use the Force checks to Block and Deflect with a lightsaber you built.","prerequisite":"Masterwork Lightsaber","prerequisitesText":"Masterwork Lightsaber","grantsActions":[],"summary":"Whenever you are armed with a lightsaber that you built, you gain a +2 morale bonus on Use the Force checks made to use the Block and Deflect talents.","source":"Jedi Academy Training Manual","page":19},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.lightsaber_specialist","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":[],"talentBackcheck":{"source":"user-pasted-rules","date":"2026-06-11","updatedFields":["system.description","system.benefit","system.effect","system.shortSummary","system.prerequisite","system.abilityMeta"]}}}}
{"_id":"700ec3d782794d11","name":"Field Detection","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Trained in Use the Force","description":"As a swift action, make a DC 15 Use the Force check. If tne check succeeds, you can detect the presence, general strength, and origin (or direction of origin if the source is out of range) of electromagnetic and energy fields within 12 squares of you. You can also determine the type of field, allowing you to detect communications devices, sensors, and other electronic equipment. When dealing damage to a person or droid using a personal shield, or to a vehicle with shields active, a successful check allows you to detect minute fluctuations in the shield, reducing their SR by -5 against your attacks until the end of your turn.","benefit":"As a swift action, make a DC 15 Use the Force check. If tne check succeeds, you can detect the presence, general strength, and origin (or direction of origin if the source is out of range) of electromagnetic and energy fields within 12 squares of you. You can also determine the type of field, allowing you to detect communications devices, sensors, and other electronic equipment. When dealing damage to a person or droid using a personal shield, or to a vehicle with shields active, a successful check allows you to detect minute fluctuations in the shield, reducing their SR by -5 against your attacks until the end of your turn.","class":"","category":"","costNumeric":null,"treeId":"e6e3fc102bb54b20","tags":["action_economy","detection","force","force_capacity","force_defense","force_offense","force_point_spend","force_power_synergy","perception","positioning","resource_spend","sensors","skills","use_the_force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"combat_action_or_force_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"modifiers":[],"combatActions":[{"id":"field-detection","name":"Field Detection","label":"Field Detection","actionType":"free","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Farseeing You are a Master of Luka Sene techniques and an expert in using sense-related Talents and Force Powers. Once per encounter, you gain a temporary Force Point that you must spend when activating a Talent from either the Sense Talent Tree or Luka Sene Talent Tree, when using the Farseeing Force Power, or on a Use the Force check made to use the Search Your Feelings or Sense Force applications of the skill. The Force Point is lost if not used before the end of the encounter. As a Free Action on your turn, you can make a Use the Force check against a living creature within 12 squares, removing one use of the Farseeing Force Power from your active Force Power Suite (as though you had activated the Force Power). If your check result equals or exceeds the Will Defense of the target, you gain a +2 insight bonus on attack rolls against that target until the end of your turn. This counts as using the Farseeing Force Power against that target, but this Talent replaces the normal rules and effects of that Force Power.","notes":"Farseeing You are a Master of Luka Sene techniques and an expert in using sense-related Talents and Force Powers. Once per encounter, you gain a temporary Force Point that you must spend when activating a Talent from either the Sense Talent Tree or Luka Sene Talent Tree, when using the Farseeing Force Power, or on a Use the Force check made to use the Search Your Feelings or Sense Force applications of the skill. The Force Point is lost if not used before the end of the encounter. As a Free Action on your turn, you can make a Use the Force check against a living creature within 12 squares, removing one use of the Farseeing Force Power from your active Force Power Suite (as though you had activated the Force Power). If your check result equals or exceeds the Will Defense of the target, you gain a +2 insight bonus on attack rolls against that target until the end of your turn. This counts as using the Farseeing Force Power against that target, but this Talent replaces the normal rules and effects of that Force Power.","relatedSkills":[{"skill":"Use the Force"},{"skill":"Perception"},{"skill":"Attack Roll"}],"resources":["Force Point context","Once per encounter","Force Power Suite context"],"requiredContext":["Target context confirmed"],"targetHint":"GM/player adjudicated target or affected creature(s)","spendAction":true,"ruleData":{}}],"rules":[],"notes":"T28 removed unsafe migrated modifier/effect data. This talent depends on Force-suite, target, equipment, ally, encounter, or table-position context and is surfaced as a truthful manual/runtime card rather than a passive actor mutation.","phase28ForceMicrotraditionCleanup":{"phase":"T28","tree":"Luka Sene","status":"reviewed_contextual_or_manual_card","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Force/special-tradition microtree cleanup. Unsafe always-on rows were removed; final bonuses/effects require player/GM or future dedicated runtime owner."}},"summary":"As a swift action, make a DC 15 Use the Force check.","source":"Knights of the Old Republic Campaign Guide","page":60},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":["defense.will","turn.on-current-turn","turn.once-per-round"]}}}
{"_id":"705f100f5703e707","name":"Improved Lightsaber Throw","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Lightsaber Throw","benefit":"You can spend a Force Point as a standard action to throw your lightsaber at a group of opponents. You make a single ranged attack roll (treating the lightsaber as a thrown weapon) and compare the result to the Reflex Defense of all targets in a 6-square line originating in your square. If your attack roll result exceeds a target’s Reflex Defense, you deal normal lightsaber damage to that target (dealing half damage if you fail to exceed the target’s Reflex Defense). This attack is considered an area attack. You can pull your lightsaber back to your hand as a swift action by making a DC 20 Use the Force check.","description":"You can spend a Force Point as a standard action to throw your lightsaber at a group of opponents. You make a single ranged attack roll (treating the lightsaber as a thrown weapon) and compare the result to the Reflex Defense of all targets in a 6-square line originating in your square. If your attack roll result exceeds a target’s Reflex Defense, you deal normal lightsaber damage to that target (dealing half damage if you fail to exceed the target’s Reflex Defense). This attack is considered an area attack. You can pull your lightsaber back to your hand as a swift action by making a DC 20 Use the Force check.","class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"b3c5d90b5036f39b","tags":["force","force_control","light_side","lightsaber","melee","mobility","ranged","support","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"active_force_point_thrown_lightsaber_area_attack","applicationScope":"standard_action_area_attack","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":false,"actionType":"standard","spendsForcePoint":1,"areaAttack":true},"summary":"You can spend a Force Point as a standard action to throw your lightsaber at a group of opponents.","source":"Force Unleashed Campaign Guide","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_lightsaber_throw","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":[]}}}
{"_id":"708a47d1be414990","name":"Illusion","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Mind trick","description":"As a standard action, you can spend a Force Point to create an illusion that seems perfectly real to anyone who views it. You designate the form and complexity of the illusion, as well as its size and location, and make a Use the Force check. When a creature views the illusion, compare the result of your Use the Force check to the creature's Will Defense; if your check result exceeds its Will Defense, it believes the illusion to be real. Any physical interaction with the illusion (such as touching it, passing through it, or shooting it with a blaster) immediately reveals the true nature of the illusion, and the creature is no longer deceived. The illusion lasts for a number of minutes equal to your heroic level. The illusion's size also affects your Use the Force check, applying a penalty for exceptionally large illusions. The penalties are -1 for Huge illusions, -2 for Gargantuan illusions, -5 for Colossal illusions, and -10 for Colossal (Frigate) or larger illusions. This is a mind-affecting effect.","benefit":"As a standard action, you can spend a Force Point to create an illusion that seems perfectly real to anyone who views it. You designate the form and complexity of the illusion, as well as its size and location, and make a Use the Force check. When a creature views the illusion, compare the result of your Use the Force check to the creature's Will Defense; if your check result exceeds its Will Defense, it believes the illusion to be real. Any physical interaction with the illusion (such as touching it, passing through it, or shooting it with a blaster) immediately reveals the true nature of the illusion, and the creature is no longer deceived. The illusion lasts for a number of minutes equal to your heroic level. The illusion's size also affects your Use the Force check, applying a penalty for exceptionally large illusions. The penalties are -1 for Huge illusions, -2 for Gargantuan illusions, -5 for Colossal illusions, and -10 for Colossal (Frigate) or larger illusions. This is a mind-affecting effect.","class":"","category":"","costNumeric":null,"treeId":"6ac3416fb6aada56","tags":["deception","force","illusion","light_side","skill_substitution","support","telekinesis","telepathy","use_the_force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"manual_or_runtime","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Alter","status":"cleaned_manual_or_future_runtime","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"As a standard action, you can spend a Force Point to create an illusion that seems perfectly real to anyone who views it.","source":"Force Unleashed Campaign Guide","page":87},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":[],"forceTalentCleanup":{"phase":"T22","tree":"Alter","status":"cleaned_manual_or_future_runtime"},"id":"swse.talent.illusion","illusionCanonicalized":"2026-06-12"}}}
{"_id":"70a06f3be4e9c216","name":"Small Target","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When you are the pilot of a Colossal or smaller vehicle, capital ship weapons that take a -20 penalty on attack rolls against your vehicle, such as turbolasers, do not automatically score a critical hit on your vehicle on a natural 20. The attack is only a critical hit if the total attack roll (20 + the weapon's attack bonus) would normally hit your vehicle. Otherwise, the attack deals normal damage.","description":{"value":"When you are the pilot of a Colossal or smaller vehicle, capital ship weapons that take a -20 penalty on attack rolls against your vehicle, such as turbolasers, do not automatically score a critical hit on your vehicle on a natural 20. The attack is only a critical hit if the total attack roll (20 + the weapon's attack bonus) would normally hit your vehicle. Otherwise, the attack deals normal damage."},"class":"9c9989c34714f920","costNumeric":null,"category":"Ace Pilot","treeId":"296772ab8e69c9ef","tags":["precision"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase16VehicleStarshipCleanup":{"status":"metadata_or_gm_player_managed","owner":"GM/player or future vehicle subsystem","notes":"No truthful automatic runtime owner in this pass; stale migrated modifiers/effects removed if present."}},"summary":"When you are the pilot of a Colossal or smaller vehicle, capital ship weapons that take a -20 penalty on attack rolls against your vehicle, such as turbolasers, do not automatically score a critical hit on your vehicle on a natural 20.","source":"Scum and Villainy","page":25},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.small_target","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":[]}}}
