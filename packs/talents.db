{"_id":"463ae052e705eaf3","name":"Wrong Decision","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Each time you are attacked, the opponent that attacked you takes a -2 morale penalty to its Will Defense until the end of your next turn. This penalty is not cumulative, so if a target makes multiple attacks against you it only incurs the penalty once per turn.","description":{"value":"Each time you are attacked, the opponent that attacked you takes a -2 morale penalty to its Will Defense until the end of your next turn. This penalty is not cumulative, so if a target makes multiple attacks against you it only incurs the penalty once per turn."},"class":"fc815ae3ca4bf726","costNumeric":null,"category":"Corporate Agent","treeId":"45c4007d09c01839","tags":["control","deception","persuasion","social"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed target context","notes":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists.","combatActions":[{"id":"wrong-decision","name":"Wrong Decision","label":"Wrong Decision","actionType":"free","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Each time you are attacked, the attacker takes a -2 morale penalty to Will Defense until the end of your next turn. This penalty is not cumulative.","notes":"Each time you are attacked, the attacker takes a -2 morale penalty to Will Defense until the end of your next turn. This penalty is not cumulative.","relatedSkills":[],"resources":["Automatic trigger when attacked","Morale penalty"],"requiredContext":[],"targetHint":"Attacker","spendAction":true,"ruleData":{}}],"manualResolution":true,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Corporate Power","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"Each time you are attacked, the opponent that attacked you takes a -2 morale penalty to its Will Defense until the end of your next turn.","source":"Knights of the Old Republic Campaign Guide","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.wrong_decision","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.411Z","detectedPredicates":["defense.will"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"GM/player managed target context","note":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists."}}}}
{"_id":"467accea4a3c8cbd","name":"Sense Deception","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Whenever someone makes a Deception or Persuasion skill check against your Will Defense, you can make a Use the Force check, replacing your Will Defense with the result of your Use the Force check if it is higher.","description":{"value":"Whenever someone makes a Deception or Persuasion skill check against your Will Defense, you can make a Use the Force check, replacing your Will Defense with the result of your Use the Force check if it is higher."},"class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"44554c28675292b6","tags":["action_economy","force","light_side","skills"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[{"target":"attack","value":0,"type":"untyped","predicates":[],"enabled":false,"priority":500,"description":"[REQUIRES MANUAL MAPPING] Sense Deception"}],"status":"talent_backcheck_user_text_2026_06_11","description":"Use a Use the Force check in place of Will Defense against Deception or Persuasion if higher.","mechanicsMode":"conditional_or_metadata","applicationScope":"will_defense_replacement","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"conditionSummary":"Use a Use the Force check in place of Will Defense against Deception or Persuasion if higher.","metadataPhase":"jedi-prestige-talent-backcheck","metadataNotes":"Updated from user-provided source text; non-automatable targeting/LOS/session adjudication remains GM/player confirmed.","rules":[{"type":"TALENT_RULE","id":"sense_deception","label":"Sense Deception","summary":"Use a Use the Force check in place of Will Defense against Deception or Persuasion if higher.","action":"use-the-force-check","mode":"will_defense_replacement","text":"Whenever someone makes a Deception or Persuasion Skill Check against your Will Defense, you can make a Use the Force check, repla