{"_id":"8488911915ea094d","name":"Respected Officer","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You have a reputation that causes allies and enemies to treat you with respect. You automatically improve the attitude of an indifferent character to friendly with no check required (see “Persuasion,” page 71 of the Saga Edition core rulebook).","description":{"value":"You have a reputation that causes allies and enemies to treat you with respect. You automatically improve the attitude of an indifferent character to friendly with no check required (see “Persuasion,” page 71 of the Saga Edition core rulebook)."},"class":"61876f91a1633cdf","costNumeric":null,"category":"Enforcer","treeId":"2d164f62e17bed8c","tags":["control","force","nonlethal","pursuit","scaling","support","vehicle"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","manualResolution":true,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","combatActions":[{"id":"respected-officer-t31-reference","name":"Respected Officer","label":"Respected Officer","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"You have a reputation that causes allies and opponents to treat you with respect. You automatically improve the Attitude of an Indifferent character to Friendly with no check required.","notes":"You have a reputation that causes allies and opponents to treat you with respect. You automatically improve the Attitude of an Indifferent character to Friendly with no check required.","relatedS