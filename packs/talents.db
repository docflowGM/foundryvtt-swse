{"_id":"d587fb91aedddd09","name":"Slashing Charge","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Block, Riposte, Weapon Focus (lightsabers), Weapon Proficiency (lightsabers)","benefit":"Once per encounter, while making a charge, you take no cumulative penalty to Use the Force checks for each Block attempt you make during the charge. When performing slashing charge, you can apply the attack bonus granted by the charge to all Riposte attacks as well. You can declare the use of this ability after you begin the charge but before you make your first Riposte attack.","description":{"value":"Once per encounter, while making a charge, you take no cumulative penalty to Use the Force checks for each Block attempt you make during the charge. When performing slashing charge, you can apply the attack bonus granted by the charge to all Riposte attacks as well. You can declare the use of this ability after you begin the charge but before you make your first Riposte attack."},"class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"dfc4142435b4356d","tags":["force","light_side","lightsaber","melee","mobility"],"executionModel":"ACTIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"action_or_contextual","applicationScope":"encounter_charge_riposte_option","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true,"engineOwner":"CombatOptionResolver / Block-Deflect flow","conditionSummary":"Once per encounter during a Charge, no cumulative Block penalties and Charge bonus applies to Ripostes.","recommendedAction":"Expose as a charge/Block/Riposte runtime option when those systems carry the needed state.","modifiers":[],"status":"talent_backcheck_user_text_2026_06_11","description":"Once per encounter during a Charge, no cumulative Block penalties and Charge bonus applies to Ripostes.","requiresSelectedChoice":false,"metadataPhase":"jedi-prestige-talent-backcheck","metadataNotes":"Updated from user-provided source text; non-automatable targeting/LOS/session adjudication remains GM/player confirmed.","rules":[{"type":"TALENT_RULE","id":"slashing_charge","label":"Slashing Charge","summary":"Once per encounter during a Charge, no cumulative Block penalties and Charge bonus applies to Ripostes.","action":"charge","mode":"encounter_charge_riposte_option","text":"Once per encounter, while making a Charge, you take no cumulative penalty to Use the Force checks for each Block attempt you make during the Charge. When performing Slashing Charge, you can apply the attack bonus granted by the Charge to all Riposte attacks as well. You can declare the use of this ability after you begin the Charge, but must do so before you make your first Riposte attack."}]},"effect":"Once per encounter, while making a Charge, you take no cumulative penalty to Use the Force checks for each Block attempt you make during the Charge. When performing Slashing Charge, you can apply the attack bonus granted by the Charge to all Riposte attacks as well. You can declare the use of this ability after you begin the Charge, but must do so before you make your first Riposte attack.","shortSummary":"Once per encounter during a Charge, no cumulative Block penalties and Charge bonus applies to Ripostes.","prerequisite":"Block, Riposte, Weapon Focus (Lightsabers)","prerequisitesText":"Block, Riposte, Weapon Focus (Lightsabers)","grantsActions":["charge"],"summary":"Once per encounter, while making a charge, you take no cumulative penalty to Use the Force checks for each Block attempt you make during the charge.","source":"Knights of the Old Republic Campaign Guide","page":39},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.slashing_charge","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":["turn.once-per-round"],"talentBackcheck":{"source":"user-pasted-rules","date":"2026-06-11","updatedFields":["system.description","system.benefit","system.effect","system.shortSummary","system.prerequisite","system.abilityMeta"]}}}}
{"_id":"d61e3a2afe8ab339","name":"Target Visions","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Findsman Ceremonies","benefit":"You have visions that tell you what your enemies are likely to do even before they do it. Once per encounter, when an enemy creature moves within 6 squares of you, you may make a melee or ranged attack against that target as a reaction to their movement.","description":{"value":"You have visions that tell you what your enemies are likely to do even before they do it. Once per encounter, when an enemy creature moves within 6 squares of you, you may make a melee or ranged attack against that target as a reaction to their movement."},"class":"336bba6d1e517c92","costNumeric":null,"category":"Bounty Hunter","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.661c2c0665e911f6","name":"Findsman Ceremonies"}],"_source":"canonical-csv"},"treeId":"022b31d355c840a9","tags":["action_economy","mobility","positioning","force","visions","perception","reaction"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","manualResolution":true,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","combatActions":[{"id":"target-visions-t31-reference","name":"Target Visions","label":"Target Visions","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"You have visions that tell you what your enemies are likely to do even before they do it. Once per encounter, when an enemy creature moves within 6 squares of you, you may make a melee or ranged attack against that target as a Reaction to their movement.","notes":"You have visions that tell you what your enemies are likely to do even before they do it. Once per encounter, when an enemy creature moves within 6 squares of you, you may make a melee or ranged attack against that target as a Reaction to their movement.","relatedSkills":[],"resources":["Once per encounter","Enemy/target context","Target context"],"requiredContext":["Triggering event confirmed","Valid target confirmed","Range/square distance confirmed"],"targetHint":"GM/player adjudicated target or context","spendAction":true,"ruleData":{}}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"target-visions-t31-context","label":"Target Visions","summary":"You have visions that tell you what your enemies are likely to do even before they do it. Once per encounter, when an enemy creature moves within 6 squares of you, you may make a melee or ranged attack against that target as a Reaction to their movement."}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Gand Findsman","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."}},"summary":"You have visions that tell you what your enemies are likely to do even before they do it.","source":"Scum and Villainy","page":26},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.target_visions","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":["turn.once-per-round"]}}}
{"_id":"d68318a928d3d5c7","name":"Leading Feint","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Noble Fencing Style","benefit":"Whenever you successfully damage an opponent with a melee attack, you can make a Deception check to feint against that target as a swift action. If successful, you designate an ally within 12 squares; your target is treated as flat-footed against the first attack that ally makes against your target before the beginning of your next turn.","description":{"value":"Whenever you successfully damage an opponent with a melee attack, you can make a Deception check to feint against that target as a swift action. If successful, you designate an ally within 12 squares; your target is treated as flat-footed against the first attack that ally makes against your target before the beginning of your next turn."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.00c3231e4a4173fa","name":"Noble Fencing Style"}],"_source":"canonical-csv"},"treeId":"9df067790c87e6bc","tags":["positioning","skills","social","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action_reference","applicationScope":"martial_protector_arena_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"leading-feint-t30-reference","name":"Leading Feint","label":"Leading Feint","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Whenever you successfully damage an opponent with a melee attack, you can make a Deception check to Feint against that target as a Swift Action. If successful, you designate an ally within 12 squares; your target is designated Flat-Footed against the first attack that ally makes against your target before the beginning of your next turn.","notes":"Whenever you successfully damage an opponent with a melee attack, you can make a Deception check to Feint against that target as a Swift Action. If successful, you designate an ally within 12 squares; your target is designated Flat-Footed against the first attack that ally makes against your target before the beginning of your next turn.","relatedSkills":[],"resources":["Ally context"],"requiredContext":["Triggering attack/damage result confirmed","Swift action available"],"targetHint":"GM/player adjudicated target or context","spendAction":true,"ruleData":{}}],"rules":[],"manualResolution":true,"phase30MartialProtectorArenaCleanup":{"phase":"T30","tree":"Fencing","status":"reviewed_manual_or_runtime_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"T30 removed unsafe passive rows from martial/protector/arena/species leftovers and surfaced action, reaction, recovery, cover, and attack-rider context as truthful cards/rules."}},"summary":"Whenever you successfully damage an opponent with a melee attack, you can make a Deception check to feint against that target as a swift action.","source":"Knights of the Old Republic Campaign Guide","page":26},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.leading_feint","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":[],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Follower/dependent-actor subsystem or GM/player managed","note":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals."}}}}
{"_id":"d6a04668587e2c03","name":"Improved Battle Meditation","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Battle Meditation","benefit":"You may activate your Battle Meditation talent as a swift action instead of as a full-round action. The range of the Battle Meditation extends out to 12 squares. Enemies within the radius of your Battle Meditation suffer a -1 penalty to all attack rolls.","description":{"value":"You may activate your Battle Meditation talent as a swift action instead of as a full-round action. The range of the Battle Meditation extends out to 12 squares. Enemies within the radius of your Battle Meditation suffer a -1 penalty to all attack rolls."},"class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.9461c7aa79dd07c6","name":"Battle Meditation"}],"_source":"canonical-csv"},"treeId":"10c843cef8ce2798","tags":["action_economy","force","force_offense","light_side","mobility","positioning"],"executionModel":"ACTIVE","subType":"ACTION","abilityMeta":{"modifiers":[{"target":"attack","value":0,"type":"untyped","predicates":[],"enabled":false,"priority":500,"description":"[REQUIRES MANUAL MAPPING] Improved Battle Meditation"}],"combatActions":[{"id":"improved-battle-meditation","name":"Improved Battle Meditation","actionType":"swift","resolutionMode":"consularTalent","consularTalentAction":"improvedBattleMeditation","spendAction":true,"description":"Activate Battle Meditation as a Swift Action, range 12 squares, and opponents in the radius take -1 on attack rolls."}]},"talent_tree":"Jedi Guardian","talentTree":"Jedi Guardian","tree":"Jedi Guardian","source":"Knights of the Old Republic Campaign Guide","summary":"You may activate your Battle Meditation talent as a swift action instead of as a full-round action.","page":25},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_battle_meditation","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":[],"sourcePatch":"jedi-guardian-runtime-pass"}}}
{"_id":"d6d3b0a2ec01ca9a","name":"Speed Implant","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per encounter as a standard action, you can give one adjacent living creature a speed implant. The target must be willing to receive this implant, which increases the target's base speed by 2 until the end of the encounter.\n\nThe following talents all grant effects that last until the end of the encounter. At the end of the encounter, any target that benefits from one or more of these talents immediately moves -3 steps down the condition track, and the condition becomes persistent. The persistent condition can only be removed after 8 hours of rest, or by performing successful surgery (as per the application of the Treat Injury skill) on the target.","description":{"value":"Once per encounter as a standard action, you can give one adjacent living creature a speed implant. The target must be willing to receive this implant, which increases the target's base speed by 2 until the end of the encounter.\n\nThe following talents all grant effects that last until the end of the encounter. At the end of the encounter, any target that benefits from one or more of these talents immediately moves -3 steps down the condition track, and the condition becomes persistent. The persistent condition can only be removed after 8 hours of rest, or by performing successful surgery (as per the application of the Treat Injury skill) on the target."},"class":"557e1a5ec72166fd","costNumeric":null,"category":"Shaper","treeId":"d8a71a6c5b2b7581","tags":["ability_enhancement","action_economy","biotech","crafting","equipment","healing","implant","mobility","positioning","standard_action","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"speed-implant","name":"Speed Implant","label":"Speed Implant","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, give one adjacent willing living creature +2 squares to base Speed until the encounter ends.","notes":"Apply the +2 base Speed change manually to the recipient for the rest of the encounter.","resources":["Once per encounter","Encounter duration"],"requiredContext":["Adjacent willing living creature"],"targetHint":"One adjacent willing living creature"}],"phase18MedicalBiotechCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual action-economy card; no passive bonus is applied automatically."}},"summary":"Once per encounter as a standard action, you can give one adjacent living creature a speed implant.","source":"Legacy Era Campaign Guide","page":47},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.speed_implant","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":["turn.once-per-round"]}}}
{"_id":"d6e7f7178e643717","name":"Bolster Ally","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a Standard Action, you can bolster an ally within line of sight, moving them +1 step along the Condition Track, and giving them a number of Bonus Hit Points equal to their Character Level, if they're at one-half their maximum Hit Points or less. Damage is subtracted from the Bonus Hit Points first, and any Bonus Hit Points remaining at the end of the encounter go away.\n\nYou can't Bolster the same ally more than once in a single encounter, and you can't Bolster yourself.","description":{"value":"As a Standard Action, you can bolster an ally within line of sight, moving them +1 step along the Condition Track, and giving them a number of Bonus Hit Points equal to their Character Level, if they're at one-half their maximum Hit Points or less. Damage is subtracted from the Bonus Hit Points first, and any Bonus Hit Points remaining at the end of the encounter go away.\n\nYou can't Bolster the same ally more than once in a single encounter, and you can't Bolster yourself."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","treeId":"72d32ebcbb607314","tags":["action_economy","condition_removal","force","force_control","force_defense","force_offense","melee","mobility","positioning","ranged","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Talent granted-abilities/action-card data + GM/player resolution","notes":"data/talent-granted-abilities.json already exposes this as a leadership action card; condition-track/bonus-HP application is table/runtime work.","combatActions":[{"id":"bolster-ally","name":"Bolster Ally","label":"Bolster Ally","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Bolster one ally within line of sight: move the ally +1 step on the condition track and grant bonus hit points equal to the ally's character level if the ally is at half HP or less.","notes":"Bolster one ally within line of sight: move the ally +1 step on the condition track and grant bonus hit points equal to the ally's character level if the ally is at half HP or less.","relatedSkills":[],"resources":["Cannot target yourself","Cannot bolster the same ally more than once per encounter"],"requiredContext":[],"targetHint":"One ally within line of sight","spendAction":true,"ruleData":{}}],"manualResolution":true,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Inspiration","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"As a Standard Action, you can bolster an ally within line of sight, moving them +1 step along the Condition Track, and giving them a number of Bonus Hit Points equal to their Character Level, if they're at one-half their maximum...","source":"Saga Edition Core Rulebook","page":44},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.bolster_ally","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":["defense.against-ranged","defense.against-melee","defense.reflex","attack.when-hit","attack.with-melee","attack.with-ranged","proximity.ally-nearby","turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"action_card_or_table_managed","owner":"Talent granted-abilities/action-card data + GM/player resolution","note":"data/talent-granted-abilities.json already exposes this as a leadership action card; condition-track/bonus-HP application is table/runtime work."}}}}
