{"_id":"86a8e796b6c4deae","name":"Impaling Assault","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Weapon Specialization","benefit":"Whenever you successfully damage an opponent using a piercing weapon that you have the Weapon Specialization talent for, your opponent reduces its speed by 2 squares until the end of your next turn. The effects of multiple Impaling Assaults do not stack.","description":{"value":"Whenever you successfully damage an opponent using a piercing weapon that you have the Weapon Specialization talent for, your opponent reduces its speed by 2 squares until the end of your next turn. The effects of multiple Impaling Assaults do not stack."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.869168cd679ee5d1","name":"Weapon Specialization"}],"_source":"canonical-csv"},"treeId":"2e9265a596cc43f7","tags":["mobility"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"Whenever you successfully damage an opponent using a piercing weapon that you have the Weapon Specialization talent for, your opponent reduces its speed by 2 squares until the end of your next turn.","source":"Scum and Villainy","page":18},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.impaling_assault","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.420Z","detectedPredicates":[]}}}
