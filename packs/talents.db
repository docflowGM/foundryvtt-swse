{"_id":"e49c62d72e8b28d3","name":"Tangle Up","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Uncanny Instincts","benefit":"As a standard action, you can make a non-area melee or ranged attack against an opponent within range. If the attack hits, you deal half your normal damage, minimum 1 point, but your opponent loses its next move action.","description":{"value":"As a standard action, you can make a non-area melee or ranged attack against an opponent within range. If the attack hits, you deal half your normal damage, minimum 1 point, but your opponent loses its next move action."},"class":"19ee85a788380256","costNumeric":null,"category":"Outlaw","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.252285ae33a2a2d5","name":"Uncanny Instincts"}],"_source":"canonical-csv"},"treeId":"3caa80f6bef04200","tags":["ambush","mobility","move_action","offense_ranged","positioning","standard_action","survivability","pursuit","reaction","action_economy"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"hunter_pursuit_fear_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals.","combatActions":[{"id":"tangle-up","name":"Tangle Up","label":"Tangle Up","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Standard Action, you can make a non-Area Attack melee or ranged attack against an opponent within Range. If the attack hits, you deal half your normal damage (minimum 1 point), but your opponent loses its next Move Action.","notes":"As a Standard Action, you c