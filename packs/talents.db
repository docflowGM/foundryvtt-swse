{"_id":"7d547902b8d9109e","name":"Penetrating Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Weapon Focus with chosen exotic weapon or weapon group.","benefit":"Choose a single Exotic Weapon or weapon group with which you are proficient. Whenever you make a successful attack against a target with such a weapon, you treat your target's Damage Reduction as if it were 5 points lower when determining the result of your attack. If you select Heavy Weapons as the weapon group this Talent applies to, you may also use the Talent with Vehicle Weapon attacks. You may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group.","description":{"value":"Choose a single Exotic Weapon or weapon group with which you are proficient. Whenever you make a successful attack against a target with such a weapon, you treat your target's Damage Reduction as if it were 5 points lower when determining the result of your attack. If you select Heavy Weapons as the weapon group this Talent applies to, you may also use the Talent with Vehicle Weapon attacks.\n\nYou may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","treeId":"2e9265a596cc43f7","tags":["scaling"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"requiresSelectedChoice":true,"choiceMetaStatus":"phase14_persistent_choice_seeded","mechanicsMode":"runtime_context","applicationScope":"selected_weapon_hit_rider","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Weapon Master","status":"cleaned_runtime_context","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":1,"notes":"Unsafe passive/ActiveEffect data removed. Talent is represented by action cards, attack options, hit/critical riders, 