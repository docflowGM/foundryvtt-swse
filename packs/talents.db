{"_id":"d9fe8a0c76d845d4","name":"Assault Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a move action, you may designate a single creature or object in line of sight as the target of an assault. If you succeed on a DC 15 Knowledge (tactics) check, you and all allies able to hear and understand you deal +1d6 damage to that target with each successful melee or ranged attack until the start of your next turn. This is a mind-affecting effect.","description":{"value":"As a move action, you may designate a single creature or object in line of sight as the target of an assault. If you succeed on a DC 15 Knowledge (tactics) check, you and all allies able to hear and understand you deal +1d6 damage to that target with each successful melee or ranged attack until the start of your next turn. This is a mind-affecting effect."},"class":"30b9cd24b80ebf46","costNumeric":null,"category":"Officer","treeId":"9253ace716c3e966","tags":["action_economy","ambush","damage_reduction","force","force_control","force_defense","force_offense","leadership","mobility","positioning","scaling","skills","support","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Talent granted-abilities/action-card data + GM/player resolution","notes":"data/talent-granted-abilities.json has a tactics action entry; target designation and ally attacks are runtime/table context.","combatActions":[{"id":"assault-tactics","name":"Assault Tactics","label":"Assault Tactics","actionType":"move","cost":1,"manualResolution":false,"resolutionMode":"auto","useLabel":"Roll / Use","description":"Designate one creature or object. On a DC 15 Knowledge (Tactics) check, you and allies who can hear and understand you deal +1d6 damage to that target with successful melee/ranged attacks until the start of your next turn.","notes":"Designate one creature or object. On a DC 15 Knowledge (Tactics) check, you and allies who can hear and understand you deal +1d6 damage to that target with successful melee/ranged attacks until the start of your next turn.","relatedSkills":[{"skill":"knowledge","when":"Knowledge (Tactics) DC 15"}],"resources":["Mind-affecting","Knowledge (Tactics) DC 15"],"requiredContext":["Allies can hear and understand you"],"targetHint":"One creature or object","spendAction":true,"ruleData":{},"skillKey":"knowledge","dc":15}],"manualResolution":false,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Military Tactics","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"Move action and DC 15 Tactics: you and allies deal +1d6 damage to one designated target until your next turn.","source":"Saga Edition Core Rulebook","page":222},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.assault_tactics","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":["defense.reflex","attack.when-hit","proximity.ally-nearby","turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"action_card_or_table_managed","owner":"Talent granted-abilities/action-card data + GM/player resolution","note":"data/talent-granted-abilities.json has a tactics action entry; target designation and ally attacks are runtime/table context."}}}}
{"_id":"d9ffff2586cd259b","name":"Stalwart Subordinates","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When any ally within 12 squares of you and in your line of sight is targeted by a skill check against its Will Defense, the source of that skill check (whether a hazard, a creature, a droid, or whatever) must roll the skill check twice and take the lowest result.","description":{"value":"When any ally within 12 squares of you and in your line of sight is targeted by a skill check against its Will Defense, the source of that skill check (whether a hazard, a creature, a droid, or whatever) must roll the skill check twice and take the lowest result."},"class":"30b9cd24b80ebf46","costNumeric":null,"category":"Officer","treeId":"61b74c82cb56876c","tags":["action_economy","mobility","positioning","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual_or_future_runtime","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally defensive reroll pressure against Will-targeting skill checks; needs future skill-attack reaction window.","phase23SocialCommanderCleanup":{"phase":"T23","tree":"Fugitive Commander","status":"reviewed_manual_or_future_runtime","cardsAdded":0,"notes":"Ally defensive reroll pressure against Will-targeting skill checks; needs future skill-attack reaction window."}},"summary":"When any ally within 12 squares of you and in your line of sight is targeted by a skill check against its Will Defense, the source of that skill check (whether a hazard, a creature, a droid, or whatever) must roll the skill check twice...","source":"Legacy Era Campaign Guide","page":42},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.stalwart_subordinates","migratedT