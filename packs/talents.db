{"_id":"8ddbb7f6d4a11725","name":"Makashi","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Lightsaber Defense","benefit":"When wielding a single lightsaber in one hand, the deflection bonus you gain from Lightsaber Defense increases by 2, to a maximum of +5.","description":"When wielding a single lightsaber in one hand, the deflection bonus you gain from Lightsaber Defense increases by 2, to a maximum of +5.","class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"2bc2572e852832e4","tags":["lightsaber","melee","force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"active_defense_manual","staticSheetPolicy":"manual_only","manualResolution":true,"notes":"Improves the active Lightsaber Defense deflection bonus while wielding a single one-handed lightsaber. Needs Lightsaber Defense active-state tracking; no permanent Reflex bonus.","modifiers":[],"combatActions":[{"id":"makashi","name":"Makashi","label":"Makashi","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Lightsaber Defense Talent increases by 2 (to a maximum of +5).","notes":"When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Lightsaber Defense Talent increases by 2 (to a maximum of +5).","relatedSkills":[],"resources":["Lightsaber context"],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[],"requiresRuntimeContext":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Lightsaber Forms","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":0,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."}},"talent_tree":"Light