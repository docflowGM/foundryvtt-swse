{"_id":"9ee88ce289527ed3","name":"Flee","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Long Stride","benefit":"As a standard action, you can designate a single opponent and move up to your speed away from that opponent. This movement does not provoke attacks of opportunity from that opponent, though it might provoke as normal from all other opponents. In addition, your speed increases by 2 until the end of your next turn.","description":{"value":"As a standard action, you can designate a single opponent and move up to your speed away from that opponent. This movement does not provoke attacks of opportunity from that opponent, though it might provoke as normal from all other opponents. In addition, your speed increases by 2 until the end of your next turn."},"class":"b5bed5d1b5f42958","costNumeric":null,"category":"Scout","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.618472c99f355949","name":"Long Stride"}],"_source":"canonical-csv"},"treeId":"7c47d36dc1f77d9c","tags":["mobility"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"modifiers":[]},"summary":"As a standard action, you can designate a single opponent and move up to your speed away from that opponent.","source":"Scum and Villainy","page":17},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.flee"}}}
{"_id":"9f01b5c07bbd5f76","name":"Manipulating Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per turn when you successfully damage a target with a non-area attack, make an immediate Persuasion check against the target's Will Defense. If successful, you can determine what the target does with its swift action on its next turn. This is a mind-affecting effect.","description":{"value":"Once per turn when you successfully damage a target with a non-area attack, make an immediate Persuasion check against the target's Will Defense. If successful, you can determine what the target does with its swift action on its next turn. This is a mind-affecting effect."},"costNumeric":null,"treeId":"da7b731a3e434a7a","tags":["action_economy","control","manipulation","melee","mobility","persuasion","positioning","ranged","skills","social","swift_action","trap","pursuit","mind-affecting"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"hunter_pursuit_fear_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals.","phase26HunterPursuitFearCleanup":{"phase":"T26","tree":"Genoharadan","status":"combat_action_card","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals."},"combatActions":[{"id":"manipulating-strike","name":"Manipulating Strike","label":"Manipulating Strike","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Once per turn when you successfully damage a target with a non-Area Attack, make an Intimidate Persuasion check against the target's Will Defense. If successful, you can determine what the target does with its Swift Action on its next turn. This is a Mind-Affecting effect.","notes":"Once per turn when you successfully damage a target with a non-Area Attack, make an Intimidate Persuasion check against the target's Will Defense. If successful, you can determine what the target does with its Swift Action on its next turn. This is a Mind-Affecting effect.","relatedSkills":[{"skill":"persuasion","when":"Intimidate vs Will after damaging target"}],"resources":["Once per turn","Non-area attack that damages target","Mind-affecting"],"requiredContext":["Successful damage with non-area attack"],"targetHint":"Damaged target","spendAction":false,"ruleData":{}}],"rules":[{"type":"ATTACK_OPTION","id":"manipulating-strike","label":"Manipulating Strike","control":"flag","excludesAreaAttack":true,"targetEffectsOnHit":[{"type":"skillContestRider","skill":"persuasion","against":"will","effect":"controlTargetSwiftAction","label":"Manipulating Strike"}],"summary":"Use once per turn after damaging with a non-area attack; roll Persuasion/Intimidate vs Will to control target Swift Action."}]},"summary":"Once per turn when you successfully damage a target with a non-area attack, make an immediate Persuasion check against the target's Will Defense.","source":"Scum and Villainy","page":30},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.manipulating_strike","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.423Z","detectedPredicates":["defense.against-ranged","defense.against-melee","defense.will","attack.with-melee","attack.with-ranged","movement.while-moving"],"talentHunterPursuitFearCleanup":{"phase":"T26","tree":"Genoharadan","status":"combat_action_card"}}}}
{"_id":"9fd409d9ceaf6733","name":"Run Interference","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Escort Pilot Talent","benefit":"As a Reaction, you can use your Vehicular Combat Feat to negate an attack against an adjacent Vehicle of Colossal size or smaller that is Piloted by an ally. If you can use Vehicular Combat more than once per round, each use to negate an attack counts toward your limit of uses per round.","description":{"value":"As a Reaction, you can use your Vehicular Combat Feat to negate an attack against an adjacent Vehicle of Colossal size or smaller that is Piloted by an ally. If you can use Vehicular Combat more than once per round, each use to negate an attack counts toward your limit of uses per round."},"class":"9c9989c34714f920","costNumeric":null,"category":"Ace Pilot","treeId":"5f355ad4093d2bf8","tags":["positioning"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"run-interference","name":"Run Interference","label":"Run Interference","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Use your Vehicular Combat feat to negate an attack against an adjacent allied Colossal-or-smaller vehicle. This counts against your Vehicular Combat uses per round.","notes":"Use your Vehicular Combat feat to negate an attack against an adjacent allied Colossal-or-smaller vehicle. This counts against your Vehicular Combat uses per round.","resources":["Vehicular Combat use","Adjacent ally vehicle"]}],"phase16VehicleStarshipCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual combat action card in the action economy UI."}},"summary":"As a Reaction, you can use your Vehicular Combat Feat to negate an attack against an adjacent Vehicle of Colossal size or smaller that is Piloted by an ally.","source":"Rebellion Era Campaign Guide","page":40},"effects":[],"folder"