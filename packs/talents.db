{"_id":"fbac177b74fcea09","name":"Takedown","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When you successfully make a melee attack and deal damage at the end of a charge, you knock your target prone as well, provided your opponent is no more than one size category larger than you.","description":{"value":"When you successfully make a melee attack and deal damage at the end of a charge, you knock your target prone as well, provided your opponent is no more than one size category larger than you."},"class":"61876f91a1633cdf","costNumeric":null,"category":"Enforcer","treeId":"2d164f62e17bed8c","tags":["control","force","force_offense","mobility","nonlethal","offense_melee","pursuit","vehicle"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Future CombatOptionResolver / action-card / reaction prompt / damage-resolution hook","notes":"Reviewed in T12. Removed legacy static/passive modifier data; this talent is a real combat mechanic but needs runtime context and should not mutate permanent sheet totals.","combatActions":[{"id":"takedown-t31-reference","name":"Takedown","label":"Takedown","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"When you successfully make a melee attack and deal damage at the end of a Charge, you knock your target Prone as well, provided your opponent is no more than one size category larger than you.","notes":"When you successfully make a melee attack and deal damage at the end of a Charge, you knock your target Prone as well, provided your opponent is no more than one size category larger than you.","relatedSkills":[],"resources":["Target context","Prone context"],"requiredContext":["Valid target confirmed"