{"_id":"d3a642f2ceb21ed4","name":"Jet Pack Training","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can activate a jet pack as a free action on your turn. You need not make Pilot checks to land safely with a jet pack.","description":{"value":"You can activate a jet pack as a free action on your turn. You need not make Pilot checks to land safely with a jet pack."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","treeId":"1f50c63b6f08de10","tags":["action_economy","armor","heavy_weapon","mobility","positioning","ranged","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"You can activate a jet pack as a free action on your turn.","source":"Knights of the Old Republic Campaign Guide","page":30},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.jet_pack_training","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":["turn.once-per-round"]}}}
{"_id":"d3b19d5e369f579d","name":"Greater Devastating Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Greater Weapon Focus; Devastating Attack; Weapon Focus with the chosen weapon","benefit":"Choose one exotic weapon or weapon group with which you are proficient. When you make a successful attack with the chosen weapon, treat the target's damage threshold as 10 points lower when determining the result of your attack. This replaces the effect of Devastating Attack for that weapon.","description":{"value":"Choose one exotic weapon or weapon group with which you are proficient. When you make a successful attack with the chosen weapon, treat the target's damage threshold as 10 points lower when determining the result of your attack. This replaces the effect of Devastating Attack for that weapon."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.383915a7d11e1225","name":"Devastating Attack"}],"_source":"canonical-csv"},"treeId":"2f720d8b061f9bd0","tags":["damage_reduction"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"selected_weapon_hit_rider","staticSheetPolicy":"exclude","manualResolution":false,"requiresRuntimeContext":true,"requiresSelectedChoice":true,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","choiceMetaStatus":"phase14_persistent_choice_seeded","rules":[{"type":"HIT_RIDER","id":"greater-devastating-attack-threshold-reduction","label":"Greater Devastating Attack","targetEffectsOnHit":[{"type":"damageThresholdAdjustment","value":-10,"duration":"thisAttack"}],"selectedChoice":true}],"phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Weapon Master","status":"reviewed","notes":"Reviewed in tactical ranged/military cleanup."}},"choiceMeta":{"resolution":"immediate","required":true,"status":"phase14_choice_kind_wired","choiceKind":"weapon_group_or_exotic","repeatable":true,"storagePath":"flags.swse.choices.greater_devastating_attack","choiceSource":"prerequisiteDerived","optionRegistry":"data/feat-choice-options.json#choiceKinds.weapon_group_or_exotic","derivesFrom":["weapon_proficiency"],"consumes":"weapon_proficiency","provides":"weapon_group_or_exotic"},"summary":"Treat a target's damage threshold as 10 lower with the chosen weapon, replacing Devastating Attack's effect.","source":"Saga Edition Core Rulebook","page":212},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.greater_devastating_attack","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":[],"requiresImmediateChoice":true}}}
{"_id":"d46612d82307f0db","name":"Drain Knowledge","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":null,"benefit":"As a standard action, you can spend a Force Point to drain the knowledge of an enemy you touch; you must succeed on a Use the Force check (DC equal to the target's Will Defense) to activate this talent, and if you fail to activate this talent, you may not try again on the same target for one day. If successful, you immediately become trained in one skill that the target is trained in; if you are already trained in that skill, you instead gain Skill Focus in that skill. This training or focus lasts for one day. Additionally, your target moves -1 persistent step along the condition track, and the persistent condition can be removed only by resting for 8 hours.\n\nAdditionally, you can choose to instead sift through the mind of the target, looking for a specific piece of knowledge or information. Doing so requires you to make a Perception check against the target's Will Defense; success indicates that you pull the relevant information from the target's mind. When you do so, you do not gain the training or focus normally granted by this talent, but otherwise the talent functions as normal.\n\nUsing this talent increases your Dark Side Score by 1.","description":"As a standard action, you can spend a Force Point to drain the knowledge of an enemy you touch; you must succeed on a Use the Force check (DC equal to the target's Will Defense) to activate this talent, and if you fail to activate this talent, you may not try again on the same target for one day. If successful, you immediately become trained in one skill that the target is trained in; if you are already trained in that skill, you instead gain Skill Focus in that skill. This training or focus lasts for one day. Additionally, your target moves -1 persistent step along the condition track, and the persistent condition can be removed only by resting for 8 hours.\n\nAdditionally, you can choose to instead sift through the mind of the target, looking for a specific piece of knowledge or information. Doing so requires you to make a Perception check against the target's Will Defense; success indicates that you pull the relevant information from the target's mind. When you do so, you do not gain the training or focus normally granted by this talent, but otherwise the talent functions as normal.\n\nUsing this talent increases your Dark Side Score by 1.","costNumeric":null,"treeId":"de95d37c72b1c4cd","tags":["condition_removal","dark_side","force","force_multiplier","investigation","knowledge","mobility"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"drain-knowledge","name":"Drain Knowledge","label":"Drain Knowledge","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"By touch, make a check vs target's Will Defense to drain knowledge; gain trained status in a skill or a Skill Focus if you already have the skill; target moves down the condition track; you gain a Dark Side Point.","notes":"By touch, make a check vs target's Will Defense to drain knowledge; gain trained status in a skill or a Skill Focus if you already have the skill; target moves down the condition track; you gain a Dark Side Point.","relatedSkills":[],"resources":["Touch target","Check vs Will Defense","Skill/Skill Focus transfer and DSP context"],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Dark Side","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"Spend a Force Point to drain a touched enemy's skill knowledge or specific information, inflicting a persistent condition and increasing your Dark Side Score.","source":"Threats of the Galaxy","page":30},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.drain_knowledge","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":["defense.will"],"forceTalentCleanup":{"phase":"T22","tree":"Dark Side","status":"combat_action_card"}}}}
{"_id":"d4a94695e27f60a1","name":"Pistol Duelist","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You are a master of the elegant, if archaic, custom of dueling with pistols. You can use each of the following actions once per encounter as a standard action:\n\nEnd Game: You make a single ranged attack with a pistol against an opponent within range. The opponent's damage threshold is halved (round down) for the purposes of this attack.\n\nSnap Aiming: You make a single ranged attack with the benefits of aiming.\n\nStand Steady: You gain a +4 bonus to your Reflex Defense until the end of your next turn and make a single ranged attack.","description":{"value":"You are a master of the elegant, if archaic, custom of dueling with pistols. You can use each of the following actions once per encounter as a standard action:\n\nEnd Game: You make a single ranged attack with a pistol against an opponent within range. The opponent's damage threshold is halved (round down) for the purposes of this attack.\n\nSnap Aiming: You make a single ranged attack with the benefits of aiming.\n\nStand Steady: You gain a +4 bonus to your Reflex Defense until the end of your next turn and make a single ranged attack."},"class":"162d866ba36fce69","costNumeric":null,"category":"Gunslinger","treeId":"cb6f775cd227a3e3","tags":["action_economy","pistol","ranged","standard_action"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_actions","applicationScope":"combat_action_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"AbilityCombatActionResolver + character sheet combat actions tab","notes":"Phase T13 split this multi-action talent out of the bad merged Multiattack Proficiency (pistols) text. Each child action is surfaced as a Standard combat action and resolved manually until per-encounter usage/attack-sequence automation exists.","combatActions":[{"id":"end-game","name":"End Game","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","relatedSkills":[{"skill":"Attack Roll","when":"Single ranged pistol attack"}],"resources":["Once per encounter"],"requiredContext":["Pistol","Target within range"],"notes":"Make a single ranged attack with a pistol. For this attack only, the target's Damage Threshold is halved, rounded down.","description":"Make one ranged pistol attack; the target's Damage Threshold is halved for this attack."},{"id":"snap-aiming","name":"Snap Aiming","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","relatedSkills":[{"skill":"Attack Roll","when":"Single ranged pistol attack with Aim benefits"}],"resources":["Once per encounter"],"requiredContext":["Pistol"],"notes":"Make a single ranged attack with the benefits of Aiming.","description":"Make one ranged pistol attack and apply Aim benefits to that attack."},{"id":"stand-ready","name":"Stand Ready","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","relatedSkills":[{"skill":"Attack Roll","when":"Single ranged pistol attack"}],"resources":["Once per encounter"],"requiredContext":["Pistol"],"notes":"Gain +4 Reflex Defense until the end of your next turn and make a single ranged attack.","description":"Gain +4 Reflex Defense until the end of your next turn, then make one ranged pistol attack."}]},"summary":"Once each per encounter as a standard action, use End Game, Snap Aiming, or Stand Steady with a pistol.","source":"Galaxy of Intrigue","page":25},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.pistol_duelist","phaseT13Created":true}}}
{"_id":"d4a9f83d180934b5","name":"Fringe Savant","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Whenever you roll a Natural 20 on a Skill Check during an encounter, you gain one temporary Force Point. If the Force Point is not used before the end of the encounter, it is lost.","description":{"value":"Whenever you roll a Natural 20 on a Skill Check during an encounter, you gain one temporary Force Point. If the Force Point is not used before the end of the encounter, it is lost."},"class":"b5bed5d1b5f42958","costNumeric":null,"category":"Scout","treeId":"7c47d36dc1f77d9c","tags":["force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"Whenever you roll a Natural 20 on a Skill Check during an encounter, you gain one temporary Force Point. If the Force Point is not used before the end of the encounter, it is lost.","source":"Saga Edition Core Rulebook","page":50},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.fringe_savant","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":[]}}}
{"_id":"d4da27798cbb18e6","name":"Impose Confusion","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Impose Hesitation","benefit":"Increase the area of Impose Hesitation toa 12-square cone. Also, once per encounter, after making the Persuasion check for Impose Hesitation, you can instead choose to have the targets lose a standard action on their next turn.","description":{"value":"Increase the area of Impose Hesitation toa 12-square cone. Also, once per encounter, after making the Persuasion check for Impose Hesitation, you can instead choose to have the targets lose a standard action on their next turn."},"class":"fc815ae3ca4bf726","costNumeric":null,"category":"Corporate Agent","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.0fd8fc8cfae6f516","name":"Impose Hesitation"}],"_source":"canonical-csv"},"treeId":"45c4007d09c01839","tags":["action_economy","control","deception","force","mobility","persuasion","positioning","skills","social","standard_action"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed target context","notes":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists.","combatActions":[{"id":"impose-confusion","name":"Impose Confusion","label":"Impose Confusion","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Use with Impose Hesitation: increase the area to a 12-square cone, and once per encounter after the check you can choose for affected targets to lose a Standard Action instead.","notes":"Use with Impose Hesitation: increase the area to a 12-square cone, and once per encounter after the check you can choose for affected targets to lose a Standard Action instead.","relatedSkills":[],"resources":["Modifies Impose Hesitation","Once per encounter standard-action loss option"],"requiredContext":[],"targetHint":"Opponents in 12-square cone","spendAction":true,"ruleData":{}}],"manualResolution":true,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Corporate Power","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"Increase the area of Impose Hesitation toa 12-square cone.","source":"Knights of the Old Republic Campaign Guide","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.impose_confusion","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":["turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"GM/player managed target context","note":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists."}}}}
