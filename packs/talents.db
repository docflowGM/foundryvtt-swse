{"_id":"594eb9e7f9084742a7d1cbc209d2f340","name":"Swift Droid","type":"talent","img":"icons/svg/item-bag.svg","system":{"benefit":"You move quickly when caught. You can make a swift action as a reaction after failing a Deception check or a Stealth check.","description":{"value":"You move quickly when caught. You can make a swift action as a reaction after failing a Deception check or a Stealth check."},"prerequisites":"Any two talents from the Autonomy talent tree","class":"3b1ed5f1038d49fb","category":"Independent Droid","treeId":"9fe73a3703fa45fca628fd43cae6bf7f","tags":["action_economy","deception","droid","durability","mobility","reaction","self_repair","skills","social","stealth","swift_action","tech"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"swift-droid-reaction","name":"Swift Droid","label":"Swift Droid","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"After failing a Deception check or Stealth check, make a Swift Action as a Reaction.","notes":"Track the granted Swift Action manually after the failed Deception or Stealth check.","relatedSkills":[{"skill":"Deception"},{"skill":"Stealth"}],"resources":["Reaction","After failed Deception or Stealth check"]}],"phase19DroidCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","tree":"Independent Droid","notes":"Reaction card for taking a Swift Action after failed Deception or Stealth.","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0},"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"swift-droid-t31-context","label":"Swift Droid","summary":"You move quickly when caught. You can make a Swift Action as a Reaction after failing a Deception check or a Stealth check."}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Autonomy","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffect