{"_id":"80a24150fd2f3163","name":"Droid Jammer","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can construct a short-range jammer that affects droids. As a full-round action, you make a Mechanics check to build the jammer. When a droid comes within 6 squares of you, compare the result of your Mechanics check to the droid’s Will Defense. If your check result equals or exceeds the droid’s Will Defense, the droid can take only swift actions as long as it remains within the radius of the jammer. Droids that are immune to the effect of a restraining bolt are immune to the effect of this talent. The jammer functions for the remainder of the encounter. You may only have one jammer (device or droid) active at a time.","description":{"value":"You can construct a short-range jammer that affects droids. As a full-round action, you make a Mechanics check to build the jammer. When a droid comes within 6 squares of you, compare the result of your Mechanics check to the droid’s Will Defense. If your check result equals or exceeds the droid’s Will Defense, the droid can take only swift actions as long as it remains within the radius of the jammer. Droids that are immune to the effect of a restraining bolt are immune to the effect of this talent. The jammer functions for the remainder of the encounter. You may only have one jammer (device or droid) active at a time."},"class":"de3f367749b82fcf","costNumeric":null,"category":"Saboteur","treeId":"8897a36d59662ee9","tags":["action_economy","mechanics","mobility","positioning","skills"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"droid-jammer","name":"Droid Jammer","label":"Droid Jammer","actionType":"full-round","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Construct a short-range droid jammer. Make the Mechanics check and compare the result when a droid comes within 6 squares.","notes":"Construct a short-range droid jammer. Make the Mechanics check and compare the result when a droid comes within 6 squares.","relatedSkills":[{"skill":"Mechanics"}],"resources":[],"requiredContext":[],"targetHint":"Droids within 6 squares"}],"phase17TechEngineeringCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual action-economy card. Automation can be added later without inventing passive bonuses."}},"summary":"You can construct a short-range jammer that affects droids.","source":"Force Unleashed Campaign Guide","page":56},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.droid_jammer","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.419Z","detectedPredicates":["defense.will"]}}}
{"_id":"80e14ef4d1f52a4a","name":"Precision","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a standard action, you can make a melee attack with a lightsaber against an adjacent opponent. If the attack hits, it deals normal damage and also reduces the target's speed to 2 squares until the end of your next turn.","description":{"value":"As a standard action, you can make a melee attack with a lightsaber against an adjacent opponent. If the attack hits, it deals normal damage and also reduces the target's speed to 2 squares until the end of your next turn."},"class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"2359c05ff13f3feb","tags":["damage_reduction","lightsaber","melee","mobility","positioning","force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[{"target":"attack","value":0,"type":"untyped","predicates":[],"enabled":false,"priority":500,"description":"[REQUIRES MANUAL MAPPING] Precision"}],"mechanicsMode":"active_attack_rider","applicationScope":"lightsaber_attack_runtime","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true},"talent_tree":"Lightsaber Combat","talentTree":"Lightsaber Combat","tree":"Lightsaber Combat","summary":"As a standard action, you can make a melee attack with a lightsaber against an adjacent opponent.","source":"Legacy Era Campaign Guide","page":27},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.precision","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.419Z","detectedPredicates":[],"lightsaberTalentImplementation":{"status":"runtime_action_or_contextual","updated":"2026-06-11"}}}}
