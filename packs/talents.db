{"_id":"5e895be4051e1408","name":"Blaster and Blade II","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Blaster and Blade I, Dual Weapon Mastery I feat, Weapon Proficiency (advanced melee weapons, pistols) feats","benefit":"When you are wielding both an advanced melee weapon and a pistol, you treat the advanced melee weapon as though you were wielding it two-handed (including doubling your Strength bonus on damage rolls).","description":{"value":"When you are wielding both an advanced melee weapon and a pistol, you treat the advanced melee weapon as though you were wielding it two-handed (including doubling your Strength bonus on damage rolls)."},"class":"fcf8cc428a6eb01a","costNumeric":null,"category":"Master Privateer","treeId":"df6678946610c554","tags":["melee","ranged"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"conditional","applicationScope":"equipped_context","staticSheetPolicy":"exclude_from_static_sheet_bonus","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"CombatStatRules.getDamageAbilityContribution","notes":"Implemented in CombatStatRules damage ability contribution: while wielding an equipped pistol and using an advanced melee weapon, the advanced melee weapon is treated as two-handed for Strength damage. No static modifier is needed."},"summary":"When you are wielding both an advanced melee weapon and a pistol, you treat the advanced melee weapon as though you were wielding it two-handed (including doubling your Strength bonus on damage rolls).","source":"Force Unleashed Campaign Guide","page":52},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.blaster_and_blade_ii","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.414Z","detectedPredicates":[]}}}
{"_id":"5ea6368fd61de9f1","name":"Unwavering Ally","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per turn, as a Swift Action, you can designate one ally within your line of sight who can hear and understand you. Until the start of your next turn, that ally becomes immune to all effects that render the ally Flat-Footed or that deny the ally a Dexterity bonus to his or her Reflex Defense.","description":{"value":"Once per turn, as a Swift Action, you can designate one ally within your line of sight who can hear and understand you. Until the start of your next turn, that ally becomes immune to all effects that render the ally Flat-Footed or that deny the ally a Dexterity bonus to his or her Reflex Defense."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","treeId":"5964237d22681dc0","tags":["support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Vehicle/crew systems or GM/player managed","notes":"Vehicle/crew/tactical effects need vehicle, commander, gunner, pilot, line-of-sight, or target context not available to static actor prep.","combatActions":[{"id":"unwavering-ally","name":"Unwavering Ally","label":"Unwavering Ally","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per turn, designate one ally within line of sight who can hear and understand you. Until the start of your next turn, the ally is immune to effects that render them flat-footed or deny Dexterity bonus to Reflex Defense.","notes":"Once per turn, designate one ally within line of sight who can hear and understand you. Until the start of your next turn, the ally is immune to effects that render them flat-footed or deny Dexterity bonus to Reflex Defe