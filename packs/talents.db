{"_id":"c3b22fdc6ca5af8e","name":"Armored Mandalorian","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Dexterity 13, Mandalorian Glory, proficient in armor worn","benefit":"Mandalorians wear armor constantly and learn to adjust to take an impact on the strongest section of their armor. You add your armor’s Fortitude Defense bonus as an equipment bonus to your elite trooper damage reduction (with a maximum bonus equal to your base elite trooper DR). Additionally, if a lightsaber does not ignore the DR of the armor you are wearing (such as cortosis weave/phrik alloy armor),\n\na lightsaber does not ignore your damage reduction.","description":{"value":"Mandalorians wear armor constantly and learn to adjust to take an impact on the strongest section of their armor. You add your armor’s Fortitude Defense bonus as an equipment bonus to your elite trooper damage reduction (with a maximum bonus equal to your base elite trooper DR). Additionally, if a lightsaber does not ignore the DR of the armor you are wearing (such as cortosis weave/phrik alloy armor),\n\na lightsaber does not ignore your damage reduction."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13},{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.2ed2cffbd702c1c3","name":"Mandalorian Glory"}],"_source":"canonical-csv"},"treeId":"4b8857716e056f62","tags":["armor","damage_reduction","lightsaber","melee"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action_reference","applicationScope":"martial_protector_arena_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditi