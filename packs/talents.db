{"_id":"5db4343762664d95","name":"Device Jammer","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can construct a short-range jammer that affects a specific type of electronic device such as a personal shield generator, comlink, computer, or datapad. As a full-round action, you select a particular piece of equipment (any object except a droid, vehicle, or weapon) and make a DC 20 Mechanics check. If the check is successful, all devices of the chosen type cease to function while within 12 squares of your position for the remainder of the encounter. You may only have one jammer (device or droid) active at a time.","description":{"value":"You can construct a short-range jammer that affects a specific type of electronic device such as a personal shield generator, comlink, computer, or datapad. As a full-round action, you select a particular piece of equipment (any object except a droid, vehicle, or weapon) and make a DC 20 Mechanics check. If the check is successful, all devices of the chosen type cease to function while within 12 squares of your position for the remainder of the encounter. You may only have one jammer (device or droid) active at a time."},"class":"de3f367749b82fcf","costNumeric":null,"category":"Saboteur","treeId":"8897a36d59662ee9","tags":["mechanics","positioning","skills"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"device-jammer","name":"Device Jammer","label":"Device Jammer","actionType":"full-round","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Construct a short-range jammer for a specific electronic device type. Make the Mechanics check and use that result against affected devices within 6 squares.","notes":"Construct a short-range jammer for a specific electronic device type. Make the Mechanics check and use that result against affected devices within 6 squares.","relatedSkills":[{"skill":"Mechanics"}],"resources":[],"requiredContext":[],"targetHint":"Selected electronic device type"}],"phase17TechEngineeringCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual action-economy card. Automation can be added later without inventing passive bonuses."}},"summary":"You can construct a short-range jammer that affects a specific type of electronic device such as a personal shield generator, comlink, computer, or datapad.","source":"Force Unleashed Campaign Guide","page":56},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.device_jammer","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.413Z","detectedPredicates":[]}}}
{"_id":"5e1065e8f4ab39b2","name":"Trust","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Born Leader, Coordinate.","benefit":"You can give up your Standard Action to give one ally within your line of sight an extra Standard Action or Move Action on their next turn, to do with as they please. The ally does not lose the Action if line of sight is later broken.","description":{"value":"You can give up your Standard Action to give one ally within your line of sight an extra Standard Action or Move Action on their next turn, to do with as they please. The ally does not lose the Action if line of sight is later broken."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.6a66ba6e0834dd6f","name":"Born Leader"},{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.a52044feeab3fe05","name":"Coordinate"}],"_source":"canonical-csv"},"treeId":"5964237d22681dc0","tags":["action_economy"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Vehicle/crew systems or GM/player managed","notes":"Vehicle/crew/tactical effects need vehicle, commander, gunner, pilot, line-of-sight, or target context not available to static actor prep.","combatActions":[{"id":"trust","name":"Trust","label":"Trust","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Give up your Standard Action to grant one ally within line of sight an extra Standard or Move Action on that ally's next turn.","notes":"Give up your Standard Action to grant one ally within line of sight an extra Standard or Move Action on that ally's next turn.","relatedSkills":[],"resources":