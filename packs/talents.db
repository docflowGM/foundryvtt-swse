{"_id":"90d9a2e7dbc160d1","name":"Force Power Adept","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You are skilled at using a particular Force Power. Select one Force Power you know. When using that Force Power, you have the option of spending a Force Point to make two Use the Force checks, keeping the better result.\n\nThis Talent may be selected multiple times. Its effects do not stack. Each time you select this Talent, you must choose a different Force Power.","description":{"value":"You are skilled at using a particular Force Power. Select one Force Power you know. When using that Force Power, you have the option of spending a Force Point to make two Use the Force checks, keeping the better result.\n\nThis Talent may be selected multiple times. Its effects do not stack. Each time you select this Talent, you must choose a different Force Power."},"class":"289fcf920ef0e184","costNumeric":null,"category":"Force Adept","treeId":"e35ee41362604227","tags":["balance","force","force_capacity","force_point_spend","force_power_synergy","force_training","resource_spend","survivability","use_the_force","will_defense","healing"],"executionModel":"ACTIVE","subType":"TALENT_ACTION","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"persistent_choice_and_force_prompt","staticSheetPolicy":"exclude","manualResolution":true,"modifiers":[],"notes":"Choose one known Force power; when using it, spend Force Point to roll twice/keep better.","requiresSelectedChoice":true,"choiceMetaStatus":"phase14_persistent_choice_seeded","combatActions":[{"id":"force-power-adept","name":"Force Power Adept","actionType":"free","requiredTalent":"Force Power Adept","description":"You are skilled at using a particular Force Power. Select one Force Power you know. When using that Force Power, you have the option of spending a Force Point to make two Use the Force checks, keeping the better result.","resolutionMode":"forceAdeptTalent","spendActi