{"_id":"4fc3fe4c1e7f9ba0","name":"Armor Mastery","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Armored Defense.","benefit":"The maximum Dexterity bonus of your Armor improves by +1. You must be proficient with the Armor you are wearing to gain this benefit.","description":{"value":"The maximum Dexterity bonus of your Armor improves by +1. You must be proficient with the Armor you are wearing to gain this benefit."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.4c236343b01ea763","name":"Armored Defense"}],"_source":"canonical-csv"},"treeId":"17cec542331cb4e4","tags":["armor"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"implementationStatus":"implemented_by_defense_calculator","engineOwner":"DefenseCalculator","mechanicsMode":"passive","applicationScope":"equipped_armor_context","staticSheetPolicy":"owned_by_defense_calculator","conditionSummary":"Applies while wearing armor with which the actor is proficient; increases effective max Dexterity/ability bonus by +1.","notes":"Removed disabled manual attack placeholder. DefenseCalculator owns the max ability cap adjustment.","implementationNote":"Handled by defense/armor calculators. Applies only while wearing proficient armor.","runtime":"armor-calculator","tags":["armor-specialist"]},"implementationNote":"Handled by defense/armor calculators. Applies only while wearing proficient armor.","effects":[],"tree":"Armor Specialist","summary":"The maximum Dexterity bonus of your Armor improves by +1. You must be proficient with the Armor you are wearing to gain this benefit.","source":"Saga Edition Core Rulebook","page":51},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armor_mastery","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.412Z","detectedPredicates":[],"runtimeOwner":"Defens