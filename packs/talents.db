{"_id":"83dce0bf42928741","name":"Force Revive","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Battle Meditation, Jedi Battle Commander","benefit":"When an ally affected by your Battle Mediation is reduced to O hit points, you can spend a Force Point as a reaction, allowing that ally to take its Second Wind as a reaction immediately (though the target still falls unconscious before the Second Wind is triggered).","description":{"value":"When an ally affected by your Battle Mediation is reduced to O hit points, you can spend a Force Point as a reaction, allowing that ally to take its Second Wind as a reaction immediately (though the target still falls unconscious before the Second Wind is triggered)."},"class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"dfc4142435b4356d","tags":["action_economy","damage_reduction","force","light_side","support"],"executionModel":"ACTIVE","subType":"STATE","abilityMeta":{"modifiers":[{"target":"attack","value":0,"type":"untyped","predicates":[],"enabled":false,"priority":500,"description":"[REQUIRES MANUAL MAPPING] Force Revive"}],"status":"talent_backcheck_user_text_2026_06_11","description":"Spend a Force Point as a Reaction to let a Battle Meditation ally at 0 HP take Second Wind immediately.","mechanicsMode":"action_or_contextual","applicationScope":"battle_meditation_second_wind_reaction","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"conditionSummary":"Spend a Force Point as a Reaction to let a Battle Meditation ally at 0 HP take Second Wind immediately.","metadataPhase":"jedi-prestige-talent-backcheck","metadataNotes":"Updated from user-provided source text; non-automatable targeting/LOS/session adjudication remains GM/player confirmed.","rules":[{"type":"TALENT_RULE","id":"force_revive","label":"Force Revive","summary":"Spend a Force Point as a Reaction to let a Battle Meditation ally at 0 HP take Second Wind immediately.","act