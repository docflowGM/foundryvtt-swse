 context","note":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists."}}}}
{"_id":"3a34ce2ef55c41b1","name":"Directed Action","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"As a standard action, you allow one droid that can hear and understand you to make a Deception, Mechanics, Persuasion, Pilot, Ride, Treat Injury, or Use Computer check immediately as a free action. The droid can replace its relevant ability score modifier for that check with your Intelligence modifier."},"benefit":"As a standard action, you allow one droid that can hear and understand you to make a Deception, Mechanics, Persuasion, Pilot, Ride, Treat Injury, or Use Computer check immediately as a free action. The droid can replace its relevant ability score modifier for that check with your Intelligence modifier.","class":"","category":"","costNumeric":null,"treeId":"01cb1ca2a10640b3","tags":["action_economy","ally_support","deception","droid","healing","melee","mobility","persuasion","pilot","positioning","ranged","social","standard_action","support","sustained_damage","tactics","teamwork","vehicle","tech","command"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"directed-action","name":"Directed Action","label":"Directed Action","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Standard Action, you allow one Droid that can hear and understand you to make a Deception, Mechanics, Persuasion, Pilot, Ride, Treat Injury, or Use Computer check immediately as a Free Action. The Droid can replace its relevant Ability Score modifier for that check with your Intelligence modifier.","notes":"As a Standard Action, allow one droid that can hear and understand you to immediately make one listed skill check as a Free Action, replacing the relevant ability modifier with your Intelligence modifier.","relatedSkills":[{"skill":"Use Computer"},{"skill":"Mechanics"},{"skill":"Pilot"},{"skill":"Ride"},{"skill":"Treat Injury"},{"skill":"Persuasion"},{"skill":"Deception"}],"resources":["One droid ally","Immediate free skill check","Your Intelligence modifier substitution"],"requiredContext":["Droid can hear and understand you","Listed skill check"],"targetHint":"","spendAction":true,"ruleData":{}}],"rules":[],"mechanicsMode":"combat_action_reference","applicationScope":"runtime_skill_crafting_medical_computer_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase29TechMedicalMicrotreeCleanup":{"phase":"T29","tree":"Override","status":"reviewed_manual_or_runtime_context","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Tech/medical/science microtree pass removed unsafe passive rows and surfaces crafting, cloning, poison, computer, droid-command, and treatment effects as truthful action/reference cards."}},"summary":"As a standard action, you allow one droid that can hear and understand you to make a Deception, Mechanics, Persuasion, Pilot, Ride, Treat Injury, or Use Computer check immediately as a free action.","source":"Scavenger's Guide to Droids","page":28},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.408Z","detectedPredicates":["attack.with-melee","attack.with-ranged"]}}}
