{"_id":"1718ec6cdf765a57","name":"Greater Penetrating Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Greater Weapon Focus; Penetrating Attack; Weapon Focus with the chosen weapon","benefit":"Choose one exotic weapon or weapon group with which you are proficient. When you make a successful attack with the chosen weapon, treat the target's damage reduction as 10 points lower when determining the result of your attack. This replaces the effect of Penetrating Attack for that weapon.","description":{"value":"Choose one exotic weapon or weapon group with which you are proficient. When you make a successful attack with the chosen weapon, treat the target's damage reduction as 10 points lower when determining the result of your attack. This replaces the effect of Penetrating Attack for that weapon."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","treeId":"2f720d8b061f9bd0","tags":["damage_reduction"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"selected_weapon_hit_rider","staticSheetPolicy":"exclude","manualResolution":false,"requiresRuntimeContext":true,"requiresSelectedChoice":true,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","choiceMetaStatus":"phase14_persistent_choice_seeded","rules":[{"type":"HIT_RIDER","id":"greater-penetrating-attack-dr-reduction","label":"Greater Penetrating Attack","targetEffectsOnHit":[{"type":"damageReductionAdjustment","value":-10,"duration":"thisDamageResolution"}],"selectedChoice":true}],"phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Weapon Master","status":"reviewed","notes":"Reviewed in tactical ranged/military cleanup."}},"choiceMeta":{"resolutio