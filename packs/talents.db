{"_id":"e5bef6ccacb51788","name":"Collective Visions","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"farseeing","benefit":"Developed by Krynda Draay, this talent is used by Jedi Covenant WatchCircles to sharpen their visions through the Force. When you use farseeing or a Force power or talent that has farseeing as a prerequisite, other Force-users with farseeing in their Force-power suite can aid another (page 151 of the Saga Edition core rulebook) on your Use the Force check as a reaction if they are within 6 squares of you.","description":"Developed by Krynda Draay, this talent is used by Jedi Covenant WatchCircles to sharpen their visions through the Force. When you use farseeing or a Force power or talent that has farseeing as a prerequisite, other Force-users with farseeing in their Force-power suite can aid another (page 151 of the Saga Edition core rulebook) on your Use the Force check as a reaction if they are within 6 squares of you.","class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"e99cfa9db8493573","tags":["action_economy","force","light_side","positioning","reaction"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"collective-visions","name":"Collective Visions","label":"Collective Visions","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"React / Note","description":"When you use Farseeing, or a Force Power or Talent that has Farseeing as a prerequisite, other Force-users with Farseeing in their Force Power Suite can Aid Another on your Use the Force check as a Reaction, if they are within 6 squares of you.","notes":"When you use Farseeing, or a Force Power or Talent that has Farseeing as a prerequisite, other Force-users with Farseeing in their Force Power Suite can Aid Another on your Use the Force check as a Reaction, if they are within 6 squares of you.","relatedSkills":[{"skill":"Use the Force"}],"resources":["Use the Force check"],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{}}],"rules":[],"mechanicsMode":"contextual","applicationScope":"force_lightsaber_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Jedi Consular","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":1,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."}},"summary":"Developed by Krynda Draay, this talent is used by Jedi Covenant WatchCircles to sharpen their visions through the Force.","source":"Knights of the Old Republic Campaign Guide","page":24},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.collective_visions","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.431Z","detectedPredicates":[],"runtimeImplemented":true,"implementationNote":"Implemented through ConsularTalentActions and the combat action tracker."}}}
{"_id":"e6c4f05db6ac6c06","name":"Master Advisor","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Skilled Advisor","benefit":"When you use the Skilled Advisor Talent, the ally you aid gains one temporary Force Point at the end of their next turn. If the Force Point is not spent before the end of the encounter, it is lost.","description":{"value":"When you use the Skilled Advisor Talent, the ally you aid gains one temporary Force Point at the end of their next turn. If the Force Point is not spent before the end of the encounter, it is lost."},"class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"152047d6ab7896ad","tags":["force","light_side","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"conditional_or_metadata","applicationScope":"temporary_force_point_grant","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true,"engineOwner":"Skill resolver / ally resource prompt","conditionSummary":"Skilled Advisor grants the aided ally one temporary Force Point at the end of their next turn.","recommendedAction":"Handle as an ally-targeted temporary Force Point grant tied to Skilled Advisor; no empty ActiveEffect or static modifier.","modifiers":[],"status":"talent_backcheck_user_text_2026_06_11","description":"Skilled Advisor grants the aided ally one temporary Force Point at the end of their next turn.","requiresSelectedChoice":false,"metadataPhase":"jedi-prestige-talent-backcheck","metadataNotes":"Updated from user-provided source text; non-automatable targeting/LOS/session adjudication remains GM/player confirmed.","rules":[{"type":"TALENT_RULE","id":"master_advisor","label":"Master Advisor","summary":"Skilled Advisor grants the aided ally one temporary Force Point at the end of their next turn.","action":"skilled-advisor","mode":"temporary_force_point_grant","text":"When you use the Skilled Advisor Talent, the ally you aid gains one temporary Force Poi