{"_id":"68e476fdeb434b01","name":"Relocate","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Safe Zone","benefit":"You can dismiss your Safe Zone as a Swift Action, ending its current effects. Any allies in the space your Safe Zone was occupying gain a +2 bonus to their Speed until the start of your next turn. When you use this Talent, you cannot create a new Safe Zone until the start of your next turn.","description":{"value":"You can dismiss your Safe Zone as a Swift Action, ending its current effects. Any allies in the space your Safe Zone was occupying gain a +2 bonus to their Speed until the start of your next turn. When you use this Talent, you cannot create a new Safe Zone until the start of your next turn."},"class":"4ee81a6708a516cd","costNumeric":null,"category":"Pathfinder","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.5989079457c8a3cf","name":"Safe Zone"}],"_source":"canonical-csv"},"treeId":"383ff8d392488cf8","tags":["action_economy","cover","mobility","positioning","recon","survival","swift_action","exploration"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"survival_exploration_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Swift Safe Zone dismissal card. Removed fake Reflex modifier/AE; this grants ally speed after zone dismissal, not owner defense.","phase25SurvivalExplorationCleanup":{"phase":"T25","tree":"Pathfinder","status":"combat_action_card","notes":"Swift Safe Zone dismissal card. Removed fake Reflex modifier/AE; this grants ally speed after zone dismissal, not owner defense."},"combatActions":[{"id":"safe-zone-relocate","name":"Relocate Safe Zone","label":"Relocate Safe Zone","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"You can dismiss your Safe Zone as a Swift Action, ending its current effects. Any allies in the space your Safe Zone was occupying gain a +2 bonus to their Speed until the start of your next turn. When you use this Talent, you cannot create a new Safe Zone until the start of your next turn.","notes":"You can dismiss your Safe Zone as a Swift Action, ending its current effects. Any allies in the space your Safe Zone was occupying gain a +2 bonus to their Speed until the start of your next turn. When you use this Talent, you cannot create a new Safe Zone until the start of your next turn.","relatedSkills":[],"resources":["Dismiss current Safe Zone","+2 Speed to allies in old zone until start of next turn"],"requiredContext":["Current Safe Zone exists","Cannot create another Safe Zone until start of next turn"],"targetHint":"Current Safe Zone","spendAction":true,"ruleData":{}}],"movementRules":[{"type":"ZONE_DISMISSAL_SPEED_BONUS","id":"relocate-safe-zone","value":2,"affected":"alliesInOldZone","duration":"untilStartOfNextTurn"}]},"summary":"You can dismiss your Safe Zone as a Swift Action, ending its current effects.","source":"Rebellion Era Campaign Guide","page":45},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.relocate"}}}
{"_id":"69420a9a5ff5d8b9","name":"Rapid Alchemy","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Asa standard action, you can perform minor alchemical alterations to a melee weapon you wield. For the remainder of the encounter, you gain a +2 equipment bonus on attack rolls with that weapon, Addition-ally, once before the end of the encounter, you can sacrifice this bonus as a free action to gain a +5 equipment bonus on a single damage roll you make with that weapon.","description":{"value":"Asa standard action, you can perform minor alchemical alterations to a melee weapon you wield. For the remainder of the encounter, you gain a +2 equipment bonus on attack rolls with that weapon, Addition-ally, once before the end of the encounter, you can sacrifice this bonus as a free action to gain a +5 equipment bonus on a single damage roll you make with that weapon."},"class":"1ba03b2d00245906","costNumeric":null,"category":"Sith Apprentice","treeId":"a67faf2ae089ab5d","tags":["crafting","dark_side","force","force_offense","melee","standard_action"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"name":"Rapid Alchemy","actionType":"standard","requiredTalent":"Rapid Alchemy","description":"As a Standard Action, you can perform minor alchemical alterations to a Melee Weapon you wield. For the remainder of the encounter, you gain a +2 Equipment bonus on attack rolls with that Weapon. Additionally, once before the end of the encounter, you can sacrifice this bonus as a Free Action to gain a +5 Equipment bonus on a single damage roll you make with that Weapon.","resolutionMode":"sithTalent","spendAction":true,"effects":[],"resources":["Melee weapon","Encounter buff"],"notes":"Choose a wielded melee weapon. It gains +2 Equipment bonus on attack rolls for the encounter until sacrificed.","manualResolution":false,"relatedSkills":[],"sithTalentAction":"rapidAlchemy","id":"rapid-alchemy","label":"Rapid Alchemy"},{"name":"Rapid Alchemy: Sacrifice Bonus","actionType":"free","requiredTalent":"Rapid Alchemy","description":"Sacrifice the active Rapid Alchemy +2 attack bonus as a Free Action to gain +5 Equipment bonus on one damage roll with that weapon.","resolutionMode":"sithTalent","spendAction":false,"effects":[],"resources":["Rapid Alchemy active","Once per encounter"],"notes":"Consumes the active Rapid Alchemy attack bonus and applies +5 to the next damage roll made with the chosen weapon.","manualResolution":false,"relatedSkills":[],"sithTalentAction":"rapidAlchemySacrifice","id":"rapid-alchemy-sacrifice","label":"Rapid Alchemy: Sacrifice Bonus"}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":false,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Sith Alchemy","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."},"contributesGenericBonus":false},"summary":"Asa standard action, you can perform minor alchemical alterations to a melee weapon you wield.","source":"Jedi Academy Training Manual","page":21},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.rapid_alchemy","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.415Z","detectedPredicates":["turn.once-per-round"],"forceTalentCleanup":{"phase":"T22","tree":"Sith Alchemy","status":"combat_action_card"}}}}
