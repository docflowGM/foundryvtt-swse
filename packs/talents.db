{"_id":"049820827d7ef32b","name":"Cover Fire","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Battle Analysis.","benefit":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus.","description":{"value":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.7df2e8e4f18dc909","name":"Battle Analysis"}],"_source":"canonical-csv"},"treeId":"798ed0945cbdac1c","tags":["positioning","ranged"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals."},"summary":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn.","source":"Saga Edition Core Rulebook","page":52},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.cover_fire","nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Follower/dependent-actor subsystem or GM/player managed","note