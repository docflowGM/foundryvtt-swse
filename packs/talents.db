{"_id":"7aa3eec9b7f748ef","name":"Escort Pilot","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"When a Vehicle that you are Piloting is adjacent to a Vehicle of Colossal size or smaller that is Piloted by an ally, both Vehicles gain a +10 bonus to their Damage Thresholds."},"benefit":"When a Vehicle that you are Piloting is adjacent to a Vehicle of Colossal size or smaller that is Piloted by an ally, both Vehicles gain a +10 bonus to their Damage Thresholds.","class":"","category":"","costNumeric":null,"treeId":"5f355ad4093d2bf8","tags":["action_economy","ally_support","pilot","positioning","support","sustained_damage","vehicle"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase16VehicleStarshipCleanup":{"status":"metadata_or_gm_player_managed","owner":"GM/player or future vehicle subsystem","notes":"No truthful automatic runtime owner in this pass; stale migrated modifiers/effects removed if present."}},"summary":"When a Vehicle that you are Piloting is adjacent to a Vehicle of Colossal size or smaller that is Piloted by an ally, both Vehicles gain a +10 bonus to their Damage Thresholds.","source":"Rebellion Era Campaign Guide","page":40},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.417Z","detectedPredicates":["proximity.ally-nearby","turn.once-per-round"]}}}
{"_id":"7aa4ca13a96d8770","name":"Ruthless","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":null,"benefit":"Once per encounter, when you drop a foe to 0 hit points or push an opponent to the bottom of the condition track, you can immediately take a bonus standard action.","description":"Once per encounter, when you drop a foe to 0 hit points or push an opponent to the bottom of the condition track, you can immediately take a bonus standard action.","class":"74fa04f5afb5f6e1","costNumeric":null,"category":"Assassin","treeId":"186daeee7bd65a69","tags":["action_economy","mobility","precision_damage","sniper","standard_action","stealth","pursuit"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","manualResolution":true,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","combatActions":[{"id":"ruthless-t31-reference","name":"Ruthless","label":"Ruthless","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, if you drop a foe to 0 hp or to the bottom of the track, you gain an extra standard action.","notes":"Once per encounter, if you drop a foe to 0 hp or to the bottom of the track, you gain an extra standard action.","relatedSkills":[],"resources":["Once per encounter"],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{}}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"ruthless-t31-context","label":"Ruthless","summary":"Once per encounter, if you drop a foe to 0 hp or to the bottom of the track, you gain an extra standard action."}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Assassin","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."}},"summary":"Once per encounter, when you drop a foe to 0 hit points or push an opponent to the bottom of the condition track, you can immediately take a bonus standard action.","source":"Scum and Villainy","page":29},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.ruthless","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.417Z","detectedPredicates":["turn.once-per-round"]}}}
{"_id":"7ab4fcbe5a8b7714","name":"Shaped Explosion","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Skilled Demolitionist","benefit":"You know how to set charges to direct a blast in a specific direction or manner. You can shape an explosion caused by explosives or mines that you set into a line or a cone instead of a radius. The length of the line is equal to 2 x the radius of the explosive blast, the length of the cone is equal to 3 x the radius of the blast, and either the line or the cone originates from the square where the explosives are placed.","description":{"value":"You know how to set charges to direct a blast in a specific direction or manner. You can shape an explosion caused by explosives or mines that you set into a line or a cone instead of a radius. The length of the line is equal to 2 x the radius of the explosive blast, the length of the cone is equal to 3 x the radius of the blast, and either the line or the cone originates from the square where the explosives are placed."},"class":"de3f367749b82fcf","costNumeric":null,"category":"Saboteur","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.c3a67c14c713a7a3","name":"Skilled Demolitionist"}],"_source":"canonical-csv"},"treeId":"8897a36d59662ee9","tags":["positioning"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase17TechEngineeringCleanup":{"status":"cleaned_future_runtime_context","owner":"future_explosive_area_resolver","notes":"Shapes explosives/mines into line or cone areas; this needs explosive placement/detonation context."}},"summary":"You know how to set charges to direct a blast in a specific direction or manner.","source":"Force Unleashed Campaign Guide","page":57},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.shaped_explosion","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.417Z","detectedPredicates":[]}}}
{"_id":"7acc479dee2d3b10","name":"Adept Negotiator","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a standard action, you can weaken the resolve of one enemy with your words. The target must have an Intelligence of 3 or higher and must be able to see, hear, and understand you. Make a Persuasion check; if the result equals or exceeds the target's Will Defense, it moves -1 step along the condition track. The target gets a +5 bonus to its Will Defense if it is higher level than you. If the target reaches the end of the track, it does not fall unconscious; instead, it cannot attack you or your allies for the remainder of the encounter unless you or one of your allies attacks it or one of its allies first. This is a mind-affecting effect.","description":"As a standard action, you can weaken the resolve of one enemy with your words. The target must have an Intelligence of 3 or higher and must be able to see, hear, and understand you. Make a Persuasion check; if the result equals or exceeds the target's Will Defense, it moves -1 step along the condition track. The target gets a +5 bonus to its Will Defense if it is higher level than you. If the target reaches the end of the track, it does not fall unconscious; instead, it cannot attack you or your allies for the remainder of the encounter unless you or one of your allies attacks it or one of its allies first. This is a mind-affecting effect.","class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"e99cfa9db8493573","tags":["action_economy","condition_removal","force","force_control","force_defense","force_offense","light_side","lightsaber","melee","mobility","positioning","skills","social","support","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"adept-negotiator","name":"Adept Negotiator","label":"Adept Negotiator","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Standard Action, you can weaken the resolve of one opponent with your words. The target must have an Intelligence of 3 or higher, and it must be able to see, hear, and understand you. Make a Persuasion check; if the result equals or exceeds the target's Will Defense, it moves -1 step along the Condition Track. The target gets a +5 bonus to its Will Defense if it is higher level than you.","notes":"As a Standard Action, you can weaken the resolve of one opponent with your words. The target must have an Intelligence of 3 or higher, and it must be able to see, hear, and understand you. Make a Persuasion check; if the result equals or exceeds the target's Will Defense, it moves -1 step along the Condition Track. The target gets a +5 bonus to its Will Defense if it is higher level than you.","relatedSkills":[{"skill":"Persuasion"}],"resources":["Persuasion check"],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{}}],"rules":[],"mechanicsMode":"contextual","applicationScope":"force_lightsaber_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Jedi Consular","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":1,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."}},"summary":"Standard action Persuasion vs. Will to move an intelligent enemy -1 condition step; reaching the end prevents it from attacking you or your allies unless provoked.","source":"Saga Edition Core Rulebook","page":39},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.adept_negotiator","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.417Z","detectedPredicates":["defense.against-melee","defense.reflex","defense.will","attack.with-melee","proximity.ally-nearby","turn.on-current-turn","turn.once-per-round"],"runtimeImplemented":true,"implementationNote":"Implemented through ConsularTalentActions and the combat action tracker.","adeptNegotiatorSchema":true,"conditionTrackOnly":true,"noHpDamage":true,"noPhysicalDamage":true}}}
{"_id":"7af4caf439358120","name":"Telekinetic Prodigy","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Telekinetic Savant","benefit":"When you take the Force Training feat and select move object as one of your Force powers, you can also select one extra power to add to your Force suite for free. This power must be one of the powers affected by the Telekinetic Savant talent. You can gain only one extra power each time you take the Force Training feat, regardless of how many times you choose the move object power.","description":"When you take the Force Training feat and select move object as one of your Force powers, you can also select one extra power to add to your Force suite for free. This power must be one of the powers affected by the Telekinetic Savant talent. You can gain only one extra power each time you take the Force Training feat, regardless of how many times you choose the move object power.","costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.ddacb8e4517da6b5","name":"Telekinetic Savant"}],"_source":"canonical-csv"},"treeId":"6ac3416fb6aada56","tags":["force","force_capacity","force_control","force_power_synergy","mobility","skill_substitution","telekinesis","telepathy"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"manual_or_runtime","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Alter","status":"cleaned_manual_or_future_runtime","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"When you take the Force Training feat and select move object as one of your Force powers, you can also select one extra power to add to your Force suite for free.","source":"Force Unleashed Campaign Guide","page":88},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.telekinetic_prodigy","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.419Z","detectedPredicates":[],"forceTalentCleanup":{"phase":"T22","tree":"Alter","status":"cleaned_manual_or_future_runtime"}}}}
{"_id":"7b23e0812d6a8985","name":"Skirmisher","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"If you move at least 2 squares before you attack and end your move in a different square from where you started, you gain a +1 bonus on attack rolls until the start of your next turn.","description":{"value":"If you move at least 2 squares before you attack and end your move in a different square from where you started, you gain a +1 bonus on attack rolls until the start of your next turn."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","treeId":"67b59e020c1660eb","tags":["mobility","positioning","precision"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"modifiers":[]},"summary":"If you move at least 2 squares before you attack and end your move in a different square from where you started, you gain a +1 bonus on attack rolls until the start of your next turn.","source":"Saga Edition Core Rulebook","page":46},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.skirmisher"}}}
{"_id":"7b56d0b92582ae88","name":"Blaster Turret I","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per encounter, as standard action you can create a blaster turret (Size Tiny, Initiative +4, Perception +4, Reflex Defense 10, 10 hp, Threshold 8) that can be mounted to any flat surface. The turret fires as a standard blaster pistol once per round, using your base attack bonus plus your Intelligence bonus and dealing 3d6 points of damage. The turret fires at any target you designate (a free action, once per round on your turn), though you must remain adjacent to the turret to control it. The turret is expended at the end of the encounter.","description":{"value":"Once per encounter, as standard action you can create a blaster turret (Size Tiny, Initiative +4, Perception +4, Reflex Defense 10, 10 hp, Threshold 8) that can be mounted to any flat surface. The turret fires as a standard blaster pistol once per round, using your base attack bonus plus your Intelligence bonus and dealing 3d6 points of damage. The turret fires at any target you designate (a free action, once per round on your turn), though you must remain adjacent to the turret to control it. The turret is expended at the end of the encounter."},"class":"de3f367749b82fcf","costNumeric":null,"category":"Saboteur","treeId":"92b30151b9b21109","tags":["action_economy","damage_reduction","force","force_control","force_defense","force_offense","mechanics","perception","positioning","ranged","skills","support","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"turret_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Turret","status":"cleaned_runtime_context","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":1,"notes":"Unsafe passive/ActiveEffect data removed. Talent is represented by action cards, attack options, hit/critical riders, or explicit manual metadata as appropriate."},"combatActions":[{"id":"create-blaster-turret","name":"Create Blaster Turret","label":"Create Blaster Turret","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, create a Tiny blaster turret mounted to a flat surface. It fires once per round as a standard blaster pistol using your BAB plus Intelligence bonus and deals 3d6 energy damage.","notes":"Once per encounter, create a Tiny blaster turret mounted to a flat surface. It fires once per round as a standard blaster pistol using your BAB plus Intelligence bonus and deals 3d6 energy damage.","relatedSkills":[{"skill":"Attack Roll","when":"Turret fires"}],"resources":["Once per encounter","Turret: Init +4, Perception +4, Reflex 10, HP 10, DT 8"],"requiredContext":[],"targetHint":"Flat surface / turret position"}],"manualResolution":true},"summary":"Once per encounter, as standard action you can create a blaster turret (Size Tiny, Initiative +4, Perception +4, Reflex Defense 10, 10 hp, Threshold 8) that can be mounted to any flat surface.","source":"Force Unleashed Campaign Guide","page":57},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.blaster_turret_i","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.419Z","detectedPredicates":["defense.reflex","attack.when-hit"]}}}
{"_id":"7bc10cb88a6a0c92","name":"Relentless","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Hunter's Mark, Hunter's Target.","benefit":"This Talent applies only to an opponent you've designated as your Hunter's Target. Any attack or effect originating from the target that would normally move you along the Condition Track does not, in fact, move you along the Condition Track.","description":{"value":"This Talent applies only to an opponent you've designated as your Hunter's Target. Any attack or effect originating from the target that would normally move you along the Condition Track does not, in fact, move you along the Condition Track."},"class":"336bba6d1e517c92","costNumeric":null,"category":"Bounty Hunter","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.907906934ba3c563","name":"Hunter's Target"}],"_source":"canonical-csv"},"treeId":"a47ed82a822e3962","tags":["condition_removal","evasion","pursuit","target-designation","fear","social"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"hunter_pursuit_fear_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals.","phase26HunterPursuitFearCleanup":{"phase":"T26","tree":"Bounty Hunter","status":"combat_action_card","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals."},"combatActions":[{"id":"relentless","name":"Relentless","label":"Relentless","actionType":"passive","cost":0,"manualReso