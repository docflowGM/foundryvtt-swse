{"_id":"9d1c806bdee12411","name":"Mandalorian Ferocity","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Dexterity 13, proficient in selected exotic weapon or weapon group","benefit":"Mandalorians can be ferocious fighters. Select one weapon group or exotic weapon you are proficient with. Once per encounter, when making more than one attack in a round, you can add one damage die to each successful hit with the selected weapon group or exotic weapon. You can take this talent more than once, selecting a different weapon group each time.","description":{"value":"Mandalorians can be ferocious fighters. Select one weapon group or exotic weapon you are proficient with. Once per encounter, when making more than one attack in a round, you can add one damage die to each successful hit with the selected weapon group or exotic weapon. You can take this talent more than once, selecting a different weapon group each time."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13}],"_source":"canonical-csv"},"treeId":"4b8857716e056f62","tags":["melee","ranged","damage_bonus","burst_damage","sustained_damage","once-per-encounter","weapon_training"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action_reference","applicationScope":"martial_protector_arena_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","combatActions":[{"id":"mandalorian-ferocity-t30-reference","name":"Mandalorian Ferocity","label":"Mandalorian Ferocity","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Mandalorians can be ferocious fighters. Select one weapon group or Exotic Weapon you are proficient with. Once per encounter, when making more than one attack in a round, you can add one damage die to each successful hit with the selected weapon group or Exotic Weapon.","notes":"Mandalorians can be ferocious fighters. Select one weapon group or Exotic Weapon you are proficient with. Once per encounter, when making more than one attack in a round, you can add one damage die to each successful hit with the selected weapon group or Exotic Weapon.","relatedSkills":[],"resources":["Once per encounter"],"requiredContext":["Triggering attack/damage result confirmed","Encounter use available"],"targetHint":"GM/player adjudicated target or context","spendAction":false,"ruleData":{}}],"rules":[{"type":"ATTACK_OPTION","id":"mandalorian-ferocity-multiattack-damage","label":"Mandalorian Ferocity","control":"flag","damageExtraWeaponDice":1,"summary":"Once per encounter, when making more than one attack in a round with the selected proficient weapon group/exotic weapon, add +1 damage die to each successful hit."}],"phase30MartialProtectorArenaCleanup":{"phase":"T30","tree":"Mandalorian Warrior","status":"reviewed_manual_or_runtime_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"T30 removed unsafe passive rows from martial/protector/arena/species leftovers and surfaced action, reaction, recovery, cover, and attack-rider context as truthful cards/rules."}},"summary":"Mandalorians can be ferocious fighters.","source":"Knights of the Old Republic Campaign Guide","page":38},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.mandalorian_ferocity","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.423Z","detectedPredicates":["attack.when-hit","turn.once-per-round"]}}}
{"_id":"9d235eba6b3e5daf","name":"Knockback","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When you score a critical hit against a target no more than two size categories larger than you are, you can choose to move that opponent 1 square in any direction as a free action. You cannot use this talent on an opponent that is being grabbed or grappled, and you cannot move your target into a solid object or another creature's fighting space.","description":{"value":"When you score a critical hit against a target no more than two size categories larger than you are, you can choose to move that opponent 1 square in any direction as a free action. You cannot use this talent on an opponent that is being grabbed or grappled, and you cannot move your target into a solid object or another creature's fighting space."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","treeId":"71e99c646b18d85c","tags":["mobility","positioning","precision"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"critical_hit_rider","staticSheetPolicy":"exclude","manualResolution":false,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","rules":[{"type":"CRITICAL_RIDER","id":"knockback-critical","label":"Knockback","targetEffectsOnCritical":[{"type":"forcedMovement","movement":"move","squares":1,"limit":"targetNoMoreThanTwoSizesLarger"}]}],"phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Critical Master","status":"reviewed","notes":"Reviewed in tactical ranged/military cleanup."}},"summary":"When you score a critical hit against a target no more than two size categories larger than you are, you can choose to move that opponent 1 square in any direction as a free action.","source":"Force Unleashed Campaign Guide","page":42},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.knockback","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.423Z","detectedPredicates":["attack.when-hit"]}}}
{"_id":"9dc39670f94a6ef2","name":"Master Negotiator","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Adept Negotiator.","benefit":"If you successfully use the Adept Negotiator Talent, your target moves an additional -1 step along the Condition Track. This is a Mind-Affecting effect.","description":"If you successfully use the Adept Negotiator Talent, your target moves an additional -1 step along the Condition Track. This is a Mind-Affecting effect.","class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.7acc479dee2d3b10","name":"Adept Negotiator"}],"_source":"canonical-csv"},"treeId":"e99cfa9db8493573","tags":["condition_removal","force","force_control","light_side","mobility"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"master-negotiator","name":"Master Negotiator","label":"Master Negotiator","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"If you successfully use the Adept Negotiator Talent, your target moves an additional -1 step along the Condition Track. This is a Mind-Affecting effect. You affect the Condition Track of the specific character (usually the Vehicle's Commander), not a Starship.","notes":"If you successfully use the Adept Negotiator Talent, your target moves an additional -1 step along the Condition Track. This is a Mind-Affecting effect. You affect the Condition Track of the specific character (usually the Vehicle's Commander), not a Starship.","relatedSkills":[],"resources":[],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[],"mechanicsMode":"contextual","applicationScope":"force_lightsaber_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true,"phase27JediLightsaberMysticCleanup":{"phase"