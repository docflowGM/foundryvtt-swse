{"_id":"616bc0afc5c847ea","name":"Get Down","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"As a reaction, when an ally is targeted by a ranged attack, you can enable that ally to drop prone immediately, imposing the normal -2 penalty for a ranged attack against a prone target to the triggering attack roll, as a free action."},"benefit":"As a reaction, when an ally is targeted by a ranged attack, you can enable that ally to drop prone immediately, imposing the normal -2 penalty for a ranged attack against a prone target to the triggering attack roll, as a free action.","class":"","category":"","costNumeric":null,"treeId":"3a785c985eae4d00","tags":["action_economy","ally_support","ambush_defense","mobility","offense_ranged","positioning","reaction","support","sustained_damage","battlefield_control","initiative"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"get-down-t31-reference","name":"Get Down","label":"Get Down","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Reaction, when an ally is targeted by a ranged attack, you can enable that ally to drop Prone immediately (imposing the normal -5 penalty for a ranged attack against a Prone target to the triggering attack roll) as a Free Action.","notes":"As a Reaction, when an ally is targeted by a ranged attack, you can enable that ally to drop Prone immediately (imposing the normal -5 penalty for a ranged attack against a Prone target to the triggering attack roll) as a Free Action.","relatedSkills":[],"resources":["Ally context","Target context","Prone context"],"requiredContext":["Triggering event confirmed","Valid target confirmed","Valid ally confirmed","Prone state handled through combat status/GM context"],"targetHint":"GM/player adjudicated target or context","spendAction":true,"ruleData":{}}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"get-down-t31-context","label":"Get Down","summary":"As a Reaction, when an ally is targeted by a ranged attack, you can enable that ally to drop Prone immediately (imposing the normal -5 penalty for a ranged attack against a Prone target to the triggering attack roll) as a Free Action."}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Anticipation","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."}},"summary":"As a reaction to a ranged attack against an ally, let the ally drop prone before the attack resolves.","source":"Galaxy at War","page":18},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.414Z","detectedPredicates":["proximity.ally-nearby","turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Follower/dependent-actor subsystem or GM/player managed","note":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals."}}}}
{"_id":"618472c99f355949","name":"Long Stride","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Your Speed increases by 2 squares if you are wearing Light Armor or no Armor. If you have a natural Fly, Climb, or Swim Speed, it increases by 2 squares as well. You cannot use this Talent if you are wearing Medium Armor or Heavy Armor.","description":{"value":"Your Speed increases by 2 squares if you are wearing Light Armor or no Armor. If you have a natural Fly, Climb, or Swim Speed, it increases by 2 squares as well.\n\nYou cannot use this Talent if you are wearing Medium Armor or Heavy Armor."},"class":"b5bed5d1b5f42958","costNumeric":null,"category":"Scout","treeId":"7c47d36dc1f77d9c","tags":["action_economy","ambush","mobility","support","sustained_damage","survival","exploration"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"survival_exploration_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Conditional speed increase depends on armor and natural movement modes; no unconditional Speed mutation.","phase25SurvivalExplorationCleanup":{"phase":"T25","tree":"Master Scout","status":"movement_reference","notes":"Conditional speed increase depends on armor and natural movement modes; no unconditional Speed mutation."},"combatActions":[{"id":"long-stride-reference","name":"Long Stride","label":"Long Stride","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Your Speed increases by 2 squares if you are wearing Light Armor or no Armor. If you have a natural Fly, Climb, or Swim Speed, it increases by 2 squares as well.\n\nYou cannot use this Talent if you are wearing Medium Armor or Heavy Armor.","notes":"Your Speed increases by 2 squares if you are wearing Light Armor or no Armor. If you have a natural Fly, Climb, or Swim Speed, it increases by 2 squares as well.\n\nYou cannot use this Talent if you are wearing Medium Armor or Heavy Armor.","relatedSkills":[],"resources":["+2 squares to Speed in light/no armor","+2 natural Fly/Climb/Swim if present"],"requiredContext":["Wearing light armor or no armor"],"targetHint":"","spendAction":false,"ruleData":{}}],"movementRules":[{"type":"CONDITIONAL_SPEED_BONUS","id":"long-stride","value":2,"allowedArmor":["none","light"],"includesNaturalMovementModes":true}]},"summary":"Your Speed increases by 2 squares if you are wearing Light Armor or no Armor. If you have a natural Fly, Climb, or Swim Speed, it increases by 2 squares as well.","source":"Saga Edition Core Rulebook","page":50},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.long_stride"}}}
{"_id":"627bd3abd30b973f","name":"Power of the Dark Side","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You allow your hatred to fuel your attacks. Whenever you spend a Force Point to modify an attack roll, you may choose to roll an additional bonus die and take the best result. However, doing so increases your Dark Side Score by 1.","description":"You allow your hatred to fuel your attacks. Whenever you spend a Force Point to modify an attack roll, you may choose to roll an additional bonus die and take the best result. However, doing so increases your Dark Side Score by 1.","costNumeric":null,"treeId":"de95d37c72b1c4cd","tags":["action_economy","condition_removal","damage_reduction","dark_side","force","force_capacity","force_control","force_defense","force_multiplier","force_offense","force_point_spend","force_power_synergy","investigation","knowledge","light_side","lightsaber","melee","mobility","move_action","offense_melee","offense_ranged","perception","positioning","ranged","resource_spend","scaling","skills","standard_action","stealth","support","sustained_damage","swift_action","use_the_force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"power-of-the-dark-side","name":"Power of the Dark Side","label":"Power of the Dark Side","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Charisma 13 As a Standard Action, you grant yourself and all allies within 6 squares of you a +1 Force bonus to all Defenses until the end of the encounter. These bonuses are lost if you fall unconscious or die. Affected allies that move out of range lose the benefits for as long as they remain out of range. Prerequisite: Once per day, you can use a Force Power that normally takes a Standard Action or a Move Action as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Sometimes your anger consumes you. As a Swift Action, you can take a -5 penalty to your Will Defense to gain a +2 Force bonus on attack rolls. The penalty and bonus last until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever an effect would normally move you down the Condition Track, you may spend a Force Point and increase your Dark Side Score by 1 to negate that movement down the Condition Track. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Once per encounter as a Swift Action, you can return one Force Power with the [Dark Side] descriptor to your Force Power Suite without spending a Force Point. You can select this Talent multiple times. Each time you select it, you can use it one additional time per encounter. Reference Book: Star Wars Saga Edition Threats of the Galaxy As a Standard Action, you can spend a Force Point to drain the knowledge of an opponent you touch; you must succeed on a Use the Force check (DC equal to the target's Will Defense) to activate this Talent, and if you fail to activate this Talent, you may not try again on the same target for one day. If successful, you immediately become Trained in one Skill that the target is Trained in; if you are already Trained in that Skill, you instead gain Skill Focus in that Skill. This effect lasts for one day. Additionally, your target moves -1 Persistent step along the Condition Track, and the Persistent Condition can be removed only by resting for 8 hours. Additionally, you can choose to instead sift through the mind of the target, looking for a specific piece of knowledge or information. Doing so requires you to make a Perception check against the target's Will Defense; success indicates that you pull the relevant information from the target's mind. When you do so, you do not gain the bonus Trained Skill or Skill Focus normally granted by this Talent, but otherwise the Talent functions as normal. Using this Talent increases your Dark Side Score by 1. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual When you die, you become a Dark Side Spirit until the end of the encounter. You continue to occupy a space in this form, but other creatures can occupy the same space or move through your space without impediment. As a Standard Action, you can attempt to possess an adjacent target. You must succeed on a Use the Force check against an adjacent target's Will Defense. If your check result equals or exceeds the target's Will Defense, you deal 8d6 points of Stun damage to the target; if you reduce the target to 0 Hit Points or move it to the bottom of the Condition Track with this attack, you possess the target as though it were a willing host. Alternatively, as a Standard Action, you can transfer your essence into a single adjacent object, such as a Holocron or a Lightsaber. If you do so, you lie dormant within the object until another creature attempts to use that object, at which time you can emerge and attempt to possess the creature, as described above. If you do not possess a creature or object within 10 rounds of manifesting as a Dark Side Spirit, your spirit dissipates and ceases to exist. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: When you roll a Natural 20 on a Use the Force check to activate a Force Power that directly deals damage to a target, you can choose not to regain all of your spent Force Powers as normal and instead the targets damaged by the Force Power take half that damage again at the start of their next turn. Only Force Powers that directly damage the target are subject to this Talent, including Corruption, Force Blast, Force Grip, Force Lightning, Force Slam, Force Thrust (only when spending a Force Point), and Repulse (only when spending a Force Point). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: You can create balls of unnatural energy, enabling you to make a ranged attack roll against the Reflex Defense of one target within 12 squares and line of sight, dealing 2d6 points of energy damage to the target on a successful attack. Using this Talent increases your Dark Side Score by 1. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Swift Power When using a Force Power that directly inflicts damage, you treat the target's Damage Threshold as though it were 5 points lower when determining if the target moves along the Condition Track. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: Whenever your character moves 3 or more squares in a round you gain Concealment; you may choose not to use this Talent when you move.","notes":"Charisma 13 As a Standard Action, you grant yourself and all allies within 6 squares of you a +1 Force bonus to all Defenses until the end of the encounter. These bonuses are lost if you fall unconscious or die. Affected allies that move out of range lose the benefits for as long as they remain out of range. Prerequisite: Once per day, you can use a Force Power that normally takes a Standard Action or a Move Action as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Sometimes your anger consumes you. As a Swift Action, you can take a -5 penalty to your Will Defense to gain a +2 Force bonus on attack rolls. The penalty and bonus last until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever an effect would normally move you down the Condition Track, you may spend a Force Point and increase your Dark Side Score by 1 to negate that movement down the Condition Track. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Once per encounter as a Swift Action, you can return one Force Power with the [Dark Side] descriptor to your Force Power Suite without spending a Force Point. You can select this Talent multiple times. Each time you select it, you can use it one additional time per encounter. Reference Book: Star Wars Saga Edition Threats of the Galaxy As a Standard Action, you can spend a Force Point to drain the knowledge of an opponent you touch; you must succeed on a Use the Force check (DC equal to the target's Will Defense) to activate this Talent, and if you fail to activate this Talent, you may not try again on the same target for one day. If successful, you immediately become Trained in one Skill that the target is Trained in; if you are already Trained in that Skill, you instead gain Skill Focus in that Skill. This effect lasts for one day. Additionally, your target moves -1 Persistent step along the Condition Track, and the Persistent Condition can be removed only by resting for 8 hours. Additionally, you can choose to instead sift through the mind of the target, looking for a specific piece of knowledge or information. Doing so requires you to make a Perception check against the target's Will Defense; success indicates that you pull the relevant information from the target's mind. When you do so, you do not gain the bonus Trained Skill or Skill Focus normally granted by this Talent, but otherwise the Talent functions as normal. Using this Talent increases your Dark Side Score by 1. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual When you die, you become a Dark Side Spirit until the end of the encounter. You continue to occupy a space in this form, but other creatures can occupy the same space or move through your space without impediment. As a Standard Action, you can attempt to possess an adjacent target. You must succeed on a Use the Force check against an adjacent target's Will Defense. If your check result equals or exceeds the target's Will Defense, you deal 8d6 points of Stun damage to the target; if you reduce the target to 0 Hit Points or move it to the bottom of the Condition Track with this attack, you possess the target as though it were a willing host. Alternatively, as a Standard Action, you can transfer your essence into a single adjacent object, such as a Holocron or a Lightsaber. If you do so, you lie dormant within the object until another creature attempts to use that object, at which time you can emerge and attempt to possess the creature, as described above. If you do not possess a creature or object within 10 rounds of manifesting as a Dark Side Spirit, your spirit dissipates and ceases to exist. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: When you roll a Natural 20 on a Use the Force check to activate a Force Power that directly deals damage to a target, you can choose not to regain all of your spent Force Powers as normal and instead the targets damaged by the Force Power take half that damage again at the start of their next turn. Only Force Powers that directly damage the target are subject to this Talent, including Corruption, Force Blast, Force Grip, Force Lightning, Force Slam, Force Thrust (only when spending a Force Point), and Repulse (only when spending a Force Point). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: You can create balls of unnatural energy, enabling you to make a ranged attack roll against the Reflex Defense of one target within 12 squares and line of sight, dealing 2d6 points of energy damage to the target on a successful attack. Using this Talent increases your Dark Side Score by 1. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Swift Power When using a Force Power that directly inflicts damage, you treat the target's Damage Threshold as though it were 5 points lower when determining if the target moves along the Condition Track. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: Whenever your character moves 3 or more squares in a round you gain Concealment; you may choose not to use this Talent when you move.","relatedSkills":[{"skill":"Use the Force"}],"resources":["May require Force Point","Once per encounter","Once per day","Dark Side / ally defense or swift power context; verify exact source text"],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Dark Side","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"When spending a Force Point on an attack roll, roll one extra bonus die and keep the best; doing so increases your Dark Side Score by 1.","source":"Saga Edition Core Rulebook","page":101},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.power_of_the_dark_side","forceTalentCleanup":{"phase":"T22","tree":"Dark Side","status":"combat_action_card"}}}}
{"_id":"629a0efa292511b7","name":"Trakata","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Weapon Focus (lightsabers); Weapon Specialization (lightsabers); base attack bonus +12","benefit":"When wielding a lightsaber, you may spend two swift actions to make a Deception check to feint in combat by quickly shutting off and reigniting the blade.","description":"When wielding a lightsaber, you may spend two swift actions to make a Deception check to feint in combat by quickly shutting off and reigniting the blade.","class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"2bc2572e852832e4","tags":["action_economy","lightsaber","melee","skills","social","force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"trakata","name":"Trakata","label":"Trakata","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"By harnessing the unique characteristics of a Lightsaber, you can catch your opponent off guard by quickly shutting off and reigniting the blade. When wielding a Lightsaber, you may spend two Swift Actions to make a Deception check to Feint in combat.","notes":"By harnessing the unique characteristics of a Lightsaber, you can catch your opponent off guard by quickly shutting off and reigniting the blade. When wielding a Lightsaber, you may spend two Swift Actions to make a Deception check to Feint in combat.","relatedSkills":[{"skill":"Deception"}],"resources":["Deception check","Lightsaber context"],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{}}],"rules":[],"mechanicsMode":"contextual","applicationScope":"force_lightsaber_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Lightsaber Forms","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":1,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."}},"talent_tree":"Lightsaber Forms","tree":"Lightsaber Forms","summary":"Spend two swift actions to feint with a lightsaber using Deception.","source":"Saga Edition Core Rulebook","page":219},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.trakata","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.414Z","detectedPredicates":[],"lightsaberFormImplementation":{"status":"active-form-only","rule":"Only one Lightsaber Form can be active at a time; inactive forms grant no benefits.","updated":"2026-06-11"}}}}
{"_id":"62d461ae3b0fcfa9","name":"Move Massive Object","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Telekinetic Power, move object","benefit":"When you successfully use the move object power to move an object of Large size or bigger, you can make an area attack with the object instead of throwing it at or dropping it on a single target, as normal for the power. You must spend a Force Point when you activate the power to do this, and the area you target is based on the size of the object: Large, 2x2; Huge, 3x3; Gargantuan, 4x4; Colossal and larger, 6x6. When you use move object to make an area attack with the object you are moving, you compare your Use the Force check to the Reflex Defense of each creature, droid, and vehicle in the target area. If your check equals or exceeds the target's Reflex Defense, it takes damage from the object (as determined by the move object power). Otherwise, the target takes half damage. This is an area effect.","description":{"value":"When you successfully use the move object power to move an object of Large size or bigger, you can make an area attack with the object instead of throwing it at or dropping it on a single target, as normal for the power. You must spend a Force Point when you activate the power to do this, and the area you target is based on the size of the object: Large, 2x2; Huge, 3x3; Gargantuan, 4x4; Colossal and larger, 6x6. When you use move object to make an area attack with the object you are moving, you compare your Use the Force check to the Reflex Defense of each creature, droid, and vehicle in the target area. If your check equals or exceeds the target's Reflex Defense, it takes damage from the object (as determined by the move object power). Otherwise, the target takes half damage. This is an area effect."},"costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.11cae48e1213c407","name":"Telekinetic Power"}],"_source":"canonical-csv"},"treeId":"6ac3416fb6aada56","tags":["battlefield_control","force","force_control","force_defense","force_offense","mobility","skill_substitution","telekinesis","telepathy","use_the_force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"manual_or_runtime","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Alter","status":"cleaned_manual_or_future_runtime","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"source":"Legacy Era Campaign Guide","page":55},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.move_massive_object","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.414Z","detectedPredicates":["defense.reflex"],"forceTalentCleanup":{"phase":"T22","tree":"Alter","status":"cleaned_manual_or_future_runtime"}}}}
{"_id":"62d47b8982b6591e","name":"Powerful Friends","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Connections, Influential Friends","benefit":"You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful friend and take 20 on one Persuasion check, with no increase in the time needed to make the check.","description":{"value":"You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful friend and take 20 on one Persuasion check, with no increase in the time needed to make the check."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.471f4294820ce5ec","name":"Influential Friends"}],"_source":"canonical-csv"},"treeId":"b5bb4154688c66ab","tags":["skills","social"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed","notes":"The talent requires target, ally, line-of-sight, action timing, encounter state, or GM judgment and should not alter permanent actor values.","combatActions":[{"id":"powerful-friends","name":"Powerful Friends","label":"Powerful Friends","actionType":"free","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, invoke your powerful contact and Take 20 on one Persuasion check with no increase in time required.","notes":"Once per encounter, invoke your powerful contact and Take 20 on one Persuasion check with no increase in time required.","relatedSkills":[{"skill":"Persuasion"}],"resources":["Once per encounter","Take 20"],"requiredContext":[],"targetHint":"Persuasion check context","spendAction":true,"ruleData":{}}],"manualResolution":true,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Lineage","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"You have a powerful contact who has an extended sphere of influence.","source":"Force Unleashed Campaign Guide","page":26},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.powerful_friends","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.414Z","detectedPredicates":["turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"GM/player managed","note":"The talent requires target, ally, line-of-sight, action timing, encounter state, or GM judgment and should not alter permanent actor values."}}}}
