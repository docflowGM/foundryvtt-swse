{"_id":"e15a3408b9474354","name":"Jury-Rigger","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You may reroll any Mechanics check made to accomplish a jury-rigged repair, but you must accept the result of the reroll even if it is worse.","description":{"value":"You may reroll any Mechanics check made to accomplish a jury-rigged repair, but you must accept the result of the reroll even if it is worse."},"class":"b5bed5d1b5f42958","costNumeric":null,"category":"Scout","treeId":"7c47d36dc1f77d9c","tags":["action_economy","evasion","heavy_weapon","mechanics","perception","positioning","skills","social","support","survival","exploration"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"survival_exploration_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Mechanics Jury-Rig reroll exposed as a skill action card.","phase25SurvivalExplorationCleanup":{"phase":"T25","tree":"Master Scout","status":"skill_reroll_card","notes":"Mechanics Jury-Rig reroll exposed as a skill action card."},"combatActions":[{"id":"jury-rigger-reroll","name":"Jury-Rigger: Reroll Mechanics","label":"Jury-Rigger: Reroll Mechanics","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"You may reroll any Mechanics check made to Jury-Rig. You must, however, accept the result of the reroll, even if it is worse.","notes":"You may reroll any Mechanics check made to Jury-Rig. You must, however, accept the result of the reroll, even if it is worse.","relatedSkills":[{"skill":"mechanics","when":"Jury-Rig check"}],"resources":["Must accept reroll"],"requiredContext":["Mechanics check made to Jury-Rig"],"targetHint":"Self","spendAction":true,"ruleData":{}}],"skillRules":[{"type":"SKILL_REROLL","id":