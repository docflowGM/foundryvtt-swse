{"_id":"603e7e5d628a435d","name":"Make an Example","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":"Whenever you hit with an attack and deal enough damage to exceed a target's damage threshold, that target takes a -5 penalty to attack rolls against you until the end of your next turn. This is a mind-affecting effect.","benefit":"Whenever you hit with an attack and deal enough damage to exceed a target's damage threshold, that target takes a -5 penalty to attack rolls against you until the end of your next turn. This is a mind-affecting effect.","class":"","category":"","costNumeric":null,"treeId":"e6a9c40b900847bd","tags":["action_economy","fear","mobility","persuasion","positioning","skills","social","standard_action","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"staticSheetPolicy":"exclude","applicationScope":"social_commander_runtime_context","requiresRuntimeContext":true,"requiresSelectedChoice":false,"combatActions":[{"id":"make-an-example","name":"Make an Example","label":"Make an Example","actionType":"standard","cost":1,"manualResolution":false,"resolutionMode":"auto","useLabel":"Roll / Use","description":{"resources":["Mind-affecting"],"targetHint":"One enemy within 12 squares and line of sight","when":"Persuasion vs Will Defense"},"notes":{"resources":["Mind-affecting"],"targetHint":"One enemy within 12 squares and line of sight","when":"Persuasion vs Will Defense"},"relatedSkills":[{"skill":"Choose one enemy within 12 squares and line of sight; make Persuasion against Will Defense. On success, the target can take only Move and Swift Actions until the end of your next turn; this ends if you attack the target.","when":""}],"resources":[],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{},"skillKey":"Choose one enemy within 12 squares and line of sight; make Persuasion against Will Defense. On success, the target can take only Move and Swift Actions until the end of your next turn; this ends if you attack the target."}],"mechanicsMode":"combat_action","manualResolution":false,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Revolutionary","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"Exceed a target's damage threshold to give it -5 on attacks against you until the end of your next turn.","source":"Galaxy of Intrigue","page":22},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.414Z","detectedPredicates":["defense.will","attack.when-hit"]}}}
