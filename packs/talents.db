{"_id":"76ff0ba56aa3864b","name":"Inquisition","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You are particularly adept at dealing with Force-sensitive foes. You gain a +1 bonus on attack rolls and deal +1 die of damage against targets that have the Force Sensitivity feat.","description":{"value":"You are particularly adept at dealing with Force-sensitive foes. You gain a +1 bonus on attack rolls and deal +1 die of damage against targets that have the Force Sensitivity feat."},"class":"289fcf920ef0e184","costNumeric":null,"category":"Force Adept","treeId":"a6ee1a0c534cbc73","tags":["force","force_capacity","force_offense","force_training","persuasion"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_or_contextual","applicationScope":"force_adept_talent_runtime","staticSheetPolicy":"allow_runtime_only","manualResolution":false,"modifiers":[],"notes":"Attack and damage bonus only against Force-sensitive targets; punt target adjudication.","combatActions":[{"id":"inquisition","name":"Inquisition","label":"Inquisition","actionType":"passive","cost":0,"manualResolution":false,"resolutionMode":"forceAdeptTalent","useLabel":"Reference","description":"You are particularly adept at dealing with Force-sensitive foes. You gain a +1 bonus on attack rolls and deal +1 die of damage against targets that have the Force Sensitivity feat.","notes":"Attack/damage roller applies this when the target has Force Sensitivity and the target actor is available.","relatedSkills":[],"resources":["Force-sensitive target"],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{"forceAdeptTalentAction":"inquisition"},"forceAdeptTalentAction":"inquisition"}],"rules":[{"type":"ATTACK_AND_DAMAGE_CONTEXT","id":"inquisition-force-sensitive-target","label":"Inquisition","attackModifier":1,"damageExtraWeaponDice":1,"requiresTargetFeat":"Force Sensitivity","summary":"You are particularly adept at dealing with Forc