{"_id":"45c4e72d74c44acb","name":"Mystical Link","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"As a standard action, make a DC 30 Use the Force check. If successful, gain one benefit selected by the Gamemaster: return one Force power to your Force suite; gain one Force Point that is lost if not spent before the end of the encounter; gain an additional use of a Force-related talent or feat normally restricted to once per encounter; or roll an additional die when making a Force check and select the highest die rolled."},"benefit":"As a standard action, make a DC 30 Use the Force check. If successful, gain one benefit selected by the Gamemaster: return one Force power to your Force suite; gain one Force Point that is lost if not spent before the end of the encounter; gain an additional use of a Force-related talent or feat normally restricted to once per encounter; or roll an additional die when making a Force check and select the highest die rolled.","class":"","category":"","costNumeric":null,"treeId":"e35ee41362604227","tags":["action_economy","balance","damage_reduction","force","standard_action","support","survivability","use_the_force","will_defense","healing"],"executionModel":"ACTIVE","subType":"TALENT_ACTION","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"gm_selected_runtime_benefit","staticSheetPolicy":"exclude","manualResolution":true,"modifiers":[],"notes":"DC 30 Use the Force check produces GM-selected benefit; no fixed static bonus.","combatActions":[{"id":"mystical-link","name":"Mystical Link","actionType":"standard","requiredTalent":"Mystical Link","description":"The Force guides you in unexpected ways. As a Standard Action, make a DC 30 Use the Force check. If the check is successful, you gain one of the following benefits, as selected by the Gamemaster:","resolutionMode":"forceAdeptTalent","spendAction":true,"effects":[],"resources":["Use the Force","Force Power Suite","Bonus Force Point"],"notes":"Standard Action DC 30 Use the Force; on success GM selects one Mystical Link benefit.","manualResolution":false,"relatedSkills":["useTheForce"],"forceAdeptTalentAction":"mysticalLink","label":"Mystical Link","useLabel":"Use"}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"mystical-link-t31-context","label":"Mystical Link","summary":"The Force guides you in unexpected ways. As a Standard Action, make a DC 30 Use the Force check. If the check is successful, you gain one of the following benefits, as selected by the Gamemaster:"}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Force Adept","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."},"requiresRuntimeContext":true,"actionType":"standard","resolutionMode":"forceAdeptTalent","forceAdeptTalentAction":"mysticalLink","implementationDeferred":false},"summary":"As a standard action, make a DC 30 Use the Force check.","source":"Unknown Regions","page":30},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.411Z","detectedPredicates":["turn.once-per-round"],"forcePrestigeCleanup":{"phase":"T9","status":"manual_or_runtime","scope":"gm_selected_runtime_benefit"},"backchecked":true,"lastBackcheck":"force-adept-force-item-batch"}}}
{"_id":"45d8f7a583314692","name":"Draw a Bead","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Precision Shot, base attack bonus +10","description":{"value":"Once per round, you can spend a single swift action to designate a single enemy who is not within point-blank range. When you make a successful ranged attack roll that deals damage against the designated enemy, add your Dexterity bonus, minimum +1, to the damage roll. This effect lasts until the target is unconscious, dead, or leaves your line of sight. You can have only one enemy designated in this manner."},"benefit":"Once per round, you can spend a single swift action to designate a single enemy who is not within point-blank range. When you make a successful ranged attack roll that deals damage against the designated enemy, add your Dexterity bonus, minimum +1, to the damage roll. This effect lasts until the target is unconscious, dead, or leaves your line of sight. You can have only one enemy designated in this manner.","class":"","category":"","costNumeric":null,"treeId":"d203a51d6d0a4c65","tags":["action_economy","offense_ranged","positioning","precision_damage","ranged","sniper","swift_action","targeting"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"Once per round, designate a distant enemy; damaging it with a ranged attack adds your Dexterity bonus to damage until the designation ends.","source":"Galaxy at War","page":31},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.411Z","detectedPredicates":["defense.reflex","attack.with-ranged","turn.once-per-round"]}}}
{"_id":"4635850263c7bf94","name":"Misplaced Loyalty","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Dirty Tactics","benefit":"As a swift action once per turn, you can make a Persuasion check against the Will Defense of all opponents within your line of sight. If successful, a target cannot attack you if one of your allies is within 6 squares of you. You may not use this talent in the same round as the soldier's Draw Fire talent. This effect lasts until the beginning of your next turn.","description":{"value":"As a swift action once per turn, you can make a Persuasion check against the Will Defense of all opponents within your line of sight. If successful, a target cannot attack you if one of your allies is within 6 squares of you. You may not use this talent in the same round as the soldier's Draw Fire talent. This effect lasts until the beginning of your next turn."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.1e7a0010a589b870","name":"Dirty Tactics"}],"_source":"canonical-csv"},"treeId":"e91cc675fbf9ba6e","tags":["positioning","skills","social","support","intrigue","deception","control"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"misplaced-loyalty-t31-reference","name":"Misplaced Loyalty","label":"Misplaced Loyalty","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Swift Action once per turn, you can make a Persuasion check against the Will Defense of all opponents within your line of sight. If successful, a target cannot attack you if one of your allies is within 6 squares of you.","notes":"As a Swift Action once per turn, you can make a Persuasion check against the Will Defense of all opponents within your line of sight. If successful, a target cannot attack you if one of your allies is within 6 squares of you.","relatedSkills":[{"skill":"Persuasion"}],"resources":["Once per turn","Target context","Line of sight"],"requiredContext":["Valid target confirmed","Line of sight confirmed","Range/square distance confirmed"],"targetHint":"GM/player adjudicated target or context","spendAction":true,"ruleData":{}}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"misplaced-loyalty-t31-context","label":"Misplaced Loyalty","summary":"As a Swift Action once per turn, you can make a Persuasion check against the Will Defense of all opponents within your line of sight. If successful, a target cannot attack you if one of your allies is within 6 squares of you."}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Disgrace","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."}},"summary":"As a swift action once per turn, you can make a Persuasion check against the Will Defense of all opponents within your line of sight.","source":"Scum and Villainy","page":14},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.misplaced_loyalty","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.411Z","detectedPredicates":["defense.will"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Follower/dependent-act