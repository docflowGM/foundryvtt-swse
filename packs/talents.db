{"_id":"001ae84d5862af55","name":"Oath of Duty","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When an ally within 12 squares of you and within your line of sight hits with a lightsaber attack, you gain bonus hit points equal to 3 x your class level until the end of your next turn. Damage is subtracted from the bonus hit points first, and any bonus hit points remaining at the end of the encounter go away. Bonus hit points from different sources do not stack.","description":{"value":"When an ally within 12 squares of you and within your line of sight hits with a lightsaber attack, you gain bonus hit points equal to 3 x your class level until the end of your next turn. Damage is subtracted from the bonus hit points first, and any bonus hit points remaining at the end of the encounter go away. Bonus hit points from different sources do not stack."},"class":"ec505163e5647cc6","costNumeric":null,"category":"Imperial Knight","treeId":"8048efd85ae61101","tags":["defense","force","lightsaber","melee","offense_melee","positioning","support","ally-trigger"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"runtime_ally_trigger","staticSheetPolicy":"exclude","manualResolution":true,"modifiers":[],"notes":"Ally within 12/LOS hits with lightsaber; temporary HP until next turn.","combatActions":[{"id":"oath-of-duty-t31-reference","name":"Oath of Duty","label":"Oath of Duty","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"When an ally within 12 squares of you and within your line of sight hits with a Lightsaber attack, you gain bonus Hit Points equal to 3 x your Class Level until the end of your next turn. Damage is subtracted from the bonus Hit Points first, and any bonus Hit Points remaining at the end of the encounter go away. Bonus Hit Points from different sources do not stack.","notes":"When an ally within 12 squares of you and within your line of sight hits with a Lightsaber attack, you gain bonus Hit Points equal to 3 x your Class Level until the end of your next turn. Damage is subtracted from the bonus Hit Points first, and any bonus Hit Points remaining at the end of the encounter go away. Bonus Hit Points from different sources do not stack.","relatedSkills":[],"resources":["Ally context","Line of sight"],"requiredContext":["Valid ally confirmed","Line of sight confirmed","Range/square distance confirmed"],"targetHint":"GM/player adjudicated target or context","spendAction":false,"ruleData":{}}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"oath-of-duty-t31-context","label":"Oath of Duty","summary":"When an ally within 12 squares of you and within your line of sight hits with a Lightsaber attack, you gain bonus Hit Points equal to 3 x your Class Level until the end of your next turn. Damage is subtracted from the bonus Hit Points first, and any bonus Hit Points remaining at the end of the encou"}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Knight's Resolve","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."},"requiresRuntimeContext":true},"summary":"When an ally within 12 squares of you and within your line of sight hits with a lightsaber attack, you gain bonus hit points equal to 3 x your class level until the end of your next turn.","source":"Legacy Era Campaign Guide","page":45},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.oath_of_duty","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.402Z","detectedPredicates":["attack.when-hit"],"forcePrestigeCleanup":{"phase":"T9","status":"manual_or_runtime","scope":"runtime_ally_trigger"}}}}
{"_id":"008b28849b74234d","name":"Dark Healing","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":null,"benefit":"You can spend a Force Point to heal wounds by drawing life energy from another creature within 6 squares of you. Using this ability is a Standard Action, and you must succeed on a ranged attack roll. If the attack equals or exceeds the target's Fortitude Defense, you deal 1d6 points of damage per Class Level to the target, and you heal an equal amount of damage. If the attack fails, there is no effect.","description":{"value":"You can spend a Force Point to heal wounds by drawing life energy from another creature within 6 squares of you. Using this ability is a Standard Action, and you must succeed on a ranged attack roll. If the attack equals or exceeds the target's Fortitude Defense, you deal 1d6 points of damage per Class Level to the target, and you heal an equal amount of damage. If the attack fails, there is no effect."},"class":"1ba03b2d00245906","costNumeric":null,"category":"Sith Apprentice","treeId":"d1037bc7a08ea80b","tags":["dark_side","force","force_defense","force_offense","force_point_spend","force_support","healing","medicine","offense_ranged","positioning","resource_spend","scaling","skills","standard_action","support"],"executionModel":"ACTIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_action","applicationScope":"standard_action_force_point_ranged_attack","staticSheetPolicy":"exclude","manualResolution":false,"requiresRuntimeContext":true,"contributesGenericBonus":false,"modifiers":[],"notes":"Spend a Force Point as a Standard Action to make a ranged attack against one creature within 6 squares; on hit, deal 1d6 Force damage per Sith class level and heal the same amount.","combatActions":[{"id":"dark-healing","name":"Dark Healing","label":"Dark Healing","actionType":"standard","cost":1,"manualResolution":false,"resolutionMode":"sithTalent","useLabel":"Use","description":"You can spend a Force Point to heal wounds by drawing life energy from another creature within 6 squares of you. Using this ability is a Standard Action, and you must succeed on a ranged attack roll. If the attack equals or exceeds the target's Fortitude Defense, you deal 1d6 points of damage per Class Level to the target, and you heal an equal amount of damage. If the attack fails, there is no effect.","notes":"Spend a Force Point as a Standard Action to make a ranged attack against one creature within 6 squares; on hit, deal 1d6 Force damage per Sith class level and heal the same amount.","relatedSkills":[],"resources":["Force Point","Ranged attack","Fortitude Defense"],"requiredContext":[],"spendAction":true,"ruleData":{"sithTalentAction":"darkHealing"}}],"rules":[],"sithTalentBackcheck":{"phase":"sith-dark-side-batch","status":"implemented_or_runtime_card","source":"user-pasted-rules-text","talismanUiDeferred":false}},"talent_tree":"Sith","tree":"Sith","summary":"You can spend a Force Point to heal wounds by drawing life energy from another creature within 6 squares of you.","source":"Saga Edition Core Rulebook","page":223},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.dark_healing","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.402Z","detectedPredicates":["defense.fortitude","turn.once-per-round"],"forcePrestigeCleanup":{"phase":"T9","status":"manual_or_runtime","scope":"runtime_force_power_action"},"sithTalentBackcheck":{"source":"user-pasted-rules-text","implemented":true,"uiDeferred":false,"action":"darkHealing"}}}}
{"_id":"00c3231e4a4173fa","name":"Noble Fencing Style","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Trained in Deception and Persuasion","benefit":"This style of swordplay uses wit and force of personality to increase accuracy, taunting and distracting an opponent with feints, misdirection, and deception. When using a light melee weapon or a lightsaber that you are proficient with, you can use your Charisma modifier instead of your Strength modifier on attack rolls.","description":{"value":"This style of swordplay uses wit and force of personality to increase accuracy, taunting and distracting an opponent with feints, misdirection, and deception. When using a light melee weapon or a lightsaber that you are proficient with, you can use your Charisma modifier instead of your Strength modifier on attack rolls."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"deceptionandpersuasion"}],"_source":"fix2-auto"},"treeId":"9df067790c87e6bc","tags":["action_economy","melee","mobility","positioning","skills","social","support","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action_reference","applicationScope":"martial_protector_arena_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"attackAbilityRules":[{"type":"USE_CHARISMA_FOR_ATTACK","weapons":["light_melee","lightsaber"],"requiresProficiency":true,"description":"Use Charisma instead of Strength for attack rolls with proficient light melee weapons or lightsabers."}],"implementedBy":"CombatStatRules attack ability rule","notes":"Canon text uses Charisma instead of Strength on attack rolls with proficient light melee weapons or lightsabers; implemented in combat stat rules.","combatActions":[{"id":"noble-fencing-style-t30-reference","name":"Noble Fencing Style","label":"Noble Fencing Style","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"This style of swordplay uses wit and force of personality to increase accuracy, taunting and distracting an opponent with feints, misdirection, and deception. When using a light melee weapon or a Lightsaber that you are proficient with, you can use your Charisma modifier instead of your Strength modifier on attack rolls.","notes":"This style of swordplay uses wit and force of personality to increase accuracy, taunting and distracting an opponent with feints, misdirection, and deception. When using a light melee weapon or a Lightsaber that you are proficient with, you can use your Charisma modifier instead of your Strength modifier on attack rolls.","relatedSkills":[],"resources":["GM/player confirmed context"],"requiredContext":["GM/player confirms valid trigger"],"targetHint":"GM/player adjudicated target or context","spendAction":false,"ruleData":{}}],"rules":[],"manualResolution":true,"phase30MartialProtectorArenaCleanup":{"phase":"T30","tree":"Fencing","status":"reviewed_manual_or_runtime_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"T30 removed unsafe passive rows from martial/protector/arena/species leftovers and surfaced action, reaction, recovery, cover, and attack-rider context as truthful cards/rules."}},"summary":"This style of swordplay uses wit and force of personality to increase accuracy, taunting and distracting an opponent with feints, misdirection, and deception.","source":"Knights of the Old Republic Campaign Guide","page":27},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.noble_fencing_style","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.402Z","detectedPredicates":["attack.when-hit","attack.with-melee","proximity.ally-nearby","turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"implemented_existing_owner","owner":"CombatStatRules attack ability rule","note":"Canon text uses Charisma instead of Strength on attack rolls with proficient light melee weapons or lightsabers; implemented in combat stat rules."}}}}
{"_id":"00deb8b4cce303b6","name":"Force Intuition","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can use your Use the Force check modifier instead of your Initiative modifier when making Initiative checks. You are considered Trained in the Initiative skill. If you are entitled to an Initiative check reroll, you may reroll your Use the Force check instead, subject to the same circumstances and limitations. You may use this Talent to determine the Initiative of a Starship if you are the Pilot.","description":{"value":"You can use your Use the Force check modifier instead of your Initiative modifier when making Initiative checks. You are considered Trained in the Initiative skill. If you are entitled to an Initiative check reroll, you may reroll your Use the Force check instead, subject to the same circumstances and limitations. You may use this Talent to determine the Initiative of a Starship if you are the Pilot."},"class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"10c843cef8ce2798","tags":["dark_side","force","force_offense","light_side","skills","support","sustained_damage","skill_substitution","initiative","use_the_force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"passive","applicationScope":"skill_substitution","staticSheetPolicy":"not_a_modifier","implementedBy":"DerivedCalculator.forceIntuitionInitiativeSubstitution","notes":"Use the Force may replace Initiative checks; Initiative is treated as trained. Defense modifier migration removed.","modifiers":[]},"talent_tree":"Jedi Guardian","talentTree":"Jedi Guardian","tree":"Jedi Guardian","source":"Saga Edition Core Rulebook","summary":"You can use your Use the Force check modifier instead of your Initiative modifier when making Initiative checks.","page":40},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_intuition","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.402Z","detectedPredicates":["turn.once-per-round"],"jediTreeCleanup":{"phase":"T7","status":"derived_calculator_implemented","reason":"Removed bogus +5 defense state row; DerivedCalculator now handles trained Initiative and Use the Force substitution."},"sourcePatch":"jedi-guardian-runtime-pass"}}}
{"_id":"014d291a6e16cc12","name":"Friend or Foe","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Cast Suspicion","benefit":"Whenever an ally within your line of sight is missed by a ranged attack, you can (as a reaction, once per turn) designate one enemy adjacent to that ally. Compare the attack roll of the missed attack to the Reflex Defense of that enemy; if the attack would hit, the attack targets that enemy and is resolved as normal.","description":{"value":"Whenever an ally within your line of sight is missed by a ranged attack, you can (as a reaction, once per turn) designate one enemy adjacent to that ally. Compare the attack roll of the missed attack to the Reflex Defense of that enemy; if the attack would hit, the attack targets that enemy and is resolved as normal."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.9408056ede41b43f","name":"Cast Suspicion"}],"_source":"canonical-csv"},"treeId":"da34105c875650ae","tags":["positioning","ranged","support","social","intrigue","reaction","control"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"friend-or-foe-t31-reference","name":"Friend or Foe","label":"Friend or Foe","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Whenever an ally within your line of sight is missed by a ranged attack, you can (as a Reaction, once per turn) designate one enemy adjacent to that ally. Compare the attack roll of the missed attack to the Reflex Defense of that enemy; if the attack would hit, the attack targets that enemy and is resolved as normal.","notes":"Whenever an ally within your line of sight is missed by a ranged attack, you can (as a Reaction, once per turn) designate one enemy adjacent to that ally. Compare the attack roll of the missed attack to the Reflex Defense of that enemy; if the attack would hit, the attack targets that enemy and is resolved as normal.","relatedSkills":[],"resources":["Once per turn","Ally context","Enemy/target context","Target context","Line of sight"],"requiredContext":["Triggering event confirmed","Valid target confirmed","Valid ally confirmed","Line of sight confirmed"],"targetHint":"GM/player adjudicated target or context","spendAction":true,"ruleData":{}}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"friend-or-foe-t31-context","label":"Friend or Foe","summary":"Whenever an ally within your line of sight is missed by a ranged attack, you can (as a Reaction, once per turn) designate one enemy adjacent to that ally. Compare the attack roll of the missed attack to the Reflex Defense of that enemy; if the attack would hit, the attack targets that enemy and is r"}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Provocateur","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."}},"summary":"Whenever an ally within your line of sight is missed by a ranged attack, you can (as a reaction, once per turn) designate one enemy adjacent to that ally.","source":"Legacy Era Campaign Guide","page":27},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.friend_or_foe","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.402Z","detectedPredicates":["attack.when-hit","attack.with-ranged"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Follower/dependent-actor subsystem or GM/player managed","note":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals."}}}}
{"_id":"0178e98b17ab2bcc","name":"Force Warning","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Allies within 12 squares can choose to reroll their Initiative checks at the start of combat but must take the second result, even if it is worse. Furthermore, if any allies within 12 squares are surprised at the start of an encounter, but you are not, you can designate a number of those allies equal to your Wisdom modifier (minimum 1); those allies are no longer considered surprised and can act normally on the surprise round.","description":{"value":"Allies within 12 squares can choose to reroll their Initiative checks at the start of combat but must take the second result, even if it is worse. Furthermore, if any allies within 12 squares are surprised at the start of an encounter, but you are not, you can designate a number of those allies equal to your Wisdom modifier (minimum 1); those allies are no longer considered surprised and can act normally on the surprise round."},"class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"77e3817ba5cfa0d5","tags":["action_economy","ambush","force","force_control","light_side","mobility","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[{"target":"attack","value":0,"type":"untyped","predicates":[],"enabled":false,"priority":500,"description":"[REQUIRES MANUAL MAPPING] Force Warning"}],"status":"talent_backcheck_user_text_2026_06_11","description":"Allies within 12 squares may reroll Initiative, and selected surprised allies may act if you are not surprised.","mechanicsMode":"conditional_or_metadata","applicationScope":"encounter_start_support","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"conditionSummary":"Allies within 12 squares may reroll Initiative, and selected surprised allies may act if you are not surprised.","metadataPhase":"jedi-prestige-talent-backcheck","metadataNotes":"Updated from user-provided source text; non-automatable targeting/LOS/session adjudication remains GM/player confirmed.","rules":[{"type":"TALENT_RULE","id":"force_warning","label":"Force Warning","summary":"Allies within 12 squares may reroll Initiative, and selected surprised allies may act if you are not surprised.","action":"initiative-roll","mode":"encounter_start_support","text":"Allies within 12 squares can choose to reroll their Initiative checks at the start of combat, but must keep the result of the reroll, even if it is worse.\n\nFurthermore, if any allies within 12 squares are Surprised at the start of an encounter, but you are not, you can designate a number of those allies equal to your Wisdom modifier (minimum 1); those allies are no longer considered Surprised, and can act normally during the Surprise Round."}]},"effect":"Allies within 12 squares can choose to reroll their Initiative checks at the start of combat, but must keep the result of the reroll, even if it is worse.\n\nFurthermore, if any allies within 12 squares are Surprised at the start of an encounter, but you are not, you can designate a number of those allies equal to your Wisdom modifier (minimum 1); those allies are no longer considered Surprised, and can act normally during the Surprise Round.","shortSummary":"Allies within 12 squares may reroll Initiative, and selected surprised allies may act if you are not surprised.","prerequisite":"","prerequisitesText":"","grantsActions":[],"summary":"Allies within 12 squares can choose to reroll their Initiative checks at the start of combat but must take the second result, even if it is worse.","source":"Knights of the Old Republic Campaign Guide","page":40},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_warning","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.402Z","detectedPredicates":[],"talentBackcheck":{"source":"user-pasted-rules","date":"2026-06-11","updatedFields":["system.description","system.benefit","system.effect","system.shortSummary","system.prerequisite","system.abilityMeta"]}}}}
{"_id":"01bcee2365b82ce6","name":"Unreadable","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You gain a +5 bonus to your Will Defense against skill checks made to read your emotions and influence your attitude. In addition, whenever you successfully feint a target in combat, that target is flat-footed against all your attacks until the end of your next turn.","description":{"value":"You gain a +5 bonus to your Will Defense against skill checks made to read your emotions and influence your attitude. In addition, whenever you successfully feint a target in combat, that target is flat-footed against all your attacks until the end of your next turn."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","treeId":"e91cc675fbf9ba6e","tags":["social","intrigue","deception","control"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed target context","notes":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists.","combatActions":[{"id":"unreadable-t31-reference","name":"Unreadable","label":"Unreadable","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"You gain a +5 bonus to your Will Defense against Skill Checks made to read your emotions and influence your Attitude. In addition, whenever you successfully Feint a target in combat, that target is Flat-Footed against all your attacks until the end of your next turn.","notes":"You gain a +5 bonus to your Will Defense against Skill Checks made to read your emotions and influence your Attitude. In addition, whenever you successfully Feint a target in combat, that target is Flat-Footed against all your attacks until the end of your next turn.","relatedSkills":[{"skill":"Deception"}],"resources":["Target context"],"requiredContext":["Valid target confirmed"],"targetHint":"GM/player adjudicated target or context","spendAction":false,"ruleData":{}}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"unreadable-t31-context","label":"Unreadable","summary":"You gain a +5 bonus to your Will Defense against Skill Checks made to read your emotions and influence your Attitude. In addition, whenever you successfully Feint a target in combat, that target is Flat-Footed against all your attacks until the end of your next turn."}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Disgrace","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."}},"summary":"You gain a +5 bonus to your Will Defense against skill checks made to read your emotions and influence your attitude.","source":"Scum and Villainy","page":14},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.unreadable","nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"GM/player managed target context","note":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists."}}}}
{"_id":"028e4e50565971ee","name":"Temporal Awareness","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Findsman Ceremonies","benefit":"Once per encounter, as a reaction to any enemy's attack, you can move up to your speed.","description":{"value":"Once per encounter, as a reaction to any enemy's attack, you can move up to your speed."},"class":"336bba6d1e517c92","costNumeric":null,"category":"Bounty Hunter","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.661c2c0665e911f6","name":"Findsman Ceremonies"}],"_source":"canonical-csv"},"treeId":"022b31d355c840a9","tags":["action_economy","mobility","force","visions","perception","reaction"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Future CombatOptionResolver / action-card / reaction prompt / damage-resolution hook","notes":"Reviewed in T12. Removed legacy static/passive modifier data; this talent is a real combat mechanic but needs runtime context and should not mutate permanent sheet totals.","combatActions":[{"id":"temporal-awareness-t31-reference","name":"Temporal Awareness","label":"Temporal Awareness","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter when attacked, you can move your speed as an immediate reaction.","notes":"Once per encounter when attacked, you can move your speed as an immediate reaction.","relatedSkills":[],"resources":["Once per encounter"],"requiredContext":["Triggering event confirmed"],"targetHint":"","spendAction":true,"ruleData":{}}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"temporal-awareness-t31-context","label":"Temporal Awareness","summary":"Once per encounter when a