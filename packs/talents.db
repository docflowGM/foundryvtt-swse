{"_id":"3f01107ed7779426","name":"Impel Ally III","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Impel Ally I, Impel Ally II","benefit":"Once per encounter, you can spend three swift actions on consecutive turns to grant one ally the ability to take a standard action and a move action. The ally must act immediately on your turn when the final swift action is spent, before you do anything else, or the opportunity is wasted.","description":{"value":"Once per encounter, you can spend three swift actions on consecutive turns to grant one ally the ability to take a standard action and a move action. The ally must act immediately on your turn when the final swift action is spent, before you do anything else, or the opportunity is wasted."},"class":"324631ca844a88be","costNumeric":null,"category":"Crime Lord","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.b11a87e70f957ed2","name":"Impel Ally II"}],"_source":"canonical-csv"},"treeId":"560cc7994b357a0d","tags":["action_economy","mobility","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"combat_action_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"AbilityCombatActionResolver + character sheet combat actions tab; final resolution remains manual until the relevant target/minion/action-sequence executor exists.","notes":"Reviewed in phase T15. This talent depends on target identity, ally/minion state, line of sight, positioning, encounter timing, or GM adjudication. It should not mutate permanent actor sheet totals.","combatActions":[{"id":"impel-ally-iii","name":"Impel Ally III","actionType":"swift","cost":3,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","relatedSkills":[],"resources":["Once per encounter","Consecutive turns"],"requiredContext":["O