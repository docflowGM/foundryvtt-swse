{"_id":"28c306c37ccb9fcf","name":"Weaken Resolve","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Presence","benefit":"Once per round, when you deal damage equal to or greater than the target's damage threshold, make a Persuasion check as a free action. If the result equals or exceeds the target's Will Defense, the target flees from you at top speed for 1 minute. It cannot take standard, swift, or full-round actions while fleeing, but normally stops fleeing if wounded. As a free action or reaction, the target can spend a Force Point, if it has not already spent one earlier in the round, to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your character level. This is a mind-affecting fear effect.","description":{"value":"Once per round, when you deal damage equal to or greater than the target's damage threshold, make a Persuasion check as a free action. If the result equals or exceeds the target's Will Defense, the target flees from you at top speed for 1 minute. It cannot take standard, swift, or full-round actions while fleeing, but normally stops fleeing if wounded. As a free action or reaction, the target can spend a Force Point, if it has not already spent one earlier in the round, to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your character level. This is a mind-affecting fear effect."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.ec8f2ba706cc2c05","name":"Presence"}],"_source":"canonical-csv"},"treeId":"8375b9b26b679901","tags":["persuasion","intimidation","social","fear","mind-affecting","control","battlefield_control","damage_threshold","will_defense","mobility","action_economy","force_point_spend","resource_spend"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"weaken-resolve","name":"Weaken Resolve","label":"Weaken Resolve","actionType":"free","cost":1,"manualResolution":false,"resolutionMode":"auto","useLabel":"Roll / Use","description":{"targetHint":"Creature or vehicle crew just damaged past threshold","resources":["Once per round","Mind-affecting fear","Target may spend a Force Point to negate if eligible"],"requiredContext":["You dealt damage >= target Damage Threshold"],"when":"Persuasion vs Will Defense"},"notes":{"targetHint":"Creature or vehicle crew just damaged past threshold","resources":["Once per round","Mind-affecting fear","Target may spend a Force Point to negate if eligible"],"requiredContext":["You dealt damage >= target Damage Threshold"],"when":"Persuasion vs Will Defense"},"relatedSkills":[{"skill":"Once per round, after you deal damage equal to or greater than the target's Damage Threshold, roll Persuasion against Will Defense. On success, the target flees as described by the talent.","when":""}],"resources":[],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{},"skillKey":"Once per round, after you deal damage equal to or greater than the target's Damage Threshold, roll Persuasion against Will Defense. On success, the target flees as described by the talent."}],"manualResolution":false,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Influence","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"After exceeding a target's damage threshold, Persuasion vs. Will can force a lower-level target to flee.","source":"Saga Edition Core Rulebook","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.weaken_resolve","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.406Z","detectedPredicates":[],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Follower/dependent-actor subsystem or GM/player managed","note":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals."}}}}
{"_id":"291937f2d45a01bc","name":"Gradual Resistance","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"If you take damage from the use of a Force Power, until the end of the encounter you gain a +2 Force bonus to all Defenses against that Force Power.","description":"If you take damage from the use of a Force Power, until the end of the encounter you gain a +2 Force bonus to all Defenses against that Force Power.","class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"36f18f3e974feb33","tags":["dual_wield","force","force_defense","force_offense","light_side"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"force_context_manual","staticSheetPolicy":"manual_only","manualResolution":true,"notes":"Conditional +2 Force bonus to all defenses only against the same Force power after taking damage from it. Requires encounter state and power identity; GM/player managed for now.","modifiers":[],"combatActions":[{"id":"gradual-resistance","name":"Gradual Resistance","label":"Gradual Resistance","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"If you take damage from the use of a Force Power, until the end of the encounter you gain a +2 Force bonus to all Defenses against that Force Power.","notes":"If you take damage from the use of a Force Power, until the end of the encounter you gain a +2 Force bonus to all Defenses against that Force Power.","relatedSkills":[],"resources":["Encounter duration"],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[],"requiresRuntimeContext":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Jedi Sentinel","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":0,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/ta