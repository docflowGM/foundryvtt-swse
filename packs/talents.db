{"_id":"98c720992c5b428e","name":"Focus Terror","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per encounter as a swift action, you can harness the fear felt by your allies and transform it into a powerful motivational tool. All allies within 12 squares of you and in your line of sight move +2 steps along the condition track, but suffer a -2 penalty on attack rolls and skill checks for a number of rounds equal to your character level.","description":{"value":"Once per encounter as a swift action, you can harness the fear felt by your allies and transform it into a powerful motivational tool. All allies within 12 squares of you and in your line of sight move +2 steps along the condition track, but suffer a -2 penalty on attack rolls and skill checks for a number of rounds equal to your character level."},"class":"1ba03b2d00245906","costNumeric":null,"category":"Sith Apprentice","treeId":"4d5ac20318ef56b6","tags":["action_economy","condition_removal","dark_side","force","force_control","force_defense","force_offense","mobility","positioning","sustained_damage","swift_action"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","manualResolution":false,"modifiers":[],"notes":"Once-per-encounter swift action affects allies in 12 squares/LOS with condition track movement and penalties.","requiresRuntimeContext":true,"requiresSelectedChoice":false,"combatActions":[{"name":"Focus Terror","actionType":"swift","requiredTalent":"Focus Terror","description":"Once per encounter as a Swift Action, you can harness the fear felt by your allies and transform it into a powerful motivational tool. All allies within 12 squares of you and in your line of sight move +2 steps along the Condition Track, but suffer a -2 penalty on attack rolls and Skill Checks for a number of rounds equal to your Character Level.","resolutionMode":"sithTalent","spendAction":true,"effects":[],"resources":["Once per encounter","Condition Track +2","Attack/skill penalty"],"notes":"Targets selected allies, improves condition track by 2 steps, and flags the -2 attack/skill penalty for character-level rounds. Range and line of sight remain adjudicated.","manualResolution":false,"relatedSkills":[],"sithTalentAction":"focusTerror","id":"focus-terror","label":"Focus Terror"}],"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Sith Commander","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."},"contributesGenericBonus":false},"summary":"Once per encounter as a swift action, you can harness the fear felt by your allies and transform it into a powerful motivational tool.","source":"Legacy Era Campaign Guide","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.focus_terror","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.422Z","detectedPredicates":["defense.reflex","turn.once-per-round"],"forcePrestigeCleanup":{"phase":"T9","status":"manual_or_runtime","scope":"runtime_ally_buff"}}}}
{"_id":"98d0ce77949d17cd","name":"Shift Sense","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":null,"benefit":"You can spend a Force Point to gain low-light vision for 1 minute or until the end of the encounter, whichever is longer.","description":"You can spend a Force Point to gain low-light vision for 1 minute or until the end of the encounter, whichever is longer.","costNumeric":null,"treeId":"d6b4331c0e31f7e3","tags":["force","initiative","pilot","precognition","senses"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"shift-sense","name":"Shift Sense","label":"Shift Sense","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Gain low-light vision for 1 minute or the rest of the encounter, whichever is longer.","notes":"Gain low-light vision for 1 minute or the rest of the encounter, whichever is longer.","relatedSkills":[],"resources":["Gain low-light vision for 1 minute or encounter"],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Sense","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"Spend a Force Point for low-light vision for 1 minute or the rest of the encounter, whichever is longer.","source":"Clone Wars Campaign Guide","page":53},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.shift_sense","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.422Z","detectedPredicates":[],"forceTalentCleanup":{"phase":"T22","tree":"Sense","status":"combat_action_card"}}}}
{"_id":"991dbfc3a436b5a1","name":"Squadron Maneuvers","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Charisma 13, any other ace pilot talent","benefit":"Choose one talent that you already possess. The talent you select must be from the Expert Pilot or Gunner talent trees. Once per encounter as a standard action, you can impart the benefits of the chosen talent to all members of your squadron. Once gained, its benefits last until the end of the encounter.","description":{"value":"Choose one talent that you already possess. The talent you select must be from the Expert Pilot or Gunner talent trees. Once per encounter as a standard action, you can impart the benefits of the chosen talent to all members of your squadron. Once gained, its benefits last until the end of the encounter."},"class":"9c9989c34714f920","costNumeric":null,"category":"Ace Pilot","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"cha","min":13}],"_source":"canonical-csv"},"treeId":"dc1b8c5ce2a70394","tags":["action_economy","force","force_defense","force_offense","light_side","mobility","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"requiresSelectedChoice":true,"choiceMetaStatus":"phase14_persistent_choice_seeded","combatActions":[{"id":"squadron-maneuvers","name":"Squadron Maneuvers","label":"Squadron Maneuvers","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, grant your squadron the benefit of the selected Expert Pilot or Gunner talent until the end of the encounter.","notes":"Once per encounter, grant your squadron the benefit of the selected Expert Pilot or Gunner talent until the end of the encounter.","requiresSelectedChoice":true,"resources":["Once per encounter","Squadron","Chosen talent"]}],"phase16VehicleStarshipCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual combat action card in the action economy UI."}},"choiceMeta":{"resolution":"immediate","required":true,"status":"phase14_persistent_choice_seeded","choiceKind":"talent_choice","repeatable":true,"storagePath":"flags.swse.choices.squadron_maneuvers_talent","choiceSource":"actorState","optionRegistry":"data/feat-choice-options.json#choiceKinds.talent_choice","allowedTreeNames":["Expert Pilot","Gunner"]},"summary":"Choose one Expert Pilot or Gunner talent you possess; once per encounter, grant its benefits to your whole squadron for the encounter.","source":"Starships of the Galaxy","page":18},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.squadron_maneuvers","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.422Z","detectedPredicates":["defense.reflex","turn.once-per-round"]}}}
{"_id":"994e8232ccd3847c","name":"Savage Reputation","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Bloodthirsty","benefit":"All opponents within 6 squares of you take a -1 penalty on all attacks. This is a mind-affecting fear effect.","description":{"value":"All opponents within 6 squares of you take a -1 penalty on all attacks. This is a mind-affecting fear effect."},"class":"fcf8cc428a6eb01a","costNumeric":null,"category":"Master Privateer","treeId":"61db5e2c0c44ef67","tags":["damage_reduction","positioning"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until target/ally/minion context automation exists","notes":"Reviewed in phase T15. This talent depends on target identity, ally/minion state, line of sight, positioning, encounter timing, or GM adjudication. It should not mutate permanent actor sheet totals."},"summary":"All opponents within 6 squares of you take a -1 penalty on all attacks.","source":"Scum and Villainy","page":33},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.savage_reputation","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.422Z","detectedPredicates":["attack.when-hit"]}}}
{"_id":"9992fb4ee6ab40df","name":"Tripwire","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Jury-Rigger, trained in the Mechanics skill","description":{"value":"As a standard action, set a simple snare or trap across an opening up to 3 squares wide with the required item. Make a DC 20 Mechanics check to set the trap and a Deception check to conceal the wire; compare the Deception result to the next creature's Perception check, with -10 to the Perception check if it observed you setting the trap. If the creature succeeds, it can make a DC 10 Acrobatics check to avoid the wire. Choose one option: Clothesline requires thin wire at neck height and on success knocks the target prone, ends its actions for the turn, and deals 1d6 damage; Electronic tripwire causes mine damage treated as a frag grenade with a 2-square blast radius centered on one end of the wire, automatically hitting the target and attacking adjacent targets at 1d20+10 vs Reflex; Tripwire requires thin wire at ankle height, adds +2 to the Deception result, and on success knocks the target prone and ends its actions for the turn."},"benefit":"As a standard action, set a simple snare or trap across an opening up to 3 squares wide with the required item. Make a DC 20 Mechanics check to set the trap and a Deception check to conceal the wire; compare the Deception result to the next creature's Perception check, with -10 to the Perception check if it observed you setting the trap. If the creature succeeds, it can make a DC 10 Acrobatics check to avoid the wire. Choose one option: Clothesline requires thin wire at neck height and on success knocks the target prone, ends its actions for the turn, and deals 1d6 damage; Electronic tripwire causes mine damage treated as a frag grenade with a 2-square blast radius centered on one end of the wire, automatically hitting the target and attacking adjacent targets at 1d20+10 vs Reflex; Tripwire requires thin wire at ankle height, adds +2 to the Deception result, and on success knocks the target prone and ends its actions for the turn.","class":"","category":"","costNumeric":null,"treeId":"dca33c0215264a02","tags":["action_economy","control","deception","mobility","standard_action","trap","survival","exploration"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"survival_exploration_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Trap setup card with Mechanics and Deception prompts.","phase25SurvivalExplorationCleanup":{"phase":"T25","tree":"Master Scout","status":"combat_action_card","notes":"Trap setup card with Mechanics and Deception prompts."},"combatActions":[{"id":"tripwire-setup","name":"Tripwire: Set Trap","label":"Tripwire: Set Trap","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Standard Action, you can set up a simple snare or trap across an opening up to 3 squares wide. You must have the required items to set the trap. Make a successful DC 20 Mechanics check to set the trap. Make a Deception check to conceal the wire. Compare the result of the Deception check to the Perception check of the next creature that passes through that square (-10 if it observes you setting the trap).\n\nIf the creature fails the Perception check, it takes the indicated use of the trap. If the creature succeeds, it can make a DC 10 Acrobatics check to avoid the wire. Select one of the following options:\n\nClothesline: Requires thin wire, set at neck height. Success results in the target falling Prone in the trapped square, ending its Actions for the turn and taking 1d6 points of damage.\nElectronic Tripwire: Success results in Mine damage (Treat as Frag Grenade, 2-square blast radius centered on one end of the wire). Target is automatically hit; roll 1d20+10 against the Reflex Defense of adjacent targets.\nTripwire: Requires thin wire, set at ankle height. Add 2 to the Deception check result. Success results in the target immediately falling Prone in the trapped square and ending its Actions for the turn.","notes":"As a Standard Action, you can set up a simple snare or trap across an opening up to 3 squares wide. You must have the required items to set the trap. Make a successful DC 20 Mechanics check to set the trap. Make a Deception check to conceal the wire. Compare the result of the Deception check to the Perception check of the next creature that passes through that square (-10 if it observes you setting the trap).\n\nIf the creature fails the Perception check, it takes the indicated use of the trap. If the creature succeeds, it can make a DC 10 Acrobatics check to avoid the wire. Select one of the following options:\n\nClothesline: Requires thin wire, set at neck height. Success results in the target falling Prone in the trapped square, ending its Actions for the turn and taking 1d6 points of damage.\nElectronic Tripwire: Success results in Mine damage (Treat as Frag Grenade, 2-square blast radius centered on one end of the wire). Target is automatically hit; roll 1d20+10 against the Reflex Defense of adjacent targets.\nTripwire: Requires thin wire, set at ankle height. Add 2 to the Deception check result. Success results in the target immediately falling Prone in the trapped square and ending its Actions for the turn.","relatedSkills":[{"skill":"mechanics","when":"DC 20 to set trap"},{"skill":"deception","when":"Conceal trap"}],"resources":["Requires trap materials","Choose Clothesline / Electronic Tripwire / Tripwire"],"requiredContext":["Opening up to 3 squares wide","Required items available"],"targetHint":"Trap space/opening","spendAction":true,"ruleData":{}}]},"summary":"Set a concealed clothesline, explosive electronic tripwire, or ankle tripwire across an opening with Mechanics and Deception.","source":"Unknown Regions","page":21},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.423Z","detectedPredicates":[]}}}
{"_id":"99c685b0631a5601","name":"Swerve","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Fade Away","benefit":"Once per encounter when an enemy makes an attack of opportunity against you, as a reaction you can automatically negate the attack and immediately move up to half your speed. This movement does not provoke attacks of opportunity. If you have the Combat Reflexes feat, you can use this talent a number of times per encounter equal to your Dexterity bonus (minimum 1). You may still only use this talent once per round.","description":{"value":"Once per encounter when an enemy makes an attack of opportunity against you, as a reaction you can automatically negate the attack and immediately move up to half your speed. This movement does not provoke attacks of opportunity. If you have the Combat Reflexes feat, you can use this talent a number of times per encounter equal to your Dexterity bonus (minimum 1). You may still only use this talent once per round."},"class":"b5bed5d1b5f42958","costNumeric":null,"category":"Scout","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.cb4b14a242fbee71","name":"Fade Away"}],"_source":"canonical-csv"},"treeId":"5a30489609182e8c","tags":["mobility","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"Once per encounter, negate an opportunity attack against you and move up to half speed without provoking; Combat Reflexes can grant extra uses.","source":"Rebellion Era Campaign Guide","page":26},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.swerve","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.423Z","detectedPredicates":["turn.once-per-round"]}}}
{"_id":"9aa564522f427214","name":"Launch Point","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Safe Zone","benefit":"Any ally who starts his or her turn within your Safe Zone and then exits the Safe Zone gains a +2 bonus to attack rolls before the end of that ally's turn, provided that the ally is not within your Safe Zone when the attack is made.","description":{"value":"Any ally who starts his or her turn within your Safe Zone and then exits the Safe Zone gains a +2 bonus to attack rolls before the end of that ally's turn, provided that the ally is not within your Safe Zone when the attack is made."},"class":"4ee81a6708a516cd","costNumeric":null,"category":"Pathfinder","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.5989079457c8a3cf","name":"Safe Zone"}],"_source":"canonical-csv"},"treeId":"383ff8d392488cf8","tags":["cover","mobility","positioning","recon","support","survival","exploration"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"survival_exploration_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Ally attack bonus after leaving Safe Zone is contextual; surfaced as a reference card instead of an owner passive attack bonus.","phase25SurvivalExplorationCleanup":{"phase":"T25","tree":"Pathfinder","status":"zone_reference","notes":"Ally attack bonus after leaving Safe Zone is contextual; surfaced as a reference card instead of an owner passive attack bonus."},"combatActions":[{"id":"launch-point-safe-zone","name":"Launch Point","label":"Launch Point","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Any ally who starts his or her turn within your Safe Zone and then exits the Safe Zone gains a +2 bonus to attack rolls before the end of that ally's turn, provided that the ally is not within your Safe Zone when the attack is made.","notes":"Any ally who starts his or her turn within your Safe Zone and then exits the Safe Zone gains a +2 bonus to attack rolls before the end of that ally's turn, provided that the ally is not within your Safe Zone when the attack is made.","relatedSkills":[],"resources":["Ally leaves Safe Zone: +2 attack before end of turn"],"requiredContext":["Ally started turn in Safe Zone","Ally is outside Safe Zone when making the attack"],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[{"type":"ZONE_EXIT_ATTACK_BONUS","id":"launch-point","value":2,"bonusType":"circumstance","affected":"alliesLeavingSafeZone","duration":"untilEndOfAllyTurn"}]},"summary":"Any ally who starts his or her turn within your Safe Zone and then exits the Safe Zone gains a +2 bonus to attack rolls before the end of that ally's turn, provided that the ally is not within your Safe Zone when the...","source":"Rebellion Era Campaign Guide","page":45},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.launch_point","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.423Z","detectedPredicates":[]}}}
{"_id":"9ae263137f27e220","name":"Capture Droid","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per encounter, you can use this Talent on an adjacent enemy Droid that has been reduced to 0 Hit Points or moved to the bottom of the Condition Track, but not destroyed.\n\nAs a Standard Action, make a Mechanics check against the Droid's Will Defense. If your result equals or exceeds the Droid's Will Defense, the Droid moves +2 steps on the Condition Track, regains 1d8 Hit Points, becomes your ally, and it's Attitude toward you immediately shifts to Friendly.\n\nThe Droid fights on your side until the end of the encounter, at which point it is destroyed.","description":{"value":"Once per encounter, you can use this Talent on an adjacent enemy Droid that has been reduced to 0 Hit Points or moved to the bottom of the Condition Track, but not destroyed.\n\nAs a Standard Action, make a Mechanics check against the Droid's Will Defense. If your result equals or exceeds the Droid's Will Defense, the Droid moves +2 steps on the Condition Track, regains 1d8 Hit Points, becomes your ally, and it's Attitude toward you immediately shifts to Friendly.\n\nThe Droid fights on your side until the end of the encounter, at which point it is destroyed."},"class":"db019dfbb271cdf6","costNumeric":null,"category":"Improviser","treeId":"7f37422819d7be6f","tags":["control","damage_reduction","droid","equipment","jury_rig","mechanics","mobility","positioning","skills","standard_action","tech"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"capture-droid","name":"Capture Droid","label":"Capture Droid","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, make a Mechanics check against the Fortitude Defense of an adjacent enemy droid at 0 hit points or the bottom of the condition track but not destroyed. On success, the droid becomes disabled instead of destroyed.","notes":"Once per encounter, make a Mechanics check against the Fortitude Defense of an adjacent enemy droid at 0 hit points or the bottom of the condition track but not destroyed. On success, the droid becomes disabled instead of destroyed.","relatedSkills":[{"skill":"Mechanics","dc":{"type":"defense","target":"Fortitude"}}],"resources":["Once per encounter"],"requiredContext":["Adjacent enemy droid","Droid at 0 HP or bottom of condition track","Droid not destroyed"],"targetHint":"Adjacent enemy droid"}],"phase17TechEngineeringCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual action-economy card. Automation can be added later without inventing passive bonuses."}},"summary":"Once per encounter, you can use this Talent on an adjacent enemy Droid that has been reduced to 0 Hit Points or moved to the bottom of the Condition Track, but not destroyed.","source":"Rebellion Era Campaign Guide","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.capture_droid","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.423Z","detectedPredicates":["defense.will","turn.once-per-round"]}}}
{"_id":"9af262765ace3af1","name":"Close Cover","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Watch This","benefit":"If you occupy the same space as a vehicle that is larger than the vehicle you are piloting, your vehicle gains a +5 cover bonus from the larger vehicle.","description":{"value":"If you occupy the same space as a vehicle that is larger than the vehicle you are piloting, your vehicle gains a +5 cover bonus from the larger vehicle."},"class":"9c9989c34714f920","costNumeric":null,"category":"Ace Pilot","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.0b04910aaabc51ba","name":"Watch This"}],"_source":"canonical-csv"},"treeId":"296772ab8e69c9ef","tags":["positioning"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase16VehicleStarshipCleanup":{"status":"metadata_or_gm_player_managed","owner":"GM/player or future vehicle subsystem","notes":"No truthful automatic runtime owner in this pass; stale migrated modifiers/effects removed if present."}},"summary":"If you occupy the same space as a vehicle that is larger than the vehicle you are piloting, your vehicle gains a +5 cover bonus from the larger vehicle.","source":"Scum and Villainy","page":25},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.close_cover","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.423Z","detectedPredicates":[]}}}
