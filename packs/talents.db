{"_id":"39b5423e255e14b1","name":"Transposing Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Noble Fencing Style, base attack bonus +5,","benefit":"When you hit a character with a melee attack, you can choose to have the attack deal only half damage and switch places with that foe. Your foe must be no more than one size category larger than you, and you must end up occupying a space that was previously occupied by your target (and vice versa) to use this talent. This movement does not provoke attacks of opportunity.","description":{"value":"When you hit a character with a melee attack, you can choose to have the attack deal only half damage and switch places with that foe. Your foe must be no more than one size category larger than you, and you must end up occupying a space that was previously occupied by your target (and vice versa) to use this talent. This movement does not provoke attacks of opportunity."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.00c3231e4a4173fa","name":"Noble Fencing Style"},{"type":"bab","min":5}],"_source":"canonical-csv"},"treeId":"9df067790c87e6bc","tags":["melee","positioning"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action_reference","applicationScope":"martial_protector_arena_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed target context","notes":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists.","combatActions":[{"id":"transposing-strike-t30-reference","name":"Transposing Strike","label":"Transposing Strike","actionType":"passive","cost":0,"manualResolution":true,"resolution