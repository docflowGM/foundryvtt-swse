{"_id":"9e2092257b53cd21","name":"Flurry Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Weapon Proficiency feat for chosen weapon","benefit":"Choose a single weapon group or exotic weapon you are proficient with. When you score a critical hit with a weapon from that group, you can make one immediate extra attack (in addition to the other effects of a critical hit) against a single target within range. You may only use this talent once per turn. You can select this talent multiple times. Its effects do not stack. Each time you take the talent, it applies to a new weapon group or exotic weapon.","description":{"value":"Choose a single weapon group or exotic weapon you are proficient with. When you score a critical hit with a weapon from that group, you can make one immediate extra attack (in addition to the other effects of a critical hit) against a single target within range. You may only use this talent once per turn. You can select this talent multiple times. Its effects do not stack. Each time you take the talent, it applies to a new weapon group or exotic weapon."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","treeId":"71e99c646b18d85c","tags":["positioning","precision"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"critical_hit_rider","staticSheetPolicy":"exclude","manualResolution":false,"requiresRuntimeContext":true,"requiresSelectedChoice":true,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","choiceMetaStatus":"phase14_persistent_choice_seeded","rules":[{"type":"CRITICAL_RIDER","id":"flurry-attack-critical","label":"Flurry Attack","targetEffectsOnCritical":[{"type":"immediateExtraAtt