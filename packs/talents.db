{"_id":"d10cdcba4faae7bb","name":"Foresight","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Force Perception.","benefit":"You may spend a Force Point to reroll an Initiative check, keeping the better of the two rolls. Additionally, if you roll a natural 20 on the Initiative check reroll, you immediately regain the Force Point spent to activate this talent.","description":"You may spend a Force Point to reroll an Initiative check, keeping the better of the two rolls. Additionally, if you roll a natural 20 on the Initiative check reroll, you immediately regain the Force Point spent to activate this talent.","costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.a358402a9fc26c02","name":"Force Perception"}],"_source":"canonical-csv"},"treeId":"d6b4331c0e31f7e3","tags":["force","force_point_spend","initiative","pilot","precognition","resource_spend","senses","skills"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"foresight","name":"Foresight","label":"Foresight","actionType":"free","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Reroll Initiative; on a natural 20, regain a Force Point.","notes":"Reroll Initiative; on a natural 20, regain a Force Point.","relatedSkills":[{"skill":"Use the Force"}],"resources":["May require Force Point","Reroll Initiative; natural 20 recovers Force Point"],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Sense","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."