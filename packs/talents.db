{"_id":"76eb427551c6495c","name":"Curved Throw","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Bugbite","benefit":"You can spend a swift action to ignore cover (but not total cover) with your next attack with a thud bug or a razor bug made before the end of your turn.","description":{"value":"You can spend a swift action to ignore cover (but not total cover) with your next attack with a thud bug or a razor bug made before the end of your turn."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.bed279ef3c81c42d","name":"Bugbite"}],"_source":"canonical-csv"},"treeId":"33c3210fcac8c664","tags":["ranged"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"curved-throw","name":"Curved Throw","label":"Curved Throw","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Spend a Swift Action so your next Thud Bug or Razor Bug attack before the end of your turn ignores Cover, but not Total Cover.","notes":"After spending the Swift Action, toggle the Curved Throw attack option on the matching attack if the pre-roll UI exposes it.","relatedSkills":[{"skill":"Attack Roll"}],"resources":["Next Thud Bug or Razor Bug attack","Before end of turn"],"requiredContext":["Thud Bug or Razor Bug attack","Target has Cover but not Total Cover"]}],"rules":[{"type":"ATTACK_OPTION","id":"curved-throw","label":"Curved Throw","control":"flag","requiresWeaponText":["thud bug","razor bug"],"suppresses":["coverBonus"],"summary":"After spending the Swift Action, the next Thud Bug or Razor Bug attack before end of turn ignores Cover but not Total Cover."}],"phase18MedicalBiotechCleanup":{"status":"contextual_runtime_rule_and_action_card","owner":"CombatOptionResolver + AbilityCombatActionResolver","notes":"Swift action card plu