{"_id":"e9820b341bf94de1","name":"Greater Weapon Specialization","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Greater Weapon Focus; Weapon Focus with the chosen weapon; Weapon Specialization with the chosen weapon","benefit":"Choose one exotic weapon or one of the following weapon groups: advanced melee weapons, heavy weapons, pistols, rifles, or simple weapons. You gain a +2 bonus on damage rolls with the chosen weapon. This stacks with Weapon Specialization. You may select this talent multiple times for different weapons.","description":{"value":"Choose one exotic weapon or one of the following weapon groups: advanced melee weapons, heavy weapons, pistols, rifles, or simple weapons. You gain a +2 bonus on damage rolls with the chosen weapon. This stacks with Weapon Specialization. You may select this talent multiple times for different weapons."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.869168cd679ee5d1","name":"Weapon Specialization"}],"_source":"canonical-csv"},"treeId":"2f720d8b061f9bd0","tags":["weapon_specialization","weapon_training","damage_bonus","melee","ranged","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"choice_required","applicationScope":"persistent_selection","staticSheetPolicy":"roll_context_only","requiresRuntimeContext":false,"requiresSelectedChoice":true,"modifiers":[{"target":"damage","value":2,"type":"untyped","predicates":["attack.weapon-matches-selected-choice"],"enabled":true,"priority":500,"description":"Greater Weapon Specialization"}],"implementedBy":"Future progression picker + Ability Engine roll-context resolver","notes":"Reviewed in T12. This talent needs a persistent selected weapon group/exotic weapon/equivalence decision before any roll modifier can be applied safely.","choiceMetaStatus":"phase14_persistent_choice_seeded","manualResolution":false,"phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Weapon Master","status":"selected_choice_roll_modifier","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Safe selected-choice roll modifier restored; applies only when the selected weapon group/exotic weapon matches the rolled weapon."}},"choiceMeta":{"resolution":"immediate","required":true,"status":"phase14_existing_choice_confirmed","choiceKind":"greater_weapon_specialization","repeatable":true,"storagePath":"flags.swse.choices.greater_weapon_specialization","choiceSource":"prerequisiteDerived","optionRegistry":"data/feat-choice-options.json#choiceKinds.greater_weapon_specialization","derivesFrom":["weapon_specialization"],"consumes":"weapon_specialization","provides":"greater_weapon_specialization"},"summary":"Gain another +2 damage with a chosen weapon, stacking with Weapon Specialization.","source":"Saga Edition Core Rulebook","page":212},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.greater_weapon_specialization","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.431Z","detectedPredicates":[],"requiresImmediateChoice":true}}}
{"_id":"e9aec3a7b011e17a","name":"Melee Assault","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When you make a melee attack against a target that has one or more of your allies adjacent to it, compare the result to the target's Fortitude Defense as well as its Reflex Defense. If the attack hits both defenses, the attack deals +1 die of damage and the target is knocked prone.","description":{"value":"When you make a melee attack against a target that has one or more of your allies adjacent to it, compare the result to the target's Fortitude Defense as well as its Reflex Defense. If the attack hits both defenses, the attack deals +1 die of damage and the target is knocked prone."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","treeId":"7bcd1d892f2e9ae7","tags":["melee","positioning"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"When you make a melee attack against a target that has one or more of your allies adjacent to it, compare the result to the target's Fortitude Defense as well as its Reflex Defense.","source":"Legacy Era Campaign Guide","page":31},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.melee_assault","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.431Z","detectedPredicates":["defense.fortitude","attack.with-melee","target.is-prone"]}}}
{"_id":"ea9a4f110f5d2d8d","name":"Assault Gambit","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per turn, as a Standard Action, you can designate one ally and one enemy that have line of effect to each other. The ally and the enemy make opposed Initiative checks, and the winner can make a single immediate melee or ranged attack against the loser. No character can benefit from this Talent more than once per round.","description":{"value":"Once per turn, as a Standard Action, you can designate one ally and one enemy that have line of effect to each other. The ally and the enemy make opposed Initiative checks, and the winner can make a single immediate melee or ranged attack against the loser. No character can benefit from this Talent more than once per round."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","treeId":"b7a1211d08826500","tags":["action_economy","mobility","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"assault-gambit","name":"Assault Gambit","label":"Assault Gambit","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per turn, designate one ally and one enemy with line of effect to each other. They make opposed Initiative checks; the winner makes one immediate melee or ranged attack against the loser.","notes":"Once per turn, designate one ally and one enemy with line of effect to each other. They make opposed Initiative checks; the winner makes one immediate melee or ranged attack against the loser.","relatedSkills":[{"skill":"Initiative"},{"skill":"Attack Roll"}],"resources":["Once per turn","One beneficiary per round"],"requiredContext":[],"targetHint":"One ally and one enemy","spendAction":true,"ruleData":{}}],"manualResolution":true,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Gambling Leader","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"Once per turn, as a Standard Action, you can designate one ally and one enemy that have line of effect to each other.","source":"Rebellion Era Campaign Guide","page":24},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.assault_gambit","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.431Z","detectedPredicates":["defense.reflex","turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Follower/dependent-actor subsystem or GM/player managed","note":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals."}}}}
{"_id":"eaaecdfd7a538975","name":"Dark Side Manipulation","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"Your Sith sorcery experimentation has provided you with a method of manipulating the dark side. Once per encounter, when using a Force Point in an act that would give you a dark side point, you may treat the Force Point as though you had rolled the maximum on the die."},"benefit":"Your Sith sorcery experimentation has provided you with a method of manipulating the dark side. Once per encounter, when using a Force Point in an act that would give you a dark side point, you may treat the Force Point as though you had rolled the maximum on the die.","class":"","category":"","costNumeric":null,"treeId":"d29a7261c1be4b83","talent_tree":"Krath","source":"Knights of the Old Republic Campaign Guide","page":59,"tags":["dark_side","dark_side_score","force","force-point","once-per-encounter"],"executionModel":"ACTIVE","subType":"TALENT_ACTION","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"encounter_limited_force_point_override","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"usesPerEncounter":1,"modifiers":[],"notes":"Applies only to a Force Point spent on an act that would increase the Dark Side Score. No permanent actor value changes; the die is maximized for that one spend.","combatActions":[],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"dark-side-manipulation-krath-context","label":"Dark Side Manipulation","summary":"Once per encounter, when you spend a Force Point on an act that would increase your Dark Side Score, you may treat the Force Point die as though it had rolled its maximum result."}]},"summary":"Your Sith sorcery experimentation has provided you with a method of manipulating the dark side."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"eafb1ee6cacedd20","name":"Second Skin","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Armored Defense.","benefit":"When wearing Armor with which you are proficient, your Armor bonus to your Reflex Defense and Equipment bonus to your Fortitude Defense each increases by +1.","description":{"value":"When wearing Armor with which you are proficient, your Armor bonus to your Reflex Defense and Equipment bonus to your Fortitude Defense each increases by +1."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.4c236343b01ea763","name":"Armored Defense"}],"_source":"canonical-csv"},"treeId":"17cec542331cb4e4","tags":["armor"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"implementationStatus":"implemented_by_defense_calculator","engineOwner":"DefenseCalculator","mechanicsMode":"passive","applicationScope":"equipped_armor_context","staticSheetPolicy":"owned_by_defense_calculator","conditionSummary":"Applies while wearing armor with which the actor is proficient; increases armor Reflex bonus and Fortitude equipment bonus by +1.","notes":"Removed nonfunctional PASSIVE/STATE defense predicates and stale maxDex active effect. DefenseCalculator owns the contextual defense bonuses.","implementationNote":"Handled by defense calculator. Applies only while wearing proficient armor.","runtime":"armor-calculator","tags":["armor-specialist"]},"implementationNote":"Handled by defense calculator. Applies only while wearing proficient armor.","effects":[],"summary":"When wearing Armor with which you are proficient, your Armor bonus to your Reflex Defense and Equipment bonus to your Fortitude Defense each increases by +1.","source":"Saga Edition Core Rulebook","page":52},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.second_skin","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.431Z","detectedPredicates":["defense.reflex","defense.fortitude"],"runtimeOwner":"DefenseCalculator","armorTreeCleanup":"phase_t6_armor_specialist"}}}
{"_id":"eb4f3e8660bc476589d0323d4cc00845","name":"Sith Alchemy","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Your knowledge of Sith alchemy allows you to imbue certain objects with the power of the dark side. You can perform any of the following alchemical transformations, though each time you do so, increase your Dark Side Score by 1.\n\nCreate Sith Amulet: You can create a Sith amulet. The creation of a Sith amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith amulet, after which point it functions exactly as a Sith amulet (see page 68).\n\nCreate Sith Armor: You can transform a suit of normal battle armor into the dark armor worn by Sith Lords. You must have a suit of battle armor to transform into the dark armor (light battle armor becomes light dark armor, medium battle armor becomes medium dark armor, and heavy battle armor becomes heavy dark armor). The transformation process takes 1 day for light dark armor, 2 days for medium dark armor, and 3 days for heavy dark armor. You must spend a Force Point at the end of the creation process to complete the armor's transformation.\n\nCreate Sith Talisman: You can spend 1 Force Point to imbue a portable object with the dark side, creating a Sith talisman that provides offensive strength to a Force power. Creating the talisman takes a full-round action. While you wear or carry the talisman on your person, you add 1d6 to your damage with Force powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith talisman. You can have only one Sith talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours.\n\nCreate Sith Weapon: You can alchemically treat a simple melee weapon or an advanced melee weapon, turning it into a Sith weapon. You must spend a Force Point and spend 1 hour imbuing the weapon with the properties of a Sith alchemical weapon. A lightsaber does not ignore the Sith weapon's DR, and characters who are proficient in the weapon's use can treat it as a lightsaber for the purposes of the Block, Deflect, and Redirect Shot talents (and any talents that have those Jedi talents as a prerequisite). Additionally, as a swift action, the wielder of a Sith weapon can spend a Force Point to gain a bonus equal to his Dark Side Score to the damage of his next attack made with the weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","description":{"value":"Your knowledge of Sith alchemy allows you to imbue certain objects with the power of the dark side. You can perform any of the following alchemical transformations, though each time you do so, increase your Dark Side Score by 1.\n\nCreate Sith Amulet: You can create a Sith amulet. The creation of a Sith amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith amulet, after which point it functions exactly as a Sith amulet (see page 68).\n\nCreate Sith Armor: You can transform a suit of normal battle armor into the dark armor worn by Sith Lords. You must have a suit of battle armor to transform into the dark armor (light battle armor becomes light dark armor, medium battle armor becomes medium dark armor, and heavy battle armor becomes heavy dark armor). The transformation process takes 1 day for light dark armor, 2 days for medium dark armor, and 3 days for heavy dark armor. You must spend a Force Point at the end of the creation process to complete the armor's transformation.\n\nCreate Sith Talisman: You can spend 1 Force Point to imbue a portable object with the dark side, creating a Sith talisman that provides offensive strength to a Force power. Creating the talisman takes a full-round action. While you wear or carry the talisman on your person, you add 1d6 to your damage with Force powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith talisman. You can have only one Sith talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours.\n\nCreate Sith Weapon: You can alchemically treat a simple melee weapon or an advanced melee weapon, turning it into a Sith weapon. You must spend a Force Point and spend 1 hour imbuing the weapon with the properties of a Sith alchemical weapon. A lightsaber does not ignore the Sith weapon's DR, and characters who are proficient in the weapon's use can treat it as a lightsaber for the purposes of the Block, Deflect, and Redirect Shot talents (and any talents that have those Jedi talents as a prerequisite). Additionally, as a swift action, the wielder of a Sith weapon can spend a Force Point to gain a bonus equal to his Dark Side Score to the damage of his next attack made with the weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1."},"costNumeric":null,"treeId":"a67faf2ae089ab5d","tags":["action_economy","beast_companion","crafting","dark_side","force","force_offense","force_point_spend","force_support","healing","investigation","knowledge","melee","resource_spend","standard_action","support"],"executionModel":"ACTIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"ui_deferred_manual","applicationScope":"sith_talisman_and_weapon_crafting","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"contributesGenericBonus":false,"modifiers":[],"notes":"UI/engine deferred: Sith Alchemy item/transformation workflows require dedicated UI and should not be faked as static bonuses.","combatActions":[{"name":"Sith Alchemy","actionType":"downtime","requiredTalent":"Sith Alchemy","description":"UI-dependent Sith Alchemy crafting/transformation talent; data cleaned, full alchemy/talisman/weapon/armor implementation deferred.","resolutionMode":"sithTalent","spendAction":false,"effects":[],"resources":["Sith Amulet","Sith Armor","Sith Talisman","Sith Weapon","Dedicated UI needed"],"notes":"Sith Alchemy is cleaned and surfaced as a manual card. Full implementation is deferred until the item/transformation UI exists.","manualResolution":true,"relatedSkills":[],"sithTalentAction":"sithAlchemy","id":"sith-alchemy","label":"Sith Alchemy"}],"rules":[],"sithTalentBackcheck":{"phase":"sith-dark-side-batch","status":"description_and_manual_card_only_ui_deferred","source":"user-pasted-rules-text","talismanUiDeferred":true}},"talent_tree":"Sith Alchemy","class":"Sith Apprentice","category":"Sith Apprentice","tree":"Sith Alchemy","summary":"Use Sith alchemy to create Sith amulets, dark armor, Sith talismans, and Sith weapons; each transformation increases your Dark Side Score by 1.","source":"Jedi Academy Training Manual","page":21},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.sith_alchemy","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.432Z","detectedPredicates":["attack.with-melee"],"forceTalentCleanup":{"phase":"T22","tree":"Sith Alchemy","status":"combat_action_card"},"sithTalentBackcheck":{"source":"user-pasted-rules-text","implemented":false,"uiDeferred":true,"action":"sithAlchemy"}}}}
{"_id":"eb503c1c3fb945a6","name":"Power Boost","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Power Surge","description":{"value":"You channel your power surge into a boost for your locomotion system. When you initiate a power surge, you can use one of the following bonuses with your installed locomotion system: Jump +4 squares (walking or wheeled locomotion), or increase hovering height by 4 squares (hovering locomotion). You can use this talent for a number of rounds equal to one-half your level (rounded down). At the end of a power boost, you move -1 persistent step on the condition track. The penalties imposed by this condition persist until you receive repairs (using the Repair Droid application of the Mechanics skill). You can use both Power Surge and Power Boost at the same time, but you must move -2 persistent steps on the condition track."},"benefit":"You channel your power surge into a boost for your locomotion system. When you initiate a power surge, you can use one of the following bonuses with your installed locomotion system: Jump +4 squares (walking or wheeled locomotion), or increase hovering height by 4 squares (hovering locomotion). You can use this talent for a number of rounds equal to one-half your level (rounded down). At the end of a power boost, you move -1 persistent step on the condition track. The penalties imposed by this condition persist until you receive repairs (using the Repair Droid application of the Mechanics skill). You can use both Power Surge and Power Boost at the same time, but you must move -2 persistent steps on the condition track.","class":"","category":"","costNumeric":null,"treeId":"cec49bc60d1646b1","tags":["condition_removal","droid","mechanics","mobility","power_systems","skills","sustained_damage","tech","vehicle"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase19DroidCleanup":{"status":"cleaned_future_runtime_context","owner":"future_power_surge_locomotion_choice_resolver","tree":"Specialized Droid","notes":"Unsafe migrated modifiers removed; talent requires a dedicated future runtime context before automation.","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0}},"summary":"You channel your power surge into a boost for your locomotion system.","source":"Scavenger's Guide to Droids","page":28},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.432Z","detectedPredicates":["movement.while-moving"]}}}
{"_id":"eb701499ba157c6a","name":"Mobile Attack (lightsabers)","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Multiattack Proficiency (lightsabers), Dual Weapon Mastery I, Weapon Focus (lightsabers)","benefit":"Immediately after making a full attack where you attack with two lightsabers (or both ends of a double-bladed lightsaber), you may move up to your speed as a free action.","description":{"value":"Immediately after making a full attack where you attack with two lightsabers (or both ends of a double-bladed lightsaber), you may move up to your speed as a free action."},"class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"dfc4142435b4356d","tags":["action_economy","force","force_control","force_offense","light_side","lightsaber","melee","mobility"],"executionModel":"ACTIVE","subType":"STATE","abilityMeta":{"modifiers":[{"target":"attack","value":0,"type":"untyped","predicates":[],"enabled":false,"priority":500,"description":"[REQUIRES MANUAL MAPPING] Mobile Attack (Lightsabers)"}],"status":"talent_backcheck_user_text_2026_06_11","description":"After a Full Attack with two lightsabers or a double-bladed lightsaber, move up to Speed as a free action.","applicationScope":"renamed_alias_record","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"metadataPhase":"jedi-prestige-talent-backcheck","metadataNotes":"Renamed stale imported title to match user-provided talent text.","rules":[{"type":"TALENT_RULE","id":"mobile-attack-lightsabers","label":"Mobile Attack (Lightsabers)","summary":"After a Full Attack with two lightsabers or a double-bladed lightsaber, move up to Speed as a free action.","action":"full-attack","text":"Immediately after making a Full Attack where you attacked with two Lightsabers (or both ends of a Double-Bladed Lightsaber), you may Move up to your Speed as a Free Action."}]},"slug":"mobile-attack-lightsabers","effect":"Immediately after making a Full Attack where you attacked with two Lightsabers (or both ends of a Double-Bladed Lightsaber), you may Move up to your Speed as a Free Action.","shortSummary":"After a Full Attack with two lightsabers or a double-bladed lightsaber, move up to Speed as a free action.","prerequisite":"Multiattack Proficiency (Lightsabers), Dual Weapon Mastery I, Weapon Focus (Lightsabers)","prerequisitesText":"Multiattack Proficiency (Lightsabers), Dual Weapon Mastery I, Weapon Focus (Lightsabers)","summary":"Immediately after making a full attack where you attack with two lightsabers (or both ends of a double-bladed lightsaber), you may move up to your speed as a free action.","source":"Knights of the Old Republic Campaign Guide","page":39},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.mobile_attack_lightsabers","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.432Z","detectedPredicates":[],"renamedFrom":"Mobile Attack (lightsabers)"}}}
{"_id":"ec12bc7f161a0893","name":"Squadron Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Charisma 13, Wisdom 13, any other ace pilot talent, Squadron Maneuvers, Starship Tactics","benefit":"Once per encounter, when you use a starship maneuver, you grant all ships in your squadron the ability to use the same maneuver once on their next turn. The pilot of each ship that chooses to use the maneuver must make any Pilot checks or attack rolls the maneuver requires—your success or failure with the maneuver has no bearing on the success of other units of your squadron.","description":{"value":"Once per encounter, when you use a starship maneuver, you grant all ships in your squadron the ability to use the same maneuver once on their next turn. The pilot of each ship that chooses to use the maneuver must make any Pilot checks or attack rolls the maneuver requires—your success or failure with the maneuver has no bearing on the success of other units of your squadron."},"class":"9c9989c34714f920","costNumeric":null,"category":"Ace Pilot","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"wis","min":13},{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.991dbfc3a436b5a1","name":"Squadron Maneuvers"}],"_source":"canonical-csv"},"treeId":"dc1b8c5ce2a70394","tags":["sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase16VehicleStarshipCleanup":{"status":"metadata_or_gm_player_managed","owner":"GM/player or future vehicle subsystem","notes":"No truthful automatic runtime owner in this pass; stale migrated modifiers/effects removed if present."}},"summary":"Once per encounter when you use a starship maneuver, each squadron ship may independently use that maneuver once on its next turn.","source":"Starships of the Galaxy","page":18},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.squadron_tactics","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.432Z","detectedPredicates":["turn.once-per-round"]}}}
{"_id":"ec12ce36ff7048f2","name":"Seize the Moment","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Distress to Discord","benefit":"Once per turn as a reaction, when an enemy is reduced to 0 hit points or is moved down the condition track by any means, you allow one ally within your line of sight to take its second wind immediately (as a free action). Furthermore, when your ally takes its second wind, it regains a number of additional hit points equal to your class level.","description":"Once per turn as a reaction, when an enemy is reduced to 0 hit points or is moved down the condition track by any means, you allow one ally within your line of sight to take its second wind immediately (as a free action). Furthermore, when your ally takes its second wind, it regains a number of additional hit points equal to your class level.","class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.974c24246ed2b972","name":"Distress to Discord"}],"_source":"canonical-csv"},"treeId":"da34105c875650ae","tags":["action_economy","damage_reduction","melee","mobility","positioning","ranged","shields","support","pursuit","reaction"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"hunter_pursuit_fear_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals.","phase26HunterPursuitFearCleanup":{"phase":"T26","tree":"Outlaw","status":"combat_action_card","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals."},"combatActions":[{"id":"seize-the-moment","name":"Seize the Moment","label":"Seize the Moment","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Once per encounter, whenever you would use , you can forgo the extra Swift Action to make an immediate melee or ranged attack against the damaged opponent. If your attack is a ranged attack that hits and deals damage, you treat the damage dealt by you and your ally as though it was one attack for purposes of overcoming Damage Reduction, Shield Rating, and determining whether the damage exceeded the target's Damage Threshold. Prerequisite: Whenever you would use , you can forgo the Swift Action to be able to Aim as a single Swift Action on your turn.","notes":"Once per encounter, whenever you would use , you can forgo the extra Swift Action to make an immediate melee or ranged attack against the damaged opponent. If your attack is a ranged attack that hits and deals damage, you treat the damage dealt by you and your ally as though it was one attack for purposes of overcoming Damage Reduction, Shield Rating, and determining whether the damage exceeded the target's Damage Threshold. Prerequisite: Whenever you would use , you can forgo the Swift Action to be able to Aim as a single Swift Action on your turn.","relatedSkills":[],"resources":[],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}]},"talent_tree":"Provocateur","tree":"Provocateur","summary":"Once per turn as a reaction, when an enemy is reduced to 0 hit points or is moved down the condition track by any means, you allow one ally within your line of sight to take its second wind immediately (as a free action).","source":"Legacy Era Campaign Guide","page":27},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.seize_the_moment","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.432Z","detectedPredicates":["attack.when-hit","attack.with-melee","attack.with-ranged","turn.on-current-turn","turn.once-per-round"],"talentHunterPursuitFearCleanup":{"phase":"T26","tree":"Outlaw","status":"combat_action_card"}}}}
{"_id":"ec18c61d653ce3e4","name":"Steady Under Pressure","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can choose to reroll any Treat Injury check, using the better result.","description":{"value":"You can choose to reroll any Treat Injury check, using the better result."},"class":"06f4d9029debf827","costNumeric":null,"category":"Medic","treeId":"61725c845d26ade0","tags":["action_economy","damage_reduction","healing","medicine","perception","positioning","skills","social","support","survivability","sustained_damage","teamwork","treat_injury"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase18MedicalBiotechCleanup":{"status":"cleaned_future_runtime_context","owner":"future_skill_reroll_resolver","notes":"Rerolls Treat Injury and keeps the better result; no safe generic passive defense bonus should apply."}},"summary":"You can choose to reroll any Treat Injury check, using the better result.","source":"Force Unleashed Campaign Guide","page":54},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.steady_under_pressure","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.432Z","detectedPredicates":["defense.will","attack.when-hit","proximity.ally-nearby"]}}}
{"_id":"ec3e6a05561ddc07","name":"Suppress Force","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Influence Savant, mind trick","benefit":"You can convince others that they have been cut off from the Force, even if that is not the case, preventing them from making Use the Force checks. Whenever a target with an Intelligence of 3 or higher within 12 squares of you and in your line of sight attempts to make a Use the Force check for any reason, you can spend one use of the mind trick Force power as a reaction. You make a Use the Force check, and if your Use the Force check equals or exceeds the target's Use the Force check result, that target's skill check is negated, and the action it was attempting fails.","description":"You can convince others that they have been cut off from the Force, even if that is not the case, preventing them from making Use the Force checks. Whenever a target with an Intelligence of 3 or higher within 12 squares of you and in your line of sight attempts to make a Use the Force check for any reason, you can spend one use of the mind trick Force power as a reaction. You make a Use the Force check, and if your Use the Force check equals or exceeds the target's Use the Force check result, that target's skill check is negated, and the action it was attempting fails.","costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.ced81064716debaa","name":"Influence Savant"}],"_source":"canonical-csv"},"treeId":"6ac3416fb6aada56","tags":["force","positioning","skill_substitution","telekinesis","telepathy","use_the_force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"manual_or_runtime","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Alter","status":"cleaned_manual_or_future_runtime","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"You can convince others that they have been cut off from the Force, even if that is not the case, preventing them from making Use the Force checks.","source":"Jedi Academy Training Manual","page":15},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.suppress_force","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.432Z","detectedPredicates":[],"forceTalentCleanup":{"phase":"T22","tree":"Alter","status":"cleaned_manual_or_future_runtime"}}}}
{"_id":"ec8f2ba706cc2c05","name":"Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can make a Persuasion check to intimidate a creature as a standard action instead of a full-round action.","description":{"value":"You can make a Persuasion check to intimidate a creature as a standard action instead of a full-round action."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","treeId":"8375b9b26b679901","tags":["action_economy","damage_reduction","force","force_defense","force_offense","melee","mobility","positioning","ranged","skills","social","support","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Talent granted-abilities/action-card data + GM/player resolution","notes":"data/talent-granted-abilities.json already exposes this as a Persuasion/Intimidate action option.","combatActions":[{"id":"presence","name":"Presence","label":"Presence","actionType":"standard","cost":1,"manualResolution":false,"resolutionMode":"auto","useLabel":"Roll / Use","description":"Make a Persuasion check to Intimidate a creature as a Standard Action instead of a Full-Round Action.","notes":"Make a Persuasion check to Intimidate a creature as a Standard Action instead of a Full-Round Action.","relatedSkills":[{"skill":"persuasion","when":"Intimidate application"}],"resources":[],"requiredContext":[],"targetHint":"One creature","spendAction":true,"ruleData":{},"skillKey":"persuasion"}],"manualResolution":false,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Influence","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debu