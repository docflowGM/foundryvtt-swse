{"_id":"d6faa4b87d5c35ce","name":"Pulling the Strings","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a standard action, you can make a Persuasion check against the Will Defense of a target within 12 squares. If you succeed, you move the target up to half its speed toward what you determine is the safest route, and you can make an immediate ranged or melee attack against the target if it is within your range. You cannot move an opponent into a hazard such as lava or off a cliff.","description":{"value":"As a standard action, you can make a Persuasion check against the Will Defense of a target within 12 squares. If you succeed, you move the target up to half its speed toward what you determine is the safest route, and you can make an immediate ranged or melee attack against the target if it is within your range. You cannot move an opponent into a hazard such as lava or off a cliff."},"costNumeric":null,"treeId":"da7b731a3e434a7a","tags":["deception","manipulation","mobility","offense_melee","persuasion","positioning","skills","social","standard_action","pursuit","mind-affecting","control"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"hunter_pursuit_fear_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals.","phase26HunterPursuitFearCleanup":{"phase":"T26","tree":"Genohardan","status":"combat_action_card","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals."},"combatActions":[{"id":"pulling-the-strings","name":"Pulling the Strings","label":"Pulling the Strings","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Standard Action, you can make a Persuasion check against the Will Defense of a target within 12 squares. If you succeed, you move the target up to half its speed toward you through the safest route, and you make an immediate ranged or melee attack against the the target if it is within Range. You cannot move an opponent into a Hazard (such as into lava or off a cliff).","notes":"As a Standard Action, you can make a Persuasion check against the Will Defense of a target within 12 squares. If you succeed, you move the target up to half its speed toward you through the safest route, and you make an immediate ranged or melee attack against the the target if it is within Range. You cannot move an opponent into a Hazard (such as into lava or off a cliff).","relatedSkills":[{"skill":"persuasion","when":"Against target Will Defense"},{"skill":"Attack Roll","when":"Immediate attack if target ends in range"}],"resources":["Move target half speed toward you","Immediate attack if in range","Mind-affecting"],"requiredContext":["Target within 12 squares"],"targetHint":"One target","spendAction":true,"ruleData":{}}]},"summary":"As a standard action, you can make a Persuasion check against the Will Defense of a target within 12 squares.","source":"Scum and Villainy","page":30},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.pulling_the_strings","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":["defense.will"],"talentHunterPursuitFearCleanup":{"phase":"T26","tree":"Genohardan","status":"combat_action_card"}}}}
{"_id":"d7870d0940a3ce0b","name":"Ranged Disarm","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can disarm an opponent using a ranged attack. If your ranged disarm attack fails, your opponent doesn't get to make a free attack against you (see Disarm, page 152).","description":{"value":"You can disarm an opponent using a ranged attack. If your ranged disarm attack fails, your opponent doesn't get to make a free attack against you (see Disarm, page 152)."},"class":"162d866ba36fce69","costNumeric":null,"category":"Gunslinger","treeId":"cb6f775cd227a3e3","tags":["action_economy","condition_removal","lightsaber","melee","mobility","positioning","ranged","unarmed"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action_reference","applicationScope":"martial_protector_arena_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","combatActions":[{"id":"ranged-disarm-t30-reference","name":"Ranged Disarm","label":"Ranged Disarm","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"You can Disarm an opponent using a ranged attack. If your ranged Disarm attack fails, your opponent doesn't get to make a free attack against you.","notes":"You can Disarm an opponent using a ranged attack. If your ranged Disarm attack fails, your opponent doesn't get to make a free attack against you.","relatedSkills":[],"resources":["GM/player confirmed context"],"requiredContext":["GM/player confirms valid trigger"],"targetHint":"GM/player adjudicated target or context","spendAct