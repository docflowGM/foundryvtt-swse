{"_id":"192279eaa0b61d36","name":"Dark Preservation","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Power of the Dark Side","benefit":"Whenever an effect would normally move you down the condition track, you may spend a Force Point and increase your Dark Side Score by 1 to negate that movement down the condition track.","description":{"value":"Whenever an effect would normally move you down the condition track, you may spend a Force Point and increase your Dark Side Score by 1 to negate that movement down the condition track."},"costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.627bd3abd30b973f","name":"Power of the Dark Side"}],"_source":"canonical-csv"},"treeId":"de95d37c72b1c4cd","tags":["condition_removal","dark_side","force","force_multiplier"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"dark-preservation","name":"Dark Preservation","label":"Dark Preservation","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Increase your Dark Side Score by 1 to stop moving down the condition track.","notes":"Increase your Dark Side Score by 1 to stop moving down the condition track.","relatedSkills":[],"resources":["Increase Dark Side Score by 1","Negate condition-track movement down"],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Dark Side","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"source":"Legacy Era Campaign Guide","page":55},"effects":[],"folder":null,