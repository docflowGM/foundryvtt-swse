{"_id":"f7a7ecda71555b5c","name":"Disciplined Trickery","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per turn as a reaction, you allow one ally within 12 squares of you and in your line of sight to reroll one Deception or Stealth check, but the ally must keep the second result, even if it is worse.","description":{"value":"Once per turn as a reaction, you allow one ally within 12 squares of you and in your line of sight to reroll one Deception or Stealth check, but the ally must keep the second result, even if it is worse."},"class":"30b9cd24b80ebf46","costNumeric":null,"category":"Officer","treeId":"61b74c82cb56876c","tags":["positioning","skills","social","stealth","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"disciplined-trickery","name":"Disciplined Trickery","label":"Disciplined Trickery","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per turn, allow one ally within 12 squares and line of sight to reroll one Deception or Stealth check. The ally must accept the reroll.","notes":"Once per turn, allow one ally within 12 squares and line of sight to reroll one Deception or Stealth check. The ally must accept the reroll.","relatedSkills":[{"skill":"Deception"},{"skill":"Stealth"}],"resources":["Once per turn","Must accept reroll"],"requiredContext":[],"targetHint":"One ally within 12 squares and line of sight","spendAction":true,"ruleData":{}}],"manualResolution":true,"p