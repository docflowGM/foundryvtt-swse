{"_id":"606e14c428f1d159","name":"Dark Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Charisma 13; Power of the Dark Side","benefit":"As a standard action, you grant yourself and all allies within 6 squares a +1 Force bonus to all defenses until the end of the encounter. The bonuses are lost if you fall unconscious or die. Affected allies who move out of range lose the benefits for as long as they remain out of range.","description":"As a standard action, you grant yourself and all allies within 6 squares a +1 Force bonus to all defenses until the end of the encounter. The bonuses are lost if you fall unconscious or die. Affected allies who move out of range lose the benefits for as long as they remain out of range.","costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"cha","min":13},{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.627bd3abd30b973f","name":"Power of the Dark Side"}],"_source":"canonical-csv"},"treeId":"de95d37c72b1c4cd","tags":["damage_reduction","dark_side","force","force_multiplier","force_offense","scaling","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"dark-presence","name":"Dark Presence","label":"Dark Presence","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Power of the Dark Side Whenever an ally of equal or higher level than you is killed or reduced to 0 hit points within your line of sight, you gain a +2 Force bonus on attack rolls and damage rolls until the end of the encounter. (Since Force bonuses do not stack, you don't get a higher bonus if more than one ally falls in the same encounter.)","notes":"Power of the Dark Side Whenever an ally of equal or higher level than you is killed or reduced to 0 hit points within your line of sight, you gain a +2 Force bonus on attack rolls and damage rolls until the end of the encounter. (Since Force bonuses do not stack, you don't get a higher bonus if more than one ally falls in the same encounter.)","relatedSkills":[],"resources":["Dark Side presence/ally defense context; verify exact source text"],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Dark Side","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"Standard action: you and nearby allies gain +1 Force to all defenses for the encounter while you remain conscious and in range.","source":"Saga Edition Core Rulebook","page":101},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.dark_presence","forceTalentCleanup":{"phase":"T22","tree":"Dark Side","status":"combat_action_card"}}}}
{"_id":"60b02b78caed8e16","name":"Wingman","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Wisdom 13","benefit":"As a swift action, you can make a DC 15 Pilot check to assist any allied starfighter or airspeeder within 2 squares at starship scale. If you succeed, the pilot of that vehicle gains a +5 bonus on all opposed Pilot checks relating to the dogfight action until the start of your next turn.","description":{"value":"As a swift action, you can make a DC 15 Pilot check to assist any allied starfighter or airspeeder within 2 squares at starship scale. If you succeed, the pilot of that vehicle gains a +5 bonus on all opposed Pilot checks relating to the dogfight action until the start of your next turn."},"class":"9c9989c34714f920","costNumeric":null,"category":"Ace Pilot","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"wis","min":13}],"_source":"canonical-csv"},"treeId":"b17c1515c06361d6","tags":["action_economy","mobility","positioning"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"wingman-assist","name":"Wingman","label":"Wingman","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Make a DC 15 Pilot check to assist an allied starfighter or airspeeder within 2 squares at starship scale; on success, that pilot gains +5 on opposed Pilot checks related to Dogfight until your next turn.","notes":"Make a DC 15 Pilot check to assist an allied starfighter or airspeeder within 2 squares at starship scale; on success, that pilot gains +5 on opposed Pilot checks related to Dogfight until your next turn.","relatedSkills":[{"skill":"Pilot"}],"resources":["Vehicle ally"]}],"phase16VehicleStarshipCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual combat action card in the action economy UI."}},"summary":"Swift DC 15 Pilot check grants a nearby allied starfighter or airspeeder +5 on opposed dogfight Pilot checks until your next turn.","source":"Starships of the Galaxy","page":17},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.wingman","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.414Z","detectedPredicates":[]}}}
{"_id":"61302cbe9ccdea12","name":"Renew Vision","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per encounter, you can regain all expended uses of the farseeing power as a swift action.","description":{"value":"Once per encounter, you can regain all expended uses of the farseeing power as a swift action."},"class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"e99cfa9db8493573","tags":["force","light_side"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"renew-vision","name":"Renew Vision","label":"Renew Vision","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, you can regain all expended uses of the Farseeing Force Power as a Swift Action.","notes":"Once per encounter, you can regain all expended uses of the Farseeing Force Power as a Swift Action.","relatedSkills":[],"resources":["Once per encounter"],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{}}],"rules":[],"mechanicsMode":"contextual","applicationScope":"force_lightsaber_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":false,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Jedi Consular","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":1,"notes":"Jedi/lightsaber/Mystic leftover pass removed embedded effects and surfaces activation/timing/target context through action cards or resolver rules."},"implementationNote":"Implemented through ConsularTalentActions.promptRenewVision and the combat action tracker."},"implementationNote":"Implemented through ConsularTalentActions.promptRenewVision and the combat action tracker.","summary":"Once per encounter, you can regain all expended uses of the farseeing power as a swift action.","source":"Knights of the Old Republic Campaign Guide