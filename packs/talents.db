{"_id":"bebc181408831371","name":"Master Mender","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Expert Shaper","benefit":"Whenever you temporarily mend a biotech device using the Treat Injury skill (see page 32), the mended device moves +4 steps on the condition track. In addition, the mended device only moves -3 steps down the condition track at the end of the scene or encounter, and is only disabled if this reduction brings it to -5 steps on the track.","description":{"value":"Whenever you temporarily mend a biotech device using the Treat Injury skill (see page 32), the mended device moves +4 steps on the condition track. In addition, the mended device only moves -3 steps down the condition track at the end of the scene or encounter, and is only disabled if this reduction brings it to -5 steps on the track."},"class":"557e1a5ec72166fd","costNumeric":null,"category":"Shaper","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.f9047f30ef6712af","name":"Expert Shaper"}],"_source":"canonical-csv"},"treeId":"cdbee578d65154fc","tags":["ability_enhancement","biotech","condition_removal","crafting","healing","mobility","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase18MedicalBiotechCleanup":{"status":"cleaned_future_runtime_context","owner":"future_biotech_mending_resolver","notes":"Improves temporary Biotech mending condition-track recovery only during that specific Treat Injury use."}},"summary":"Whenever you temporarily mend a biotech device using the Treat Injury skill (see page 32), the mended device moves +4 steps on the condition track.","source":"Legacy Era Campaign Guide","page":47},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.master_mender","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.426Z","detectedPredicates":[]}}}
