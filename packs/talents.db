{"_id":"e15adb60be0dda02","name":"Known Dissident","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Know Your Enemy","benefit":"You are a well-known opponent of a large and influential government or organization (such as the Empire or the Corporate Sector Authority). Officials of any level are loath to take action against you, lest they inadvertently promote your cause. As a standard action, you can make a Persuasion check against the Will Defense of a single opponent within line of sight that can hear and understand you. If your Persuasion check succeeds, that opponent may not attack you or any vehicle you occupy until the start of your next turn. If the target is of higher level than you, it gains a +5 bonus to its Will Defense, and the target must be able to hear and understand you. If the target is attacked, the effect of this talent ends. This is a mind-affecting effect.","description":{"value":"You are a well-known opponent of a large and influential government or organization (such as the Empire or the Corporate Sector Authority). Officials of any level are loath to take action against you, lest they inadvertently promote your cause. As a standard action, you can make a Persuasion check against the Will Defense of a single opponent within line of sight that can hear and understand you. If your Persuasion check succeeds, that opponent may not attack you or any vehicle you occupy until the start of your next turn. If the target is of higher level than you, it gains a +5 bonus to its Will Defense, and the target must be able to hear and understand you. If the target is attacked, the effect of this talent ends. This is a mind-affecting effect."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.72cfc8816ea3ebf5","name":"Know Your Enemy"}],"_source":"canonical-csv"},"treeId":"d65a4816379802ee","tags":["skills","social"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed target context","notes":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists.","combatActions":[{"id":"known-dissident","name":"Known Dissident","label":"Known Dissident","actionType":"standard","cost":1,"manualResolution":false,"resolutionMode":"auto","useLabel":"Roll / Use","description":{"resources":["Mind-affecting","Target must hear and understand you","Higher-level target gains +5 Will Defense"],"targetHint":"One opponent within line of sight","when":"Persuasion vs Will Defense"},"notes":{"resources":["Mind-affecting","Target must hear and understand you","Higher-level target gains +5 Will Defense"],"targetHint":"One opponent within line of sight","when":"Persuasion vs Will Defense"},"relatedSkills":[{"skill":"Make Persuasion against one opponent's Will Defense. On success, the opponent may not attack you or any vehicle you occupy until the start of your next turn unless attacked.","when":""}],"resources":[],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{},"skillKey":"Make Persuasion against one opponent's Will Defense. On success, the opponent may not attack you or any vehicle you occupy until the start of your next turn unless attacked."}],"manualResolution":false,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Ideologue","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"You are a well-known opponent of a large and influential government or organization (such as the Empire or the Corporate Sector Authority).","source":"Force Unleashed Campaign Guide","page":25},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.known_dissident","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.431Z","detectedPredicates":["defense.will"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"GM/player managed target context","note":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists."}}}}
