{"_id":"17ec736c3984fe43","name":"Turret Self-Destruct","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Blaster Turret I","benefit":"Your turret self-destructs automatically when it reaches 0 hit points. It explodes in a 2-square radius, dealing its normal damage. If you are adjacent to the turret, you can disable this feature as a reaction.","description":{"value":"Your turret self-destructs automatically when it reaches 0 hit points. It explodes in a 2-square radius, dealing its normal damage. If you are adjacent to the turret, you can disable this feature as a reaction."},"class":"de3f367749b82fcf","costNumeric":null,"category":"Saboteur","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.7b56d0b92582ae88","name":"Blaster Turret I"}],"_source":"canonical-csv"},"treeId":"92b30151b9b21109","tags":["action_economy","damage_reduction","positioning"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"turret_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Turret","status":"cleaned_runtime_context","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Unsafe passive/ActiveEffect data removed. Talent is represented by action cards, attack options, hit/critical riders, or explicit manual metadata as appropriate."},"combatActions":[{"id":"disable-turret-self-destruct","name":"Disable Turret Self-Destruct","label":"Disable Turret Self-Destruct","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"If adjacent to your turret when it would self-destruct at 0 HP, use your reaction to disable the explosion.","notes":"If adjacent to your turret when it would self-destruct at 0 HP, use your reaction to disable the explosion.","relatedSkills":[],"resources":["Reaction","Adjacent to turret"],"requiredContext":[],"targetHint":""}],"manualResolution":true},"summary":"Your turret self-destructs automatically when it reaches 0 hit points.","source":"Force Unleashed Campaign Guide","page":57},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.turret_self_destruct","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.405Z","detectedPredicates":[]}}}
{"_id":"181da7f36b9fba9d","name":"Force Treatment","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can make a Use the Force check in place of a Treat Injury check. You are considered Trained in the Treat Injury Skill. If you are entitled to a Treat Injury check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations).\n\nIn addition, you can administer First Aid, Treat Disease, Treat Poison, and Treat Radiation without the requisite Medical Kit or Medpac.","description":{"value":"You can make a Use the Force check in place of a Treat Injury check. You are considered Trained in the Treat Injury Skill. If you are entitled to a Treat Injury check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations).\n\nIn addition, you can administer First Aid, Treat Disease, Treat Poison, and Treat Radiation without the requisite Medical Kit or Medpac."},"class":"289fcf920ef0e184","costNumeric":null,"category":"Force Adept","treeId":"e35ee41362604227","tags":["balance","force","force_capacity","force_training","healing","support","survivability","use_the_force","will_defense"],"executionModel":"ACTIVE","subType":"TALENT_ACTION","abilityMeta":{"mechanicsMode":"conditional_or_metadata","applicationScope":"skill_substitution_treat_injury","staticSheetPolicy":"exclude","implementedBy":"DerivedCalculator.prepareDerivedData -> Force Treatment skill substitution","notes":"Treat Treat Injury as trained and use Use the Force total when higher. Medkit/medpac exception is table/skill-use note until skill-use prompts support it.","modifiers":[],"combatActions":[{"id":"force-treatment","name":"Force Treatment","actionType":"standard","requiredTalent":"Force Treatment","description":"You can make a Use the Force check in place of a Treat Injury check. You are considered Trained in the Treat Injury Skill. If you are entitled to a Treat Injury check rero