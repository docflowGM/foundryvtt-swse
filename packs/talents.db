{"_id":"e8922370838f2965","name":"Idealist","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Charisma 13","benefit":"Your confidence empowers you, giving you the ability to withstand the harmful influence of others. You can add your Charisma bonus in place of your Wisdom bonus to your Will Defense.","description":{"value":"Your confidence empowers you, giving you the ability to withstand the harmful influence of others. You can add your Charisma bonus in place of your Wisdom bonus to your Will Defense."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"cha","min":13}],"_source":"canonical-csv"},"treeId":"d65a4816379802ee","tags":["will_defense","defense","ability_enhancement","resilience"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"implemented_static_rule","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"defenseAbilityRules":[{"type":"USE_BETTER_ABILITY","defense":"will","abilities":["wis","cha"],"source":"Idealist"}],"implementedBy":"DefenseCalculator defense ability rule","notes":"Implemented as a defense ability rule so Will Defense can use Charisma instead of Wisdom when better.","phase23SocialCommanderCleanup":{"phase":"T23","tree":"Ideologue","status":"implemented_static_rule","cardsAdded":0,"notes":"Implemented as a defense ability rule so Will Defense can use Charisma instead of Wisdom when better."}},"summary":"Your confidence empowers you, giving you the ability to withstand the harmful influence of others.","source":"Force Unleashed Campaign Guide","page":25},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.idealist","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.431Z","detectedPredicates":["defense.will"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"implemented_existing_owner","owner":"DefenseCalculator defense ability rule","note":"Canon text allows Charisma in place of Wisdom for Will Defense; implemented as a defense ability rule, not a flat Will bonus."}}}}
{"_id":"e8bf1222fd6289e4","name":"Lightsaber Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a swift action, you can use your lightsaber to parry your opponents' attacks, gaining a +1 deflection bonus to your Reflex Defense until the start of your next turn. You must have a lightsaber drawn and ignited to use this talent, and you don't gain the deflection bonus if you are flat-footed or otherwise unaware of the incoming attack.\n\nYou can take this talent multiple times; each time you take this talent, the deflection bonus increases by +1 (maximum +3).","description":{"value":"As a swift action, you can use your lightsaber to parry your opponents' attacks, gaining a +1 deflection bonus to your Reflex Defense until the start of your next turn. You must have a lightsaber drawn and ignited to use this talent, and you don't gain the deflection bonus if you are flat-footed or otherwise unaware of the incoming attack.\n\nYou can take this talent multiple times; each time you take this talent, the deflection bonus increases by +1 (maximum +3)."},"class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"2359c05ff13f3feb","tags":["lightsaber","melee","force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"active_temporary_bonus","applicationScope":"self_defense_buff","staticSheetPolicy":"exclude","manualResolution":false,"notes":"Swift-action lightsaber parry granting +1 deflection to Reflex until next turn while lightsaber is drawn/ignited and not flat-footed. Needs active combat state; no permanent Reflex bonus.","modifiers":[],"requiresRuntimeContext":true},"talent_tree":"Lightsaber Combat","talentTree":"Lightsaber Combat","tree":"Lightsaber Combat","summary":"As a swift action, you can use your lightsaber to parry your opponents' attacks, gaining a +1 deflection bonus to your Reflex Defense until the start of your next turn.","source":"Saga Edition Core Rulebook","page":41},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.lightsaber_defense","jediTreeCleanup":{"phase":"T7","status":"manual_or_contextual","reason":"Swift-action lightsaber parry granting +1 deflection to Reflex until next turn while lightsaber is drawn/ignited and not flat-footed. Needs active combat state; no permanent Reflex bonus."},"lightsaberTalentImplementation":{"status":"runtime_action_or_contextual","updated":"2026-06-11"}}}}
{"_id":"e8fe6087eef386c7","name":"Findsman's Foresight","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Findsman Ceremonies","benefit":"The visions you receive sometimes provide clues about dangerous situations. Whenever you make a Perception check to avoid surprise, you may roll two dice and keep the better result.","description":{"value":"The visions you receive sometimes provide clues about dangerous situations. Whenever you make a Perception check to avoid surprise, you may roll two dice and keep the better result."},"class":"336bba6d1e517c92","costNumeric":null,"category":"Bounty Hunter","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.661c2c0665e911f6","name":"Findsman Ceremonies"}],"_source":"canonical-csv"},"treeId":"022b31d355c840a9","tags":["ambush","evasion","perception","skills","force","visions","reaction"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","manualResolution":true,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","combatActions":[{"id":"findsmans-foresight-t31-reference","name":"Findsman's Foresight","label":"Findsman's Foresight","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"The visions you receive sometimes provide clues about dangerous situations. Whenever you make a Perception check to avoid Surprise, you may roll twice, keeping the better of the two results.","notes":"The visions you receive sometimes provide clues about dangerous situations. Whenever 