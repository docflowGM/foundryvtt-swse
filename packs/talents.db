{"_id":"962c8a24f9caaba0","name":"Rally","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Born Leader, Distant Command.","benefit":"Once per encounter, you can rally your allies and bring them back from the edge of defeat. As a Swift Action, any allies within your line of sight who have less than half their total hit points remaining gain a +2 morale bonus to their Reflex Defense and Will Defense, and a +2 bonus to all damage rolls for the remainder of the encounter.","description":{"value":"Once per encounter, you can rally your allies and bring them back from the edge of defeat. As a Swift Action, any allies within your line of sight who have less than half their total hit points remaining gain a +2 morale bonus to their Reflex Defense and Will Defense, and a +2 bonus to all damage rolls for the remainder of the encounter."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.64fa257cd511314d","name":"Distant Command"}],"_source":"canonical-csv"},"treeId":"5964237d22681dc0","tags":["scaling"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Talent granted-abilities/action-card data + GM/player resolution","notes":"data/talent-granted-abilities.json has a Rally entry; affected allies, HP threshold, vehicles, and duration are runtime/table context.","combatActions":[{"id":"rally","name":"Rally","label":"Rally","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, allies in line of sight below half hit points gain +2 morale bonus to Reflex Defense and Will Defense and +2 damage for the remainder of the encounter. 