{"_id":"221eb131fcb23585","name":"Great Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When firing a vehicle weapon, you treat the distance to the target as though it were one range category less than it actually is. For example, when targeting an enemy at short range, you treat it as though it were at point blank range for the purpose of determining bonuses or penalties.","description":{"value":"When firing a vehicle weapon, you treat the distance to the target as though it were one range category less than it actually is. For example, when targeting an enemy at short range, you treat it as though it were at point blank range for the purpose of determining bonuses or penalties."},"class":"9c9989c34714f920","costNumeric":null,"category":"Ace Pilot","treeId":"43ead399d82b8142","tags":["damage_reduction","positioning","ranged"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"rules":[{"type":"ATTACK_OPTION","id":"great-shot","label":"Great Shot","control":"passive","requiresVehicleWeapon":true,"rangePenaltyAdjustment":"oneStepCloser","summary":"When firing a vehicle weapon, treat the target as one range category closer."}],"phase16VehicleStarshipCleanup":{"status":"contextual_runtime_rule","owner":"CombatOptionResolver / attack pipeline","notes":"Curated vehicle/starship contextual rule; does not modify static actor totals."}},"summary":"Treat vehicle-weapon targets as one range category closer for range bonuses and penalties.","source":"Starships of the Galaxy","page":17},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.great_shot","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.405Z","detectedPredicates":[]}}}
{"_id":"223ba62ffbabb9c2","name":"Hailfire","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Dual Weapon Mastery I","benefit":"When you are wielding two pistols, as a standard action you can make an autofire attack with one of the pistols as though the weapon were set to autofire, even if the pistol would not normally be capable of autofire. The normal penalties for autofire still apply to this attack roll, and you may split the number of shots consumed between the two pistols.","description":{"value":"When you are wielding two pistols, as a standard action you can make an autofire attack with one of the pistols as though the weapon were set to autofire, even if the pistol would not normally be capable of autofire. The normal penalties for autofire still apply to this attack roll, and you may split the number of shots consumed between the two pistols."},"class":"162d866ba36fce69","costNumeric":null,"category":"Gunslinger","treeId":"ed77ab2e234089ed","tags":["burst_damage","ranged"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"combat_option_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Future CombatOptionResolver / action-card / reaction prompt / damage-resolution hook","notes":"Reviewed in T12. Removed legacy static/passive modifier data; this talent is a real combat mechanic but needs runtime context and should not mutate permanent sheet totals.","combatActions":[{"id":"hailfire","name":"Hailfire","label":"Hailfire","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"While wielding two pistols, make an autofire attack with one pistol as though it were autofire-capable.","notes":"While wielding two pistols, make an autofire attack with one pistol as though it were autofire-capable.","relatedSkills":[{"skill":"Attack Roll