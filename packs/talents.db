{"_id":"bef731c3743c2c7f","name":"Precision Fire","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"The Jedi are skilled at blocking and deflecting ranged attacks with their lightsabers, and you are able to compensate for this to some degree by taking careful shots. Whenever you aim before making a ranged attack, you increase the difficulty of Deflect attempts to negate your attack by +5.","description":{"value":"The Jedi are skilled at blocking and deflecting ranged attacks with their lightsabers, and you are able to compensate for this to some degree by taking careful shots. Whenever you aim before making a ranged attack, you increase the difficulty of Deflect attempts to negate your attack by +5."},"class":"336bba6d1e517c92","costNumeric":null,"category":"Bounty Hunter","treeId":"29b16e48a3dbf165","tags":["force","force_offense","anti-force","pursuit","reaction"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"hunter_pursuit_fear_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals.","phase26HunterPursuitFearCleanup":{"phase":"T26","tree":"Force Hunter","status":"combat_action_card","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals."},"combatActions":[{"id":"precision-fire","name":"Precision Fire","label":"Precision Fire","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"The Jedi are skilled at blocking and deflectin