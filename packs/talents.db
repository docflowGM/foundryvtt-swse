{"_id":"8a5f8b5c9b9fabaf","name":"Deployment Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can use your tactical knowledge to direct allies in battle. As a Move Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, you and any allies that can see, hear, and understand you gain a +1 competence bonus on attack rolls against Flanked opponents, or a +1 dodge bonus to Reflex Defense against Attacks of Opportunity (character's choice). The bonus lasts until the start of your next turn. This is a Mind-Affecting effect. If you have the Born Leader Talent or the Battle Analysis Talent, the bonus granted by this Talent increases to +2.","description":{"value":"You can use your tactical knowledge to direct allies in battle. As a Move Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, you and any allies that can see, hear, and understand you gain a +1 competence bonus on attack rolls against Flanked opponents, or a +1 dodge bonus to Reflex Defense against Attacks of Opportunity (character's choice). The bonus lasts until the start of your next turn. This is a Mind-Affecting effect.\n\nIf you have the Born Leader Talent or the Battle Analysis Talent, the bonus granted by this Talent increases to +2."},"class":"30b9cd24b80ebf46","costNumeric":null,"category":"Officer","treeId":"9253ace716c3e966","tags":["action_economy","evasion","mobility","positioning","skills","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"deployment-tactics","name":"Deployment Tactics","label":"Deployment Tactics","actionType":"move","cost":1,"manualResolution":false,"resolutionMode":"auto","useLabel":"Roll / Use","description":"On a DC 15 Knowledge (Tactics) check, you and allies who can see/hear/understand you gain either +1 attack against flanked opponents or +1 dodge Reflex against attacks of opportunity until the start of your next turn. Born Leader or Battle Analysis can increase this to +2.","notes":"On a DC 15 Knowledge (Tactics) check, you and allies who can see/hear/understand you gain either +1 attack against flanked opponents or +1 dodge Reflex against attacks of opportunity until the start of your next turn. Born Leader or Battle Analysis can increase this to +2.","relatedSkills":[{"skill":"knowledge","when":""}],"resources":["Mind-affecting","Knowledge (Tactics) DC 15"],"requiredContext":[],"targetHint":"You and qualifying allies","spendAction":true,"ruleData":{},"skillKey":"knowledge","dc":15}],"manualResolution":false,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Military Tactics","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"You can use your tactical knowledge to direct allies in battle. As a Move Action, you can make a DC 15 Knowledge (Tactics) check.","source":"Saga Edition Core Rulebook","page":221},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deployment_tactics","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.420Z","detectedPredicates":["defense.reflex","proximity.ally-nearby"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Follower/dependent-actor subsystem or GM/player managed","note":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals."}}}}
