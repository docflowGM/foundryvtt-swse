{"_id":"86fbb269a17a8c5e","name":"Masquerade","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Illusion","benefit":"You can use the Illusion talent to create a disguise for yourself. You use the result of your Use the Force check made to create the illusion for the purposes of creating a deceptive appearance, as per the application of the Deception skill. All other rules and restrictions for using the Illusion talent still apply.","description":"You can use the Illusion talent to create a disguise for yourself. You use the result of your Use the Force check made to create the illusion for the purposes of creating a deceptive appearance, as per the application of the Deception skill. All other rules and restrictions for using the Illusion talent still apply.","costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.708a47d1be414990","name":"Illusion"}],"_source":"canonical-csv"},"treeId":"6ac3416fb6aada56","tags":["deception","force","illusion","skill_substitution","skills","social","telekinesis","telepathy","use_the_force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"manual_or_runtime","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Alter","status":"cleaned_manual_or_future_runtime","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"You can use the Illusion talent to create a disguise for yourself.","source":"Jedi Academy Training Manual","page":15},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.masquerade","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.420Z","detectedP