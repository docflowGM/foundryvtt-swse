{"_id":"b85b92b788f7fa54","name":"Distracting Apparition","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Manifest Guardian Spirit","benefit":"When you have a manifested guardian spirit, the spirit also discourages your enemies and distracts them from their goals. Any enemy within 3 squares of your guardian spirit takes a -2 penalty to Will Defense and a -2 penalty on attack rolls against you.","description":"When you have a manifested guardian spirit, the spirit also discourages your enemies and distracts them from their goals. Any enemy within 3 squares of your guardian spirit takes a -2 penalty to Will Defense and a -2 penalty on attack rolls against you.","costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.3449cb22b384498b","name":"Manifest Guardian Spirit"}],"_source":"canonical-csv"},"treeId":"6629c34384c4ca53","tags":["ally_support","healing","positioning","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"manual_or_reference_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"modifiers":[],"combatActions":[{"id":"distracting-apparition","name":"Distracting Apparition","label":"Distracting Apparition","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Enemies within 3 squares of the apparition take -2 Will Defense and -2 attack against you.","notes":"Enemies within 3 squares of the apparition take -2 Will Defense and -2 attack against you.","relatedSkills":[],"resources":[],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[],"notes":"T28 removed unsafe migrated modifier/effect data. This talent depends on Force-suite, target, equipment, ally, encounter, or table-position context and is surfaced as a truthful manual/runtime card rather than a passive actor mutation.","phase28ForceMicrotraditionCleanup":{"phase":"T28","tree":"Guardian Spirit","status":"reviewed_contextual_or_manual_card","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Force/special-tradition microtree cleanup. Unsafe always-on rows were removed; final bonuses/effects require player/GM or future dedicated runtime owner."}},"summary":"When you have a manifested guardian spirit, the spirit also discourages your enemies and distracts them from their goals.","source":"Jedi Academy Training Manual","page":17},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.distracting_apparition","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.426Z","detectedPredicates":["defense.will"]}}}
{"_id":"b89d573dba9ddb20","name":"Assured Skill","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"When you select this talent, choose one skill. Whenever you roll a skill check with that skill, you can choose to lose any competence bonuses to that skill check and instead roll 2 dice, keeping either result.\n\nYou can select this talent multiple times. Each time you do so, you must choose a different skill to gain the benefits of this talent."},"benefit":"When you select this talent, choose one skill. Whenever you roll a skill check with that skill, you can choose to lose any competence bonuses to that skill check and instead roll 2 dice, keeping either result.\n\nYou can select this talent multiple times. Each time you do so, you must choose a different skill to gain the benefits of this talent.","class":"","category":"","costNumeric":null,"treeId":"04a6f32128cc4b98","talent_tree":"Superior Skills","source":"Galaxy of Intrigue","page":21,"tags":["reroll","skill-mastery","skills","support"],"executionModel":"PASSIVE","subType":"STATE","repeatable":true,"abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":true,"modifiers":[],"implementedBy":"GM/player managed","notes":"The talent resolves against live check results, encounter state, or player timing decisions and should not alter permanent actor values.","combatActions":[],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"assured-skill-superior-skills-context","label":"Assured Skill","summary":"When you select this Talent, choose one Skill. Whenever you roll a Skill Check with that Skill, you can choose to lose any competence bonuses to that Skill Check and instead roll twice, keeping either result. You can select this Talent multiple times. Each time you do so, you must choose a different Skill to gain the benefits of this Talent."}]},"choiceMeta":{"resolution":"immediate","required":true,"repeatable":true,"choiceKind":"skill","choiceKey":"assured_skill","choiceSource":"fixed","storagePath":"flags.swse.choices.assured_skill","optionRegistry":"data/feat-choice-options.json#choiceKinds.skill","label":"Assured Skill Skill","prompt":"Choose the Skill that Assured Skill applies to."},"summary":"For one chosen skill, forgo competence bonuses to roll twice and keep either result; may be selected for different skills."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"b8a9dd4c950a96f5","name":"Incite Rage","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per encounter as a swift action, you can channel your anger and hatred into your allies. All allies within 12 squares of you and in your line of sight gain a +1 rage bonus on attack rolls but take a -2 penalty to their Reflex Defense. This effect lasts until the encounter ends, or you are knocked unconscious or killed.","description":{"value":"Once per encounter as a swift action, you can channel your anger and hatred into your allies. All allies within 12 squares of you and in your line of sight gain a +1 rage bonus on attack rolls but take a -2 penalty to their Reflex Defense. This effect lasts until the encounter ends, or you are knocked unconscious or killed."},"class":"1ba03b2d00245906","costNumeric":null,"category":"Sith Apprentice","treeId":"4d5ac20318ef56b6","tags":["action_economy","dark_side","force","force_offense","mobility","scaling","support","swift_action"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","manualResolution":false,"modifiers":[],"notes":"Once-per-encounter aura grants allies rage attack bonus and Reflex penalty while conditions remain true.","requiresRuntimeContext":true,"requiresSelectedChoice":false,"combatActions":[{"name":"Incite Rage","actionType":"swift","requiredTalent":"Incite Rage","description":"Once per encounter as a Swift Action, you can channel your anger and hatred into your allies. All allies within 12 squares of you and in your line of sight gain a +1 rage bonus on attack rolls, but take a -2 penalty to their Reflex Defense. This effect lasts until the encounter ends, or until you are knocked unconscious or killed.","resolutionMode":"sithTalent","spendAction":true,"effects":[],"resources":["Once per encounter","Rage attack bonus","Reflex penalty"],"notes":"Targets selected allies and flags +1 attack / -2 Reflex until encounter end or the Sith commander is incapacitated. Range and line of sight remain adjudicated.","manualResolution":false,"relatedSkills":[],"sithTalentAction":"inciteRage","id":"incite-rage","label":"Incite Rage"}],"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Sith Commander","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."},"contributesGenericBonus":false},"summary":"Once per encounter as a swift action, you can channel your anger and hatred into your allies.","source":"Legacy Era Campaign Guide","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.incite_rage","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.426Z","detectedPredicates":["attack.when-hit","turn.once-per-round"],"forcePrestigeCleanup":{"phase":"T9","status":"manual_or_runtime","scope":"runtime_ally_buff"}}}}
{"_id":"b8aaf500d3069938","name":"Indomitable","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per day as a swift action, you can move +5 steps along the condition track. This does not remove any persistent conditions affecting you. You can select this talent multiple times; each time, you can use it one additional time per day.","description":{"value":"Once per day as a swift action, you can move +5 steps along the condition track. This does not remove any persistent conditions affecting you. You can select this talent multiple times; each time, you can use it one additional time per day."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","treeId":"798ed0945cbdac1c","tags":["condition_removal","mobility","scaling","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Vehicle/crew systems or GM/player managed","notes":"Vehicle/crew/tactical effects need vehicle, commander, gunner, pilot, line-of-sight, or target context not available to static actor prep."},"summary":"Once per day as a swift action, move +5 steps up the condition track without removing persistent conditions.","source":"Saga Edition Core Rulebook","page":52},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.indomitable","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.426Z","detectedPredicates":[],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Vehicle/crew systems or GM/player managed","note":"Vehicle/crew/tactical effects need vehicle, commander, gunner, pilot, line-of-sight, or target context not available to static actor prep."}}}}
