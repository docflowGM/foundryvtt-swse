{"_id":"07cd591fb8dccb39","name":"Skill Confidence","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Critical Skill Success, trained in the chosen skill","description":{"value":"When you select this talent, choose one skill. Whenever you roll a natural 19 or a natural 20 on a skill check with that skill, you gain the benefits of the Critical Skill Success talent and also gain bonus hit points equal to your Charisma modifier.\n\nYou can select this talent multiple times. Each time you do so, you must choose a different skill to gain the benefits of this talent."},"benefit":"When you select this talent, choose one skill. Whenever you roll a natural 19 or a natural 20 on a skill check with that skill, you gain the benefits of the Critical Skill Success talent and also gain bonus hit points equal to your Charisma modifier.\n\nYou can select this talent multiple times. Each time you do so, you must choose a different skill to gain the benefits of this talent.","class":"","category":"","costNumeric":null,"treeId":"04a6f32128cc4b98","talent_tree":"Superior Skills","source":"Galaxy of Intrigue","page":21,"tags":["critical_success","skill-mastery","skills","support"],"executionModel":"PASSIVE","subType":"STATE","repeatable":true,"abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":true,"modifiers":[],"implementedBy":"GM/player managed","notes":"The talent resolves against live check results, encounter state, or player timing decisions and should not alter permanent actor values.","combatActions":[],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"skill-confidence-superior-skills-context","label":"Skill Confidence","summary":"When you select this Talent, choose one Trained Skill. Whenever you roll a Natural 19 or a Natural 20 on a Skill Check with that Skill, you gain the benefits of the Critical Skill Success Talent and also gain Bonus Hit Points equal to your Charisma modifier. You can select this Talent multiple times. Each time you do so, you must choose a different Skill to gain the benefits of this Talent."}]},"choiceMeta":{"resolution":"immediate","required":true,"repeatable":true,"choiceKind":"trained_skill","choiceKey":"skill_confidence","choiceSource":"fixed","storagePath":"flags.swse.choices.skill_confidence","optionRegistry":"data/feat-choice-options.json#choiceKinds.trained_skill","label":"Skill Confidence Trained Skill","prompt":"Choose the Trained Skill that Skill Confidence applies to."},"summary":"With a chosen trained skill, natural 19-20 triggers Critical Skill Success and grants bonus hit points equal to your Charisma modifier."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
