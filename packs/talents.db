{"_id":"e5ac014e044a4afa","name":"Droid Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"As a Standard Action, you can transmit tactical information to all Droid allies that can hear and understand you, granting them a bonus equal to your Intelligence modifier to one of their Defenses (your choice) until the beginning of your next turn."},"benefit":"As a Standard Action, you can transmit tactical information to all Droid allies that can hear and understand you, granting them a bonus equal to your Intelligence modifier to one of their Defenses (your choice) until the beginning of your next turn.","class":"","category":"","costNumeric":null,"treeId":"9688ed3500084dca","tags":["action_economy","defense","droid","durability","mobility","sensors","skills","standard_action","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"droid-defense-transmit","name":"Droid Defense","label":"Droid Defense","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Transmit tactical information to all Droid allies that can hear and understand you. They gain a bonus equal to your Intelligence modifier to one Defense of your choice until the beginning of your next turn.","notes":"Choose Fortitude, Reflex, or Will for each affected droid ally and track the temporary bonus manually.","relatedSkills":[{"skill":"Tactics"},{"skill":"Defense"}],"resources":["Standard Action","Droid allies","Until beginning of your next turn"],"targetHint":"Droid allies that can hear and understand you"}],"phase19DroidCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","tree":"Droid Commander","notes":"Standard-action ally defense buff card; temporary recipient defense application remains manual.","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0}},"summary":"As a Standard Action, you can trans