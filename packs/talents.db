{"_id":"0adc25cfaa35147a","name":"Insight of the Force","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You can make a Use the Force check in place of a Knowledge check for any Knowledge skill you are not Trained in. You are considered Trained in that Knowledge skill for the purposes of using this Talent. If you are entitled to a Knowledge check reroll, you can reroll your Use the Force check instead (subject to the same circumstances and limitations).","description":{"value":"You can make a Use the Force check in place of a Knowledge check for any Knowledge skill you are not Trained in. You are considered Trained in that Knowledge skill for the purposes of using this Talent. If you are entitled to a Knowledge check reroll, you can reroll your Use the Force check instead (subject to the same circumstances and limitations)."},"class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"152047d6ab7896ad","tags":["force","light_side","skills"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[{"target":"attack","value":0,"type":"untyped","predicates":[],"enabled":false,"priority":500,"description":"[REQUIRES MANUAL MAPPING] Insight of the Force"}],"status":"talent_backcheck_user_text_2026_06_11","description":"Use Use the Force in place of untrained Knowledge checks; rerolls transfer to the UtF check.","mechanicsMode":"conditional_or_metadata","applicationScope":"skill_substitution_knowledge","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"conditionSummary":"Use Use the Force in place of untrained Knowledge checks; rerolls transfer to the UtF check.","metadataPhase":"jedi-prestige-talent-backcheck","metadataNotes":"Updated from user-provided source text; non-automatable targeting/LOS/session adjudication remains GM/player confirmed.","rules":[{"type":"TALENT_RULE","id":"insight_of_the_force","label":"Insight of the Force","summary":"Use Use the 