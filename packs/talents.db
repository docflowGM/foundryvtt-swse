{"_id":"e53cad01df3f27dd","name":"Tech Savant","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Trained in Knowledge (Technology)","benefit":"As a standard action, you can increase the speed of one adjacent droid or vehicle you occupy by 1 square (applied to any method of locomotion) until the end of your next turn.","description":{"value":"As a standard action, you can increase the speed of one adjacent droid or vehicle you occupy by 1 square (applied to any method of locomotion) until the end of your next turn."},"class":"b85240cf77cf95eb","costNumeric":null,"category":"Military Engineer","treeId":"e32009b1b0aee8c9","tags":["mobility","positioning","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"tech-savant","name":"Tech Savant","label":"Tech Savant","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Increase the speed of one adjacent droid, or one vehicle you occupy, by 1 square until the end of your next turn. A target can benefit only once per encounter.","notes":"Increase the speed of one adjacent droid, or one vehicle you occupy, by 1 square until the end of your next turn. A target can benefit only once per encounter.","relatedSkills":[{"skill":"Mechanics","when":"GM may request a check for unusual systems"}],"resources":["Once per encounter per target"],"requiredContext":[],"targetHint":"Adjacent droid or occupied vehicle"}],"phase17TechEngineeringCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual action-economy card. Automation can be added later without inventing passive bonuses."}},"summary":"As a standard action, you can increase the speed of one adjacent droid or vehicle you occupy by 1 square (applied to any method of locomotion) until the end of your next turn.","source":"Clone Wars Campaign Guide","page":46},"effects":[],"folder"