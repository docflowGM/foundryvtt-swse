{"_id":"0c636cdbb63cdba3","name":"Greater Force Talisman","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Force Talisman","benefit":"You may spend a Force Point to imbue a weapon or some other portable object with The Force, creating a Talisman that provides protection to you. Creating the Talisman takes a Full-Round Action.\n\nWhile you wear or carry the Talisman on your person, you gain a +1 Force bonus to all of your Defenses (Reflex Defense, Fortitude Defense, and Will Defense).\n\nYou may only have one Greater Force Talisman active at a given time, and if your Greater Force Talisman is destroyed, you may not create another Greater Force Talisman (or regular Force Talisman) for 24 hours.","description":{"value":"You may spend a Force Point to imbue a weapon or some other portable object with The Force, creating a Talisman that provides protection to you. Creating the Talisman takes a Full-Round Action.\n\nWhile you wear or carry the Talisman on your person, you gain a +1 Force bonus to all of your Defenses (Reflex Defense, Fortitude Defense, and Will Defense).\n\nYou may only have one Greater Force Talisman active at a given time, and if your Greater Force Talisman is destroyed, you may not create another Greater Force Talisman (or regular Force Talisman) for 24 hours."},"class":"289fcf920ef0e184","costNumeric":null,"category":"Force Adept","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.66b23ee79bd33bf1","name":"Force Talisman"}],"_source":"canonical-csv"},"treeId":"01e443d93e47f9c4","tags":["alchemy","crafting","empowerment","force","force_capacity","force_point_spend","force_training","resource_spend"],"executionModel":"ACTIVE","subType":"TALENT_ACTION","abilityMeta":{"modifiers":[],"combatActions":[{"id":"greater-force-talisman","name":"Greater Force Talisman","actionType":"full-round","requiredTalent":"Greater Force Talisman","description":"You may spend a Force Point to imbue a weapon or some other portable object with The Force, creating a Talisman that provides protection to you. Creating the Talisman takes a Full-Round Action.","resolutionMode":"forceAdeptTalent","spendAction":true,"effects":[],"resources":["Force Point","Talisman"],"notes":"Manual/deferred greater talisman creation and equipment card. No always-on defense bonus is applied until talisman UI exists.","manualResolution":true,"relatedSkills":[],"forceAdeptTalentAction":"greaterForceTalisman","label":"Greater Force Talisman","useLabel":"Use / Note"}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Force Item","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."},"actionType":"full-round","resolutionMode":"forceAdeptTalent","forceAdeptTalentAction":"greaterForceTalisman","implementationDeferred":true},"summary":"You may spend a Force Point to imbue a weapon or some other portable object with The Force, creating a Talisman that provides protection to you.","source":"Saga Edition Core Rulebook","page":214},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.greater_force_talisman","forceTalentCleanup":{"phase":"T22","tree":"Force Item","status":"combat_action_card"},"backchecked":true,"lastBackcheck":"force-adept-force-item-batch"}}}
