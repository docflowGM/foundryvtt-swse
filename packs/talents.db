{"_id":"bd34fd5bbc4a14fb","name":"Commanding Officer","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You gain a single Follower. Choose either the Aggressive, Defensive, or Utility Follower Template for your Follower, generating the follower's statistics using the rules found in the Followers page. This Follower gains one Armor Proficiency Feat of your choice and Weapon Proficiency (Rifles), in addition to those provided by the Follower Templates. The Follower must meet the prerequisites for the Armor Proficiency Feat you select.\n\nYou can select this Talent multiple times. Each time you do, you gain one additional Follower (maximum of three Followers).","description":{"value":"You gain a single Follower. Choose either the Aggressive, Defensive, or Utility Follower Template for your Follower, generating the follower's statistics using the rules found in the Followers page. This Follower gains one Armor Proficiency Feat of your choice and Weapon Proficiency (Rifles), in addition to those provided by the Follower Templates. The Follower must meet the prerequisites for the Armor Proficiency Feat you select.\n\nYou can select this Talent multiple times. Each time you do, you gain one additional Follower (maximum of three Followers)."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","treeId":"781feba15dc9e42f","tags":["action_economy","battlefield_control","burst_damage","positioning","ranged","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"staticSheetPolicy":"exclude","applicationScope":"social_commander_runtime_context","requiresRuntimeContext":true,"requiresSelectedChoice":false,"mechanicsMode":"manual_or_future_runtime","notes":"Follower-granting talent; belongs to follower subsystem, not combat-action mutation.","phase23SocialCommanderCleanup":{"phase":"T23","tree":"Squad Leader","status":"reviewed_manual_or_future_runtime","cardsAdded":0,"notes":"Follower-granting talent; belongs to follower subsystem, not combat-action mutation."}},"summary":"You gain a single Follower.","source":"Clone Wars Campaign Guide","page":26},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.commanding_officer","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.426Z","detectedPredicates":["attack.when-hit","attack.with-ranged","turn.on-current-turn"]}}}
{"_id":"bd6cbb85cf7fc8a2","name":"Triangulate","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Enhanced Vision","benefit":"If you and at least one other ally have line of sight to and are aware of a target, you and all allies that can hear and understand you can reroll one ranged attack roll against that target, accepting the second result even if it is worse. You and your allies can only gain the benefits of this Talent once per encounter.","description":{"value":"If you and at least one other ally have line of sight to and are aware of a target, you and all allies that can hear and understand you can reroll one ranged attack roll against that target, accepting the second result even if it is worse. You and your allies can only gain the benefits of this Talent once per encounter."},"class":"acd10710f000ae70","costNumeric":null,"category":"Vanguard","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.d6f62f5d8b003e14","name":"Enhanced Vision"}],"_source":"canonical-csv"},"treeId":"ca304c9496f38747","tags":["cover","offense_ranged","positioning","ranged","recon","support","targeting","teamwork"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","combatActions":[{"id":"triangulate","name":"Triangulate","label":"Triangulate","actionType":"free","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"If you and at least one ally have line of sight to and awareness of a target, designate the target. Allies who can hear and understand you may reroll one ranged attack against that target once this encounter.","notes":"If you and at least one ally have line of sight to and awareness of a target, designate the target. Allies who can hear and understand you may reroll one ranged attack against that target once this encounter.","relatedSkills":[],"resources":["Once per encounter","Ally LOS/awareness"],"requiredContext":[],"targetHint":"One target"}],"phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Vanguard","status":"reviewed","notes":"Reviewed in tactical ranged/military cleanup."}},"summary":"If you and at least one other ally have line of sight to and are aware of a target, you and all allies that can hear and understand you can reroll one ranged attack roll against that target, accepting the second...","source":"Clone Wars Campaign Guide","page":47},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.triangulate","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.426Z","detectedPredicates":["attack.with-ranged","turn.once-per-round"]}}}
{"_id":"bd797d3f83d0f61f","name":"Attuned","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Focused Attack","benefit":"When you roll a natural 20 on an attack roll against a target with a Dark Side Score of 1 or higher, you can activate a single Force power with the [light side] descriptor immediately as a free action.","description":"When you roll a natural 20 on an attack roll against a target with a Dark Side Score of 1 or higher, you can activate a single Force power with the [light side] descriptor immediately as a free action.","costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.2fc019fa8c4108a7","name":"Focused Attack"}],"_source":"canonical-csv"},"treeId":"001a438135e03588","tags":["force","force_capacity","force_power_synergy","healing","light_side","resource_recovery","survivability"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"attuned","name":"Attuned","label":"Attuned","actionType":"free","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"When you roll a natural 20 on an attack against a foe with Dark Side Score 1+, you may activate any power with the light side descriptor.","notes":"When you roll a natural 20 on an attack against a foe with Dark Side Score 1+, you may activate any power with the light side descriptor.","relatedSkills":[],"resources":["Trigger: natural 20 against target with Dark Side Score 1+"],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Light Side","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"On a natural 20 against a target with Dark Side Score 1+, immediately activate a [light side] Force power as a free action.","source":"Clone Wars Campaign Guide","page":53},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.attuned","forceTalentCleanup":{"phase":"T22","tree":"Light Side","status":"combat_action_card"}}}}
{"_id":"be617461ca46a5ad","name":"Burning Assault","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Jet Pack Training","benefit":"As a standard action you can expend one of your jet pack’s charges to make an attack with the jet pack, treating it as a flame thrower (see page 128 of the Saga Edition core rulebook). You cannot use this talent when you are flying. You are considered proficient in the flame thrower for the purpose of making this attack.","description":{"value":"As a standard action you can expend one of your jet pack’s charges to make an attack with the jet pack, treating it as a flame thrower (see page 128 of the Saga Edition core rulebook). You cannot use this talent when you are flying. You are considered proficient in the flame thrower for the purpose of making this attack."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.d3a642f2ceb21ed4","name":"Jet Pack Training"}],"_source":"canonical-csv"},"treeId":"1f50c63b6f08de10","tags":["heavy_weapon","mobility","ranged"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"As a standard action you can expend one of your jet pack’s charges to make an attack with the jet pack, treating it as a flame thrower (see page 128 of the Saga Edition core rulebook).","source":"Knights of the Old Republic Campaign Guide","page":30},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.burning_assault","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.426Z","detectedPredicates":[]}}}
{"_id":"be932caff635f8bc","name":"Force Fortification","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a Reaction, you can spend a Force Point to negate a Critical Hit scored against you, taking normal damage instead. You can spend this Force Point even if you have already spent a Force Point earlier in the round.","description":"As a Reaction, you can spend a Force Point to negate a Critical Hit scored against you, taking normal damage instead. You can spend this Force Point even if you have already spent a Force Point earlier in the round.","class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"b3c5d90b5036f39b","tags":["force","force_offense","precision"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"active_reaction_force_point_critical_negation","applicationScope":"critical_hit_response","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"manualResolution":false,"actionType":"reaction","spendsForcePoint":1},"summary":"As a Reaction, you can spend a Force Point to negate a Critical Hit scored against you, taking normal damage instead.","source":"Saga Edition Core Rulebook","page":218},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"skillSubstitution":true,"substitutionType":"fortitude_to_will","description":"Your Will Defense now functions in place of Fortitude Defense","id":"swse.talent.force_fortification","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.426Z","detectedPredicates":[]}}}
