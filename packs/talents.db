{"_id":"5d682aa33468b683","name":"Impart Knowledge","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Skilled Advisor","benefit":"You can Aid Another on the Knowledge checks of an ally within 6 squares of you as a Reaction for Knowledge skills you are Trained in.","description":{"value":"You can Aid Another on the Knowledge checks of an ally within 6 squares of you as a Reaction for Knowledge skills you are Trained in."},"class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"152047d6ab7896ad","tags":["force","light_side","positioning","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[{"target":"attack","value":0,"type":"untyped","predicates":[],"enabled":false,"priority":500,"description":"[REQUIRES MANUAL MAPPING] Impart Knowledge"}],"status":"talent_backcheck_user_text_2026_06_11","description":"Aid Another on trained Knowledge checks for an ally within 6 squares as a Reaction.","mechanicsMode":"conditional_or_metadata","applicationScope":"reaction_aid_another_knowledge","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"conditionSummary":"Aid Another on trained Knowledge checks for an ally within 6 squares as a Reaction.","metadataPhase":"jedi-prestige-talent-backcheck","metadataNotes":"Updated from user-provided source text; non-automatable targeting/LOS/session adjudication remains GM/player confirmed.","rules":[{"type":"TALENT_RULE","id":"impart_knowledge","label":"Impart Knowledge","summary":"Aid Another on trained Knowledge checks for an ally within 6 squares as a Reaction.","action":"knowledge-check","mode":"reaction_aid_another_knowledge","text":"You can Aid Another on the Knowledge checks of an ally within 6 squares of you as a Reaction for Knowledge skills you are Trained in."}]},"effect":"You can Aid Another on the Knowledge checks of an ally within 6 squares of you as a Reaction for Knowledge skills you are Trained in.","shortSum