{"_id":"11cae48e1213c407","name":"Telekinetic Power","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Whenever you roll a natural 20 on your Use the Force check to activate Force disarm, Force grip, Force slam, Force thrust, or move object, you may choose to use that Force power again immediately as a free action. You may direct the second use of the Force power against any eligible target.","description":"Whenever you roll a natural 20 on your Use the Force check to activate Force disarm, Force grip, Force slam, Force thrust, or move object, you may choose to use that Force power again immediately as a free action. You may direct the second use of the Force power against any eligible target.","costNumeric":null,"treeId":"6ac3416fb6aada56","tags":["battlefield_control","control","droid","force","force_capacity","force_control","force_defense","force_offense","force_point_spend","force_power_synergy","light_side","mobility","pilot","ranged","resource_spend","skill_substitution","telekinesis","telepathy","trap","use_the_force","vehicle"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"manual_or_runtime","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Alter","status":"cleaned_manual_or_future_runtime","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"On a natural 20 with a listed telekinetic power, immediately use that power again as a free action.","source":"Saga Edition Core Rulebook","page":100},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.telekinetic_power","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.404Z","detectedPredicates":["defe