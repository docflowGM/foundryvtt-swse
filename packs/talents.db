{"_id":"4bdb0bda258c609e","name":"Thrive on Chaos","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Advantageous Opening","benefit":"When an enemy or ally within 20 squares of you is reduced to 0 Hit Points, you gain Bonus Hit Points equal to 5 + one-half your Character Level. Damage is subtracted from Bonus Hit Points first, and any Bonus Hit Points remaining at the end of the encounter go away. Bonus Hit Points do not stack.","description":{"value":"When an enemy or ally within 20 squares of you is reduced to 0 Hit Points, you gain Bonus Hit Points equal to 5 + one-half your Character Level. Damage is subtracted from Bonus Hit Points first, and any Bonus Hit Points remaining at the end of the encounter go away. Bonus Hit Points do not stack."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.c2403caee49be74b","name":"Advantageous Opening"}],"_source":"canonical-csv"},"treeId":"bf3b07c1687a3ca2","tags":["damage_reduction","positioning","support"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"modifiers":[]},"summary":"When an enemy or ally within 20 squares of you is reduced to 0 Hit Points, you gain Bonus Hit Points equal to 5 + one-half your Character Level.","source":"Clone Wars Campaign Guide","page":24},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.thrive_on_chaos"}}}
{"_id":"4c236343b01ea763","name":"Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"When calculating your Reflex Defense, you may add either your Heroic Level or your Armor bonus, whichever is higher. You must be proficient with the Armor you are wearing to gain this benefit.","description":{"value":"When calculating your Reflex Defense, you may add either your Heroic Level or your Armor bonus, whichever is higher. You must be proficient with the Armor you are wearing to gain this benefit."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","treeId":"17cec542331cb4e4","tags":["armor","lightsaber","melee","scaling","sustained_damage","unarmed","force","defense"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"implementationStatus":"implemented_by_defense_calculator","engineOwner":"DefenseCalculator","mechanicsMode":"passive","applicationScope":"equipped_armor_context","staticSheetPolicy":"owned_by_defense_calculator","conditionSummary":"Applies while wearing armor with which the actor is proficient; uses max(heroic level, armor bonus) for the armor/level Reflex contribution.","notes":"Removed migrated flat +1 Reflex passive modifier. The real rule is calculated by DefenseCalculator.","modifiers":[],"combatActions":[{"id":"armored-defense-t31-reference","name":"Armored Defense","label":"Armored Defense","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"When calculating your Reflex Defense, you may add either your Heroic Level or your Armor bonus, whichever is higher. You must be proficient with the Armor you are wearing to gain this benefit.","notes":"When calculating your Reflex Defense, you may add either your Heroic Level or your Armor bonus, whichever is higher. You must be proficient with the Armor you are wearing to gain this benefit.","relatedSkills":[],"resources":[],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"armored-defense-t31-context","label":"Armored Defense","summary":"When calculating your Reflex Defense, you may add either your Heroic Level or your Armor bonus, whichever is higher. You must be proficient with the Armor you are wearing to gain this benefit."}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Knight's Armor","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."},"implementationNote":"Handled by defense calculator. Applies only while wearing proficient armor.","runtime":"armor-calculator","tags":["armor-specialist"]},"implementationNote":"Handled by defense calculator. Applies only while wearing proficient armor.","effects":[],"summary":"When calculating your Reflex Defense, you may add either your Heroic Level or your Armor bonus, whichever is higher.","source":"Saga Edition Core Rulebook","page":51},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense","runtimeOwner":"DefenseCalculator","armorTreeCleanup":"phase_t6_armor_specialist"}}}
{"_id":"4c23c64e3ab8dcc6","name":"Jet Pack Withdraw","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Jet Pack Training","benefit":"Once per encounter, as a reaction when an opponent moves adjacent to you, you can expend one charge of your jet pack to fly and move your speed or withdraw.","description":{"value":"Once per encounter, as a reaction when an opponent moves adjacent to you, you can expend one charge of your jet pack to fly and move your speed or withdraw."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.d3a642f2ceb21ed4","name":"Jet Pack Training"}],"_source":"canonical-csv"},"treeId":"1f50c63b6f08de10","tags":["heavy_weapon","mobility","positioning"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"Once per encounter, as a reaction when an opponent moves adjacent to you, you can expend one charge of your jet pack to fly and move your speed or withdraw.","source":"Knights of the Old Republic Campaign Guide","page":30},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.jet_pack_withdraw","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.412Z","detectedPredicates":["turn.once-per-round"]}}}
{"_id":"4c689ac688e80c9e","name":"Trick Step","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a Swift Action, make an Initiative check, opposed by the Initiative check of an enemy within your line of sight.\n\nIf your check result equals or exceeds the target's check, the target is considered Flat-Footed against the next attack you make before the end of your turn. If the target's check result is higher, you are considered Flat-Footed against the next attack made by the target before the start of your next turn.","description":{"value":"As a Swift Action, make an Initiative check, opposed by the Initiative check of an enemy within your line of sight.\n\nIf your check result equals or exceeds the target's check, the target is considered Flat-Footed against the next attack you make before the end of your turn. If the target's check result is higher, you are considered Flat-Footed against the next attack made by the target before the start of your next turn."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","treeId":"4af97ad058b1b30f","tags":["action_economy","evasion","mobility","positioning","skills","social"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"As a Swift Action, make an Initiative check, opposed by the Initiative check of an enemy within your line of sight.","source":"Rebellion Era Campaign Guide","page":26},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.trick_step","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.412Z","detectedPredicates":["defense.will"]}}}
{"_id":"4c7eb9c679ee43a8","name":"Demoralizing Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Noble Fencing Style","benefit":"As a reaction, you can designate an enemy you\n\nhave just hit with a melee attack. The enemy takes only half damage from the attack, but takes a -5 penalty on attacks made against you until the end of your next turn.\n\nThis is a mind-affecting effect.","description":{"value":"As a reaction, you can designate an enemy you\n\nhave just hit with a melee attack. The enemy takes only half damage from the attack, but takes a -5 penalty on attacks made against you until the end of your next turn.\n\nThis is a mind-affecting effect."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.00c3231e4a4173fa","name":"Noble Fencing Style"}],"_source":"canonical-csv"},"treeId":"9df067790c87e6bc","tags":["melee","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action_reference","applicationScope":"martial_protector_arena_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed target context","notes":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists.","combatActions":[{"id":"demoralizing-defense-t30-reference","name":"Demoralizing Defense","label":"Demoralizing Defense","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Reaction, you can designate an enemy you have just hit with a melee attack. The enemy takes only half damage from the attack, but takes a -5 penalty on attacks made against you until the end of your next turn. A single target may only be affected by this Talent once per round. This is a Mind-Affecting effect.","notes":"As a Reaction, you can designate an enemy you have just hit with a melee attack. The enemy takes only half damage from the attack, but takes a -5 penalty on attacks made against you until the end of your next turn. A single target may only be affected by this Talent once per round. This is a Mind-Affecting effect.","relatedSkills":[],"resources":["Once per round","Until your next turn"],"requiredContext":["Triggering attack/damage result confirmed","Reaction timing available"],"targetHint":"GM/player adjudicated target or context","spendAction":false,"ruleData":{}}],"rules":[],"manualResolution":true,"phase30MartialProtectorArenaCleanup":{"phase":"T30","tree":"Fencing","status":"reviewed_manual_or_runtime_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"T30 removed unsafe passive rows from martial/protector/arena/species leftovers and surfaced action, reaction, recovery, cover, and attack-rider context as truthful cards/rules."}},"summary":"As a reaction, you can designate an enemy you","source":"Knights of the Old Republic Campaign Guide","page":26},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.demoralizing_defense","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.412Z","detectedPredicates":["attack.with-melee","turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"GM/player managed target context","note":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists."}}}}
{"_id":"4cc3f26d58c3302b","name":"Deception Awareness","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Order of Shasa","talentTree":"Order of Shasa","tree":"Order of Shasa","treeId":"d2e4cd882822dcf2","prerequisites":"","description":{"value":"Realizing how the devastating the consequences would have been if the Sith had successfully deceived her and her companions during the Jedi Civil War, Shasa has developed a technique for using the Force to detect deceptions. You gain +5 to your Will Defense against uses of the Deception skill. Additionally, you can make a Use the Force check instead of a Perception check to sense deception and sense influence. You are considered trained in Perception for the purpose of using this talent. If you are entitled toa Perception check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations)."},"benefit":"Realizing how the devastating the consequences would have been if the Sith had successfully deceived her and her companions during the Jedi Civil War, Shasa has developed a technique for using the Force to detect deceptions. You gain +5 to your Will Defense against uses of the Deception skill. Additionally, you can make a Use the Force check instead of a Perception check to sense deception and sense influence. You are considered trained in Perception for the purpose of using this talent. If you are entitled toa Perception check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations).","class":"","category":"","costNumeric":null,"source":"Knights of the Old Republic Campaign Guide","tags":["force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"deception-awareness","name":"Deception Awareness","label":"Deception Awareness","actionType":"passive","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"You gain +5 to your Will Defense against uses of the Deception skill. Additionally, you can make a Use the Force check instead of a Perception check to Sense Deception and Sense Influence. You are considered Trained in Perception for the purposes of using this Talent. If you are entitled to a Perception check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations).","notes":"You gain +5 to your Will Defense against uses of the Deception skill. Additionally, you can make a Use the Force check instead of a Perception check to Sense Deception and Sense Influence. You are considered Trained in Perception for the purposes of using this Talent. If you are entitled to a Perception check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations).","relatedSkills":[{"skill":"Use the Force"}],"resources":["Use the Force can replace Perception for Sense Deception/Influence","+5 Will vs Deception"],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Order of Shasa","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"Realizing how the devastating the consequences would have been if the Sith had successfully deceived her and her companions during the Jedi Civil War, Shasa has developed a technique for using the Force to detect deceptions.","page":61},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"sourcePatch":"force-tradition-and-jedi-guardian-membership","forceTalentCleanup":{"phase":"T22","tree":"Order of Shasa","status":"combat_action_card"}}}}
{"_id":"4d8882a28da30454","name":"Inspire Confidence","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a Standard Action, you can inspire confidence in all allies in your line of sight, granting them a +1 morale bonus on attack rolls, and a +1 morale bonus on Skill Checks for the rest of the encounter, or until you're unconscious or dead. Once Inspired, your allies don't need to remain within line of sight of you. You can't Inspire Confidence in yourself.","description":{"value":"As a Standard Action, you can inspire confidence in all allies in your line of sight, granting them a +1 morale bonus on attack rolls, and a +1 morale bonus on Skill Checks for the rest of the encounter, or until you're unconscious or dead. Once Inspired, your allies don't need to remain within line of sight of you.\n\nYou can't Inspire Confidence in yourself."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","treeId":"72d32ebcbb607314","tags":["action_economy","mobility","support"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Talent granted-abilities/action-card data + GM/player resolution","notes":"data/talent-granted-abilities.json already exposes this as a leadership action card; the ally buff still requires GM/player application.","combatActions":[{"id":"inspire-confidence","name":"Inspire Confidence","label":"Inspire Confidence","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Grant all allies in your line of sight a +1 morale bonus to attack rolls and skill checks for the rest of the encounter, until you are unconscious or dead.","notes":"Grant all allies in your line of sight a +1 morale bonus to attack rolls and skill checks for the rest of the encounter, until you are unconscious or dead.","relatedSkills":[],"resources":["Morale bonus","Does not affect yourself"],"requiredContext":[],"targetHint":"All allies in line of sight","spendAction":true,"ruleData":{}}],"manualResolution":true,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Inspiration","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"As a Standard Action, you can inspire confidence in all allies in your line of sight, granting them a +1 morale bonus on attack rolls, and a +1 morale bonus on Skill Checks for the rest of the encounter, or until you're unconscious...","source":"Saga Edition Core Rulebook","page":44},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_confidence","nobleOfficerCorporateCleanup":{"phase":"T10","status":"action_card_or_table_managed","owner":"Talent granted-abilities/action-card data + GM/player resolution","note":"data/talent-granted-abilities.json already exposes this as a leadership action card; the ally buff still requires GM/player application."}}}}
{"_id":"4df672d524de7aa0","name":"Preternatural Senses","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per encounter, as a reaction, you can add one-half your class level to the defense score of your choice.","description":{"value":"Once per encounter, as a reaction, you can add one-half your class level to the defense score of your choice."},"class":"19ee85a788380256","costNumeric":null,"category":"Outlaw","treeId":"3caa80f6bef04200","tags":["action_economy","force","force_defense","mobility","reaction","survivability","pursuit"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"hunter_pursuit_fear_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals.","combatActions":[{"id":"preternatural-senses","name":"Preternatural Senses","label":"Preternatural Senses","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, as a Reaction, you can add one-half your Class Level to the Defense Score of your choice.","notes":"Once per encounter, as a Reaction, you can add one-half your Class Level to the Defense Score of your choice.","relatedSkills":[],"resources":["Once per encounter","Add half class level to one defense"],"requiredContext":["Reaction to incoming attack or effect targeting a defense"],"targetHint":"Self","spendAction":true,"ruleData":{},"reactionKey":"preternaturalSenses","reactionTrigger":"ON_ATTACK_DECLARED"}],"phase26HunterPursuitFearCleanup":{"phase":"T26","tree":"Outlaw","status":"reaction_registered","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes"