{"_id":"b7d5a1bc3d40b964","name":"Keep It Together","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Once per encounter, when a vehicle you're piloting takes damage that equals or exceeds its damage threshold, your vehicle avoids moving down the condition track.","description":{"value":"Once per encounter, when a vehicle you're piloting takes damage that equals or exceeds its damage threshold, your vehicle avoids moving down the condition track."},"class":"9c9989c34714f920","costNumeric":null,"category":"Ace Pilot","treeId":"b17c1515c06361d6","tags":["condition_removal","evasion"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"keep-it-together","name":"Keep It Together","label":"Keep It Together","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, when your piloted vehicle takes damage equal to or greater than its Damage Threshold, prevent it from moving down the Condition Track.","notes":"Once per encounter, when your piloted vehicle takes damage equal to or greater than its Damage Threshold, prevent it from moving down the Condition Track.","resources":["Once per encounter","Vehicle"]}],"phase16VehicleStarshipCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual combat action card in the action economy UI."}},"summary":"Once per encounter, prevent your piloted vehicle from moving down the condition track from threshold damage.","source":"Saga Edition Core Rulebook","page":207},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.keep_it_together","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.425Z","detectedPredicates":["turn.once-per-round"]}}}
{"_id":"b812c197daea93fd","name":"Multiattack Proficiency (pistols)","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Whenever you make multiple attacks with any type of pistol as a full attack action, you reduce the penalty on your attack rolls by 2. You can take this talent multiple times; each time, reduce the penalty by an additional 2.","description":{"value":"Whenever you make multiple attacks with any type of pistol as a full attack action, you reduce the penalty on your attack rolls by 2. You can take this talent multiple times; each time, reduce the penalty by an additional 2."},"class":"162d866ba36fce69","costNumeric":null,"category":"Gunslinger","treeId":"cb6f775cd227a3e3","tags":["action_economy","dual_wield","evasion","force","force_control","force_defense","force_offense","mobility","positioning","ranged","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"choice_required","applicationScope":"full_attack_roll_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Future progression picker + Ability Engine roll-context resolver","notes":"Cleaned in phase T13. This talent modifies multiple-attack penalties for pistols during Full Attack; it is not the Pistol Duelist multi-action talent."},"summary":"Reduce full-attack penalties with pistols by 2; stacks with repeated selections.","source":"Saga Edition Core Rulebook","page":216},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.multiattack_proficiency_pistols","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.426Z","detectedPredicates":["defense.against-ranged","defense.reflex","attack.with-ranged","turn.on-current-turn","turn.once-per-round"]}}}
