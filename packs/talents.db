{"_id":"8c47c02ec74fa858","name":"Difficult to Sense","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You are skilled at concealing your presence from other Force-users. You may reroll any opposed Use the Force check made to conceal your presence from someone who attempts to sense other Force-users, keeping the better result.","description":{"value":"You are skilled at concealing your presence from other Force-users. You may reroll any opposed Use the Force check made to conceal your presence from someone who attempts to sense other Force-users, keeping the better result."},"class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"e303ddd025779062","tags":["battlefield_control","damage_reduction","dual_wield","force","force_support","light_side","medicine","mobility","skills","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"difficult-to-sense","name":"Difficult to Sense","label":"Difficult to Sense","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"You are skilled at concealing your presence from other Force-users. You may reroll any opposed Use the Force check made to conceal your presence from someone who attempts to sense other Force-users, keeping the better of the two results.","notes":"You are skilled at concealing your presence from other Force-users. You may reroll any opposed Use the Force check made to conceal your presence from someone who attempts to sense other Force-users, keeping the better of the two results.","relatedSkills":[{"skill":"Use the Force"}],"resources":["Use the Force check"],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[{"type":"TALENT_RULE","id":"difficult_to_sense","label":"Difficult to Sense","summary":"Reroll opposed Use the Force checks to conceal your presence and keep the better result.","action":"use-