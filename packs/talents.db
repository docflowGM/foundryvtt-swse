{"_id":"2b6a4a203b72dc79","name":"Heuristic Mastery","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Wisdom 15","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"wis","min":15}],"_source":"scavengers-guide-to-droids-p28"},"description":{"value":"You understand the subtleties and limitations of your heuristic processor. You can reroll any untrained skill check (except Use the Force), keeping the second result, even if it is worse. Once per encounter, you can spend a Force Point to reroll any skill check (trained or untrained), taking the better result."},"benefit":"You understand the subtleties and limitations of your heuristic processor. You can reroll any untrained skill check (except Use the Force), keeping the second result, even if it is worse. Once per encounter, you can spend a Force Point to reroll any skill check (trained or untrained), taking the better result.","class":"","category":"Droid","costNumeric":null,"treeId":"b968ecab63bc4cf4","talent_tree":"Elite Droid","source":"Scavenger's Guide to Droids","page":29,"tags":["droid","force-point","once-per-encounter","reroll","skills"],"executionModel":"ACTIVE","subType":"TALENT_ACTION","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"skill_check_reroll","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"modifiers":[],"notes":"Two separate rerolls. The untrained reroll excludes Use the Force and must keep the second result even when it is worse. The Force Point reroll is once per encounter, applies to trained or untrained checks, and takes the better result.","rerolls":[{"id":"heuristic-mastery-untrained","trigger":"untrainedSkillCheck","excludes":["useTheForce"],"keep":"second","cost":null,"usesPerEncounter":null},{"id":"heuristic-mastery-force-point","trigger":"anySkillCheck","excludes":[],"keep":"better","cost":"forcePoint","usesPerEncounter":1}],"combatActions":[],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"heuristic-mastery-elite-droid-context","label":"Heuristic Mastery","summary":"You can reroll any untrained Skill Check, except a Use the Force check, but you must keep the result of the reroll even if it is worse. Additionally, once per encounter you can spend a Force Point to reroll any Skill Check, trained or untrained, and take the better result."}]},"summary":"You understand the subtleties and limitations of your heuristic processor."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"2b808a4a90614f92","name":"Strength of the Empire","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Knight's Morale","benefit":"When an ally within 12 squares of you and in your line of sight hits with a lightsaber attack, you deal +1 die of damage with the next lightsaber attack you make before the end of your next turn.","description":{"value":"When an ally within 12 squares of you and in your line of sight hits with a lightsaber attack, you deal +1 die of damage with the next lightsaber attack you make before the end of your next turn."},"class":"ec505163e5647cc6","costNumeric":null,"category":"Imperial Knight","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.e3b7d8c87441a1f0","name":"Knight's Morale"}],"_source":"canonical-csv"},"treeId":"8048efd85ae61101","tags":["cover","defense","force","lightsaber","melee","offense_melee","positioning","support","ally-trigger"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"runtime_ally_trigger","staticSheetPolicy":"exclude","manualResolution":true,"modifiers":[],"notes":"Next lightsaber attack gains +1 die after ally trigger; Ward/Cover note is separate ally-cover context.","combatActions":[{"id":"strength-of-the-empire-t31-reference","name":"Strength of the Empire","label":"Strength of the Empire","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"When an ally within 12 squares of you and in your line of sight hits with a Lightsaber attack, you deal +1 die of damage with the next Lightsaber attack you make before the end of your next turn.","notes":"When an ally within 12 squares of you and in your line of sight hits with a Lightsaber attack, you deal +1 die of damage with the next Lightsaber attack you make before the end of your next turn.","relatedSkills":[],"resources":["Ally c