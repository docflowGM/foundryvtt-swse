{"_id":"d21d7d3d4d7be0d2","name":"Seducer","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You excel at seduction through deception. If you fail a Persuasion check to change a target's attitude (see page 71 of the Saga Edition core rulebook), you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it's lower.","description":{"value":"You excel at seduction through deception. If you fail a Persuasion check to change a target's attitude (see page 71 of the Saga Edition core rulebook), you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it's lower."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","treeId":"67b59e020c1660eb","tags":["force","skills","social"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed target context","notes":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists.","combatActions":[{"id":"seducer-reroll","name":"Seducer Reroll","label":"Seducer Reroll","actionType":"free","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"If you fail a Persuasion check to change a target's attitude, immediately reroll using Deception instead of Persuasion and keep the reroll.","notes":"If you fail a Persuasion check to change a target's attitude, immediately reroll using Deception instead of Persuasion and keep the reroll.","relatedSkills":[{"skill":"Deception","when":"Reroll failed attitude-change Persuasion check"}],"resources":["Must accept reroll"],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{}}],"manualResolution":true,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Influence","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"You excel at seduction through deception.","source":"Legacy Era Campaign Guide","page":29},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.seducer","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":[],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"GM/player managed target context","note":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists."}}}}
{"_id":"d24b04541998b27b","name":"Rifle Master","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You treat all rifles as though they were accurate weapons, taking no penalty when firing at targets at short range.","description":{"value":"You treat all rifles as though they were accurate weapons, taking no penalty when firing at targets at short range."},"class":"162d866ba36fce69","costNumeric":null,"category":"Gunslinger","treeId":"1933731cc59f8463","tags":["positioning","ranged"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"combat_option_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Future CombatOptionResolver / action-card / reaction prompt / damage-resolution hook","notes":"Reviewed in T12. Removed legacy static/passive modifier data; this talent is a real combat mechanic but needs runtime context and should not mutate permanent sheet totals.","rules":[{"type":"ATTACK_OPTION","id":"rifle-master-short-range","label":"Rifle Master","summary":"Treat rifles as accurate weapons: no short-range penalty with rifles.","control":"passive","requiresWeaponGroups":["rifles"],"requiresRangeBand":"short","attackModifier":2}],"manualResolution":false,"phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Carbineer","status":"reviewed","notes":"Reviewed in tactical ranged/military cleanup."}},"summary":"You treat all rifles as though they were accurate weapons, taking no penalty when firing at targets at short range.","source":"Legacy Era Campaign Guide","page":41},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"skillSubstitution":true,"substitutionType":"pistol_as_rifle","description":"Pistol-class weapons function as rifles for talent requirements","id":"swse.talent.rifle_master","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":[]}}}
{"_id":"d26506bfba104470","name":"Electronic Trail","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Nowhere to Hide, trained in the Use Computer skill","description":{"value":"Once you have located a target using Gather Information, you can track its electronic presence. Once per day, you receive a catalog of the target's electronic trail, which includes the amount and location of credits spent, the routes of any public transportation taken, and the sites viewed on the HoloNet while the target was logged in using its primary identity. To receive this information, you must have access to a computer or datapad plus access to a network or the HoloNet. The electronic trail does not reveal bank balances or other secret information, which requires a separate Gather Information check."},"benefit":"Once you have located a target using Gather Information, you can track its electronic presence. Once per day, you receive a catalog of the target's electronic trail, which includes the amount and location of credits spent, the routes of any public transportation taken, and the sites viewed on the HoloNet while the target was logged in using its primary identity. To receive this information, you must have access to a computer or datapad plus access to a network or the HoloNet. The electronic trail does not reveal bank balances or other secret information, which requires a separate Gather Information check.","class":"","category":"","costNumeric":null,"treeId":"a47ed82a822e3962","tags":["action_economy","force","force_defense","force_offense","investigation","network","perception","sustained_damage","tech","tracking","pursuit","target-designation","fear","social"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"hunter_pursuit_fear_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals.","phase26HunterPursuitFearCleanup":{"phase":"T26","tree":"Bounty Hunter","status":"combat_action_card","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals."},"combatActions":[{"id":"electronic-trail","name":"Electronic Trail","label":"Electronic Trail","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Once you have located a target using Gather Information, you can track its electronic presence. Once per day, you receive a catalog of the target's Electronic Trail, which includes the amount and location of credits spent, the routes of any public transportation taken, and the sites viewed on the HoloNet while the target was logged in using its primary identity.","notes":"Once you have located a target using Gather Information, you can track its electronic presence. Once per day, you receive a catalog of the target's Electronic Trail, which includes the amount and location of credits spent, the routes of any public transportation taken, and the sites viewed on the HoloNet while the target was logged in using its primary identity.","relatedSkills":[{"skill":"Use Computer"},{"skill":"Gather Information"}],"resources":["Once per day","After locating target"],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}]},"summary":"After locating a target, receive a daily catalog of its normal electronic trail while you have computer/network access.","source":"Galaxy of Intrigue","page":24},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":["defense.fortitude","defense.will"],"talentHunterPursuitFearCleanup":{"phase":"T26","tree":"Bounty Hunter","status":"combat_action_card"}}}}
{"_id":"d2aabaa6848b4a09","name":"Force Immersion","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"White Current Adept, trained in Stealth","description":"You can use the sneak application of the Stealth skill to hide from electronic surveillance and sensors. Any opponent attempting to detect you with sensors or electronic surveillance must beat your Stealth check with a Use Computer check. You need only roll a single Stealth check to avoid both electronic notice and notice by conventional means, using the same result as the DC for both Perception checks and Use Computer checks made to detect you.","benefit":"You can use the sneak application of the Stealth skill to hide from electronic surveillance and sensors. Any opponent attempting to detect you with sensors or electronic surveillance must beat your Stealth check with a Use Computer check. You need only roll a single Stealth check to avoid both electronic notice and notice by conventional means, using the same result as the DC for both Perception checks and Use Computer checks made to detect you.","class":"","category":"","costNumeric":null,"treeId":"4509306f66d744bf","tags":["action_economy","evasion","force","force_capacity","force_offense","force_point_spend","force_power_synergy","mobility","perception","positioning","precision","reaction","resource_spend","skills","stealth","support","sustained_damage","swift_action","use_the_force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"reaction_or_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"modifiers":[],"combatActions":[{"id":"force-immersion","name":"Force Immersion","label":"Force Immersion","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Whenever you make a Stealth check to Sneak, you can use your check result in place of one adjacent ally's Stealth check to Sneak (additionally, if you have the Talent, that Talent applies to the designated ally as well). Similarly, you can use your Use the Force check result in the place of an adjacent ally's Use the Force check result to avoid detection by the Sense Force application of the skill. You can spend a Force Point to have this ability apply to all adjacent allies instead of just one. As a Reaction to being damaged by an attack or Force Power, you can spend a Force Point to gain Total Concealment from all targets until the end of your next turn. Additionally, if you have not yet taken your Second Wind, you can do so immediately as part of this Reaction. As a Swift Action, you can choose to surrender to the White Current and allow it to flow around you and fuel your Force Powers. Until the end of the encounter, you cannot use Force Powers that do not have \"You\" as the sole target. However, once per turn as a Swift Action, you can recover one spent Force Power that has \"You\" as the sole target without spending a Force Point, adding that Force Power back to your Force Power Suite. You can make a Use the Force check in place of a Stealth check. You are considered Trained in the Stealth skill. If you are entitled to a Stealth check reroll, you can reroll your Use the Force check instead (subject to the same circumstances and limitations).","notes":"Whenever you make a Stealth check to Sneak, you can use your check result in place of one adjacent ally's Stealth check to Sneak (additionally, if you have the Talent, that Talent applies to the designated ally as well). Similarly, you can use your Use the Force check result in the place of an adjacent ally's Use the Force check result to avoid detection by the Sense Force application of the skill. You can spend a Force Point to have this ability apply to all adjacent allies instead of just one. As a Reaction to being damaged by an attack or Force Power, you can spend a Force Point to gain Total Concealment from all targets until the end of your next turn. Additionally, if you have not yet taken your Second Wind, you can do so immediately as part of this Reaction. As a Swift Action, you can choose to surrender to the White Current and allow it to flow around you and fuel your Force Powers. Until the end of the encounter, you cannot use Force Powers that do not have \"You\" as the sole target. However, once per turn as a Swift Action, you can recover one spent Force Power that has \"You\" as the sole target without spending a Force Point, adding that Force Power back to your Force Power Suite. You can make a Use the Force check in place of a Stealth check. You are considered Trained in the Stealth skill. If you are entitled to a Stealth check reroll, you can reroll your Use the Force check instead (subject to the same circumstances and limitations).","relatedSkills":[{"skill":"Use the Force"},{"skill":"Stealth"},{"skill":"Perception"}],"resources":["Force Point context","Second Wind context","Force Power Suite context"],"requiredContext":["Adjacency/position confirmed by GM/player","Ally context confirmed","Target context confirmed"],"targetHint":"GM/player adjudicated target or affected creature(s)","spendAction":true,"ruleData":{},"reactionTrigger":"GM_ADJUDICATED_REACTION_WINDOW"}],"rules":[],"notes":"T28 removed unsafe migrated modifier/effect data. This talent depends on Force-suite, target, equipment, ally, encounter, or table-position context and is surfaced as a truthful manual/runtime card rather than a passive actor mutation.","phase28ForceMicrotraditionCleanup":{"phase":"T28","tree":"White Current Adept","status":"reviewed_contextual_or_manual_card","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Force/special-tradition microtree cleanup. Unsafe always-on rows were removed; final bonuses/effects require player/GM or future dedicated runtime owner."}},"summary":"You can use the sneak application of the Stealth skill to hide from electronic surveillance and sensors.","source":"Jedi Academy Training Manual","page":77},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":["attack.when-hit","proximity.ally-nearby"]}}}
{"_id":"d2b9069670413a43","name":"Hot Wire","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Trained in the Mechanics skill","benefit":"You can use your Mechanics check modifier instead of your Use Computer check modifier when making Use Computer checks to improve access to a computer system. You are considered trained in the Use Computer skill for purposes of using this talent. If you are entitled to a Use Computer check reroll, you may reroll your Mechanics check instead (subject to the same circumstances and limitations).","description":"You can use your Mechanics check modifier instead of your Use Computer check modifier when making Use Computer checks to improve access to a computer system. You are considered trained in the Use Computer skill for purposes of using this talent. If you are entitled to a Use Computer check reroll, you may reroll your Mechanics check instead (subject to the same circumstances and limitations).","class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"745a5686d6f21e8c"}],"_source":"fix5F-canonical"},"treeId":"f1657b1d23a4c7dc","tags":["mechanics","scaling","skills","slicing"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"phase17TechEngineeringCleanup":{"status":"cleaned_future_runtime_context","owner":"future_skill_use_substitution_resolver","notes":"Allows Mechanics instead of Use Computer only for Improve Access, not all Use Computer checks."}},"summary":"Use Mechanics instead of Use Computer to improve computer access, including qualifying rerolls.","source":"Starships of the Galaxy","page":16},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hot_wire","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.429Z","detectedPredicates":[]}}}
{"_id":"d2ffe0250af82d28","name":"Silicon Mind","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Iron Knight","talentTree":"Iron Knight","tree":"Iron Knight","treeId":"a7dc5adf97fd6a67","prerequisites":"","description":{"value":"Other Force-users have a difficult time knowing how to influence you. You can spend a Force Point as a reaction to gain a bonus to your Will Defense equal to your Charisma modifier (minimum +1) against all Use the Force checks until the end of your next turn."},"benefit":"Other Force-users have a difficult time knowing how to influence you. You can spend a Force Point as a reaction to gain a bonus to your Will Defense equal to your Charisma modifier (minimum +1) against all Use the Force checks until the end of your next turn.","class":"","category":"","costNumeric":null,"source":"Jedi Academy Training Manual","tags":["force"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"silicon-mind","name":"Silicon Mind","label":"Silicon Mind","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Other Force-users have a difficult time knowing how to influence you. You can spend a Force Point as a Reaction to gain a bonus to your Will Defense equal to your Charisma modifier (minimum +1) against all Use the Force checks until the end of your next turn.","notes":"Other Force-users have a difficult time knowing how to influence you. You can spend a Force Point as a Reaction to gain a bonus to your Will Defense equal to your Charisma modifier (minimum +1) against all Use the Force checks until the end of your next turn.","relatedSkills":[{"skill":"Use the Force"}],"resources":["May require Force Point"],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Iron Knight","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"Other Force-users have a difficult time knowing how to influence you.","page":79},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"sourcePatch":"force-tradition-and-jedi-guardian-membership","forceTalentCleanup":{"phase":"T22","tree":"Iron Knight","status":"combat_action_card"}}}}
{"_id":"d350b28e72652d29","name":"Wicked Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Weapon Focus (lightsabers) feat (see page 89), Weapon Specialization (lightsabers) (see page 41).","benefit":"When you score a critical hit with a Lightsaber, you may spend a Force Point to move the target -2 steps along the Condition Track.","description":{"value":"When you score a critical hit with a Lightsaber, you may spend a Force Point to move the target -2 steps along the Condition Track."},"class":"1ba03b2d00245906","costNumeric":null,"category":"Sith Apprentice","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.869168cd679ee5d1","name":"Weapon Specialization"}],"_source":"canonical-csv"},"treeId":"d1037bc7a08ea80b","tags":["condition_removal","critical_hit","dark_side","force","force_control","force_point_spend","lightsaber","melee","mobility","offense_melee","precision","resource_spend"],"executionModel":"ACTIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_critical_rider","applicationScope":"lightsaber_critical_condition_track","staticSheetPolicy":"exclude","manualResolution":false,"requiresRuntimeContext":true,"contributesGenericBonus":false,"modifiers":[],"notes":"Spend a Force Point after a lightsaber critical hit to move the target two steps down the condition track.","combatActions":[{"id":"wicked-strike","name":"Wicked Strike","label":"Wicked Strike","actionType":"free","cost":0,"manualResolution":false,"resolutionMode":"sithTalent","useLabel":"Use","description":"When you score a critical hit with a Lightsaber, you may spend a Force Point to move the target -2 steps along the Condition Track.","notes":"Spend a Force Point after a lightsaber critical hit to move the target two steps down the condition track.","relatedSkills":[],"resources":["Force Point","Lightsaber critical hit","Condition Track"],"requiredContext":[],"spendAction":false,"ruleData