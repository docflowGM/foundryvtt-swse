igrationDate":"2026-03-08T18:22:17.421Z","detectedPredicates":[],"talentBackcheck":{"source":"user-pasted-rules","date":"2026-06-11","updatedFields":["system.description","system.benefit","system.effect","system.shortSummary","system.prerequisite","system.abilityMeta"]}}}}
{"_id":"8d0657e7ade688bd","name":"Scripted Routines","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Base attack bonus +5","prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":5}],"_source":"scavengers-guide-to-droids-p28"},"description":{"value":"Your extensive experience allows you to preset specific routines that give you an advantage in some situations. Once per encounter you can use each of the following actions: Attack Script: You can use a feat or a talent that modifies your attack roll as one action less (for example, a full-round action becomes a standard action, a standard action becomes a move action, a move action becomes a swift action, a swift action becomes a free action). Defense Script: You can apply your Independent Spirit bonus a second time during a single encounter. Skill Script: While in combat, you can apply a bonus equal to one-half of your class level to any single skill that requires a standard action or less to use. You must be trained in the skill."},"benefit":"Your extensive experience allows you to preset specific routines that give you an advantage in some situations. Once per encounter you can use each of the following actions: Attack Script: You can use a feat or a talent that modifies your attack roll as one action less (for example, a full-round action becomes a standard action, a standard action becomes a move action, a move action becomes a swift action, a swift action becomes a free action). Defense Script: You can apply your Independent Spirit bonus a second time during a single encounter. Skill Script: While in combat, you can apply a bonus equal to one-half of your class level to any single skill that requires a standard action or less to use. You must be trained in the skill.","class":"","category":"Droid","costNumeric":null,"treeId":"b968ecab63bc4cf4","talent_tree":"Elite Droid","source":"Scavenger's Guide to Droids","page":29,"tags":["action_economy","droid","once-per-encounter","skills"],"executionModel":"ACTIVE","subType":"TALENT_ACTION","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"encounter_limited_scripted_routines","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"usesPerEncounter":1,"modifiers":[],"notes":"Three independent routines, each usable once per encounter. Attack Script stays contextual because the action-cost resolver cannot safely pick which Feat or Talent is being reduced. Defense Script depends on Independent Spirit state. Skill Script requires combat, a trained Skill, and a use costing a Standard Action or less.","routines":[{"id":"attack-script","name":"Attack Script","usesPerEncounter":1,"effect":"reduceActionCost","steps":[{"from":"full-round","to":"standard"},{"from":"standard","to":"move"},{"from":"move","to":"swift"},{"from":"swift","to":"free"}],"appliesTo":"featOrTalentModifyingAnAttackRoll","manualResolution":true},{"id":"defense-script","name":"Defense Script","usesPerEncounter":1,"effect":"reapplyIndependentSpirit","appliesTo":"independentSpiritBonus","manualResolution":true},{"id":"skill-script","name":"Skill Script","usesPerEncounter":1,"effect":"skillBonus","bonusFormula":"floor(independentDroidLevel / 2)","requires":["inCombat","trainedSkill","standardActionOrLess"],"manualResolution":true}],"combatActions":[],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"scripted-routines-elite-droid-context","label":"Scripted Routines","summary":"Once per encounter, you can use each of the following three Scripted Routines.\n\nAttack Script: You can use a Feat or Talent that modifies an attack roll as one action less than it normally requires. A Full-Round Action becomes a Standard Action, a Standard Action becomes a Move Action, a Move Action becomes a Swift Action, and a Swift Action becomes a Free Action.\n\nDefense Script: You can apply your Independent Spirit bonus a second time during the encounter.\n\nSkill Script: While in combat, you can apply a bonus equal to one-half your Independent Droid class level to one use of a Skill in which you are trained that requires a Standard Action or less."}]},"summary":"Your extensive experience allows you to preset specific routines that give you an advantage in some situations."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"8d14ab116a78dfd6","name":"Improved Manipulating Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Manipulating Strike","benefit":"Whenever you successfully use the Manipulating Strike talent, you determine what the target does with its move action on its next turn. You cannot move an opponent into a hazard such as lava or off a cliff.","description":{"value":"Whenever you successfully use the Manipulating Strike talent, you determine what the target does with its move action on its next turn. You cannot move an opponent into a hazard such as lava or off a cliff."},"costNumeric":null,"treeId":"da7b731a3e434a7a","tags":["action_economy","battlefield_control","control","deception","force","force_control","force_defense","force_offense","manipulation","mobility","move_action","positioning","skills","social","trap","pursuit","mind-affecting"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"hunter_pursuit_fear_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"implementedBy":"AbilityCombatActionResolver / GM-player context","notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals.","phase26HunterPursuitFearCleanup":{"phase":"T26","tree":"Genohardan","status":"combat_action_card","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Reviewed in T26 hunter/pursuit/fear cleanup. Conditional target, fear, pursuit, stealth, reaction, or minion effects should not mutate permanent actor totals."},"combatActions":[{"id":"improved-manipulating-strike","name":"Improved Manipulating Strike","label":"Improved Manipulating Strike","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Whenever you successfully use the Manipulating Strike Talent, you determine what the target does with its Move Action on its next turn. You cannot move an opponent into a Hazard (such as into lava or off a cliff).","notes":"Whenever you successfully use the Manipulating Strike Talent, you determine what the target does with its Move Action on its next turn. You cannot move an opponent into a Hazard (such as into lava or off a cliff).","relatedSkills":[],"resources":["Upgrades successful Manipulating Strike","Control target Move Action instead"],"requiredContext":["Manipulating Strike succeeded"],"targetHint":"","spendAction":false,"ruleData":{}}]},"summary":"Whenever you successfully use the Manipulating Strike talent, you determine what the target does with its move action on its next turn.","source":"Scum and Villainy","page":30},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_manipulating_strike","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.421Z","detectedPredicates":["defense.will"],"talentHunterPursuitFearCleanup":{"phase":"T26","tree":"Genohardan","status":"combat_action_card"}}}}
