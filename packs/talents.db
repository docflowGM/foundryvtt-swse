{"_id":"ae9cf46162b4bc42","name":"Willpower","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Inspire Confidence","benefit":"You can share your strength of will with your allies. Once per encounter as a swift action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight with you to retain this bonus. You may not use this talent on yourself.","description":{"value":"You can share your strength of will with your allies. Once per encounter as a swift action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight with you to retain this bonus. You may not use this talent on yourself."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.4d8882a28da30454","name":"Inspire Confidence"}],"_source":"canonical-csv"},"treeId":"72d32ebcbb607314","tags":["ally_support","support","teamwork","morale","will_defense","swift_action","action_economy","once-per-encounter"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"willpower","name":"Willpower","label":"Willpower","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use /