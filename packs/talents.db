{"_id":"5cb9f0f6011a1bab","name":"Friendly Fire","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Enemy Tactics","benefit":"If you are engaged in melee combat with an adjacent enemy and are the target of a ranged attack that misses you, compare the attack roll to the Reflex Defense of one adjacent enemy; if the attack equals or exceeds the target's Reflex Defense, that enemy becomes the new target of the attack, which is resolved as normal.","description":{"value":"If you are engaged in melee combat with an adjacent enemy and are the target of a ranged attack that misses you, compare the attack roll to the Reflex Defense of one adjacent enemy; if the attack equals or exceeds the target's Reflex Defense, that enemy becomes the new target of the attack, which is resolved as normal."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.bb28cf47a45aff36","name":"Enemy Tactics"}],"_source":"canonical-csv"},"treeId":"4dc70f924e7794ac","tags":["melee","positioning","ranged","social","intrigue","ally_support","battlefield_control"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed target context","notes":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists.","combatActions":[{"id":"friendly-fire-t31-reference","name":"Friendly Fire","label":"Friendly Fire","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"If you are engaged in melee combat with an adjacent enemy and are the target of a ranged attack t