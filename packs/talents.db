{"_id":"d137ae2e8be700b3","name":"Stolen Advantage","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Cast Suspicion","benefit":"Whenever an enemy within your line of sight uses the aid another action to grant one of its allies a bonus, you can (as a reaction) designate one ally within your line of sight. The enemy automatically fails to aid its ally, and the ally you designate gains a +2 bonus on its next attack roll made before the end of your next turn.","description":{"value":"Whenever an enemy within your line of sight uses the aid another action to grant one of its allies a bonus, you can (as a reaction) designate one ally within your line of sight. The enemy automatically fails to aid its ally, and the ally you designate gains a +2 bonus on its next attack roll made before the end of your next turn."},"class":"8c58016e587dd2c7","costNumeric":null,"category":"Noble","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.9408056ede41b43f","name":"Cast Suspicion"}],"_source":"canonical-csv"},"treeId":"da34105c875650ae","tags":["support","social","intrigue","reaction","control"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"gm_player_managed","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"stolen-advantage-t31-reference","name":"Stolen Advantage","label":"Stolen Advantage","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Whenever an enemy within your line of sight uses the Aid Another Action to grant one of its allies a bonus, y