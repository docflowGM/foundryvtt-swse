{"_id":"7fa47c5d2c33ed40","name":"Force Suppression","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"rebuke Force power","benefit":"If you use the rebuke Force power to attempt to negate or redirect a Force power used against you but fail to overcome your opponent's Use the Force check result, you instead lessen the effect of the Force power by one step. For example, if an opponent attempted to use the slow Force power on you and rolled a 21, if you fail to rebuke the power you only suffer the DC 15 effect instead of the DC 20 effect. This talent only affects Force powers that have variable effects based on your opponent's Use the Force checks, and powers with static DCs without variable effects (such as Force lightning) are unaffected.","description":"If you use the rebuke Force power to attempt to negate or redirect a Force power used against you but fail to overcome your opponent's Use the Force check result, you instead lessen the effect of the Force power by one step. For example, if an opponent attempted to use the slow Force power on you and rolled a 21, if you fail to rebuke the power you only suffer the DC 15 effect instead of the DC 20 effect. This talent only affects Force powers that have variable effects based on your opponent's Use the Force checks, and powers with static DCs without variable effects (such as Force lightning) are unaffected.","costNumeric":null,"prerequisitesMeta":["Requires Force Power: rebuke Force power"],"treeId":"d3661aa9906bdc79","tags":["force","force_capacity","force_power_synergy","recovery","resilience","resource_recovery","will_defense"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"force-suppression","name":"Force Suppression","label":"Force Suppression","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Attempt to rebuke a Force power; if you fail, lessen its effect by one step; only works on powers with variable effects.","notes":"Attempt to rebuke a Force power; if you fail, lessen its effect by one step; only works on powers with variable effects.","relatedSkills":[{"skill":"Use the Force"}],"resources":["Attempt to rebuke variable Force Power effect"],"requiredContext":[],"targetHint":""}],"mechanicsMode":"combat_action","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Control","status":"combat_action_card","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"If you use the rebuke Force power to attempt to negate or redirect a Force power used against you but fail to overcome your opponent's Use the Force check result, you instead lessen the effect of the Force power by one step.","source":"Knights of the Old Republic Campaign Guide","page":53},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_suppression","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.419Z","detectedPredicates":[],"forceTalentCleanup":{"phase":"T22","tree":"Control","status":"combat_action_card"}}}}
{"_id":"8063a6b94b1de530","name":"Close-Quarters Fighter","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Whenever you occupy the same square as your target or are adjacent to your target, you gain a +1 circumstance bonus to your melee attack rolls against that target.","description":{"value":"Whenever you occupy the same square as your target or are adjacent to your target, you gain a +1 circumstance bonus to your melee attack rolls against that target."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","treeId":"fad8118981c532f0","tags":["melee","positioning"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"runtime_context","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Future CombatOptionResolver / action-card / reaction prompt / damage-resolution hook","notes":"Reviewed in T12. Removed legacy static/passive modifier data; this talent is a real combat mechanic but needs runtime context and should not mutate permanent sheet totals."},"summary":"Whenever you occupy the same square as your target or are adjacent to your target, you gain a +1 circumstance bonus to your melee attack rolls against that target.","source":"Clone Wars Campaign Guide","page":40},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.close_quarters_fighter","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.419Z","detectedPredicates":["attack.with-melee"]}}}
