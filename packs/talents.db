{"_id":"0290634450ab1637","name":"Electronic Sabotage","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Trained in the Use Computer skill","benefit":"You excel at causing havoc with computers and electronics. As a standard action, you can lock down a computer terminal by making a Use Computer check, making it potentially difficult for anyone else to access. That computer is considered unfriendly to anyone other than you who attempts to use it, and the result of your Use Computer check replaces the computer's Will Defense on an attempt to change its attitude. This effect ends if anyone else succeeds in adjusting the computer's attitude to indifferent. You cannot take 20 on this Use Computer check.","description":{"value":"You excel at causing havoc with computers and electronics. As a standard action, you can lock down a computer terminal by making a Use Computer check, making it potentially difficult for anyone else to access. That computer is considered unfriendly to anyone other than you who attempts to use it, and the result of your Use Computer check replaces the computer's Will Defense on an attempt to change its attitude. This effect ends if anyone else succeeds in adjusting the computer's attitude to indifferent. You cannot take 20 on this Use Computer check."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"usecomputer"}],"_source":"fix5F-canonical"},"treeId":"64874e65579e4cf4","tags":["mechanics","skills","slicing","tech","use_computer"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"electronic-sabotage","name":"Electronic Sabotage","label":"Electronic Sabotage","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"You excel at causing havoc with computers and electronics. As a Standard Action, you can lock down a computer terminal by making a Use Computer check, making it potentially difficult for anyone else to access. That computer is considered Unfriendly to anyone other than you who attempts to use it, and the result of your Use Computer check replaces the computer's Will Defense on an attempt to change its Attitude.","notes":"Make a Use Computer check to lock down a terminal. The check result replaces the computer Will Defense for attempts by others to change its attitude.","relatedSkills":[{"skill":"Use Computer"}],"resources":["Computer terminal","Use Computer check","Computer attitude/Will Defense"],"requiredContext":["Accessible computer terminal"],"targetHint":"","spendAction":true,"ruleData":{}}],"rules":[],"mechanicsMode":"combat_action_reference","applicationScope":"runtime_skill_crafting_medical_computer_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase29TechMedicalMicrotreeCleanup":{"phase":"T29","tree":"Slicer","status":"reviewed_manual_or_runtime_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Tech/medical/science microtree pass removed unsafe passive rows and surfaces crafting, cloning, poison, computer, droid-command, and treatment effects as truthful action/reference cards."}},"summary":"You excel at causing havoc with computers and electronics.","source":"Force Unleashed Campaign Guide","page":27},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.electronic_sabotage","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.402Z","detectedPredicates":["defense.will"]}}}
