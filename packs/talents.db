{"_id":"f0bfcfc354862328","name":"No Escape","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Opportunistic Strike","benefit":"Whenever an opponent uses the withdraw action to leave your threatened space, that opponent is considered flat-footed against you until the end of your next turn.","description":{"value":"Whenever an opponent uses the withdraw action to leave your threatened space, that opponent is considered flat-footed against you until the end of your next turn."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.93770927eba5446d","name":"Opportunistic Strike"}],"_source":"canonical-csv"},"treeId":"6367600ed3c0cfae","tags":["mobility"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"Whenever an opponent uses the withdraw action to leave your threatened space, that opponent is considered flat-footed against you until the end of your next turn.","source":"Knights of the Old Republic Campaign Guide","page":27},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.no_escape","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.433Z","detectedPredicates":[]}}}
