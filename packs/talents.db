{"_id":"9dfce712a60a097f","name":"Djem So","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":null,"benefit":"Once per round when an opponent hits you with a melee attack, you may spend a Force Point as a reaction to make an immediate attack against that opponent.","description":"Once per round when an opponent hits you with a melee attack, you may spend a Force Point as a reaction to make an immediate attack against that opponent.","class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"2bc2572e852832e4","tags":["lightsaber","melee","sustained_damage","force","reaction"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"manual","applicationScope":"reaction_force_point_attack_manual","staticSheetPolicy":"manual_only","manualResolution":true,"notes":"Once per round reaction after a melee hit, spend a Force Point to make an immediate attack. Needs combat reaction prompt and attacker context; no passive attack or damage bonus.","modifiers":[],"combatActions":[{"id":"djem-so","name":"Djem So","label":"Djem So","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"reaction","useLabel":"React / Note","description":"After an opponent hits you with a melee attack, spend a Force Point as a Reaction to make an immediate attack against that opponent.","notes":"After an opponent hits you with a melee attack, spend a Force Point as a Reaction to make an immediate attack against that opponent.","relatedSkills":[{"skill":"Attack Roll"}],"resources":["Force Point context","Once per round"],"requiredContext":["Reaction timing must be valid"],"targetHint":"","spendAction":true,"ruleData":{"reactionKey":"djemSo","trigger":"ON_ATTACK_HIT"}}],"rules":[],"requiresRuntimeContext":true,"phase27JediLightsaberMysticCleanup":{"phase":"T27","tree":"Lightsaber Forms","status":"reviewed_contextual_or_manual_card","removedEmbeddedActiveEffects":0,"removedLegacyModifierRows":0,"notes":"Jedi/lightsaber/My