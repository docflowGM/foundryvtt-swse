{"_id":"d7e9b15e21ea1c4e","name":"Devastating Melee Smash","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Melee Smash","benefit":"Once per encounter, you can attempt a devastating melee smash. You must declare this special melee attack before making the attack roll. If the attack roll succeeds add half your level to the damage instead of the normal +1 for Melee Smash. The damage from this talent does not stack with any damage bonus provided by the Powerful Charge feat.","description":{"value":"Once per encounter, you can attempt a devastating melee smash. You must declare this special melee attack before making the attack roll. If the attack roll succeeds add half your level to the damage instead of the normal +1 for Melee Smash. The damage from this talent does not stack with any damage bonus provided by the Powerful Charge feat."},"class":"f62ca2e639cab614","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.e0ee525f4109cfde","name":"Melee Smash"}],"_source":"canonical-csv"},"treeId":"67fdd8dce9abd6c1","tags":["melee","mobility","scaling","damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"rules":[{"type":"ATTACK_OPTION","id":"devastatingMeleeSmash","label":"Devastating Melee Smash","control":"toggle","requiresAttackType":"melee","damageModifierFormula":"halfLevelMinusOne","summary":"Once per encounter, declare before a melee attack. Adds half level instead of the +1 from Melee Smash; this option adds the net extra over Melee Smash."}],"mechanicsMode":"runtime_context","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"manual_only","requiresRuntimeContext":true,"requiresSelectedChoice":false,"phase21BrawlerShockboxerCleanup":{"status":"runtime_attack_option","owner":"CombatOptionResolver / ReactionEngine / GrapplingSystem","notes":"Implemented as a declared melee attack option using net half-level-over-Melee-Smash damage; Powerful Charge non-stacking remains table/context adjudicated.","naturalWeaponPolicy":"Treat species natural weapons as unarmed-family attacks when the source text affects unarmed attacks."}},"summary":"Once per encounter, you can attempt a devastating melee smash.","source":"Knights of the Old Republic Campaign Guide","page":29},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.devastating_melee_smash","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":["attack.with-melee","turn.once-per-round"]}}}
{"_id":"d838141fe404a9fb","name":"Defensive Circle","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Battle Meditation, Block or Deflect, Jedi Battle Commander","benefit":"As a swift action, you and any allies affected by your Battle Meditation gain a +2 insight bonus to Reflex Defense, lasting as long as they are affected by Battle Meditation. Additionally, you gain a +1 bonus to your Use the Force checks to Block and Deflect (as per the talents) for each adjacent ally wielding a lightsaber.","description":{"value":"As a swift action, you and any allies affected by your Battle Meditation gain a +2 insight bonus to Reflex Defense, lasting as long as they are affected by Battle Meditation. Additionally, you gain a +1 bonus to your Use the Force checks to Block and Deflect (as per the talents) for each adjacent ally wielding a lightsaber."},"class":"fb5c2644f988e6bf","costNumeric":null,"category":"Jedi Knight","treeId":"dfc4142435b4356d","tags":["force","force_defense","light_side","positioning","support"],"executionModel":"ACTIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"action_or_contextual","applicationScope":"battle_meditation_defense_upgrade","staticSheetPolicy":"exclude","manualResolution":true,"notes":"Swift-action Battle Meditation rider for you and affected allies. Requires active Battle Meditation/aura/ally tracking; no permanent Reflex bonus.","modifiers":[],"status":"talent_backcheck_user_text_2026_06_11","description":"Battle Meditation allies gain +2 Reflex; gain +1 UtF to Block/Deflect per adjacent lightsaber-wielding ally.","requiresRuntimeContext":true,"requiresSelectedChoice":false,"conditionSummary":"Battle Meditation allies gain +2 Reflex; gain +1 UtF to Block/Deflect per adjacent lightsaber-wielding ally.","metadataPhase":"jedi-prestige-talent-backcheck","metadataNotes":"Updated from user-provided source text; non-automatable targeting/LOS/session adjudication remains GM/player confirmed.","rules":[{"type":"TALENT_RULE","id":"defensive_circle","label":"Defensive Circle","summary":"Battle Meditation allies gain +2 Reflex; gain +1 UtF to Block/Deflect per adjacent lightsaber-wielding ally.","action":"swift-action","mode":"battle_meditation_defense_upgrade","text":"As a Swift Action, you and any allies affected by your Battle Meditation gain a +2 insight bonus to their Reflex Defense, lasting as long as they are affected by your Battle Meditation. Additionally, you gain a +1 bonus to your Use the Force checks to Block and Deflect (as per the Talents) for each adjacent ally wielding a Lightsaber."}]},"effect":"As a Swift Action, you and any allies affected by your Battle Meditation gain a +2 insight bonus to their Reflex Defense, lasting as long as they are affected by your Battle Meditation. Additionally, you gain a +1 bonus to your Use the Force checks to Block and Deflect (as per the Talents) for each adjacent ally wielding a Lightsaber.","shortSummary":"Battle Meditation allies gain +2 Reflex; gain +1 UtF to Block/Deflect per adjacent lightsaber-wielding ally.","prerequisite":"Battle Meditation, Block or Deflect, Jedi Battle Commander","prerequisitesText":"Battle Meditation, Block or Deflect, Jedi Battle Commander","grantsActions":["swift-action"],"summary":"As a swift action, you and any allies affected by your Battle Meditation gain a +2 insight bonus to Reflex Defense, lasting as long as they are affected by Battle Meditation.","source":"Knights of the Old Republic Campaign Guide","page":39},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.defensive_circle","jediTreeCleanup":{"phase":"T7","status":"manual_or_contextual","reason":"Swift-action Battle Meditation rider for you and affected allies. Requires active Battle Meditation/aura/ally tracking; no permanent Reflex bonus."},"talentBackcheck":{"source":"user-pasted-rules","date":"2026-06-11","updatedFields":["system.description","system.benefit","system.effect","system.shortSummary","system.prerequisite","system.abilityMeta"]}}}}
{"_id":"d8d7218123a28f39","name":"Fleet Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Charisma 13, Fleet Deployment","benefit":"As a standard action, you may designate a single vehicle as the target of a large-scale assault. If you succeed on a DC 15 Knowledge (tactics) check, all allied gunners within line of sight deal 1 additional die of damage to the target with each successful ranged attack until the start of your next turn. This is a mind-affecting effect.","description":{"value":"As a standard action, you may designate a single vehicle as the target of a large-scale assault. If you succeed on a DC 15 Knowledge (tactics) check, all allied gunners within line of sight deal 1 additional die of damage to the target with each successful ranged attack until the start of your next turn. This is a mind-affecting effect."},"class":"30b9cd24b80ebf46","costNumeric":null,"category":"Officer","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"cha","min":13},{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.d1c2e9bdbb58b715","name":"Fleet Deployment"}],"_source":"canonical-csv"},"treeId":"057a978a7dc1d5a7","tags":["vehicle","tactics","knowledge","skills","standard_action","action_economy","ally_support","support","teamwork","target-designation","targeting","ranged","damage_bonus","sustained_damage","mind-affecting"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Vehicle/crew systems or GM/player managed","notes":"Vehicle/crew/tactical effects need vehicle, commander, gunner, pilot, line-of-sight, or target context not available to static actor prep.","combatActions":[{"id":"fleet-tactics","name":"Fleet Tactics","label":"Fleet Tactics","actionType":"standard","cost":1,"manualResolution":false,"resolutionMode":"auto","useLabel":"Roll / Use","description":{"dc":15,"resources":["Mind-affecting","Vehicle/gunner context"],"targetHint":"One vehicle target","when":"Knowledge (Tactics) DC 15"},"notes":{"dc":15,"resources":["Mind-affecting","Vehicle/gunner context"],"targetHint":"One vehicle target","when":"Knowledge (Tactics) DC 15"},"relatedSkills":[{"skill":"Designate a vehicle as the target of a large-scale assault. On a DC 15 Knowledge (Tactics) check, allied gunners within line of sight deal +1 die damage to the target until the start of your next turn.","when":""}],"resources":[],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{},"skillKey":"Designate a vehicle as the target of a large-scale assault. On a DC 15 Knowledge (Tactics) check, allied gunners within line of sight deal +1 die damage to the target until the start of your next turn."}],"manualResolution":false,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Naval Officer","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"Standard action and DC 15 Knowledge (tactics) check grants visible allied gunners +1 damage die against one vehicle until your next turn.","source":"Starships of the Galaxy","page":18},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.fleet_tactics","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":[],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"Vehicle/crew systems or GM/player managed","note":"Vehicle/crew/tactical effects need vehicle, commander, gunner, pilot, line-of-sight, or target context not available to static actor prep."}}}}
{"_id":"d9241073d3b975e6","name":"Ward","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a swift action, designate one adjacent ally. Until the end of your next turn, as long as that ally remains adjacent to you, you are considered to be providing that ally with soft cover against all attacks. You cannot be designated as the target of this talent (such as, when it is used by an ally) if you have used this talent since the start of your last turn, and you cannot use this talent if you are currently designated as another ally's ward.","description":{"value":"As a swift action, designate one adjacent ally. Until the end of your next turn, as long as that ally remains adjacent to you, you are considered to be providing that ally with soft cover against all attacks. You cannot be designated as the target of this talent (such as, when it is used by an ally) if you have used this talent since the start of your last turn, and you cannot use this talent if you are currently designated as another ally's ward."},"class":"c4dbedcf989cb6b2","costNumeric":null,"category":"Elite Trooper","treeId":"c92c2cbc79b8a515","tags":["action_economy","armor","positioning","scaling","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action_reference","applicationScope":"martial_protector_arena_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","combatActions":[{"id":"ward-t30-reference","name":"Ward","label":"Ward","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"As a Swift Action, designate one adjacent ally. Until the end of your next turn, as long as that ally remains adjacent to you, you are considered to be providing that ally with Soft Cover against all attacks.","notes":"As a Swift Action, designate one adjacent ally. Until the end of your next turn, as long as that ally remains adjacent to you, you are considered to be providing that ally with Soft Cover against all attacks.","relatedSkills":[],"resources":["Until your next turn","Ally context","Adjacent positioning"],"requiredContext":["Valid adjacent creature/ally positioning","Swift action available","Protected ally and damage-transfer context confirmed"],"targetHint":"GM/player adjudicated target or context","spendAction":true,"ruleData":{}}],"rules":[{"type":"COVER_CONTEXT_REFERENCE","id":"ward-soft-cover-adjacent-ally","label":"Ward","summary":"Swift Action to designate adjacent ally; while adjacent until end of next turn, you provide Soft Cover to that ally. Use the combat status cover surface/GM context."}],"phase30MartialProtectorArenaCleanup":{"phase":"T30","tree":"Protection","status":"reviewed_manual_or_runtime_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"T30 removed unsafe passive rows from martial/protector/arena/species leftovers and surfaced action, reaction, recovery, cover, and attack-rider context as truthful cards/rules."}},"summary":"As a swift action, designate one adjacent ally.","source":"Legacy Era Campaign Guide","page":41},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.ward","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.430Z","detectedPredicates":["defense.reflex","attack.when-hit","proximity.ally-nearby"]}}}
{"_id":"d9e707f23fffc2af","name":"Armor Mastery","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":null,"benefit":"When calculating your Reflex Defense, you may add your heroic level plus one-half your armor bonus (rounded down) or your armor bonus, whichever is higher. You must be proficient with the armor you are wearing to gain this benefit.\n\nThis talent counts as both the Armored Defense and Improved Armored Defense talents for the purposes of prerequisites.","description":"When calculating your Reflex Defense, you may add your heroic level plus one-half your armor bonus (rounded down) or your armor bonus, whichever is higher. You must be proficient with the armor you are wearing to gain this benefit.\n\nThis talent counts as both the Armored Defense and Improved Armored Defense talents for the purposes of prerequisites.","class":"ec505163e5647cc6","costNumeric":null,"category":"Imperial Knight","treeId":"ea01d740c91888b3","tags":["armor","defense","force","lightsaber","scaling"],"executionModel":"PASSIVE","subType":"MODIFIER","abilityMeta":{"mechanicsMode":"passive","applicationScope":"equipped_armor_context","staticSheetPolicy":"defense_calculator_only","implementedBy":"DefenseCalculator armor Reflex level-term rule","notes":"Counts as Armored Defense and Improved Armored Defense while proficiently wearing armor; no separate flat Reflex modifier.","modifiers":[],"combatActions":[{"id":"armor-mastery-t31-reference","name":"Armor Mastery","label":"Armor Mastery","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Reflex Defense bonus equals heroic level + half armor bonus or armor bonus; counts as Armored and Improved Armored Defense.","notes":"Reflex Defense bonus equals heroic level + half armor bonus or armor bonus; counts as Armored and Improved Armored Defense.","relatedSkills":[],"resources":[],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"armor-mastery-t31-context","label":"Armor Mastery","summary":"Reflex Defense bonus equals heroic level + half armor bonus or armor bonus; counts as Armored and Improved Armored Defense."}],"phase31FinalRemainingCleanup":{"phase":"T31","tree":"Knight's Armor","status":"reviewed_manual_runtime_or_existing_engine_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"Final remaining tree pass. No unsafe legacy rows remained; talent is surfaced through action/reference cards, context rules, or existing dedicated engine ownership instead of passive fake bonuses."}},"summary":"When calculating your Reflex Defense, you may add your heroic level plus one-half your armor bonus (rounded down) or your armor bonus, whichever is higher.","source":"Legacy Era Campaign Guide","page":45},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armor_mastery","forcePrestigeCleanup":{"phase":"T9","status":"implemented_existing_owner","owner":"DefenseCalculator armor Reflex level-term rule"}}}}
{"_id":"d9f47bfdde76475f","name":"Brutal Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Weapon Focus with the chosen weapon","benefit":"Choose a single exotic weapon or weapon group you are proficient with. Attacks with such weapons that deal damage that exceeds an opponent's damage threshold deal +1 die of damage on that attack.\n\nYou can select this talent multiple times. Each time you select this talent, it applies to a different exotic weapon or weapon group.","description":{"value":"Choose a single exotic weapon or weapon group you are proficient with. Attacks with such weapons that deal damage that exceeds an opponent's damage threshold deal +1 die of damage on that attack.\n\nYou can select this talent multiple times. Each time you select this talent, it applies to a different exotic weapon or weapon group."},"class":"533f1066362655c7","costNumeric":null,"category":"Gladiator","treeId":"12a2a02b0901605d","tags":["melee","mobility","positioning","ranged"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action_reference","applicationScope":"martial_protector_arena_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":true,"modifiers":[],"implementedBy":"Future CombatOptionResolver / action-card / reaction prompt / damage-resolution hook","notes":"Reviewed in T12. Removed legacy static/passive modifier data; this talent is a real combat mechanic but needs runtime context and should not mutate permanent sheet totals.","choiceMetaStatus":"phase14_persistent_choice_seeded","combatActions":[{"id":"brutal-attack-t30-reference","name":"Brutal Attack","label":"Brutal Attack","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Choose a single weapon with which you posses the Weapon Focus feat. Attacks with such weapons that deal damage (including doubling damage from a Critical Hit) exceeding an opponent's Damage Threshold deals +1 die of damage on that attack.","notes":"Choose a single weapon with which you posses the Weapon Focus feat. Attacks with such weapons that deal damage (including doubling damage from a Critical Hit) exceeding an opponent's Damage Threshold deals +1 die of damage on that attack.","relatedSkills":[],"resources":["Damage Threshold context"],"requiredContext":["Triggering attack/damage result confirmed","Arena/attack trigger context confirmed"],"targetHint":"GM/player adjudicated target or context","spendAction":false,"ruleData":{}}],"rules":[{"type":"DAMAGE_THRESHOLD_RIDER","id":"brutal-attack-extra-die","label":"Brutal Attack","summary":"With the chosen Weapon Focus weapon, if damaging attack exceeds target Damage Threshold, add +1 die of damage to that attack. Requires selected weapon context."}],"manualResolution":true,"phase30MartialProtectorArenaCleanup":{"phase":"T30","tree":"Gladiatorial Combat","status":"reviewed_manual_or_runtime_context","removedLegacyModifierRows":0,"removedEmbeddedActiveEffects":0,"notes":"T30 removed unsafe passive rows from martial/protector/arena/species leftovers and surfaced action, reaction, recovery, cover, and attack-rider context as truthful cards/rules."}},"choiceMeta":{"resolution":"immediate","required":true,"status":"phase14_persistent_choice_seeded","choiceKind":"weapon_focus_choice","repeatable":true,"storagePath":"flags.swse.choices.brutal_attack_weapon","choiceSource":"prerequisiteDerived","optionRegistry":"data/feat-choice-options.json#choiceKinds.weapon_focus_choice","derivesFrom":["weapon_focus"],"consumes":"weapon_focus","provides":"weapon_focus_choice"},"summary":"Choose a single exotic weapon or weapon group you are proficient with.","source":"Knights of the Old Republic Campaign Guide","page":44},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.brutal_attack","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.4