{"_id":"0fc08fad3a87a830","name":"Disciplined Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":null,"benefit":"Whenever you use a Force power that has an area effect (such as Force slam), you may exclude a certain number of targets from the effects of that power. The number of targets that you may exclude in this manner is equal to your Wisdom modifier (minimum of 1).","description":"Whenever you use a Force power that has an area effect (such as Force slam), you may exclude a certain number of targets from the effects of that power. The number of targets that you may exclude in this manner is equal to your Wisdom modifier (minimum of 1).","costNumeric":null,"treeId":"6ac3416fb6aada56","tags":["battlefield_control","force","force_offense","skill_substitution","telekinesis","telepathy"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"manual_or_runtime","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Alter","status":"cleaned_manual_or_future_runtime","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"Whenever you use a Force power that has an area effect (such as Force slam), you may exclude a certain number of targets from the effects of that power.","source":"Saga Edition Core Rulebook","page":100},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.disciplined_strike","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.403Z","detectedPredicates":[],"forceTalentCleanup":{"phase":"T22","tree":"Alter","status":"cleaned_manual_or_future_runtime"}}}}
{"_id":"0fd8fc8cfae6f516","name":"Impose Hesitation","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a standard action, make a Persuasion check targeting all opponents in a 6-square cone. If you equal or exceed the target's Will Defense, the target loses a swift action on its next turn and cannot take full-round actions. This is a mind-affecting effect. Targets need to see, hear, and understand you to be affected by this attack.","description":{"value":"As a standard action, make a Persuasion check targeting all opponents in a 6-square cone. If you equal or exceed the target's Will Defense, the target loses a swift action on its next turn and cannot take full-round actions. This is a mind-affecting effect. Targets need to see, hear, and understand you to be affected by this attack."},"class":"fc815ae3ca4bf726","costNumeric":null,"category":"Corporate Agent","treeId":"45c4007d09c01839","tags":["action_economy","battlefield_control","burst_damage","control","deception","force","force_control","force_defense","force_offense","mobility","persuasion","positioning","skills","social","standard_action","support","sustained_damage","swift_action"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed target context","notes":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists.","combatActions":[{"id":"impose-hesitation","name":"Impose Hesitation","label":"Impose Hesitation","actionType":"standard","cost":1,"manualResolution":false,"resolutionMode":"auto","useLabel":"Roll / Use","description":{"resources":["Mind-affecting","Targets must see, hear, and understand you"],"targetHint":"Opponents in 6-square cone","when":"Persuasion vs Will Defense"},"notes":{"resources":["Mind-affecting","Targets must see, hear, and understand you"],"targetHint":"Opponents in 6-square cone","when":"Persuasion vs Will Defense"},"relatedSkills":[{"skill":"Make a Persuasion check against all opponents within a 6-square cone. Targets whose Will Defense you equal or exceed lose a Swift Action on their next turn and cannot take Full-Round Actions.","when":""}],"resources":[],"requiredContext":[],"targetHint":"","spendAction":true,"ruleData":{},"skillKey":"Make a Persuasion check against all opponents within a 6-square cone. Targets whose Will Defense you equal or exceed lose a Swift Action on their next turn and cannot take Full-Round Actions."}],"manualResolution":false,"phase23SocialCommanderCleanup":{"phase":"T23","tree":"Corporate Power","status":"combat_action_card","cardsAdded":1,"notes":"Social/commander activation surfaced through abilityMeta combat action cards. Skill-backed cards use the existing sheet skill preroller where safe; final buffs/debuffs remain GM/player/runtime-applied."}},"summary":"As a standard action, make a Persuasion check targeting all opponents in a 6-square cone.","source":"Knights of the Old Republic Campaign Guide","page":43},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.impose_hesitation","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.403Z","detectedPredicates":["defense.will","turn.once-per-round"],"nobleOfficerCorporateCleanup":{"phase":"T10","status":"gm_player_managed","owner":"GM/player managed target context","note":"The benefit depends on a target/opponent/reaction/encounter condition; per user direction, punt +X/penalties against conditional targets to GM/player unless an exact runtime owner exists."}}}}
{"_id":"10a43f0f9d4b31f5","name":"Regroup","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Charisma 13","benefit":"Once per encounter as a standard action, you can move all vehicles in your squadron +1 step on their condition tracks.","description":{"value":"Once per encounter as a standard action, you can move all vehicles in your squadron +1 step on their condition tracks."},"class":"9c9989c34714f920","costNumeric":null,"category":"Ace Pilot","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"cha","min":13}],"_source":"canonical-csv"},"treeId":"dc1b8c5ce2a70394","tags":["condition_removal","mobility"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"regroup","name":"Regroup","label":"Regroup","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Once per encounter, move all vehicles in your squadron +1 step on their Condition Tracks.","notes":"Once per encounter, move all vehicles in your squadron +1 step on their Condition Tracks.","resources":["Once per encounter","Squadron"]}],"phase16VehicleStarshipCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual combat action card in the action economy UI."}},"summary":"Once per encounter, standard action moves every squadron vehicle +1 step on the condition track.","source":"Starships of the Galaxy","page":18},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.regroup","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.403Z","detectedPredicates":["turn.once-per-round"]}}}
{"_id":"10a678b2b7e3ac0e","name":"Mark the Target","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Whenever you damage a target with a non-Area Attack ranged attack, you may designate one ally within your line of sight as a Swift Action. Your target is considered Flat-Footed against that ally's first attack made before the start of your next turn.","description":{"value":"Whenever you damage a target with a non-Area Attack ranged attack, you may designate one ally within your line of sight as a Swift Action. Your target is considered Flat-Footed against that ally's first attack made before the start of your next turn."},"class":"acd10710f000ae70","costNumeric":null,"category":"Vanguard","treeId":"ca304c9496f38747","tags":["action_economy","battlefield_control","cover","offense_ranged","recon","support","swift_action","targeting","teamwork"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"combat_action_or_reaction_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"GM/player managed until exact target/ally/battlefield context exists","notes":"Reviewed in T12. Removed legacy static/passive automation. Conditional target, ally, positioning, or scene-state effects should be applied at the table or through a future runtime prompt.","combatActions":[{"id":"mark-the-target","name":"Mark the Target","label":"Mark the Target","actionType":"swift","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"After damaging a target with a non-area ranged attack, designate one ally in line of sight. The damaged target is flat-footed against that ally’s first attack before your next turn.","notes":"After damaging a target with a non-area ranged attack, designate one ally in line of sight. The damaged target is flat-footed against that ally’s first attack before your next turn.","relatedSkills":[],"resources":["Swift Action","After non-area ranged damage"],"requiredContext":[],"targetHint":"One ally"}],"phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Vanguard","status":"reviewed","notes":"Reviewed in tactical ranged/military cleanup."}},"summary":"Whenever you damage a target with a non-Area Attack ranged attack, you may designate one ally within your line of sight as a Swift Action.","source":"Clone Wars Campaign Guide","page":47},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.mark_the_target","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.403Z","detectedPredicates":[]}}}
{"_id":"11065e811d738b6e","name":"Hunker Down","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Whenever you benefit from cover, you can spend a swift action to hunker down and maximize the benefit of the cover. You increase the benefit of cover to improved cover and improved cover to total cover.","description":{"value":"Whenever you benefit from cover, you can spend a swift action to hunker down and maximize the benefit of the cover. You increase the benefit of cover to improved cover and improved cover to total cover."},"class":"b5bed5d1b5f42958","costNumeric":null,"category":"Scout","treeId":"3926d582d2077489","tags":["action_economy","scaling"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[]},"summary":"Whenever you benefit from cover, you can spend a swift action to hunker down and maximize the benefit of the cover.","source":"Scum and Villainy","page":16},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hunker_down","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.404Z","detectedPredicates":[]}}}
{"_id":"111b0a9d1f8d5111","name":"Personalized Modifications","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"As a standard action, you may tweak the settings, grips, and moving parts of a powered weapon you wield, tailoring it to your needs. For the remainder of the encounter, you gain a +1 equipment bonus on attack rolls and a +2 equipment bonus on damage rolls with that weapon. You can use this talent only on powered weapons (those that require a power cell to operate), including weapons connected to a larger power source (such as vehicle and starship weapons).","description":{"value":"As a standard action, you may tweak the settings, grips, and moving parts of a powered weapon you wield, tailoring it to your needs. For the remainder of the encounter, you gain a +1 equipment bonus on attack rolls and a +2 equipment bonus on damage rolls with that weapon. You can use this talent only on powered weapons (those that require a power cell to operate), including weapons connected to a larger power source (such as vehicle and starship weapons)."},"class":"21dfe84d159a1b7f","costNumeric":null,"category":"Scoundrel","treeId":"f1657b1d23a4c7dc","tags":["tech","modification","equipment","standard_action","action_economy","precision","damage_bonus","melee","ranged","sustained_damage"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"personalized-modifications","name":"Personalized Modifications","label":"Personalized Modifications","actionType":"standard","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"Tweak one powered weapon you wield for the remainder of the encounter, granting +1 equipment bonus on attack rolls and +2 equipment bonus on damage rolls with that weapon.","notes":"Tweak one powered weapon you wield for the remainder of the encounter, granting +1 equipment bonus on attack rolls and +2 equipment bonus on damage rolls with that weapon.","relatedSkills":[{"skill":"Mechanics","when":"GM may request a check for unusual powered weapons"}],"resources":["Remainder of encounter"],"requiredContext":["Powered weapon requiring an Energy Cell, Power Pack, or larger power source"],"targetHint":"One powered weapon you wield"}],"phase17TechEngineeringCleanup":{"status":"combat_action_card","owner":"AbilityCombatActionResolver","notes":"Surfaced as a manual action-economy card. Automation can be added later without inventing passive bonuses."}},"summary":"As a standard action, tune a powered weapon you wield for +1 attack and +2 damage for the encounter.","source":"Starships of the Galaxy","page":17},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.personalized_modifications","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.404Z","detectedPredicates":[]}}}
