{"_id":"ecb678c47bb2cb43","name":"Multiattack Proficiency (rifles)","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"Whenever you make multiple attacks with any type of rifle as a full attack action (see page 154 of the Saga Edition core rulebook), you reduce the penalty of your attack rolls by 2.\n\nYou can take this talent multiple times; each time you take this talent, you reduce the penalty on your attack rolls by an additional 2.","description":{"value":"Whenever you make multiple attacks with any type of rifle as a full attack action (see page 154 of the Saga Edition core rulebook), you reduce the penalty of your attack rolls by 2.\n\nYou can take this talent multiple times; each time you take this talent, you reduce the penalty on your attack rolls by an additional 2."},"class":"162d866ba36fce69","costNumeric":null,"category":"Gunslinger","treeId":"1933731cc59f8463","tags":["damage_reduction","ranged"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"choice_required","applicationScope":"persistent_selection","staticSheetPolicy":"not_a_modifier_until_choice_resolved","requiresRuntimeContext":false,"requiresSelectedChoice":true,"modifiers":[],"implementedBy":"Future progression picker + Ability Engine roll-context resolver","notes":"Reviewed in T12. This talent needs a persistent selected weapon group/exotic weapon/equivalence decision before any roll modifier can be applied safely.","phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Weapon Master/Carbineer","status":"full_attack_executor_consumed","notes":"Kept as selection-gated metadata for FullAttackExecutor/Multiattack Proficiency resolution. No passive actor modifier."}},"summary":"Whenever you make multiple attacks with any type of rifle as a full attack action (see page 154 of the Saga Edition core rulebook), you reduce the penalty of your attack rolls by 2.","source":"Legacy Era Campaign Guide","page":41},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.multiattack_proficiency_rifles","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.432Z","detectedPredicates":[]}}}
{"_id":"ece2612b7449f39a","name":"Force Reflexes","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Force Sensitivity, Starship Tactics, Force Pilot","benefit":"When activating a starship maneuver, you may spend a Force Point to reroll your Pilot check, keeping the better result. See Chapter 2 for more information on starship maneuvers.","description":"When activating a starship maneuver, you may spend a Force Point to reroll your Pilot check, keeping the better result. See Chapter 2 for more information on starship maneuvers.","costNumeric":null,"prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.443373859f1ecca3","name":"Force Pilot"}],"_source":"canonical-csv"},"treeId":"d6b4331c0e31f7e3","tags":["force","initiative","pilot","precognition","senses","vehicle"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"manual_or_runtime","applicationScope":"force_user_runtime_context","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"phase22ForceCleanup":{"phase":"T22","tree":"Sense","status":"cleaned_manual_or_future_runtime","notes":"Removed unsafe migrated static modifiers/effects. Talent requires Force-user activation, target, Force Point, suite, item, or encounter context and must not mutate actor totals passively."}},"summary":"Spend a Force Point when activating a starship maneuver to reroll the Pilot check and keep the better result.","source":"Starships of the Galaxy","page":16},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_reflexes","migratedToState":true,"migrationDate":"2026-03-08T18:22:17.432Z","detectedPredicates":[],"forceTalentCleanup":{"phase":"T22","tree":"Sense","status":"cleaned_manual_or_future_runtime"}}}}
{"_id":"ed0304eebd82042b","name":"Krath Intuition","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":{"value":"You have a natural ability to use dark-side artifacts, such as Sith talismans and alchemical weapons. Once per encounter, you may spend a Force Point to treat the damage from a Sith alchemical weapon as though you had rolled the maximum damage on the dice."},"benefit":"You have a natural ability to use dark-side artifacts, such as Sith talismans and alchemical weapons. Once per encounter, you may spend a Force Point to treat the damage from a Sith alchemical weapon as though you had rolled the maximum damage on the dice.","class":"","category":"","costNumeric":null,"treeId":"d29a7261c1be4b83","talent_tree":"Krath","source":"Knights of the Old Republic Campaign Guide","page":60,"tags":["damage","dark_side","force","force-point","once-per-encounter"],"executionModel":"ACTIVE","subType":"TALENT_ACTION","abilityMeta":{"mechanicsMode":"manual_or_runtime","applicationScope":"encounter_limited_alchemical_damage_maximization","staticSheetPolicy":"exclude","manualResolution":true,"requiresRuntimeContext":true,"usesPerEncounter":1,"modifiers":[],"notes":"Requires a Sith alchemical weapon and a Force Point spend. Maximizes that attack’s damage dice only; it does not change the weapon’s damage formula.","combatActions":[],"rules":[{"type":"RUNTIME_CONTEXT_REFERENCE","id":"krath-intuition-krath-context","label":"Krath Intuition","summary":"Once per encounter, you can spend a Force Point when using a Sith alchemical weapon to treat the weapon's damage dice as though they had rolled their maximum result."}]},"summary":"You have a natural ability to use dark-side artifacts, such as Sith talismans and alchemical weapons."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"ee2cbf6681a5a7e1","name":"Master of the Great Hunt","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","benefit":"You gain a +1 Force bonus on attack rolls and deal +1 die of damage on lightsaber attacks made against a beast with a Dark Side Score of 1+.","description":"You gain a +1 Force bonus on attack rolls and deal +1 die of damage on lightsaber attacks made against a beast with a Dark Side Score of 1+.","class":"fec1f8af44fcc35a","costNumeric":null,"category":"Jedi","treeId":"36f18f3e974feb33","tags":["dark_side","force","force_offense","light_side","lightsaber"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"combatActions":[{"id":"master-of-the-great-hunt","name":"Master of the Great Hunt","label":"Master of the Great Hunt","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"You gain a +1 Force bonus on attack rolls and deal +1 die of damage on Lightsaber attacks made against a Beast with a Dark Side Score of 1+.","notes":"You gain a +1 Force bonus on attack rolls and deal +1 die of damage on Lightsaber attacks made against a Beast with a Dark Side Score of 1+.","relatedSkills":[{"skill":"Attack Roll"}],"resources":["Lightsaber context"],"requiredContext":[],"targetHint":"","spendAction":false,"ruleData":{}},{"id":"master-of-the-great-hunt-beast-target","name":"Master of the Great Hunt","label":"Master of the Great Hunt","actionType":"passive","cost":0,"manualResolution":true,"resolutionMode":"reference","useLabel":"Reference","description":"Against beast targets, opt in for +1 attack and +1 weapon die damage. Confirm the target is a beast.","notes":"Against beast targets, opt in for +1 attack and +1 weapon die damage. Confirm the target is a beast.","relatedSkills":[],"resources":["+1 attack","+1 weapon die vs beasts"],"requiredContext":["Target is a beast"],"targetHint":"","spendAction":false,"ruleData":{}}],"rules":[{"type":"