{"_id":"f7ddece8fd2141f5","name":"One for the Team","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"Deployment Tactics.","benefit":"As a Reaction, you can choose to take one-half or all of the damage dealt to an adjacent ally by a single attack. Similarly, as a Reaction, an adjacent ally can choose to take one-half or all of the damage dealt to you by a single attack (even if they don't have this Talent).","description":{"value":"As a Reaction, you can choose to take one-half or all of the damage dealt to an adjacent ally by a single attack. Similarly, as a Reaction, an adjacent ally can choose to take one-half or all of the damage dealt to you by a single attack (even if they don't have this Talent)."},"class":"30b9cd24b80ebf46","costNumeric":null,"category":"Officer","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","uuid":"Compendium.foundryvtt-swse.talents.Item.8a5f8b5c9b9fabaf","name":"Deployment Tactics"}],"_source":"canonical-csv"},"treeId":"9253ace716c3e966","tags":["positioning","support"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"mechanicsMode":"combat_action","applicationScope":"social_commander_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"modifiers":[],"implementedBy":"Follower/dependent-actor subsystem or GM/player managed","notes":"Ally/follower/minion effects need dependent actor, adjacency, line-of-sight, attack, or action timing context; they should not mutate owner static totals.","combatActions":[{"id":"one-for-the-team","name":"One for the Team","label":"One for the Team","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"When an adjacent ally takes damage from a single attack, choose to take half or all of that damage. An adjacent ally can likewise take half/all damage dealt to you even if they do not have this talent.","notes":"When an adjacent al