":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"ff4ed2e6add735d8","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"af8bc349d1c9ce63","name":"Assault Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Military Tactics","prerequisites":"Trained in Initiative","benefit":"You can use the , Deployment Tactics, or Field Tactics Talent as a Swift Action, instead of a Move Action (provided you have the Talent in question). Reference Book: Star Wars Saga Edition Unknown Regions During the first round of combat in an encounter (after the Surprise Round, if any), you can take your turn before any of your allies, but you must use either the Share Talent Prestige Class ability or a Talent from one of the following Talent Trees as part of your turn: Commando Talent Tree, Leadership Talent Tree, or Military Tactics Talent Tree. On the subsequent round, you return to your normal place in the Initiative Order. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisite: When you use the Talent on an enemy, the target takes a cumulative -1 penalty to its Reflex Defense each time it is damaged by one of your allies (maximum -5 penalty). This penalty applies until the end of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide As a Swift Action, once per encounter, you can grant bonus Hit Points equal to 5 + one-half your Character Level to allies within 20 squares of you and in your line of sight. Damage is subtracted from the bonus Hit Points first, and any bonus Hit Points remaining at the end of the encounter go away. Bonus Hit Points from multiple sources do not stack. Reference Book: Star Wars Saga Edition Unknown Regions Your tactics confuse enemy commanders and tacticians that can see or otherwise observe your forces in action, such as when using sensors. After using the Share Talent special quality, make a Knowledge (Tactics) check as a Free Action. The result replaces the DC of any Talents that use Knowledge (Tactics) from the Military Tactics Talent Tree used against your or your allies. Reference Book: Star Wars Saga Edition Unknown Regions If you have already used a Talent in an encounter before granting the same Talent to an ally with your Share Talent special quality in the same encounter, any character who benefits from Share Talent gains one of the following bonuses when using that talent (if the Talent can be affected by more than one effect, the character using the Talent selects the desired effect): Reduce the Talent's DC by 5. Gain an additional +2 bonus to any bonus to attack, Defense, or damage used by the Talent. Reduce the amount of damage taken by the character through the use of the Talent by 10 points. Reference Book: Star Wars Saga Edition Unknown Regions","description":"You can use the , Deployment Tactics, or Field Tactics Talent as a Swift Action, instead of a Move Action (provided you have the Talent in question). Reference Book: Star Wars Saga Edition Unknown Regions During the first round of combat in an encounter (after the Surprise Round, if any), you can take your turn before any of your allies, but you must use either the Share Talent Prestige Class ability or a Talent from one of the following Talent Trees as part of your turn: Commando Talent Tree, Leadership Talent Tree, or Military Tactics Talent Tree. On the subsequent round, you return to your normal place in the Initiative Order. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisite: When you use the Talent on an enemy, the target takes a cumulative -1 penalty to its Reflex Defense each time it is damaged by one of your allies (maximum -5 penalty). This penalty applies until the end of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide As a Swift Action, once per encounter, you can grant bonus Hit Points equal to 5 + one-half your Character Level to allies within 20 squares of you and in your line of sight. Damage is subtracted from the bonus Hit Points first, and any bonus Hit Points remaining at the end of the encounter go away. Bonus Hit Points from multiple sources do not stack. Reference Book: Star Wars Saga Edition Unknown Regions Your tactics confuse enemy commanders and tacticians that can see or otherwise observe your forces in action, such as when using sensors. After using the Share Talent special quality, make a Knowledge (Tactics) check as a Free Action. The result replaces the DC of any Talents that use Knowledge (Tactics) from the Military Tactics Talent Tree used against your or your allies. Reference Book: Star Wars Saga Edition Unknown Regions If you have already used a Talent in an encounter before granting the same Talent to an ally with your Share Talent special quality in the same encounter, any character who benefits from Share Talent gains one of the following bonuses when using that talent (if the Talent can be affected by more than one effect, the character using the Talent selects the desired effect): Reduce the Talent's DC by 5. Gain an additional +2 bonus to any bonus to attack, Defense, or damage used by the Talent. Reduce the amount of damage taken by the character through the use of the Talent by 10 points. Reference Book: Star Wars Saga Edition Unknown Regions","class":"Officer","costNumeric":null,"category":"Officer","tree":"Military Tactics","treeId":"9253ace716c3e966","tags":["action-economy","ambush","controller","damage-reduction","defender","feat-chain","force","force-control","force-defense","force-offense","leader","leadership","mobility","positioning","scaling","scout","skills","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.assault_tactics"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d9fe8a0c76d845d4"}}},{"_id":"537f424c2d3fffcf","name":"Born Leader","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Naval Officer","prerequisites":"","benefit":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","description":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","class":"Noble","costNumeric":null,"category":"Noble","tree":"Naval Officer","treeId":"057a978a7dc1d5a7","tags":["armor","defender","noble","striker","support","sustained-damage"]},"effects":[{"_id":"f9275c38-3cb5-4ab3-aaa5-25e5722dcdd3","name":"Born Leader","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.will","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Born Leader"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.born_leader"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.6a66ba6e0834dd6f"}}},{"_id":"65e306ea8e6f2e32","name":"Coordinate","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Leadership","prerequisites":null,"benefit":"All allies in line of sight gain +1 when using aid another (maximum +5).","description":"All allies gain +1 when using Aid Another, up to +5.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Leadership","canonicalName":"Coordinate","canonicalTree":"Bab +12","treeId":"5964237d22681dc0","tags":["noble","striker"]},"effects":[{"_id":"25b28077-6a3c-43d8-97ba-a128e768f614","name":"Coordinate","icon":"icons/svg/handshake.svg","changes":[{"key":"system.actions.aidAnother","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Coordinate"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.coordinate"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a52044feeab3fe05"}}},{"_id":"ad3348b92190d015","name":"Shift Defense I","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Military Tactics","prerequisites":"","benefit":"As a Swift Action, you can take a -5 penalty to one Defense (Reflex, Fortitude, or Will) to gain a +2 competence bonus to another Defense until the start of your next turn. Prerequisites: , I As a Swift Action, you can gain a +5 competence bonus to one Defense (Reflex, Fortitude, or Will) by taking a -5 penalty to your other two Defenses.","description":"As a Swift Action, you can take a -5 penalty to one Defense (Reflex, Fortitude, or Will) to gain a +2 competence bonus to another Defense until the start of your next turn. Prerequisites: , I As a Swift Action, you can gain a +5 competence bonus to one Defense (Reflex, Fortitude, or Will) by taking a -5 penalty to your other two Defenses.","class":"Officer","costNumeric":null,"category":"Officer","tree":"Military Tactics","treeId":"9253ace716c3e966","tags":["action-economy","defender","mobility","striker"]},"effects":[{"_id":"ba3b7c8c-b416-4808-b91c-722e90b8c6b8","name":"Shift Defense I","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.flexible","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Shift Defense I"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.shift_defense_i"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.cb981391d4d16c59"}}},{"_id":"7fcceab69557439d","name":"Trust","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Leadership","prerequisites":"Born Leader, Coordinate","benefit":"Give up your standard action to grant allies an extra action on their next turn.","description":"Give up a standard action to grant all allies an extra action next turn.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Leadership","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.born_leader"},{"type":"talent","id":"swse.talent.coordinate"}],"_source":"ca