svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"c79ce6adfda8c6c2","name":"Biotech Adept","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Yuuzhan Vong Biotech","prerequisites":null,"benefit":"Reroll Knowledge (life sciences) or Treat Injury checks to use or repair biotech.","description":"Reroll Knowledge (life sciences) or Treat Injury checks to use or repair biotech.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Yuuzhan Vong Biotech","treeId":"33c3210fcac8c664","tags":["mechanics","scoundrel","skills"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.biotech_adept"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a86559a808738c98"}}},{"_id":"d9b97dab5d666b01","name":"Spacehound","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Spacer","prerequisites":"","benefit":"You gain a +1 bonus on attack rolls made while aboard a Starship. This bonus applies to attacks made with Starship Weapons, as well as personal weapons used aboard a Starship. Prerequisite: Whenever you roll a Natural 20 on an attack roll made aboard a Starship, you gain one temporary Force Point. If the Force Point is not used before the end of the encounter, it is lost. This Talent works with both Weapon Systems and personal weapons used aboard a Starship. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Starship Raider When adjacent to an obstacle or barrier, you gain a +2 Cover bonus to your Reflex Defense. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Starship Raider Whether you are taking on military targets on behalf of a resistance movement or you are out for personal gain, you are experienced at raiding Starships and similar targets. You can use each if the following Actions once per encounter: Clear a Path: Your attack forces an enemy to alter course or move out of your way. You must be fighting aboard a Starship to use this Action. As a Standard Action, make a ranged attack. If the attack hits, on its next turn your target must move its Speed to a square that is not adjacent to you. If the target is an enemy Starfighter engaged in a Dogfight, the target instead must attempt to disengage from the Dogfight. Covering Fire: You squeeze off several shots as you escape pursuing enemies. As a Full-Round Action, if you are the Pilot of a Vehicle, you may move the Vehicle up to twice its Speed and make a single ranged attack with one of the Pilot-controlled Vehicle Weapons at any point during that movement. If you hit and deal damage to a Vehicle with this attack, the target Vehicle takes a -2 penalty to attack rolls against your Vehicle until the end of your turn. Disabling Fire: Make a ranged attack with your Vehicle Weapon. If you make this attack against a Vehicle and hit and deal damage, you can choose one of the following to take effect until the end of your next turn: One of the target's Vehicle Weapons ceases to function. The target's Shield Rating is reduced to 0. The target's Hyperdrive is disabled. The target's Speed is reduced to 2 squares (Character Scale). Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Stellar Warrior Once per encounter, while on or in a Vehicle, you can move up to one-half your speed, or move the Vehicle up to one-half its speed if you are the Pilot, as a Swift Action. This movement does not provoke Attacks of Opportunity.","description":"You gain a +1 bonus on attack rolls made while aboard a Starship. This bonus applies to attacks made with Starship Weapons, as well as personal weapons used aboard a Starship. Prerequisite: Whenever you roll a Natural 20 on an attack roll made aboard a Starship, you gain one temporary Force Point. If the Force Point is not used before the end of the encounter, it is lost. This Talent works with both Weapon Systems and personal weapons used aboard a Starship. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Starship Raider When adjacent to an obstacle or barrier, you gain a +2 Cover bonus to your Reflex Defense. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Starship Raider Whether you are taking on military targets on behalf of a resistance movement or you are out for personal gain, you are experienced at raiding Starships and similar targets. You can use each if the following Actions once per encounter: Clear a Path: Your attack forces an enemy to alter course or move out of your way. You must be fighting aboard a Starship to use this Action. As a Standard Action, make a ranged attack. If the attack hits, on its next turn your target must move its Speed to a square that is not adjacent to you. If the target is an enemy Starfighter engaged in a Dogfight, the target instead must attempt to disengage from the Dogfight. Covering Fire: You squeeze off several shots as you escape pursuing enemies. As a Full-Round Action, if you are the Pilot of a Vehicle, you may move the Vehicle up to twice its Speed and make a single ranged attack with one of the Pilot-controlled Vehicle Weapons at any point during that movement. If you hit and deal damage to a Vehicle with this attack, the target Vehicle takes a -2 penalty to attack rolls against your Vehicle until the end of your turn. Disabling Fire: Make a ranged attack with your Vehicle Weapon. If you make this attack against a Vehicle and hit and deal damage, you can choose one of the following to take effect until the end of your next turn: One of the target's Vehicle Weapons ceases to function. The target's Shield Rating is reduced to 0. The target's Hyperdrive is disabled. The target's Speed is reduced to 2 squares (Character Scale). Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Stellar Warrior Once per encounter, while on or in a Vehicle, you can move up to one-half your speed, or move the Vehicle up to one-half its speed if you are the Pilot, as a Swift Action. This movement does not provoke Attacks of Opportunity.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Spacer","treeId":"5ea8c79492d40713","tags":["action-economy","controller","damage-reduction","defender","force","force-control","force-defense","force-offense","mobility","positioning","ranged","scaling","scoundrel","shields","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.spacehound"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.fe0c3a64ca460542"}}},{"_id":"cffb455a92f21d45","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":1,"flatDamageFormula":"1d4","useFlat":true}}}},{"_id":"6e998cec25740609","name":"Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d6+1","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":500,"equipped":true,"description":"<p>The standard sidearm used throughout the galaxy. Reliable, common, and effective at close to medium range.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":500,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":2,"flatDamageFormula":"3d6+1","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Devaronian","Nonheroic Level":0,"Class Levels":{"Scoundrel":3},"Destiny Points":0,"Force Points":1,"Dark Side Points":0,"Initiative":6,"Senses":"Perception +2","Languages":["Basic","Devaronese","Huttese","Shyriiwook (understand only)"],"Unassigned Languages":0,"Reflex Defense":15,"Flat-Footed Defense":15,"Fortitude Defense":12,"Will Defense":16,"Hit Points":22,"Damage Threshold":12,"Speed":"6 Squares","Melee Weapons":"Unarmed +1 (1d4)","Ranged Weapons":"Blaster Pistol +2 (3d6+1)","Base Attack Bonus":2,"Grapple":2,"Attack Options":["Point-Blank Shot"],"Special Actions":["Biotech Specialist","Natural Curiosity","Tech Specialist","Spacehound"],"Force Powers":[],"Force Secrets":[],"Force Techniques":[],"Strength":8,"Dexterity":10,"Constitution":8,"Intelligence":14,"Wisdom":12,"Charisma":10,"Talents":["Talents : Biotech Adept","Spacehound"],"Feats":["Feats : Biotech Specialist","Point-Blank Shot","Skill Focus (Deception)","Skill Focus (Mechanics)","Tech Specialist","Weapon Proficiency (Pistols)","Weapon Proficiency (Rifles)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Deception","Knowledge (Technology)","Mechanics","Pilot","Treat Injury","must take 