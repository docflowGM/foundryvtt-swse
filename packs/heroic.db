"f1ae4da13a61d805","name":"Elder's Knowledge","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"","prerequisite":"","special":"","normalText":"","sourcebook":"Unknown Regions","page":20,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Substitute a <a class=\"mw-redirect\" href=\"/wiki/Knowledge_(Social_Sciences)\" title=\"Knowledge (Social Sciences)\">Knowledge (Social Sciences)</a> or <a class=\"mw-redirect\" href=\"/wiki/Knowledge_(Galactic_Lore)\" title=\"Knowledge (Galactic Lore)\">Knowledge (Galactic Lore)</a> skill check for a <a href=\"/wiki/Wisdom\" title=\"Wisdom\">Wisdom</a>-related <a class=\"mw-redirect\" href=\"/wiki/Skill_Check\" title=\"Skill Check\">Skill Check</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.6ba02f4dd4c3bfe5"}}},{"_id":"4ba526e6c009a646","name":"Improved Damage Threshold","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Your damage threshold increases by 5.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["defender","non-force","scout","soldier","striker"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"<a class=\"mw-redirect\" href=\"/wiki/Damage_Threshold\" title=\"Damage Threshold\">Damage Threshold</a> increases by 5 points."}},"effects":[{"name":"Improved Damage Threshold","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.damageThreshold","mode":2,"value":"5","priority":20}],"transfer":true}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.96666de28ba99b64"}}},{"_id":"eaeb6f5fba850aea","name":"Linguist","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a number of additional Languages equal to 1 + your Intelligence modifier (Minimum 1). If your Intelligence modifier increases so does the number of languages granted by this Feat.","prerequisite":"Int 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["feat-chain","leader","noble","non-force","striker"],"bonus_feat_for":["Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain bonus <a href=\"/wiki/Languages\" title=\"Languages\">Languages</a> equal to 1 + your <a href=\"/wiki/Intelligence\" title=\"Intelligence\">Intelligence</a> modifier (minimum 1)."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"int","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.5afd91fb081e576b"}}},{"_id":"7c1555c67aa6744d","name":"Pin","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may attempt to pin a grappled opponent. If successful, the target is immobilized until they escape the grapple.","prerequisite":"Int 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"<a class=\"mw-redirect\" href=\"/wiki/Grappled\" title=\"Grappled\">Grappled</a> opponent is <a class=\"mw-redirect\" href=\"/wiki/Pinned\" title=\"Pinned\">Pinned</a> for one round, can't move, and and loses its <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{