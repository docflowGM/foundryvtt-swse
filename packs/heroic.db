"striker"],"bonus_feat_for":["Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You can make custom modifications to Armor, Weapons, Vehicles, Droids, and Devices."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"745a5686d6f21e8c"}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.42e2404790756700"}}},{"_id":"19b9f2e41a762936","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"d2102f4acada0059","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"3299c5de61b3b0e7","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"f8d8a4a99b0e8031","name":"Gimmick","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Slicer","prerequisites":"Trained in Use Computer","benefit":"You may choose to reroll any Use Computer check made to Improve Access on a computer, keeping the better of the two results. You can substitute your Use Computer Skill for any Gather Information check as long as you have access to a computer network. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You can use your Use Computer modifier in place of your Deception modifier to create a deceptive appearance with forged electronic documents. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You excel at causing havoc with computers and electronics. As a Standard Action, you can lock down a computer terminal by making a Use Computer check, making it potentially difficult for anyone else to access. That computer is considered Unfriendly to anyone other than you who attempts to use it, and the result of your Use Computer check replaces the computer's Will Defense on an attempt to change its Attitude. This effect ends if anyone else succeeds in adjusting the computer's Attitude to Indifferent. You cannot Take 20 on this Use Computer check. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You are an expert in electronic security. When you make a Mechanics check to Disable Device, you can do so without the help of a Security Kit. Additionally, something goes wrong only when you fail the Mechanics check by 10 or more. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: When attempting to damage or disrupt a computer system, you may make a DC 20 Use Computer check. If successful, the computer moves -5 steps on the Condition Track and becomes disabled. If working remotely from another terminal or device, the DC increases to 30. Homebrew Reference Book: New Republic Campaign Guide When making a Use Computer check to Access Information, Disable or Erase Program, Improve Access, or Issue Routine Command, you may make a DC 25 Use Computer check before making the command. If successful, the effects of Cover Tracks are automatically applied regardless of the actual check DC. Homebrew Reference Book: New Republic Campaign Guide You may grant a +2 bonus to a computer's Will Defense against Use Computer checks to Improve Access. If the attacking slicer fails their Use Computer check by 5 or more, the Attitude of the computer moves 2 steps toward Hostile (Instead of the normal 1 step towards Hostile).","description":"You may choose to reroll any Use Computer check made to Improve Access on a computer, keeping the better of the two results. You can substitute your Use Computer Skill for any Gather Information check as long as you have access to a computer network. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You can use your Use Computer modifier in place of your Deception modifier to create a deceptive appearance with forged electronic documents. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You excel at causing havoc with computers and electronics. As a Standard Action, you can lock down a computer terminal by making a Use Computer check, making it potentially difficult for anyone else to access. That computer is considered Unfriendly to anyone other than you who attempts to use it, and the result of your Use Computer check replaces the computer's Will Defense on an attempt to change its Attitude. This effect ends if anyone else succeeds in adjusting the computer's Attitude to Indifferent. You cannot Take 20 on this Use Computer check. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You are an expert in electronic security. When you make a Mechanics check to Disable Device, you can do so without the help of a Security Kit. Additionally, something goes wrong only when you fail the Mechanics check by 10 or more. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: When attempting to damage or disrupt a computer system, you may make a DC 20 Use Computer check. If successful, the computer moves -5 steps on the Condition Track and becomes disabled. If working remotely from another terminal or device, the DC increases to 30. Homebrew Reference Book: New Republic Campaign Guide When making a Use Computer check to Access Information, Disable or Erase Program, Improve Access, or Issue Routine Command, you may make a DC 25 Use Computer check before making the command. If successful, the effects of Cover Tracks are automatically applied regardless of the actual check DC. Homebrew Reference Book: New Republic Campaign Guide You may grant a +2 bonus to a computer's Will Defense against Use Computer checks to Improve Access. If the attacking slicer fails their Use Computer check by 5 or more, the Attitude of the computer moves 2 steps toward Hostile (Instead of the normal 1 step towards Hostile).","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Slicer","treeId":"64874e65579e4cf4","tags":["action-economy","condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","leader","mechanics","mobility","scaling","scoundrel","skills","slicing","social","striker","support","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.gimmick"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8d8937a416fc0d81"}}},{"_id":"69f20999c3df27b1","name":"Hyperdriven","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Spacer","prerequisites":null,"benefit":"Once per day, add your class level to an attack, skill, or ability check.","description":"Once per day, add your class level to an attack roll, skill check, or ability check.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Spacer","treeId":"5ea8c79492d40713","tags":["scoundrel","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hyperdriven"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.29f73c36cabdeaf5"}}},{"_id":"3668f6fc60c0f2fa","name":"Knack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fortune","prerequisites":"","benefit":"Once per day, you can reroll an attack roll and take the better result. You can select this Talent multiple times; each time you select this Talent, you can use it one additional time per day. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot You are possessed of incredible luck and an uncanny ability to succeed where others would fail. You can use each of the following actions once per encounter as a Standard Action: Elude Enemy: Make a single melee or ranged attack against any target within your Range. If you damage the target, you gain a +2 bonus to your Reflex Defense against this target until the beginning of your next turn. Escape: Make a single melee or ranged attack against any target within your Range. If that target successfully damages you before the start of your next turn, you can immediately move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Make your Own Luck: Make a single melee or ranged attack against any target within your Range. If you miss this target, you gain a +2 bonus on your next attack roll. Reference Book: Star Wars Saga Edition Scum and Villainy Once per encounter, as a Reaction, you become immune to all Mind-Affecting effects until the end of your next turn (you can choose to ignore this for beneficial effects). Any Mind-Affecting effects currently afflicting you are also removed, though you can choose to retain any beneficial effects you currently have. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisite: A successful hit against you is mitigated by an item you just happen to be wearing or carrying, or glances off your armor or clothing in just the right way. Once per encounter, as a Reaction, you can negate the damage from a single attack that would normally reduce you to 0 Hit Points. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot When making a ranged attack against a target with Cover, you can choose to reduce the benefit of that target's Cover by one step, from Improved Cover to Cover, or Cover to no Cover. You deal only half damage with this attack. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can consider any single d20 roll of 16 or higher to be a Natural 20. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can reroll the damage of one attack, keeping the better of the two results. Gambler's Fortune Talent data created by Sterling Hershey (source). Prerequisites: , Trained in Chosen Skill Select one of the following Skills: Knowledge (Any), Mechanics, Perception, or Use Computer. When making a reroll for that Skill, you may keep the better result.","description":"Once per day, you can reroll an attack roll and take the better result. You can select this Talent multiple times; each time you select this Talent, you can use it one additional time per day. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot You are possessed of incredible luck and an uncanny ability to succeed where others would fail. You can use each of the following actions once per encounter as a Standard Action: Elude Enemy: Make a single melee or ranged attack against any target within your Range. If you damage the target, you gain a +2 bonus to your Reflex Defense against this target until the beginning of your next turn. Escape: Make a single melee or ranged attack against any target within your Range. If that target successfully damages you before the start of your next turn, you can immediately move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Make your Own Luck: Make a single melee or ranged attack against any target within your Range. If you miss this target, you gain a +2 bonus on your next attack roll. Reference Book: Star Wars Saga Edition Scum and Villainy Once per encounter, as a Reaction, you become immune to all Mind-Affecting effects until the end of your next turn (you can choose to ignore this for beneficial effects). Any Mind-Affecting effects currently afflicting you are also removed, though you can choose to retain any beneficial effects you currently have. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisite: A successful hit against you is mitigated by an item you just happen to be wearing or carrying, or glances off your armor or clothing in just the right way. Once per encounter, as a Reaction, you can negate the damage from a single attack that would normally reduce you to 0 Hit Points. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot When making a ranged attack against a target with Cover, you can choose to reduce the benefit of that target's Cover by one step, from Improved Cover to Cover, or Cover to no Cover. You deal only half damage with this attack. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can consider any single d20 roll of 16 or higher to be a Natural 20. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can reroll the damage of one attack, keeping the better of the two results. Gambler's Fortune Talent data created by Sterling Hershey (source). Prerequisites: , Trained in Chosen Skill Select one of the following Skills: Knowledge (Any), Mechanics, Perception, or Use Computer. When making a reroll for that Skill, you may keep the better result.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Fortune","treeId":"cee9b9398682b7d0","tags":["action-economy","armor","controller","damage-reduction","defender","mechanics","melee","mobility","perception","positioning","ranged","scaling","scoundrel","skills","slicing","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.knack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ac6baadb9d65ff7f"}}},{"_id":"7033e90790c96fb0","name":"Master Slicer","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Slicer","prerequisites":"Gimmick","benefit":"Reroll Use Computer checks to improve access to computers.","description":"Reroll Use Computer checks to improve access.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Slicer","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.gimmick"}],"_source":"canonical-csv"},"treeId":"64874e65579e4cf4","tags":["feat-chain","scaling","scoundrel","talent-chain"]},"effects":[{"_id":"0fb45306-0091-4a1e-94f0-46b013c5b671","name":"Master Slicer","icon":"icons/svg/laptop.svg","changes":[{"key":"system.skills.useComputer.misc","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Master Slicer"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.master_slicer"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.bae4b0a8a3554cca"}}},{"_id":"7ad01980c23601f5","name":"Trace","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Slicer","prerequisites":null,"benefit":"Substitute Use Computer for Gather Information if you have computer access.","description":"Use Computer replaces Gather Information when accessing networks.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Slicer","treeId":"64874e65579e4cf4","tags":["scoundrel"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.trace"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.54065380bb20e8d8"}}},{"_id":"5a9126cc9004dbe9","name":"Unarmed ( Energy-Binding Prosthesis )","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d6+6","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":8,"flatDamageFormula":"1d6+6","useFlat":true}}}},{"_id":"dc6cf7817308cfc2","name":"Vibroblade","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d6+6","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range