-swse.feats.e896798c6d194345"}}},{"_id":"cdc962eadd8c3e86","name":"Point-Blank Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on ranged attacks and damage against foes within Point-Blank <a class=\"mw-redirect\" href=\"/wiki/Range\" title=\"Range\">Range</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.05459ac4d439f229"}}},{"_id":"c8ef9bbad0734ec5","name":"Precise Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You do not take the -5 penalty for firing into melee.","prerequisite":"Point Blank Shot","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","melee","non-force","precision","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No -5 penalty for shooting into melee."}},"effects":[{"_id":"77e126ab-16c9-4116-9d67-b5550c007b1b","name":"Precise Shot","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Precise Shot","effectType":"passive_effect","flagType":"Precise Shot"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c180eee7d3bc29b2"}}},{"_id":"dd054860d85379ed","name":"Running Attack","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may make a single melee or ranged attack at any point during a move action taken on your turn.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"ta