-chain","melee","non-force","precision","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No -5 penalty for shooting into melee."}},"effects":[{"_id":"77e126ab-16c9-4116-9d67-b5550c007b1b","name":"Precise Shot","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Precise Shot","effectType":"passive_effect","flagType":"Precise Shot"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c180eee7d3bc29b2"}}},{"_id":"60ab9fcc904912cd","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"233e5922f2cdf9a2","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"a67a2e68c57ccbd3","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"f54f7ff1aa41593c","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"62fd029a17dfc689","name":"Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"d4f445f11e03ee8a","name":"Battle Analysis","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":"Trained in Initiative","benefit":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus. When you use the Mechanics skill to Handle Explosives, the explosion deals +2 dice of damage. You may take this Talent multiple times; its effects stack. You can distract opponents and convince them that you are the most tempting (or most dangerous) target in the area. As a Swift Action, make a Persuasion check and compare the result to the Will Defense of all opponents within line of sight. If the check result exceeds an opponent's Will Defense, that opponent cannot attack any character within 6 squares of you until the start of your next turn as long as you do not have Cover against that opponent. (The affected opponent may still attack you, however.) If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per round, you may spend a Swift Action to shield a single adjacent ally from attacks, taking the damage and suffering the ill effects in your ally's stead. Until the start of your next turn, any attack made against the protected ally targets you instead. You may elect not to shield your protected ally against a given attack, provided the decision is made before the attack roll is made. If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per day as a Swift Action, you can move +5 steps on the Condition Track. This does not remove any Persistent Conditions that may be affecting you. This Talent does not affect the Condition Track of a Vehicle. You can select this talent multiple times. Each time you select this Talent, you can use it one additional time per day. You can catch a Second Wind one extra time per day. If you have this Talent and the Extra Second Wind feat, you can catch your Second Wind a total of three times per day. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisite: Whenever you have the benefit of Cover, you can spend two Swift Actions to treat it as Improved Cover until the start of your next turn. Reference Book: Star Wars Saga Edition Threats of the Galaxy Prerequisite: When one or more allies uses the Aid Another Action to give you a bonus to your attack roll, you gain a circumstance bonus equal to the total bonus provided to your damage roll. Homebrew Reference Book: Legacy of the Force Sourcebook You add an additional die of damage when attacking with any weapon that has a Burst radius.","description":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus. When you use the Mechanics skill to Handle Explosives, the explosion deals +2 dice of damage. You may take this Talent multiple times; its effects stack. You can distract opponents and convince them that you are the most tempting (or most dangerous) target in the area. As a Swift Action, make a Persuasion check and compare the result to the Will Defense of all opponents within line of sight. If the check result exceeds an opponent's Will Defense, that opponent cannot attack any character within 6 squares of you until the start of your next turn as long as you do not have Cover against that opponent. (The affected opponent may still attack you, however.) If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per round, you may spend a Swift Action to shield a single adjacent ally from attacks, taking the damage and suffering the ill effects in your ally's stead. Until the start of your next turn, any attack made against the protected ally targets you instead. You may elect not to shield your protected ally against a given attack, provided the decision is made before the attack roll is made. If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per day as a Swift Action, you can move +5 steps on the Condition Track. This does not remove any Persistent Conditions that may be affecting you. This Talent does not affect the Condition Track of a Vehicle. You can select this talent multiple times. Each time you select this Talent, you can use it one additional time per day. You can catch a Second Wind one extra time per day. If you have this Talent and the Extra Second Wind feat, you can catch your Second Wind a total of three times per day. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisite: Whenever you have the benefit of Cover, you can spend two Swift Actions to treat it as Improved Cover until the start of your next turn. Reference Book: Star Wars Saga Edition Threats of the Galaxy Prerequisite: When one or more allies uses the Aid Another Action to give you a bonus to your attack roll, you gain a circumstance bonus equal to the total bonus provided to your damage roll. Homebrew Reference Book: Legacy of the Force Sourcebook You add an additional die of damage when attacking with any weapon that has a Burst radius.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Commando","treeId":"798ed0945cbdac1c","tags":["action-economy","battlefield-control","burst-damage","condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","mechanics","mobility","piloting","positioning","ranged","scaling","shields","skills","social","soldier","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.battle_analysis"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7df2e8e4f18dc909"}}},{"_id":"f4e4a7b65725b756","name":"Deployment Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Military Tactics","prerequisites":"","benefit":"You know how to use existing terrain to your best advantage. By using a Move Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, you and all allies within 10 squares of you can use whatever Cover is available to gain a +10 Cover bonus to Reflex Defense (instead of the normal +5 Cover bonus). Allies must be able to hear and understand you to gain this benefit, and the bonus lasts until the start of your next turn. This Talent provides no benefit to anyone who doesn't have Cover. This is a Mind-Affecting effect. Prerequisite: As a Reaction, you can choose to take one-half or all of the damage dealt to an adjacent ally by a single attack. Similarly, as a Reaction, an adjacent ally can choose to take one-half or all of the damage dealt to you by a single attack (even if they don't have this Talent). Prerequisites: , Field Tactics An Officer learns to counter the tactics of their enemies. As a Standard Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, opponents in your line of sight lose all competence, insight, and morale bonuses on attack rolls, as well as any dodge bonuses to Reflex Defense, until the start of your next turn. If one or more enemy Officers are within your line of sight, the highest level Officer among them can attempt to Oppose your Knowledge (Tactics) check as a Reaction. If their Skill Check result is higher than yours, your attempt to Outmaneuver your opponents fails. As a Swift Action, you can take a -2 penalty to one Defense (Reflex, Fortitude, or Will) to gain a +1 competence bonus to another Defense until the start of your next turn.","description":"You know how to use existing terrain to your best advantage. By using a Move Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, you and all allies within 10 squares of you can use whatever Cover is available to gain a +10 Cover bonus to Reflex Defense (instead of the normal +5 Cover bonus). Allies must be able to hear and understand you to gain this benefit, and the bonus lasts until the start of your next turn. This Talent provides no benefit to anyone who doesn't have Cover. This is a Mind-Affecting effect. Prerequisite: As a Reaction, you can choose to take one-half or all of the damage dealt to an adjacent ally by a single attack. Similarly, as a Reaction, an adjacent ally can choose to take one-half or all of the damage dealt to you by a single attack (even if they don't have this Talent). Prerequisites: , Field Tactics An Officer learns to counter the tactics of their enemies. As a Standard Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, opponents in your line of sight lose all competence, insight, and morale bonuses on attack rolls, as well as any dodge bonuses to Reflex Defense, until the start of your next turn. If one or more enemy Officers are within your line of sight, the highest level Officer among them can attempt to Oppose your Knowledge (Tactics) check as a Reaction. If their Skill Check result is higher than yours, your attempt to Outmaneuver your opponents fails. As a Swift Action, you can take a -2 penalty to one Defense (Reflex, Fortitude, or Will) to gain a +1 competence bonus to another Defense until the start of your next turn.","class":"Officer","costNumeric":null,"category":"Officer","tree":"Military Tactics","treeId":"9253ace716c3e966","tags":["action-economy","controller","defender","evasion","leader","mobility","positioning","scout","skills","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deployment_tactics"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8a5f8b5c9b9fabaf"}}},{"_id":"a01c875b4d4fc6ef","name":"Field Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Military Tactics","prerequisites":"Deployment Tactics, DC 15 Tactics","benefit":"Allies within 10 squares gain a +10 cover bonus if they are in cover until your next turn.","description":"Allies in cover gain +10 cover bonus until your next turn.","class":"Officer","costNumeric":null,"category":"Officer","tree":"Military Tactics","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.deployment_tactics"}],"_source":"canonical-csv"},"treeId":"9253ace716c3e966","tags":["feat-chain","positioning","striker","talent-chain"]},"effects":[{"_id":"283d3697-cb75-47ef-8269-fe14c8b2e141","name":"Field Tactics","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.cover.bonus","mode":2,"value":"10"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Field Tactics"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.field_tactics"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5bdbf0148a6eb7b0"}}},{"_id":"a470e056f71d41dc","name":"Indomitable","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":null,"benefit":"Once per day, move +5 steps up the condition track (not persistent conditions); may be taken multiple times.","description":"","class":"Soldier","costNumeric":null,"category":"Soldier","treeId":"798ed0945cbdac1c","tree":"Commando","tags":["condition-removal","controller","mobility","scaling","soldier","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.indomitable"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.b8aaf500d3069938"}}},{"_id":"97c919b85a34e8fe","name":"Juggernaut","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Armor Specialist","prerequisites":"Armored Defense","benefit":"Armor does not reduce speed or distance moved.","description":"Armor does not reduce your speed or distance moved.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Armor Specialist","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.armored_defense"}],"_source":"canonical-csv"},"treeId":"17cec542331cb4e4","tags":["armor","controller","damage-reduction","defender","feat-chain","mobility","positioning","soldier","talent-chain"]},"effects":[{"_id":"bbba797f-b820-4645-90ee-c462bc890f35","name":"Juggernaut","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.armor.speedPenalty","mode":5,"value":"0"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Juggernaut","effectType":"armor_speed_penalty"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.juggernaut"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.55f4a04087dacddc"}}},{"_id":"d882d84f8e11baf7","name":"Mandalorian Advance","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mandalorian Warrior","prerequisites":null,"benefit":"Once per encounter on your turn, move your speed as a free action before taking other actions.","description":"Once per encounter on your turn, move your speed as a free action before any other action.","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Mandalorian Warrior","treeId":"4b8857716e056f62","tags":["action-economy","controller","mobility","soldier"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.mandalorian_advance"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e97df0daa156338c"}}},{"_id":"7f3ecfc259086b2f","name":"Mandalorian Ferocity","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mandalorian Warrior","prerequisites":"Dexterity 13, Weapon Proficiency (once)","benefit":"Once per encounter when making more than one attack, add one damage die for each successful hit.","description":"Once per encounter, when making more than one attack, add one extra die of damage for each successful hit.","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Mandalorian Warrior","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13}],"_source":"canonical-csv"},"treeId":"4b8857716e056f62","tags":["feat-chain","soldier","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.mandalorian_ferocity"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9d1c806bdee12411"}}},{"_id":"e2fff99ac12aa305","name":"Mandalorian Glory","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mandalorian Warrior","prerequisites":"Prerequisites: Dexterity 13","benefit":"Prerequisites: Dexterity 13, , Proficient with Armor Mandalorians wear armor constantly and learn to adjust to take an impact on the strongest section of their armor. You add your armor's Fortitude Defense bonus as an Equipment bonus to your Elite Trooper Damage Reduction (with a maximum bonus equal to your base Elite Trooper DR). Additionally, if a Lightsaber does not ignore the DR of the armor you are wearing (such as Cortosis Weave/Phrik Alloy General Template), a Lightsaber does not ignore your Elite Trooper Damage Reduction. Veteran Mandalorians know how to move on the battlefield. Once per encounter, on your turn, you can Move up to your Speed as a Free Action before any other Action. Mandalorians can be ferocious fighters. Select one weapon group or Exotic Weapon you are proficient with. Once per encounter, when making more than one attack in a round, you can add one damage die to each successful hit with the selected weapon group or Exotic Weapon. You can take this Talent more than once, selecting a different Exotic Weapon or weapon group each time. Above everything else, Mandalorians fight for glory in battle. Once per encounter, when you reduce an opponent's Hit Points to 0, you gain a +5 attack bonus with your next attack roll during the same encounter.","description":"Prerequisites: Dexterity 13, , Proficient with Armor Mandalorians wear armor constantly and learn to adjust to take an impact on the strongest section of their armor. You add your armor's Fortitude Defense bonus as an Equipment bonus to your Elite Trooper Damage Reduction (with a maximum bonus equal to your base Elite Trooper DR). Additionally, if a Lightsaber does not ignore the DR of the armor you are wearing (such as Cortosis Weave/Phrik Alloy General Template), a Lightsaber does not ignore your Elite Trooper Damage Reduction. Veteran Mandalorians know how to move on the battlefield. Once per encounter, on your turn, you can Move up to your Speed as a Free Action before any other Action. Mandalorians can be ferocious fighters. Select one weapon group or Exotic Weapon you are proficient with. Once per encounter, when making more than one attack in a round, you can add one damage die to each successful hit with the selected weapon group or Exotic Weapon. You can take this Talent more than once, selecting a different Exotic Weapon or weapon group each time. Above everything else, Mandalorians fight for glory in battle. Once per encounter, when you reduce an opponent's Hit Points to 0, you gain a +5 attack bonus with your next attack roll during the same encounter.","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Mandalorian Warrior","treeId":"4b8857716e056f62","tags":["action-economy","armor","battlefield-control","controller","damage-reduction","defender","feat-chain","lightsaber","melee","mobility","soldier","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.mandalorian_glory"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.2ed2cffbd702c1c3"}}},{"_id":"4b00f5d9b1526d5f","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d6+11","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":19,"flatDamageFormula":"1d6+11","useFlat":true}}}},{"_id":"00719b58e649c9ae","name":"Dagger Gauntlet","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+11","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Dagger Gauntlet","npc":{"flatAttackBonus":19,"flatDamageFormula":"1d4+11","useFlat":true}}}},{"_id":"af91a869789ceb5a","name":"Light Repeating Blaster","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+8,2-SquareAutofire","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":6,"cost":1200,"equipped":true,"description":"<p>A light automatic blaster weapon.</p>","properties":["Military","Autofire"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"rifles","subcategory":"rifle","costNumeric":1200,"category":"rifle"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-s