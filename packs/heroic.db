"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"abefb072dc418280","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"a9d5eadab6c45746","name":"Acute Senses","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Master Scout","prerequisites":"","benefit":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","description":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Master Scout","treeId":"dca33c0215264a02","tags":["action-economy","armor","controller","damage-reduction","defender","force","force-control","force-defense","force-offense","melee","mobility","positioning","ranged","scout","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.acute_senses"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f0166d26d9f6252a"}}},{"_id":"31cb4a10319e5cb8","name":"Evasion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Survivor","prerequisites":null,"benefit":"If hit by an area attack, take half or no damage.","description":"Take half or no damage from area attacks.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Survivor","treeId":"9b06340233eb3cdd","tags":["battlefield-control","evasion","scout","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.evasion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5400bc8cb1200624"}}},{"_id":"dda78a2da05a3b2f","name":"Gambler","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fortune","prerequisites":"","benefit":"You may reroll any Wisdom check when you Gamble, but must take the second result, even if it is worse. When Gambling against other characters, you must decide to reroll before the results of your opponents are revealed. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"You may reroll any Wisdom check when you Gamble, but must take the second result, even if it is worse. When Gambling against other characters, you must decide to reroll before the results of your opponents are revealed. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Fortune","treeId":"cee9b9398682b7d0","tags":["force","scoundrel"]},"effects":[{"_id":"0ca50b6a-df5d-4156-a022-e5743f6f2d7f","name":"Gambler","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.skills.gambling","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Gambler"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.gambler"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8e4475b0f99633f3"}}},{"_id":"71b94c39291239df","name":"Hunter's Mark","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Bounty Hunter","prerequisites":"","benefit":"Once per encounter as a Free Action, you may designate an opponent. For the rest of the encounter, when you succeed on a melee or ranged attack against that opponent, you gain a bonus on damage equal to your Class Level. Your skill as a Bounty Hunter is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. You may choose to reroll any Gather Information checks made to Locate Individual, but you must accept the result of the reroll, even if it is worse. Prerequisites: , Hunter's Target This Talent applies only to an opponent you've designated as your Hunter's Target. Any attack or effect originating from the target that would normally move you along the Condition Track does not, in fact, move you along the Condition Track. Prerequisites: , Hunter's Target Prerequisites: , Hunter's Target, Nowhere to Hide Prerequisites: , Hunter's Target","description":"Once per encounter as a Free Action, you may designate an opponent. For the rest of the encounter, when you succeed on a melee or ranged attack against that opponent, you gain a bonus on damage equal to your Class Level. Your skill as a Bounty Hunter is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. You may choose to reroll any Gather Information checks made to Locate Individual, but you must accept the result of the reroll, even if it is worse. Prerequisites: , Hunter's Target This Talent applies only to an opponent you've designated as your Hunter's Target. Any attack or effect originating from the target that would normally move you along the Condition Track does not, in fact, move you along the Condition Track. Prerequisites: , Hunter's Target Prerequisites: , Hunter's Target, Nowhere to Hide Prerequisites: , Hunter's Target","class":"Bounty Hunter","costNumeric":null,"category":"Bounty Hunter","tree":"Bounty Hunter","treeId":"a47ed82a822e3962","tags":["action-economy","condition-removal","controller","dual-wield","melee","mobility","positioning","ranged","scoundrel","skills","social","stealth","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hunters_mark"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.74fb6b37af983a4c"}}},{"_id":"4c71bf1713ae65e3","name":"Keen Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Awareness","prerequisites":"Acute Senses","benefit":"Ignore penalties against opponents with concealment (except total concealment).","description":"Ignore concealment penalties except total concealment.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Awareness","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.acute_senses"}],"_source":"canonical-csv"},"treeId":"1c48d1cd9ab1f5c8","tags":["feat-chain","ranged","scout","talent-chain"]},"effects":[{"_id":"ef19c1fd-23a5-4d9c-9a58-fbe2725f4f2c","name":"Keen Shot","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.ranged.concealmentPenalty","mode":5,"value":"0"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Keen Shot","effectType":"concealment_penalty"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.keen_shot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.aca0598e9b0eb935"}}},{"_id":"7cd90bec6a7f87bd","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+5","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none