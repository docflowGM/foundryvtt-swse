word.svg","system":{"damage":"2d8+16","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":24,"flatDamageFormula":"2d8+16","useFlat":true}}}},{"_id":"3b5006cc9146bcfd","name":"Lightsaber","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d8+16","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":19,"flatDamageFormula":"2d8+16","useFlat":true}}}},{"_id":"c33d51813da88621","name":"Lightsaber","type":"weapon