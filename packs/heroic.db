icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"429d165bbd8880c2","name":"Connections","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":"","benefit":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","treeId":"b5bb4154688c66ab","tags":["force","noble","skills","social","striker","support"]},"effects":[{"_id":"6708f25b-1035-4044-99fb-a15527d65e5c","name":"Connections","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.economy.blackMarketMultiplier","mode":2,"value":"-1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Connections","effectType":"economy_bonus","economy":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.connections"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e58a8ad63c1d8771"}}},{"_id":"0866a86a1de9f0ca","name":"Inspire Fear I","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Infamy","prerequisites":"","benefit":"As , except that the penalty increases to -2. Prerequisites: , I As , except that the penalty increases to -5. Your reputation as a Crime Lord is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. Prerequisites: , I, II, Notorious Any opponent that is reduced to half Hit Points or fewer while within 6 squares of you takes a -2 penalty on all attack rolls and Skill Checks for the duration of the encounter. This is a Mind-Affecting Fear effect.","description":"As , except that the penalty increases to -2. Prerequisites: , I As , except that the penalty increases to -5. Your reputation as a Crime Lord is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. Prerequisites: , I, II, Notorious Any opponent that is reduced to half Hit Points or fewer while within 6 squares of you takes a -2 penalty on all attack rolls and Skill Checks for the duration of the encounter. This is a Mind-Affecting Fear effect.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Infamy","treeId":"c1be604242cb328f","tags":["damage-reduction","positioning","skills","social","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_fear_i"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.cf4b1e5b126a2a7e"}}},{"_id":"872733490c8fa4e2","name":"Inspire Fear II","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Infamy","prerequisites":"Inspire Fear I","benefit":"Increase penalties to -2 on affected rolls.","description":"Increase Inspire Fear penalties to –2.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Infamy","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.inspire_fear_i"}],"_source":"canonical-csv"},"treeId":"c1be604242cb328f","tags":["feat-chain","talent-chain"]},"effects":[{"_id":"93101939-886b-4faf-a5cd-092f86e11d0f","name":"Inspire Fear II","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.morale.penalty","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Fear II"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse"