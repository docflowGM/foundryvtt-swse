ndryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"24ce5d123a4a2a39","name":"Skill Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You become trained in one additional skill. You may take this feat multiple times.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["noble","non-force","scaling","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You become <a class=\"mw-redirect\" href=\"/wiki/Trained\" title=\"Trained\">Trained</a> in one Class Skill."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"2ee929b7b72558a2","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"ee6bf2a58db26782","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"b3867b877c4e9981","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"bae4df73c5cfa48d","name":"Connections","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":"","benefit":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","treeId":"b5bb4154688c66ab","tags":["force","noble","skills","social","striker","support"]},"effects":[{"_id":"6708f25b-1035-4044-99fb-a15527d65e5c","name":"Connections","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.economy.blackMarketMultiplier","mode":2,"value":"-1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Connections","effectType":"economy_bonus","economy":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.connections"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e58a8ad63c1d8771"}}},{"_id":"0f053180475a1405","name":"Demand Surrender","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Consular","prerequisites":"Farseeing","benefit":"Once per turn as a Swift Action, you can remove one ongoing Mind-Affecting effect (such as the effects of or Weaken Resolve Talents, or the effect of being moved to the end of the Condition Track by the Adept Negotiator Talent, or the ongoing effects of the Mind Trick Force Power) from a single allied target within line of sight. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide When you use Farseeing, or a Force Power or Talent that has Farseeing as a prerequisite, other Force-users with Farseeing in their Force Power Suite can Aid Another on your Use the Force check as a Reaction, if they are within 6 squares of you. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Once per round as a Swift Action, you grant one ally within 12 squares of you (and within your line of sight) Bonus Hit Points equal to 5 + your Charisma modifier. These Bonus Hit Points last until the beginning of your next turn (at which point any remaining Bonus Hit Points are lost), and any damage dealt to that ally comes out of Bonus Hit Points first. You take a -5 penalty on all Use the Force checks until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide","description":"Once per turn as a Swift Action, you can remove one ongoing Mind-Affecting effect (such as the effects of or Weaken Resolve Talents, or the effect of being moved to the end of the Condition Track by the Adept Negotiator Talent, or the ongoing effects of the Mind Trick Force Power) from a single allied target within line of sight. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide When you use Farseeing, or a Force Power or Talent that has Farseeing as a prerequisite, other Force-users with Farseeing in their Force Power Suite can Aid Another on your Use the Force check as a Reaction, if they are within 6 squares of you. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Once per round as a Swift Action, you grant one ally within 12 squares of you (and within your line of sight) Bonus Hit Points equal to 5 + your Charisma modifier. These Bonus Hit Points last until the beginning of your next turn (at which point any remaining Bonus Hit Points are lost), and any damage dealt to that ally comes out of Bonus Hit Points first. You take a -5 penalty on all Use the Force checks until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide","class":"Noble","costNumeric":null,"category":"Noble","tree":"Jedi Consular","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.presence"}],"_source":"canonical-csv"},"treeId":"e99cfa9db8493573","tags":["action-economy","condition-removal","controller","feat-chain","force","force-control","force-offense","leader","light-side","mobility","noble","positioning","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.demand_surrender"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.871638a983029bc4"}}},{"_id":"91b7007da7f03a2d","name":"Impel Ally I","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mastermind","prerequisites":"","benefit":"You can spend two Swift Actions to grant one ally the ability to take a Standard Action or Move Action. The ally must move immediately on your turn, before you do anything else, or else the opportunity is wasted. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisites: , I Once per encounter, you can spend three Swift Actions on consecutive turns to grant one ally the ability to take a Standard Action and a Move Action. The ally must act immediately on your turn when the final Swift Action is spent, before you do anything else, or the opportunity is wasted. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , I As a Standard Action, you can designate a target to be the object of your allies' wrath. While your allies have line of sight to you or until you are unconscious or dead, your allies gain a +2 morale bonus on attack rolls against the target and a +2 morale bonus on Skill Checks against that target. You can designate a new target on any round by using another Standard Action. You can only use this Talent against one opponent at a time. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , I When an ally uses an Action granted to him or her by you, the ally can reroll any attack or check made during that Action, taking the better result. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , I Once per encounter, you can spend three Swift Actions on consecutive turns to increase the speed of all allies within your line of sight of you by 2. The increased speed lasts until the start of your next turn after the third Swift Action is spent. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"You can spend two Swift Actions to grant one ally the ability to take a Standard Action or Move Action. The ally must move immediately on your turn, before you do anything else, or else the opportunity is wasted. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisites: , I Once per encounter, you can spend three Swift Actions on consecutive turns to grant one ally the ability to take a Standard Action and a Move Action. The ally must act immediately on your turn when the final Swift Action is spent, before you do anything else, or the opportunity is wasted. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , I As a Standard Action, you can designate a target to be the object of your allies' wrath. While your allies have line of sight to you or until you are unconscious or dead, your allies gain a +2 morale bonus on attack rolls against the target and a +2 morale bonus on Skill Checks against that target. You can designate a new target on any round by using another Standard Action. You can only use this Talent against one opponent at a time. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , I When an ally uses an Action granted to him or her by you, the ally can reroll any attack or check made during that Action, taking the better result. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , I Once per encounter, you can spend three Swift Actions on consecutive turns to increase the speed of all allies within your line of sight of you by 2. The increased speed lasts until the start of your next turn after the third Swift Action is spent. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Mastermind","treeId":"560cc7994b357a0d","tags":["action-economy","controller","leader","mobility","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.impel_ally_i"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.aa32a31a179fe5c1"}}},{"_id":"e2fe9a368713b310","name":"Impel Ally II","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mastermind","prerequisites":"Impel Ally I","benefit":"Designated ally can make a standard or move action immediately or the effect is wasted.","description":"An ally may immediately take a move or standard action or lose it.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Mastermind","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.impel_ally_i"}],"_source":"canonical-csv"},"treeId":"560cc7994b357a0d","tags":["action-economy","controller","feat-chain","mobility","support","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.impel_ally_ii"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.b11a87e70f957ed2"}}},{"_id":"2bcaf7acf5b8b4f4","name":"Inspire Confidence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","description":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","controller","defender","leader","mobility","noble","striker","support"]},"effects":[{"_id":"1faa089c-9609-46d8-8543-9a68ace3553b","name":"Inspire Confidence","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Confidence"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_confidence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4d8882a28da30454"}}},{"_id":"b6b0d63744cab128","name":"Inspire Haste","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":null,"benefit":"An ally may make a skill check as a move action instead of a standard action.","description":"An ally may make a skill check as a move action instead of a standard action.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","controller","mobility","noble","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_haste"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.c5f8d32dbc5afcc4"}}},{"_id":"dd3476f4dbf36f58","name":"Inspire Fear I","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Infamy","prerequisites":"","benefit":"As , except that the penalty increases to -2. Prerequisites: , I As , except that the penalty increases to -5. Your reputation as a Crime Lord is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. Prerequisites: , I, II, Notorious Any opponent that is reduced to half Hit Points or fewer while within 6 squares of you takes a -2 penalty on all attack rolls and Skill Checks for the duration of the encounter. This is a Mind-Affecting Fear effect.","description":"As , except that the penalty increases to -2. Prerequisites: , I As , except that the penalty increases to -5. Your reputation as a Crime Lord is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. Prerequisites: , I, II, Notorious Any opponent that is reduced to half Hit Points or fewer while within 6 squares of you takes a -2 penalty on all attack rolls and Skill Checks for the duration of the encounter. This is a Mind-Affecting Fear effect.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Infamy","treeId":"c1be604242cb328f","tags":["damage-reduction","positioning","skills","social","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_fear_i"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.cf4b1e5b126a2a7e"}}},{"_id":"b23fefa751e01efe","name":"Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Influence","prerequisites":"","benefit":"Once per encounter, you can make a Persuasion check as a Standard Action to demand surrender from an opponent who has been reduced to one-half or less of its hit points. If your check result equals or exceeds the target's Will Defense, it surrenders to you and your allies, drops any weapons it is holding, and takes no hostile actions. If the target is higher level than you, it gains a +5 bonus to its Will Defense. If you or any of your allies attack it, it no longer submits to your will and can act normally. You can only use this Talent against a particular target once per encounter. This is a Mind-Affecting effect. Prerequisites: , Weaken Resolve Prerequisite: Once per round, when you deal damage equal to or greater than the target's Damage Threshold, you can make a Persuasion check as a Free Action; if the result equals or exceeds the target's Will Defense, you fill the target with terror, causing it to flee from you at top speed for 1 minute. The target can't take Standard Actions, Swift Actions, or Full-Round Actions while fleeing, but the target stops fleeing and can act normally if it is wounded. As a Free Action or Reaction, the target can spend a Force Point (if it has not already spent one earlier in the round) to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your Character Level. This is a Mind-Affecting fear effect. Unlike with other Mind-Affecting effects, you need only to hail a Vehicle to weaken the crew's resolve. When you deal damage that equals or exceeds a Vehicle's Damage Threshold, you may use this Talent; in addition, you may Ready an Action to use this Talent after any Gunner on your Vehicle deals damage that equals or exceeds a Vehicle's Damage Threshold. You make your check against the Vehicle's Commander; all Nonheroic crews are assumed to have a Will Defense of 10. The effect is automatically negated if the target Vehicle's Challenge Level is greater than your Heroic Level or your Vehicle's Challenge Level. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion You get under an opponent's skin. Once per encounter, make a Persuasion check to Intimidate one creature within line of sight as a Standard Action. On a success, instead of the normal effect of an Intimidate application of the Persuasion skill, the affected creature can take only a single Swift Action on its next turn. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion Once per encounter, as a Reaction, you can make a Persuasion check to Intimidate one creature that is making a melee or ranged attack against you, and is within your line of sight. If you succeed, you impose a -5 penalty to that attack roll. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"Once per encounter, you can make a Persuasion check as a Standard Action to demand surrender from an opponent who has been reduced to one-half or less of its hit points. If your check result equals or exceeds the target's Will Defense, it surrenders to you and your allies, drops any weapons it is holding, and takes no hostile actions. If the target is higher level than you, it gains a +5 bonus to its Will Defense. If you or any of your allies attack it, it no longer submits to your will and can act normally. You can only use this Talent against a particular target once per encounter. This is a Mind-Affecting effect. Prerequisites: , Weaken Resolve Prerequisite: Once per round, when you deal damage equal to or greater than the target's Damage Threshold, you can make a Persuasion check as a Free Action; if the result equals or exceeds the target's Will Defense, you fill the target with terror, causing it to flee from you at top speed for 1 minute. The target can't take Standard Actions, Swift Actions, or Full-Round Actions while fleeing, but the target stops fleeing and can act normally if it is wounded. As a Free Action or Reaction, the target can spend a Force Point (if it has not already spent one earlier in the round) to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your Character Level. This is a Mind-Affecting fear effect. Unlike with other Mind-Affecting effects, you need only to hail a Vehicle to weaken the crew's resolve. When you deal damage that equals or exceeds a Vehicle's Damage Threshold, you may use this Talent; in addition, you may Ready an Action to use this Talent after any Gunner on your Vehicle deals damage that equals or exceeds a Vehicle's Damage Threshold. You make your check against the Vehicle's Commander; all Nonheroic crews are assumed to have a Will Defense of 10. The effect is automatically negated if the target Vehicle's Challenge Level is greater than your Heroic Level or your Vehicle's Challenge Level. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion You get under an opponent's skin. Once per encounter, make a Persuasion check to Intimidate one creature within line of sight as a Standard Action. On a success, instead of the normal effect of an Intimidate application of the Persuasion skill, the affected creature can take only a single Swift Action on its next turn. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion Once per encounter, as a Reaction, you can make a Persuasion check to Intimidate one creature that is making a melee or ranged attack against you, and is within your line of sight. If you succeed, you impose a -5 penalty to that attack roll. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Influence","treeId":"8375b9b26b679901","tags":["action-economy","damage-reduction","defender","force","force-defense","force-offense","melee","mobility","noble","positioning","ranged","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.presence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ec8f2ba706cc2c05"}}},{"_id":"18341c212efd51e4","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+6","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":9,"flatDamageFormula":"1d4+6","useFlat":true}}}},{"_id":"3816972c96ce58df","name":"Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d6+6","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":500,"equipped":true,"description":"<p>The standard sidearm used throughout the galaxy. Reliable, common, and effective at close to medium range.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":500,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":11,"flatDamageFormula":"3d6+6","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Kel","Nonheroic Level":0,"Class Levels":{"Noble":10,"Lord":3},"Destiny Points":2,"Force Points":6,"Dark Side Points":2,"Initiative":12,"Senses":"Low-Light Vision, Perception +19","Languages":["Basic","Bocce","Durese","Huttese","Kel Dor","Mon Calamarian"],"Unassigned Languages":0,"Reflex Defense":27,"Flat-Footed Defense":26,"Fortitude Defense":25,"Will Defense":31,"Hit Points":76,"Damage Threshold":25,"Speed":"6 Squares","Melee Weapons":"Unarmed +9 (1d4+6)","Ranged Weapons":"Blaster Pistol +11 (3d6+6)","Base Attack Bonus":9,"Grapple":10,"Attack Options":["Point-Blank Shot","Precise Shot"],"Special Actions":["Command Cover (+1)","Connections","Demand Surrender","Impel Ally II","Inspire Confidence","Inspire Haste","Inspire Fear I","Presence"],"Force Powers":[],"Force Secrets":[],"Force Techniques":[],"Strength":10,"Dexterity":13,"Constitution":13,"Intelligence":15,"Wisdom":17,"Charisma":17,"Talents":["Talents : Connections","Demand Surrender","Impel Ally I","Impel Ally II","Inspire Confidence","Inspire Haste","Inspire Fear I","Presence"],"Feats":["Feats : Armor Proficiency (Light)","Improved Defenses","Linguist","Point-Blank Shot","Precise Shot","Skill Focus (Initiative)","Skill Focus (Mechanics)","Skill Focus (Perception)","Skill Focus (Persuasion)","Skill Focus (Use Computer)","Skill Training (Deception)","Weapon Focus (Pistols)","Weapon Proficiency (Pistols)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Deception","Gather Information","Initiative","Knowledge (Bureaucracy)","Knowledge (Galactic Lore)","Mechanics","Perception","Persuasion","Pilot","Treat Injury","Use Computer"],"Trained Skills":["Skills : Deception","Gather Information","Initiative","Knowledge (Bureaucracy)","Knowledge (Galactic Lore)","Mechanics","Perception","Persuasion","Pilot","Treat Injury","Use Computer"],"Species Traits":[],"Gear":"Blaster Pistol , Comlink (Short-Range, Encrypted), Datapad (Encrypted), Antiox Breath Mask and Goggles"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
