 Traits":[],"Gear":"Stun Cloak (+1 Reflex ), Stun Baton , Heavy Blaster Pistol , Stun Grenades (2), Comlink (Short-Range), Utility Belt , The Cutting Strike ( Corellian YU-410 Light Freighter )"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
