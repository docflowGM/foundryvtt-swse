t_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":"<p><strong>Cost:</strong> Force Point or Destiny Point</p><p>When using a Force Power that requires a Standard Action or Move Action to activate, you can spend a Force Point to activate the Force Power as a Swift Action instead.</p><p>Alternatively, you can spend a Destiny Point to activate the Force Power as a Reaction instead.</p>","cost":"Force Point or Destiny Point","alternativeCost":"Alternatively, you can spend a Destiny Point to activate the Force Power as a Reaction instead."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcesecrets.52bf7b9a1a41de2b"}}},{"_id":"2f9aa57dedf33f7b","name":"Force Point Recovery","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"At the end of an encounter, you automatically recover 1 Force Point spent during the encounter.","prerequisite":"","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>At the end of an encounter, you automatically recover 1 Force Point spent during the encounter.</p>","relatedPower":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.056ab39b3ab9df10"}}},{"_id":"2d12617deaa6a154","name":"Improved Force Trance","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"Each hour you remain in a Force Trance, you regain a number of Hit Points equal to 2 x your Character Level.","prerequisite":"Force Trance","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>Each hour you remain in a Force Trance, you regain a number of Hit Points equal to 2 x your Character Level.</p><p><strong>Related Power:</strong> Force Trance</p><p><strong>Prerequisites:</strong> Force Trance</p>","relatedPower":"Force Trance"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.93b96db5b560e14a"}}},{"_id":"a4221ee1e2349fd2","name":"Improved Move Light Object","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may make a Use the Force check to Move Light Object as a Swift Action instead of a Move Action. Using the light object as a projectile weapon requires a Move Action (instead of a Standard Action).","prerequisite":"Move Light Object","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may make a Use the Force check to Move Light Object as a Swift Action instead of a Move Action. Using the light object as a projectile weapon requires a Move Action (instead of a Standard Action).</p><p><strong>Related Power:</strong> Move Light Object</p><p><strong>Prerequisites:</strong> Move Light Object</p>","relatedPower":"Move Light Object"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.c406600924a7780e"}}},{"_id":"c65de62ad454937f","name":"Improved Sense Force","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may use the Sense Force ability of the Use the Force Skill as a Move Action rather than a Full-Round Action.","prerequisite":"Sense Force","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may use the Sense Force ability of the Use the Force Skill as a Move Action rather than a Full-Round Action.</p><p><strong>Related Power:</strong> Sense Force</p><p><strong>Prerequisites:</strong> Sense Force</p>","relatedPower":"Sense Force"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.ad67b8f3959860f2"}}},{"_id":"30f8352fbb1077c8","name":"Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"b8eef9a47bc5fbc3","name":"Block","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith Alchemy","prerequisites":"","benefit":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","description":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Sith Alchemy","treeId":"a67faf2ae089ab5d","tags":["action-economy","armor","dark-side","defender","force","force-offense","jedi","lightsaber","melee","mobility","ranged","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.block"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9379daa94a228c04"}}},{"_id":"a3729bd59b7e40a3","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"d33d320b5a8ee463","name":"Force Deception","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith","prerequisites":null,"benefit":"Use the Force replaces Deception checks and is treated as trained.","description":"Use the Force replaces Deception; you are considered trained.","class":"Sith Apprentice","costNumeric":null,"category":"Sith Apprentice","tree":"Sith","treeId":"d1037bc7a08ea80b","tags":["dark-side","force","jedi","skills","social"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_deception"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a40e25585a6f8c2b"}}},{"_id":"1c8868fba3709b37","name":"Force Perception","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sense","prerequisites":"","benefit":"You may spend a Force Point to reroll an Initiative check, keeping the better of the two rolls. Additionally, if you roll a natural 20 on the Initiative check reroll, you immediately regain the Force Point spent to activate this talent. Prerequisite: By focusing on a specific creature in your line of sight, you can gauge how strong in The Force they are. This takes a Standard Action and requires a Use the Force check. If your check result meets or beats the target's Will Defense, you know whether or not they have the Force Sensitivity feat, you know how many Force Powers they know (but not which ones specifically), and you know how many Force Points they currently have. Prerequisites: , Farseeing See also: On the Force, Visions, and Discretion Whenever you use the Farseeing Force Power, you can spend a Force Point as a Swift Action to see into the target's past or future instead of the present. You declare how far into the target's past or future you wish to look, up to a maximum of 1 year per your Character Level. Any information gained about a target's future is subject to change, depending on whether steps are taken to alter that future. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide As a Standard Action, you can spend a Force Point to ignore all Concealment for 1 minute. Prerequisites: , Farseeing As a Swift Action, you can peer into the future in search of signs of danger, removing one use of the Farseeing Force Power from your active Force Power Suite (as though you had just activated the Force Power). Any time before the end of your next turn when you are the target of an attack or Force Power, you can force your attacker to reroll the attack roll (or Use the Force check) against you, keeping the second result. This counts as using the Farseeing Force Power against the attacker, but this Talent replaces the normal rules and effect of that Force Power. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisites: , Farseeing When you use the Farseeing Force Power, you can choose to target an object you hold instead of a character or creature. You can look into the targeted item's past, up to a maximum of 5 years per your Character Level. Any information gained about the object's past is based on the thoughts and emotions of the person holding or carrying the object at the time you perceive, which can skew the results of the vision. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to gain Low-Light Vision (see Visibility) for 1 minute or until the end of the encounter, whichever is longer. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Jedi Padawans Prerequisites: Once per encounter, you may spend a Force Point to gain a +1 insight bonus to your Reflex Defense and Will Defense for the remainder of the encounter, or until you are knocked unconscious.","description":"You may spend a Force Point to reroll an Initiative check, keeping the better of the two rolls. Additionally, if you roll a natural 20 on the Initiative check reroll, you immediately regain the Force Point spent to activate this talent. Prerequisite: By focusing on a specific creature in your line of sight, you can gauge how strong in The Force they are. This takes a Standard Action and requires a Use the Force check. If your check result meets or beats the target's Will Defense, you know whether or not they have the Force Sensitivity feat, you know how many Force Powers they know (but not which ones specifically), and you know how many Force Points they currently have. Prerequisites: , Farseeing See also: On the Force, Visions, and Discretion Whenever you use the Farseeing Force Power, you can spend a Force Point as a Swift Action to see into the target's past or future instead of the present. You declare how far into the target's past or future you wish to look, up to a maximum of 1 year per your Character Level. Any information gained about a target's future is subject to change, depending on whether steps are taken to alter that future. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide As a Standard Action, you can spend a Force Point to ignore all Concealment for 1 minute. Prerequisites: , Farseeing As a Swift Action, you can peer into the future in search of signs of danger, removing one use of the Farseeing Force Power from your active Force Power Suite (as though you had just activated the Force Power). Any time before the end of your next turn when you are the target of an attack or Force Power, you can force your attacker to reroll the attack roll (or Use the Force check) against you, keeping the second result. This counts as using the Farseeing Force Power against the attacker, but this Talent replaces the normal rules and effect of that Force Power. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisites: , Farseeing When you use the Farseeing Force Power, you can choose to target an object you hold instead of a character or creature. You can look into the targeted item's past, up to a maximum of 5 years per your Character Level. Any information gained about the object's past is based on the thoughts and emotions of the person holding or carrying the object at the time you perceive, which can skew the results of the vision. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to gain Low-Light Vision (see Visibility) for 1 minute or until the end of the encounter, whichever is longer. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Jedi Padawans Prerequisites: Once per encounter, you may spend a Force Point to gain a +1 insight bonus to your Reflex Defense and Will Defense for the remainder of the encounter, or until you are knocked unconscious.","costNumeric":null,"tree":"Sense","treeId":"d6b4331c0e31f7e3","tags":["action-economy","defender","force","force-defense","force-offense","light-side","mobility","scout","skills","stealth","striker","support"]},"effects":[{"name":"Force Perception (Trained)","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.skills.perception.trained","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Force Perception","effectType":"skill-trained"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_perception"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a358402a9fc26c02"}}},{"_id":"7ac7a5366c6a7b9a","name":"Lightsaber Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Niman When you use the Talent, you gain twice the normal deflection bonus to your Reflex Defense when you are wielding two Lightsabers. Prerequisite: When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Talent increases by 2 (to a maximum of +5). When wielding a Lightsaber, you gain a +1 bonus to your Reflex Defense and Will Defense.","description":"Niman When you use the Talent, you gain twice the normal deflection bonus to your Reflex Defense when you are wielding two Lightsabers. Prerequisite: When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Talent increases by 2 (to a maximum of +5). When wielding a Lightsaber, you gain a +1 bonus to your Reflex Defense and Will Defense.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["defender","jedi","lightsaber","melee","striker"]},"effects":[{"_id":"fcdbf882-923a-4095-b0df-a1079c214099","name":"Lightsaber Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Lightsaber Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.lightsaber_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e8bf1222fd6289e4"}}},{"_id":"ac0f38f36ef9454d","name":"Jar'Kai","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"Lightsaber Defense, Niman","benefit":"Apply Lightsaber Defense twice when wielding two lightsabers.","description":"Double your Lightsaber Defense bonus when wielding two lightsabers.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["defender","feat-chain","jedi","lightsaber","melee","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.jarkai"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4552785ad56d90d4"}}},{"_id":"47a0a76005b61de5","name":"Niman","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":null,"benefit":"+1 Reflex and +1 Will Defense while wielding a lightsaber.","description":"Gain +1 Reflex Defense and +1 Will Defense while wielding a lightsaber.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Lightsaber Forms","canonicalName":"Niman","canonicalTree":"Bab +10","treeId":"2bc2572e852832e4","tags":["defender","jedi","lightsaber","melee","striker"]},"effects":[{"_id":"e56b443f-3c7f-4450-9993-b3cdfb3f5b72","name":"Niman","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex","mode":2,"value":"1"},{"key":"system.defenses.will","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Niman"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.niman"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7842befd5a8713c5"}}},{"_id":"17c2a510f651b236","name":"Visions","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Keetael","prerequisites":"","benefit":"Prerequisites: The long-lived Draethos are particularly adept at searching and understanding the past. When using Farseeing to look into the past, reduce your DC numbers by half. Also, you are able to see everything within 6 squares of your target clearly without spending a Force Point.","description":"Prerequisites: The long-lived Draethos are particularly adept at searching and understanding the past. When using Farseeing to look into the past, reduce your DC numbers by half. Also, you are able to see everything within 6 squares of your target clearly without spending a Force Point.","costNumeric":null,"tree":"Keetael","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.force_perception"}],"_source":"canonical-csv"},"treeId":"dad3c0da191748c1","tags":["damage-reduction","force","positioning"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.visions"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.da12fc505efc5eea"}}},{"_id":"ed025e4e33611c06","name":"Battle Strike","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You channel the Force to enhance your next melee attack. Your next melee attack this round gains a +1d6 bonus to damage.</p>","special":"<p>This bonus damage is Force damage and bypasses Damage Reduction.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["enhancement","damage","melee"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f177dc6d65f76de9"}}},{"_id":"dba19abb2976eb68","name":"Dark Rage","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Dark Rage"}}},{"_id":"b917f303cf3f12e1","name":"Farseeing","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"1 minute","range":"Unlimited","target":"Special","duration":"Concentration","effect":"<p>You peer through the Force to see distant locations or events. You can observe a place you've been before or a person you know, regardless of distance.</p>","special":"<p>The GM may require additional checks for very distant or obscured visions.</p>","descriptor":["Mind-Affecting","Scrying"],"dcChart":[],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":95,"tags":["utility","divination","scrying"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.0419ecb55f011f81"}}},{"_id":"a74d3f03e6b61a10","name":"Force Lightning","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":4,"discipline":"dark-side","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Instantaneous","effect":"<p>You unleash devastating arcs of Force Lightning from your fingertips. The target takes lightning damage based on your Use the Force check result.</p>","special":"<p>This is a Dark Side power. Using it gains you a Dark Side Point.</p>","descriptor":["Dark Side","Force Lightning"],"dcChart":[{"dc":15,"effect":"2d6 lightning damage","description":"Target takes 2d6 lightning damage"},{"dc":20,"effect":"4d6 lightning damage","description":"Target takes 4d6 lightning damage"},{"dc":25,"effect":"6d6 lightning damage + stun","description":"Target takes 6d6 lightning damage and is stunned for 1 round"},{"dc":30,"effect":"8d6 lightning damage + stun 1d4","description":"Target takes 8d6 lightning damage and is stunned for 1d4 rounds"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["attack","damage","dark-side","lightning"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.0a422b939edfad56"}}},{"_id":"094597e33013b97a","name":"Mind Trick","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telepathic","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 minute or until completed","effect":"<p>You influence a weak mind to believe what you tell them or follow a simple suggestion. The target must make a Will save (DC = your UTF check) or be affected.</p>","special":"<p>The suggestion must be reasonable and the target must be able to understand you.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["mind-control","suggestion","social"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.e6649f366d6c5737"}}},{"_id":"6c9b9599f4e3379e","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"247cdab04cfd157e","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}},{"_id":"c6fee01c7041add5","name":"Surge","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"vital","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You use the Force to push your body beyond normal limits. You gain an additional move action this turn.</p>","special":"<p>This extra move action can be used to move or perform other move-action tasks.</p>","descriptor":["Vital"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["enhancement","action-economy","movement"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.1ac1084ca8f07114"}}},{"_id":"6c91debff320017e","name":"Lightsaber","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d8+9","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber"