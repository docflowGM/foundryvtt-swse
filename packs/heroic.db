pgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"c4c7f97efb33f6e1","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"cee4f51395d5437c","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"85e04efa6a43b9ab","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"b35978681971fea2","name":"Block","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith Alchemy","prerequisites":"","benefit":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","description":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Sith Alchemy","treeId":"a67faf2ae089ab5d","tags":["action-economy","armor","dark-side","defender","force","force-offense","jedi","lightsaber","melee","mobility","ranged","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.block"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9379daa94a228c04"}}},{"_id":"dabc697314587b73","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"af9f218e5ae25bed","name":"Elusive Dogfighter","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Expert Pilot","prerequisites":"Wisdom 13","benefit":"You are an expert at escaping Dogfights. When making an opposed check to Disengage from a Dogfight, you can reroll your Pilot check, taking the better result. If you fail, you remain in the Dogfight, but the Gunners on your Vehicle do not take penalties to their attack rolls. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Once per encounter, if your Vehicle takes damage, make a Pilot check and compare the result to the Reflex Defense of one adjacent allied Vehicle. If your check result is higher, the allied Vehicle takes the damage instead. Reference Book: Star Wars Saga Edition Starships of the Galaxy Choose a single type of Vehicle from the following list: Airspeeder Capital Ship Space Transport Speeder Starfighter Walker When you are the Pilot or Gunner of that type of Vehicle, you gain a +2 bonus to all attack rolls with its Vehicle Weapons, and may Take 10 on any Pilot checks made while piloting that type of Vehicle, even when you are otherwise unable to. Reference Book: Star Wars Saga Edition Starships of the Galaxy As a Swift Action, you can make a DC 15 Pilot check to assist any allied Starfighter or Airspeeder within 2 squares at Starship Scale. If you succeed, the Pilot of that Vehicle gains a +5 bonus on all opposed Pilot checks relating to the Dogfight Action until the start of your next turn.","description":"You are an expert at escaping Dogfights. When making an opposed check to Disengage from a Dogfight, you can reroll your Pilot check, taking the better result. If you fail, you remain in the Dogfight, but the Gunners on your Vehicle do not take penalties to their attack rolls. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Once per encounter, if your Vehicle takes damage, make a Pilot check and compare the result to the Reflex Defense of one adjacent allied Vehicle. If your check result is higher, the allied Vehicle takes the damage instead. Reference Book: Star Wars Saga Edition Starships of the Galaxy Choose a single type of Vehicle from the following list: Airspeeder Capital Ship Space Transport Speeder Starfighter Walker When you are the Pilot or Gunner of that type of Vehicle, you gain a +2 bonus to all attack rolls with its Vehicle Weapons, and may Take 10 on any Pilot checks made while piloting that type of Vehicle, even when you are otherwise unable to. Reference Book: Star Wars Saga Edition Starships of the Galaxy As a Swift Action, you can make a DC 15 Pilot check to assist any allied Starfighter or Airspeeder within 2 squares at Starship Scale. If you succeed, the Pilot of that Vehicle gains a +5 bonus on all opposed Pilot checks relating to the Dogfight Action until the start of your next turn.","class":"Ace Pilot","costNumeric":null,"category":"Ace Pilot","tree":"Expert Pilot","treeId":"b17c1515c06361d6","tags":["action-economy","defender","feat-chain","mobility","piloting","positioning","scaling","scout","skills","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.elusive_dogfighter"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.fead6e3522fd458a"}}},{"_id":"424ec657b320b25a","name":"Force Pilot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sense","prerequisites":"Prerequisites: Technometry","benefit":"Starship Tactics When activating a Starship Maneuver, you may spend a Force Point to reroll your Pilot check, keeping the better of the two results. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to add your Charisma bonus to your Perception check. You can select this Talent multiple times. Each time you select this Talent, you add your Charisma bonus an additional time. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Prerequisite: You can substitute your Use the Force skill for any Use Computer check made to Astrogate or Use Sensors while you are the Pilot of a Vehicle. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Prerequisites: You can use your Use the Force check modifier instead of your Use Computer check modifier to Astrogate. You are considered Trained in the Use Computer skill. If you are entitled to a Use Computer check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Homebrew Reference Book: Legacy of the Force Sourcebook You can use your Use the Force check modifier instead of your Mechanics check modifier. You are considered Trained in the Mechanics skill. If you are entitled to a Mechanics check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Force Users As a Full-Round Action, you may attempt to merge your consciousness with am adjacent complex machine such as a computer, Droid or Vehicle by treating a Use the Force check as the Improve Access function of the Use Computer skill. Failure to beat the machine's Will Defense results in 1d4 Force damage dealt directly to your Hit Points. Success is treated as normal, though you may spend a Force Point as a Reaction upon success to move the system's Attitude an additional step. When a system is Helpful you are considered merged, and remain so until you chose to return to your natural body. While merged you are considered helpless and unaware of your body's surroundings. However, on your turn, you are in control of the merged machine. You are able to use the Access Information ability of the Use Computer Skill at a +10 bonus. In the case of a Vehicle or Droid, you are able to operate any single Vehicle or Droid system as if you were at the appropriate station, but at a +5 bonus to the associated check (attack roll or Skill Check). Further, when a merged Force-user uses the Reroute Power Action, their Vehicle moves an additional +1 step up the Condition Track. Upon returning to their natural body, a Force-user suffers a -5 penalty to all Use the Force checks made for 1d4 hours for every round they spent merged, and cannot spend Force Points unless accepting a Dark Side Point. If the player was merged for longer than an hour, they suffer a -10 penalty to all Use the Force checks for 1d4 days for every hour spent merged, and cannot spend Force Points or Destiny Points unless accepting a Dark Side Point. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"Starship Tactics When activating a Starship Maneuver, you may spend a Force Point to reroll your Pilot check, keeping the better of the two results. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to add your Charisma bonus to your Perception check. You can select this Talent multiple times. Each time you select this Talent, you add your Charisma bonus an additional time. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Prerequisite: You can substitute your Use the Force skill for any Use Computer check made to Astrogate or Use Sensors while you are the Pilot of a Vehicle. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Prerequisites: You can use your Use the Force check modifier instead of your Use Computer check modifier to Astrogate. You are considered Trained in the Use Computer skill. If you are entitled to a Use Computer check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Homebrew Reference Book: Legacy of the Force Sourcebook You can use your Use the Force check modifier instead of your Mechanics check modifier. You are considered Trained in the Mechanics skill. If you are entitled to a Mechanics check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Force Users As a Full-Round Action, you may attempt to merge your consciousness with am adjacent complex machine such as a computer, Droid or Vehicle by treating a Use the Force check as the Improve Access function of the Use Computer skill. Failure to beat the machine's Will Defense results in 1d4 Force damage dealt directly to your Hit Points. Success is treated as normal, though you may spend a Force Point as a Reaction upon success to move the system's Attitude an additional step. When a system is Helpful you are considered merged, and remain so until you chose to return to your natural body. While merged you are considered helpless and unaware of your body's surroundings. However, on your turn, you are in control of the merged machine. You are able to use the Access Information ability of the Use Computer Skill at a +10 bonus. In the case of a Vehicle or Droid, you are able to operate any single Vehicle or Droid system as if you were at the appropriate station, but at a +5 bonus to the associated check (attack roll or Skill Check). Further, when a merged Force-user uses the Reroute Power Action, their Vehicle moves an additional +1 step up the Condition Track. Upon returning to their natural body, a Force-user suffers a -5 penalty to all Use the Force checks made for 1d4 hours for every round they spent merged, and cannot spend Force Points unless accepting a Dark Side Point. If the player was merged for longer than an hour, they suffer a -10 penalty to all Use the Force checks for 1d4 days for every hour spent merged, and cannot spend Force Points or Destiny Points unless accepting a Dark Side Point. Homebrew Reference Book: Legacy of the Force Sourcebook","costNumeric":null,"tree":"Sense","treeId":"d6b4331c0e31f7e3","tags":["action-economy","condition-removal","controller","dark-side","defender","feat-chain","force","force-control","force-defense","force-offense","light-side","mechanics","mobility","perception","piloting","positioning","scaling","skills","slicing","striker","sustained-damage","talent-chain"]},"effects":[{"_id":"1a0877e3-3ddb-43ec-8895-3fce38f8d0e6","name":"Force Pilot","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.skills.pilot.trained","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Force Pilot"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_pilot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.443373859f1ecca3"}}},{"_id":"d933c22a89a3fe9d","name":"Weapon Specialization (Lightsabers)","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Duelist","tree":"Duelist","prerequisites":"","description":"Greater Weapon Focus (Lightsabers) You gain a +2 bonus on melee damage rolls with Lightsabers. This bonus stacks with the bonus granted by the Talent. Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. See also: Maiming Foes When you deal damage with a Lightsaber that is equal to or greater than both the target's current Hit Points and the target's Damage Threshold (that is, when you would deal enough damage to kill your target), you may choose to use this Talent. Instead of dealing full damage, you instead deal half damage to your target and move it -1 step on the Condition Track. In addition, you sever one of your target's arms at the wrist or elbow joint, or one of the target's legs at the knee or ankle joint (your choice). Severing part of an arm prevents the target from wielding weapons or using tools in that hand, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Severing part of a leg knocks the target Prone, reduces the target's Speed by half, reduces its Carrying Capacity by half, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Because of the severity of such an injury, losing part of a limb causes a Persistent Condition that can only be removed by having Surgery successfully performed on you. A Cybernetic Prosthesis negates these reductions and penalties. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","benefit":"Greater Weapon Focus (Lightsabers) You gain a +2 bonus on melee damage rolls with Lightsabers. This bonus stacks with the bonus granted by the Talent. Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. See also: Maiming Foes When you deal damage with a Lightsaber that is equal to or greater than both the target's current Hit Points and the target's Damage Threshold (that is, when you would deal enough damage to kill your target), you may choose to use this Talent. Instead of dealing full damage, you instead deal half damage to your target and move it -1 step on the Condition Track. In addition, you sever one of your target's arms at the wrist or elbow joint, or one of the target's legs at the knee or ankle joint (your choice). Severing part of an arm prevents the target from wielding weapons or using tools in that hand, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Severing part of a leg knocks the target Prone, reduces the target's Speed by half, reduces its Carrying Capacity by half, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Because of the severity of such an injury, losing part of a limb causes a Persistent Condition that can only be removed by having Surgery successfully performed on you. A Cybernetic Prosthesis negates these reductions and penalties. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","class":"","category":"","costNumeric":null,"treeId":"b3c5d90b5036f39b","tags":["burst-damage","condition-removal","controller","damage-reduction","defender","force","force-control","force-offense","leader","lightsaber","melee","mobility","scaling","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.00a9210772a64a19"}}},{"_id":"f7aae07e85734ca6","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"54a56d6df7ab411e","name":"Surge","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"vital","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You use the Force to push your body beyond normal limits. You gain an additional move action this turn.</p>","special":"<p>This extra move action can be used to move or perform other move-action tasks.</p>","descriptor":["Vital"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["enhancement","action-economy","movement"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.1ac1084ca8f07114"}}},{"_id":"7da4b0778b7b5b13","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+6","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":10,"flatDamageFormula":"1d4+6","useFlat":true}}}},{"_id":"177cdbb05eb68981","name":"Lightsaber","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d8+10","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":12,"flatDamageFormula":"2d8+10","useFlat":true}}}},{"_id":"3f49cec38373d376","name":"Lightsaber","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d8+10","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":7,"flatDamageFormula":"2d8+10","useFlat":true}}}},{"_id":"b639d3dba11d6863","name":"Lightsaber (with Double Attack)","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d8+10","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":7,"flatDamageFormula":"2d8+10","useFlat":true}}}},{"_id":"6e013f13fc430e70","name":"Ascension Gun","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+4","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":2,"cost":1200,"equipped":true,"description":"<p>A grappling gun with blaster capability.</p>","properties":["Military","Inaccurate"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":1200,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-ascension-gun"},"swse":{"npc":{"flatAttackBonus":10,"flatDamageFormula":"3d8+4","useFlat":true}}}},{"_id":"fb6dfe3c9b5f192f","name":"Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d6+4","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":500,"equipped":true,"description":"<p>The standard sidearm used throughout the galaxy. Reliable, common, and effective at close to medium range.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":500,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":10,"flatDamageFormula":"3d6+4","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Human","Nonheroic Level":0,"Class Levels":{"Scout":1,"Jedi":6,"Pilot":2},"Destiny Points":2,"Force Points":5,"Dark Side Points":1,"Initiative":12,"Senses":"Perception +10","Languages":["Basic","Huttese","Shyriiwook (understand only)"],"Unassigned Languages":0,"Reflex Defense":26,"Flat-Footed Defense":23,"Fortitude Defense":23,"Will Defense":21,"Hit Points":84,"Damage Threshold":23,"Speed":"6 Squares; Ascension Gun","Melee Weapons":"Unarmed +10 (1d4+6), Lightsaber +12 (2d8+10), Lightsaber +7 (2d8+10) and Lightsaber +7 (2d8+10) with Double Attack","Ranged Weapons":"Ascension Gun +10 (3d8+4), Blaster Pistol +10 (3d6+4)","Base Attack Bonus":7,"Grapple":10,"Attack Options":["Double Attack (Lightsabers)","Weapon Finesse"],"Speci