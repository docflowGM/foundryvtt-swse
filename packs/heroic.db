"Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"9b917795b992dd4a","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"8f4e78c3a0aa717d","name":"Ambush","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Disgrace","prerequisites":"Dirty Tactics","benefit":"If you are not surprised, you may forgo your standard action so non-surprised allies in line of sight gain an extra move or may reroll Initiative and keep the better result.","description":"If you hit an opponent that has not yet acted in combat, deal +2 dice of damage.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Disgrace","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.dirty_tactics"}],"_source":"canonical-csv"},"treeId":"e91cc675fbf9ba6e","tags":["action-economy","ambush","controller","feat-chain","mobility","noble","skills","talent-chain"]},"effects":[{"_id":"f6eb1201-2070-44b8-928a-095eb1d1c20a","name":"Ambush","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.all","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Ambush"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.ambush"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a3ac90e84127805d"}}},{"_id":"19e1ae8dc7e3cc17","name":"Attract Minion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mastermind","prerequisites":"","benefit":"Impel Ally I, Impel Ally II You attract a particularly skilled and powerful Minion. The Minion is a Nonheroic character with a Class Level equal to your Character Level. This Talent otherwise functions as the Talent. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Whenever you are adjacent to a minion gained with the Talent, once per turn as a Reaction to being attacked you can redirect the attack against that minion. Compare the attack roll to the minion's Defenses and resolve the attack as normal. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Bodyguard I Prerequisites: , Bodyguard I, Bodyguard II Prerequisite: Whenever you are adjacent to a Minion, you increase any Cover bonus to your Reflex Defense by +2. Reference Book: Star Wars Saga Edition Scum and Villainy Spend two Swift Actions to select two allies. Each ally can move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Reference Book: Star Wars Saga Edition Scum and Villainy Spend two Swift Actions to grant all allies that are in your line of sight and within 6 squares of you the ability to use the Withdraw Action as a Swift Action until the start of your next turn. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Whenever one of your minions is killed, he or she is replaced by another minion of the same level. This replacement occurs 24 hours later.","description":"Impel Ally I, Impel Ally II You attract a particularly skilled and powerful Minion. The Minion is a Nonheroic character with a Class Level equal to your Character Level. This Talent otherwise functions as the Talent. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Whenever you are adjacent to a minion gained with the Talent, once per turn as a Reaction to being attacked you can redirect the attack against that minion. Compare the attack roll to the minion's Defenses and resolve the attack as normal. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Bodyguard I Prerequisites: , Bodyguard I, Bodyguard II Prerequisite: Whenever you are adjacent to a Minion, you increase any Cover bonus to your Reflex Defense by +2. Reference Book: Star Wars Saga Edition Scum and Villainy Spend two Swift Actions to select two allies. Each ally can move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Reference Book: Star Wars Saga Edition Scum and Villainy Spend two Swift Actions to grant all allies that are in your line of sight and within 6 squares of you the ability to use the Withdraw Action as a Swift Action until the start of your next turn. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Whenever one of your minions is killed, he or she is replaced by another minion of the same level. This replacement occurs 24 hours later.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Mastermind","treeId":"560cc7994b357a0d","tags":["action-economy","controller","defender","leader","mobility","positioning","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.attract_minion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.2b31cb2ea7ad64b9"}}},{"_id":"61e30f166f8694e1","name":"Born Leader","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Naval Officer","prerequisites":"","benefit":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","description":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","class":"Noble","costNumeric":null,"category":"Noble","tree":"Naval Officer","treeId":"057a978a7dc1d5a7","tags":["armor","defender","noble","striker","support","sustained-damage"]},"effects":[{"_id":"f9275c38-3cb5-4ab3-aaa5-25e5722dcdd3","name":"Born Leader","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.will","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Born Leader"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.born_leader"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.6a66ba6e0834dd6f"}}},{"_id":"134223ae70c1bd4b","name":"Connections","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":"","benefit":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","treeId":"b5bb4154688c66ab","tags":["force","noble","skills","social","striker","support"]},"effects":[{"_id":"6708f25b-1035-4044-99fb-a15527d65e5c","name":"Connections","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.economy.blackMarketMultiplier","mode":2,"value":"-1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Connections","effectType":"economy_bonus","economy":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.connections"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e58a8ad63c1d8771"}}},{"_id":"437ef128442c883a","name":"Dirty Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Disgrace","prerequisites":"","benefit":"During a Surprise Round, before combat begins, if you are not Surprised you can give up your Standard Action to allow all non-Surprised allies within your line of sight to take an extra Move Action during the Surprise Round. Allies can spend this Move Action to instead reroll their Initiative checks and take the better of the two results as a Free Action before combat begins. You deliver a scathing rebuke against a target to erode its will and fill it with doubt. Make a Persuasion check as a Standard Action against the target's Will Defense. If successful, you impose a -2 penalty to all the target's Defenses until the end of your next turn. You can use this ability only against targets that can clearly hear and understand your language. Once per encounter, as a Standard Action, you can grant a tactical advantage to all allies within your line of sight. When an ally Flanks an opponent, that ally gains a +4 Flanking bonus on melee attack rolls instead of the normal +2 bonus. Allies lose this benefit immediately if line of sight is broken or if you are unconscious or dead, or at the end of the encounter. Prerequisite: As a Swift Action once per turn, you can make a Persuasion check against the Will Defense of all opponents within your line of sight. If successful, a target cannot attack you if one of your allies is within 6 squares of you. Prerequisites: , Misplaced Loyalty You have mastered the art of saying one thing and doing another, allowing you to deceive your enemies to keep your machinations hidden. You can use each of the following actions once per encounter as a Standard Action: False Security: Make a single melee or ranged attack against a target within your Range. At any time before the beginning of your next turn, you can make a single attack against that target as a Reaction if that target attacks you. Nonthreatening: Make a single melee or ranged attack against a target within your Range. Until the beginning of your next turn, that opponent cannot make any attacks against you except for Attacks of Opportunity. This is a Mind-Affecting effect. Tricky Target: Make a single melee or ranged attack against a target within your range that has not attacked you since the end of your last turn. You gain a +2 bonus on your attack roll and damage roll for this attack. You gain a +5 bonus to your Will Defense against Skill Checks made to read your emotions and influence your Attitude. In addition, whenever you successfully Feint a target in combat, that target is Flat-Footed against all your attacks until the end of your next turn.","description":"During a Surprise Round, before combat begins, if you are not Surprised you can give up your Standard Action to allow all non-Surprised allies within your line of sight to take an extra Move Action during the Surprise Round. Allies can spend this Move Action to instead reroll their Initiative checks and take the better of the two results as a Free Action before combat begins. You deliver a scathing rebuke against a target to erode its will and fill it with doubt. Make a Persuasion check as a Standard Action against the target's Will Defense. If successful, you impose a -2 penalty to all the target's Defenses until the end of your next turn. You can use this ability only against targets that can clearly hear and understand your language. Once per encounter, as a Standard Action, you can grant a tactical advantage to all allies within your line of sight. When an ally Flanks an opponent, that ally gains a +4 Flanking bonus on melee attack rolls instead of the normal +2 bonus. Allies lose this benefit immediately if line of sight is broken or if you are unconscious or dead, or at the end of the encounter. Prerequisite: As a Swift Action once per turn, you can make a Persuasion check against the Will Defense of all opponents within your line of sight. If successful, a target cannot attack you if one of your allies is within 6 squares of you. Prerequisites: , Misplaced Loyalty You have mastered the art of saying one thing and doing another, allowing you to deceive your enemies to keep your machinations hidden. You can use each of the following actions once per encounter as a Standard Action: False Security: Make a single melee or ranged attack against a target within your Range. At any time before the beginning of your next turn, you can make a single attack against that target as a Reaction if that target attacks you. Nonthreatening: Make a single melee or ranged attack against a target within your Range. Until the beginning of your next turn, that opponent cannot make any attacks against you except for Attacks of Opportunity. This is a Mind-Affecting effect. Tricky Target: Make a single melee or ranged attack against a target within your range that has not attacked you since the end of your last turn. You gain a +2 bonus on your attack roll and damage roll for this attack. You gain a +5 bonus to your Will Defense against Skill Checks made to read your emotions and influence your Attitude. In addition, whenever you successfully Feint a target in combat, that target is Flat-Footed against all your attacks until the end of your next turn.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Disgrace","treeId":"e91cc675fbf9ba6e","tags":["action-economy","ambush","controller","defender","leader","melee","mobility","noble","positioning","ranged","scout","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.dirty_tactics"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.1e7a0010a589b870"}}},{"_id":"fd58d466fcc0a213","name":"Impel Ally I","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mastermind","prerequisites":"","benefit":"You can spend two Swift Actions to grant one ally the ability to take a Standard Action or Move Action. The ally must move immediately on your turn, before you do anything else, or else the opportunity is wasted. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisites: , I Once per encounter, you can spend three Swift Actions on consecutive turns to grant one ally the ability to take a Standard Action and a Move Action. The ally must act immediately on your turn when the final Swift Action is spent, before you do anything else, or the opportunity is wasted. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , I As a Standard Action, you can designate a target to be the object of your allies' wrath. While your allies have line of sight to you or until you are unconscious or dead, your allies gain a +2 morale bonus on attack rolls against the target and a +2 morale bonus on Skill Checks against that target. You can designate a new target on any round by using another Standard Action. You can only use this Talent against one opponent at a time. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , I When an ally uses an Action granted to him or her by you, the ally can reroll any attack or check made during that Action, taking the better result. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , I Once per encounter, you can spend three Swift Actions on consecutive turns to increase the speed of all allies within your line of sight of you by 2. The increased speed lasts until the start of your next turn after the third Swift Action is spent. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"You can spend two Swift Actions to grant one ally the ability to take a Standard Action or Move Action. The ally must move immediately on your turn, before you do anything else, or else the opportunity is wasted. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisites: , I Once per encounter, you can spend three Swift Actions on consecutive turns to grant one ally the ability to take a Standard Action and a Move Action. The ally must act immediately on your turn when the final Swift Action is spent, before you do anything else, or the opportunity is wasted. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , I As a Standard Action, you can designate a target to be the object of your allies' wrath. While your allies have line of sight to you or until you are unconscious or dead, your allies gain a +2 morale bonus on attack rolls against the target and a +2 morale bonus on Skill Checks against that target. You can designate a new target on any round by using another Standard Action. You can only use this Talent against one opponent at a time. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , I When an ally uses an Action granted to him or her by you, the ally can reroll any attack or check made during that Action, taking the better result. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , I Once per encounter, you can spend three Swift Actions on consecutive turns to increase the speed of all allies within your line of sight of you by 2. The increased speed lasts until the start of your next turn after the third Swift Action is spent. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Mastermind","treeId":"560cc7994b357a0d","tags":["action-economy","controller","leader","mobility","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.impel_ally_i"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.aa32a31a179fe5c1"}}},{"_id":"a241ee32497c9c1b","name":"Inspire Fear I","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Infamy","prerequisites":"","benefit":"As , except that the penalty increases to -2. Prerequisites: , I As , except that the penalty increases to -5. Your reputation as a Crime Lord is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. Prerequisites: , I, II, Notorious Any opponent that is reduced to half Hit Points or fewer while within 6 squares of you takes a -2 penalty on all attack rolls and Skill Checks for the duration of the encounter. This is a Mind-Affecting Fear effect.","description":"As , except that the penalty increases to -2. Prerequisites: , I As , except that the penalty increases to -5. Your reputation as a Crime Lord is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. Prerequisites: , I, II, Notorious Any opponent that is reduced to half Hit Points or fewer while within 6 squares of you takes a -2 penalty on all attack rolls and Skill Checks for the duration of the encounter. This is a Mind-Affecting Fear effect.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Infamy","treeId":"c1be604242cb328f","tags":["damage-reduction","positioning","skills","social","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_fear_i"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.cf4b1e5b126a2a7e"}}},{"_id":"621b53e2b8046036","name":"Inspire Fear II","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Infamy","prerequisites":"Inspire Fear I","benefit":"Increase penalties to -2 on affected rolls.","description":"Increase Inspire Fear penalties to –2.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Infamy","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.inspire_fear_i"}],"_source":"canonical-csv"},"treeId":"c1be604242cb328f","tags":["feat-chain","talent-chain"]},"effects":[{"_id":"93101939-886b-4faf-a5cd-092f86e11d0f","name":"Inspire Fear II","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.morale.penalty","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Fear II"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_fear_ii"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.71bc6b43ab504b90"}}},{"_id":"cc3ac3458b74526a","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+7","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple",