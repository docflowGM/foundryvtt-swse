re proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"9832888228b0296b","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"1b92477d47190f67","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"3f07df0c719b7fac","name":"Force Power Mastery","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"Choose a single Force Power. You may Take 10 on Use the Force checks to activate this Force Power even when distracted or threatened.","prerequisite":"","special":"You may select this Force Technique multiple times; each time you select this Force Technique, it applies to a different Force Power.","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>Choose a single Force Power. You may Take 10 on Use the Force checks to activate this Force Power even when distracted or threatened.</p><p><strong>Special:</strong> You may select this Force Technique multiple times; each time you select this Force Technique, it applies to a different Force Power.</p>","relatedPower":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.07cea7e3e8b21d69"}}},{"_id":"7107372340d676d4","name":"Adept Spellcaster","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Dathomiri Witch","tree":"Dathomiri Witch","prerequisites":"Ichor Creation","description":"As a Swift Action, you can spend a Force Point to fly. You gain a fly speed equal to your base speed, and you can ascend at half speed or descend at double speed. The flight lasts until the start of your next turn; if you're still airborne at that time, you fall. Homebrew Reference Book: Dathomir Field Guide You can make Grab or Grapple attempts against any enemy within the reach of a Chain Sickle that you are wielding. These attempts use your weapon's attack bonus with in place of your Grapple modifier. When you would deal damage as part of a Grapple (such as through the Throw or Crush feats), you deal additional damage equal to your Dexterity modifier (minimum +1). Homebrew Reference Book: Dathomir Field Guide When you use a Chain Sickle or an Energy Bow, your damage die increases by one step (from d8s to d10s). In addition, you gain a +2 bonus to Use the Force checks made to Sense Surroundings. Homebrew Reference Book: Dathomir Field Guide Items you create through the Ichor Creation Force Power gain one applicable benefit as though enhanced by the Tech Specialist feat. Homebrew Reference Book: Dathomir Field Guide","benefit":"As a Swift Action, you can spend a Force Point to fly. You gain a fly speed equal to your base speed, and you can ascend at half speed or descend at double speed. The flight lasts until the start of your next turn; if you're still airborne at that time, you fall. Homebrew Reference Book: Dathomir Field Guide You can make Grab or Grapple attempts against any enemy within the reach of a Chain Sickle that you are wielding. These attempts use your weapon's attack bonus with in place of your Grapple modifier. When you would deal damage as part of a Grapple (such as through the Throw or Crush feats), you deal additional damage equal to your Dexterity modifier (minimum +1). Homebrew Reference Book: Dathomir Field Guide When you use a Chain Sickle or an Energy Bow, your damage die increases by one step (from d8s to d10s). In addition, you gain a +2 bonus to Use the Force checks made to Sense Surroundings. Homebrew Reference Book: Dathomir Field Guide Items you create through the Ichor Creation Force Power gain one applicable benefit as though enhanced by the Tech Specialist feat. Homebrew Reference Book: Dathomir Field Guide","class":"","category":"","costNumeric":null,"treeId":"ad16f3e5f4f7441b","tags":["action-economy","feat-chain","force","force-offense","mobility","ranged","scout","striker","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.12b7eb5d32bd440e"}}},{"_id":"ea0ce04b2e78a082","name":"Charm Beast","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Felucian Shaman","prerequisites":"Force Blast","benefit":"Whenever you manage to shift the Attitude of a Beast to Indifferent or Friendly, you may treat that creature as a domesticated animal- but for you only (it remains undomesticated in its response to other creatures). Additionally, you may use this Beast as a Mount, as per the Ride skill, provided that it is at least one size category larger than you and has a comfortable place for you to sit. When you use the Force Blast Force Power, you can spend a Force Point to compare the result of your Use the Force check to the Reflex Defense of all other characters, creatures, and Droids within 2 squares of your target. If you exceed the Reflex Defense of those secondary targets, they also take damage from the Force Blast, and if you fail to exceed their Reflex Defense, they take half damage instead. This is considered to be an Area Attack against the secondary targets (but not against the original target). You can use the Telepathy application of the Use the Force skill as a Swift Action, and you automatically succeed (no roll required) if your target is a willing recipient on the same planet. You can spend a Force Point to infuse an unpowered melee weapon (one that does not require an Energy Cell) with the strength of The Force, making it resistant to the attacks of other Weapons. Infusing the weapon takes a Full-Round Action.","description":"Whenever you manage to shift the Attitude of a Beast to Indifferent or Friendly, you may treat that creature as a domesticated animal- but for you only (it remains undomesticated in its response to other creatures). Additionally, you may use this Beast as a Mount, as per the Ride skill, provided that it is at least one size category larger than you and has a comfortable place for you to sit. When you use the Force Blast Force Power, you can spend a Force Point to compare the result of your Use the Force check to the Reflex Defense of all other characters, creatures, and Droids within 2 squares of your target. If you exceed the Reflex Defense of those secondary targets, they also take damage from the Force Blast, and if you fail to exceed their Reflex Defense, they take half damage instead. This is considered to be an Area Attack against the secondary targets (but not against the original target). You can use the Telepathy application of the Use the Force skill as a Swift Action, and you automatically succeed (no roll required) if your target is a willing recipient on the same planet. You can spend a Force Point to infuse an unpowered melee weapon (one that does not require an Energy Cell) with the strength of The Force, making it resistant to the attacks of other Weapons. Infusing the weapon takes a Full-Round Action.","class":"Force Adept","costNumeric":null,"category":"Force Adept","tree":"Felucian Shaman","treeId":"8a61bf426391431b","tags":["action-economy","battlefield-control","defender","feat-chain","force","force-defense","force-offense","melee","mobility","positioning","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.charm_beast"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.bab9a1ce285f98b9"}}},{"_id":"c07a32837b1cfe49","name":"Evasion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Survivor","prerequisites":null,"benefit":"If hit by an area attack, take half or no damage.","description":"Take half or no damage from area attacks.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Survivor","treeId":"9b06340233eb3cdd","tags":["battlefield-control","evasion","scout","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.evasion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5400bc8cb1200624"}}},{"_id":"a7c08bcd84b8c901","name":"Extreme Effort","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Survivor","prerequisites":"","benefit":"You can spend a Swift Action to gain a +1 morale bonus to your attack rolls and Defenses until the end of your next turn, at which time you move -1 step along the Condition Track.","description":"You can spend a Swift Action to gain a +1 morale bonus to your attack rolls and Defenses until the end of your next turn, at which time you move -1 step along the Condition Track.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Survivor","treeId":"9b06340233eb3cdd","tags":["action-economy","condition-removal","controller","defender","leader","mobility","scout","striker"]},"effects":[{"_id":"77180b26-dbd9-4513-b415-146649a78fab","name":"Extreme Effort","icon":"icons/svg/fist.svg","changes":[{"key":"system.abilities.strength","mode":2,"value":"5"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Extreme Effort"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.extreme_effort"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.c7c5ac9608d29c5b"}}},{"_id":"b432ee532db0d7ac","name":"Long Stride","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Master Scout","prerequisites":"Skill Focus (Initiative)","benefit":"Surefooted, Trained in Climb You do not suffer penalties when using the Accelerated Climbing application of the Climb Skill. In a Surprise Round, if you are not Surprised, you can take a Swift Action in addition to the one other Action normally allowed. If you are Surprised, you can take a single Swift Action. Normal: In a Surprise Round, if you are not Surprised, you can take a Standard Action, a Move Action, or a Swift Action. If you are Surprised, you can take no Actions.","description":"Surefooted, Trained in Climb You do not suffer penalties when using the Accelerated Climbing application of the Climb Skill. In a Surprise Round, if you are not Surprised, you can take a Swift Action in addition to the one other Action normally allowed. If you are Surprised, you can take a single Swift Action. Normal: In a Surprise Round, if you are not Surprised, you can take a Standard Action, a Move Action, or a Swift Action. If you are Surprised, you can take no Actions.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Master Scout","treeId":"dca33c0215264a02","tags":["action-economy","ambush","controller","feat-chain","mobility","scout","striker","support","sustained-damage","talent-chain"]},"effects":[{"_id":"1379eb45-3cb6-42c3-aabe-c8747b8d5bf0","name":"Long Stride","icon":"icons/svg/running.svg","changes":[{"key":"system.speed","mode":2,"value":"2","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Long Stride"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.long_stride"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.618472c99f355949"}}},{"_id":"9e72322e1363d034","name":"Surefooted","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Survivor","prerequisites":null,"benefit":"Speed is not reduced by difficult terrain.","description":"Your speed is not reduced by difficult terrain.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Survivor","treeId":"9b06340233eb3cdd","tags":["controller","damage-reduction","mobility","scout"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.surefooted"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f87bd82a892f69ea"}}},{"_id":"a6b49b4506562fb4","name":"Dark Rage","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Dark Rage"}}},{"_id":"0a3a1d3aeedc36e2","name":"Force Grip","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":3,"discipline":"dark-side","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Concentration","effect":"<p>You use the Force to telekinetically choke or crush your target. The target takes damage each round based on your Use the Force check result.</p>","special":"<p>This is a Dark Side power. The target is immobilized while gripped.</p>","descriptor":["Dark Side","Telekinetic"],"dcChart":[{"dc":15,"effect":"2d6 damage/round","description":"Target takes 2d6 damage per round and is immobilized"},{"dc":20,"effect":"4d6 damage/round","description":"Target takes 4d6 damage per round and is immobilized"},{"dc":25,"effect":"6d6 damage/round + lift","description":"Target takes 6d6 damage per round, is immobilized, and lifted off ground"},{"dc":30,"effect":"8d6 damage/round + crush","description":"Target takes 8d6 damage per round and is being crushed (fort save or die)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["attack","damage","dark-side","telekinetic","immobilize"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f41a957f71e98a6a"}}},{"_id":"302b25dbb0db7616","name":"Force Slam","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One creature or object","duration":"Instantaneous","effect":"<p>You use telekinetic force to violently slam your target against a surface. The target takes 4d6 damage and is knocked prone.</p>","special":"<p>The target must be within 6 squares of a solid surface (wall, floor, ceiling).</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":97,"tags":["attack","damage","telekinetic","prone"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.462a6c23e00c4dfc"}}},{"_id":"61bea8c824d7d35c","name":"Force Storm","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":6,"discipline":"dark-side","useTheForce":30,"time":"Standard Action","range":"12 squares","target":"20-square radius","duration":"Concentration","effect":"<p>You create a massive Force storm of lightning and violent energy. All creatures in the area take 10d6 lightning damage each round (Reflex half, DC = your UTF check).</p>","special":"<p>This is a powerful Dark Side power. Using it gains you 2 Dark Side Points. Master-level power.</p>","descriptor":["Dark Side","Force Lightning","Area"],"dcChart":[{"dc":30,"effect":"10d6 to all in area","description":"All creatures in 20-square radius take 10d6 lightning damage (Reflex half)"},{"dc":35,"effect":"12d6 to all + stun","description":"All creatures take 12d6 damage (Reflex half) and are stunned 1 round (Fort negates)"},{"dc":40,"effect":"15d6 to all + disintegrate","description":"All creatures take 15d6 damage; those reduced to 0 HP are disintegrated"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":97,"tags":["area","damage","dark-side","master","lightning"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.aef6dad242fd225b"}}},{"_id":"8a4becc62374f875","name":"Mind Trick","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telepathic","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 minute or until completed","effect":"<p>You influence a weak mind to believe what you tell them or follow a simple suggestion. The target must make a Will save (DC = your UTF check) or be affected.</p>","special":"<p>The suggestion must be reasonable and the target must be able to understand you.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["mind-control","suggestion","social"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.e6649f366d6c5737"}}},{"_id":"0bf453b80f62c0fe","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"eab6676c1233ecb3","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d6+7","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":9,"flatDamageFormula":"1d6+7","useFlat":true}}}},{"_id":"0e48ef1360812e98","name":"Whip ((2d4+7))","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"0","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"<p>2-Square Reach</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Whip","npc":{"flatAttackBonus":9,"flatDamageFormula":"0","useFlat":true}}}},{"_id":"a75e52aac8888324","name":"Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d6+5","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":500,"equipped":true,"description":"<p>The standard sidearm used throughout the galaxy. Reliable, common, and effective at close to medium range.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":500,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":9,"flatDamageFormula":"3d6+5","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Human","Nonheroic Level":0,"Class Levels":{"Scout":7,"Adept":3},"Destiny Points":1,"Force Points":5,"Dark Side Points":10,"Initiative":7,"Senses":"Perception +6","Languages":["Basic","Paecian"],"Unassigned Languages":0,"Reflex Defense":25,"Flat-Footed Defense":23,"Fortitude Defense":24,"Will Defense":25,"Hit Points":71,"Damage Threshold":24,"Speed":"8 Squares; Surefooted","Melee Weapons":"Unarmed +9 (1d6+7), Whip +9 (2-Square Reach ) (2d4+7)","Ranged Weapons":"Blaster Pistol +9 (3d6+5)","Base Attack Bonus":7,"Grapple":9,"Attack Options":[],"Special Actions":["Adept Spellcaster","Charm Beast","Extreme Effort"],"Force Powers":["Dark Rage","Force Grip","Force Slam","Force Storm","Mind Trick","Move Object"],"Force Secrets":[],"Force Techniques":["Force Techniques : Force Power Mastery ( Move Object )"],"Strength":14,"Dexterity":14,"Constitution":15,"Intelligence":10,"Wisdom":12,"Charisma":12,"Talents":["Talents : Adept Spellcaster","Charm Beast","Evasion","Extreme Effort","Long Stride","Surefooted"],"Feats":["Feats : Dodge","Force Sensitivity","Force Training (3)","Martial Arts I","Skill Focus (Climb)","Skill Focus (Ride)","Weapon Proficiency (Pistols)","Weapon Proficiency (Rifles)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Climb","Jump","Knowledge (Life Sciences)","Ride","Survival","Use the Force"],"Trained Skills":["Skills : Climb","Jump","Knowledge (Life Sciences)","Ride","Survival","Use the Force"],"Species Traits":[],"Gear":"Blaster Pistol , Whip"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
{"_id":"4768335560c62494","name":"Marn \"The Gryph\" Hierogryph","type":"npc","img":"icons/svg/mystery-man.svg","system":{"isDroid":false,"droidDegree":"","attributes":{"str":{"base":8,"racial":0,"enhancement":0,"temp":0},"dex":{"base":12,"racial":0,"enhancement":0,"temp":0},"con":{"base":10,"racial":0,"enhancement":0,"temp":0},"int":{"base":16,"racial":0,"enhancement":0,"temp":0},"wis":{"base":13,"racial":0,"enhancement":0,"temp":0},"cha":{"base":17,"racial":0,"enhancement":0,"temp":0}},"skills":{"acrobatics":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"dex","favorite":false},"climb":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"str","favorite":false},"deception":{"trained":true,"focused":true,"miscMod":0,"selectedAbility":"cha","favorite":false},"endurance":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"con","favorite":false},"gatherInformation":{"trained":true,"focused":true,"miscMod":0,"selectedAbility":"cha","favorite":false},"initiative":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"dex","favorite":false},"jump":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"str","favorite":false},"knowledgeBureaucracy":{"trained":true,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeGalacticLore":{"trained":true,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeLifeSciences":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgePhysicalSciences":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeSocialSciences":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeTactics":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeTechnology":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"mechanics":{"trained":false,"focu