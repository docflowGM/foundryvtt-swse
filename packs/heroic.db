fect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"cdabe7714acaacb5","name":"Cheap Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Run and Gun","prerequisites":"Opportunistic Strike","benefit":"Once per encounter, make an attack of opportunity against an opponent that withdraws from an ally in point-blank range.","description":"Once per encounter, make an attack of opportunity against a withdrawing opponent.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Run and Gun","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.opportunistic_strike"}],"_source":"canonical-csv"},"treeId":"6367600ed3c0cfae","tags":["feat-chain","mobility","positioning","ranged","scoundrel","support","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.cheap_shot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.32a76fe000898f90"}}},{"_id":"5b950fd77e4ccf46","name":"No Escape","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Run and Gun","prerequisites":"Opportunistic Strike","benefit":"When an opponent withdraws, that opponent is considered flat-footed against you until the end of your next turn.","description":"Opponents withdrawing from you are flat-footed until the end of your next turn.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Run and Gun","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.opportunistic_strike"}],"_source":"canonical-csv"},"treeId":"6367600ed3c0cfae","tags":["controller","feat-chain","mobility","scoundrel","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.no_escape"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f0bfcfc354862328"}}},{"_id":"45166d88a19db358","name":"Opportunistic Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Run and Gun","prerequisites":"","benefit":"Once per encounter, you can make an Attack of Opportunity against an opponent that takes the Withdraw Action to Withdraw from a space threatened by one of your allies within Point-Blank Range. Prerequisite: Whenever an opponent uses the Withdraw Action to leave your Threatened Area, that opponent is considered Flat-Footed against you until the end of your next turn. Once per encounter, you can make an Attack of Opportunity against an opponent within Point-Blank Range (even using a ranged weapon), if that opponent provokes an Attack of Opportunity from one of your allies.","description":"Once per encounter, you can make an Attack of Opportunity against an opponent that takes the Withdraw Action to Withdraw from a space threatened by one of your allies within Point-Blank Range. Prerequisite: Whenever an opponent uses the Withdraw Action to leave your Threatened Area, that opponent is considered Flat-Footed against you until the end of your next turn. Once per encounter, you can make an Attack of Opportunity against an opponent within Point-Blank Range (even using a ranged weapon), if that opponent provokes an Attack of Opportunity from one of your allies.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Run and Gun","treeId":"6367600ed3c0cfae","tags":["action-economy","battlefield-control","controller","mobility","positioning","ranged","scoundrel"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.opportunistic_strike"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.93770927eba5446d"}}},{"_id":"f262740b3393789f","name":"Sneak Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["action-economy","battlefield-control","controller","defender","melee","mobility","positioning","precision","ranged","scaling","scoundrel","skills","social","striker"]},"effects":[{"_id":"3195415b-2276-403c-9fb1-5d323d38d31a","name":"Sneak Attack","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.flatfooted","mode":2,"value":"1d6"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Sneak Attack"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.sneak_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.1505abc8babeeb84"}}},{"_id":"a1aad12292796b55","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+4","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":6,"flatDamageFormula":"1d4+4","useFlat":true}}}},{"_id":"f651aa7ee7222155","name":"Heavy Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+4","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1.3,"cost":750,"equipped":true,"description":"<p>A more powerful variant of the standard blaster pistol, delivering higher damage at the cost of increased weight and power consumption.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":750,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-heavy-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":10,"flatDamageFormula":"3d8+4","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Human","Nonheroic Level":0,"Class Levels":{"Scoundrel":9},"Destiny Points":0,"Force Points":3,"Dark Side Points":0,"Initiative":12,"Senses":"Perception +10","Languages":["Basic"],"Unassigned Languages":0,"Reflex Defense":24,"Flat-Footed Defense":21,"Fortitude Defense":20,"Will Defense":21,"Hit Points":55,"Damage Threshold":20,"Speed":"6 Squares; Running Attack","Melee Weapons":"Unarmed +6 (1d4+4)","Ranged Weapons":"Heavy Blaster Pistol +10 (3d8+4)","Base Attack Bonus":6,"Grapple":9,"Attack Options":["Careful Shot","Cheap Shot ( No Escape )","Opportunistic Strike","Point-Blank Shot","Precise Shot","Sneak Attack (+2d6)","Sniper","Triple Crit (Pistols)"],"Special Actions":["Quick Draw"],"Force Powers":[],"Force Secrets":[],"Force Techniques":[],"Strength":10,"Dexterity":16,"Constitution":12,"Intelligence":10,"Wisdom":13,"Charisma":16,"Talents":["Talents : Cheap Shot","No Escape","Opportunistic Strike","Sneak Attack (+2d6)"],"Feats":["Feats : Careful Shot","Point-Blank Shot","Precise Shot","Quick Draw","Running Attack","Skill Focus (Stealth)","Sniper","Triple Crit (Pistols)","Vehicular Combat","Weapon Focus (Pistols)","Weapon Proficiency (Pistols)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Deception","Initiative","Perception","Pilot","Stealth"],"Trained Skills":["Skills : Deception","Initiative","Perception","Pilot","Stealth"],"Species Traits":[],"Gear":"Heavy Blaster Pistol , Comlink (Short-Range), Datapad"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
