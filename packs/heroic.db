ons:</strong> Instinctive Attack, Stunning Strike</p>\n<p><strong>Special Actions:</strong> Ancient Knowledge, Born Leader, Inspire Confidence, Rage (1/Day)</p>","derived":{},"npcProfile":{"kind":"heroic","mode":"play","sourceAuthority":"statblock","legalProfile":"heroic","legalState":"unchecked","importMode":"play","playReady":true,"statblockAuthority":true,"sourcePack":"heroic","normalizationVersion":1,"authority":{"hp":"statblock","defenses":"statblock","bab":"statblock","attacks":"statblock","skills":"statblock","damageThreshold":"statblock"}}},"items":[{"_id":"ff39923a357f9e2e","name":"Rakata","type":"species","img":"icons/svg/mystery-man.svg","system":{"size":"Medium","speed":6,"abilities":"+2 Str, -2 Wis","skillBonuses":["+2 Use the Force"],"special":["Force-Born"],"languages":["Rakata","Basic"],"source":"KOTOR","description":"","tags":[],"costNumeric":null},"effects":[],"folder":null,"sort":9100,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.species.species-rakata"}}},{"_id":"76c8672873a2212b","name":"Armor Proficiency (light)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with light armor and do not take armor check penalties on attack rolls.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":85,"tags":["armor","defender","non-force","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No penalty on attacks and no <a class=\"mw-redirect\" href=\"/wiki/Armor_Check_Penalty\" title=\"Armor Check Penalty\">Armor Check Penalty</a> while wearing <a href=\"/wiki/Light_Armor\" title=\"Light Armor\">Light Armor</a>."}},"effects":[{"_id":"9781a3c7-4e7e-4af0-9dcc-cdea0524b414","name":"Armor Proficiency (Light)","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.armorProficiency.light","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Armor Proficiency (Light)","effectType":"armor_proficiency"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.773ec00effc7e96f"}}},{"_id":"7842d3474653c955","name":"Dual Weapon Mastery I","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You reduce the penalty for fighting with two weapons by 2.","prerequisite":"Dex 13, Two-Weapon Fighting","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["damage-reduction","dual-wield","feat-chain","non-force","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Take a -5 penalty on attacks when attacking with two weapons, or both ends of a double weapon."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13},{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[{"_id":"5e1f7aa0-8f41-4f6e-9a16-1710b2de25e9","name":"Dual Weapon Mastery I","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Dual Weapon Mastery I","effectType":"passive_effect","flagType":"Dual Weapon Mastery I"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.84d8866a57381620"}}},{"_id":"f801ae1ec094ff4e","name":"Force Sensitivity","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"You can make Use the Force checks and gain access to Force Talents.","prerequisite":"Non-Droid","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["feat-chain","force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You can make <a href=\"/wiki/Use_the_Force\" title=\"Use the Force\">Use the Force</a