9","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":7,"flatDamageFormula":"2d8+9","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Cerean","Nonheroic Level":0,"Class Levels":{"Jedi":6,"Noble":2,"Knight":6,"Master":2},"Destiny Points":1,"Force Points":6,"Dark Side Points":0,"Initiative":9,"Senses":"Improved Sense Force , Improved Sense Surroundings , Perception +11","Languages":["Basic","Cerean","High Galactic","Huttese","Kel Dor","Ryl","Shyriiwook (understand only)"],"Unassigned Languages":0,"Reflex Defense":31,"Flat-Footed Defense":30,"Fortitude Defense":32,"Will Defense":33,"Immune":"Fear effects","Hit Points":142,"Damage Threshold":32,"Speed":"6 Squares","Melee Weapons":"Unarmed +16 (1d4+9), Lightsaber +17 (2d8+9), Lightsaber +12 (2d8+9) and Lightsaber +12 (2d8+9) with Double Attack, Lightsaber +7 (2d8+9) and Lightsaber +7 (2d8+9) and Lightsaber +7 (2d8+9) with Triple Attack","Ranged Weapons":"By Weapon +16","Base Attack Bonus":15,"Grapple":16,"Attack Options":["Accelerated Strike","Double Attack (Lightsabers)","Triple Attack (Lightsabers)"],"Special Actions":["Beast Trick","Force Harmony","Jedi Quarry","Redirect Shot","Serenity","Vigilance"],"Force Powers":["Farseeing","Farseeing","Force Slam","Mind Trick","Mind Trick","Move Object","Prescience","Rebuke","Surge","Unhindered Charge","Valor","Vital Transfer"],"Force Secrets":["Force Secrets : Mentor"],"Force Techniques":["Force Techniques : Force Point Recovery","Improved Sense Force","Improved Sense Surroundings"],"Strength":12,"Dexterity":13,"Constitution":14,"Intelligence":16,"Wisdom":16,"Charisma":12,"Talents":["Talents : Beast Trick","Block","Deflect","Force Harmony","Jedi Quarry","Redirect Shot","Sheltering Stance","Vigilance"],"Feats":["Feats : Accelerated Strike","Combat Reflexes","Dodge","Double Attack (Lightsabers)","Force Sensitivity","Force Training (3)","Linguist","Skill Training (Gather Information)","Triple Attack (Lightsabers)","Weapon Focus (Lightsabers)","Weapon Proficiency (Lightsabers)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Gather Information","Knowledge (Galactic Lore)","Knowledge (Social Sciences)","Pilot","Use the Force"],"Trained Skills":["Skills : Gather Information","Knowledge (Galactic Lore)","Knowledge (Social Sciences)","Pilot","Use the Force"],"Species Traits":[],"Gear":"Lightsaber ( Self-Built ), Jedi Robes"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
