","name":"Skill Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You become trained in one additional skill. You may take this feat multiple times.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["noble","non-force","scaling","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You become <a class=\"mw-redirect\" href=\"/wiki/Trained\" title=\"Trained\">Trained</a> in one Class Skill."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"6df76090fed10850","name":"Skill Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You become trained in one additional skill. You may take this feat multiple times.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["noble","non-force","scaling","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You become <a class=\"mw-redirect\" href=\"/wiki/Trained\" title=\"Trained\">Trained</a> in one Class Skill."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"d6dd43a2a00a607c","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"ac91f4a5fe201a69","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"26b8898f3fde0429","name":"Born Leader","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Naval Officer","prerequisites":"","benefit":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","description":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","class":"Noble","costNumeric":null,"category":"Noble","tree":"Naval Officer","treeId":"057a978a7dc1d5a7","tags":["armor","defender","noble","striker","support","sustained-damage"]},"effects":[{"_id":"f9275c38-3cb5-4ab3-aaa5-25e5722dcdd3","name":"Born Leader","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.will","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Born Leader"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.born_leader"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.6a66ba6e0834dd6f"}}},{"_id":"a1184f34f35aceeb","name":"Connections","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":"","benefit":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","treeId":"b5bb4154688c66ab","tags":["force","noble","skills","social","striker","support"]},"effects":[{"_id":"6708f25b-1035-4044-99fb-a15527d65e5c","name":"Connections","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.economy.blackMarketMultiplier","mode":2,"value":"-1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Connections","effectType":"economy_bonus","economy":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.connections"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e58a8ad63c1d8771"}}},{"_id":"51402dc3d92bd30d","name":"Educated","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":"","benefit":"Sometimes you surprise others with your skill. Once per day, you may make an Untrained skill check as though you were Trained in the Skill. Exception: you cannot use this Talent to make an Untrained Use the Force check as though you were Trained in the skill, unless you have the Force Sensitivity feat. You can select this Talent multiple times; each time you do, you can use it one additional time per day. Each time you gain a level (including the level at which you select this Talent), you receive an amount of credits equal to 5,000 x your Class Level. You can spend these credits as you see fit. The credits appear in a civilized, accessible location of your choice or in your private bank account. Reference Book: Star Wars Saga Edition Starships of the Galaxy Prerequisites: , Trained in Knowledge (Technology) You are Trained in the Mechanics skill. Additionally, when installing new systems into a Vehicle, the efficiency of your designs reduces the time it takes to install the system by 25%. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisites: , Intelligence 13 Select a number of Skills equal to your Intelligence modifier that you are not Trained in. You may now use Trained-only applications of those Skills, and they are considered Class Skills. You are not considered Trained in those Skills for any other purposes, and must still satisfy any other requirements in order to use the skill. Homebrew Reference Book: Legacy of the Force Sourcebook Select one type of performance, such as acting, dancing, singing, or playing a musical instrument. You gain a +5 bonus on Persuasion checks to entertain for that type of performance. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Intelligence 13 You have the ability to acquire aid and information from a long list of people. You may reroll any Gather Information check, but the result of the reroll must be accepted, even if it is worse. Additionally, the DC for any Persuasion checks made to reduce the cost of Bribery is reduced by 5.","description":"Sometimes you surprise others with your skill. Once per day, you may make an Untrained skill check as though you were Trained in the Skill. Exception: you cannot use this Talent to make an Untrained Use the Force check as though you were Trained in the skill, unless you have the Force Sensitivity feat. You can select this Talent multiple times; each time you do, you can use it one additional time per day. Each time you gain a level (including the level at which you select this Talent), you receive an amount of credits equal to 5,000 x your Class Level. You can spend these credits as you see fit. The credits appear in a civilized, accessible location of your choice or in your private bank account. Reference Book: Star Wars Saga Edition Starships of the Galaxy Prerequisites: , Trained in Knowledge (Technology) You are Trained in the Mechanics skill. Additionally, when installing new systems into a Vehicle, the efficiency of your designs reduces the time it takes to install the system by 25%. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisites: , Intelligence 13 Select a number of Skills equal to your Intelligence modifier that you are not Trained in. You may now use Trained-only applications of those Skills, and they are considered Class Skills. You are not considered Trained in those Skills for any other purposes, and must still satisfy any other requirements in order to use the skill. Homebrew Reference Book: Legacy of the Force Sourcebook Select one type of performance, such as acting, dancing, singing, or playing a musical instrument. You gain a +5 bonus on Persuasion checks to entertain for that type of performance. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Intelligence 13 You have the ability to acquire aid and information from a long list of people. You may reroll any Gather Information check, but the result of the reroll must be accepted, even if it is worse. Additionally, the DC for any Persuasion checks made to reduce the cost of Bribery is reduced by 5.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","treeId":"b5bb4154688c66ab","tags":["ambush","damage-reduction","force","mechanics","noble","scaling","skills","social","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.educated"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.3e98c9f5a4f450ff"}}},{"_id":"2a542a7f2a553d84","name":"Inspire Confidence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","description":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","controller","defender","leader","mobility","noble","striker","support"]},"effects":[{"_id":"1faa089c-9609-46d8-8543-9a68ace3553b","name":"Inspire Confidence","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Confidence"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_confidence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4d8882a28da30454"}}},{"_id":"7fa6a3ed838f1dde","name":"Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Influence","prerequisites":"","benefit":"Once per encounter, you can make a Persuasion check as a Standard Action to demand surrender from an opponent who has been reduced to one-half or less of its hit points. If your check result equals or exceeds the target's Will Defense, it surrenders to you and your allies, drops any weapons it is holding, and takes no hostile actions. If the target is higher level than you, it gains a +5 bonus to its Will Defense. If you or any of your allies attack it, it no longer submits to your will and can act normally. You can only use this Talent against a particular target once per encounter. This is a Mind-Affecting effect. Prerequisites: , Weaken Resolve Prerequisite: Once per round, when you deal damage equal to or greater than the target's Damage Threshold, you can make a Persuasion check as a Free Action; if the result equals or exceeds the target's Will Defense, you fill the target with terror, causing it to flee from you at top speed for 1 minute. The target can't take Standard Actions, Swift Actions, or Full-Round Actions while fleeing, but the target stops fleeing and can act normally if it is wounded. As a Free Action or Reaction, the target can spend a Force Point (if it has not already spent one earlier in the round) to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your Character Level. This is a Mind-Affecting fear effect. Unlike with other Mind-Affecting effects, you need only to hail a Vehicle to weaken the crew's resolve. When you deal damage that equals or exceeds a Vehicle's Damage Threshold, you may use this Talent; in addition, you may Ready an Action to use this Talent after any Gunner on your Vehicle deals damage that equals or exceeds a Vehicle's Damage Threshold. You make your check against the Vehicle's Commander; all Nonheroic crews are assumed to have a Will Defense of 10. The effect is automatically negated if the target Vehicle's Challenge Level is greater than your Heroic Level or your Vehicle's Challenge Level. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion You get under an opponent's skin. Once per encounter, make a Persuasion check to Intimidate one creature within line of sight as a Standard Action. On a success, instead of the normal effect of an Intimidate application of the Persuasion skill, the affected creature can take only a single Swift Action on its next turn. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion Once per encounter, as a Reaction, you can make a Persuasion check to Intimidate one creature that is making a melee or ranged attack against you, and is within your line of sight. If you succeed, you impose a -5 penalty to that attack roll. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"Once per encounter, you can make a Persuasion check as a Standard Action to demand surrender from an opponent who has been reduced to one-half or less of its hit points. If your check result equals or exceeds the target's Will Defense, it surrenders to you and your allies, drops any weapons it is holding, and takes no hostile actions. If the target is higher level than you, it gains a +5 bonus to its Will Defense. If you or any of your allies attack it, it no longer submits to your will and can act normally. You can only use this Talent against a particular target once per encounter. This is a Mind-Affecting effect. Prerequisites: , Weaken Resolve Prerequisite: Once per round, when you deal damage equal to or greater than the target's Damage Threshold, you can make a Persuasion check as a Free Action; if the result equals or exceeds the target's Will Defense, you fill the target with terror, causing it to flee from you at top speed for 1 minute. The target can't take Standard Actions, Swift Actions, or Full-Round Actions while fleeing, but the target stops fleeing and can act normally if it is wounded. As a Free Action or Reaction, the target can spend a Force Point (if it has not already spent one earlier in the round) to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your Character Level. This is a Mind-Affecting fear effect. Unlike with other Mind-Affecting effects, you need only to hail a Vehicle to weaken the crew's resolve. When you deal damage that equals or exceeds a Vehicle's Damage Threshold, you may use this Talent; in addition, you may Ready an Action to use this Talent after any Gunner on your Vehicle deals damage that equals or exceeds a Vehicle's Damage Threshold. You make your check against the Vehicle's Commander; all Nonheroic crews are assumed to have a Will Defense of 10. The effect is automatically negated if the target Vehicle's Challenge Level is greater than your Heroic Level or your Vehicle's Challenge Level. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion You get under an opponent's skin. Once per encounter, make a Persuasion check to Intimidate one creature within line of sight as a Standard Action. On a success, instead of the normal effect of an Intimidate application of the Persuasion skill, the affected creature can take only a single Swift Action on its next turn. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion Once per encounter, as a Reaction, you can make a Persuasion check to Intimidate one creature that is making a melee or ranged attack against you, and is within your line of sight. If you succeed, you impose a -5 penalty to that attack roll. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Influence","treeId":"8375b9b26b679901","tags":["action-economy","damage-reduction","defender","force","force-defense","force-offense","melee","mobility","noble","positioning","ranged","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.presence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ec8f2ba706cc2c05"}}},{"_id":"84b6aad528962093","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+4","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":6,"flatDamageFormula":"1d4+4","useFlat":true}}}},{"_id":"33e64dcd6acdbb32","name":"Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d6+4","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":500,"equipped":true,"description":"<p>The standard sidearm used throughout the galaxy. Reliable, common, and effective at close to medium range.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":500,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":7,"flatDamageFormula":"3d6+4","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Human","Nonheroic Level":0,"Class Levels":{"Noble":9},"Destiny Points":2,"Force Points":4,"Dark Side Points":0,"Initiative":10,"Senses":"Perception +16","Languages":["Basic","High Galactic","Mon Calamarian","Sullustese"],"Unassigned Languages":0,"Reflex Defense":21,"Flat-Footed Defense":20,"Fortitude Defense":19,"Will Defense":23,"Hit Points":50,"Damage Threshold":19,"Speed":"6 Squares","Melee Weapons":"Unarmed +6 (1d4+4)","Ranged Weapons":"Blaster Pistol +7 (3d6+4)","Base Attack Bonus":6,"Grapple":7,"Attack Options":["Melee Defense"],"Special Actions":["Born Leader","Connections","Educated","Inspire Confidence","Presence","Quick Draw"],"Force Powers":[],"Force Secrets":[],"Force Techniques":[],"Strength":11,"Dexterity":13,"Constitution":10,"Intelligence":13,"Wisdom":15,"Charisma":14,"Talents":["Talents : Born Leader","Connections","Educated","Inspire Confidence","Presence"],"Feats":["Feats : Dodge","Linguist","Melee Defense","Quick Draw","Skill Focus (Deception)","Skill Focus (Knowledge (Bureaucracy))","Skill Focus (Perception)","Skill Training (Initiative)","Skill Training (Pilot)","Skill Training (Use Computer)","Weapon Proficiency (Pistols)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Deception","Gather Information","Initiative","Knowledge (Bureaucracy)","Knowledge (Galactic Lore)","Knowledge (Social Sciences)","Perception","Persuasion","Pilot","Treat Injury","Use Computer"],"Trained Skills":["Skills : Deception","Gather Information","Initiative","Knowledge (Bureaucracy)","Knowledge (Galactic Lore)","Knowledge (Social Sciences)","Perception","Persuasion","Pilot","Treat Injury","Use Computer"],"Species Traits":[],"Gear":"Blaster Pistol , Comlink (Short-Range), Datapad"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
