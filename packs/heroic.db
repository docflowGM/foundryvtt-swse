pendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"fe2fde1e38a419a1","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"ea7a52bd475c2a77","name":"Force Point Recovery","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"At the end of an encounter, you automatically recover 1 Force Point spent during the encounter.","prerequisite":"","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>At the end of an encounter, you automatically recover 1 Force Point spent during the encounter.</p>","relatedPower":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.056ab39b3ab9df10"}}},{"_id":"0b5715ace08a1893","name":"Clear Mind","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Sentinel","prerequisites":"","benefit":"Force Haze Prerequisites: , Force Haze","description":"Force Haze Prerequisites: , Force Haze","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Sentinel","treeId":"36f18f3e974feb33","tags":["force","jedi","light-side"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.clear_mind"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8bd201bb22c8da3a"}}},{"_id":"0d3ce14462630a1c","name":"Dastardly Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","tree":"Misfortune","prerequisites":"Combat Reflexes","description":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","benefit":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","class":"","category":"","costNumeric":null,"treeId":"67b59e020c1660eb","tags":["condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","lightsaber","melee","mobility","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9e4345faaaa94dd8"}}},{"_id":"0036593ecae75f00","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"9b7980e220af93de","name":"Force Haze","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Sentinel","prerequisites":"Farseeing","benefit":"You can spend a Force Point as a Standard Action to create a \"Haze\" that hides you and your allies from the perception of others. You can hide a number of creatures in line of sight equal to your Class Level. Make a Use the Force check and compare the result to the Will Defense of any opponent that moves into line of sight of any creature hidden by your . If your check result equals or exceeds the opponent's Will Defense, all hidden creatures are treated as if they had Total Concealment against the opponent. The lasts for up to 1 minute but is dismissed instantly if anyone hidden by the makes an attack. You may use this Talent to hide a single Vehicle while you are on board. The Vehicle can't have a size penalty to Reflex Defense, Initiative, or Pilot checks greater than your Heroic Level. Thus, a Gargantuan Starship (size penalty of -5) can be hidden only by a character of 5th level or higher. Whenever anyone concealed by your use of the Talent attacks, you maintain Total Concealment without having to make another Use the Force check. Only those who do not attack remain concealed; the attacker no longer has Total Concealment, even when using his Talent. Reference Book: Star Wars Saga Edition Galaxy at War When you hit a target with a Lightsaber attack, if the target has not been attacked since the end of your last turn, you deal +1 die of damage. Reference Book: Star Wars Saga Edition Rebellion Era Campaign Guide If you take damage from the use of a Force Power, until the end of the encounter you deal an extra 2 points of damage against the creature that used the Force Power against you. Reference Book: Star Wars Saga Edition Unknown Regions Jedi who spend time in a diverse wilderness learn the nuances of The Living Force at work within a wild ecosystem. When within a natural wilderness area, such as a jungle, a forest, a swamp, or plains, you tap into the vibrant Living Force of the area and can use the Sense Surroundings aspect of the Use the Force skill to detect targets out to a 30-square radius, regardless of line of sight. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Any time you attack a Flat-Footed opponent (or one who is denied its Dexterity bonus to its Reflex Defense against you) with a damage-dealing Force Power, or attack with a Lightsaber, you deal an extra +1d6 points of damage with that attack. This Talent does not affect Force Powers with the [Dark Side] descriptor. Whenever you use the Talent, allies hidden by the can reroll any Perception check, keeping the better of the two results. Additionally, allies hidden by the gain a +2 bonus on all damage rolls against foes that are unaware of them. Homebrew Reference Book: Legacy of the Force Sourcebook You can make a Use the Force check instead of a Survival check to Track. You are considered Trained in the Survival skill for the purposes of this Talent. If you are entitled to a Survival check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Homebrew Reference Book: Legacy of the Force Sourcebook You may substitute your Wisdom modifier for your Dexterity modifier when determining your Reflex Defense. Any condition that would cause you to be denied your Dexterity modifier to Reflex Defense causes you to be denied your Wisdom modifier as well. Homebrew Reference Book: Legacy of the Force Sourcebook You may reroll Perception checks made to Avoid Surprise or Search, keeping the better of the two results.","description":"You can spend a Force Point as a Standard Action to create a \"Haze\" that hides you and your allies from the perception of others. You can hide a number of creatures in line of sight equal to your Class Level. Make a Use the Force check and compare the result to the Will Defense of any opponent that moves into line of sight of any creature hidden by your . If your check result equals or exceeds the opponent's Will Defense, all hidden creatures are treated as if they had Total Concealment against the opponent. The lasts for up to 1 minute but is dismissed instantly if anyone hidden by the makes an attack. You may use this Talent to hide a single Vehicle while you are on board. The Vehicle can't have a size penalty to Reflex Defense, Initiative, or Pilot checks greater than your Heroic Level. Thus, a Gargantuan Starship (size penalty of -5) can be hidden only by a character of 5th level or higher. Whenever anyone concealed by your use of the Talent attacks, you maintain Total Concealment without having to make another Use the Force check. Only those who do not attack remain concealed; the attacker no longer has Total Concealment, even when using his Talent. Reference Book: Star Wars Saga Edition Galaxy at War When you hit a target with a Lightsaber attack, if the target has not been attacked since the end of your last turn, you deal +1 die of damage. Reference Book: Star Wars Saga Edition Rebellion Era Campaign Guide If you take damage from the use of a Force Power, until the end of the encounter you deal an extra 2 points of damage against the creature that used the Force Power against you. Reference Book: Star Wars Saga Edition Unknown Regions Jedi who spend time in a diverse wilderness learn the nuances of The Living Force at work within a wild ecosystem. When within a natural wilderness area, such as a jungle, a forest, a swamp, or plains, you tap into the vibrant Living Force of the area and can use the Sense Surroundings aspect of the Use the Force skill to detect targets out to a 30-square radius, regardless of line of sight. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Any time you attack a Flat-Footed opponent (or one who is denied its Dexterity bonus to its Reflex Defense against you) with a damage-dealing Force Power, or attack with a Lightsaber, you deal an extra +1d6 points of damage with that attack. This Talent does not affect Force Powers with the [Dark Side] descriptor. Whenever you use the Talent, allies hidden by the can reroll any Perception check, keeping the better of the two results. Additionally, allies hidden by the gain a +2 bonus on all damage rolls against foes that are unaware of them. Homebrew Reference Book: Legacy of the Force Sourcebook You can make a Use the Force check instead of a Survival check to Track. You are considered Trained in the Survival skill for the purposes of this Talent. If you are entitled to a Survival check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Homebrew Reference Book: Legacy of the Force Sourcebook You may substitute your Wisdom modifier for your Dexterity modifier when determining your Reflex Defense. Any condition that would cause you to be denied your Dexterity modifier to Reflex Defense causes you to be denied your Wisdom modifier as well. Homebrew Reference Book: Legacy of the Force Sourcebook You may reroll Perception checks made to Avoid Surprise or Search, keeping the better of the two results.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Sentinel","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.clear_mind"}],"_source":"canonical-csv"},"treeId":"36f18f3e974feb33","tags":["action-economy","ambush","battlefield-control","condition-removal","controller","dark-side","defender","evasion","feat-chain","force","force-control","force-defense","force-offense","jedi","light-side","lightsaber","melee","mobility","perception","piloting","positioning","scout","skills","stealth","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_haze"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f098749cb8767a5f"}}},{"_id":"75e1224900279132","name":"Improved Sentinel Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Shadow","prerequisites":null,"benefit":"Increase Sentinel Strike damage die to d8 instead of d6.","description":"Increase Sentinel Strike damage dice from d6 to d8.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Jedi Shadow","treeId":"eab0d8bbee7e0f4f","tags":["force","force-offense","jedi","light-side","striker"]},"effects":[{"_id":"5c11840f-9cbd-4806-b1c7-2c0c9ed88cf6","name":"Improved Sentinel Strike","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.sentinel","mode":5,"value":"1d8"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Improved Sentinel Strike"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_sentinel_strike"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f836070c4a153ba0"}}},{"_id":"23b92004e1001791","name":"Sentinel Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Shadow","prerequisites":"","benefit":"Increase the damage dice of your to d8, instead of d6.","description":"Increase the damage dice of your to d8, instead of d6.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Shadow","treeId":"eab0d8bbee7e0f4f","tags":["force","force-offense","jedi","light-side","striker"]},"effects":[{"_id":"d09476da-02f8-413d-91fd-1d8873844060","name":"Sentinel Strike","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.flatfooted","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Sentinel Strike"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.sentinel_strike"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.cf2d518039afd828"}}},{"_id":"bb2e55996708a198","name":"Battle Strike","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You channel the Force to enhance your next melee attack. Your next melee attack this round gains a +1d6 bonus to damage.</p>","special":"<p>This bonus damage is Force damage and bypasses Damage Reduction.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["enhancement","damage","melee"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f177dc6d65f76de9"}}},{"_id":"cfd266cc1358c20f","name":"Force Slam","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One creature or object","duration":"Instantaneous","effect":"<p>You use telekinetic force to violently slam your target against a surface. The target takes 4d6 damage and is knocked prone.</p>","special":"<p>The target must be within 6 squares of a solid surface (wall, floor, ceiling).</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":97,"tags":["attack","damage","telekinetic","prone"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.462a6c23e00c4dfc"}}},{"_id":"f1bedd75a6964e16","name":"Mind Trick","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telepathic","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 minute or until completed","effect":"<p>You influence a weak mind to believe what you tell them or follow a simple suggestion. The target must make a Will save (DC = your UTF check) or be affected.</p>","special":"<p>The suggestion must be reasonable and the target must be able to understand you.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["mind-control","suggestion","social"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.e6649f366d6c5737"}}},{"_id":"21143d6c62e154a0","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"c2532b4ac030e0cc","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}},{