"_id":"3b52bf36811f2f29","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"ba3640c4b5475e04","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"6ea5a6ac2cb89d45","name":"Castigate","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Disgrace","prerequisites":null,"benefit":"Make Persuasion vs Will Defense to impose -2 to all of the target’s defenses until the end of your next turn.","description":"Make a Persuasion check vs Will Defense to impose -2 to all defenses until the end of your next turn.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Disgrace","treeId":"e91cc675fbf9ba6e","tags":["defender","noble","skills","social"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.castigate"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.cad07bbaa57634c0"}}},{"_id":"74e6340d1c1cef42","name":"Cast Suspicion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Provocateur","prerequisites":"","benefit":"Whenever an ally within your line of sight is missed by a ranged attack, you can (as a Reaction, once per turn) designate one enemy adjacent to that ally. Compare the attack roll of the missed attack to the Reflex Defense of that enemy; if the attack would hit, the attack targets that enemy and is resolved as normal. Prerequisite: Whenever an enemy within your line of sight uses the Aid Another Action to grant one of its allies a bonus, you can (as a Reaction) designate one ally within your line of sight. The enemy automatically fails to aid its ally, and the ally you designate gains a +2 bonus on its next attack roll made before the end of your next turn. Prerequisites: , Friend or Foe As a Standard Action, make a Persuasion check against the Will Defense of one enemy within your line of sight that can hear and understand you. If your check result equals or exceeds the target's Will Defense, that target immediately makes an attack (as a Free Action) against another target of your choice. This can be a melee attack against an adjacent target or a ranged attack against a target within the attacker's Point-Blank Range. The target gains a +5 bonus to its Will Defense if it is of a higher level than you. This is a Mind-Affecting effect.","description":"Whenever an ally within your line of sight is missed by a ranged attack, you can (as a Reaction, once per turn) designate one enemy adjacent to that ally. Compare the attack roll of the missed attack to the Reflex Defense of that enemy; if the attack would hit, the attack targets that enemy and is resolved as normal. Prerequisite: Whenever an enemy within your line of sight uses the Aid Another Action to grant one of its allies a bonus, you can (as a Reaction) designate one ally within your line of sight. The enemy automatically fails to aid its ally, and the ally you designate gains a +2 bonus on its next attack roll made before the end of your next turn. Prerequisites: , Friend or Foe As a Standard Action, make a Persuasion check against the Will Defense of one enemy within your line of sight that can hear and understand you. If your check result equals or exceeds the target's Will Defense, that target immediately makes an attack (as a Free Action) against another target of your choice. This can be a melee attack against an adjacent target or a ranged attack against a target within the attacker's Point-Blank Range. The target gains a +5 bonus to its Will Defense if it is of a higher level than you. This is a Mind-Affecting effect.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Provocateur","treeId":"da34105c875650ae","tags":["action-economy","defender","leader","melee","noble","positioning","ranged","skills","social","striker","support"]},"effects":[{"_id":"c6a962d9-bdbf-4119-82bb-4d0344f3bf83","name":"Cast Suspicion","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.morale.suppressed","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Cast Suspicion"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.cast_suspicion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9408056ede41b43f"}}},{"_id":"f1825d873ee9ec4a","name":"Connections","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":"","benefit":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","treeId":"b5bb4154688c66ab","tags":["force","noble","skills","social","striker","support"]},"effects":[{"_id":"6708f25b-1035-4044-99fb-a15527d65e5c","name":"Connections","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.economy.blackMarketMultiplier","mode":2,"value":"-1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Connections","effectType":"economy_bonus","economy":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.connections"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e58a8ad63c1d8771"}}},{"_id":"6e0da9cd6e2153f8","name":"Hesitate","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"Once per encounter, as a Standard Action, you can make a Deception check and compare the result to the Will Defense of all enemies in your line of sight. If the check result equals or exceeds an enemy's Will Defense, that enemy must spend a Swift Action in addition to a Standard Action to make an attack until the start of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Once per round, as a Swift Action, you can designate a target within 12 squares of you and in your line of sight as the target of this Talent. Until the beginning of your turn, you can cause that target to take a -5 penalty on all checks made with a single Skill. You must have line of sight to your target to make use of this Talent, and declare which Skill is to be penalized at the time this Talent is activated. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"Once per encounter, as a Standard Action, you can make a Deception check and compare the result to the Will Defense of all enemies in your line of sight. If the check result equals or exceeds an enemy's Will Defense, that enemy must spend a Swift Action in addition to a Standard Action to make an attack until the start of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Once per round, as a Swift Action, you can designate a target within 12 squares of you and in your line of sight as the target of this Talent. Until the beginning of your turn, you can cause that target to take a -5 penalty on all checks made with a single Skill. You must have line of sight to your target to make use of this Talent, and declare which Skill is to be penalized at the time this Talent is activated. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["action-economy","defender","mobility","positioning","scoundrel","skills","social","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hesitate"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.1c381292494e3139"}}},{"_id":"4cedebaaa42594df","name":"Inspire Confidence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","description":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","controller","defender","leader","mobility","noble","striker","support"]},"effects":[{"_id":"1faa089c-9609-46d8-8543-9a68ace3553b","name":"Inspire Confidence","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Confidence"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_confidence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4d8882a28da30454"}}},{"_id":"3ef16c5f51b7f763","name":"Influential Friends","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":"Connections","benefit":"Once per day, friends may take 20 on a skill check with modifier equal to 5 + half your heroic level; time taken is 10 × result minimum.","description":"Once per day, allies may take 20 on skill checks using your modifier.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.connections"}],"_source":"canonical-csv"},"treeId":"b5bb4154688c66ab","tags":["feat-chain","noble","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.influential_friends"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.471f4294820ce5ec"}}},{"_id":"61c1348e015a3d57","name":"Sow Confusion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"Hesitate","benefit":"Once per encounter, make Deception vs Will Defense against a target in line of sight; target must spend a swift action with their standard action to attack until your next turn.","description":"Once per encounter, force a target to spend a swift action to attack.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.hesitate"}],"_source":"canonical-csv"},"treeId":"67b59e020c1660eb","tags":["action-economy","defender","feat-chain","mobility","scoundrel","skills","social","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.sow_confusion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.6b09fe0c6fe98367"}}},{"_id":"e6bf484fdef28df6","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+5","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":7,"flatDamageFormula":"1d4+5","useFlat":true}}}},{"_id":"8a77f91261bf5461","name":