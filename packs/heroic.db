svg/sword.svg","system":{"damage":"2d8+5(Ion)","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":17,"flatDamageFormula":"2d8+5(Ion)","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Small","Species":"Chadra-Fan","Nonheroic Level":0,"Class Levels":{"Jedi":8,"Knight":4},"Destiny Points":0,"Force Points":0,"Dark Side Points":0,"Initiative":14,"Senses":"Darkvision, Perception +13","Languages":["Basic","Binary","Bocce","Chadra-Fan","Mon Calamarian","Ryl"],"Unassigned Languages":0,"Reflex Defense":28,"Flat-Footed Defense":25,"Fortitude Defense":24,"Will Defense":26,"Hit Points":101,"Damage Threshold":24,"Speed":"4 Squares","Melee Weapons":"Unarmed +15 (1d3+5), Lightsaber +17 (2d8+5 ( Ion ))","Ranged Weapons":"By Weapon +15","Base Attack Bonus":12,"Grapple":10,"Attack Options":["Defensive Acuity","Weapon Finesse"],"Special Actions":["Droidcraft","Expert Droid Repair","Superior Tech (Droids)","Tech Specialist"],"Force Powers":["Drain Energy","Ionize","Technometry"],"Force Secrets":[],"Force Techniques":["Force Techniques : Improved Ionize","Improved Technometry"],"Strength":8,"Dexterity":16,"Constitution":10,"Intelligence":18,"Wisdom":14,"Charisma":12,"Tal