featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"5487ddd1b85c47a1","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"99cb9faa2f56002b","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"30e25fcfb45af160","name":"Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"9a585e91af68e4c5","name":"Assault Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Military Tactics","prerequisites":"Trained in Initiative","benefit":"You can use the , Deployment Tactics, or Field Tactics Talent as a Swift Action, instead of a Move Action (provided you have the Talent in question). Reference Book: Star Wars Saga Edition Unknown Regions During the first round of combat in an encounter (after the Surprise Round, if any), you can take your turn before any of your allies, but you must use either the Share Talent Prestige Class ability or a Talent from one of the following Talent Trees as part of your turn: Commando Talent Tree, Leadership Talent Tree, or Military Tactics Talent Tree. On the subsequent round, you return to your normal place in the Initiative Order. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisite: When you use the Talent on an enemy, the target takes a cumulative -1 penalty to its Reflex Defense each time it is damaged by one of your allies (maximum -5 penalty). This penalty applies until the end of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide As a Swift Action, once per encounter, you can grant bonus Hit Points equal to 5 + one-half your Character Level to allies within 20 squares of you and in your line of sight. Damage is subtracted from the bonus Hit Points first, and any bonus Hit Points remaining at the end of the encounter go away. Bonus Hit Points from multiple sources do not stack. Reference Book: Star Wars Saga Edition Unknown Regions Your tactics confuse enemy commanders and tacticians that can see or otherwise observe your forces in action, such as when using sensors. After using the Share Talent special quality, make a Knowledge (Tactics) check as a Free Action. The result replaces the DC of any Talents that use Knowledge (Tactics) from the Military Tactics Talent Tree used against your or your allies. Reference Book: Star Wars Saga Edition Unknown Regions If you have already used a Talent in an encounter before granting the same Talent to an ally with your Share Talent special quality in the same encounter, any character who benefits from Share Talent gains one of the following bonuses when using that talent (if the Talent can be affected by more than one effect, the character using the Talent selects the desired effect): Reduce the Talent's DC by 5. Gain an additional +2 bonus to any bonus to attack, Defense, or damage used by the Talent. Reduce the amount of damage taken by the character through the use of the Talent by 10 points. Reference Book: Star Wars Saga Edition Unknown Regions","description":"You can use the , Deployment Tactics, or Field Tactics Talent as a Swift Action, instead of a Move Action (provided you have the Talent in question). Reference Book: Star Wars Saga Edition Unknown Regions During the first round of combat in an encounter (after the Surprise Round, if any), you can take your turn before any of your allies, but you must use either the Share Talent Prestige Class ability or a Talent from one of the following Talent Trees as part of your turn: Commando Talent Tree, Leadership Talent Tree, or Military Tactics Talent Tree. On the subsequent round, you return to your normal place in the Initiative Order. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisite: When you use the Talent on an enemy, the target takes a cumulative -1 penalty to its Reflex Defense each time it is damaged by one of your allies (maximum -5 penalty). This penalty applies until the end of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide As a Swift Action, once per encounter, you can grant bonus Hit Points equal to 5 + one-half your Character Level to allies within 20 squares of you and in your line of sight. Damage is subtracted from the bonus Hit Points first, and any bonus Hit Points remaining at the end of the encounter go away. Bonus Hit Points from multiple sources do not stack. Reference Book: Star Wars Saga Edition Unknown Regions Your tactics confuse enemy commanders and tacticians that can see or otherwise observe your forces in action, such as when using sensors. After using the Share Talent special quality, make a Knowledge (Tactics) check as a Free Action. The result replaces the DC of any Talents that use Knowledge (Tactics) from the Military Tactics Talent Tree used against your or your allies. Reference Book: Star Wars Saga Edition Unknown Regions If you have already used a Talent in an encounter before granting the same Talent to an ally with your Share Talent special quality in the same encounter, any character who benefits from Share Talent gains one of the following bonuses when using that talent (if the Talent can be affected by more than one effect, the character using the Talent selects the desired effect): Reduce the Talent's DC by 5. Gain an additional +2 bonus to any bonus to attack, Defense, or damage used by the Talent. Reduce the amount of damage taken by the character through the use of the Talent by 10 points. Reference Book: Star Wars Saga Edition Unknown Regions","class":"Officer","costNumeric":null,"category":"Officer","tree":"Military Tactics","treeId":"9253ace716c3e966","tags":["action-economy","ambush","controller","damage-reduction","defender","feat-chain","force","force-control","force-defense","force-offense","leader","leadership","mobility","positioning","scaling","scout","skills","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.assault_tactics"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d9fe8a0c76d845d4"}}},{"_id":"50aa473a9d3d9c50","name":"Blast Back","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Unpredictable","prerequisites":"","benefit":"Once per encounter when you miss a target with a single melee or ranged attack, as a Free Action you can move up to half your speed and make a second attack of the same type against a different target. This movement doesn't provoke Attacks of Opportunity. If you have the Combat Reflexes feat, you may use this Talent a number of times per encounter equal to your Dexterity bonus (minimum 1). You may still only use this Talent once per round.","description":"Once per encounter when you miss a target with a single melee or ranged attack, as a Free Action you can move up to half your speed and make a second attack of the same type against a different target. This movement doesn't provoke Attacks of Opportunity. If you have the Combat Reflexes feat, you may use this Talent a number of times per encounter equal to your Dexterity bonus (minimum 1). You may still only use this Talent once per round.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Unpredictable","treeId":"5a30489609182e8c","tags":["action-economy","controller","melee","mobility","positioning","ranged","scout","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.blast_back"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.2d486ece7350cedf"}}},{"_id":"d5e873522d4ff19a","name":"Hailfire","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Pistoleer","prerequisites":"Dual Weapon Mastery I","benefit":"With two pistols, attack as if autofire even without autofire, applying autofire penalties.","description":"When wielding two pistols, you may attack as if using autofire; autofire penalties apply.","class":"Gunslinger","costNumeric":null,"category":"Gunslinger","tree":"Pistoleer","treeId":"ed77ab2e234089ed","tags":["burst-damage","feat-chain","ranged","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hailfire"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.223ba62ffbabb9c2"}}},{"_id":"552ff0732fc32428","name":"Improved Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Armor Specialist","prerequisites":"Armored Defense","benefit":"Your Reflex Defense bonus equals either your heroic level + half your armor bonus, or your armor bonus.","description":"Your Reflex Defense bonus equals either your heroic level plus half your armor bonus or your armor bonus.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Armor Specialist","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.armored_defense"}],"_source":"canonical-csv"},"treeId":"17cec542331cb4e4","tags":["armor","defender","feat-chain","soldier","striker","talent-chain"]},"effects":[{"_id":"842ee02b-8f7e-4a40-802a-c6fe553379a5","name":"Improved Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Improved Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.394809ed8baff1b9"}}},{"_id":"62490b5766ea9f21","name":"Second Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Unpredictable","prerequisites":"Blast Back","benefit":"Once per encounter, when you miss, move half your speed and attack ano