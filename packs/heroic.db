tNumeric":null,"forcePowerGrants":1,"description":{"value":"Learn a number of <a href=\"/wiki/Force_Powers\" title=\"Force Powers\">Force Powers</a> equal to 1 + your <a href=\"/wiki/Wisdom\" title=\"Wisdom\">Wisdom</a> modifier (minimum 1)."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"usetheforce"}],"_source":"canonical-csv"}},"effects":[{"_id":"d1c60a9b-78e6-4601-85a4-320794fa5a91","name":"Force Training","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Force Training","effectType":"passive_effect","flagType":"Force Training"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.9b7b869a86f39190"}}},{"_id":"57840eaaa4faa620","name":"Improved Damage Threshold","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Your damage threshold increases by 5.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["defender","non-force","scout","soldier","striker"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"<a class=\"mw-redirect\" href=\"/wiki/Damage_Threshold\" title=\"Damage Threshold\">Damage Threshold</a> increases by 5 points."}},"effects":[{"name":"Improved Damage Threshold","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.damageThreshold","mode":2,"value":"5","priority":20}],"transfer":true}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.96666de28ba99b64"}}},{"_id":"5d6ee2902d06fb2e","name":"Melee Defense","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"As a swift action, you may take a -5 penalty on melee attack rolls to gain a +5 bonus to your Reflex Defense against melee attacks until the start of your next turn.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["action-economy","defender","melee","mobility","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Trade attack bonus on melee attacks for a dodge bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"int","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.3a847230d573a623"}}},{"_id":"7896a0fb40b988d0","name":"Rapid Strike","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"When making a full attack with a melee weapon, you may make one additional attack. All attacks take a -2 penalty.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","melee","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Take a -2 penalty on a melee attack roll to deal +1 die of damage."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ccb33e58342499a3"}}},{"_id":"ae48b9e4aff960e4","name":"Skill Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +5 bonus on all checks with the selected skill.","prerequisite":"Trained in the chosen skill","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","noble","non-force","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"c8a299ea094334c1","name":"Skill Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You become trained in one additional skill. You may take this feat multiple times.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["noble","non-force","scaling","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You become <a class=\"mw-redirect\" href=\"/wiki/Trained\" title=\"Trained\">Trained</a> in one Class Skill."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"3c56ffe2fe30f7f2","name":"Weapon Finesse","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may use your Dexterity modifier instead of Strength for attack rolls with light melee weapons.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","melee","non-force","scoundrel","scout"],"bonus_feat_for":["Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Use <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> modifier instead of <a href=\"/wiki/Strength\" title=\"Strength\">Strength</a> modifier on attack rolls with Light Melee Weapons and <a href=\"/wiki/Lightsabers\" title=\"Lightsabers\">Lightsabers</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.252b67d6e31c377e"}}},{"_id":"cbc209ef61ae223b","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"0a274d683988f866","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"8c070f532ee7e647","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"5077677f2a0df8a4","name":"Improved Dark Rage","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"When you use the Dark Rage Force Power, you ignore the restriction that prevents you from using Skills or performing tasks that require patience and concentration.","prerequisite":"Dark Rage","special":"Additionally, you can always activate Dark Rage in the Surprise Round, even if you are considered Surprised.","normalText":"","sourcebook":"Force Unleashed Campaign Guide","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>When you use the Dark Rage Force Power, you ignore the restriction that prevents you from using Skills or performing tasks that require patience and concentration.</p><p><strong>Special:</strong> Additionally, you can always activate Dark Rage in the Surprise Round, even if you are considered Surprised.</p><p><strong>Related Power:</strong> Dark Rage</p><p><strong>Prerequisites:</strong> Dark Rage</p>","relatedPower":"Dark Rage"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.b10cf49890093fab"}}},{"_id":"e9b70d61d8ce3a92","name":"Block","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith Alchemy","prerequisites":"","benefit":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","description":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Sith Alchemy","treeId":"a67faf2ae089ab5d","tags":["action-economy","armor","dark-side","defender","force","force-offense","jedi","lightsaber","melee","mobility","ranged","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.block"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9379daa94a228c04"}}},{"_id":"872593e116526b1b","name":"Dual Weapon Flourish I","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Duelist","prerequisites":"Prerequisites: Trained in Deception, Weapon Finesse","benefit":"Prerequisites: Dual Weapon Mastery I, Dual Weapon Mastery II, , Master of Elegance, Weapon Finesse When wielding only two light melee weapons or two Lightsabers, once per turn on your turn, you can make a Full Attack Action as a Standard Action, rather than a Full-Round Action, provided you attack with both weapons during the attack. You apply the normal penalties for fighting with two weapons to both of these attacks. Prerequisites: or Single Weapon Flourish I, Weapon Finesse You may add your Dexterity bonus (instead of your Strength bonus) on damage rolls when wielding a light melee weapon. When you wield a light melee weapon two-handed, you may apply double your Dexterity bonus (instead of double your Strength bonus) to the damage. Whenever you make multiple attacks with Advanced Melee Weapons as a Full Attack Action, you reduce the penalty on your attack rolls by 2 points. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2 points. Once per encounter, as a Free Action on your turn, you can make an attack with a light melee weapon or Lightsaber after a successful Feint. When you wield only a single light melee weapon, or a single Lightsaber, and use the Full Attack Action, once per turn; you can Move up to your Speed as a Free Action at any time during your turn.","description":"Prerequisites: Dual Weapon Mastery I, Dual Weapon Mastery II, , Master of Elegance, Weapon Finesse When wielding only two light melee weapons or two Lightsabers, once per turn on your turn, you can make a Full Attack Action as a Standard Action, rather than a Full-Round Action, provided you attack with both weapons during the attack. You apply the normal penalties for fighting with two weapons to both of these attacks. Prerequisites: or Single Weapon Flourish I, Weapon Finesse You may add your Dexterity bonus (instead of your Strength bonus) on damage rolls when wielding a light melee weapon. When you wield a light melee weapon two-handed, you may apply double your Dexterity bonus (instead of double your Strength bonus) to the damage. Whenever you make multiple attacks with Advanced Melee Weapons as a Full Attack Action, you reduce the penalty on your attack rolls by 2 points. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2 points. Once per encounter, as a Free Action on your turn, you can make an attack with a light melee weapon or Lightsaber after a successful Feint. When you wield only a single light melee weapon, or a single Lightsaber, and use the Full Attack Action, once per turn; you can Move up to your Speed as a Free Action at any time during your turn.","class":"Melee Duelist","costNumeric":null,"category":"Melee Duelist","tree":"Melee Duelist","treeId":"1381bb8c9a838279","tags":["action-economy","burst-damage","controller","damage-reduction","dual-wield","feat-chain","lightsaber","melee","mobility","scaling","striker","sustained-damage","talent-chain"]},"effects":[{"_id":"4f9b4473-b5bf-4389-b36a-2d31234a5140","name":"Dual Weapon Flourish I","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks.dualWield","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Dual Weapon Flourish I"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.dual_weapon_flourish_i"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5004013069710c3e"}}},{"_id":"735c3291ef918a75","name":"Evasion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Survivor","prerequisites":null,"benefit":"If hit by an area attack, take half or no damage.","description":"Take half or no damage from area attacks.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Survivor","treeId":"9b06340233eb3cdd","tags":["battlefield-control","evasion","scout","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.evasion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5400bc8cb1200624"}}},{"_id":"e9b44f0d6a180482","name":"Improved Stealth","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Camouflage","prerequisites":"","benefit":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scout","costNumeric":null,"category":"Scout","tree":"Camouflage","treeId":"3926d582d2077489","tags":["action-economy","ambush","controller","mobility","perception","piloting","positioning","ranged","scout","skills","stealth","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_stealth"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.073115894cad8cf9"}}},{"_id":"2000a9b99a218ee2","name":"Master of Elegance","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Duelist","prerequisites":"","benefit":"Prerequisites: Double Attack with either Advanced Melee Weapons, an Exotic Weapon (Melee), or Lightsabers; , Single Weapon Flourish I, Weapon Finesse When you wield only a single light melee weapon, or a single Lightsaber, once per turn on your turn, you can make a Full Attack Action as a Standard Action, instead of a Full-Round Action.","description":"Prerequisites: Double Attack with either Advanced Melee Weapons, an Exotic Weapon (Melee), or Lightsabers; , Single Weapon Flourish I, Weapon Finesse When you wield only a single light melee weapon, or a single Lightsaber, once per turn on your turn, you can make a Full Attack Action as a Standard Action, instead of a Full-Round Action.","class":"Melee Duelist","costNumeric":null,"category":"Melee Duelist","tree":"Melee Duelist","treeId":"1381bb8c9a838279","tags":["action-economy","lightsaber","melee","sustained-damage"]},"effects":[{"_id":"7e0e71c5-4333-442a-ae60-0b4a8d53f64b","name":"Master of Elegance","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.light_melee","mode":2,"value":"dex_bonus"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Master of Elegance"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.master_of_elegance"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.fc986d810732ff3a"}}},{"_id":"5fd811b7a388bc2b","name":"Melee Smash","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Specialist","prerequisites":"","benefit":"Unrelenting Assault You twirl your Weapon around you in a blur, creating a circle of death around you. Any enemy target that begins its turn adjacent to you takes damage equal to your Strength bonus. You must be wielding a Melee Weapon to be using this Talent.","description":"Unrelenting Assault You twirl your Weapon around you in a blur, creating a circle of death around you. Any enemy target that begins its turn adjacent to you takes damage equal to your Strength bonus. You must be wielding a Melee Weapon to be using this Talent.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Melee Specialist","treeId":"fad8118981c532f0","tags":["melee","positioning","soldier","striker","sustained-damage"]},"effects":[{"_id":"2d692811-5c22-48b8-944d-45db89ca5e77","name":"Melee Smash","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.melee","mode":5,"value":"half_level"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Melee Smash"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.melee_smash"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e0ee525f4109cfde"}}},{"_id":"a1dd98233e84ca18","name":"Multiattack Proficiency (lightsabers)","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Battlemaster","prerequisites":"","benefit":"Dual Weapon Mastery I, Weapon Focus (Lightsabers) Immediately after making a Full Attack where you attacked with two Lightsabers (or both ends of a Double-Bladed Lightsaber), you may Move up to your Speed as a Free Action.","description":"Dual Weapon Mastery I, Weapon Focus (Lightsabers) Immediately after making a Full Attack where you attacked with two Lightsabers (or both ends of a Double-Bladed Lightsaber), you may Move up to your Speed as a Free Action.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Jedi Battlemaster","treeId":"dfc4142435b4356d","tags":["action-economy","controller","dual-wield","force","force-control","force-offense","jedi","light-side","lightsaber","melee","mobility"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.multiattack_proficiency_lightsabers"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.317400e9ea2b66c7"}}},{"_id":"cc718a4195549515","name":"Stunning Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Specialist","prerequisites":"","benefit":"When you damage an opponent with a melee attack that moves the target down the Condition Track, the target cannot take any Action requiring a Standard Action or a Full-Round Action on its next turn.","description":"When you damage an opponent with a melee attack that moves the target down the Condition Track, the target cannot take any Action requiring a Standard Action or a Full-Round Action on its next turn.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Melee Specialist","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.melee_smash"}],"_source":"canonical-csv"},"treeId":"fad8118981c532f0","tags":["action-economy","condition-removal","controller","melee","mobility","soldier","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.stunning_strike"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9292819462b46074"}}},{"_id":"f1dc2ec8b2f17fca","name":"Dark Rage","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Dark Rage"}}},{"_id":"13b944d893743ed9","name":"Draw Closer","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Draw Closer"}}},{"_id":"6093ac548c8f0377","name":"Force Grip","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":3,"discipline":"dark-side","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Concentration","effect":"<p>You use the Force to telekinetically choke or crush your target. The target takes damage each round based on your Use the Force check result.</p>","special":"<p>This is a Dark Side power. The target is immobilized while gripped.</p>","descriptor":["Dark Side","Telekinetic"],"dcChart":[{"dc":15,"effect":"2d6 damage/round","description":"Target takes 2d6 damage per round and is immobilized"},{"dc":20,"effect":"4d6 damage/round","description":"Target takes 4d6 damage per round and is immobilized"},{"dc":25,"effect":"6d6 damage/round + lift","description":"Target takes 6d6 damage per round, is immobilized, and lifted off ground"},{"dc":30,"effect":"8d6 damage/round + crush","description":"Target takes 8d6 damage per round and is being crushed (fort save or die)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["attack","damage","dark-side","telekinetic","immobilize"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f41a957f71e98a6a"}}},{"_id":"38e8c23dccfdfc06","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"0faf770cf64605f2","name":"Pushing Slash","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Pushing Slash"}}},{"_id":"05491ec56a3c1f62","name":"Rising Whirlwind","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","tar