 Defense","Battle Analysis","Deployment Tactics","Field Tactics","Indomitable","Juggernaut","Mandalorian Advance","Mandalorian Ferocity (Pistols)","Mandalorian Glory"],"Feats":["Feats : Accelerated Strike","Armor Proficiency (Light)","Armor Proficiency (Medium)","Armor Proficiency (Heavy)","Charging Fire","Dual Weapon Mastery I","Implant Training","Mandalorian Training","Martial Arts I","Point-Blank Shot","Precise Shot","Weapon Focus (Rifles)","Weapon Proficiency (Pistols)","Weapon Proficiency (Rifles)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Endurance","Initiative","Knowledge (Tactics)","Mechanics","Perception","Pilot"],"Trained Skills":["Skills : Endurance","Initiative","Knowledge (Tactics)","Mechanics","Perception","Pilot"],"Species Traits":[],"Gear":"Heavy Beskar'gam with Helmet Package (+10 Reflex , +4 Fortitude ; +2 Perception , Low-Light Vision), Blaster Gauntlet (2), Dagger Gauntlet, Light Repeating Blaster , Implants ( Bio-Stabilizer Implant , Cardio Implant , Nerve Reinforcement Implant , Regenerative Implant ), Basilisk War Droid"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
{"_id":"81d8604f591c3123","name":"Demagol","type":"npc","img":"icons/svg/mystery-man.svg","system":{"isDroid":false,"droidDegree":"","attributes":{"str":{"base":12,"racial":0,"enhancement":0,"temp":0},"dex":{"base":15,"racial":0,"enhancement":0,"temp":0},"con":{"base":12,"racial":0,"enhancement":0,"temp":0},"int":{"base":20,"racial":0,"enhancement":0,"temp":0},"wis":{"base":18,"racial":0,"enhancement":0,"temp":0},"cha":{"base":15,"racial":0,"enhancement":0,"temp":0}},"skills":{"acrobatics":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"dex","favorite":false},"climb":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"str","favorite":false},"deception":{"trained":true,"focused":true,"miscMod":0,"selectedAbility":"cha","favorite":false},"endurance":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"con","favorite":false},"gatherInformation":{"trained":true,"focused":false,"miscMod":0,"selectedAbility":"cha","favorite":false},"initiative":{"trained":true,"focused":false,"miscMod":0,"selectedAbility":"dex","favorite":false},"jump":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"str","favorite":false},"knowledgeBureaucracy":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeGalacticLore":{"trained":true,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeLifeSciences":{"trained":true,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgePhysicalSciences":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeSocialSciences":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeTactics":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeTechnology":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"mechanics":{"trained":false,"focused":false,"miscMod":