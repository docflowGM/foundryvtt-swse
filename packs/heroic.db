3,"Will Defense":15,"Hit Points":20,"Damage Threshold":13,"Speed":"6 Squares","Melee Weapons":"Unarmed +4 (1d4+1), Lightsaber -1 (2d8+1)","Ranged Weapons":"Heavy Blaster Pistol +6 (3d8+1), Hold-Out Blaster Pistol +6 (3d4+1)","Base Attack Bonus":4,"Grapple":6,"Attack Options":["Bantha Herder"],"Special Actions":["Disruptive","Knack","Shapeshift","Startle"],"Force Powers":["Force Thrust","Rebuke"],"Force Secrets":[],"Force Techniques":[],"Strength":10,"Dexterity":14,"Constitution":10,"Intelligence":12,"Wisdom":12,"Charisma":18,"Talents":["Talents : Disruptive","Knack"],"Feats":["Feats : Bantha Herder","Force Sensitivity","Force Training","Skill Focus (Deception)","Skill Focus (Use the Force)","Skill Training (Use the Force)","Weapon Proficiency (Pistols)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Deception","Initiative","Use the Force"],"Trained Skills":["Skills : Deception","Initiative","Use the Force"],"Species Traits":[],"Gear":"Heavy Blaster Pistol , Hold-Out Blaster Pistol , Lightsaber , Comlink (Short-Range), Datapad , Stolen Jedi Robes, Street Clothes"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
