ks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"a9af4c8307d2395f","name":"Vehicular Combat","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Once per round, when your vehicle is hit in combat, you may make a Pilot check to negate the hit.","prerequisite":"Pilot 1 rank","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","scout","striker","sustained-damage"],"bonus_feat_for":["Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Negate one attack per round against the <a class=\"mw-redirect\" href=\"/wiki/Vehicle\" title=\"Vehicle\">Vehicle</a> you're piloting."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"b8dad0c963f046c6"}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1f2f70d34a17667d"}}},{"_id":"9f8a473b3d6c86b7","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costN