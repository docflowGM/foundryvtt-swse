iki/Light_Armor\" title=\"Light Armor\">Light Armor</a>."}},"effects":[{"_id":"9781a3c7-4e7e-4af0-9dcc-cdea0524b414","name":"Armor Proficiency (Light)","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.armorProficiency.light","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Armor Proficiency (Light)","effectType":"armor_proficiency"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.773ec00effc7e96f"}}},{"_id":"2e38536731ef7f9c","name":"Careful Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"If you Aim, gain +1 bonus on the attack roll.","prerequisite":"Point-Blank Shot, Base Attack Bonus +2","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["feat-chain","non-force","ranged","striker"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"If you <a href=\"/wiki/Aim\" title=\"Aim\">Aim</a>, gain +1 bonus on the attack roll."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":2}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.62fdf44c56b24507"}}},{"_id":"0f3b174442c69f9d","name":"Deadeye","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may reroll a ranged attack roll once per encounter and take the better result.","prerequisite":"Point Blank Shot","special":"","normalText":"","sourcebook":"Galaxy at War","page":24,"tags":["feat-chain","non-force","positioning","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"If you <a href=\"/wiki/Aim\" title=\"Aim\">Aim</a>, deal extra damage."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"ba