cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"20abfdac91ddabf3","name":"Devastating Power","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-secret.png","system":{"featType":"force","benefit":"When using a Force Power that deals damage, you can spend a Force Point to increase the Power's damage dice by 50%.","prerequisite":"","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-secret"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":"<p><strong>Cost:</strong> Force Point or Destiny Point</p><p>When using a Force Power that deals damage, you can spend a Force Point to increase the Power's damage dice by 50%.</p><p>Alternatively, you can spend a Destiny Point to double the amount of damage dice.</p>","cost":"Force Point or Destiny Point","alternativeCost":"Alternatively, you can spend a Destiny Point to double the amount of damage dice."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcesecrets.996848a2e0c0ac4f"}}},{"_id":"abe7617659d4cc4e","name":"Force Point Recovery","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"At the end of an encounter, you automatically recover 1 Force Point spent during the encounter.","prerequisite":"","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>At the end of an encounter, you automatically recover 1 Force Point spent during the encounter.</p>","relatedPower":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.056ab39b3ab9df10"}}},{"_id":"4fd96ad0e50cda2e","name":"Improved Sense Force","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may use the Sense Force ability of the Use the Force Skill as a Move Action rather than a Full-Round Action.","prerequisite":"Sense Force","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may use the Sense Force ability of the Use the Force Skill as a Move Action rather than a Full-Round Action.</p><p><strong>Related Power:</strong> Sense Force</p><p><strong>Prerequisites:</strong> Sense Force</p>","relatedPower":"Sense Force"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.ad67b8f3959860f2"}}},{"_id":"19fbe29346bc0c84","name":"Adept Negotiator","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Consular","prerequisites":"","benefit":"You can use your Use the Force modifier instead of your Persuasion check modifier when making a Persuasion check. You are considered Trained in the Persuasion skill. If you are entitled to a Persuasion check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisite: If you successfully use the Talent, your target moves an additional -1 step along the Condition Track. This is a Mind-Affecting effect. You affect the Condition Track of the specific character (usually the Vehicle's Commander), not a Starship. You can spend a Full-Round Action advising an ally, thereby granting them a +5 bonus on their next Skill Check. If you spend a Force Point, the bonus increases to +10. The target must be able to (and willing) to hear and understand your voice. You cannot advise yourself. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual As a Standard Action, you can peer into The Force and search for weaknesses in the defenses of your enemies. Make a Use the Force check against the Will Defense of a target creature within 12 squares of you and in your line of sight. If the Skill Check equals or exceeds the target's Will Defense, that target takes a -2 penalty to their Reflex Defense against you and all allies who can hear and understand you until the end of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever you damage an opponent with a Lightsaber attack, you can Take 10 on any Persuasion checks you make before the end of your next turn, even if you would not normally be able to. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: Once per encounter as a Swift Action, you can choose one ally within your line of sight that can hear and understand you. Until the end of the encounter, that ally adds your Wisdom bonus to its Will Defense against Mind-Affecting effects. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per turn as a Swift Action, you can spend a Force Point to let one adjacent ally use the Aid Another Action (as a Reaction) to assist you with a Skill Check. You must make the Skill Check before the end of your turn, or the benefit of the Aid Another Action is lost. An ally that has already used the Aid Another Action to assist you since the end of your last turn may not be targeted by this Talent. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You gain a +2 insight bonus to your Will Defense. Also, as a Swift Action, you can spend a Force Point to give all allies within 6 squares of you a +2 insight bonus to their Will Defense that lasts for the remainder of the encounter. This bonus does not extend to allies outside the range of the effect, even if they move within 6 squares of you later on. Allies who benefit from this Talent must remain within 6 squares of you to retain the insight bonus, and they lose it if you are knocked unconscious or killed. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Rebellion Era Campaign Guide When you deal damage to a target by making a Lightsaber attack on your turn, you can use a Swift Action before the end of your turn to activate this Talent. If you do so, allies adjacent to the target at the time you make the attack gain a +2 circumstance bonus to melee attack rolls against the target until the start of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","description":"You can use your Use the Force modifier instead of your Persuasion check modifier when making a Persuasion check. You are considered Trained in the Persuasion skill. If you are entitled to a Persuasion check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisite: If you successfully use the Talent, your target moves an additional -1 step along the Condition Track. This is a Mind-Affecting effect. You affect the Condition Track of the specific character (usually the Vehicle's Commander), not a Starship. You can spend a Full-Round Action advising an ally, thereby granting them a +5 bonus on their next Skill Check. If you spend a Force Point, the bonus increases to +10. The target must be able to (and willing) to hear and understand your voice. You cannot advise yourself. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual As a Standard Action, you can peer into The Force and search for weaknesses in the defenses of your enemies. Make a Use the Force check against the Will Defense of a target creature within 12 squares of you and in your line of sight. If the Skill Check equals or exceeds the target's Will Defense, that target takes a -2 penalty to their Reflex Defense against you and all allies who can hear and understand you until the end of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever you damage an opponent with a Lightsaber attack, you can Take 10 on any Persuasion checks you make before the end of your next turn, even if you would not normally be able to. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: Once per encounter as a Swift Action, you can choose one ally within your line of sight that can hear and understand you. Until the end of the encounter, that ally adds your Wisdom bonus to its Will Defense against Mind-Affecting effects. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per turn as a Swift Action, you can spend a Force Point to let one adjacent ally use the Aid Another Action (as a Reaction) to assist you with a Skill Check. You must make the Skill Check before the end of your turn, or the benefit of the Aid Another Action is lost. An ally that has already used the Aid Another Action to assist you since the end of your last turn may not be targeted by this Talent. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You gain a +2 insight bonus to your Will Defense. Also, as a Swift Action, you can spend a Force Point to give all allies within 6 squares of you a +2 insight bonus to their Will Defense that lasts for the remainder of the encounter. This bonus does not extend to allies outside the range of the effect, even if they move within 6 squares of you later on. Allies who benefit from this Talent must remain within 6 squares of you to retain the insight bonus, and they lose it if you are knocked unconscious or killed. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Rebellion Era Campaign Guide When you deal damage to a target by making a Lightsaber attack on your turn, you can use a Swift Action before the end of your turn to activate this Talent. If you do so, allies adjacent to the target at the time you make the attack gain a +2 circumstance bonus to melee attack rolls against the target until the start of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Consular","treeId":"e99cfa9db8493573","tags":["action-economy","condition-removal","controller","defender","force","force-control","force-defense","force-offense","jedi","leader","light-side","lightsaber","melee","mobility","positioning","scout","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.adept_negotiator"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7acc479dee2d3b10"}}},{"_id":"3f2a15c41437dec9","name":"Dark Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Dark Side","prerequisites":"","benefit":"Power of the Dark Side Whenever an ally of equal or higher level than you is killed or reduced to 0 hit points within your line of sight, you gain a +2 Force bonus on attack rolls and damage rolls until the end of the encounter. (Since Force bonuses do not stack, you don't get a higher bonus if more than one ally falls in the same encounter.)","description":"Power of the Dark Side Whenever an ally of equal or higher level than you is killed or reduced to 0 hit points within your line of sight, you gain a +2 Force bonus on attack rolls and damage rolls until the end of the encounter. (Since Force bonuses do not stack, you don't get a higher bonus if more than one ally falls in the same encounter.)","costNumeric":null,"tree":"Dark Side","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"cha","min":13},{"type":"talent","id":"swse.talent.power_of_the_dark_side"}],"_source":"canonical-csv"},"treeId":"de95d37c72b1c4cd","tags":["damage-reduction","dark-side","force","force-offense","scaling","striker","support"]},"effects":[{"_id":"b278be01-b200-4515-abdb-7137e70ffebf","name":"Dark Presence","icon":"icons/svg/moon.svg","changes":[{"key":"system.defenses.all","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Dark Presence"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.dark_presence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.606e14c428f1d159"}}},{"_id":"fbecb6ff58acff2e","name":"Dark Side Adept","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith","prerequisites":"Prerequisites: Any One Force Technique, Weapon Focus (Lightsabers)","benefit":"Force Powers that are strongly tied to the Dark Side flow through you more easily. You can reroll any Use the Force check made when activating Force Powers with the [Dark Side] descriptor, and can spend a Force Point to keep the better of the two results. You can use your Use the Force modifier instead of your Deception check modifier when making Deception checks, as you use The Force to cloak your vile treachery. You are considered Trained in the Deception skill. If you are entitled to a Deception check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisites: , Dark Side Master Your knowledge of Sith sorcery allows you to imbue talismans and other objects with the power of the Dark Side. Create Sith Talisman: You can spend one Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power or Lightsaber attack. Creating the talisman takes a Full-Round Action. While you wear or carry a Sith Talisman on your person, add 1d6 to damage rolls with your Force Powers. You increase your Dark Side Score by one when you first put on or carry a Sith Talisman. You can only have one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a properly prepared weapon to become a Sith Weapon. You may spend a Force Point to imbue the weapon with the properties of the Sith Alchemical Weapon Template (this process takes one hour to complete). Reference Book: Star Wars Saga Edition Threats of the Galaxy You have learned how to use a Jedi fighting technique to defeat Jedi in combat. Choose one Talent from the Lightsaber Forms Talent Tree; you gain the benefits of this Talent and are considered to have this Talent for the purpose of satisfying prerequisites. You must meet all the prerequisites as normal for the chosen Talent, in addition to the prerequisites of this Talent. You can select this Talent multiple times. Each time you select it, choose a different Talent from the Lightsaber Forms Talent Tree. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: Any One Force Technique, Whenever you successfully activate a Force Power with the [Dark Side] descriptor that causes the target to move down the Condition Track, they gain a Persistent Condition, which can only be removed if the target receives Surgery (for living beings) or Repairs (for Droids, Vehicles, and objects). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Dark Side Master Once per encounter, you can spend a Force Point as a Standard Action to call upon the vengeful spirits of the ancient Sith. Doing so grants you 3 Followers with the Vengeful Spirit Template. These Followers appear in any unoccupied square adjacent to you, and last until the end of the encounter (at which point they vanish).","description":"Force Powers that are strongly tied to the Dark Side flow through you more easily. You can reroll any Use the Force check made when activating Force Powers with the [Dark Side] descriptor, and can spend a Force Point to keep the better of the two results. You can use your Use the Force modifier instead of your Deception check modifier when making Deception checks, as you use The Force to cloak your vile treachery. You are considered Trained in the Deception skill. If you are entitled to a Deception check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisites: , Dark Side Master Your knowledge of Sith sorcery allows you to imbue talismans and other objects with the power of the Dark Side. Create Sith Talisman: You can spend one Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power or Lightsaber attack. Creating the talisman takes a Full-Round Action. While you wear or carry a Sith Talisman on your person, add 1d6 to damage rolls with your Force Powers. You increase your Dark Side Score by one when you first put on or carry a Sith Talisman. You can only have one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a properly prepared weapon to become a Sith Weapon. You may spend a Force Point to imbue the weapon with the properties of the Sith Alchemical Weapon Template (this process takes one hour to complete). Reference Book: Star Wars Saga Edition Threats of the Galaxy You have learned how to use a Jedi fighting technique to defeat Jedi in combat. Choose one Talent from the Lightsaber Forms Talent Tree; you gain the benefits of this Talent and are considered to have this Talent for the purpose of satisfying prerequisites. You must meet all the prerequisites as normal for the chosen Talent, in addition to the prerequisites of this Talent. You can select this Talent multiple times. Each time you select it, choose a different Talent from the Lightsaber Forms Talent Tree. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: Any One Force Technique, Whenever you successfully activate a Force Power with the [Dark Side] descriptor that causes the target to move down the Condition Track, they gain a Persistent Condition, which can only be removed if the target receives Surgery (for living beings) or Repairs (for Droids, Vehicles, and objects). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Dark Side Master Once per encounter, you can spend a Force Point as a Standard Action to call upon the vengeful spirits of the ancient Sith. Doing so grants you 3 Followers with the Vengeful Spirit Template. These Followers appear in any unoccupied square adjacent to you, and last until the end of the encounter (at which point they vanish).","class":"Sith Apprentice","costNumeric":null,"category":"Sith Apprentice","tree":"Sith","treeId":"d1037bc7a08ea80b","tags":["action-economy","condition-removal","controller","dark-side","feat-chain","force","force-control","force-offense","jedi","leader","light-side","lightsaber","mechanics","melee","mobility","positioning","scaling","skills","social","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.dark_side_adept"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.cfdd73f3d939799d"}}},{"_id":"daa65ad2c9465c14","name":"Dark Side Master","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith","prerequisites":"Dark Side Adept","benefit":"Reroll any Dark Side skill check.","description":"You may reroll Dark Side skill checks.","class":"Sith Apprentice","costNumeric":null,"category":"Sith Apprentice","tree":"Sith","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.dark_side_adept"}],"_source":"canonical-csv"},"treeId":"d1037bc7a08ea80b","tags":["dark-side","feat-chain","force","jedi","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.dark_side_master"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d4fe49ef1701891e"}}},{"_id":"f65e29d8f707b0ba","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"bc0b14ffdbb5b33a","name":"Force Deception","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith","prerequisites":null,"benefit":"Use the Force replaces Deception checks and is treated as trained.","description":"Use the Force replaces Deception; you are considered trained.","class":"Sith Apprentice","costNumeric":null,"category":"Sith Apprentice","tree":"Sith","treeId":"d1037bc7a08ea80b","tags":["dark-side","force","jedi","skills","social"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_deception"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a40e25585a6f8c2b"}}},{"_id":"2154f827c0155c54","name":"Force Persuasion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Consular","prerequisites":"Adept Negotiator","benefit":"Use the Force instead of Persuasion for checks; considered trained in Persuasion.","description":"You may use Use the Force instead of Persuasion and are considered trained in Persuasion.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Consular","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.adept_negotiator"}],"_source":"canonical-csv"},"treeId":"e99cfa9db8493573","tags":["feat-chain","force","jedi","light-side","skills","social","talent-chain"]},"effects":[{"_id":"f8c30152-0d87-4368-a330-0f73d55cd21d","name":"Force Persuasion","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.skills.persuasion.substitute","mode":5,"value":"useTheForce"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Force Persuasion"}}},{"name":"Force Persuasion (Trained)","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.skills.persuasion.trained","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Force Persuasion","effectType":"skill-trained"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_persuasion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d1fd547124c1901c"}}},{"_id":"d0e25c493743a369","name":"Lightsaber Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Niman When you use the Talent, you gain twice the normal deflection bonus to your Reflex Defense when you are wielding two Lightsabers. Prerequisite: When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Talent increases by 2 (to a maximum of +5). When wielding a Lightsaber, you gain a +1 bonus to your Reflex Defense and Will Defense.","description":"Niman When you use the Talent, you gain twice the normal deflection bonus to your Reflex Defense when you are wielding two Lightsabers. Prerequisite: When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Talent increases by 2 (to a maximum of +5). When wielding a Lightsaber, you gain a +1 bonus to your Reflex Defense and Will Defense.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["defender","jedi","lightsaber","melee","striker"]},"effects":[{"_id":"fcdbf882-923a-4095-b0df-a1079c214099","name":"Lightsaber Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Lightsaber Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.lightsaber_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e8bf1222fd6289e4"}}},{"_id":"171b4fde0ebf621a","name":"Power of the Dark Side","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Dark Side","prerequisites":"Dark Side Score equal to Wisdom Score","benefit":"Charisma 13 As a Standard Action, you grant yourself and all allies within 6 squares of you a +1 Force bonus to all Defenses until the end of the encounter. These bonuses are lost if you fall unconscious or die. Affected allies that move out of range lose the benefits for as long as they remain out of range. Prerequisite: Once per day, you can use a Force Power that normally takes a Standard Action or a Move Action as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Sometimes your anger consumes you. As a Swift Action, you can take a -5 penalty to your Will Defense to gain a +2 Force bonus on attack rolls. The penalty and bonus last until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever an effect would normally move you down the Condition Track, you may spend a Force Point and increase your Dark Side Score by 1 to negate that movement down the Condition Track. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Once per encounter as a Swift Action, you can return one Force Power with the [Dark Side] descriptor to your Force Power Suite without spending a Force Point. You can select this Talent multiple times. Each time you select it, you can use it one additional time per encounter. Reference Book: Star Wars Saga Edition Threats of the Galaxy As a Standard Action, you can spend a Force Point to drain the knowledge of an opponent you touch; you must succeed on a Use the Force check (DC equal to the target's Will Defense) to activate this Talent, and if you fail to activate this Talent, you may not try again on the same target for one day. If successful, you immediately become Trained in one Skill that the target is Trained in; if you are already Trained in that Skill, you instead gain Skill Focus in that Skill. This effect lasts for one day. Additionally, your target moves -1 Persistent step along the Condition Track, and the Persistent Condition can be removed only by resting for 8 hours. Additionally, you can choose to instead sift through the mind of the target, looking for a specific piece of knowledge or information. Doing so requires you to make a Perception check against the target's Will Defense; success indicates that you pull the relevant information from the target's mind. When you do so, you do not gain the bonus Trained Skill or Skill Focus normally granted by this Talent, but otherwise the Talent functions as normal. Using this Talent increases your Dark Side Score by 1. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual When you die, you become a Dark Side Spirit until the end of the encounter. You continue to occupy a space in this form, but other creatures can occupy the same space or move through your space without impediment. As a Standard Action, you can attempt to possess an adjacent target. You must succeed on a Use the Force check against an adjacent target's Will Defense. If your check result equals or exceeds the target's Will Defense, you deal 8d6 points of Stun damage to the target; if you reduce the target to 0 Hit Points or move it to the bottom of the Condition Track with this attack, you possess the target as though it were a willing host. Alternatively, as a Standard Action, you can transfer your essence into a single adjacent object, such as a Holocron or a Lightsaber. If you do so, you lie dormant within the object until another creature attempts to use that object, at which time you can emerge and attempt to possess the creature, as described above. If you do not possess a creature or object within 10 rounds of manifesting as a Dark Side Spirit, your spirit dissipates and ceases to exist. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: When you roll a Natural 20 on a Use the Force check to activate a Force Power that directly deals damage to a target, you can choose not to regain all of your spent Force Powers as normal and instead the targets damaged by the Force Power take half that damage again at the start of their next turn. Only Force Powers that directly damage the target are subject to this Talent, including Corruption, Force Blast, Force Grip, Force Lightning, Force Slam, Force Thrust (only when spending a Force Point), and Repulse (only when spending a Force Point). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: You can create balls of unnatural energy, enabling you to make a ranged attack roll against the Reflex Defense of one target within 12 squares and line of sight, dealing 2d6 points of energy damage to the target on a successful attack. Using this Talent increases your Dark Side Score by 1. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Swift Power When using a Force Power that directly inflicts damage, you treat the target's Damage Threshold as though it were 5 points lower when determining if the target moves along the Condition Track. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: Whenever your character moves 3 or more squares in a round you gain Concealment; you may choose not to use this Talent when you move.","description":"Charisma 13 As a Standard Action, you grant yourself and all allies within 6 squares of you a +1 Force bonus to all Defenses until the end of the encounter. These bonuses are lost if you fall unconscious or die. Affected allies that move out of range lose the benefits for as long as they remain out of range. Prerequisite: Once per day, you can use a Force Power that normally takes a Standard Action or a Move Action as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Sometimes your anger consumes you. As a Swift Action, you can take a -5 penalty to your Will Defense to gain a +2 Force bonus on attack rolls. The penalty and bonus last until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever an effect would normally move you down the Condition Track, you may spend a Force Point and increase your Dark Side Score by 1 to negate that movement down the Condition Track. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Once per encounter as a Swift Action, you can return one Force Power with the [Dark Side] descriptor to your Force Power Suite without spending a Force Point. You can select this Talent multiple times. Each time you select it, you can use it one additional time per encounter. Reference Book: Star Wars Saga Edition Threats of the Galaxy As a Standard Action, you can spend a Force Point to drain the knowledge of an opponent you touch; you must succeed on a Use the Force check (DC equal to the target's Will Defense) to activate this Talent, and if you fail to activate this Talent, you may not try again on the same target for one day. If successful, you immediately become Trained in one Skill that the target is Trained in; if you are already Trained in that Skill, you instead gain Skill Focus in that Skill. This effect lasts for one day. Additionally, your target moves -1 Persistent step along the Condition Track, and the Persistent Condition can be removed only by resting for 8 hours. Additionally, you can choose to instead sift through the mind of the target, looking for a specific piece of knowledge or information. Doing so requires you to make a Perception check against the target's Will Defense; success indicates that you pull the relevant information from the target's mind. When you do so, you do not gain the bonus Trained Skill or Skill Focus normally granted by this Talent, but otherwise the Talent functions as normal. Using this Talent increases your Dark Side Score by 1. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual When you die, you become a Dark Side Spirit until the end of the encounter. You continue to occupy a space in this form, but other creatures can occupy the same space or move through your space without impediment. As a Standard Action, you can attempt to possess an adjacent target. You must succeed on a Use the Force check against an adjacent target's Will Defense. If your check result equals or exceeds the target's Will Defense, you deal 8d6 points of Stun damage to the target; if you reduce the target to 0 Hit Points or move it to the bottom of the Condition Track with this attack, you possess the target as though it were a willing host. Alternatively, as a Standard Action, you can transfer your essence into a single adjacent object, such as a Holocron or a Lightsaber. If you do so, you lie dormant within the object until another creature attempts to use that object, at which time you can emerge and attempt to possess the creature, as described above. If you do not possess a creature or object within 10 rounds of manifesting as a Dark Side Spirit, your spirit dissipates and ceases to exist. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: When you roll a Natural 20 on a Use the Force check to activate a Force Power that directly deals damage to a target, you can choose not to regain all of your spent Force Powers as normal and instead the targets damaged by the Force Power take half that damage again at the start of their next turn. Only Force Powers that directly damage the target are subject to this Talent, including Corruption, Force Blast, Force Grip, Force Lightning, Force Slam, Force Thrust (only when spending a Force Point), and Repulse (only when spending a Force Point). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: You can create balls of unnatural energy, enabling you to make a ranged attack roll against the Reflex Defense of one target within 12 squares and line of sight, dealing 2d6 points of energy damage to the target on a successful attack. Using this Talent increases your Dark Side Score by 1. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Swift Power When using a Force Power that directly inflicts damage, you treat the target's Damage Threshold as though it were 5 points lower when determining if the target moves along the Condition Track. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: Whenever your character moves 3 or more squares in a round you gain Concealment; you may choose not to use this Talent when you move.","costNumeric":null,"tree":"Dark Side","treeId":"de95d37c72b1c4cd","tags":["action-economy","condition-removal","controller","damage-reduction","dark-side","defender","feat-chain","force","force-control","force-defense","force-offense","leader","light-side","lightsaber","melee","mobility","perception","positioning","ranged","scaling","skills","stealth","striker","support","sustained-damage","talent-chain"]},"effects":[{"_id":"b3ad7fe2-78a8-42b3-83dc-385122d061ed","name":"Power of the Dark Side","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Power of the Dark Side"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.power_of_the_dark_side"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.627bd3abd30b973f"}}},{"_id":"b8e4a9fedaba43d7","name":"Battle Strike","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You channel the Force to enhance your next melee attack. Your next melee attack this round gains a +1d6 bonus to damage.</p>","special":"<p>This bonus damage is Force damage and bypasses Damage Reduction.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["enhancement","damage","melee"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f177dc6d65f76de9"}}},{"_id":"44684ff2a0ce2809","name":"Dark Rage","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Dark Rage"}}},{"_id":"adf733639b8bd621","name":"Force Grip","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":3,"discipline":"dark-side","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Concentration","effect":"<p>You use the Force to telekinetically choke or crush your target. The target takes damage each round based on your Use the Force check result.</p>","special":"<p>This is a Dark Side power. The target is immobilized while gripped.</p>","descriptor":["Dark Side","Telekinetic"],"dcChart":[{"dc":15,"effect":"2d6 damage/round","description":"Target takes 2d6 damage per round and is immobilized"},{"dc":20,"effect":"4d6 damage/round","description":"Target takes 4d6 damage per round and is immobilized"},{"dc":25,"effect":"6d6 damage/round + lift","description":"Target takes 6d6 damage per round, is immobilized, and lifted off ground"},{"dc":30,"effect":"8d6 damage/round + crush","description":"Target takes 8d6 damage per round and is being crushed (fort save or die)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["attack","damage","dark-side","telekinetic","immobilize"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f41a957f71e98a6a"}}},{"_id":"afa9b1679f95db6f","name":"Mind Trick","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telepathic","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 minute or until completed","effect":"<p>You influence a weak mind to believe what you tell them or follow a simple suggestion. The target must make a Will save (DC = your UTF check) or be affected.</p>","special":"<p>The suggestion must be reasonable and the target must be able to understand you.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["mind-control","suggestion","social"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.e6649f366d6c5737"}}},{"_id":"5e491cf0c0a5e903","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"39d41859a05011b9","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Human","Nonheroic Level":0,"Class Levels":{"Jedi":7,"Apprentice":5,"Lord":3},"Destiny Points":2,"Force Points":8,"Dark Side Points":14,"Initiative":13,"Senses":"Improved Sense Force , Perception +14","Languages":["Basic","Onderonian","Sith"],"Unassigned Languages":0,"Reflex Defense":30,"Flat-Footed Defense":29,"Fortitude Defense":29,"Will Defense":31,"Immune":"Attacks , [ Telekinetic ] Force Powers, Fear effects","Hit Points":135,"Damage Threshold":33,"Speed":"6 Squares (Incorporeal); Dark Spiritual Travel","Melee Weapons":"","Ranged Weapons":"","Base Attack Bonus":15,"Grapple":17,"Attack Options":["Double Attack (Lightsabers)","Power Attack","Power of the Dark Side","Triple Crit (Lightsabers)"],"Special Actions":["Adept Negotiator","Dark Presence","Manifestation","Possession","Temptation"],"Force Powers":["Battle Strike","Dark Rage","Force Grip","Mind Trick","Move Object","Rebuke"],"Force Secrets":["Force Secrets : Devastating Power"],"Force Techniques":["Force Techniques : Force Point Recovery","Improved Sense Force"],"Strength":14,"Dexterity":13,"Constitution":"","Intelligence":14,"Wisdom":14,"Charisma":19,"Talents":["Talents : Adept Negotiator","Dark Presence","Dark Side Adept","Dark Side Master","Deflect","Force Deception","Force Persuasion","Lightsaber Defense","Power of the Dark Side"],"Feats":["Feats : Armor Proficiency (Light)","Double Attack (Lightsabers)","Force Sensitivity","Force Training (2)","Improved Defenses","Power Attack","Skill Focus (Use the Force)","Triple Crit (Lightsabers)","Weapon Focus (Lightsabers)","Weapon Proficiency (Lightsabers)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Endurance","Initiative","Knowledge (Galactic Lore)","Perception","Use the Force","may substitute for Deception and Persuasion checks)"],"Trained Skills":["Skills : Endurance","Initiative","Knowledge (Galactic Lore)","Perception","Use the Force","may substitute for Deception and Persuasion checks)"],"Species Traits":[],"Gear":""},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
