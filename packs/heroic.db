ar effects","Hit Points":185,"Damage Threshold":37,"Speed":"6 Squares","Melee Weapons":"Double-Bladed Lightsaber +25 (2d8+15), Double-Bladed Lightsaber +27 (2d8+15) with Flurry, Double-Bladed Lightsaber +23 (3d8+15) with Rapid Strike, Double-Bladed Lightsaber +25 (3d8+15) with Flurry and Rapid Strike, Double-Bladed Lightsaber +25 (2d8+15) and Double-Bladed Lightsaber +25 (2d8+15)","Ranged Weapons":"By Weapon +23","Base Attack Bonus":20,"Grapple":23,"Attack Options":["Dark Scourge","Riposte"],"Special Actions":["Dark Healing","Redirect Shot","Sith Alchemy","Temptation"],"Force Powers":["Battle Strike","Dark Rage","Energy Resistance","Force Lightning","Force Stun","Force Thrust","Force Whirlwind","Mind Trick","Wound"],"Force Secrets":["Force Secrets : Devastating Power","Distant Power","Multitarget Power","Quicken Power"],"Force Techniques":["Force Techniques : Improved Force Stun","Improved Sense Force","Language Absorption"],"Strength":17,"Dexterity":17,"Constitution":15,"Intelligence":14,"Wisdom":15,"Charisma":17,"Talents":["Talents : Armored Defense","Block","Dark Healing","Dark Scourge","Dark Side Adept","Dark Side Master","Deflect","Niman","Redirect Shot","Riposte","Sith Alchemy","Weapon Specialization (Lightsabers)"],"Feats":["Feats : Armor Proficiency (Light)","Dual Weapon Mastery I","Dual Weapon Mastery II","Dual Weapon Mastery III","Flurry","Force Sensitivity","Force Training (3)","Rapid Strike","Skill Focus (Use the Force)","Weapon Focus (Lightsabers)","Weapon Proficiency (Lightsabers)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Initiative","Knowledge (Galactic Lore)","Perception","Pilot","Use the Force"],"Trained Skills":["Skills : Initiative","Knowledge (Galactic Lore)","Perception","Pilot","Use the Force"],"Species Traits":[],"Gear":"Double-Bladed Lightsaber ( Self-Built )"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
