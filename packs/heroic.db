Options:</strong> Dark Scourge, Power of the Dark Side, Weapon Finesse, Wicked Strike</p>\n<p><strong>Special Actions:</strong> Equilibrium, Improved Disarm, Redirect Shot, Swift Power, Temptation</p>","derived":{},"npcProfile":{"kind":"heroic","mode":"play","sourceAuthority":"statblock","legalProfile":"heroic","legalState":"unchecked","importMode":"play","playReady":true,"statblockAuthority":true,"sourcePack":"heroic","normalizationVersion":1,"authority":{"hp":"statblock","defenses":"statblock","bab":"statblock","attacks":"statblock","skills":"statblock","damageThreshold":"statblock"}}},"items":[{"_id":"b2cf02b600047389","name":"Quarren","type":"species","img":"icons/svg/mystery-man.svg","system":{"size":"Medium","speed":6,"abilities":"+2 Con, -2 Int","skillBonuses":["+2 Swim"],"special":[],"languages":["Basic","Quarren"],"source":"Core","description":"","tags":[],"visionTraits":[],"naturalWeapons":[],"movementTraits":["Amphibious: Can breathe underwater and move normally in water"],"environmentalTraits":[],"combatTraits":{"naturalArmor":0,"weaponProficiencies":[],"otherTraits":[]},"techTraits":[],"forceTraits":[],"socialTraits":[],"bonusFeats":0,"bonusTrainedSkills":0,"costNumeric":null},"effects":[],"folder":null,"sort":1000,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.species.species-quarren"}}},{"_id":"40697c2fc1831c3c","name":"Force Sensitivity","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"You can make Use the Force checks and gain access to Force Talents.","prerequisite":"Non-Droid","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["feat-chain","force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You can make <a href=\"/wiki/Use_the_Force\" title=\"Use the Force\">Use the Force</a> checks and gain access to <a href=\"/wiki/Force_Talents\" title=\"Force Talents\">Force Talents</a>."}},