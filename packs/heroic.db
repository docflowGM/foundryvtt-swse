eneral","benefit":"You are trained to make use of Starship Maneuvers and are skilled at space combat.","prerequisite":"Vehicular Combat, Trained in Pilot","special":"","normalText":"","sourcebook":"Starships of the Galaxy","page":30,"tags":["feat-chain","non-force","striker"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You are trained to make use of <a href=\"/wiki/Starship_Maneuvers\" title=\"Starship Maneuvers\">Starship Maneuvers</a> and are skilled at space combat."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.376d805d1b73f7e6"}}},{"_id":"a7265a65cd29bc9b","name":"Vehicular Combat","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Once per round, when your vehicle is hit in combat, you may make a Pilot check to negate the hit.","prerequisite":"Pilot 1 rank","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","scout","striker","sustained-damage"],"bonus_feat_for":["Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Negate one attack per round against the <a class=\"mw-redirect\" href=\"/wiki/Vehicle\" title=\"Vehicle\">Vehicle</a> you're piloting."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"b8dad0c963f046c6"}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1f2f70d34a17667d"}}},{"_id":"31bcef0b8f12227a","name":"Weapon Finesse","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may use your Dexterity modifier instead of Strength for attack rolls with light melee weapons.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","melee","non-force","scoundrel","scout"],"bonus_feat_for":["Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Use <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> modifier instead of <a href=\"/wiki/Strength\" title=\"Strength\">Strength</a> modifier on attack rolls with Light Melee Weapons and <a href=\"/wiki/Lightsabers\" title=\"Lightsabers\">Lightsabers</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.252b67d6e31c377e"}}},{"_id":"75e5ba33b7779e73","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"f5053b631dcbdab3","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"474ee00365021b50","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"d9102f19aaf72113","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"e93c11bbc7babf0c","name":"Ataru","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":null,"benefit":"May apply Dexterity modifier to damage or double Dexterity bonus if two-handed instead of Strength.","description":"Add Dexterity modifier to damage, or double Dexterity bonus if two-handed, instead of Strength.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","striker"]},"effects":[{"_id":"51d31037-d4be-4c4d-a5e5-b405e21aa08a","name":"Ataru - Apply DEX to Damage","icon":"icons/svg/wind.svg","changes":[{"key":"system.abilities.dex.applyToDamage","mode":5,"value":"true","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Ataru"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.ataru"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.0b3f4075ed84aee0"}}},{"_id":"63f8e41539963b6a","name":"Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"6775b5e2c6fc4c0f","name":"Battle Meditation","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sense","prerequisites":"","benefit":"Link Using a meditative battle trance, Force-users are able to join their minds together, collectively becoming stronger. However, a masterful degree of will is required to prevent the participants from sharing their weaknesses as well as their strengths. As a Full-Round Action, you can designate a number of willing allies equal to your Charisma modifier within 12 squares of you. These allies must be Trained in the Use the Force skill. As long as you remain within 12 squares of each other, you can Aid Another on attack rolls and Skill Checks as a Reaction.","description":"Link Using a meditative battle trance, Force-users are able to join their minds together, collectively becoming stronger. However, a masterful degree of will is required to prevent the participants from sharing their weaknesses as well as their strengths. As a Full-Round Action, you can designate a number of willing allies equal to your Charisma modifier within 12 squares of you. These allies must be Trained in the Use the Force skill. As long as you remain within 12 squares of each other, you can Aid Another on attack rolls and Skill Checks as a Reaction.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Sense","treeId":"d6b4331c0e31f7e3","tags":["action-economy","force","force-offense","jedi","positioning","striker","sustained-damage"]},"effects":[{"_id":"0cdcb68b-7eeb-45d0-ae5c-575d13648a00","name":"Battle Meditation","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks.allies","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Battle Meditation"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.battle_meditation"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9461c7aa79dd07c6"}}},{"_id":"8096d66c619de0ab","name":"Block","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith Alchemy","prerequisites":"","benefit":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","description":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Sith Alchemy","treeId":"a67faf2ae089ab5d","tags":["action-economy","armor","dark-side","defender","force","force-offense","jedi","lightsaber","melee","mobility","ranged","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.block"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9379daa94a228c04"}}},{"_id":"29a685a4102e14c8","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"adbbf5464ff074e0","name":"Force Pilot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sense","prerequisites":"Prerequisites: Technometry","benefit":"Starship Tactics When activating a Starship Maneuver, you may spend a Force Point to reroll your Pilot check, keeping the better of the two results. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to add your Charisma bonus to your Perception check. You can select this Talent multiple times. Each time you select this Talent, you add your Charisma bonus an additional time. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Prerequisite: You can substitute your Use the Force skill for any Use Computer check made to Astrogate or Use Sensors while you are the Pilot of a Vehicle. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Prerequisites: You can use your Use the Force check modifier instead of your Use Computer check modifier to Astrogate. You are considered Trained in the Use Computer skill. If you are entitled to a Use Computer check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Homebrew Reference Book: Legacy of the Force Sourcebook You can use your Use the Force check modifier instead of your Mechanics check modifier. You are considered Trained in the Mechanics skill. If you are entitled to a Mechanics check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Force Users As a Full-Round Action, you may attempt to merge your consciousness with am adjacent complex machine such as a computer, Droid or Vehicle by treating a Use the Force check as the Improve Access function of the Use Computer skill. Failure to beat the machine's Will Defense results in 1d4 Force damage dealt directly to your Hit Points. Success is treated as normal, though you may spend a Force Point as a Reaction upon success to move the system's Attitude an additional step. When a system is Helpful you are considered merged, and remain so until you chose to return to your natural body. While merged you are considered helpless and unaware of your body's surroundings. However, on your turn, you are in control of the merged machine. You are able to use the Access Information ability of the Use Computer Skill at a +10 bonus. In the case of a Vehicle or Droid, you are able to operate any single Vehicle or Droid system as if you were at the appropriate station, but at a +5 bonus to the associated check (attack roll or Skill Check). Further, when a merged Force-user uses the Reroute Power Action, their Vehicle moves an additional +1 step up the Condition Track. Upon returning to their natural body, a Force-user suffers a -5 penalty to all Use the Force checks made for 1d4 hours for every round they spent merged, and cannot spend Force Points unless accepting a Dark Side Point. If the player was merged for longer than an hour, they suffer a -10 penalty to all Use the Force checks for 1d4 days for every hour spent merged, and cannot spend Force Points or Destiny Points unless accepting a Dark Side Point. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"Starship Tactics When activating a Starship Maneuver, you may spend a Force Point to reroll your Pilot check, keeping the better of the two results. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to add your Charisma bonus to your Perception check. You can select this Talent multiple times. Each time you select this Talent, you add your Charisma bonus an additional time. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Prerequisite: You can substitute your Use the Force skill for any Use Computer check made to Astrogate or Use Sensors while you are the Pilot of a Vehicle. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Prerequisites: You can use your Use the Force check modifier instead of your Use Computer check modifier to Astrogate. You are considered Trained in the Use Computer skill. If you are entitled to a Use Computer check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Homebrew Reference Book: Legacy of the Force Sourcebook You can use your Use the Force check modifier instead of your Mechanics check modifier. You are considered Trained in the Mechanics skill. If you are entitled to a Mechanics check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Force Users As a Full-Round Action, you may attempt to merge your consciousness with am adjacent complex machine such as a computer, Droid or Vehicle by treating a Use the Force check as the Improve Access function of the Use Computer skill. Failure to beat the machine's Will Defense results in 1d4 Force damage dealt directly to your Hit Points. Success is treated as normal, though you may spend a Force Point as a Reaction upon success to move the system's Attitude an additional step. When a system is Helpful you are considered merged, and remain so until you chose to return to your natural body. While merged you are considered helpless and unaware of your body's surroundings. However, on your turn, you are in control of the merged machine. You are able to use the Access Information ability of the Use Computer Skill at a +10 bonus. In the case of a Vehicle or Droid, you are able to operate any single Vehicle or Droid system as if you were at the appropriate station, but at a +5 bonus to the associated check (attack roll or Skill Check). Further, when a merged Force-user uses the Reroute Power Action, their Vehicle moves an additional +1 step up the Condition Track. Upon returning to their natural body, a Force-user suffers a -5 penalty to all Use the Force checks made for 1d4 hours for every round they spent merged, and cannot spend Force Points unless accepting a Dark Side Point. If the player was merged for longer than an hour, they suffer a -10 penalty to all Use the Force checks for 1d4 days for every hour spent merged, and cannot spend Force Points or Destiny Points unless accepting a Dark Side Point. Homebrew Reference Book: Legacy of the Force Sourcebook","costNumeric":null,"tree":"Sense","treeId":"d6b4331c0e31f7e3","tags":["action-economy","condition-removal","controller","dark-side","defender","feat-chain","force","force-control","force-defense","force-offense","light-side","mechanics","mobility","perception","piloting","positioning","scaling","skills","slicing","striker","sustained-damage","talent-chain"]},"effects":[{"_id":"1a0877e3-3ddb-43ec-8895-3fce38f8d0e6","name":"Force Pilot","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.skills.pilot.trained","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Force Pilot"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_pilot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.443373859f1ecca3"}}},{"_id":"6726aef03cbdbf2b","name":"Surefooted","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Survivor","prerequisites":null,"benefit":"Speed is not reduced by difficult terrain.","description":"Your speed is not reduced by difficult terrain.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Survivor","treeId":"9b06340233eb3cdd","tags":["controller","damage-reduction","mobility","scout"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.surefooted"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f87bd82a892f69ea"}}},{"_id":"12e84a6c3da73954","name":"Telekinetic Savant","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Alter","prerequisites":"","benefit":"When you take the Force Training Feat and select Move Object as one of your Force Powers, you can also select one extra Force Power to add to your Force Power Suite for free. This extra Force Power must contain the [Telekinetic] descriptor. You can only gain one extra Force Power each time you take the Force Training Feat, regardless of how many times you choose the Move Object Force Power. If you increase your Wisdom score at a later time and select the Move Object power, you only gain an additional power if you did not take the Move Object power when you first chose that Feat. Otherwise, you gain an additional Force Power as normal. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide","description":"When you take the Force Training Feat and select Move Object as one of your Force Powers, you can also select one extra Force Power to add to your Force Power Suite for free. This extra Force Power must contain the [Telekinetic] descriptor. You can only gain one extra Force Power each time you take the Force Training Feat, regardless of how many times you choose the Move Object Force Power. If you increase your Wisdom score at a later time and select the Move Object power, you only gain an additional power if you did not take the Move Object power when you first chose that Feat. Otherwise, you gain an additional Force Power as normal. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide","costNumeric":null,"tree":"Alter","treeId":"6ac3416fb6aada56","tags":["controller","force","force-control","mobility"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.telekinetic_savant"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ddacb8e4517da6b5"}}},{"_id":"88d5d583ca52cac8","name":"Battle Strike","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You channel the Force to enhance your next melee attack. Your next melee attack this round gains a +1d6 bonus to damage.</p>","special":"<p>This bonus damage is Force damage and bypasses Damage Reduction.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["enhancement","damage","melee"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f177dc6d65f76de9"}}},{"_id":"ffdb173b9d7249b2","name":"Force Grip","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":3,"discipline":"dark-side","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Concentration","effect":"<p>You use the Force to telekinetically choke or crush your target. The target takes damage each round based on your Use the Force check result.</p>","special":"<p>This is a Dark Side power. The target is immobilized while gripped.</p>","descriptor":["Dark Side","Telekinetic"],"dcChart":[{"dc":15,"effect":"2d6 damage/round","description":"Target takes 2d6 damage per round and is immobilized"},{"dc":20,"effect":"4d6 damage/round","description":"Target takes 4d6 damage per round and is immobilized"},{"dc":25,"effect":"6d6 damage/round + lift","description":"Target takes 6d6 damage per round, is immobilized, and lifted off ground"},{"dc":30,"effect":"8d6 damage/round + crush","description":"Target takes 8d6 damage per round and is being crushed (fort save or die)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["attack","damage","dark-side","telekinetic","immobilize"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f41a957f71e98a6a"}}},{"_id":"e26a7ae18f351547","name":"Force Slam","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One creature or object","duration":"Instantaneous","effect":"<p>You use telekinetic force to violently slam your target against a surface. The target takes 4d6 damage and is knocked prone.</p>","special":"<p>The target must be within 6 squares of a solid surface (wall, floor, ceiling).</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":97,"tags":["attack","damage","telekinetic","prone"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.462a6c23e00c4dfc"}}},{"_id":"291c6c4364c82709","name":"Force Whirlwind","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Force Whirlwind"}}},{"_id":"94e47abaa80400dc","name":"Hawk-Bat Swoop","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Hawk-Bat Swoop"}}},{"_id":"838886590cbb5bfe","name":"Levitate","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Levitate"}}},{"_id":"76f160e63ac671e3","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"b90285e2348163ce","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}},{"_id":"dd2cc724be6e5b1c","name":"Saber Swarm","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Saber Swarm"}}},{"_id":"b1184be4e303161b","name":"Surge","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"vital","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You use the Force to push your body beyond normal limits. You gain an additional move action this turn.</p>","special":"<p>This extra move action can be used to move or perform other move-action tasks.</p>","descri