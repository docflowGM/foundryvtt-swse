roficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"1632f9c3cad7b05b","name":"Ambush Specialist","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Ambusher","prerequisites":"","benefit":"After you designate a Prime Target, you deal +1 die of damage on attacks against the Prime Target until the end of the encounter. Prerequisite: If you reduce your Prime Target to 0 Hit Points, as a Free Action you can designate another target within your line of sight as your new Prime Target. This new target remains your Prime Target until the end of the encounter. Prerequisite: Once per turn as a Swift Action, you can make an Initiative check, opposed by the Initiative check of your Prime Target. If your check result equals or exceeds your Prime Target's check result, your target is Flat-Footed against all attacks you make before the end of your turn. Prerequisite: You gain a +5 circumstance bonus to Perception checks against your Prime Target until the end of the encounter. If you and all your allies roll higher Initiative checks to start combat than do all your opponents, you automatically gain a Surprise Round, even if the opponents are aware of you when combat begins.","description":"After you designate a Prime Target, you deal +1 die of damage on attacks against the Prime Target until the end of the encounter. Prerequisite: If you reduce your Prime Target to 0 Hit Points, as a Free Action you can designate another target within your line of sight as your new Prime Target. This new target remains your Prime Target until the end of the encounter. Prerequisite: Once per turn as a Swift Action, you can make an Initiative check, opposed by the Initiative check of your Prime Target. If your check result equals or exceeds your Prime Target's check result, your target is Flat-Footed against all attacks you make before the end of your turn. Prerequisite: You gain a +5 circumstance bonus to Perception checks against your Prime Target until the end of the encounter. If you and all your allies roll higher Initiative checks to start combat than do all your opponents, you automatically gain a Surprise Round, even if the opponents are aware of you when combat begins.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Ambusher","treeId":"12027e0ad5e4d260","tags":["action-economy","ambush","controller","damage-reduction","mobility","perception","scout","skills","soldier","striker","support","sustained-damage"]},"effects":[{"_id":"55971dae-5cdf-40b0-823d-79482f07dbde","name":"Ambush Specialist","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Ambush Specialist"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.ambush_specialist"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e835b21a01ae2ee7"}}},{"_id":"d037001e31f2eb7b","name":"Destructive Ambusher","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Ambusher","prerequisites":"Ambush Specialist","benefit":"Gain +1 die of damage against your prime target until end of encounter.","description":"Deal +1 die of damage against your prime target until the end of the encounter.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Ambusher","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.ambush_specialist"}],"_source":"canonical-csv"},"treeId":"12027e0ad5e4d260","tags":["feat-chain","soldier","striker","talent-chain"]},"effects":[{"_id":"aa647a89-3fb8-460e-8d25-b4e345407202","name":"De