","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["noble","non-force","scaling","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You become <a class=\"mw-redirect\" href=\"/wiki/Trained\" title=\"Trained\">Trained</a> in one Class Skill."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"70992f200cdc7202","name":"Strong in the Force","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"Roll d8s instead of d6s when you spend a Force Point.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Roll d8s instead of d6s when you spend a <a class=\"mw-redirect\" href=\"/wiki/Force_Point\" title=\"Force Point\">Force Point</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.71892687abbed346"}}},{"_id":"c15fd6f6637f9f8b","name":"Weapon Finesse","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may use your Dexterity modifier instead of Strength for attack rolls with light melee weapons.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","melee","non-force","scoundrel","scout"],"bonus_feat_for":["Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Use <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> modifier instead of <a href=\"/wiki/Strength\" title=\"Strength\">Strength</a> modifier on attack rolls with Light Melee Weapons and <a href=\"/wiki/Lightsabers\" title=\"Lightsabers\">Lightsabers</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.252b67d6e31c377e"}}},{"_id":"56141f029763eefd","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"bea04f8e9882f085","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"f5922610edeaaa6b","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"f386c79298d8104f","name":"Force Power Mastery","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"Choose a single Force Power. You may Take 10 on Use the Force checks to activate this Force Power even when distracted or threatened.","prerequisite":"","special":"You may select this Force Technique multiple times; each time you select this Force Technique, it applies to a different Force Power.","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>Choose a single Force Power. You may Take 10 on Use the Force checks to activate this Force Power even when distracted or threatened.</p><p><strong>Special:</strong> You may select this Force Technique multiple times; each time you select this Force Technique, it applies to a different Force Power.</p>","relatedPower":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.07cea7e3e8b21d69"}}},{"_id":"abffcc0cd1701174","name":"Damage Reduction 10","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Control","prerequisites":null,"benefit":"Gain DR 10 for one minute.","description":"Gain damage reduction 10 for one minute.","costNumeric":null,"tree":"Control","treeId":"d3661aa9906bdc79","tags":["defender","force"]},"effects":[{"_id":"a33bfc46-2971-4f80-b25b-3facd242fa76","name":"Damage Reduction 10","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damageReduction","mode":5,"value":"10"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Damage Reduction 10"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.damage_reduction_10"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.35b42e14e3ef7d0d"}}},{"_id":"0462e499601c6dc5","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"0eb5f4ac9b7f1725","name":"Inquisition","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Imperial Inquisitor","prerequisites":null,"benefit":"+1 attack rolls and +1 die damage against Force-sensitives.","description":"Gain +1 attack and +1 die of damage against Force-sensitive opponents.","class":"Force Adept","costNumeric":null,"category":"Force Adept","tree":"Imperial Inquisitor","treeId":"a6ee1a0c534cbc73","tags":["force","force-offense","striker"]},"effects":[{"_id":"4c44f4de-ea20-4afd-8031-4e2fb447d6ed","name":"Inquisition","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage","mode":2,"value":"1d6"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inquisition"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inquisition"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.76ff0ba56aa3864b"}}},{"_id":"5a84c84967125b1c","name":"Power of the Dark Side","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Dark Side","prerequisites":"Dark Side Score equal to Wisdom Score","benefit":"Charisma 13 As a Standard Action, you grant yourself and all allies within 6 squares of you a +1 Force bonus to all Defenses until the end of the encounter. These bonuses are lost if you fall unconscious or die. Affected allies that move out of range lose the benefits for as long as they remain out of range. Prerequisite: Once per day, you can use a Force Power that normally takes a Standard Action or a Move Action as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Sometimes your anger consumes you. As a Swift Action, you can take a -5 penalty to your Will Defense to gain a +2 Force bonus on attack rolls. The penalty and bonus last until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever an effect would normally move you down the Condition Track, you may spend a Force Point and increase your Dark Side Score by 1 to negate that movement down the Condition Track. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Once per encounter as a Swift Action, you can return one Force Power with the [Dark Side] descriptor to your Force Power Suite without spending a Force Point. You can select this Talent multiple times. Each time you select it, you can use it one additional time per encounter. Reference Book: Star Wars Saga Edition Threats of the Galaxy As a Standard Action, you can spend a Force Point to drain the knowledge of an opponent you touch; you must succeed on a Use the Force check (DC equal to the target's Will Defense) to activate this Talent, and if you fail to activate this Talent, you may not try again on the same target for one day. If successful, you immediately become Trained in one Skill that the target is Trained in; if you are already Trained in that Skill, you instead gain Skill Focus in that Skill. This effect lasts for one day. Additionally, your target moves -1 Persistent step along the Condition Track, and the Persistent Condition can be removed only by resting for 8 hours. Additionally, you can choose to instead sift through the mind of the target, looking for a specific piece of knowledge or information. Doing so requires you to make a Perception check against the target's Will Defense; success indicates that you pull the relevant information from the target's mind. When you do so, you do not gain the bonus Trained Skill or Skill Focus normally granted by this Talent, but otherwise the Talent functions as normal. Using this Talent increases your Dark Side Score by 1. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual When you die, you become a Dark Side Spirit until the end of the encounter. You continue to occupy a space in this form, but other creatures can occupy the same space or move through your space without impediment. As a Standard Action, you can attempt to possess an adjacent target. You must succeed on a Use the Force check against an adjacent target's Will Defense. If your check result equals or exceeds the target's Will Defense, you deal 8d6 points of Stun damage to the target; if you reduce the target to 0 Hit Points or move it to the bottom of the Condition Track with this attack, you possess the target as though it were a willing host. Alternatively, as a Standard Action, you can transfer your essence into a single adjacent object, such as a Holocron or a Lightsaber. If you do so, you lie dormant within the object until another creature attempts to use that object, at which time you can emerge and attempt to possess the creature, as described above. If you do not possess a creature or object within 10 rounds of manifesting as a Dark Side Spirit, your spirit dissipates and ceases to exist. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: When you roll a Natural 20 on a Use the Force check to activate a Force Power that directly deals damage to a target, you can choose not to regain all of your spent Force Powers as normal and instead the targets damaged by the Force Power take half that damage again at the start of their next turn. Only Force Powers that directly damage the target are subject to this Talent, including Corruption, Force Blast, Force Grip, Force Lightning, Force Slam, Force Thrust (only when spending a Force Point), and Repulse (only when spending a Force Point). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: You can create balls of unnatural energy, enabling you to make a ranged attack roll against the Reflex Defense of one target within 12 squares and line of sight, dealing 2d6 points of energy damage to the target on a successful attack. Using this Talent increases your Dark Side Score by 1. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Swift Power When using a Force Power that directly inflicts damage, you treat the target's Damage Threshold as though it were 5 points lower when determining if the target moves along the Condition Track. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: Whenever your character moves 3 or more squares in a round you gain Concealment; you may choose not to use this Talent when you move.","description":"Charisma 13 As a Standard Action, you grant yourself and all allies within 6 squares of you a +1 Force bonus to all Defenses until the end of the encounter. These bonuses are lost if you fall unconscious or die. Affected allies that move out of range lose the benefits for as long as they remain out of range. Prerequisite: Once per day, you can use a Force Power that normally takes a Standard Action or a Move Action as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Sometimes your anger consumes you. As a Swift Action, you can take a -5 penalty to your Will Defense to gain a +2 Force bonus on attack rolls. The penalty and bonus last until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever an effect would normally move you down the Condition Track, you may spend a Force Point and increase your Dark Side Score by 1 to negate that movement down the Condition Track. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Once per encounter as a Swift Action, you can return one Force Power with the [Dark Side] descriptor to your Force Power Suite without spending a Force Point. You can select this Talent multiple times. Each time you select it, you can use it one additional time per encounter. Reference Book: Star Wars Saga Edition Threats of the Galaxy As a Standard Action, you can spend a Force Point to drain the knowledge of an opponent you touch; you must succeed on a Use the Force check (DC equal to the target's Will Defense) to activate this Talent, and if you fail to activate this Talent, you may not try again on the same target for one day. If successful, you immediately become Trained in one Skill that the target is Trained in; if you are already Trained in that Skill, you instead gain Skill Focus in that Skill. This effect lasts for one day. Additionally, your target moves -1 Persistent step along the Condition Track, and the Persistent Condition can be removed only by resting for 8 hours. Additionally, you can choose to instead sift through the mind of the target, looking for a specific piece of knowledge or information. Doing so requires you to make a Perception check against the target's Will Defense; success indicates that you pull the relevant information from the target's mind. When you do so, you do not gain the bonus Trained Skill or Skill Focus normally granted by this Talent, but otherwise the Talent functions as normal. Using this Talent increases your Dark Side Score by 1. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual When you die, you become a Dark Side Spirit until the end of the encounter. You continue to occupy a space in this form, but other creatures can occupy the same space or move through your space without impediment. As a Standard Action, you can attempt to possess an adjacent target. You must succeed on a Use the Force check against an adjacent target's Will Defense. If your check result equals or exceeds the target's Will Defense, you deal 8d6 points of Stun damage to the target; if you reduce the target to 0 Hit Points or move it to the bottom of the Condition Track with this attack, you possess the target as though it were a willing host. Alternatively, as a Standard Action, you can transfer your essence into a single adjacent object, such as a Holocron or a Lightsaber. If you do so, you lie dormant within the object until another creature attempts to use that object, at which time you can emerge and attempt to possess the creature, as described above. If you do not possess a creature or object within 10 rounds of manifesting as a Dark Side Spirit, your spirit dissipates and ceases to exist. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: When you roll a Natural 20 on a Use the Force check to activate a Force Power that directly deals damage to a target, you can choose not to regain all of your spent Force Powers as normal and instead the targets damaged by the Force Power take half that damage again at the start of their next turn. Only Force Powers that directly damage the target are subject to this Talent, including Corruption, Force Blast, Force Grip, Force Lightning, Force Slam, Force Thrust (only when spending a Force Point), and Repulse (only when spending a Force Point). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: You can create balls of unnatural energy, enabling you to make a ranged attack roll against the Reflex Defense of one target within 12 squares and line of sight, dealing 2d6 points of energy damage to the target on a successful attack. Using this Talent increases your Dark Side Score by 1. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Swift Power When using a Force Power that directly inflicts damage, you treat the target's Damage Threshold as though it were 5 points lower when determining if the target moves along the Condition Track. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: Whenever your character moves 3 or more squares in a round you gain Concealment; you may choose not to use this Talent when you move.","costNumeric":null,"tree":"Dark Side","treeId":"de95d37c72b1c4cd","tags":["action-economy","condition-removal","controller","damage-reduction","dark-side","defender","feat-chain","force","force-control","force-defense","force-offense","leader","light-side","lightsaber","melee","mobility","perception","positioning","ranged","scaling","skills","stealth","striker","support","sustained-damage","talent-chain"]},"effects":[{"_id":"b3ad7fe2-78a8-42b3-83dc-385122d061ed","name":"Power of the Dark Side","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Power of the Dark Side"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.power_of_the_dark_side"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.627bd3abd30b973f"}}},{"_id":"fac903ba3e1bc522","name":"Redirect Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Whenever you redirect a deflected blaster bolt (see the Talent), you gain a +5 bonus on your ranged attack roll.","description":"Whenever you redirect a deflected blaster bolt (see the Talent), you gain a +5 bonus on your ranged attack roll.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.deflect"},{"type":"bab","min":5}],"_source":"canonical-csv"},"treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","positioning","ranged","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.redirect_shot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.941c1dfd00e697da"}}},{"_id":"fe4d2de37876e2e7","name":"Telekinetic Savant","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Alter","prerequisites":"","benefit":"When you take the Force Training Feat and select Move Object as one of your Force Powers, you can also select one extra Force Power to add to your Force Power Suite for free. This extra Force Power must contain the [Telekinetic] descriptor. You can only gain one extra Force Power each time you take the Force Training Feat, regardless of how many times you choose the Move Object Force Power. If you increase your Wisdom score at a later time and select the Move Object power, you only gain an additional power if you did not take the Move Object power when you first chose that Feat. Otherwise, you gain an additional Force Power as normal. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide","description":"When you take the Force Training Feat and select Move Object as one of your Force Powers, you can also select one extra Force Power to add to your Force Power Suite for free. This extra Force Power must contain the [Telekinetic] descriptor. You can only gain one extra Force Power each time you take the Force Training Feat, regardless of how many times you choose the Move Object Force Power. If you increase your Wisdom score at a later time and select the Move Object power, you only gain an additional power if you did not take the Move Object power when you first chose that Feat. Otherwise, you gain an additional Force Power as normal. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide","costNumeric":null,"tree":"Alter","treeId":"6ac3416fb6aada56","tags":["controller","force","force-control","mobility"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.telekinetic_savant"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ddacb8e4517da6b5"}}},{"_id":"ca97f9d6288b3a98","name":"Dark Rage","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Dark Rage"}}},{"_id":"17e7a582efe69750","name":"Force Grip","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":3,"discipline":"dark-side","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Concentration","effect":"<p>You use the Force to telekinetically choke or crush your target. The target takes damage each round based on your Use the Force check result.</p>","special":"<p>This is a Dark Side power. The target is immobilized while gripped.</p>","descriptor":["Dark Side","Telekinetic"],"dcChart":[{"dc":15,"effect":"2d6 damage/round","description":"Target takes 2d6 damage per round and is immobilized"},{"dc":20,"effect":"4d6 damage/round","description":"Target takes 4d6 damage per round and is immobilized"},{"dc":25,"effect":"6d6 damage/round + lift","description":"Target takes 6d6 damage per round, is immobilized, and lifted off ground"},{"dc":30,"effect":"8d6 damage/round + crush","description":"Target takes 8d6 damage per round and is being crushed (fort save or die)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["attack","damage","dark-side","telekinetic","immobilize"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f41a957f71e98a6a"}}},{"_id":"ce42c62046bd3a2b","name":"Force Lightning","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":4,"discipline":"dark-side","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Instantaneous","effect":"<p>You unleash devastating arcs of Force Lightning from your fingertips. The target takes lightning damage based on your Use the Force check result.</p>","special":"<p>This is a Dark Side power. Using it gains you a Dark Side Point.</p>","descriptor":["Dark Side","Force Lightning"],"dcChart":[{"dc":15,"effect":"2d6 lightning damage","description":"Target takes 2d6 lightning damage"},{"dc":20,"effect":"4d6 lightning damage","description":"Target takes 4d6 lightning damage"},{"dc":25,"effect":"6d6 lightning damage + stun","description":"Target takes 6d6 lightning damage and is stunned for 1 round"},{"dc":30,"effect":"8d6 lightning damage + stun 1d4","description":"Target takes 8d6 lightning damage and is stunned for 1d4 rounds"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["attack","damage","dark-side","lightning"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.0a422b939edfad56"}}},{"_id":"08f20458db6715e1","name":"Force Slam","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One creature or object","duration":"Instantaneous","effect":"<p>You use telekinetic force to violently slam your target against a surface. The target takes 4d6 damage and is knocked prone.</p>","special":"<p>The target must be within 6 squares of a solid surface (wall, floor, ceiling).</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":97,"tags":["attack","damage","telekinetic","prone"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.462a6c23e00c4dfc"}}},{"_id":"d7405ff85385a4cc","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"920ae67c91aa8092","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}},{"_id":"b5c4431e605b8cae","name":"Surge","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"vital","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You use the Force to push your body beyond normal limits. You gain an additional move action this turn.</p>","special":"<p>This extra move action can be used to move or perform other move-action tasks.</p>","descriptor":["Vital"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["enhancement","action-economy","movement"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.1ac1084ca8f07114"}}},{"_id":"c36cc7c6d22e7a18","name":"Lightsaber","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d8+5","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Spe