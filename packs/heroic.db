a47ca08fd4","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"3c514f6a3025b298","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"ac95d082f7379f97","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"f0f8e1f196998156","name":"Devastating Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"","benefit":"This replaces the effects of the Talent.","description":"This replaces the effects of the Talent.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["soldier"]},"effects":[{"_id":"69f7a1a0-603e-4b5e-a42a-15f770230266","name":"Devastating Attack","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.combat.weaponGroupThresholdReduction","mode":2,"value":"5"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Devastating Attack","effectType":"threshold_reduction","weaponGroupSpecific":true,"notes":"Weapon group specific - applies when using designated weapon group"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.devastating_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.383915a7d11e1225"}}},{"_id":"e427554d09d7058a","name":"Expert Gunner","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Gunner","prerequisites":"","benefit":"While your Vehicle is engaged in a Dogfight, you take no penalty on your attack rolls with Vehicle Weapons, even if you are not the Pilot. You gain a +1 bonus on attack rolls made using Vehicle Weapons. Prerequisite: Whenever an enemy Vehicle moves out of your square, or an adjacent square, you may make a single attack against that Vehicle as an Attack of Opportunity. Prerequisite: Whenever you deal damage to a Vehicle that equals or exceeds its Damage Threshold, you move that Vehicle an additional -1 step on the Condition Track. Reference Book: Star Wars Saga Edition Starships of the Galaxy Prerequisites: , System Hit Whenever you make an attack that causes a Vehicle to move -1 or more steps down the Condition Track, you may also cause it to lose one of the following systems: Hyperdrive, one Weapon System or Weapon Battery, or communications. The system remains inoperable until the target regains all steps on the Condition Track. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Quick Trigger Once per encounter, when Piloting a Vehicle of Gargantuan size or smaller, you can make a Full Attack as a Standard Action. You can spend a Force Point to use this Talent one additional time in an encounter. Reference Book: Star Wars Saga Edition Starships of the Galaxy When firing a Vehicle Weapon, you treat the distance to the target as though it were one Range category less than it actually is. For example, when targeting an opponent at Short Range, you treat it as though it were at least Point-Blank Range for the purpose of determining bonuses or penalties. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisite: You know how to overcharge your Vehicle's weapon to produce additional damage. As a Swift Action, you can overcharge your Vehicle's energy weapon and deal +1 die of damage on your next attack in the same turn. However, your weapon loses 1 die of damage on its subsequent attacks and cannot be overcharged again, until a full round passes without the weapon firing. Reference Book: Star Wars Saga Edition Starships of the Galaxy Prerequisite: Once per encounter, you may ready to fire a single weapon at the same target as an ally, and you coordinate with a single weapon of your ally. If both attacks hit, you add the damage of the two weapons together before applying the target's Shield Rating or Damage Reduction, and treat it as a single attack for purposes of exceeding the target's Damage Threshold.","description":"While your Vehicle is engaged in a Dogfight, you take no penalty on your attack rolls with Vehicle Weapons, even if you are not the Pilot. You gain a +1 bonus on attack rolls made using Vehicle Weapons. Prerequisite: Whenever an enemy Vehicle moves out of your square, or an adjacent square, you may make a single attack against that Vehicle as an Attack of Opportunity. Prerequisite: Whenever you deal damage to a Vehicle that equals or exceeds its Damage Threshold, you move that Vehicle an additional -1 step on the Condition Track. Reference Book: Star Wars Saga Edition Starships of the Galaxy Prerequisites: , System Hit Whenever you make an attack that causes a Vehicle to move -1 or more steps down the Condition Track, you may also cause it to lose one of the following systems: Hyperdrive, one Weapon System or Weapon Battery, or communications. The system remains inoperable until the target regains all steps on the Condition Track. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Quick Trigger Once per encounter, when Piloting a Vehicle of Gargantuan size or smaller, you can make a Full Attack as a Standard Action. You can spend a Force Point to use this Talent one additional time in an encounter. Reference Book: Star Wars Saga Edition Starships of the Galaxy When firing a Vehicle Weapon, you treat the distance to the target as though it were one Range category less than it actually is. For example, when targeting an opponent at Short Range, you treat it as though it were at least Point-Blank Range for the purpose of determining bonuses or penalties. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisite: You know how to overcharge your Vehicle's weapon to produce additional damage. As a Swift Action, you can overcharge your Vehicle's energy weapon and deal +1 die of damage on your next attack in the same turn. However, your weapon loses 1 die of damage on its subsequent attacks and cannot be overcharged again, until a full round passes without the weapon firing. Reference Book: Star Wars Saga Edition Starships of the Galaxy Prerequisite: Once per encounter, you may ready to fire a single weapon at the same target as an ally, and you coordinate with a single weapon of your ally. If both attacks hit, you add the damage of the two weapons together before applying the target's Shield Rating or Damage Reduction, and treat it as a single attack for purposes of exceeding the target's Damage Threshold.","class":"Ace Pilot","costNumeric":null,"category":"Ace Pilot","tree":"Gunner","treeId":"43ead399d82b8142","tags":["action-economy","condition-removal","controller","damage-reduction","defender","dual-wield","force","force-control","force-offense","mobility","piloting","positioning","scout","shields","skills","striker","support","sustained-damage"]},"effects":[{"_id":"19db7346-c8b7-44de-a92a-3a48795e7596","name":"Expert Gunner","icon":"icons/svg/gun.svg","changes":[{"key":"system.attacks.ranged","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Expert Gunner"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.expert_gunner"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.befaa195df06b274"}}},{"_id":"3b1f68f8899f4164","name":"Melee Smash","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Specialist","prerequisites":"","benefit":"Unrelenting Assault You twirl your Weapon around you in a blur, creating a circle of death around you. Any enemy target that begins its turn adjacent to you takes damage equal to your Strength bonus. You must be wielding a Melee Weapon to be using this Talent.","description":"Unrelenting Assault You twirl your Weapon around you in a blur, creating a circle of death around you. Any enemy target that begins its turn adjacent to you takes damage equal to your Strength bonus. You must be wielding a Melee Weapon to be using this Talent.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Melee Specialist","treeId":"fad8118981c532f0","tags":["melee","positioning","soldier","striker","sustained-damage"]},"effects":[{"_id":"2d692811-5c22-48b8-944d-45db89ca5e77","name":"Melee Smash","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.melee","mode":5,"value":"half_level"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Melee Smash"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.melee_smash"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e0ee525f4109cfde"}}},{"_id":"ce2004acc5dcd727","name":"Penetrating Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"Weapon Focus (Chosen Weapon)","benefit":"This replaces the effects of the Talent. Choose one Exotic Weapon or weapon group with which you're proficient. You gain a +1 bonus on attack rolls with the chosen Exotic Weapon or weapon from the chosen group. This bonus stacks with the bonus granted by the Weapon Focus feat. You may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group.","description":"This replaces the effects of the Talent. Choose one Exotic Weapon or weapon group with which you're proficient. You gain a +1 bonus on attack rolls with the chosen Exotic Weapon or weapon from the chosen group. This bonus stacks with the bonus granted by the Weapon Focus feat. You may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["feat-chain","leader","scaling","soldier","striker","talent-chain"]},"effects":[{"_id":"a0fba2f5-3da6-476e-9ac5-900be2d16e6b","name":"Penetrating Attack","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.combat.weaponGroupDRReduction","mode":2,"value":"5"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Penetrating Attack","effectType":"dr_reduction","weaponGroupSpecific":true,"notes":"Weapon group specific - applies when using designated weapon group"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.penetrating_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7d547902b8d9109e"}}},{"_id":"3191e34552a0dc26","name":"Tough as Nails","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":"","benefit":"You can Catch a Second Wind as a Reaction, instead of as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide When you use the Aid Another Action to Suppress an Enemy, that enemy takes a -5 penalty on its next attack instead of the normal -2 penalty. Only 1 character may gain the benefits of this Talent against a given target at a time. Reference Book: Star Wars Saga Edition Unknown Regions","description":"You can Catch a Second Wind as a Reaction, instead of as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide When you use the Aid Another Action to Suppress an Enemy, that enemy takes a -5 penalty on its next attack instead of the normal -2 penalty. Only 1 character may gain the benefits of this Talent against a given ta