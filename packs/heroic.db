ccess to Force Talents.","prerequisite":"Non-Droid","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["feat-chain","force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You can make <a href=\"/wiki/Use_the_Force\" title=\"Use the Force\">Use the Force</a> checks and gain access to <a href=\"/wiki/Force_Talents\" title=\"Force Talents\">Force Talents</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ddbeb23013d9e917"}}},{"_id":"12025989b473ffeb","name":"Force Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"You learn a number of Force powers equal to 1 + your Wisdom modifier.","prerequisite":"Force Sensitivity, Trained in Use the Force","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["feat-chain","force","jedi","striker"],"bonus_feat_for":["Jedi"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"forcePowerGrants":1,"description":{"value":"Learn a number of <a href=\"/wiki/Force_Powers\" title=\"Force Powers\">Force Powers</a> equal to 1 + your <a href=\"/wiki/Wisdom\" title=\"Wisdom\">Wisdom</a> modifier (minimum 1)."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"usetheforce"}],"_source":"canonical-csv"}},"effects":[{"_id":"d1c60a9b-78e6-4601-85a4-320794fa5a91","name":"Force Training","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Force Training","effectType":"passive_effect","flagType":"Force Training"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.9b7b869a86f39190"}}},{"_id":"8f704d8b76957ad4","name":"Linguist","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a n