di Robes</p>\n<p><strong>Senses:</strong> Perception +16</p>\n<p><strong>Attack Options:</strong> Acrobatic Strike, Ataru, Autofire ( Blaster Rifle ), Devastating Attack (Lightsabers), Djem So, Double Attack (Lightsabers), Point-Blank Shot, Triple Attack (Lightsabers), Weapon Finesse</p>\n<p><strong>Special Actions:</strong> Disruptive, Indomitable, Serenity</p>","derived":{},"npcProfile":{"kind":"heroic","mode":"play","sourceAuthority":"statblock","legalProfile":"heroic","legalState":"unchecked","importMode":"play","playReady":true,"statblockAuthority":true,"sourcePack":"heroic","normalizationVersion":1,"authority":{"hp":"statblock","defenses":"statblock","bab":"statblock","attacks":"statblock","skills":"statblock","damageThreshold":"statblock"}}},"items":[{"_id":"58eae69ce1049d7a","name":"Human","type":"species","img":"icons/svg/mystery-man.svg","system":{"size":"Medium","speed":6,"abilities":"None","skillBonuses":[],"special":["Bonus Feat: Humans gain one bonus feat at 1st level","Bonus Trained Skill: Humans gain one additional trained skill at 1st level"],"languages":["Basic"],"source":"Core","description":"","tags":[],"visionTraits":[],"naturalWeapons":[],"movementTraits":[],"environmentalTraits":[],"combatTraits":{"naturalArmor":0,"weaponProficiencies":[],"otherTraits":[]},"techTraits":[],"forceTraits":[],"socialTraits":[],"bonusFeats":1,"bonusTrainedSkills":1,"costNumeric":null},"effects":[],"folder":null,"sort":700,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.species.species-human"}}},{"_id":"d36ded9975900a7b","name":"Acrobatic Strike","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You can use Acrobatics to tumble through an enemy’s space and gain a +2 bonus on your next melee attack against that enemy.","prerequisite":"Acrobatics 15 ranks","special":"","normalText":"","sourcebook":"Galaxy at War","page":23,"tags":["feat-chain","melee","non-force","scout","striker"],"bonus_feat_for":