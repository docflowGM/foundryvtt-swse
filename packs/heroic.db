e":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.252b67d6e31c377e"}}},{"_id":"392d507383274b3a","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"3a6eba3c3b024dee","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"3cb3888ab03c1224","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"2492980d0252820e","name":"Force Power Mastery","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"Choose a single Force Power. You may Take 10 on Use the Force checks to activate this Force Power even when distracted or threatened.","prerequisite":"","special":"You may select this Force Technique multiple times; each time you select this Force Technique, it applies to a different Force Power.","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>Choose a single Force Power. You may Take 10 on Use the Force checks to activate this Force Power even when distracted or threatened.</p><p><strong>Special:</strong> You may select this Force Technique multiple times; each time you select this Force Technique, it applies to a different Force Power.</p>","relatedPower":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.07cea7e3e8b21d69"}}},{"_id":"d80f5edb6f49e476","name":"Improved Force Trance","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"Each hour you remain in a Force Trance, you regain a number of Hit Points equal to 2 x your Character Level.","prerequisite":"Force Trance","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>Each hour you remain in a Force Trance, you regain a number of Hit Points equal to 2 x your Character Level.</p><p><strong>Related Power:</strong> Force Trance</p><p><strong>Prerequisites:</strong> Force Trance</p>","relatedPower":"Force Trance"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.93b96db5b560e14a"}}},{"_id":"98e1ceb8d1b9b7a1","name":"Adept Negotiator","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Consular","prerequisites":"","benefit":"You can use your Use the Force modifier instead of your Persuasion check modifier when making a Persuasion check. You are considered Trained in the Persuasion skill. If you are entitled to a Persuasion check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisite: If you successfully use the Talent, your target moves an additional -1 step along the Condition Track. This is a Mind-Affecting effect. You affect the Condition Track of the specific character (usually the Vehicle's Commander), not a Starship. You can spend a Full-Round Action advising an ally, thereby granting them a +5 bonus on their next Skill Check. If you spend a Force Point, the bonus increases to +10. The target must be able to (and willing) to hear and understand your voice. You cannot advise yourself. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual As a Standard Action, you can peer into The Force and search for weaknesses in the defenses of your enemies. Make a Use the Force check against the Will Defense of a target creature within 12 squares of you and in your line of sight. If the Skill Check equals or exceeds the target's Will Defense, that target takes a -2 penalty to their Reflex Defense against you and all allies who can hear and understand you until the end of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever you damage an opponent with a Lightsaber attack, you can Take 10 on any Persuasion checks you make before the end of your next turn, even if you would not normally be able to. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: Once per encounter as a Swift Action, you can choose one ally within your line of sight that can hear and understand you. Until the end of the encounter, that ally adds your Wisdom bonus to its Will Defense against Mind-Affecting effects. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per turn as a Swift Action, you can spend a Force Point to let one adjacent ally use the Aid Another Action (as a Reaction) to assist you with a Skill Check. You must make the Skill Check before the end of your turn, or the benefit of the Aid Another Action is lost. An ally that has already used the Aid Another Action to assist you since the end of your last turn may not be targeted by this Talent. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You gain a +2 insight bonus to your Will Defense. Also, as a Swift Action, you can spend a Force Point to give all allies within 6 squares of you a +2 insight bonus to their Will Defense that lasts for the remainder of the encounter. This bonus does not extend to allies outside the range of the effect, even if they move within 6 squares of you later on. Allies who benefit from this Talent must remain within 6 squares of you to retain the insight bonus, and they lose it if you are knocked unconscious or killed. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Rebellion Era Campaign Guide When you deal damage to a target by making a Lightsaber attack on your turn, you can use a Swift Action before the end of your turn to activate this Talent. If you do so, allies adjacent to the target at the time you make the attack gain a +2 circumstance bonus to melee attack rolls against the target until the start of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","description":"You can use your Use the Force modifier instead of your Persuasion check modifier when making a Persuasion check. You are considered Trained in the Persuasion skill. If you are entitled to a Persuasion check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisite: If you successfully use the Talent, your target moves an additional -1 step along the Condition Track. This is a Mind-Affecting effect. You affect the Condition Track of the specific character (usually the Vehicle's Commander), not a Starship. You can spend a Full-Round Action advising an ally, thereby granting them a +5 bonus on their next Skill Check. If you spend a Force Point, the bonus increases to +10. The target must be able to (and willing) to hear and understand your voice. You cannot advise yourself. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual As a Standard Action, you can peer into The Force and search for weaknesses in the defenses of your enemies. Make a Use the Force check against the Will Defense of a target creature within 12 squares of you and in your line of sight. If the Skill Check equals or exceeds the target's Will Defense, that target takes a -2 penalty to their Reflex Defense against you and all allies who can hear and understand you until the end of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever you damage an opponent with a Lightsaber attack, you can Take 10 on any Persuasion checks you make before the end of your next turn, even if you would not normally be able to. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: Once per encounter as a Swift Action, you can choose one ally within your line of sight that can hear and understand you. Until the end of the encounter, that ally adds your Wisdom bonus to its Will Defense against Mind-Affecting effects. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per turn as a Swift Action, you can spend a Force Point to let one adjacent ally use the Aid Another Action (as a Reaction) to assist you with a Skill Check. You must make the Skill Check before the end of your turn, or the benefit of the Aid Another Action is lost. An ally that has already used the Aid Another Action to assist you since the end of your last turn may not be targeted by this Talent. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You gain a +2 insight bonus to your Will Defense. Also, as a Swift Action, you can spend a Force Point to give all allies within 6 squares of you a +2 insight bonus to their Will Defense that lasts for the remainder of the encounter. This bonus does not extend to allies outside the range of the effect, even if they move within 6 squares of you later on. Allies who benefit from this Talent must remain within 6 squares of you to retain the insight bonus, and they lose it if you are knocked unconscious or killed. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Rebellion Era Campaign Guide When you deal damage to a target by making a Lightsaber attack on your turn, you can use a Swift Action before the end of your turn to activate this Talent. If you do so, allies adjacent to the target at the time you make the attack gain a +2 circumstance bonus to melee attack rolls against the target until the start of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Consular","treeId":"e99cfa9db8493573","tags":["action-economy","condition-removal","controller","defender","force","force-control","force-defense","force-offense","jedi","leader","light-side","lightsaber","melee","mobility","positioning","scout","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.adept_negotiator"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7acc479dee2d3b10"}}},{"_id":"593ff9afb9cf83fb","name":"Block","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith Alchemy","prerequisites":"","benefit":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","description":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Sith Alchemy","treeId":"a67faf2ae089ab5d","tags":["action-economy","armor","dark-side","defender","force","force-offense","jedi","lightsaber","melee","mobility","ranged","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.block"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9379daa94a228c04"}}},{"_id":"46f129c179539d4b","name":"Equilibrium","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Force Adept","prerequisites":"","benefit":"The Force shields you against ailments, toxins, and radiation poisoning, making you immune to Disease, Poison, and Radiation. Reference Book: Star Wars Saga Edition Unknown Regions You are particularly in tune with The Living Force. When you successfully use Search Your Feelings, you gain a Force Point that must be used before the end of the encounter. If you use this Force Point in a manner that would end in unfavorable results (per Search Your Feelings), you raise your Dark Side Score by 1. lf you use the Force Point in an action that would normally raise your Dark Side Score, you raise your Dark Side Score by 2 instead. Reference Book: Star Wars Saga Edition Unknown Regions","description":"The Force shields you against ailments, toxins, and radiation poisoning, making you immune to Disease, Poison, and Radiation. Reference Book: Star Wars Saga Edition Unknown Regions You are particularly in tune with The Living Force. When you successfully use Search Your Feelings, you gain a Force Point that must be used before the end of the encounter. If you use this Force Point in a manner that would end in unfavorable results (per Search Your Feelings), you raise your Dark Side Score by 1. lf you use the Force Point in an action that would normally raise your Dark Side Score, you raise your Dark Side Score by 2 instead. Reference Book: Star Wars Saga Edition Unknown Regions","costNumeric":null,"tree":"Force Adept","treeId":"e35ee41362604227","tags":["action-economy","dark-side","defender","force","shields","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.equilibrium"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.328a880e60f2320f"}}},{"_id":"ecf914315fc42111","name":"Lightsaber Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Niman When you use the Talent, you gain twice the normal deflection bonus to your Reflex Defense when you are wielding two Lightsabers. Prerequisite: When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Talent increases by 2 (to a maximum of +5). When wielding a Lightsaber, you gain a +1 bonus to your Reflex Defense and Will Defense.","description":"Niman When you use the Talent, you gain twice the normal deflection bonus to your Reflex Defense when you are wielding two Lightsabers. Prerequisite: When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Talent increases by 2 (to a maximum of +5). When wielding a Lightsaber, you gain a +1 bonus to your Reflex Defense and Will Defense.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["defender","jedi","lightsaber","melee","striker"]},"effects":[{"_id":"fcdbf882-923a-4095-b0df-a1079c214099","name":"Lightsaber Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Lightsaber Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.lightsaber_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e8bf1222fd6289e4"}}},{"_id":"ec155d9707189b2a","name":"Skilled Advisor","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Archivist","prerequisites":"","benefit":"You can Aid Another on the Knowledge checks of an ally within 6 squares of you as a Reaction for Knowledge skills you are Trained in. You can make a Use the Force check in place of a Knowledge check for any Knowledge skill you are not Trained in. You are considered Trained in that Knowledge skill for the purposes of using this Talent. If you are entitled to a Knowledge check reroll, you can reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisite: When you use the Talent, the ally you aid gains one temporary Force Point at the end of their next turn. If the Force Point is not spent before the end of the encounter, it is lost. As a Swift Action, you can reroll a Knowledge check and keep the better of the two results. This can be used with any Knowledge skill you are Trained in.","description":"You can Aid Another on the Knowledge checks of an ally within 6 squares of you as a Reaction for Knowledge skills you are Trained in. You can make a Use the Force check in place of a Knowledge check for any Knowledge skill you are not Trained in. You are considered Trained in that Knowledge skill for the purposes of using this Talent. If you are entitled to a Knowledge check reroll, you can reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisite: When you use the Talent, the ally you aid gains one temporary Force Point at the end of their next turn. If the Force Point is not spent before the end of the encounter, it is lost. As a Swift Action, you can reroll a Knowledge check and keep the better of the two results. This can be used with any Knowledge skill you are Trained in.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Archivist","treeId":"152047d6ab7896ad","tags":["action-economy","force","jedi","light-side","mobility","positioning","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.skilled_advisor"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.35cbdbe9c91ba1d0"}}},{"_id":"958926c01bc9db84","name":"Soothe","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Healer","prerequisites":"Vital Transfer","benefit":"Use Vital Transfer to move a target +1 up the condition track instead of healing; you move -1 down the track.","description":"Use Vital Transfer to move a target one step up the condition track instead of healing; you move –1 down the track.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Jedi Healer","treeId":"a2a7a376e4905da9","tags":["condition-removal","controller","feat-chain","force","force-control","force-support","jedi","light-side","medicine","mobility","skills","striker","support","talent-chain"]},"effects":[{"_id":"3663846e-dc0d-44d3-ac39-dc181d0f2d63","name":"Soothe","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.healing","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Soothe"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.soothe"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.3713870862584269"}}},{"_id":"3982756a23ad4f53","name":"Force Stun","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 round","effect":"<p>You use the Force to overwhelm your target's mind, stunning them. The target must make a Will save (DC = your UTF check) or be stunned for 1 round.</p>","special":"","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":97,"tags":["attack","stun","mind-affecting"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.a214d4f56b4abe11"}}},{"_id":"35263fab3501b060","name":"Mind Trick","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telepathic","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 minute or until completed","effect":"<p>You influence a weak mind to believe what you tell them or follow a simple suggestion. The target must make a Will save (DC = your UTF check) or be affected.</p>","special":"<p>The suggestion must be reasonable and the target must be able to understand you.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["mind-control","suggestion","social"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.e6649f366d6c5737"}}},{"_id":"1d79767dca1fb393","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}},{"_id":"ca6be6e8efaba6fe","name":"Sever Force","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":6,"discipline":"dark-side","useTheForce":30,"time":"1 minute","range":"Touch","target":"One Force-sensitive creature","duration":"Permanent","effect":"<p>You permanently sever a Force user's connection to the Force. The target loses all Force abilities permanently.</p>","special":"<p>This is an extremely powerful and cruel Dark Side power. Using it gains you 3 Dark Side Points. The target can make a Will save (DC = your UTF check) to resist. Master-level power.</p>","descriptor":["Dark Side","Force Drain"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","dark-side","permanent","master"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.b52769dd11b4e52c"}}},{"_id":"87dd51de9e9edd5b","name":"Surge","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"vital","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You use the Force to push your body beyond normal limits. You gain an additional move action this turn.</p>","special":"<p>This extra move action can be used to move or perform other move-action tasks.</p>","descriptor":["Vital"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["enhancement","action-economy","movement"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.1ac1084ca8f07114"}}},{"_id":"f2aa37311cb66d5e","name":"Vital Transfer","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":3,"discipline":"vital","useTheForce":15,"time":"Standard Action","range":"Touch","target":"One living creature","duration":"Instantaneous","effect":"<p>You channel the Force to heal injuries and restore vitality. The target recovers hit points based on your Use the Force check result.</p>","special":"<p>You cannot heal yourself with this power.</p>","descriptor":["Vital","Healing"],"dcChart":[{"dc":15,"effect":"2d6 healing","description":"Target heals 2d6 hit points"},{"dc":20,"effect":"4d6 healing","description":"Target heals 4d6 hit points"},{"dc":25,"effect":"6d6 healing + condition","description":"Target heals 6d6 hit points and removes one ongoing condition"},{"dc":30,"effect":"8d6 healing + all conditions","description":"Target heals 8d6 hit points and removes all ongoing conditions"}],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["healing","vital","support"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.00b65e47a4dd7d76"}}},{"_id":"6acf1cf9d75864d4","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+5","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":13,"flatDamageFormula":"1d4+5","useFlat":true}}}},{"_id":"08b83a854f99c110","name":"Lightsaber","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d8+5","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":14,"flatDamageFormula":"2d8+5","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Mon","Nonheroic Level":0,"Class Levels":{"Noble":1,"Jedi":7,"Knight":4,"Master":1},"Destiny Points":2,"Force Points":4,"Dark Side Points":0,"Initiative":7,"Senses":"Low-Light Vision, Perception +19","Languages":["Basic","Ithorese","Kel Dor","Mon Calamarian","Quarren","Rodese","Zabrak"],"Unassigned Languages":0,"Reflex Defense":27,"Flat-Footed Defense":26,"Fortitude Defense":27,"Will Defense":29,"Immune":"Fear effects","Hit Points":112,"Damage Threshold":27,"Speed":"6 Squares (Walking), 4 Squares (Swimming)","Melee Weapons":"Unarmed +13 (1d4+5), Lightsaber +14 (2d8+5)","Ranged Weapons":"By Weapon +13","Base Attack Bonus":12,"Grapple":13,"Attack Options":["Weapon Finesse"],"Special Actions":["Adept Negotiator","Cybernetic Surgery","Force Recovery","Serenity","Skilled Advisor"],"Force Powers":["Force Stun","Mind Trick","Rebuke","Sever Force","Surge","Vital Transfer (3; Soothe )"],"Force Secrets":[],"Force Techniques":["Force Techniques : Force Power Mastery ( Vital Transfer )","Improved Force Trance"],"Strength":9,"Dexterity":13,"Constitution":12,"Intelligence":15,"Wisdom":16,"Charisma":12,"Talents":["Talents : Adept Negotiator","Block","Equilibrium","Lightsaber Defense","Skilled Advisor","Soothe"],"Feats":["Feats : Cybernetic Surgery","Force Sensitivity","Force Training (2)","Linguist","Skill Focus (Perception)","Skill Focus (Treat Injury)","Skill Focus (Use the Force)","Surgical Expertise","Weapon Finesse","Weapon Proficiency (Lightsabers)","Weapon Proficiency (Pistols)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Gather Information","Knowledge (Galactic Lore)","Knowledge (Life Sciences)","Perception","Persuasion","Treat Injury","Use Computer","Use the Force"],"Trained Skills":["Skills : Gather Information","Knowledge (Galactic Lore)","Knowledge (Life Sciences)","Perception","Persuasion","Treat Injury","Use Computer","Use the Force"],"Species Traits":[],"Gear":"Lightsaber ( Self-Built ), Medical Kit , Surgery Kit , Utility Belt with Medpac , Jedi Robes"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
{"_id":"82dba3ccaea5d8c3","name":"Deliah Blue, Bounty Hunter","type":"npc","img":"icons/svg/mystery-man.svg","system":{"isDroid":false,"droidDegree":"","attributes":{"str":{"base":10,"racial":0,"enhancement":0,"temp":0},"dex":{"base":14,"racial":0,"enhancement":0,"temp":0},"con":{"base":13,"racial":0,"enhancement":0,"temp":0},"int":{"base":14,"racial":0,"enhancement":0,"temp":0},"wis":{"base":12,"racial":0,"enhancement":0,"temp":0},"cha":{"base":17,"racial":0,"enhancement":0,"temp":0}},"skills":{"acrobatics":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"dex","favorite":false},"climb":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"str","favorite":false},"deception":{"trained":true,"focused":false,"miscMod":0,"selectedAbility":"cha","favorite":false},"endurance":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"con","favorite":false},"gatherInformation":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"cha","favorite":false},"initiative":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"dex","favorite":false},"jump":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"str","favorite":false},"knowledgeBureaucracy":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeGalacticLore":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeLifeSciences":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgePhysicalSciences":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeSocialSciences":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeTactics":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeTechnology":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"mechanics":{"trained":true,"focused":true,"miscMod":0,"selectedAbility":"int","favorite":false},"perception":{"trained":true,"focused":false,"miscMod":0,"selectedAbility":"wis","favorite":false},"persuasion":{"trained":true,"focused":true,"miscMod":0,"selectedAbility":"cha","favorite":false},"pilot":{"trained":true,"focused":false,"miscMod":0,"selectedAbility":"dex","favorite":false},"ride":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"dex","favorite":false},"stealth":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"dex","favorite":false},"survival":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"wis","favorite":false},"swim":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"str","favorite":false},"treatInjury":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"wis","favorite":false},"useComputer":{"trained":true,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"useTheForce":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"cha","favorite":false}},"hp":{"value":55,"max":55,"temp":0,"bonus":0},"conditionTrack":{"current":0,"persistent":false,"penalty":0},"level":8,"size":"medium","speed":6,"defenses":{"reflex":{"total":22,"armor":0,"classBonus":0,"misc":{"auto":{},"user":{}},"ability":"dex","source":"level","level":0},"fort":{"total":20,"classBonus":0,"misc":{"auto":{},"user":{}},"ability":"con","level":0},"will":{"total":20,"classBonus":0,"misc":{"auto":{},"user":{}},"ability":"wis","level":0},"flatFooted":{"total":20}},"languages":["Basic","Huttese","Shyriiwook (understand only)"],"destinyPoints":{"value":1,"max":1},"forcePoints":{"value":4,"max":4,"die":"1d6"},"darkSideScore":1,"damageThreshold":20,"bab":6,"race":"Zeltron","class":"Scoundrel 4 / Scout 4","className":"Scoundrel 4 / Scout 4","biography":"<p><strong>Gear:</strong> Blaster Pistol , Wrist Launcher (6-Square Range ), Comlink (Short-Range), Tool Kit</p>\n<p><strong>Senses:</strong> Perception +10</p>\n<p><strong>Attack Options:</strong> Deadeye, Keen Shot, Point-Blank Shot, Precise Shot</p>\n<p><strong>Special Actions:</strong> Hyperdriven, Spacehound</p>","derived":{},"npcProfile":{"kind":"heroic","mode":"play","sourceAuthority":"statblock","legalProfile":"heroic","legalState":"unchecked","importMode":"play","playReady":true,"statblockAuthority":true,"sourcePack":"heroic","normalizationVersion":1,"authority":{"hp":"statblock","defenses":"statblock","bab":"statblock","attacks":"statblock","skills":"statblock","damageThreshold":"statblock"}}},"items":[{"_id":"1225971942c901e9","name":"Zeltron","type":"species","img":"icons/svg/mystery-man.svg","system":{"size":"Medium","speed":6,"abilities":"+2 Cha, -2 Wis","skillBonuses":["+2 Persuasion","+2 Deception"],"special":["Empathy","Pheromones"],"languages":["Zeltron","Basic"],"source":"Legacy","description":"","tags":[],"costNumeric":null},"effects":[],"folder":null,"sort":10900,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.species.species-zeltron"}}},{"_id":"6b2d175cfb0396b7","name":"Deadeye","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may reroll a ranged attack roll once per encounter and take the better result.","prerequisite":"Point Blank Shot","special":"","normalText":"","sourcebook":"Galaxy at War","page":24,"tags":["feat-chain","non-force","positioning","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"If you <a href=\"/wiki/Aim\" title=\"Aim\">Aim</a>, deal extra damage."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":4}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.6e47c132fbedde08"}}},{"_id":"7f9e7f25f3631ef0","name":"Dodge","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"During your turn, you designate an opponent and receive a +1 dodge bonus to your Reflex Defense against attacks from that opponent. You can select a new opponent on any action. A situation that makes you lose your Dexterity bonus to Reflex Defense (if any) also makes you lose dodge bonuses. Also, dodge bonuses stack with each other, unlike most other types of bonuses.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":84,"tags":["action-economy","defender","evasion","feat-chain","non-force","scaling","scout","striker"],"bonus_feat_for":["Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain a +1 dodge bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a> against a selected target."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13}],"_source":"canonical-csv"}},"effects":[{"name":"Dodge","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"feat-defense-bonus","source":"Dodge","defenseType":"reflex"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.45366d4f3a5e443d"}}},{"_id":"af2814f0d69b68d1","name":"Point-Blank Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on ranged attacks and damage against foes within Point-Blank <a class=\"mw-redirect\" href=\"/wiki/Range\" title=\"Range\">Range</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.05459ac4d439f229"}}},{"_id":"4bac1116594f4253","name":"Precise Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You do not take the -5 penalty for firing into melee.","prerequisite":"Point Blank Shot","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","melee","non-force","precision","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No -5 penalty for shooting into melee."}},"effects":[{"_id":"77e126ab-16c9-4116-9d67-b5550c007b1b","name":"Precise Shot","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Precise Shot","effectType":"passive_effect","flagType":"Precise Shot"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c180eee7d3bc29b2"}}},{"_id":"ce93a9011fcd2384","name":"Running Attack","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may make a single melee or ranged attack at any point during a move action taken on your turn.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["action-economy","controller","feat-chain","melee","mobility","non-force","positioning","ranged","scout","soldier"],"bonus_feat_for":["Scout","Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Move before and after making an attack."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.4d6a68d553fb0449"}}},{"_id":"7d2a440a2145014b","name":"Skill Focus","type":"feat","img":"icons/svg/upgrade.svg","syste