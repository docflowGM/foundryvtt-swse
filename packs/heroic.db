"damage":"3d8+12","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":13,"flatDamageFormula":"3d8+12","useFlat":true}}}},{"_id":"d6a4623ee684c8e6","name":"Heavy Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+6","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1.3,"cost":750,"equipped":true,"description":"<p>A more powerful variant of the standard blaster pistol, delivering higher damage at the cost of increased weight and power consumption.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":750,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-heavy-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":14,"flatDamageFormula":"3d8+6","useFlat":true}}}},{"_id":"27de6054e3902d8f","name":"Frag Grenade (4)","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"4d6+6,2-SquareBurst","damageType":"kinetic","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":0.5,"cost":200,"equipped":true,"description":"<p>A standard fragmentation grenade. The most common explosive device in the galaxy.</p>\n      <p><strong>Special:</strong> 2-square radius burst. Reflex save DC 15 for half damage.</p>","properties":["Grenade","Area Effect","Explosive","Single Use"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"simple","subcategory":"grenade","costNumeric":200,"category":"grenade"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-frag-grenade"},"swse":{"npc":{"flatAttackBonus":14,"flatDamageFormula":"4d6+6,2-SquareBurst","useFlat":true}}}},{"_id":"d3f58bf9c81b4c39","name":"Thermal Detonator (1)","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"8d6+6,4-SquareBurst","damageType":"kinetic","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":2000,"equipped":true,"description":"<p>An extremely powerful explosive device. Creates a massive blast that can level buildings.</p>\n      <p><strong>Special:</strong> 4-square radius burst. Reflex save DC 20 for half damage. Extremely dangerous and often illegal.</p>","properties":["Grenade","Area Effect","Explosive","Single Use","Restricted"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"simple","subcategory":"grenade","costNumeric":2000,"category":"grenade"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-thermal-detonator"},"swse":{"npc":{"flatAttackBonus":14,"flatDamageFormula":"8d6+6,4-SquareBurst","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Human","Nonheroic Level":0,"Class Levels":{"Jedi":9,"Scout":1,"Soldier":1,"Knight":1},"Destiny Points":2,"Force Points":11,"Dark Side Points":0,"Initiative":14,"Senses":"Perception +14","Languages":["Basic","Binary","Shyriiwook (understand only)"],"Unassigned Languages":0,"Reflex Defense":27,"Flat-Footed Defense":24,"Fortitude Defense":28,"Will Defense":27,"Hit Points":128,"Damage Threshold":28,"Speed":"6 Squares; Surefooted","Melee Weapons":"Unarmed +14 (1d4+7), Lightsaber +15 (2d8+12), Lightsaber +13 (3d8+12) with Rapid Strike","Ranged Weapons":"Heavy Blaster Pistol +14 (3d8+6), Frag Grenade (4) +14 (4d6+6, 2-Square Burst ), Thermal Detonator (1) +14 (8d6+6, 4-Square Burst )","Base Attack Bonus":11,"Grapple":14,"Attack Options":["Ataru","Rapid Strike","Weapon Finesse"],"Special Actions":["Battle Meditation","Telekinetic Savant"],"Force Powers":["Battle Strike","Battle Strike","Force Grip","Force Slam","Force Whirlwind","Hawk-Bat Swoop","Levitate","Move Object","Move Object","Rebuke","Saber Swarm","Surge"],"Force Secrets":[],"Force Techniques":[],"Strength":12,"Dexterity":17,"Constitution":12,"Intelligence":14,"Wisdom":16,"Charisma":18,"Talents":["Talents : Ataru","Armored Defense","Battle Meditation","Block","Deflect","Force Pilot","Surefooted","Telekinetic Savant"],"Feats":["Feats : Armor Proficiency (Light)","Force Sensitivity","Force Training (3)","Rapid Strike","Skill Focus (Mechanics)","Skill Focus (Use the Force)","Starship Tactics","Vehicular Combat","Weapon Finesse","Weapon Focus (Lightsabers)","Weapon Proficiency (Lightsabers)","Weapon Proficiency (Pistols)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Acrobatics","Initiative","Knowledge (Galactic Lore)","Mechanics","Perception","Use the Force","may ignore Yuuzhan Vong penalties to Sense Surroundings )"],"Trained Skills":["Skills : Acrobatics","Initiative","Knowledge (Galactic Lore)","Mechanics","Perception","Use the Force","may ignore Yuuzhan Vong penalties to Sense Surroundings )"],"Species Traits":[],"Gear":"Molytex Light Battle Armor (+6 Reflex , +3 Fortitude ; DR 5 vs Slashing and Piercing), Lightsaber ( Self-Built , Lambent Crystal ), Heavy Blaster Pistol , Frag Grenade (4), Thermal Detonator (1), Comlink (Short-Range), Utility Belt"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
