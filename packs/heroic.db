","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"bc88d856e5002e1f","name":"Bolster Ally","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"Inspire Confidence Whenever you hit an opponent with a melee or ranged attack, you can (as a Free Action) choose to give one ally within your line of sight a bonus to damage on their next attack equal to their Character Level. Once their fervor has been ignited, the affected ally doesn't need to remain within line of sight of you; if their next attack misses, they lose the bonus to damage granted by this Talent. Prerequisites: , Inspire Confidence, Ignite Fervor Whenever an ally within line of sight of you makes an attack that moves an opponent down the Condition Track (such as dealing damage that equals of exceeds the target's Damage Threshold), that ally moves the target an additional -1 step down the Condition Track. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Inspire Confidence Your allies hold you in such esteem that when you are threatened or injured, you can impel them to action. You can use each of the following actions once per encounter: Guardian: Choose one ally as a Swift Action. As long as you remain within 6 squares of the ally, you gain a +2 bonus to your Reflex Defense until the start of your next turn. Reprisal: Make a single melee or ranged attack against any target within your Range as a Standard Action. If your attack roll succeeds and if that target attacks you before the end of your next turn, one ally within 6 squares can make an attack against that target as a Reaction. To Me!: Spend a Swift Action. Whenever you take any damage before the beginning of your next turn, each ally within line of sight can move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","description":"Inspire Confidence Whenever you hit an opponent with a melee or ranged attack, you can (as a Free Action) choose to give one ally within your line of sight a bonus to damage on their next attack equal to their Character Level. Once their fervor has been ignited, the affected ally doesn't need to remain within line of sight of you; if their next attack misses, they lose the bonus to damage granted by this Talent. Prerequisites: , Inspire Confidence, Ignite Fervor Whenever an ally within line of sight of you makes an attack that moves an opponent down the Condition Track (such as dealing damage that equals of exceeds the target's Damage Threshold), that ally moves the target an additional -1 step down the Condition Track. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Inspire Confidence Your allies hold you in such esteem that when you are threatened or injured, you can impel them to action. You can use each of the following actions once per encounter: Guardian: Choose one ally as a Swift Action. As long as you remain within 6 squares of the ally, you gain a +2 bonus to your Reflex Defense until the start of your next turn. Reprisal: Make a single melee or ranged attack against any target within your Range as a Standard Action. If your attack roll succeeds and if that target attacks you before the end of your next turn, one ally within 6 squares can make an attack against that target as a Reaction. To Me!: Spend a Swift Action. Whenever you take any damage before the beginning of your next turn, each ally within line of sight can move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","condition-removal","controller","defender","force","force-control","force-defense","force-offense","leader","melee","mobility","noble","positioning","ranged","striker","support"]},"effects":[{"_id":"c5626626-5e0d-4051-b4c2-928434aef891","name":"Bolster Ally","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.hp.regen","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Bolster Ally"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.bolster_ally"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d6e7f7178e643717"}}},{"_id":"327eca2d2d2ffe6e","name":"Demoralizing Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fencing","prerequisites":"Noble Fencing Style","benefit":"Against an enemy you just hit with a melee attack, deal half damage and impose -5 attack against you until your next turn; usable once per round.","description":"After hitting an enemy, they take half damage and -5 attack against you until next turn.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Fencing","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.noble_fencing_style"}],"_source":"canonical-csv"},"treeId":"9df067790c87e6bc","tags":["defender","feat-chain","melee","noble","striker","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.demoralizing_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c7eb9c679ee43a8"}}},{"_id":"0160e5abb773f1be","name":"Inspire Confidence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","description":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","controller","defender","leader","mobility","noble","striker","support"]},"effects":[{"_id":"1faa089c-9609-46d8-8543-9a68ace3553b","name":"Inspire Confidence","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Confidence"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_confidence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4d8882a28da30454"}}},{"_id":"da864c9edafe00b3","name":"Leading Feint","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fencing","prerequisites":"Noble Fencing Style","benefit":"When you damage an opponent, you may attempt a Deception check to feint; if successful, one ally within 12 squares treats the target as flat-footed against your opponent.","description":"After damaging an opponent, you may feint to make the target flat-footed against an ally.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Fencing","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.noble_fencing_style"}],"_source":"canonical-csv"},"treeId":"9df067790c87e6bc","tags":["controller","feat-chain","noble","positioning","skills","social","striker","support","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.leading_feint"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d68318a928d3d5c7"}}},{"_id":"3f00593b3b5e5815","name":"Noble Fencing Style","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fencing","prerequisites":"","benefit":"As a Reaction, you can designate an enemy you have just hit with a melee attack. The enemy takes only half damage from the attack, but takes a -5 penalty on attacks made against you until the end of your next turn. A single target may only be affected by this Talent once per round. This is a Mind-Affecting effect. Prerequisite: Whenever you successfully damage an opponent with a melee attack, you can make a Deception check to Feint against that target as a Swift Action. If successful, you designate an ally within 12 squares; your target is designated Flat-Footed against the first attack that ally makes against your target before the beginning of your next turn. Prerequisites: , Base Attack Bonus +5 Once per encounter, as a Reaction, you can make a single melee attack against an adjacent enemy who just damaged you. Prerequisites: , Base Attack Bonus +5 When you hit a character with a melee attack, you can choose to have the attack deal only half damage and switch places with that foe. Your foe must be no more than one size category larger than you, and you must end up occupying a space that was previously occupied by your target (And vice versa) to use this Talent. This movement does not provoke Attacks of Opportunity.","description":"As a Reaction, you can designate an enemy you have just hit with a melee attack. The enemy takes only half damage from the attack, but takes a -5 penalty on attacks made against you until the end of your next turn. A single target may only be affected by this Talent once per round. This is a Mind-Affecting effect. Prerequisite: Whenever you successfully damage an opponent with a melee attack, you can make a Deception check to Feint against that target as a Swift Action. If successful, you designate an ally within 12 squares; your target is designated Flat-Footed against the first attack that ally makes against your target before the beginning of your next turn. Prerequisites: , Base Attack Bonus +5 Once per encounter, as a Reaction, you can make a single melee attack against an adjacent enemy who just damaged you. Prerequisites: , Base Attack Bonus +5 When you hit a character with a melee attack, you can choose to have the attack deal only half damage and switch places with that foe. Your foe must be no more than one size category larger than you, and you must end up occupying a space that was previously occupied by your target (And vice versa) to use this Talent. This movement does not provoke Attacks of Opportunity.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Fencing","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"deceptionandpersuasion"}],"_source":"fix2-auto"},"treeId":"9df067790c87e6bc","tags":["action-economy","controller","melee","mobility","noble","positioning","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.noble_fencing_style"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.00c3231e4a4173fa"}}},{"_id":"72cdad9d9b9fb0de","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+4","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":9,"flatDamageFormula":"1d4+4","useFlat":true}}}},{"_id":"694fd1cf76b8e2bd","name":"Vibroblade","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d6+4","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":2,"cost":500,"equipped":true,"description":"<p>A blade weapon enhanced with ultrasonic vibrations that increase its cutting power.</p>\n      <p><strong>Special:</strong> Vibroweapon. Critical threat range 19-20.</p>","properties":["Vibroweapon","Critical 19-20"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"advanced-melee","subcategory":"advanced","costNumeric":500,"category":"advanced"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-vibroblade"},"swse":{"npc":{"flatAttackBonus":10,"flatDamageFormula":"2d6+4","useFlat":true}}}},{"_id":"0a058091b91e2328","name":"Vibroblade (with Flurry)","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d6+4","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":2,"cost":500,"equipped":true,"description":"<p>A blade weapon enhanced with ultrasonic vibrations that increase its cutting power.</p>\n      <p><strong>Special:</strong> Vibroweapon. Critic