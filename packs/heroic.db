}}},{"_id":"15b41a81ccddd9e4","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"c1dad9747a32324d","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"5c4ffe7945f7c2d9","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"12d45991da48041b","name":"Acute Senses","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Master Scout","prerequisites":"","benefit":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","description":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Master Scout","treeId":"dca33c0215264a02","tags":["action-economy","armor","controller","damage-reduction","defender","force","force-control","force-defense","force-offense","melee","mobility","positioning","ranged","scout","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.acute_senses"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f0166d26d9f6252a"}}},{"_id":"be07e6dcd9de261c","name":"Educated","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":"","benefit":"Sometimes you surprise others with your skill. Once per day, you may make an Untrained skill check as though you were Trained in the Skill. Exception: you cannot use this Talent to make an Untrained Use the Force check as though you were Trained in the skill, unless you have the Force Sensitivity feat. You can select this Talent multiple times; each time you do, you can use it one additional time per day. Each time you gain a level (including the level at which you select this Talent), you receive an amount of credits equal to 5,000 x your Class Level. You can spend these credits as you see fit. The credits appear in a civilized, accessible location of your choice or in your private bank account. Reference Book: Star Wars Saga Edition Starships of the Galaxy Prerequisites: , Trained in Knowledge (Technology) You are Trained in the Mechanics skill. Additionally, when installing new systems into a Vehicle, the efficiency of your designs reduces the time it takes to install the system by 25%. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisites: , Intelligence 13 Select a number of Skills equal to your Intelligence modifier that you are not Trained in. You may now use Trained-only applications of those Skills, and they are considered Class Skills. You are not considered Trained in those Skills for any other purposes, and must still satisfy any other requirements in order to use the skill. Homebrew Reference Book: Legacy of the Force Sourcebook Select one type of performance, such as acting, dancing, singing, or playing a musical instrument. You gain a +5 bonus on Persuasion checks to entertain for that type of performance. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Intelligence 13 You have the ability to acquire aid and information from a long list of people. You may reroll any Gather Information check, but the result of the reroll must be accepted, even if it is worse. Additionally, the DC for any Persuasion checks made to reduce the cost of Bribery is reduced by 5.","description":"Sometimes you surprise others with your skill. Once per day, you may make an Untrained skill check as though you were Trained in the Skill. Exception: you cannot use this Talent to make an Untrained Use the Force check as though you were Trained in the skill, unless you have the Force Sensitivity feat. You can select this Talent multiple times; each time you do, you can use it one additional time per day. Each time you gain a level (including the level at which you select this Talent), you receive an amount of credits equal to 5,000 x your Class Level. You can spend these credits as you see fit. The credits appear in a civilized, accessible location of your choice or in your private bank account. Reference Book: Star Wars Saga Edition Starships of the Galaxy Prerequisites: , Trained in Knowledge (Technology) You are Trained in the Mechanics skill. Additionally, when installing new systems into a Vehicle, the efficiency of your designs reduces the time it takes to install the system by 25%. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisites: , Intelligence 13 Select a number of Skills equal to your Intelligence modifier that you are not Trained in. You may now use Trained-only applications of those Skills, and they are considered Class Skills. You are not considered Trained in those Skills for any other purposes, and must still satisfy any other requirements in order to use the skill. Homebrew Reference Book: Legacy of the Force Sourcebook Select one type of performance, such as acting, dancing, singing, or playing a musical instrument. You gain a +5 bonus on Persuasion checks to entertain for that type of performance. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Intelligence 13 You have the ability to acquire aid and information from a long list of people. You may reroll any Gather Information check, but the result of the reroll must be accepted, even if it is worse. Additionally, the DC for any Persuasion checks made to reduce the cost of Bribery is reduced by 5.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","treeId":"b5bb4154688c66ab","tags":["ambush","damage-reduction","force","mechanics","noble","scaling","skills","social","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.educated"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.3e98c9f5a4f450ff"}}},{"_id":"91c7aaa27f6eb5f7","name":"Inspire Haste","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":null,"benefit":"An ally may make a skill check as a move action instead of a standard action.","description":"An ally may make a skill check as a move action instead of a standard action.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","controller","mobility","noble","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_haste"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.c5f8d32dbc5afcc4"}}},{"_id":"9a76d3eba6304269","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+3","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":4,"flatDamageFormula":"1d4+3","useFlat":true}}}},{"_id":"dd6865b299fcd922","name":"Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d6+3","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":500,"equipped":true,"description":"<p>The standard sidearm used throughout the galaxy. Reliable, common, and effective at close to medium range.</p>","