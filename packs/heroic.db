eat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"71c973bf6ed7718b","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"ca2138dabc5f2889","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"07e63aa62ed2cbf9","name":"Born Leader","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Naval Officer","prerequisites":"","benefit":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","description":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","class":"Noble","costNumeric":null,"category":"Noble","tree":"Naval Officer","treeId":"057a978a7dc1d5a7","tags":["armor","defender","noble","striker","support","sustained-damage"]},"effects":[{"_id":"f9275c38-3cb5-4ab3-aaa5-25e5722dcdd3","name":"Born Leader","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.will","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Born Leader"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.born_leader"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.6a66ba6e0834dd6f"}}},{"_id":"a679da2bc65e7b40","name":"Dastardly Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","tree":"Misfortune","prerequisites":"Combat Reflexes","description":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","benefit":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","class":"","category":"","costNumeric":null,"treeId":"67b59e020c1660eb","tags":["condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","lightsaber","melee","mobility","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9e4345faaaa94dd8"}}},{"_id":"bf29583a7c955a1c","name":"Deceptive Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Gunslinger","prerequisites":null,"benefit":"Target in line of sight within 6 squares; Deception vs Will imposes loss of Dexterity to Defense until next turn.","description":"Make a Deception check vs Will Defense; if successful, the target loses Dexterity to Defense until the end of your next turn.","class":"Gunslinger","costNumeric":null,"category":"Gunslinger","tree":"Gunslinger","treeId":"cb6f775cd227a3e3","tags":["defender","positioning","ranged","skills","social"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deceptive_shot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.b1afecfea833a2a5"}}},{"_id":"f63affce8f97ada2","name":"Disruptive","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"As a Standard Action, you can do or say something that catches your enemies off guard. All opponents within 6 squares of you, and within your line of sight take a -2 penalty to their Defenses until the start of your next turn. The penalty is negated if line of sight is broken. This Talent has a range of 6 squares at Starship Scale. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Walk the Line You can create opportunities to chip away at our opponents' defenses. You can use each of the following actions once per encounter as a Standard Action: Create Opening: Make a single melee or ranged attack against any target within your Range. If you damage the target, the target takes a -5 penalty to their Reflex Defense until the start of your next turn. Crippling Attack: Make a single melee or ranged attack against any target within your Range. Until the start of your next turn, the target takes a -2 penalty to their base speed. Vicious Attack: Make a melee or ranged attack within your Range against two opponents that are within 2 squares of each other. Make separate attack rolls at a -5 penalty against each target, but roll damage once only. Reference Book: Star Wars Saga Edition Scum and Villainy You can fill your opponent with doubt by making a Persuasion check as a Standard Action against a single target that can hear and understand you within 12 squares of you. If your check result equals or exceeds the target's Will Defense, the target takes a -2 penalty to its base speed, and if the target takes a Standard Action, it must also spend its Swift Action. This penalty lasts until the end of the target's next turn. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"As a Standard Action, you can do or say something that catches your enemies off guard. All opponents within 6 squares of you, and within your line of sight take a -2 penalty to their Defenses until the start of your next turn. The penalty is negated if line of sight is broken. This Talent has a range of 6 squares at Starship Scale. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Walk the Line You can create opportunities to chip away at our opponents' defenses. You can use each of the following actions once per encounter as a Standard Action: Create Opening: Make a single melee or ranged attack against any target within your Range. If you damage the target, the target takes a -5 penalty to their Reflex Defense until the start of your next turn. Crippling Attack: Make a single melee or ranged attack against any target within your Range. Until the start of your next turn, the target takes a -2 penalty to their base speed. Vicious Attack: Make a melee or ranged attack within your Range against two opponents that are within 2 squares of each other. Make separate attack rolls at a -5 penalty against each target, but roll damage once only. Reference Book: Star Wars Saga Edition Scum and Villainy You can fill your opponent with doubt by making a Persuasion check as a Standard Action against a single target that can hear and understand you within 12 squares of you. If your check result equals or exceeds the target's Will Defense, the target takes a -2 penalty to its base speed, and if the target takes a Standard Action, it must also spend its Swift Action. This penalty lasts until the end of the target's next turn. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["action-economy","defender","melee","mobility","positioning","ranged","scaling","scoundrel","skills","social","striker"]},"effects":[{"_id":"4eefbe8a-47cc-4cee-a02a-7c11b76bd6b5","name":"Disruptive","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.morale.bonuses_suppressed","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Disruptive"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.disruptive"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.91b335f8565b90ef"}}},{"_id":"fcdd3190791ca34f","name":"Lucky Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fortune","prerequisites":"Knack","benefit":"Once per day, reroll an attack roll.","description":"Once per day, reroll an attack roll and take the better result.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Fortune","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.knack"}],"_source":"canonical-csv"},"treeId":"cee9b9398682b7d0","tags":["feat-chain","ranged","scoundrel","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.lucky_shot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5fbf1a3504865fba"}}},{"_id":"f149ca15865291e5","name":"Rally","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Leadership","prerequisites":"","benefit":"Unlike other Mind-Affecting Talents, affects both allied Vehicles and characters with less than half their Hit Points. The Vehicle gains a +2 bonus to its Reflex Defense, all crewmembers gain a +2 bonus to their Will Defense so long as they are on board, and all Gunners gain a +2 bonus on damage with Weapon Systems (before multiplier, if any). Any crewmember who has less than half its Hit Points also gains the normal benefits of this Talent even if it leaves the Vehicle, but note that these bonuses do not stack.","description":"Unlike other Mind-Affecting Talents, affects both allied Vehicles and characters with less than half their Hit Points. The Vehicle gains a +2 bonus to its Reflex Defense, all crewmembers gain a +2 bonus to their Will Defense so long as they are on board, and all Gunners gain a +2 bonus on damage with Weapon Systems (before multiplier, if any). Any crewmember who has less than half its Hit Points also gains the normal benefits of this Talent even if it leaves the Vehicle, but note that these bonuses do not stack.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Leadership","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.distant_command"}],"_source":"canonical-csv"},"treeId":"5964237d22681dc0","tags":["defender","noble","scaling","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.rally"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.962c8a24f9caaba0"}}},{"_id":"f6d580979fa805cb","name":"Stun Baton","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d6+5(Stun)","damageType":"stun","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1.5,"cost":250,"equipped":true,"description":"<p>A non-lethal weapon that delivers an electrical shock to stun targets.</p>\n      <p><strong>Special:</strong> Deals stun damage only. Target must make Fortitude save or be stunned.</p>","properties":["Stun","Non-Lethal"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"simple","subcategory":"simple","costNumeric":250,"category":"simple"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-stun-baton"},"swse":{"npc":{"flatAttackBonus":7,"flatDamageFormula":"2d6+5(Stun)","useFlat":true}}}},{"_id":"dae5bd3ab97d2876","name":"Heavy Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+5","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1.3,"cost":750,"equipped":true,"description":"<p>A more powerful variant of the standard blaster pistol, delivering higher damage at the cost of increased weight and power consumption.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":750,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-heavy-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":11,"flatDamageFormula":"3d8+5","useFlat":true}}}},{"_id":"7d5c18c0803cef5c","name":"Heavy Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+5","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1.3,"cost":750,"equipped":true,"description":"<p>A more powerful variant of the standard blaster pistol, delivering higher damage at the cost of increased weight and power consumption.</p>","properties":[],"ammunition":{"type":"none",