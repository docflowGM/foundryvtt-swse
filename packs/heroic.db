":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"a5fbde4794c7eaa7","name":"Evasion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Survivor","prerequisites":null,"benefit":"If hit by an area attack, take half or no damage.","description":"Take half or no damage from area attacks.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Survivor","treeId":"9b06340233eb3cdd","tags":["battlefield-control","evasion","scout","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.evasion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5400bc8cb1200624"}}},{"_id":"9dd3f5f55598354d","name":"Hesitate","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"Once per encounter, as a Standard Action, you can make a Deception check and compare the result to the Will Defense of all enemies in your line of sight. If the check result equals or exceeds an enemy's Will Defense, that enemy must spend a Swift Action in addition to a Standard Action to make an attack until the start of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Once per round, as a Swift Action, you can designate a target within 12 squares of you and in your line of sight as the target of this Talent. Until the beginning of your turn, you can cause that target to take a -5 penalty on all checks made with a single Skill. You must have line of sight to your target to make use of this Talent, and declare which Skill is to be penalized at the time this Talent is activated. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"Once per encounter, as a Standard Action, you can make a Deception check and compare the result to the Will Defense of all enemies in your line of sight. If the check result equals or exceeds an enemy's Will Defense, that enemy must spend a Swift Action in addition to a Standard Action to make an attack until the start of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Once per round, as a Swift Action, you can designate a target within 12 squares of you and in your line of sight as the target of this Talent. Until the beginning of your turn, you can cause that target to take a -5 penalty on all checks made with a single Skill. You must have line of sight to your target to make use of this Talent, and declare which Skill is to be penalized at the time this Talent is activated. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["action-economy","defender","mobility","positioning","scoundrel","skills","social","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hesitate"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.1c381292494e3139"}}},{"_id":"b31a918ee753d20c","name":"Preternatural Senses","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Outlaw","prerequisites":null,"benefit":"Once per encounter add half your class level to one Defense.","description":"Once per encounter, add half your class level to one defense.","class":"Outlaw","costNumeric":null,"category":"Outlaw","tree":"Outlaw","treeId":"3caa80f6bef04200","tags":["defender","force","force-defense"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.preternatural_senses"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4df672d524de7aa0"}}},{"_id":"bc983948de90a4a6","name":"Quick Fix","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mechanic","prerequisites":"Prerequisites: Skill Focus (Mechanics)","benefit":"Once per encounter, you may use the Jury-Rig application of the Mechanics skill as a Standard Action instead of a Full-Round Action. While using the Build Object action, you can Take 20 on Mechanics checks. Additionally, when assembling the object you reduce the Object's Size Multiplier by half. You may reroll Mechanics checks, but the result of the reroll must be accepted, even if it is worse.","description":"Once per encounter, you may use the Jury-Rig application of the Mechanics skill as a Standard Action instead of a Full-Round Action. While using the Build Object action, you can Take 20 on Mechanics checks. Additionally, when assembling the object you reduce the Object's Size Multiplier by half. You may reroll Mechanics checks, but the result of the reroll must be accepted, even if it is worse.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Mechanic","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"745a5686d6f21e8c"}],"_source":"fix5F-canonical"},"treeId":"38d7c18ce4664c66","tags":["action-economy","damage-reduction","feat-chain","mechanics","scoundrel","skills","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.quick_fix"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.3e6f7edaeec04a06"}}},{"_id":"2f00424c579ca8de","name":"Strike and Run","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Run and Gun","prerequisites":"","benefit":"Once per encounter, you can designate an opponent you have just damaged as a Reaction; that opponent cannot make Attacks of Opportunity against you until the end of your next turn. You may use this in conjunction with the Talent, allowing you to benefit from both Talents as a single Reaction. Once per encounter, as a Reaction after successfully damaging an opponent with a melee or ranged attack, you can Move your Speed.","description":"Once per encounter, you can designate an opponent you have just damaged as a Reaction; that opponent cannot make Attacks of Opportunity against you until the end of your next turn. You may use this in conjunction with the Talent, allowing you to benefit from both Talents as a single Reaction. Once per encounter, as a Reaction after successfully damaging an opponent with a melee or ranged attack, you can Move your Speed.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Run and Gun","treeId":"6367600ed3c0cfae","tags":["action-economy","controller","melee","mobility","positioning","ranged","scoundrel","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.strike_and_run"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.119725589e32a35a"}}},{"_id":"0f20431cace5e1ae","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+4","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus"