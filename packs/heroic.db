ay":false},"costNumeric":null,"description":{"value":"Use <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> modifier instead of <a href=\"/wiki/Strength\" title=\"Strength\">Strength</a> modifier on attack rolls with Light Melee Weapons and <a href=\"/wiki/Lightsabers\" title=\"Lightsabers\">Lightsabers</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.252b67d6e31c377e"}}},{"_id":"8a11821f72575c07","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"f9531442ea5c4f8e","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"900a217f8de36775","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"f60334fa2b149692","name":"Quicken Power","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-secret.png","system":{"featType":"force","benefit":"When using a Force Power that requires a Standard Action or Move Action to activate, you can spend a Force Point to activate the Force Power as a Swift Action instead.","prerequisite":"","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-secret"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":"<p><strong>Cost:</strong> Force Point or Destiny Point</p><p>When using a Force Power that requires a Standard Action or Move Action to activate, you can spend a Force Point to activate the Force Power as a Swift Action instead.</p><p>Alternatively, you can spend a Destiny Point to activate the Force Power as a Reaction instead.</p>","cost":"Force Point or Destiny Point","alternativeCost":"Alternatively, you can spend a Destiny Point to activate the Force Power as a Reaction instead."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcesecrets.52bf7b9a1a41de2b"}}},{"_id":"219c59dcabeb32db","name":"Force Point Recovery","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"At the end of an encounter, you automatically recover 1 Force Point spent during the encounter.","prerequisite":"","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>At the end of an encounter, you automatically recover 1 Force Point spent during the encounter.</p>","relatedPower":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.056ab39b3ab9df10"}}},{"_id":"a3b672da25ed3e97","name":"Improved Move Light Object","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may make a Use the Force check to Move Light Object as a Swift Action instead of a Move Action. Using the light object as a projectile weapon requires a Move Action (instead of a Standard Action).","prerequisite":"Move Light Object","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may make a Use the Force check to Move Light Object as a Swift Action instead of a Move Action. Using the light object as a projectile weapon requires a Move Action (instead of a Standard Action).</p><p><strong>Related Power:</strong> Move Light Object</p><p><strong>Prerequisites:</strong> Move Light Object</p>","relatedPower":"Move Light Object"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.c406600924a7780e"}}},{"_id":"7eff5f4d6f200140","name":"Adept Negotiator","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Consular","prerequisites":"","benefit":"You can use your Use the Force modifier instead of your Persuasion check modifier when making a Persuasion check. You are considered Trained in the Persuasion skill. If you are entitled to a Persuasion check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisite: If you successfully use the Talent, your target moves an additional -1 step along the Condition Track. This is a Mind-Affecting effect. You affect the Condition Track of the specific character (usually the Vehicle's Commander), not a Starship. You can spend a Full-Round Action advising an ally, thereby granting them a +5 bonus on their next Skill Check. If you spend a Force Point, the bonus increases to +10. The target must be able to (and willing) to hear and understand your voice. You cannot advise yourself. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual As a Standard Action, you can peer into The Force and search for weaknesses in the defenses of your enemies. Make a Use the Force check against the Will Defense of a target creature within 12 squares of you and in your line of sight. If the Skill Check equals or exceeds the target's Will Defense, that target takes a -2 penalty to their Reflex Defense against you and all allies who can hear and understand you until the end of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever you damage an opponent with a Lightsaber attack, you can Take 10 on any Persuasion checks you make before the end of your next turn, even if you would not normally be able to. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: Once per encounter as a Swift Action, you can choose one ally within your line of sight that can hear and understand you. Until the end of the encounter, that ally adds your Wisdom bonus to its Will Defense against Mind-Affecting effects. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per turn as a Swift Action, you can spend a Force Point to let one adjacent ally use the Aid Another Action (as a Reaction) to assist you with a Skill Check. You must make the Skill Check before the end of your turn, or the benefit of the Aid Another Action is lost. An ally that has already used the Aid Another Action to assist you since the end of your last turn may not be targeted by this Talent. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You gain a +2 insight bonus to your Will Defense. Also, as a Swift Action, you can spend a Force Point to give all allies within 6 squares of you a +2 insight bonus to their Will Defense that lasts for the remainder of the encounter. This bonus does not extend to allies outside the range of the effect, even if they move within 6 squares of you later on. Allies who benefit from this Talent must remain within 6 squares of you to retain the insight bonus, and they lose it if you are knocked unconscious or killed. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Rebellion Era Campaign Guide When you deal damage to a target by making a Lightsaber attack on your turn, you can use a Swift Action before the end of your turn to activate this Talent. If you do so, allies adjacent to the target at the time you make the attack gain a +2 circumstance bonus to melee attack rolls against the target until the start of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","description":"You can use your Use the Force modifier instead of your Persuasion check modifier when making a Persuasion check. You are considered Trained in the Persuasion skill. If you are entitled to a Persuasion check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisite: If you successfully use the Talent, your target moves an additional -1 step along the Condition Track. This is a Mind-Affecting effect. You affect the Condition Track of the specific character (usually the Vehicle's Commander), not a Starship. You can spend a Full-Round Action advising an ally, thereby granting them a +5 bonus on their next Skill Check. If you spend a Force Point, the bonus increases to +10. The target must be able to (and willing) to hear and understand your voice. You cannot advise yourself. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual As a Standard Action, you can peer into The Force and search for weaknesses in the defenses of your enemies. Make a Use the Force check against the Will Defense of a target creature within 12 squares of you and in your line of sight. If the Skill Check equals or exceeds the target's Will Defense, that target takes a -2 penalty to their Reflex Defense against you and all allies who can hear and understand you until the end of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever you damage an opponent with a Lightsaber attack, you can Take 10 on any Persuasion checks you make before the end of your next turn, even if you would not normally be able to. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: Once per encounter as a Swift Action, you can choose one ally within your line of sight that can hear and understand you. Until the end of the encounter, that ally adds your Wisdom bonus to its Will Defense against Mind-Affecting effects. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per turn as a Swift Action, you can spend a Force Point to let one adjacent ally use the Aid Another Action (as a Reaction) to assist you with a Skill Check. You must make the Skill Check before the end of your turn, or the benefit of the Aid Another Action is lost. An ally that has already used the Aid Another Action to assist you since the end of your last turn may not be targeted by this Talent. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You gain a +2 insight bonus to your Will Defense. Also, as a Swift Action, you can spend a Force Point to give all allies within 6 squares of you a +2 insight bonus to their Will Defense that lasts for the remainder of the encounter. This bonus does not extend to allies outside the range of the effect, even if they move within 6 squares of you later on. Allies who benefit from this Talent must remain within 6 squares of you to retain the insight bonus, and they lose it if you are knocked unconscious or killed. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Rebellion Era Campaign Guide When you deal damage to a target by making a Lightsaber attack on your turn, you can use a Swift Action before the end of your turn to activate this Talent. If you do so, allies adjacent to the target at the time you make the attack gain a +2 circumstance bonus to melee attack rolls against the target until the start of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Consular","treeId":"e99cfa9db8493573","tags":["action-economy","condition-removal","controller","defender","force","force-control","force-defense","force-offense","jedi","leader","light-side","lightsaber","melee","mobility","positioning","scout","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.adept_negotiator"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7acc479dee2d3b10"}}},{"_id":"4186ecdb9fddee8c","name":"Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"f4221ab827c4e8b2","name":"Block","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith Alchemy","prerequisites":"","benefit":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","description":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Sith Alchemy","treeId":"a67faf2ae089ab5d","tags":["action-economy","armor","dark-side","defender","force","force-offense","jedi","lightsaber","melee","mobility","ranged","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.block"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9379daa94a228c04"}}},{"_id":"14cc3652381ec67c","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"f2f44f7f96bf2030","name":"Redirect Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Whenever you redirect a deflected blaster bolt (see the Talent), you gain a +5 bonus on your ranged attack roll.","description":"Whenever you redirect a deflected blaster bolt (see the Talent), you gain a +5 bonus on your ranged attack roll.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.deflect"},{"type":"bab","min":5}],"_source":"canonical-csv"},"treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","positioning","ranged","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.redirect_shot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.941c1dfd00e697da"}}},{"_id":"126fd9193cfa1c3f","name":"Severing Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Duelist","prerequisites":null,"benefit":"If you deal damage exceeding current HP and threshold, deal half damage and sever (special effect) while moving down the track.","description":"If damage exceeds the target's current hit points and damage threshold, deal half damage again, move the target down the condition track, and sever a limb.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Duelist","treeId":"b3c5d90b5036f39b","tags":["jedi","striker"]},"effects":[{"_id":"8a7d9568-c68f-4b0e-a64a-0064e0dd2330","name":"Severing Strike","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.limb_loss","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Severing Strike"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.severing_strike"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.efd3308a8ccc22c6"}}},{"_id":"5b36b153ea383e55","name":"Soresu","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"Block, Deflect","benefit":"Reroll Use the Force checks for Block and Deflect.","description":"When using Block or Deflect, you may reroll your Use the Force check.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["feat-chain","force","jedi","lightsaber","melee","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.soresu"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.af8c6f9b6c06b448"}}},{"_id":"57d5b7758e929981","name":"Weapon Specialization (Lightsabers)","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Duelist","tree":"Duelist","prerequisites":"","description":"Greater Weapon Focus (Lightsabers) You gain a +2 bonus on melee damage rolls with Lightsabers. This bonus stacks with the bonus granted by the Talent. Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. See also: Maiming Foes When you deal damage with a Lightsaber that is equal to or greater than both the target's current Hit Points and the target's Damage Threshold (that is, when you would deal enough damage to kill your target), you may choose to use this Talent. Instead of dealing full damage, you instead deal half damage to your target and move it -1 step on the Condition Track. In addition, you sever one of your target's arms at the wrist or elbow joint, or one of the target's legs at the knee or ankle joint (your choice). Severing part of an arm prevents the target from wielding weapons or using tools in that hand, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Severing part of a leg knocks the target Prone, reduces the target's Speed by half, reduces its Carrying Capacity by half, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Because of the severity of such an injury, losing part of a limb causes a Persistent Condition that can only be removed by having Surgery successfully performed on you. A Cybernetic Prosthesis negates these reductions and penalties. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","benefit":"Greater Weapon Focus (Lightsabers) You gain a +2 bonus on melee damage rolls with Lightsabers. This bonus stacks with the bonus granted by the Talent. Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. See also: Maiming Foes When you deal damage with a Lightsaber that is equal to or greater than both the target's current Hit Points and the target's Damage Threshold (that is, when you would deal enough damage to kill your target), you may choose to use this Talent. Instead of dealing full damage, you instead deal half damage to your target and move it -1 step on the Condition Track. In addition, you sever one of your target's arms at the wrist or elbow joint, or one of the target's legs at the knee or ankle joint (your choice). Severing part of an arm prevents the target from wielding weapons or using tools in that hand, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Severing part of a leg knocks the target Prone, reduces the target's Speed by half, reduces its Carrying Capacity by half, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Because of the severity of such an injury, losing part of a limb causes a Persistent Condition that can only be removed by having Surgery successfully performed on you. A Cybernetic Prosthesis negates these reductions and penalties. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","class":"","category":"","costNumeric":null,"treeId":"b3c5d90b5036f39b","tags":["burst-damage","condition-removal","controller","damage-reduction","defender","force","force-control","force-offense","leader","lightsaber","melee","mobility","scaling","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.00a9210772a64a19"}}},{"_id":"f2eff29e81f0077c","name":"Farseeing","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"1 minute","range":"Unlimited","target":"Special","duration":"Concentration","effect":"<p>You peer through the Force to see distant locations or events. You can observe a place you've been before or a person you know, regardless of distance.</p>","special":"<p>The GM may require additional checks for very distant or obscured visions.</p>","descriptor":["Mind-Affecting","Scrying"],"dcChart":[],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":95,"tags":["utility","divination","scrying"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.0419ecb55f011f81"}}},{"_id":"fb45d5390e076e8d","name":"Force Slam","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One creature or object","duration":"Instantaneous","effect":"<p>You use telekinetic force to violently slam your target against a surface. The target takes 4d6 damage and is knocked prone.</p>","special":"<p>The target must be within 6 squares of a solid surface (wall, floor, ceiling).</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":97,"tags":["attack","damage","telekinetic","prone"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.462a6c23e00c4dfc"}}},{"_id":"4cb80aedc72c8cd9","name":"Mind Trick","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telepathic","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 minute or until completed","effect":"<p>You influence a weak mind to believe what you tell them or follow a simple suggestion. The target must make a Will save (DC = your UTF check) or be affected.</p>","special":"<p>The suggestion must be reasonable and the target must be able to understand you.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["mind-control","suggestion","social"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.e6649f366d6c5737"}}},{"_id":"fe882a651490e667","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"feb7ac4ca0348a82","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}},{"_id":"87432a162aed39ff","name":"Surge","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"vital","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You use the Force to push your body beyond normal limits. You gain an additional move action this turn.</p>","special":"<p>This extra move action can be used to move or perform other move-action tasks.</p>","descriptor":["Vital"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["enhancement","action-economy","movement"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.1ac1084ca8f07114"}}},{"_id":"f2f1d820520bce64","name":"Vital Transfer","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":3,"discipline":"vital","useTheForce":15,"time":"Standa