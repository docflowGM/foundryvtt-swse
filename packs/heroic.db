e Cold ), Integrated Equipment ( Electrobinoculars , Heat Sensor ), Vacuum Seals , Blaster Pistol (2), Combat Gloves , Knife , Riot Shield , Wrist Blaster , Whipcord , Frag Grenade (4), Comlink (Short-Range), Holster (2; Hip), Mandalorian Jet Pack , Medpac , Utility Belt</p>\n<p><strong>Senses:</strong> Darkvision, Perception +9</p>\n<p><strong>Attack Options:</strong> Blast Back, Second Strike, Hailfire, K'thri Training, Point-Blank Shot, Precise Shot, Rapid Shot, Trigger Work, Trusty Sidearm (+2), Twin Shot</p>\n<p><strong>Special Actions:</strong> Assault Tactics, Command Cover (+1), Cover ( Riot Shield ), Quick Draw, Share Talent ( Tough as Nails ), Tactical Edge</p>","derived":{},"npcProfile":{"kind":"heroic","mode":"play","sourceAuthority":"statblock","legalProfile":"heroic","legalState":"unchecked","importMode":"play","playReady":true,"statblockAuthority":true,"sourcePack":"heroic","normalizationVersion":1,"authority":{"hp":"statblock","defenses":"statblock","bab":"statblock","attacks":"statblock","skills":"statblock","damageThreshold":"statblock"}}},"items":[{"_id":"cb03b5869a2fc8da","name":"Human","type":"species","img":"icons/svg/mystery-man.svg","system":{"size":"Medium","speed":6,"abilities":"None","skillBonuses":[],"special":["Bonus Feat: Humans gain one bonus feat at 1st level","Bonus Trained Skill: Humans gain one additional trained skill at 1st level"],"languages":["Basic"],"source":"Core","description":"","tags":[],"visionTraits":[],"naturalWeapons":[],"movementTraits":[],"environmentalTraits":[],"combatTraits":{"naturalArmor":0,"weaponProficiencies":[],"otherTraits":[]},"techTraits":[],"forceTraits":[],"socialTraits":[],"bonusFeats":1,"bonusTrainedSkills":1,"costNumeric":null},"effects":[],"folder":null,"sort":700,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.species.species-human"}}},{"_id":"a311afca89e942a6","name":"Armor Proficiency (light)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with light armor and do not take armor check penalties on attack rolls.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":85,"tags":["armor","defender","non-force","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No penalty on attacks and no <a class=\"mw-redirect\" href=\"/wiki/Armor_Check_Penalty\" title=\"Armor Check Penalty\">Armor Check Penalty</a> while wearing <a href=\"/wiki/Light_Armor\" title=\"Light Armor\">Light Armor</a>."}},"effects":[{"_id":"9781a3c7-4e7e-4af0-9dcc-cdea0524b414","name":"Armor Proficiency (Light)","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.armorProficiency.light","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Armor Proficiency (Light)","effectType":"armor_proficiency"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.773ec00effc7e96f"}}},{"_id":"357a3b5a8e906258","name":"Combat Reflexes","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may make a number of attacks of opportunity per round equal to your Dexterity modifier.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":85,"tags":["feat-chain","non-force","scout","soldier","sustained-damage"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain additional <a href=\"/wiki/Attacks_of_Opportunity\" title=\"Attacks of Opportunity\">Attacks of Opportunity</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.7146640744fdf052"}}},{"_id":"494f197545497625","name":"Dual Weapon Mastery I","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You reduce the penalty for fighting with two weapons by 2.","prerequisite":"Dex 13, Two-Weapon Fighting","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["damage-reduction","dual-wield","feat-chain","non-force","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Take a -5 penalty on attacks when attacking with two weapons, or both ends of a double weapon."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13},{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[{"_id":"5e1f7aa0-8f41-4f6e-9a16-1710b2de25e9","name":"Dual Weapon Mastery I","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Dual Weapon Mastery I","effectType":"passive_effect","flagType":"Dual Weapon Mastery I"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.84d8866a57381620"}}},{"_id":"2ae138f54a91b6d3","name":"Dual Weapon Mastery II","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You reduce the penalty for fighting with two weapons by an additional 2.","prerequisite":"Dual Weapon Mastery I","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["damage-reduction","dual-wield","feat-chain","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Take a -2 penalty on attacks when attacking with two weapons, or both ends of a double weapon."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":15},{"type":"bab","min":6}],"_source":"canonical-csv"}},"effects":[{"_id":"fa217f33-b718-45d3-b256-9226da60389d","name":"Dual Weapon Mastery II","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Dual Weapon Mastery II","effectType":"special","requiresCustomLogic":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c7c99a77ebee1c0c"}}},{"_id":"14a05b0acd4dadda","name":"K'thri Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"martial_arts","benefit":"Once per round, you can spend a Swift Action to make a single Unarmed Attack against one enemy within Reach, dealing your base Unarmed damage with no bonus to the damage roll from your Strength or Heroic Level.\n\nOnce per encounter, when you make an Unarmed Attack that misses the target, you deal half damage to the target.\n\nYou must be wearing Light Armor or no Armor to gain the benefits of this Feat.\n\nSpecial: If you have the K'thri Expertise Talent, once per encounter when making a Full Attack, you can reroll one of your Unarmed attack rolls; however, you must accept the result of the reroll, even if it is worse. You must be wearing Light Armor or no Armor to gain this special benefit.","prerequisite":"Dual Weapon Mastery I, Martial Arts I","special":"","normalText":"","sourcebook":"Star Wars Saga Edition","page":0,"tags":["action-economy","armor","defender","feat-chain","mobility","non-force","striker","sustained-damage","unarmed"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Make swift <a class=\"mw-redirect\" href=\"/wiki/Unarmed\" title=\"Unarmed\">Unarmed</a> attacks. Deal half damage on misses."},"martialArtsFeat":true},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.b00e0a883da4edda"}}},{"_id":"599be012770b7d99","name":"Martial Arts I","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Increases damage from Unarmed attacks by one die step; gain +1 bonus to Reflex Defense.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["defender","non-force","striker","unarmed"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Increases damage from <a class=\"mw-redirect\" href=\"/wiki/Unarmed\" title=\"Unarmed\">Unarmed</a> attacks by one die step; gain +1 bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.92f927c92ded9fcf"}}},{"_id":"8439979188228b7d","name":"Shake It Off","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Spend two Swift Actions to move +1 step along the Condition Track.","prerequisite":"Constitution 13, Trained in Endurance","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["action-economy","condition-removal","controller","feat-chain","mobility","non-force","striker"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Spend two <a href=\"/wiki/Swift_Actions\" title=\"Swift Actions\">Swift Actions</a> to move +1 step along the <a class=\"mw-redirect\" href=\"/wiki/Condition_Track\" title=\"Condition Track\">Condition Track</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"con","min":13},{"type":"skillTrained","skill":"35df8faa4878f2c5"}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.3036290329d5b3e6"}}},{"_id":"d5202cac68c53cb7","name":"Point-Blank Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page"