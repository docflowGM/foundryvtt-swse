 damage from Unarmed attacks by one die step; gain +1 bonus to Reflex Defense.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["defender","non-force","striker","unarmed"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Increases damage from <a class=\"mw-redirect\" href=\"/wiki/Unarmed\" title=\"Unarmed\">Unarmed</a> attacks by one die step; gain +1 bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.92f927c92ded9fcf"}}},{"_id":"3bdc08f483feac70","name":"Martial Arts II","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Increases damage from Unarmed attacks by one die step; gain +1 bonus to Reflex Defense.","prerequisite":"Martial Arts I, Base Attack Bonus +3","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["defender","feat-chain","non-force","striker","unarmed"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Increases damage from <a class=\"mw-redirect\" href=\"/wiki/Unarmed\" title=\"Unarmed\">Unarmed</a> attacks by one die step; gain +1 bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":3}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.5bedd71f0eead6b9"}}},{"_id":"ee0acaef3d6f72b1","name":"Point-Blank Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on ranged attacks and damage against foes within Point-Blank <a class=\"mw-redirect\" href=\"/wiki/Range\" title=\"Range\">Range</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.05459ac4d439f229"}}},{"_id":"3b23da08dce75fc1","name":"Precise Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You do not take the -5 penalty for firing into melee.","prerequisite":"Point Blank Shot","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","melee","non-force","precision","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No -5 penalty for shooting into melee."}},"effects":[{"_id":"77e126ab-16c9-4116-9d67-b5550c007b1b","name":"Precise Shot","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Precise Shot","effectType":"passive_effect","flagType":"Precise Shot"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c180eee7d3bc29b2"}}},{"_id":"78a1f52b91ecee65","name":"Skill Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You become trained in one additional skill. You may take this feat multiple times.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["noble","non-force","scaling","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You become <a class=\"mw-redirect\" href=\"/wiki/Trained\" title=\"Trained\">Trained</a> in one Class Skill."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"1c5f55c5eb8d2257","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"766cfdece7797225","name":"Weapon Proficiency (Heavy Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with heavy weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["heavy-weapons","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"5f95d267-fdb7-43aa-998c-918188f277fe","name":"Weapon Proficiency (Heavy Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Heavy Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Heavy Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.8329a353aa3899be"}}},{"_id":"db71126cf245afb5","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"70223a8a420202c4","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"a7972617fec2c900","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"0fe3539a74e615cb","name":"Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"4ffb89205275a4d3","name":"Battle Analysis","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":"Trained in Initiative","benefit":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus. When you use the Mechanics skill to Handle Explosives, the explosion deals +2 dice of damage. You may take this Talent multiple times; its effects stack. You can distract opponents and convince them that you are the most tempting (or most dangerous) target in the area. As a Swift Action, make a Persuasion check and compare the result to the Will Defense of all opponents within line of sight. If the check result exceeds an opponent's Will Defense, that opponent cannot attack any character within 6 squares of you until the start of your next turn as long as you do not have Cover against that opponent. (The affected opponent may still attack you, however.) If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per round, you may spend a Swift Action to shield a single adjacent ally from attacks, taking the damage and suffering the ill effects in your ally's stead. Until the start of your next turn, any attack made against the protected ally targets you instead. You may elect not to shield your protected ally against a given attack, provided the decision is made before the attack roll is made. If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per day as a Swift Action, you can move +5 steps on the Condition Track. This does not remove any Persistent Conditions that may be affecting you. This Talent does not affect the Condition Track of a Vehicle. You can select this talent multiple times. Each time you select this Talent, you can use it one additional time per day. You can catch a Second Wind one extra time per day. If you have this Talent and the Extra Second Wind feat, you can catch your Second Wind a total of three times per day. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisite: Whenever you have the benefit of Cover, you can spend two Swift Actions to treat it as Improved Cover until the start of your next turn. Reference Book: Star Wars Saga Edition Threats of the Galaxy Prerequisite: When one or more allies uses the Aid Another Action to give you a bonus to your attack roll, you gain a circumstance bonus equal to the total bonus provided to your damage roll. Homebrew Reference Book: Legacy of the Force Sourcebook You add an additional die of damage when attacking with any weapon that has a Burst radius.","description":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus. When you use the Mechanics skill to Handle Explosives, the explosion deals +2 dice of damage. You may take this Talent multiple times; its effects stack. You can distract opponents and convince them that you are the most tempting (or most dangerous) target in the area. As a Swift Action, make a Persuasion check and compare the result to the Will Defense of all opponents within line of sight. If the check result exceeds an opponent's Will Defense, that opponent cannot attack any character within 6 squares of you until the start of your next turn as long as you do not have Cover against that opponent. (The affected opponent may still attack you, however.) If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per round, you may spend a Swift Action to shield a single adjacent ally from attacks, taking the damage and suffering the ill effects in your ally's stead. Until the start of your next turn, any attack made against the protected ally targets you instead. You may elect not to shield your protected ally against a given attack, provided the decision is made before the attack roll is made. If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per day as a Swift Action, you can move +5 steps on the Condition Track. This does not remove any Persistent Conditions that may be affecting you. This Talent does not affect the Condition Track of a Vehicle. You can select this talent multiple times. Each time you select this Talent, you can use it one additional time per day. You can catch a Second Wind one extra time per day. If you have this Talent and the Extra Second Wind feat, you can catch your Second Wind a total of three times per day. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisite: Whenever you have the benefit of Cover, you can spend two Swift Actions to treat it as Improved Cover until the start of your next turn. Reference Book: Star Wars Saga Edition Threats of the Galaxy Prerequisite: When one or more allies uses the Aid Another Action to give you a bonus to your attack roll, you gain a circumstance bonus equal to the total bonus provided to your damage roll. Homebrew Reference Book: Legacy of the Force Sourcebook You add an additional die of damage when attacking with any weapon that has a Burst radius.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Commando","treeId":"798ed0945cbdac1c","tags":["action-economy","battlefield-control","burst-damage","condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","mechanics","mobility","piloting","positioning","ranged","scaling","shields","skills","social","soldier","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.battle_analysis"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7df2e8e4f18dc909"}}},{"_id":"6924d79649e23fce","name":"Cover Fire","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":"Battle Analysis","benefit":"When you make a ranged attack, allies within 6 squares gain +1 Defense until your next turn.","description":"","class":"Soldier","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.battle_analysis"}],"_source":"canonical-csv"},"treeId":"798ed0945cbdac1c","tree":"Commando","tags":["defender","feat-chain","positioning","ranged","soldier","striker","talent-chain"]},"effects":[{"_id":"6a421fc4-15d4-4819-8d96-a2ffb7283d28","name":"Cover Fire","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.all","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Cover Fire"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.cover_fire"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.049820827d7ef32b"}}},{"_id":"72a7cc13ae409d98","name":"Deployment Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Military Tactics","prerequisites":"","benefit":"You know how to use existing terrain to your best advantage. By using a Move Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, you and all allies within 10 squares of you can use whatever Cover is available to gain a +10 Cover bonus to Reflex Defense (instead of the normal +5 Cover bonus). Allies must be able to hear and understand you to gain this benefit, and the bonus lasts until the start of your next turn. This Talent provides no benefit to anyone who doesn't have Cover. This is a Mind-Affecting effect. Prerequisite: As a Reaction, you can choose to take one-half or all of the damage dealt to an adjacent ally by a single attack. Similarly, as a Reaction, an adjacent ally can choose to take one-half or all of the damage dealt to you by a single attack (even if they don't have this Talent). Prerequisites: , Field Tactics An Officer learns to counter the tactics of their enemies. As a Standard Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, opponents in your line of sight lose all competence, insight, and morale bonuses on attack rolls, as well as any dodge bonuses to Reflex Defense, until the start of your next turn. If one or more enemy Officers are within your line of sight, the highest level Officer among them can attempt to Oppose your Knowledge (Tactics) check as a Reaction. If their Skill Check result is higher than yours, your attempt to Outmaneuver your opponents fails. As a Swift Action, you can take a -2 penalty to one Defense (Reflex, Fortitude, or Will) to gain a +1 competence bonus to another Defense until the start of your next turn.","description":"You know how to use existing terrain to your best advantage. By using a Move Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, you and all allies within 10 squares of you can use whatever Cover is available to gain a +10 Cover bonus to Reflex Defense (instead of the normal +5 Cover bonus). Allies must be able to hear and understand you to gain this benefit, and the bonus lasts until the start of your next turn. This Talent provides no benefit to anyone who doesn't have Cover. This is a Mind-Affecting effect. Prerequisite: As a Reaction, you can choose to take one-half or all of the damage dealt to an adjacent ally by a single attack. Similarly, as a Reaction, an adjacent ally can choose to take one-half or all of the damage dealt to you by a single attack (even if they don't have this Talent). Prerequisites: , Field Tactics An Officer learns to counter the tactics of their enemies. As a Standard Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, opponents in your line of sight lose all competence, insight, and morale bonuses on attack rolls, as well as any dodge bonuses to Reflex Defense, until the start of your next turn. If one or more enemy Officers are within your line of sight, the highest level Officer among them can attempt to Oppose your Knowledge (Tactics) check as a Reaction. If their Skill Check result is higher than yours, your attempt to Outmaneuver your opponents fails. As a Swift Action, you can take a -2 penalty to one Defense (Reflex, Fortitude, or Will) to gain a +1 competence bonus to another Defense until the start of your next turn.","class":"Officer","costNumeric":null,"category":"Officer","tree":"Military Tactics","treeId":"9253ace716c3e966","tags":["action-economy","controller","defender","evasion","leader","mobility","positioning","scout","skills","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deployment_tactics"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8a5f8b5c9b9fabaf"}}},{"_id":"87d8efd96545b136","name":"Draw Fire","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Disgrace","prerequisites":"","benefit":"You may not gain the benefit of this Talent if another character within 6 squares of you has used this talent since the end of your last turn. You may not use this Talent in the same round as the Soldier's Talent.","description":"You may not gain the benefit of this Talent if another character within 6 squares of you has used this talent since the end of your last turn. You may not use this Talent in the same round as the Soldier's Talent.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Disgrace","treeId":"e91cc675fbf9ba6e","tags":["positioning","soldier","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.draw_fire"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f29d5c0628459c94"}}},{"_id":"60e84da60acc0222","name":"Improved Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Armor Specialist","prerequisites":"Armored Defense","benefit":"Your Reflex Defense bonus equals either your heroic level + half your armor bonus, or your armor bonus.","description":"Your Reflex Defense bonus equals either your heroic level plus half your armor bonus or your armor bonus.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Armor Specialist","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.armored_defense"}],"_source":"canonical-csv"},"treeId":"17cec542331cb4e4","tags":["armor","defender","feat-chain","soldier","striker","talent-chain"]},"effects":[{"_id":"842ee02b-8f7e-4a40-802a-c6fe553379a5","name":"Improved Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Improved Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.t