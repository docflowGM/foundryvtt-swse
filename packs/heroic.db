"special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["noble","non-force","scaling","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You become <a class=\"mw-redirect\" href=\"/wiki/Trained\" title=\"Trained\">Trained</a> in one Class Skill."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"5cc1fc08107122ba","name":"Sniper","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may aim as a move action instead of a standard action when using a rifle or pistol.","prerequisite":"Point Blank Shot","special":"","normalText":"","sourcebook":"Galaxy at War","page":27,"tags":["action-economy","controller","feat-chain","mobility","non-force","ranged","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You ignore <a class=\"mw-redirect\" href=\"/wiki/Soft_Cover\" title=\"Soft Cover\">Soft Cover</a> when making a ranged attack."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":4}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.56367f3943ee8c17"}}},{"_id":"768fa975c3b9cc11","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"02b33f99733b77ae","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"c1a353ca377e714f","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"8a0ba81b211b2c06","name":"Dastardly Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","tree":"Misfortune","prerequisites":"Combat Reflexes","description":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","benefit":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","class":"","category":"","costNumeric":null,"treeId":"67b59e020c1660eb","tags":["condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","lightsaber","melee","mobility","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9e4345faaaa94dd8"}}},{"_id":"eeec2efb4732a632","name":"Demolitionist","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":null,"benefit":"When using Mechanics to set explosives, deal +2 dice of damage; may be taken multiple times and stacks.","description":"","class":"Soldier","costNumeric":null,"category":"Soldier","treeId":"798ed0945cbdac1c","tree":"Commando","tags":["mechanics","scaling","skills","soldier","striker"]},"effects":[{"_id":"1e1f48cc-a5a2-4a95-a9ec-599c316d3d60","name":"Demolitionist","icon":"icons/svg/explosion.svg","changes":[{"key":"system.damage.explosives","mode":2,"value":"2d6"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Demolitionist"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.demolitionist"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8aedbfb39b9f3b52"}}},{"_id":"4d1f4cf671c054a3","name":"Indomitable","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":null,"benefit":"Once per day, move +5 steps up the condition track (not persistent conditions); may be taken multiple times.","description":"","class":"Soldier","costNumeric":null,"category":"Soldier","treeId":"798ed0945cbdac1c","tree":"Commando","tags":["condition-removal","controller","mobility","scaling","soldier","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.indomitable"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.b8aaf500d3069938"}}},{"_id":"fb7638ec10dbd642","name":"Skirmisher","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"When you move at least 2 squares before your attack and end your move in a different square from where you started, you gain a +1 bonus to all your Defenses until the start of your next turn. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Sneak Attack Whenever you would gain the benefit of the Talent and you successfully hit your opponent, you deal Sneak Attack damage in addition to the normal damage dealt by the attack. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"When you move at least 2 squares before your attack and end your move in a different square from where you started, you gain a +1 bonus to all your Defenses until the start of your next turn. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Sneak Attack Whenever you would gain the benefit of the Talent and you successfully hit your opponent, you deal Sneak Attack damage in addition to the normal damage dealt by the attack. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["controller","defender","mobility","positioning","precision","scoundrel","striker"]},"effects":[{"_id":"b27e05f0-9859-46a5-92ab-7f844073dc03","name":"Skirmisher","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Skirmisher"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.skirmisher"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7b23e0812d6a8985"}}},{"_id":"f08bec02181aa2ac","name":"Sneak Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["action-economy","battlefield-control","controller","defender","melee","mobility","positioning","precision","ranged","scaling","scoundrel","skills","social","striker"]},"effects":[{"_id":"3195415b-2276-403c-9fb1-5d323d38d31a","name":"Sneak Attack","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.flatfooted","mode":2,"value":"1d6"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Sneak Attack"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.sneak_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.1505abc8babeeb84"}}},{"_id":"5b82da42e480e6f0","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+5","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":7,"flatDamageFormula":"1d4+5","useFlat":true}}}},{"_id":"74d4984a767096b2","name":"Knife","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+5","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Knife","npc":{"flatAttackBonus":7,"flatDamageFormula":"1d4+5","useFlat":true}}}},{"_id":"a6c7268872ac2c5e","name":"Blaster Rifle","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+4","damageType":"energy","attackBonus":0,"att