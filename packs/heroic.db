":"Compendium.foundryvtt-swse.feats.ddbeb23013d9e917"}}},{"_id":"b31d2026715fd8a7","name":"Sniper Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"","prerequisite":"","special":"","normalText":"","sourcebook":"Knights of the Old Republic Campaign Guide","page":30,"tags":["non-force","ranged"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Increase accuracy at a -5 <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a> penalty."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.94fc90a53d747f84"}}},{"_id":"5be7a7a016f8936a","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"0c8b61b9bb0b720b","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"368a103d70afe96a","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"15b174186bd4e829","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"b9d6dc66744c7271","name":"Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"b5e992964b4c6983","name":"Knack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fortune","prerequisites":"","benefit":"Once per day, you can reroll an attack roll and take the better result. You can select this Talent multiple times; each time you select this Talent, you can use it one additional time per day. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot You are possessed of incredible luck and an uncanny ability to succeed where others would fail. You can use each of the following actions once per encounter as a Standard Action: Elude Enemy: Make a single melee or ranged attack against any target within your Range. If you damage the target, you gain a +2 bonus to your Reflex Defense against this target until the beginning of your next turn. Escape: Make a single melee or ranged attack against any target within your Range. If that target successfully damages you before the start of your next turn, you can immediately move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Make your Own Luck: Make a single melee or ranged attack against any target within your Range. If you miss this target, you gain a +2 bonus on your next attack roll. Reference Book: Star Wars Saga Edition Scum and Villainy Once per encounter, as a Reaction, you become immune to all Mind-Affecting effects until the end of your next turn (you can choose to ignore this for beneficial effects). Any Mind-Affecting effects currently afflicting you are also removed, though you can choose to retain any beneficial effects you currently have. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisite: A successful hit against you is mitigated by an item you just happen to be wearing or carrying, or glances off your armor or clothing in just the right way. Once per encounter, as a Reaction, you can negate the damage from a single attack that would normally reduce you to 0 Hit Points. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot When making a ranged attack against a target with Cover, you can choose to reduce the benefit of that target's Cover by one step, from Improved Cover to Cover, or Cover to no Cover. You deal only half damage with this attack. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can consider any single d20 roll of 16 or higher to be a Natural 20. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can reroll the damage of one attack, keeping the better of the two results. Gambler's Fortune Talent data created by Sterling Hershey (source). Prerequisites: , Trained in Chosen Skill Select one of the following Skills: Knowledge (Any), Mechanics, Perception, or Use Computer. When making a reroll for that Skill, you may keep the better result.","description":"Once per day, you can reroll an attack roll and take the better result. You can select this Talent multiple times; each time you select this Talent, you can use it one additional time per day. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot You are possessed of incredible luck and an uncanny ability to succeed where others would fail. You can use each of the following actions once per encounter as a Standard Action: Elude Enemy: Make a single melee or ranged attack against any target within your Range. If you damage the target, you gain a +2 bonus to your Reflex Defense against this target until the beginning of your next turn. Escape: Make a single melee or ranged attack against any target within your Range. If that target successfully damages you before the start of your next turn, you can immediately move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Make your Own Luck: Make a single melee or ranged attack against any target within your Range. If you miss this target, you gain a +2 bonus on your next attack roll. Reference Book: Star Wars Saga Edition Scum and Villainy Once per encounter, as a Reaction, you become immune to all Mind-Affecting effects until the end of your next turn (you can choose to ignore this for beneficial effects). Any Mind-Affecting effects currently afflicting you are also removed, though you can choose to retain any beneficial effects you currently have. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisite: A successful hit against you is mitigated by an item you just happen to be wearing or carrying, or glances off your armor or clothing in just the right way. Once per encounter, as a Reaction, you can negate the damage from a single attack that would normally reduce you to 0 Hit Points. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot When making a ranged attack against a target with Cover, you can choose to reduce the benefit of that target's Cover by one step, from Improved Cover to Cover, or Cover to no Cover. You deal only half damage with this attack. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can consider any single d20 roll of 16 or higher to be a Natural 20. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can reroll the damage of one attack, keeping the better of the two results. Gambler's Fortune Talent data created by Sterling Hershey (source). Prerequisites: , Trained in Chosen Skill Select one of the following Skills: Knowledge (Any), Mechanics, Perception, or Use Computer. When making a reroll for that Skill, you may keep the better result.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Fortune","treeId":"cee9b9398682b7d0","tags":["action-economy","armor","controller","damage-reduction","defender","mechanics","melee","mobility","perception","positioning","ranged","scaling","scoundrel","skills","slicing","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.knack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ac6baadb9d65ff7f"}}},{"_id":"5a02f9d4b76d1da3","name":"Sneak Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["action-economy","battlefield-control","controller","defender","melee","mobility","positioning","precision","ranged","scaling","scoundrel","skills","social","striker"]},"effects":[{"_id":"3195415b-2276-403c-9fb1-5d323d38d31a","name":"Sneak Attack","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.flatfooted","mode":2,"value":"1d6"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Sneak Attack"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.sneak_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.1505abc8babeeb84"}}},{"_id":"0d6834a7c344669e","name":"Vibroblade","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d6+3","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":2,"cost":500,"equipped":true,"description":"<p>A blade weapon enhanced with ultrasonic vibrations that increase its cutting power.</p>\n      <p><strong>Special:</strong> Vibroweapon. Critical threat range 19-20.</p>","properties":["Vibroweapon","Critical 19-20"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"advanced-melee","subcategory":"advanced","costNumeric":500,"category":"advanced"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-vibroblade"},"swse":{"npc":{"flatAt