:"general","benefit":"You are proficient with heavy armor and do not take armor check penalties on attack rolls.","prerequisite":"Armor Proficiency (Medium)","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":85,"tags":["armor","defender","feat-chain","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No penalty on attacks and no <a class=\"mw-redirect\" href=\"/wiki/Armor_Check_Penalty\" title=\"Armor Check Penalty\">Armor Check Penalty</a> while wearing <a href=\"/wiki/Light_Armor\" title=\"Light Armor\">Light Armor</a>, <a href=\"/wiki/Medium_Armor\" title=\"Medium Armor\">Medium Armor</a>, or <a href=\"/wiki/Heavy_Armor\" title=\"Heavy Armor\">Heavy Armor</a>."}},"effects":[{"_id":"2c536333-89aa-4859-b875-3c23070a7e9b","name":"Armor Proficiency (Heavy)","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.armorProficiency.heavy","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Armor Proficiency (Heavy)","effectType":"armor_proficiency"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.859d6b9f49118499"}}},{"_id":"bc64bcd656b9683f","name":"Linguist","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a number of additional Languages equal to 1 + your Intelligence modifier (Minimum 1). If your Intelligence modifier increases so does the number of languages granted by this Feat.","prerequisite":"Int 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["feat-chain","leader","noble","non-force","striker"],"bonus_feat_for":["Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain bonus <a href=\"/wiki/Languages\" title=\"Languages\">Languages</a> equal to 1 + your <a href=\"/wiki/Intelligence\" title=\"Intellig