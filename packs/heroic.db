d":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"686f0a4f0a32eeca","name":"Acute Senses","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Master Scout","prerequisites":"","benefit":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","description":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Master Scout","treeId":"dca33c0215264a02","tags":["action-economy","armor","controller","damage-reduction","defender","force","force-control","force-defense","force-offense","melee","mobility","positioning","ranged","scout","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.acute_senses"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f0166d26d9f6252a"}}},{"_id":"ed47f157922e8962","name":"Hyperdriven","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Spacer","prerequisites":null,"benefit":"Once per day, add your class level to an attack, skill, or ability check.","description":"Once per day, add your class level to an attack roll, skill check, or ability check.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Spacer","treeId":"5ea8c79492d40713","tags":["scoundrel","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hyperdriven"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.29f73c36cabdeaf5"}}},{"_id":"cc1bef5497ef03b7","name":"Skirmisher","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"When you move at least 2 squares before your attack and end your move in a different square from where you started, you gain a +1 bonus to all your Defenses until the start of your next turn. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Sneak Attack Whenever you would gain the benefit of the Talent and you successfully hit your opponent, you deal Sneak Attack damage in addition to the normal damage dealt by the attack. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"When you move at least 2 squares before your attack and end your move in a different square from where you started, you gain a +1 bonus to all your Defenses until the start of your next turn. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Sneak Attack Whenever you would gain the benefit of the Talent and you successfully hit your opponent, you deal Sneak Attack damage in addition to the normal damage dealt by the attack. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["controller","defender","mobility","positioning","precision","scoundrel","striker"]},"effects":[{"_id":"b27e05f0-9859-46a5-92ab-7f844073dc03","name":"Skirmisher","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Skirmisher"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.skirmisher"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7b23e0812d6a8985"}}},{"_id":"cc60684c612da08b","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d6+7","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[