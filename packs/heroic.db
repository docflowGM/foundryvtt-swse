at","featName":"Dual Weapon Mastery I","effectType":"passive_effect","flagType":"Dual Weapon Mastery I"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.84d8866a57381620"}}},{"_id":"05d941d9103988d6","name":"Dual Weapon Mastery II","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You reduce the penalty for fighting with two weapons by an additional 2.","prerequisite":"Dual Weapon Mastery I","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["damage-reduction","dual-wield","feat-chain","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Take a -2 penalty on attacks when attacking with two weapons, or both ends of a double weapon."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":15},{"type":"bab","min":6}],"_source":"canonical-csv"}},"effects":[{"_id":"fa217f33-b718-45d3-b256-9226da60389d","name":"Dual Weapon Mastery II","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Dual Weapon Mastery II","effectType":"special","requiresCustomLogic":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c7c99a77ebee1c0c"}}},{"_id":"e3324ce2fd1f26cd","name":"Force Sensitivity","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"You can make Use the Force checks and gain access to Force Talents.","prerequisite":"Non-Droid","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["feat-chain","force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You can make <a href=\"/wiki/Use_the_Force\" title=\"Use the Force\">Use the Force</a> checks and gain access to <a href=\"/wiki/Force_Talents\" title=\"Force Talents\">Force Talents</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ddbeb23013d9e917"}}},{"_id":"2e3647d5e7d8ed46","name":"Force Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"You learn a number of Force powers equal to 1 + your Wisdom modifier.","prerequisite":"Force Sensitivity, Trained in Use the Force","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["feat-chain","force","jedi","striker"],"bonus_feat_for":["Jedi"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"forcePowerGrants":1,"description":{"value":"Learn a number of <a href=\"/wiki/Force_Powers\" title=\"Force Powers\">Force Powers</a> equal to 1 + your <a href=\"/wiki/Wisdom\" title=\"Wisdom\">Wisdom</a> modifier (minimum 1)."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"usetheforce"}],"_source":"canonical-csv"}},"effects":[{"_id":"d1c60a9b-78e6-4601-85a4-320794fa5a91","name":"Force Training","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Force Training","effectType":"passive_effect","flagType":"Force Training"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.9b7b869a86f39190"}}},{"_id":"4b7201e14f756a87","name":"Martial Arts I","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Increases damage from Unarmed attacks by one die step; gain +1 bonus to Reflex Defense.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["defender","non-force","striker","unarmed"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Increases damage from <a class=\"mw-redirect\" href=\"/wiki/Unarmed\" title=\"Unarmed\">Unarmed</a> attacks by one die step; gain +1 bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.92f927c92ded9fcf"}}},{"_id":"e306af6c3c87022c","name":"Martial Arts II","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Increases damage from Unarmed attacks by one die step; gain +1 bonus to Reflex Defense.","prerequisite":"Martial Arts I, Base Attack Bonus +3","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["defender","feat-chain","non-force","striker","unarmed"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Increases damage from <a class=\"mw-redirect\" href=\"/wiki/Unarmed\" title=\"Unarmed\">Unarmed</a> attacks by one die step; gain +1 bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":3}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.5bedd71f0eead6b9"}}},{"_id":"a86e7eb6a5d34512","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"c1598b7da1f4d4f7","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"11b9a9cd59381db7","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"61260e01be6e1c1f","name":"Multitarget Power","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-secret.png","system":{"featType":"force","benefit":"When using a Force Power that affects a single target, you can spend a Force Point to affect one additional target.","prerequisite":"","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-secret"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":"<p><strong>Cost:</strong> Force Point or Destiny Point</p><p>When using a Force Power that affects a single target, you can spend a Force Point to affect one additional target.</p><p>Alternatively, you can spend a Destiny Point to affect one target per four Character Levels.</p>","cost":"Force Point or Destiny Point","alternativeCost":"Alternatively, you can spend a Destiny Point to affect one target per four Character Levels."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcesecrets.af908ace9a361603"}}},{"_id":"5a924fd3e2bf02fc","name":"Quicken Power","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-secret.png","system":{"featType":"force","benefit":"When using a Force Power that requires a Standard Action or Move Action to activate, you can spend a Force Point to activate the Force Power as a Swift Action instead.","prerequisite":"","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-secret"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":"<p><strong>Cost:</strong> Force Point or Destiny Point</p><p>When using a Force Power that requires a Standard Action or Move Action to activate, you can spend a Force Point to activate the Force Power as a Swift Action instead.</p><p>Alternatively, you can spend a Destiny Point to activate the Force Power as a Reaction instead.</p>","cost":"Force Point or Destiny Point","alternativeCost":"Alternatively, you can spend a Destiny Point to activate the Force Power as a Reaction instead."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcesecrets.52bf7b9a1a41de2b"}}},{"_id":"49f4f94dea3fc29c","name":"Force Point Recovery","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"At the end of an encounter, you automatically recover 1 Force Point spent during the encounter.","prerequisite":"","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>At the end of an encounter, you automatically recover 1 Force Point spent during the encounter.</p>","relatedPower":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.056ab39b3ab9df10"}}},{"_id":"1c9184a01297ec29","name":"Improved Force Trance","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"Each hour you remain in a Force Trance, you regain a number of Hit Points equal to 2 x your Character Level.","prerequisite":"Force Trance","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>Each hour you remain in a Force Trance, you regain a number of Hit Points equal to 2 x your Character Level.</p><p><strong>Related Power:</strong> Force Trance</p><p><strong>Prerequisites:</strong> Force Trance</p>","relatedPower":"Force Trance"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.93b96db5b560e14a"}}},{"_id":"9dc0b6f37f90e81d","name":"Improved Sense Surroundings","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may use the Sense Surroundings application of the Use the Force Skill as a Free Action rather than a Swift Action.","prerequisite":"Sense Surroundings","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may use the Sense Surroundings application of the Use the Force Skill as a Free Action rather than a Swift Action.</p><p><strong>Related Power:</strong> Sense Surroundings</p><p><strong>Prerequisites:</strong> Sense Surroundings</p>","relatedPower":"Sense Surroundings"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.4955b5076ca5da89"}}},{"_id":"03aa13a0c0b81d21","name":"Acrobatic Recovery","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"You may Take 10 on Acrobatics checks to Tumble, even when distracted or threatened. Additionally, each threatened or occupied square that you Tumble through only counts as 1 square of movement.","description":"You may Take 10 on Acrobatics checks to Tumble, even when distracted or threatened. Additionally, each threatened or occupied square that you Tumble through only counts as 1 square of movement.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["controller","jedi","lightsaber","melee","mobility","positioning","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.acrobatic_recovery"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5d4a63123e5a5eb4"}}},{"_id":"cf55eff47c445bb4","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"d5c569276419f876","name":"Force Fortification","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Duelist","prerequisites":null,"benefit":"Negate critical hits and take normal damage instead.","description":"When you would suffer a critical hit, negate the critical and take normal damage instead.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Duelist","treeId":"b3c5d90b5036f39b","tags":["force","force-offense","jedi","precision","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"skillSubstitution":true,"substitutionType":"fortitude_to_will","description":"Your Will Defense now functions in place of Fortitude Defense","id":"swse.talent.force_fortification"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.be932caff635f8bc"}}},{"_id":"69d0ff8d580e91bf","name":"Force Perception","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sense","prerequisites":"","benefit":"You may spend a Force Point to reroll an Initiative check, keeping the better of the two rolls. Additionally, if you roll a natural 20 on the Initiative check reroll, you immediately regain the Force Point spent to activate this talent. Prerequisite: By focusing on a specific creature in your line of sight, you can gauge how strong in The Force they are. This takes a Standard Action and requires a Use the Force check. If your check result meets or beats the target's Will Defense, you know whether or not they have the Force Sensitivity feat, you know how many Force Powers they know (but not which ones specifically), and you know how many Force Points they currently have. Prerequisites: , Farseeing See also: On the Force, Visions, and Discretion Whenever you use the Farseeing Force Power, you can spend a Force Point as a Swift Action to see into the target's past or future instead of the present. You declare how far into the target's past or future you wish to look, up to a maximum of 1 year per your Character Level. Any information gained about a target's future is subject to change, depending on whether steps are taken to alter that future. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide As a Standard Action, you can spend a Force Point to ignore all Concealment for 1 minute. Prerequisites: , Farseeing As a Swift Action, you can peer into the future in search of signs of danger, removing one use of the Farseeing Force Power from your active Force Power Suite (as though you had just activated the Force Power). Any time before the end of your next turn when you are the target of an attack or Force Power, you can force your attacker to reroll the attack roll (or Use the Force check) against you, keeping the second result. This counts as using the Farseeing Force Power against the attacker, but this Talent replaces the normal rules and effect of that Force Power. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisites: , Farseeing When you use the Farseeing Force Power, you can choose to target an object you hold instead of a character or creature. You can look into the targeted item's past, up to a maximum of 5 years per your Character Level. Any information gained about the object's past is based on the thoughts and emotions of the person holding or carrying the object at the time you perceive, which can skew the results of the vision. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to gain Low-Light Vision (see Visibility) for 1 minute or until the end of the encounter, whichever is longer. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Jedi Padawans Prerequisites: Once per encounter, you may spend a Force Point to gain a +1 insight bonus to your Reflex Defense and Will Defense for the remainder of the encounter, or until you are knocked unconscious.","description":"You may spend a Force Point to reroll an Initiative check, keeping the better of the two rolls. Additionally, if you roll a natural 20 on the Initiative check reroll, you immediately regain the Force Point spent to activate this talent. Prerequisite: By focusing on a specific creature in your line of sight, you can gauge how strong in The Force they are. This takes a Standard Action and requires a Use the Force check. If your check result meets or beats the target's Will Defense, you know whether or not they have the Force Sensitivity feat, you know how many Force Powers they know (but not which ones specifically), and you know how many Force Points they currently have. Prerequisites: , Farseeing See also: On the Force, Visions, and Discretion Whenever you use the Farseeing Force Power, you can spend a Force Point as a Swift Action to see into the target's past or future instead of the present. You declare how far into the target's past or future you wish to look, up to a maximum of 1 year per your Character Level. Any information gained about a target's future is subject to change, depending on whether steps are taken to alter that future. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide As a Standard Action, you can spend a Force Point to ignore all Concealment for 1 minute. Prerequisites: , Farseeing As a Swift Action, you can peer into the future in search of signs of danger, removing one use of the Farseeing Force Power from your active Force Power Suite (as though you had just activated the Force Power). Any time before the end of your next turn when you are the target of an attack or Force Power, you can force your attacker to reroll the attack roll (or Use the Force check) against you, keeping the second result. This counts as using the Farseeing Force Power against the attacker, but this Talent replaces the normal rules and effect of that Force Power. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisites: , Farseeing When you use the Farseeing Force Power, you can choose to target an object you hold instead of a character or creature. You can look into the targeted item's past, up to a maximum of 5 years per your Character Level. Any information gained about the object's past is based on the thoughts and emotions of the person holding or carrying the object at the time you perceive, which can skew the results of the vision. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to gain Low-Light Vision (see Visibility) for 1 minute or until the end of the encounter, whichever is longer. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Jedi Padawans Prerequisites: Once per encounter, you may spend a Force Point to gain a +1 insight bonus to your Reflex Defense and Will Defense for the remainder of the encounter, or until you are knocked unconscious.","costNumeric":null,"tree":"Sense","treeId":"d6b4331c0e31f7e3","tags":["action-economy","defender","force","force-defense","force-offense","light-side","mobility","scout","skills","stealth","striker","support"]},"effects":[{"name":"Force Perception (Trained)","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.skills.perception.trained","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Force Perception","effectType":"skill-trained"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_perception"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a358402a9fc26c02"}}},{"_id":"1522d6bd1e68e772","name":"Greater Weapon Focus (lightsabers)","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Duelist","prerequisites":"Weapon Focus (lightsabers)","benefit":"Gain an additional +1 attack with lightsabers.","description":"Gain +1 attack with lightsabers.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Duelist","treeId":"b3c5d90b5036f39b","tags":["feat-chain","jedi","lightsaber","melee","striker","talent-chain"]},"effects":[{"_id":"e871f71e-474b-4e58-b378-9ebb4f6702c3","name":"Greater Weapon Focus (lightsabers)","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks.lightsaber","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Greater Weapon Focus (lightsabers)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.greater_weapon_focus_lightsabers"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.3038f4c26de19e39"}}},{"_id":"109d4b59b6cbfa5b","name":"Juyo","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"Prerequisites: Double Attack (Lightsabers), Skill Focus (Use the Force), Base Attack Bonus +12","benefit":"Weapon Focus (Lightsabers), Weapon Specialization (Lightsabers), Base Attack Bonus +12 When attacking with a Lightsaber, you score a critical hit on a natural roll of 19 or 20. However, a natural 19 is not considered an automatic hit; if you roll a natural 19 and still miss the target, you do not score a critical hit. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - The Dark Side You may make a Deception check as a Swift Action (instead of a Standard Action) when attempting to Feint in combat. Maho-Kai Lightsaber Form Talent created by Wikia user SirenEyes. Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you may choose to forgo an attack and instead activate a Force Power that requires a Standard Action or Move Action to activate. When activating a Force Power in this manner, apply the attack roll penalty to the Use the Force check to activate the Force Power. You may only activate one Force Power in this manner each Round. Tripzest Lightsaber Form Talent created by Wikia user Droidscotty.","description":"Weapon Focus (Lightsabers), Weapon Specialization (Lightsabers), Base Attack Bonus +12 When attacking with a Lightsaber, you score a critical hit on a natural roll of 19 or 20. However, a natural 19 is not considered an automatic hit; if you roll a natural 19 and still miss the target, you do not score a critical hit. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - The Dark Side You may make a Deception check as a Swift Action (instead of a Standard Action) when attempting to Feint in combat. Maho-Kai Lightsaber Form Talent created by Wikia user SirenEyes. Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you may choose to forgo an attack and instead activate a Force Power that requires a Standard Action or Move Action to activate. When activating a Force Power in this manner, apply the attack roll penalty to the Use the Force check to activate the Force Power. You may only activate one Force Power in this manner each Round. Tripzest Lightsaber Form Talent created by Wikia user Droidscotty.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["action-economy","burst-damage","controller","dark-side","feat-chain","force","force-control","force-offense","jedi","lightsaber","melee","mobility","precision","skills","social","striker","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.juyo"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5fd19be0deca1115"}}},{"_id":"22dd30c8811a0082","name":"Lightsaber Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Niman When you use the Talent, you gain twice the normal deflection bonus to your Reflex Defense when you are wielding two Lightsabers. Prerequisite: When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Talent increases by 2 (to a maximum of +5). When wielding a Lightsaber, you gain a +1 bonus to your Reflex Defense and Will Defense.","description":"Niman When you use the Talent, you gain twice the normal deflection bonus to your Reflex Defense when you are wielding two Lightsabers. Prerequisite: When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Talent increases by 2 (to a maximum of +5). When wielding a Lightsaber, you gain a +1 bonus to your Reflex Defense and Will Defense.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["defender","jedi","lightsaber","melee","striker"]},"effects":[{"_id":"fcdbf882-923a-4095-b0df-a1079c214099","name":"Lightsaber Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Lightsaber Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.lightsaber_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e8bf1222fd6289e4"}}},{"_id":"c95321c097e165a4","name":"Redirect Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Whenever you redirect a deflected blaster bolt (see the Talent), you gain a +5 bonus on your ranged attack roll.","description":"Whenever you redirect a deflected blaster bolt (see the Talent), you gain a +5 bonus on your ranged attack roll.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.deflect"},{"type":"bab","min":5}],"_source":"canonical-csv"},"treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","positioning","ranged","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.redirect_shot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.941c1dfd00e697da"}}},{"_id":"05847e758e4f8330","name":"Battle Strike","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You channel the Force to enhance your next melee attack. Your next melee attack this round gains a +1d6 bonus to damage.</p>","special":"<p>This bonus damage is Force damage and bypasses Damage Reduction.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["enhancement","damage","melee"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f177dc6d65f76de9"}}},{"_id":"25ea0bd2a43c8847","name":"Force Thrust","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One creature or object","duration":"Instantaneous","effect":"<p>You violently push your target away with telekinetic force. The target is pushed 6 squares away from you and knocked prone, taking 2d6 damage.</p>","special":"<p>If the target hits an obstacle during the push, they take an additional 1d6 damage per 2 squares not traveled.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":97,"tags":["attack","movement","telekinetic","forced-movement"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.d51bf85903366b6b"}}},{"_id":"cbc7afb5e62bbaac","name":"Mind Trick","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telepathic","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 minute or until completed","effect":"<p>You influence a weak mind to believe what you tell them or follow a simple suggestion. The target must make a Will save (DC = your UTF check) or be affected.</p>","special":"<p>The suggestion must be reasonable and the target must be able to understand you.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["mind-control","suggestion","social"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.e6649f366d6c5737"}}},{"_id":"b52478be726d0b39","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"f1471acfdfa08b25","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}},{"_id":"d8394f5ee357d8cd","name":"Surge","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"vital","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You use the Force to push your body beyond normal limits. You gain an additional move action this turn.</p>","special":"<p>This extra move action can be used to move or perform other move-action tasks.</p>","descriptor":["Vital"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["enhancement","action-economy","movement"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.1ac1084ca8f07114"}}},{"_id":"3c2dd17cee6fa604","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage"