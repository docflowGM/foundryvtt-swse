bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a> against a selected target."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13}],"_source":"canonical-csv"}},"effects":[{"name":"Dodge","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"feat-defense-bonus","source":"Dodge","defenseType":"reflex"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.45366d4f3a5e443d"}}},{"_id":"d7ec2522efc5d79b","name":"Double Attack","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may make two attacks on your turn as a full-round action, each at a -5 penalty.","prerequisite":"Base attack bonus +6","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["action-economy","feat-chain","non-force","soldier","sustained-damage"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Make an extra attack with chosen weapon during <a href=\"/wiki/Full_Attack\" title=\"Full Attack\">Full Attack</a>, -5 penalty to all attacks."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":6}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.357807a5ceb77203"}}},{"_id":"45261c3492e28ca1","name":"Far Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You reduce the range penalties for ranged attacks by half.","prerequisite":"Point Blank Shot","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["damage-reduction","feat-chain","non-force","positioning","ranged","scout","sol