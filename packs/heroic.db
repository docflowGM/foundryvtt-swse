n , Low-Light Vision), Blaster Pistol (2), Combat Gloves , Flamethrower (Gauntlet), Rocket Dart Launcher, Saberdart Launcher , Whipcord (As Net ), Antisecurity Blades , Mandalorian Jet Pack (10 Charges), Slave I</p>\n<p><strong>Senses:</strong> Low-Light Vision, Perception +16</p>\n<p><strong>Attack Options:</strong> Careful Shot, Deadeye, Lucky Shot, Point-Blank Shot, Precise Shot, Trigger Work, Triple Crit (Blaster Pistol), Trusty Sidearm (+1)</p>\n<p><strong>Special Actions:</strong> Delay Damage, Familiar Foe (+1), Knack</p>","derived":{},"npcProfile":{"kind":"heroic","mode":"play","sourceAuthority":"statblock","legalProfile":"heroic","legalState":"unchecked","importMode":"play","playReady":true,"statblockAuthority":true,"sourcePack":"heroic","normalizationVersion":1,"authority":{"hp":"statblock","defenses":"statblock","bab":"statblock","attacks":"statblock","skills":"statblock","damageThreshold":"statblock"}}},"items":[{"_id":"3d98a99220862c47","name":"Human","type":"species","img":"icons/svg/mystery-man.svg","system":{"size":"Medium","speed":6,"abilities":"None","skillBonuses":[],"special":["Bonus Feat: Humans gain one bonus feat at 1st level","Bonus Trained Skill: Humans gain one additional trained skill at 1st level"],"languages":["Basic"],"source":"Core","description":"","tags":[],"visionTraits":[],"naturalWeapons":[],"movementTraits":[],"environmentalTraits":[],"combatTraits":{"naturalArmor":0,"weaponProficiencies":[],"otherTraits":[]},"techTraits":[],"forceTraits":[],"socialTraits":[],"bonusFeats":1,"bonusTrainedSkills":1,"costNumeric":null},"effects":[],"folder":null,"sort":700,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.species.species-human"}}},{"_id":"7c1d7e85810a29ff","name":"Armor Proficiency (light)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with light armor and do not take armor check penalties on attack rolls.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":85,"tags":["armor","defender","non-force","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No penalty on attacks and no <a class=\"mw-redirect\" href=\"/wiki/Armor_Check_Penalty\" title=\"Armor Check Penalty\">Armor Check Penalty</a> while wearing <a href=\"/wiki/Light_Armor\" title=\"Light Armor\">Light Armor</a>."}},"effects":[{"_id":"9781a3c7-4e7e-4af0-9dcc-cdea0524b414","name":"Armor Proficiency (Light)","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.armorProficiency.light","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Armor Proficiency (Light)","effectType":"armor_proficiency"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.773ec00effc7e96f"}}},{"_id":"6405f6164709b98c","name":"Armor Proficiency (medium)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with medium armor and do not take armor check penalties on attack rolls.","prerequisite":"Armor Proficiency (Light)","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":85,"tags":["armor","defender","feat-chain","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No penalty on attacks and no <a class=\"mw-redirect\" href=\"/wiki/Armor_Check_Penalty\" title=\"Armor Check Penalty\">Armor Check Penalty</a> while wearing <a href=\"/wiki/Light_Armor\" title=\"Light Armor\">Light Armor</a> or <a href=\"/wiki/Medium_Armor\" title=\"Medium Armor\">Medium Armor</a>."}},"effects":[{"_id":"af0983df-e771-4593-8f88-f0aa43612597","name":"Armor Proficiency (Medium)","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.armorProficiency.medium","mode":5,"value":"true"}],"disabl