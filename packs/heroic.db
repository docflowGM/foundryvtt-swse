m.speed","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Full Throttle"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.full_throttle"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.34ff9dc64050028d"}}},{"_id":"29c143dde17111e5","name":"Keep it Together","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fringer","prerequisites":"Jury-Rigger","benefit":"When you jury-rig a vehicle, it moves -2 down the condition track at end (instead of -5).","description":"Once per encounter, your vehicle avoids moving down the condition track.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Fringer","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.jury_rigger"}],"_source":"canonical-csv"},"treeId":"7c47d36dc1f77d9c","tags":["condition-removal","controller","feat-chain","mobility","scout","talent-chain"]},"effects":[{"_id":"a0a072a8-d539-4e13-8542-20bca578650a","name":"Keep it Together","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.jury_rig.stability","mode":5,"value":"2_down"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Keep it Together"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.keep_it_together"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9211e3f6268b3413"}}},{"_id":"269ec013ff45af96","name":"Sneak Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["action-economy","battlefield-control","controller","defender","melee","mobility","positioning","precision","ranged","scaling","scoundrel","skills","social","striker"]},"effects":[{"_id":"3195415b-2276-403c-9fb1-5d323d38d31a","name":"Sneak Attack","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.flatfooted","mode":2,"value":"1d6"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Sneak Attack"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.sneak_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.1505abc8babeeb84"}}},{"_id":"bce7b9fb140df95c","name":"Spacehound","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Spacer","prerequisites":"","benefit":"You gain a +1 bonus on attack rolls made while aboard a Starship. This bonus applies to attacks made with Starship Weapons, as well as personal weapons used aboard a Starship. Prerequisite: Whenever you roll a Natural 20 on an attack roll made aboard a Starship, you gain one temporary Force Point. If the Force Point is not used before the end of the encounter, it is lost. This Talent works with both Weapon Systems and personal weapons used aboard a Starship. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Starship Raider When adjacent to an obstacle or barrier, you gain a +2 Cover bonus to your Reflex Defense. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Starship Raider Whether you are taking on military targets on behalf of a resistance movement or you are out for personal gain, you are experienced at raiding Starships and similar targets. You can use each if the following Actions once per encounter: Clear a Path: Your attack forces an enemy to alter course or move out of your way. You must be fighting aboard a Starship to use this Action. As a Standard Action, make a ranged attack. If the attack hits, on its next turn your target must move its Speed to a square that is not adjacent to you. If the target is an enemy Starfighter engaged in a Dogfight, the target instead must attempt to disengage from the Dogfight. Covering Fire: You squeeze off several shots as you escape pursuing enemies. As a Full-Round Action, if you are the Pilot of a Vehicle, you may move the Vehicle up to twice its Speed and make a single ranged attack with one of the Pilot-controlled Vehicle Weapons at any point during that movement. If you hit and deal damage to a Vehicle with this attack, the target Vehicle takes a -2 penalty to attack rolls against your Vehicle until the end of your turn. Disabling Fire: Make a ranged attack with your Vehicle Weapon. If you make this attack against a Vehicle and hit and deal damage, you can choose one of the following to take effect until the end of your next turn: One of the target's Vehicle Weapons ceases to function. The target's Shield Rating is reduced to 0. The target's Hyperdrive is disabled. The target's Speed is reduced to 2 squares (Character Scale). Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Stellar Warrior Once per encounter, while on or in a Vehicle, you can move up to one-half your speed, or move the Vehicle up to one-half its speed if you are the Pilot, as a Swift Action. This movement does not provoke Attacks of Opportunity.","description":"You gain a +1 bonus on attack rolls made while aboard a Starship. This bonus applies to attacks made with Starship Weapons, as well as personal weapons used aboard a Starship. Prerequisite: Whenever you roll a Natural 20 on an attack roll made aboard a Starship, you gain one temporary Force Point. If the Force Point is not used before the end of the encounter, it is lost. This Talent works with both Weapon Systems and personal weapons used aboard a Starship. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Starship Raider When adjacent to an obstacle or barrier, you gain a +2 Cover bonus to your Reflex Defense. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Starship Raider Whether you are taking on military targets on behalf of a resistance movement or you are out for personal gain, you are experienced at raiding Starships and similar targets. You can use each if the following Actions once per encounter: Clear a Path: Your attack forces an enemy to alter course or move out of your way. You must be fighting aboard a Starship to use this Action. As a Standard Action, make a ranged attack. If the attack hits, on its next turn your target must move its Speed to a square that is not adjacent to you. If the target is an enemy Starfighter engaged in a Dogfight, the target instead must attempt to disengage from the Dogfight. Covering Fire: You squeeze off several shots as you escape pursuing enemies. As a Full-Round Action, if you are the Pilot of a Vehicle, you may move the Vehicle up to twice its Speed and make a single ranged attack with one of the Pilot-controlled Vehicle Weapons at any point during that movement. If you hit and deal damage to a Vehicle with this attack, the target Vehicle takes a -2 penalty to attack rolls against your Vehicle until the end of your turn. Disabling Fire: Make a ranged attack with your Vehicle Weapon. If you make this attack against a Vehicle and hit and deal damage, you can choose one of the following to take effect until the end of your next turn: One of the target's Vehicle Weapons ceases to function. The target's Shield Rating is reduced to 0. The target's Hyperdrive is disabled. The target's Speed is reduced to 2 squares (Character Scale). Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Stellar Warrior Once per encounter, while on or in a Vehicle, you can move up to one-half your speed, or move the Vehicle up to one-half its speed if you are the Pilot, as a Swift Action. This movement does not provoke Attacks of Opportunity.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Spacer","treeId":"5ea8c79492d40713","tags":["action-economy","controller","damage-reduction","defender","force","force-control","force-defense","force-offense","mobility","positioning","ranged","scaling","scoundrel","shields","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.spacehound"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.fe0c3a64ca460542"}}},{"_id":"a9af1be4ac1edaa1","name":"Stellar Warrior","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Spacer","prerequisites":"Spacehound","benefit":"On a natural 20 attack roll, gain an extra Force Point for the encounter.","description":"When you roll a natural 20 on an attack, gain a temporary Force Point.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Spacer","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.spacehound"}],"_source":"canonical-csv"},"treeId":"5ea8c79492d40713","tags":["feat-chain","force","force-offense","scoundrel","talent-chain"]},"effects":[{"_id":"8655a9b1-41f3-4be7-a85c-98972f9c7cc8","name":"Stellar Warrior","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.forcePoints","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Stellar Warrior"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.stellar_warrior"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f92583cf04620d84"}}},{"_id":"65dc447c9e7ed512","name":"Trigger Work","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Gunslinger","prerequisites":null,"benefit":"No penalty to attack when using Rapid Shot.","description":"You take no attack penalty when using Rapid Shot.","class":"Gunslinger","costNumeric":null,"category":"Gunslinger","tree":"Gunslinger","treeId":"cb6f775cd227a3e3","tags":["ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.trigger_work"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.86c10d63bba2d9c8"}}},{"_id":"d0907337e8a6ce38","name":"Weapon Specialization","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Comba