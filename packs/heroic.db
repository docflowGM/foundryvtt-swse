th light melee weapons.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","melee","non-force","scoundrel","scout"],"bonus_feat_for":["Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Use <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> modifier instead of <a href=\"/wiki/Strength\" title=\"Strength\">Strength</a> modifier on attack rolls with Light Melee Weapons and <a href=\"/wiki/Lightsabers\" title=\"Lightsabers\">Lightsabers</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.252b67d6e31c377e"}}},{"_id":"945d8fb6247ed71f","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"6114e839c9dba2a5","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"7d40781d6ce840f6","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"0aca463de7b9f593","name":"Withdrawal Strike","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"","prerequisite":"","special":"","normalText":"","sourcebook":"Knights of the Old Republic Campaign Guide","page":30,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Adjacent opponents can not use the <a href=\"/wiki/Withdraw\" title=\"Withdraw\">Withdraw</a> Action."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":5}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.caad1a8c13bf01a1"}}},{"_id":"eaddcadc73cfd049","name":"Improved Force Slam","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"When you use the Force Slam Force Power, you can change the time it takes to activate to a Full-Round Action in order to target all targets within a 2-square radius originating in your square.","prerequisite":"Force Slam","special":"Additionally, you can spend a Force Point to increase the area to a 4-square radius Burst that originates from your square.","normalText":"","sourcebook":"Knights of the Old Republic Campaign Guide","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>When you use the Force Slam Force Power, you can change the time it takes to activate to a Full-Round Action in order to target all targets within a 2-square radius originating in your square.</p><p><strong>Special:</strong> Additionally, you can spend a Force Point to increase the area to a 4-square radius Burst that originates from your square.</p><p><strong>Related Power:</strong> Force Slam</p><p><strong>Prerequisites:</strong> Force Slam</p>","relatedPower":"Force Slam"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.1e72f9eadd438d77"}}},{"_id":"e5c3f7b382fcd871","name":"Improved Move Light Object","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may make a Use the Force check to Move Light Object as a Swift Action instead of a Move Action. Using the light object as a projectile weapon requires a Move Action (instead of a Standard Action).","prerequisite":"Move Light Object","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may make a Use the Force check to Move Light Object as a Swift Action instead of a Move Action. Using the light object as a projectile weapon requires a Move Action (instead of a Standard Action).</p><p><strong>Related Power:</strong> Move Light Object</p><p><strong>Prerequisites:</strong> Move Light Object</p>","relatedPower":"Move Light Object"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.c406600924a7780e"}}},{"_id":"a86fc6a62580a891","name":"Improved Sense Force","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may use the Sense Force ability of the Use the Force Skill as a Move Action rather than a Full-Round Action.","prerequisite":"Sense Force","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may use the Sense Force ability of the Use the Force Skill as a Move Action rather than a Full-Round Action.</p><p><strong>Related Power:</strong> Sense Force</p><p><strong>Prerequisites:</strong> Sense Force</p>","relatedPower":"Sense Force"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.ad67b8f3959860f2"}}},{"_id":"42e7efba400d618a","name":"Block","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith Alchemy","prerequisites":"","benefit":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","description":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Sith Alchemy","treeId":"a67faf2ae089ab5d","tags":["action-economy","armor","dark-side","defender","force","force-offense","jedi","lightsaber","melee","mobility","ranged","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.block"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9379daa94a228c04"}}},{"_id":"29132cd5f160fdaf","name":"Battle Meditation","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sense","prerequisites":"","benefit":"Link Using a meditative battle trance, Force-users are able to join their minds together, collectively becoming stronger. However, a masterful degree of will is required to prevent the participants from sharing their weaknesses as well as their strengths. As a Full-Round Action, you can designate a number of willing allies equal to your Charisma modifier within 12 squares of you. These allies must be Trained in the Use the Force skill. As long as you remain within 12 squares of each other, you can Aid Another on attack rolls and Skill Checks as a Reaction.","description":"Link Using a meditative battle trance, Force-users are able to join their minds together, collectively becoming stronger. However, a masterful degree of will is required to prevent the participants from sharing their weaknesses as well as their strengths. As a Full-Round Action, you can designate a number of willing allies equal to your Charisma modifier within 12 squares of you. These allies must be Trained in the Use the Force skill. As long as you remain within 12 squares of each other, you can Aid Another on attack rolls and Skill Checks as a Reaction.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Sense","treeId":"d6b4331c0e31f7e3","tags":["action-economy","force","force-offense","jedi","positioning","striker","sustained-damage"]},"effects":[{"_id":"0cdcb68b-7eeb-45d0-ae5c-575d13648a00","name":"Battle Meditation","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks.allies","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Battle Meditation"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.battle_meditation"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9461c7aa79dd07c6"}}},{"_id":"ab8d5e7fe4f0e65e","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"49b97bd173581088","name":"Improved Battle Meditation","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Guardian","prerequisites":"Battle Meditation","benefit":"Activate Battle Meditation as a swift action; range increases to 12 squares; enemies in the radius take -1 attack.","description":"Battle Meditation can be activated as a swift action; enemies within the area take -1 attack.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Guardian","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.battle_meditation"}],"_source":"canonical-csv"},"treeId":"10c843cef8ce2798","tags":["action-economy","feat-chain","force","force-offense","jedi","light-side","mobility","positioning","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_battle_meditation"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d6a04668587e2c03"}}},{"_id":"e392b349849b6b04","name":"Jedi Battle Commander","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Battlemaster","prerequisites":"KotOR 39","benefit":"Your Battle Meditation grants +2 to attack instead of +1.","description":"Your Battle Meditation grants +2 attack instead of +1.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Jedi Battlemaster","treeId":"dfc4142435b4356d","tags":["feat-chain","force","force-offense","jedi","leader","light-side","striker","talent-chain"]},"effects":[{"_id":"76fbe4cd-48fd-47da-9c14-140781c9cc53","name":"Jedi Battle Commander","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Jedi Battle Commander"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.jedi_battle_commander"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.57823500e878124a"}}},{"_id":"eb457e9a89b6c4e4","name":"Lightsaber Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Niman When you use the Talent, you gain twice the normal deflection bonus to your Reflex Defense when you are wielding two Lightsabers. Prerequisite: When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Talent increases by 2 (to a maximum of +5). When wielding a Lightsaber, you gain a +1 bonus to your Reflex Defense and Will Defense.","description":"Niman When you use the Talent, you gain twice the normal deflection bonus to your Reflex Defense when you are wielding two Lightsabers. Prerequisite: When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Talent increases by 2 (to a maximum of +5). When wielding a Lightsaber, you gain a +1 bonus to your Reflex Defense and Will Defense.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["defender","jedi","lightsaber","melee","striker"]},"effects":[{"_id":"fcdbf882-923a-4095-b0df-a1079c214099","name":"Lightsaber Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Lightsaber Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.lightsaber_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e8bf1222fd6289e4"}}},{"_id":"1dbb72d3de201b6d","name":"Multiattack Proficiency (lightsabers)","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Battlemaster","prerequisites":"","benefit":"Dual Weapon Mastery I, Weapon Focus (Lightsabers) Immediately after making a Full Attack where you attacked with two Lightsabers (or both ends of a Double-Bladed Lightsaber), you may Move up to your Speed as a Free Action.","description":"Dual Weapon Mastery I, Weapon Focus (Lightsabers) Immediately after making a Full Attack where you attacked with two Lightsabers (or both ends of a Double-Bladed Lightsaber), you may Move up to your Speed as a Free Action.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Jedi Battlemaster","treeId":"dfc4142435b4356d","tags":["action-economy","controller","dual-wield","force","force-control","force-offense","jedi","light-side","lightsaber","melee","mobility"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.multiattack_proficiency_lightsabers"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.317400e9ea2b66c7"}}},{"_id":"4b452a5af6d6c18b","name":"Riposte","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Duelist","prerequisites":"","benefit":"When you successfully make a attack using the Talent, you do not count the Block Talent use that triggered the (thus, you take no cumulative penalty to Use the Force checks from that Block attempt).","description":"When you successfully make a attack using the Talent, you do not count the Block Talent use that triggered the (thus, you take no cumulative penalty to Use the Force checks from that Block attempt).","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Duelist","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.block"},{"type":"bab","min":5}],"_source":"canonical-csv"},"treeId":"b3c5d90b5036f39b","tags":["force","force-offense","jedi"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.riposte"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.b788095a71a47be7"}}},{"_id":"bc7cca5e464c1ccc","name":"Telepathic Link","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Alter","prerequisites":"","benefit":"You naturally and unconsciously influence those who are regularly around you. Whenever you roll a natural 20 on an attack roll or Use the Force check, instead of regaining all your spent Force Powers, you may instead choose to grant one ally within 12 squares of you a temporary Force Point. If your ally does not use this temporary Force Point before the end of the encounter, it is lost. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide You form an enhanced with a willing ally, that possesses the Force Sensitivity feat, as a Swift Action. The is maintained until you choose to remove it (no Action required). As long as you remain within one kilometer of your target, you and the target can communicate telepathically as though you were speaking. Once per encounter, you may use a Force Power from your target's Force Power Suite (if the target consents), or you may allow the target to use one of your Force Powers. You may only have one active at a time. Force Bond Talent created by TheSagaContinues user fairytalejedi. Prerequisite: A becomes permanent between yourself and another possessing the Force Sensitivity Feat. While out of combat, you and the bonded individual can freely speak as if in the same location. By spending a Force Point to make a DC 25 Use the Force check, you may give or take a single item of Diminutive size or smaller.","description":"You naturally and unconsciously influence those who are regularly around you. Whenever you roll a natural 20 on an attack roll or Use the Force check, instead of regaining all your spent Force Powers, you may instead choose to grant one ally within 12 squares of you a temporary Force Point. If your ally does not use this temporary Force Point before the end of the encounter, it is lost. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide You form an enhanced with a willing ally, that possesses the Force Sensitivity feat, as a Swift Action. The is maintained until you choose to remove it (no Action required). As long as you remain within one kilometer of your target, you and the target can communicate telepathically as though you were speaking. Once per encounter, you may use a Force Power from your target's Force Power Suite (if the target consents), or you may allow the target to use one of your Force Powers. You may only have one active at a time. Force Bond Talent created by TheSagaContinues user fairytalejedi. Prerequisite: A becomes permanent between yourself and another possessing the Force Sensitivity Feat. While out of combat, you and the bonded individual can freely speak as if in the same location. By spending a Force Point to make a DC 25 Use the Force check, you may give or take a single item of Diminutive size or smaller.","costNumeric":null,"tree":"Alter","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"usetheforce"}],"_source":"fix5F-canonical"},"treeId":"6ac3416fb6aada56","tags":["action-economy","controller","dual-wield","force","force-control","force-offense","leader","light-side","mobility","positioning","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.telepathic_link"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.25dd9d9b3b66c048"}}},{"_id":"8e07065d59cb9ad9","name":"Battle Strike","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You channel the Force to enhance your next melee attack. Your next melee attack this round gains a +1d6 bonus to damage.</p>","special":"<p>This bonus damage is Force damage and bypasses Damage Reduction.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["enhancement","damage","melee"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f177dc6d65f76de9"}}},{"_id":"5247d580bd5c42fd","name":"Force Grip","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":3,"discipline":"dark-side","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Concentration","effect":"<p>You use the Force to telekinetically choke or crush your target. The target takes damage each round based on your Use the Force check result.</p>","special":"<p>This is a Dark Side power. The target is immobilized while gripped.</p>","descriptor":["Dark Side","Telekinetic"],"dcChart":[{"dc":15,"effect":"2d6 damage/round","description":"Target takes 2d6 damage per round and is immobilized"},{"dc":20,"effect":"4d6 damage/round","description":"Target takes 4d6 damage per round and is immobilized"},{"dc":25,"effect":"6d6 damage/round + lift","description":"Target takes 6d6 damage per round, is immobilized, and lifted off ground"},{"dc":30,"effect":"8d6 damage/round + crush","description":"Target takes 8d6 damage per round and is being crushed (fort save or die)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["attack","damage","dark-side","telekinetic","immobilize"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f41a957f71e98a6a"}}},{"_id":"73d4592e2f64f587","name":"Force Slam","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One creature or object","duration":"Instantaneous","effect":"<p>You use telekinetic force to violently slam your target against a surface. The target takes 4d6 damage and is knocked prone.</p>","special":"<p>The target must be within 6 squares of a solid surface (wall, floor, ceiling).</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":97,"tags":["attack","damage","telekinetic","prone"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.462a6c23e00c4dfc"}}},{"_id":"6a8c1e44ce666166","name":"Force Whirlwind","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Force Whirlwind"}}},{"_id":"ebf51b48fe5ebe92","name":"Mind Trick","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telepathic","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 minute or until completed","effect":"<p>You influence a weak mind to believe what you tell them or follow a simple suggestion. The target must make a Will save (DC = your UTF check) or be affected.</p>","special":"<p>The suggestion must be reasonable and the target must be able to understand you.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["mind-control","suggestion","social"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.e6649f366d6c5737"}}},{"_id":"3fe81c2b3900bee8","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}},{"_id":"278e7da22396fa91","name":"Slow","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Slow"}}},{"_id":"72246f918a98320d","name":"Surge","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"vital","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You use the Force to push your body beyond normal limits. You gain an additional move action this turn.</p>","special":"<p>This extra move action can be used to move or perform other move-action tasks.</p>","descriptor":["Vital"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["enhancement","action-economy","movement"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.1ac1084ca8f07114"}}},{"_id":"d6ff726e4f0aab7d","name":"Vital Transfer","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":3,"discipline":"vital","useTheForce":15,"time":"Standard Action","range":"Touch","target":"One living creature","duration":"Instantaneous","effect":"<p>You channel the Force to heal injuries and restore vitality. The target recovers hit points based on your Use the Force check result.</p>","special":"<p>You cannot heal yourself with this power.</p>","descriptor":["Vital","Healing"],"dcChart":[{"dc":15,"effect":"2d6 healing","description":"Target heals 2d6 hit points"},{"dc":20,"effect":"4d6 healing","description":"Target heals 4d6 hit points"},{"dc":25,"effect":"6d6 healing + condition","description":"Target heals 6d6 hit points and removes one ongoing condition"},{"dc":30,"effect":"8d6 healing + all conditions","description":"Target heals 8d6 hit points and removes all ongoing conditions"}],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["healing","vital","support"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null}