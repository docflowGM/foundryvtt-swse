,"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"c1bc2534c7d4f573","name":"Weapon Proficiency (Heavy Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with heavy weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["heavy-weapons","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"5f95d267-fdb7-43aa-998c-918188f277fe","name":"Weapon Proficiency (Heavy Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Heavy Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Heavy Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.8329a353aa3899be"}}},{"_id":"1c5f8e7415dabcbc","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"4a81ed358e56b8e0","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"eb972a6a059cf18b","name":"Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"384725ba084ac0ad","name":"Battle Analysis","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":"Trained in Initiative","benefit":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus. When you use the Mechanics skill to Handle Explosives, the explosion deals +2 dice of damage. You may take this Talent multiple times; its effects stack. You can distract opponents and convince them that you are the most tempting (or most dangerous) target in the area. As a Swift Action, make a Persuasion check and compare the result to the Will Defense of all opponents within line of sight. If the check result exceeds an opponent's Will Defense, that opponent cannot attack any character within 6 squares of you until the start of your next turn as long as you do not have Cover against that opponent. (The affected opponent may still attack you, however.) If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per round, you may spend a Swift Action to shield a single adjacent ally from attacks, taking the damage and suffering the ill effects in your ally's stead. Until the start of your next turn, any attack made against the protected ally targets you instead. You may elect not to shield your protected ally against a given attack, provided the decision is made before the attack roll is made. If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per day as a Swift Action, you can move +5 steps on the Condition Track. This does not remove any Persistent Conditions that may be affecting you. This Talent does not affect the Condition Track of a Vehicle. You can select this talent multiple times. Each time you select this Talent, you can use it one additional time per day. You can catch a Second Wind one extra time per day. If you have this Talent and the Extra Second Wind feat, you can catch your Second Wind a total of three times per day. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisite: Whenever you have the benefit of Cover, you can spend two Swift Actions to treat it as Improved Cover until the start of your next turn. Reference Book: Star Wars Saga Edition Threats of the Galaxy Prerequisite: When one or more allies uses the Aid Another Action to give you a bonus to your attack roll, you gain a circumstance bonus equal to the total bonus provided to your damage roll. Homebrew Reference Book: Legacy of the Force Sourcebook You add an additional die of damage when attacking with any weapon that has a Burst radius.","description":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus. When you use the Mechanics skill to Handle Explosives, the explosion deals +2 dice of damage. You may take this Talent multiple times; its effects stack. You can distract opponents and convince them that you are the most tempting (or most dangerous) target in the area. As a Swift Action, make a Persuasion check and compare the result to the Will Defense of all opponents within line of sight. If the check result exceeds an opponent's Will Defense, that opponent cannot attack any character within 6 squares of you until the start of your next turn as long as you do not have Cover against that opponent. (The affected opponent may still attack you, however.) If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per round, you may spend a Swift Action to shield a single adjacent ally from attacks, taking the damage and suffering the ill effects in your ally's stead. Until the start of your next turn, any attack made against the protected ally targets you instead. You may elect not to shield your protected ally against a given attack, provided the decision is made before the attack roll is made. If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per day as a Swift Action, you can move +5 steps on the Condition Track. This does not remove any Persistent Conditions that may be affecting you. This Talent does not affect the Condition Track of a Vehicle. You can select this talent multiple times. Each time you select this Talent, you can use it one additional time per day. You can catch a Second Wind one extra time per day. If you have this Talent and the Extra Second Wind feat, you can catch your Second Wind a total of three times per day. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisite: Whenever you have the benefit of Cover, you can spend two Swift Actions to treat it as Improved Cover until the start of your next turn. Reference Book: Star Wars Saga Edition Threats of the Galaxy Prerequisite: When one or more allies uses the Aid Another Action to give you a bonus to your attack roll, you gain a circumstance bonus equal to the total bonus provided to your damage roll. Homebrew Reference Book: Legacy of the Force Sourcebook You add an additional die of damage when attacking with any weapon that has a Burst radius.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Commando","treeId":"798ed0945cbdac1c","tags":["action-economy","battlefield-control","burst-damage","condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","mechanics","mobility","piloting","positioning","ranged","scaling","shields","skills","social","soldier","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.battle_analysis"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7df2e8e4f18dc909"}}},{"_id":"f6618abdce12bc9b","name":"Born Leader","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Naval Officer","prerequisites":"","benefit":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","description":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","class":"Noble","costNumeric":null,"category":"Noble","tree":"Naval Officer","treeId":"057a978a7dc1d5a7","tags":["armor","defender","noble","striker","support","sustained-damage"]},"effects":[{"_id":"f9275c38-3cb5-4ab3-aaa5-25e5722dcdd3","name":"Born Leader","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.will","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Born Leader"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.born_leader"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.6a66ba6e0834dd6f"}}},{"_id":"64c117a3288b825f","name":"Combined Fire","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Naval Officer","prerequisites":"Charisma 13","benefit":"As a Swift Action, you may designate a single creature, Vehicle or object within your line of sight as the target of . Any Weapon Batteries attacking the target deal an extra die of damage for every 2 points by which their attack roll exceeds the target's Reflex Defense (instead of every 3 points). In addition, when using the Tactical Fire option for a Capital Ship, you may designated a weapon or Weapon Battery to make a single attack. As a Full-Round Action, you can designate a number of Vehicles equal to your Officer Class Level and within your line of sight. Those Vehicles may immediately move a number of squares equal to their speed.","description":"As a Swift Action, you may designate a single creature, Vehicle or object within your line of sight as the target of . Any Weapon Batteries attacking the target deal an extra die of damage for every 2 points by which their attack roll exceeds the target's Reflex Defense (instead of every 3 points). In addition, when using the Tactical Fire option for a Capital Ship, you may designated a weapon or Weapon Battery to make a single attack. As a Full-Round Action, you can designate a number of Vehicles equal to your Officer Class Level and within your line of sight. Those Vehicles may immediately move a number of squares equal to their speed.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Naval Officer","treeId":"057a978a7dc1d5a7","tags":["action-economy","controller","defender","feat-chain","mobility","positioning","soldier","striker","sustained-damage","talent-chain"]},"effects":[{"_id":"6f88b513-9d62-4971-a686-72668a6da31d","name":"Combined Fire","icon":"icons/svg/gun.svg","changes":[{"key":"system.damage","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Combined Fire"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.combined_fire"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.17518b7669101122"}}},{"_id":"79f49a7bd97082d4","name":"Coordinate","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Leadership","prerequisites":null,"benefit":"All allies in line of sight gain +1 when using aid another (maximum +5).","description":"All allies gain +1 when using Aid Another, up to +5.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Leadership","canonicalName":"Coordinate","canonicalTree":"Bab +12","treeId":"5964237d22681dc0","tags":["noble","striker"]},"effects":[{"_id":"25b28077-6a3c-43d8-97ba-a128e768f614","name":"Coordinate","icon":"icons/svg/handshake.svg","changes":[{"key":"system.actions.aidAnother","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Coordinate"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.coordinate"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a52044feeab3fe05"}}},{"_id":"cc4be04e15e6f494","name":"Deployment Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Military Tactics","prerequisites":"","benefit":"You know how to use existing terrain to your best advantage. By using a Move Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, you and all allies within 10 squares of you can use whatever Cover is available to gain a +10 Cover bonus to Reflex Defense (instead of the normal +5 Cover bonus). Allies must be able to hear and understand you to gain this benefit, and the bonus lasts until the start of your next turn. This Talent provides no benefit to anyone who doesn't have Cover. This is a Mind-Affecting effect. Prerequisite: As a Reaction, you can choose to take one-half or all of the damage dealt to an adjacent ally by a single attack. Similarly, as a Reaction, an adjacent ally can choose to take one-half or all of the damage dealt to you by a single attack (even if they don't have this Talent). Prerequisites: , Field Tactics An Officer learns to counter the tactics of their enemies. As a Standard Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, opponents in your line of sight lose all competence, insight, and morale bonuses on attack rolls, as well as any dodge bonuses to Reflex Defense, until the start of your next turn. If one or more enemy Officers are within your line of sight, the highest level Officer among them can attempt to Oppose your Knowledge (Tactics) check as a Reaction. If their Skill Check result is higher than yours, your attempt to Outmaneuver your opponents fails. As a Swift Action, you can take a -2 penalty to one Defense (Reflex, Fortitude, or Will) to gain a +1 competence bonus to another Defense until the start of your next turn.","description":"You know how to use existing terrain to your best advantage. By using a Move Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, you and all allies within 10 squares of you can use whatever Cover is available to gain a +10 Cover bonus to Reflex Defense (instead of the normal +5 Cover bonus). Allies must be able to hear and understand you to gain this benefit, and the bonus lasts until the start of your next turn. This Talent provides no benefit to anyone who doesn't have Cover. This is a Mind-Affecting effect. Prerequisite: As a Reaction, you can choose to take one-half or all of the damage dealt to an adjacent ally by a single attack. Similarly, as a Reaction, an adjacent ally can choose to take one-half or all of the damage dealt to you by a single attack (even if they don't have this Talent). Prerequisites: , Field Tactics An Officer learns to counter the tactics of their enemies. As a Standard Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, opponents in your line of sight lose all competence, insight, and morale bonuses on attack rolls, as well as any dodge bonuses to Reflex Defense, until the start of your next turn. If one or more enemy Officers are within your line of sight, the highest level Officer among them can attempt to Oppose your Knowledge (Tactics) check as a Reaction. If their Skill Check result is higher than yours, your attempt to Outmaneuver your opponents fails. As a Swift Action, you can take a -2 penalty to one Defense (Reflex, Fortitude, or Will) to gain a +1 competence bonus to another Defense until the start of your next turn.","class":"Officer","costNumeric":null,"category":"Officer","tree":"Military Tactics","treeId":"9253ace716c3e966","tags":["action-economy","controller","defender","evasion","leader","mobility","positioning","scout","skills","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"defau