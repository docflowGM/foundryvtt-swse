tNumeric":null,"treeId":"67b59e020c1660eb","tags":["condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","lightsaber","melee","mobility","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9e4345faaaa94dd8"}}},{"_id":"1a7dbde2d91135e6","name":"Fool's Luck","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fortune","prerequisites":"","benefit":"Once per encounter, you can turn a Critical Hit against you into a normal hit. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Once per encounter, as a Reaction, you gain a +5 luck bonus to any one Defense until the start of your next turn. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"Once per encounter, you can turn a Critical Hit against you into a normal hit. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Once per encounter, as a Reaction, you gain a +5 luck bonus to any one Defense until the start of your next turn. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Fortune","treeId":"cee9b9398682b7d0","tags":["action-economy","defender","precision","scoundrel","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.fools_luck"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5319a796f2c4ff64"}}},{"_id":"c6f6eadf4d3815d0","name":"Fortune's Favor","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fortune","prerequisites":null,"benefit":"When you score a critical hit, gain a free standard action; must be used before your next turn or it is lost.","description":"When you score a critical hit, gain a free standard action before your next turn.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Fortu