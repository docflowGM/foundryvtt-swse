nership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"db3e7cfa89eead39","name":"Weapon Proficiency (Heavy Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with heavy weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["heavy-weapons","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"5f95d267-fdb7-43aa-998c-918188f277fe","name":"Weapon Proficiency (Heavy Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Heavy Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Heavy Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.8329a353aa3899be"}}},{"_id":"da6a490e2e7edddd","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"3902086e885e58df","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"7b77e581e890bacc","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"a8d614a8e712e3e3","name":"Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"cf9398c1a13d9583","name":"Battle Analysis","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":"Trained in Initiative","benefit":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus. When you use the Mechanics skill to Handle Explosives, the explosion deals +2 dice of damage. You may take this Talent multiple times; its effects stack. You can distract opponents and convince them that you are the most tempting (or most dangerous) target in the area. As a Swift Action, make a Persuasion check and compare the result to the Will Defense of all opponents within line of sight. If the check result exceeds an opponent's Will Defense, that opponent cannot attack any character within 6 squares of you until the start of your next turn as long as you do not have Cover against that opponent. (The affected opponent may still attack you, however.) If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per round, you may spend a Swift Action to shield a single adjacent ally from attacks, taking the damage and suffering the ill effects in your ally's stead. Until the start of your next turn, any attack made against the protected ally targets you instead. You may elect not to shield your protected ally against a given attack, provided the decision is made before the attack roll is made. If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per day as a Swift Action, you can move +5 steps on the Condition Track. This does not remove any Persistent Conditions that may be affecting you. This Talent does not affect the Condition Track of a Vehicle. You can select this talent multiple times. Each time you select this Talent, you can use it one additional time per day. You can catch a Second Wind one extra time per day. If you have this Talent and the Extra Second Wind feat, you can catch your Second Wind a total of three times per day. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisite: Whenever you have the benefit of Cover, you can spend two Swift Actions to treat it as Improved Cover until the start of your next turn. Reference Book: Star Wars Saga Edition Threats of the Galaxy Prerequisite: When one or more allies uses the Aid Another Action to give you a bonus to your attack roll, you gain a circumstance bonus equal to the total bonus provided to your damage roll. Homebrew Reference Book: Legacy of the Force Sourcebook You add an additional die of damage when attacking with any weapon that has a Burst radius.","description":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus. When you use the Mechanics skill to Handle Explosives, the explosion deals +2 dice of damage. You may take this Talent multiple times; its effects stack. You can distract opponents and convince them that you are the most tempting (or most dangerous) target in the area. As a Swift Action, make a Persuasion check and compare the result to the Will Defense of all opponents within line of sight. If the check result exceeds an opponent's Will Defense, that opponent cannot attack any character within 6 squares of you until the start of your next turn as long as you do not have Cover against that opponent. (The affected opponent may still attack you, however.) If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per round, you may spend a Swift Action to shield a single adjacent ally from attacks, taking the damage and suffering the ill effects in your ally's stead. Until the start of your next turn, any attack made against the protected ally targets you instead. You may elect not to shield your protected ally against a given attack, provided the decision is made before the attack roll is made. If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per day as a Swift Action, you can move +5 steps on the Condition Track. This does not remove any Persistent Conditions that may be affecting you. This Talent does not affect the Condition Track of a Vehicle. You can select this talent multiple times. Each time you select this Talent, you can use it one additional time per day. You can catch a Second Wind one extra time per day. If you have this Talent and the Extra Second Wind feat, you can catch your Second Wind a total of three times per day. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisite: Whenever you have the benefit of Cover, you can spend two Swift Actions to treat it as Improved Cover until the start of your next turn. Reference Book: Star Wars Saga Edition Threats of the Galaxy Prerequisite: When one or more allies uses the Aid Another Action to give you a bonus to your attack roll, you gain a circumstance bonus equal to the total bonus provided to your damage roll. Homebrew Reference Book: Legacy of the Force Sourcebook You add an additional die of damage when attacking with any weapon that has a Burst radius.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Commando","treeId":"798ed0945cbdac1c","tags":["action-economy","battlefield-control","burst-damage","condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","mechanics","mobility","piloting","positioning","ranged","scaling","shields","skills","social","soldier","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.battle_analysis"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7df2e8e4f18dc909"}}},{"_id":"c1f8125f81411f35","name":"Controlled Burst","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"Weapon Focus (Simple Weapons)","benefit":"Base Attack Bonus +12 Once per encounter, when making an Autofire attack, you can treat the attack as a 6-Square Cone. Making this attack consumes 20 shots from the weapon's Power Pack. Reference Book: Star Wars Saga Edition Unknown Regions Whenever you make multiple attacks with any type of Simple Weapon as a Full-Round Action (see Full Attack), you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. Reference Book: Star Wars Saga Edition Unknown Regions As a Standard Action, you can throw two weapons simultaneously. Both weapons target the same enemy or target square and are thrown with one hand. Make separate attack rolls for each weapon, each at a -10 penalty. The weapons must be similar, such as two Grenades or two Knives, and they must be no larger than one size category smaller than you. The attack cannot exceed Short Range (typically 8 squares). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Weapon Proficiency (Heavy Weapons), Strength 15 When attacking with an Autofire-capable weapon, you may deal +1 die of damage. This increased damage die stacks with the increased damage from the Burst Fire and Rapid Shot Feats. Homebrew Reference Book: Legacy of the Force Sourcebook Choose one Exotic Weapon or one of the following weapon groups: Advanced Melee Weapons, Lightsabers, or Simple Weapons. You take no penalty on your attack roll when using the Rapid Strike feat with such weapons. You may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group.","description":"Base Attack Bonus +12 Once per encounter, when making an Autofire attack, you can treat the attack as a 6-Square Cone. Making this attack consumes 20 shots from the weapon's Power Pack. Reference Book: Star Wars Saga Edition Unknown Regions Whenever you make multiple attacks with any type of Simple Weapon as a Full-Round Action (see Full Attack), you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. Reference Book: Star Wars Saga Edition Unknown Regions As a Standard Action, you can throw two weapons simultaneously. Both weapons target the same enemy or target square and are thrown with one hand. Make separate attack rolls for each weapon, each at a -10 penalty. The weapons must be similar, such as two Grenades or two Knives, and they must be no larger than one size category smaller than you. The attack cannot exceed Short Range (typically 8 squares). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Weapon Proficiency (Heavy Weapons), Strength 15 When attacking with an Autofire-capable weapon, you may deal +1 die of damage. This increased damage die stacks with the increased damage from the Burst Fire and Rapid Shot Feats. Homebrew Reference Book: Legacy of the Force Sourcebook Choose one Exotic Weapon or one of the following weapon groups: Advanced Melee Weapons, Lightsabers, or Simple Weapons. You take no penalty on your attack roll when using the Rapid Strike feat with such weapons. You may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group.","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["action-economy","burst-damage","damage-reduction","dual-wield","feat-chain","force","force-offense","heavy-weapons","lightsaber","melee","positioning","ranged","scaling","soldier","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.controlled_burst"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.3e35df4fce7082a3"}}},{"_id":"7b2f78b78a0fecc9","name":"Tough as Nails","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":"","benefit":"You can Catch a Second Wind as a Reaction, instead of as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide When you use the Aid Another Action to Suppress an Enemy, that enemy takes a -5 penalty on its next attack instead of the normal -2 penalty. Only 1 character may gain the benefits of this Talent against a given target at a time. Reference Book: Star Wars Saga Edition Unknown Regions","description":"You can Catch a Second Wind as a Reaction, instead of as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide When you use the Aid Another Action to Suppress an Enemy, that enemy takes a -5 penalty on its next attack instead of the normal -2 penalty. Only 1 character may gain the benefits of this Talent against a given target at a time. Reference Book: Star Wars Saga Edition Unknown Regions","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Commando","treeId":"798ed0945cbdac1c","tags":["action-economy","mobility","soldier"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.tough_as_nails"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.916b0a6197bf85a6"}}},{"_id":"e52843a02b902f6f","name":"Weapon Specialization","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Combat","prerequisites":"Weapon Focus","benefit":"+2 melee damage.","description":"Gain +2 damage with a chosen weapon.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Combat","treeId":"2359c05ff13f3feb","tags":["feat-chain","jedi","lightsaber","melee","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.weapon_specialization"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.41426ecd7fade0b0"}}},{"_id":"fb4dcbba0728bb7e","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+7","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":12,"flatDamageFormula":"1d4+7","useFlat":true}}}},{"_id":"f813e1e26ffa057b","name":"Heavy Blaster Rifle","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d10+6","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":6,"cost":1500,"equipped":true,"description":"<p>A powerful rifle that sacrifices range for increased damage output. Heavy but devastating.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"rifles","subcategory":"rifle","costNumeric":1500,"category":"rifle"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-heavy-blaster-rifle"},"swse":{"npc":{"flatAttackBonus":12,"flatDamageFormula":"3d10+6","useFlat":true}}}},{"_id":"6e2acfd08b587d2f","name":"Heavy Blaster Rifle (with Controlled Burst)","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d10+6,2-SquareAutofire","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":6,"cost":1500,"equipped":true,"description":"<p>A powerful rifle that sacrifices range for increased damage output. Heavy but devastating.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"rifles","subcategory":"rifle","costNumeric":1500,"category":"rifle"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-heavy-blaster-rifle"},"swse":{"npc":{"flatAttackBonus":10,"flatDamageFormula":"3d10+6,2-SquareAutofire","useFlat":true}}}},{"_id":"35045742b2f896b1","name":"Flamethrower","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d6+4(Fire),6-SquareCone","damageType":"fire","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":6,"cost":1500,"equipped":true,"description":"<p>A weapon that projects a cone of flame. Area effect weapon that sets targets on fire.</p>\n      <p><strong>Special:</strong> Cone template (6 squares). Reflex save DC 15 for half damage. May catch targets on fire (1d6 ongoing fire damage).</p>","properties":["Exotic","Area Effect","Fire","Cone"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"exotic","subcategory":"exotic","costNumeric":1500,"category":"exotic"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-flamethrower"},"swse":{"npc":{"flatAttackBonus":11,"flatDamageFormula":"3d6+4(Fire),6-SquareCone","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"4th-Degree","Nonheroic Level":0,"Class Levels":{"Medium":4,"Trooper":2},"Destiny Points":1,"Force Points":5,"Dark Side Points":11,"Initiative":11,"Senses":"Darkvision , Perception +12","Languages":["Basic","Binary","Tusken; Translator Unit (DC 5)"],"Unassigned Languages":0,"Reflex Defense":23,"Flat-Footed Defense":21,"Fortitude Defense":26,"Will Defense":20,"Immune":"Droid Traits","Hit Points":76,"Damage Threshold":26,"Speed":"6 Squares ( Walking )","Melee Weapons":"Unarmed +12 (1d4+7)","Ranged Weapons":"Heavy Blaster Rifle +12 (3d10+6), Heavy Blaster Rifle +10 (3d10+6, 2-Square Autofire ) with Controlled Burst, Flamethrower +11 (3d6+4 ( Fire ), 6-Square Cone )","Base Attack Bonus":9,"Grapple":12,"Attack Options":["Autofire ( Heavy Blaster Rifle )","Controlled Burst","Point-Blank Shot","Precise Shot"],"Special Actions":["Battle Analysis","Delay Damage"],"Force Powers":[],"Force Secrets":[],"Force Techniques":[],"Strength":16,"Dexterity":14,"Constitution":"","Intelligence":14,"Wisdom":12,"Charisma":10,"Talents":["Talents : Armored Defense","Battle Analysis","Controlled Burst","Tough as Nails","Weapon Specialization (Rifles)"],"Feats":["Feats : Armor Proficiency (Light)","Armor Proficiency (Medium)","Exotic Weapon Proficiency (Flamethrower)","Martial Arts I","Point-Blank Shot","Precise Shot","Weapon Focus (Rifles)","Weapon Proficiency (Advanced Melee Weapons)","Weapon Proficiency (Heavy Weapons)","Weapon Proficiency (Pistols)","Weapon Proficiency (Rifles)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Initiative","Knowledge (Tactics)","Mechanics","Perception","Use Computer"],"Trained Skills":["Skills : Initiative","Knowledge (Tactics)","Mechanics","Perception","Use Computer"],"Species Traits":[],"Gear":"Flamethrower , Heavy Blaster Rifle , Durasteel Battle Armor ( Droid Armor ; +8 Reflex )"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
