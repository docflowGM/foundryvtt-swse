ce":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"d133f451c21a9161","name":"Force Power Mastery","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"Choose a single Force Power. You may Take 10 on Use the Force checks to activate this Force Power even when distracted or threatened.","prerequisite":"","special":"You may select this Force Technique multiple times; each time you select this Force Technique, it applies to a different Force Power.","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>Choose a single Force Power. You may Take 10 on Use the Force checks to activate this Force Power even when distracted or threatened.</p><p><strong>Special:</strong> You may select this Force Technique multiple times; each time you select this Force Technique, it applies to a different Force Power.</p>","relatedPower":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.07cea7e3e8b21d69"}}},{"_id":"696ed685a3ab9f51","name":"Improved Sense Surroundings","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may use the Sense Surroundings application of the Use the Force Skill as a Free Action rather than a Swift Action.","prerequisite":"Sense Surroundings","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may use the Sense Surroundings application of the Use the Force Skill as a Free Action rather than a Swift Action.</p><p><strong>Related Power:</strong> Sense Surroundings</p><p><strong>Prerequisites:</strong> Sense Surroundings</p>","relatedPower":"Sense Surroundings"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.4955b5076ca5da89"}}},{"_id":"e4b16b3975255270","name":"Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"bbc93a46af5a3dfa","name":"Assault Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Military Tactics","prerequisites":"Trained in Initiative","benefit":"You can use the , Deployment Tactics, or Field Tactics Talent as a Swift Action, instead of a Move Action (provided you have the Talent in question). Reference Book: Star Wars Saga Edition Unknown Regions During the first round of combat in an encounter (after the Surprise Round, if any), you can take your turn before any of your allies, but you must use either the Share Talent Prestige Class ability or a Talent from one of the following Talent Trees as part of your turn: Commando Talent Tree, Leadership Talent Tree, or Military Tactics Talent Tree. On the subsequent round, you return to your normal place in the Initiative Order. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisite: When you use the Talent on an enemy, the target takes a cumulative -1 penalty to its Reflex Defense each time it is damaged by one of your allies (maximum -5 penalty). This penalty applies until the end of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide As a Swift Action, once per encounter, you can grant bonus Hit Points equal to 5 + one-half your Character Level to allies within 20 squares of you and in your line of sight. Damage is subtracted from the bonus Hit Points first, and any bonus Hit Points remaining at the end of the encounter go away. Bonus Hit Points from multiple sources do not stack. Reference Book: Star Wars Saga Edition Unknown Regions Your tactics confuse enemy commanders and tacticians that can see or otherwise observe your forces in action, such as when using sensors. After using the Share Talent special quality, make a Knowledge (Tactics) check as a Free Action. The result replaces the DC of any Talents that use Knowledge (Tactics) from the Military Tactics Talent Tree used against your or your allies. Reference Book: Star Wars Saga Edition Unknown Regions If you have already used a Talent in an encounter before granting the same Talent to an ally with your Share Talent special quality in the same encounter, any character who benefits from Share Talent gains one of the following bonuses when using that talent (if the Talent can be affected by more than one effect, the character using the Talent selects the desired effect): Reduce the Talent's DC by 5. Gain an additional +2 bonus to any bonus to attack, Defense, or damage used by the Talent. Reduce the amount of damage taken by the character through the use of the Talent by 10 points. Reference Book: Star Wars Saga Edition Unknown Regions","description":"You can use the , Deployment Tactics, or Field Tactics Talent as a Swift Action, instead of a Move Action (provided you have the Talent in question). Reference Book: Star Wars Saga Edition Unknown Regions During the first round of combat in an encounter (after the Surprise Round, if any), you can take your turn before any of your allies, but you must use either the Share Talent Prestige Class ability or a Talent from one of the following Talent Trees as part of your turn: Commando Talent Tree, Leadership Talent Tree, or Military Tactics Talent Tree. On the subsequent round, you return to your normal place in the Initiative Order. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisite: When you use the Talent on an enemy, the target takes a cumulative -1 penalty to its Reflex Defense each time it is damaged by one of your allies (maximum -5 penalty). This penalty applies until the end of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide As a Swift Action, once per encounter, you can grant bonus Hit Points equal to 5 + one-half your Character Level to allies within 20 squares of you and in your line of sight. Damage is subtracted from the bonus Hit Points first, and any bonus Hit Points remaining at the end of the encounter go away. Bonus Hit Points from multiple sources do not stack. Reference Book: Star Wars Saga Edition Unknown Regions Your tactics confuse enemy commanders and tacticians that can see or otherwise observe your forces in action, such as when using sensors. After using the Share Talent special quality, make a Knowledge (Tactics) check as a Free Action. The result replaces the DC of any Talents that use Knowledge (Tactics) from the Military Tactics Talent Tree used against your or your allies. Reference Book: Star Wars Saga Edition Unknown Regions If you have already used a Talent in an encounter before granting the same Talent to an ally with your Share Talent special quality in the same encounter, any character who benefits from Share Talent gains one of the following bonuses when using that talent (if the Talent can be affected by more than one effect, the character using the Talent selects the desired effect): Reduce the Talent's DC by 5. Gain an additional +2 bonus to any bonus to attack, Defense, or damage used by the Talent. Reduce the amount of damage taken by the character through the use of the Talent by 10 points. Reference Book: Star Wars Saga Edition Unknown Regions","class":"Officer","costNumeric":null,"category":"Officer","tree":"Military Tactics","treeId":"9253ace716c3e966","tags":["action-economy","ambush","controller","damage-reduction","defender","feat-chain","force","force-control","force-defense","force-offense","leader","leadership","mobility","positioning","scaling","scout","skills","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.assault_tactics"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d9fe8a0c76d845d4"}}},{"_id":"70c029c12a049865","name":"Block","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith Alchemy","prerequisites":"","benefit":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","description":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Sith Alchemy","treeId":"a67faf2ae089ab5d","tags":["action-economy","armor","dark-side","defender","force","force-offense","jedi","lightsaber","melee","mobility","ranged","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.block"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9379daa94a228c04"}}},{"_id":"8f9d843bc9b9fa84","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"7a4ff5645093fcc1","name":"Dark Side Adept","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith","prerequisites":"Prerequisites: Any One Force Technique, Weapon Focus (Lightsabers)","benefit":"Force Powers that are strongly tied to the Dark Side flow through you more easily. You can reroll any Use the Force check made when activating Force Powers with the [Dark Side] descriptor, and can spend a Force Point to keep the better of the two results. You can use your Use the Force modifier instead of your Deception check modifier when making Deception checks, as you use The Force to cloak your vile treachery. You are considered Trained in the Deception skill. If you are entitled to a Deception check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisites: , Dark Side Master Your knowledge of Sith sorcery allows you to imbue talismans and other objects with the power of the Dark Side. Create Sith Talisman: You can spend one Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power or Lightsaber attack. Creating the talisman takes a Full-Round Action. While you wear or carry a Sith Talisman on your person, add 1d6 to damage rolls with your Force Powers. You increase your Dark Side Score by one when you first put on or carry a Sith Talisman. You can only have one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a properly prepared weapon to become a Sith Weapon. You may spend a Force Point to imbue the weapon with the properties of the Sith Alchemical Weapon Template (this process takes one hour to complete). Reference Book: Star Wars Saga Edition Threats of the Galaxy You have learned how to use a Jedi fighting technique to defeat Jedi in combat. Choose one Talent from the Lightsaber Forms Talent Tree; you gain the benefits of this Talent and are considered to have this Talent for the purpose of satisfying prerequisites. You must meet all the prerequisites as normal for the chosen Talent, in addition to the prerequisites of this Talent. You can select this Talent multiple times. Each time you select it, choose a different Talent from the Lightsaber Forms Talent Tree. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: Any One Force Technique, Whenever you successfully activate a Force Power with the [Dark Side] descriptor that causes the target to move down the Condition Track, they gain a Persistent Condition, which can only be removed if the target receives Surgery (for living beings) or Repairs (for Droids, Vehicles, and objects). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Dark Side Master Once per encounter, you can spend a Force Point as a Standard Action to call upon the vengeful spirits of the ancient Sith. Doing so grants you 3 Followers with the Vengeful Spirit Template. These Followers appear in any unoccupied square adjacent to you, and last until the end of the encounter (at which point they vanish).","description":"Force Powers that are strongly tied to the Dark Side flow through you more easily. You can reroll any Use the Force check made when activating Force Powers with the [Dark Side] descriptor, and can spend a Force Point to keep the better of the two results. You can use your Use the Force modifier instead of your Deception check modifier when making Deception checks, as you use The Force to cloak your vile treachery. You are considered Trained in the Deception skill. If you are entitled to a Deception check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisites: , Dark Side Master Your knowledge of Sith sorcery allows you to imbue talismans and other objects with the power of the Dark Side. Create Sith Talisman: You can spend one Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power or Lightsaber attack. Creating the talisman takes a Full-Round Action. While you wear or carry a Sith Talisman on your person, add 1d6 to damage rolls with your Force Powers. You increase your Dark Side Score by one when you first put on or carry a Sith Talisman. You can only have one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a properly prepared weapon to become a Sith Weapon. You may spend a Force Point to imbue the weapon with the properties of the Sith Alchemical Weapon Template (this process takes one hour to complete). Reference Book: Star Wars Saga Edition Threats of the Galaxy You have learned how to use a Jedi fighting technique to defeat Jedi in combat. Choose one Talent from the Lightsaber Forms Talent Tree; you gain the benefits of this Talent and are considered to have this Talent for the purpose of satisfying prerequisites. You must meet all the prerequisites as normal for the chosen Talent, in addition to the prerequisites of this Talent. You can select this Talent multiple times. Each time you select it, choose a different Talent from the Lightsaber Forms Talent Tree. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: Any One Force Technique, Whenever you successfully activate a Force Power with the [Dark Side] descriptor that causes the target to move down the Condition Track, they gain a Persistent Condition, which can only be removed if the target receives Surgery (for living beings) or Repairs (for Droids, Vehicles, and objects). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Dark Side Master Once per encounter, you can spend a Force Point as a Standard Action to call upon the vengeful spirits of the ancient Sith. Doing so grants you 3 Followers with the Vengeful Spirit Template. These Followers appear in any unoccupied square adjacent to you, and last until the end of the encounter (at which point they vanish).","class":"Sith Apprentice","costNumeric":null,"category":"Sith Apprentice","tree":"Sith","treeId":"d1037bc7a08ea80b","tags":["action-economy","condition-removal","controller","dark-side","feat-chain","force","force-control","force-offense","jedi","leader","light-side","lightsaber","mechanics","melee","mobility","positioning","scaling","skills","social","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.dark_side_adept"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.cfdd73f3d939799d"}}},{"_id":"8f6dce4cb54cc584","name":"Indomitable","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":null,"benefit":"Once per day, move +5 steps up the condition track (not persistent conditions); may be taken multiple times.","description":"","class":"Soldier","costNumeric":null,"category":"Soldier","treeId":"798ed0945cbdac1c","tree":"Commando","tags":["condition-removal","controller","mobility","scaling","soldier","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.indomitable"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.b8aaf500d3069938"}}},{"_id":"6ed156706d77874b","name":"Melee Smash","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Specialist","prerequisites":"","benefit":"Unrelenting Assault You twirl your Weapon around you in a blur, creating a circle of death around you. Any enemy target that begins its turn adjacent to you takes damage equal to your Strength bonus. You must be wielding a Melee Weapon to be using this Talent.","description":"Unrelenting Assault You twirl your Weapon around you in a blur, creating a circle of death around you. Any enemy target that begins its turn adjacent to you takes damage equal to your Strength bonus. You must be wielding a Melee Weapon to be using this Talent.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Melee Specialist","treeId":"fad8118981c532f0","tags":["melee","positioning","soldier","striker","sustained-damage"]},"effects":[{"_id":"2d692811-5c22-48b8-944d-45db89ca5e77","name":"Melee Smash","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.melee","mode":5,"value":"half_level"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Melee Smash"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.melee_smash"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e0ee525f4109cfde"}}},{"_id":"49191bbaabfa61f0","name":"Shift Defense I","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Military Tactics","prerequisites":"","benefit":"As a Swift Action, you can take a -5 penalty to one Defense (Reflex, Fortitude, or Will) to gain a +2 competence bonus to another Defense until the start of your next turn. Prerequisites: , I As a Swift Action, you can gain a +5 competence bonus to one Defense (Reflex, Fortitude, or Will) by taking a -5 penalty to your other two Defenses.","description":"As a Swift Action, you can take a -5 penalty to one Defense (Reflex, Fortitude, or Will) to gain a +2 competence bonus to another Defense until the start of your next turn. Prerequisites: , I As a Swift Action, you can gain a +5 competence bonus to one Defense (Reflex, Fortitude, or Will) by taking a -5 penalty to your other two Defenses.","class":"Officer","costNumeric":null,"category":"Officer","tree":"Military Tactics","treeId":"9253ace716c3e966","tags":["action-economy","defender","mobility","striker"]},"effects":[{"_id":"ba3b7c8c-b416-4808-b91c-722e90b8c6b8","name":"Shift Defense I","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.flexible","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Shift Defense I"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.shift_defense_i"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.cb981391d4d16c59"}}},{"_id":"e2517ccbbed8ffe6","name":"Stunning Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Specialist","prerequisites":"","benefit":"When you damage an opponent with a melee attack that moves the target down the Condition Track, the target cannot take any Action requiring a Standard Action or a Full-Round Action on its next turn.","description":"When you damage an opponent with a melee attack that moves the target down the Condition Track, the target cannot take any Action requiring a Standard Action or a Full-Round Action on its next turn.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Melee Specialist","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.melee_smash"}],"_source":"canonical-csv"},"treeId":"fad8118981c532f0","tags":["action-economy","condition-removal","controller","melee","mobility","soldier","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.stunning_strike"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9292819462b46074"}}},{"_id":"e573215a51d1a5a6","name":"Weapon Specialization (Lightsabers)","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Duelist","tree":"Duelist","prerequisites":"","description":"Greater Weapon Focus (Lightsabers) You gain a +2 bonus on melee damage rolls with Lightsabers. This bonus stacks with the bonus granted by the Talent. Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. See also: Maiming Foes When you deal damage with a Lightsaber that is equal to or greater than both the target's current Hit Points and the target's Damage Threshold (that is, when you would deal enough damage to kill your target), you may choose to use this Talent. Instead of dealing full damage, you instead deal half damage to your target and move it -1 step on the Condition Track. In addition, you sever one of your target's arms at the wrist or elbow joint, or one of the target's legs at the knee or ankle joint (your choice). Severing part of an arm prevents the target from wielding weapons or using tools in that hand, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Severing part of a leg knocks the target Prone, reduces the target's Speed by half, reduces its Carrying Capacity by half, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Because of the severity of such an injury, losing part of a limb causes a Persistent Condition that can only be removed by having Surgery successfully performed on you. A Cybernetic Prosthesis negates these reductions and penalties. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","benefit":"Greater Weapon Focus (Lightsabers) You gain a +2 bonus on melee damage rolls with Lightsabers. This bonus stacks with the bonus granted by the Talent. Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. See also: Maiming Foes When you deal damage with a Lightsaber that is equal to or greater than both the target's current Hit Points and the target's Damage Threshold (that is, when you would deal enough damage to kill your target), you may choose to use this Talent. Instead of dealing full damage, you instead deal half damage to your target and move it -1 step on the Condition Track. In addition, you sever one of your target's arms at the wrist or elbow joint, or one of the target's legs at the knee or ankle joint (your choice). Severing part of an arm prevents the target from wielding weapons or using tools in that hand, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Severing part of a leg knocks the target Prone, reduces the target's Speed by half, reduces its Carrying Capacity by half, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Because of the severity of such an injury, losing part of a limb causes a Persistent Condition that can only be removed by having Surgery successfully performed on you. A Cybernetic Prosthesis negates these reductions and penalties. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","class":"","category":"","costNumeric":null,"treeId":"b3c5d90b5036f39b","tags":["burst-damage","condition-removal","controller","damage-reduction","defender","force","force-control","force-offense","leader","lightsaber","melee","mobility","scaling","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.00a9210772a64a19"}}},{"_id":"3ea3de909a5e48e8","name":"Battle Strike","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You channel the Force to enhance your next melee attack. Your next melee attack this round gains a +1d6 bonus to damage.</p>","special":"<p>This bonus damage is Force damage and bypasses Damage Reduction.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["enhancement","damage","melee"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f177dc6d65f76de9"}}},{"_id":"dafee14849c8b7e5","name":"Force Grip","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":3,"discipline":"dark-side","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Concentration","effect":"<p>You use the Force to telekinetically choke or crush your target. The target takes damage each round based on your Use the Force check result.</p>","special":"<p>This is a Dark Side power. The target is immobilized while gripped.</p>","descriptor":["Dark Side","Telekinetic"],"dcChart":[{"dc":15,"effect":"2d6 damage/round","description":"Target takes 2d6 damage per round and is immobilized"},{"dc":20,"effect":"4d6 damage/round","description":"Target takes 4d6 damage per round and is immobilized"},{"dc":25,"effect":"6d6 damage/round + lift","description":"Target takes 6d6 damage per round, is immobilized, and lifted off ground"},{"dc":30,"effect":"8d6 damage/round + crush","description":"Target takes 8d6 damage per round and is being crushed (fort save or die)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["attack","damage","dark-side","telekinetic","immobilize"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f41a957f71e98a6a"}}},{"_id":"27b35ed6d8b0a99e","name":"Force Lightning","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":4,"discipline":"dark-side","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Instantaneous","effect":"<p>You unleash devastating arcs of Force Lightning from your fingertips. The target takes lightning damage based on your Use the Force check result.</p>","special":"<p>This is a Dark Side power. Using it gains you a Dark Side Point.</p>","descriptor":["Dark Side","Force Lightning"],"dcChart":[{"dc":15,"effect":"2d6 lightning damage","description":"Target takes 2d6 lightning damage"},{"dc":20,"effect":"4d6 lightning damage","description":"Target takes 4d6 lightning damage"},{"dc":25,"effect":"6d6 lightning damage + stun","description":"Target takes 6d6 lightning damage and is stunned for 1 round"},{"dc":30,"effect":"8d6 lightning damage + stun 1d4","description":"Target takes 8d6 lightning damage and is stunned for 1d4 rounds"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["attack","damage","dark-side","lightning"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.0a422b939edfad56"}}},{"_id":"396d12e8f9a924e5","name":"Force Slam","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One creature or object","duration":"Instantaneous","effect":"<p>You use telekinetic force to violently slam your target against a surface. The target takes 4d6 damage and is knocked prone.</p>","special":"<p>The target must be within 6 squares of a solid surface (wall, floor, ceiling).</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":97,"tags":["attack","damage","telekinetic","prone"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.462a6c23e00c4dfc"}}},{"_id":"53e1daf2b26448da","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}},{"_id":"2f8c50712f13c4fd","name":"Surge","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"vital","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You use the Force to push your body beyond normal limits. You gain an additional move action this turn.</p>","special":"<p>This extra move action can be used to move or perform other move-action tasks.</p>","descriptor":["Vital"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["enhancement","action-economy","movement"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.1ac1084ca8f07114"}}},{"_id":"9b047fd209f07ca0","name":"Long-Handle Lightsaber","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d10+10","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Long-Handle Lightsaber","npc":{"flatAttackBonus":21,"flatDamageFormula":"2d10+10","useFlat":true}}}},{"_id":"a84363a7a480f46e","name":"Long-Handle Lightsaber (with Rapid Strike)","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d10+10","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weigh