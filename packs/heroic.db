ble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"f9430d99f56aac3f","name":"Coordinate","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Leadership","prerequisites":null,"benefit":"All allies in line of sight gain +1 when using aid another (maximum +5).","description":"All allies gain +1 when using Aid Another, up to +5.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Leadership","canonicalName":"Coordinate","canonicalTree":"Bab +12","treeId":"5964237d22681dc0","tags":["noble","striker"]},"effects":[{"_id":"25b28077-6a3c-43d8-97ba-a128e768f614","name":"Coordinate","icon":"icons/svg/handshake.svg","changes":[{"key":"system.actions.aidAnother","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Coordinate"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.coordinate"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a52044feeab3fe05"}}},{"_id":"af259d65203ade8f","name":"Gimmick","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Slicer","prerequisites":"Trained in Use Computer","benefit":"You may choose to reroll any Use Computer check made to Improve Access on a computer, keeping the better of the two results. You can substitute your Use Computer Skill for any Gather Information check as long as you have access to a computer network. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You can use your Use Computer modifier in place of your Deception modifier to create a deceptive appearance with forged electronic documents. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You excel at causing havoc with computers and electronics. As a Standard Action, you can lock down a computer terminal by making a Use Computer check, making it potentially difficult for anyone else to access. That computer is considered Unfriendly to anyone other than you who attempts to use it, and the result of your Use Computer check replaces the computer's Will Defense on an attempt to change its Attitude. This effect ends if anyone else succeeds in adjusting the computer's Attitude to Indifferent. You cannot Take 20 on this Use Computer check. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You are an expert in electronic security. When you make a Mechanics check to Disable Device, you can do so without the help of a Security Kit. Additionally, something goes wrong only when you fail the Mechanics check by 10 or more. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: When attempting to damage or disrupt a computer system, you may make a DC 20 Use Computer check. If successful, the computer moves -5 steps on the Condition Track and becomes disabled. If working remotely from another terminal or device, the DC increases to 30. Homebrew Reference Book: New Republic Campaign Guide When making a Use Computer check to Access Information, Disable or Erase Program, Improve Access, or Issue Routine Command, you may make a DC 25 Use Computer check before making the command. If successful, the effects of Cover Tracks are automatically applied regardless of the actual check DC. Homebrew Reference Book: New Republic Campaign Guide You may grant a +2 bonus to a computer's Will Defense against Use Computer checks to Improve Access. If the attacking slicer fails their Use Computer check by 5 or more, the Attitude of the computer moves 2 steps toward Hostile (Instead of the normal 1 step towards Hostile).","description":"You may choose to reroll any Use Computer check made to Improve Access on a computer, keeping the better of the two results. You can substitute your Use Computer Skill for any Gather Information check as long as you have access to a computer network. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You can use your Use Computer modifier in place of your Deception modifier to create a deceptive appearance with forged electronic documents. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You excel at causing havoc with computers and electronics. As a Standard Action, you can lock down a computer terminal by making a Use Computer check, making it potentially difficult for anyone else to access. That computer is considered Unfriendly to anyone other than you who attempts to use it, and the result of your Use Computer check replaces the computer's Will Defense on an attempt to change its Attitude. This effect ends if anyone else succeeds in adjusting the computer's Attitude to Indifferent. You cannot Take 20 on this Use Computer check. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You are an expert in electronic security. When you make a Mechanics check to Disable Device, you can do so without the help of a Security Kit. Additionally, something goes wrong only when you fail the Mechanics check by 10 or more. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: When attempting to damage or disrupt a computer system, you may make a DC 20 Use Computer check. If successful, the computer moves -5 steps on the Condition Track and becomes disabled. If working remotely from another terminal or device, the DC increases to 30. Homebrew Reference Book: New Republic Campaign Guide When making a Use Computer check to Access Information, Disable or Erase Program, Improve Access, or Issue Routine Command, you may make a DC 25 Use Computer check before making the command. If successful, the effects of Cover Tracks are automatically applied regardless of the actual check DC. Homebrew Reference Book: New Republic Campaign Guide You may grant a +2 bonus to a computer's Will Defense against Use Computer checks to Improve Access. If the attacking slicer fails their Use Computer check by 5 or more, the Attitude of the computer moves 2 steps toward Hostile (Instead of the normal 1 step towards Hostile).","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Slicer","treeId":"64874e65579e4cf4","tags":["action-economy","condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","leader","mechanics","mobility","scaling","scoundrel","skills","slicing","social","striker","support","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.gimmick"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8d8937a416fc0d81"}}},{"_id":"524598d6700417a4","name":"Master Slicer","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Slicer","prerequisites":"Gimmick","benefit":"Reroll Use Computer checks to improve access to computers.","description":"Reroll Use Computer checks to improve access.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Slicer","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.gimmick"}],"_source":"canonical-csv"},"treeId":"64874e65579e4cf4","tags":["feat-chain","scaling","scoundrel","talent-chain"]},"effects":[{"_id":"0fb45306-0091-4a1e-94f0-46b013c5b671","name":"Master Slicer","icon":"icons/svg/laptop.svg","changes":[{"key":"system.skills.useComputer.misc","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Master Slicer"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talen