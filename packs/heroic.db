vg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"5bd79920f742a9c8","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"38abebfc25d8e0cd","name":"Born Leader","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Naval Officer","prerequisites":"","benefit":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","description":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","class":"Noble","costNumeric":null,"category":"Noble","tree":"Naval Officer","treeId":"057a978a7dc1d5a7","tags":["armor","defender","noble","striker","support","sustained-damage"]},"effects":[{"_id":"f9275c38-3cb5-4ab3-aaa5-25e5722dcdd3","name":"Born Leader","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.will","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Born Leader"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.born_leader"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.6a66ba6e0834dd6f"}}},{"_id":"36a85c0923594dab","name":"Connections","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":"","benefit":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","treeId":"b5bb4154688c66ab","tags":["force","noble","skills","social","striker","support"]},"effects":[{"_id":"6708f25b-1035-4044-99fb-a15527d65e5c","name":"Connections","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.economy.blackMarketMultiplier","mode":2,"value":"-1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Connections","effectType":"economy_bonus","economy":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.connections"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e58a8ad63c1d8771"}}},{"_id":"a10791abda337be2","name":"Competitive Drive","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Corporate Power","prerequisites":null,"benefit":"Once per encounter reroll one Wisdom, Intelligence, or Charisma-based skill check (except Use the Force).","description":"Once per encounter, reroll a Wisdom-, Intelligence-, or Charisma-based skill check (except Use the Force).","class":"Corporate Agent","costNumeric":null,"category":"Corporate Agent","tree":"Corporate Power","treeId":"45c4007d09c01839","tags":["force","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.competitive_drive"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.53b0aa17a95ba670"}}},{"_id":"ca3cb3f991dbcc9d","name":"Corporate Clout","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Corporate Power","prerequisites":"Impose Hesitation","benefit":"Once per encounter, Persuasion vs Will within line of sight can prevent the target from attacking you; if over by 5, they also cannot attack your allies.","description":"Once per encounter, Persuasion vs Will Defense; the target cannot attack you, and if exceeded by 5, cannot attack your allies.","class":"Corporate Agent","costNumeric":null,"category":"Corporate Agent","tree":"Corporate Power","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.impose_hesitation"},{"type":"talent","id":"swse.talent.wrong_decision"}],"_source":"canonical-csv"},"treeId":"45c4007d09c01839","tags":["feat-chain","skills","social","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.corporate_clout"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.50073b86c51c52cd"}}},{"_id":"d6954448c4a08654","name":"Distant Command","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Leadership","prerequisites":"Born Leader","benefit":"You do not lose Born Leader’s benefits if out of line of sight.","description":"Born Leader remains active even when allies are not in line of sight.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Leadership","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.born_leader"}],"_source":"canonical-csv"},"treeId":"5964237d22681dc0","tags":["feat-chain","noble","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.distant_command"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.64fa257cd511314d"}}},{"_id":"015f075203cb1456","name":"Impose Hesitation","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Corporate Power","prerequisites":"","benefit":"Wrong Decision You are adept at making deals that make opponents question which side they should be on. Once per encounter, as a Standard Action, you can make a Persuasion check against the Will Defense of an opponent within line of sight. If your check equals or exceeds the target's Will Defense, the target cannot attack you for the remainder of the encounter. If your check exceeds the target's Will Defense by 5 or more, the target will not attack you or your allies for the remainder of the encounter. If your check exceeds the target's Will Defense by 10 or more, the target's Attitude toward you is now Friendly, and the target becomes your ally for the remainder of the encounter, remaining under the control of the Gamemaster. If you or one of your allies attacks the target, the target once again becomes Hostile. If the target is a higher level than you, it gains a +5 bonus to its Will Defense. This is a Mind-Affecting Fear effect. Prerequisite: Increase the area of to a 12-Square Cone. Also, once per encounter, after making the Persuasion check for , you can instead choose to have the targets lose a Standard Action on their next turn. As a Standard Action, make a Persuasion check targeting all opponents within a 6-Square Cone. If you equal or exceed the target's Will Defense, the target loses a Swift Action on its next turn, and cannot take Full-Round Actions. Targets need to see, hear, and understand you to be affected by this attack. This is a Mind-Affecting effect. Once per encounter, you can negate the effects of a single attack roll or Skill Check made against you that targets your Will Defense. Each time you are attacked, the opponent that attacked you takes a -2 morale penalty to its Will Defense until the end of your next turn. This penalty is not cumulative, so if a target makes multiple attacks against you it only incurs the penalty once per turn.","description":"Wrong Decision You are adept at making deals that make opponents question which side they should be on. Once per encounter, as a Standard Action, you can make a Persuasion check against the Will Defense of an opponent within line of sight. If your check equals or exceeds the target's Will Defense, the target cannot attack you for the remainder of the encounter. If your check exceeds the target's Will Defense by 5 or more, the target will not attack you or your allies for the remainder of the encounter. If your check exceeds the target's Will Defense by 10 or more, the target's Attitude toward you is now Friendly, and the target becomes your ally for the remainder of the encounter, remaining under the control of the Gamemaster. If you or one of your allies attacks the target, the target once again becomes Hostile. If the target is a higher level than you, it gains a +5 bonus to its Will Defense. This is a Mind-Affecting Fear effect. Prerequisite: Increase the area of to a 12-Square Cone. Also, once per encounter, after making the Persuasion check for , you can instead choose to have the targets lose a Standard Action on their next turn. As a Standard Action, make a Persuasion check targeting all opponents within a 6-Square Cone. If you equal or exceed the target's Will Defense, the target loses a Swift Action on its next turn, and cannot take Full-Round Actions. Targets need to see, hear, and understand you to be affected by this attack. This is a Mind-Affecting effect. Once per encounter, you can negate the effects of a single attack roll or Skill Check made against you that targets your Will Defense. Each time you are attacked, the opponent that attacked you takes a -2 morale penalty to its Will Defense until the end of your next turn. This penalty is not cumulative, so if a target makes multiple attacks against you it only incurs the penalty once per turn.","class":"Corporate Agent","costNumeric":null,"category":"Corporate Agent","tree":"Corporate Power","treeId":"45c4007d09c01839","tags":["action-economy","battlefield-control","burst-damage","defender","force","force-control","force-defense","force-offense","leader","mobility","positioning","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.impose_hesitation"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.0fd8fc8cfae6f516"}}},{"_id":"d1ef82201de9decd","name":"Wealth","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":null,"benefit":"At every level, gain credits equal to class level × 5000.","description":"Gain credits equal to character level × 5,000 each level.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","treeId":"b5bb4154688c66ab","tags":["noble"]},"effects":[{"_id":"cd6b58ce-5144-4f39-a76a-720505ecdfc8","name":"Wealth","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.credits","mode":2,"value":"level_per_level"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Wealth"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.wealth"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.37bf53b4b2c0e539"}}},{"_id":"8ecfdcd2e69d8a9f","name":"Wrong Decision","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Corporate Power","prerequisites":null,"benefit":"Each time you are attacked, the opponent takes -2 to Will Defense until the end of their next turn.","description":"Each time you are attacked, the attacker takes –2 to Will Defense until the end of your next turn.","class":"Corporate Agent","costNumeric":null,"category":"Corporate Agent","tree":"Corporate Power","treeId":"45c4007d09c01839","tags":["defender"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.wrong_decision"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.463ae052e705eaf3"}}},{"_id":"b5dfe2edb5c98cb6","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d6+8","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":12,"flatDamageFormula":"1d6+8","useFlat":true}}}},{"_id":"d25be4795aea908c","name":"Sporting Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d4+7","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":300,"equipped":true,"description":"<p>A civilian-grade blaster pistol designed for sport shooting and personal defense. Less powerful than military models but widely available.</p>","properties":["Civilian"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pi