peed":"6 Squares; Full Throttle","Melee Weapons":"Unarmed +8 (1d4+5)","Ranged Weapons":"Blaster Pistol +11 (3d6+5), Blaster Pistol +6 (3d6+5) and Blaster Pistol +6 (3d6+5) with Double Attack","Base Attack Bonus":8,"Grapple":11,"Attack Options":["Double Attack (Pistols)","Point-Blank Shot"],"Special Actions":["Connections","Hyperdriven","Wealth"],"Force Powers":[],"Force Secrets":[],"Force Techniques":[],"Strength":10,"Dexterity":17,"Constitution":12,"Intelligence":14,"Wisdom":8,"Charisma":15,"Talents":["Talents : Connections","Full Throttle","Hyperdriven","Relentless Pursuit","Spacehound","Wealth"],"Feats":["Feats : Dodge","Double Attack (Pistols)","Linguist","Mobility","Point-Blank Shot","Skill Focus (Pilot)","Starship Tactics","Vehicular Combat","Weapon Proficiency (Heavy Weapons)","Weapon Proficiency (Pistols)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Deception","Gather Information","Initiative","Knowledge (Galactic Lore)","Perception","must take second result)","Pilot","may keep better result)","Use Computer"],"Trained Skills":["Skills : Deception","Gather Information","Initiative","Knowledge (Galactic Lore)","Perception","must take second result)","Pilot","may keep better result)","Use Computer"],"Species Traits":[],"Gear":"Blaster Pistol , The Last Laugh (Modified Cutlass-9 Patrol Fighter (No Weapon Systems ; Hyperdrive Class 3; Speed: Fly 16 Squares ( Character Scale ), Fly 6 Squares ( Starship Scale ); (Maximum Velocity 1,300 km/h)))"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
