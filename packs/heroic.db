-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"e0c4dbea3f53276b","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"c89d177568391400","name":"Acute Senses","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Master Scout","prerequisites":"","benefit":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","description":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Master Scout","treeId":"dca33c0215264a02","tags":["action-economy","armor","controller","damage-reduction","defender","force","force-control","force-defense","force-offense","melee","mobility","positioning","ranged","scout","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.acute_senses"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f0166d26d9f6252a"}}},{"_id":"5518179fa27c72c0","name":"Barter","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fringer","prerequisites":null,"benefit":"Reroll Persuasion checks to haggle.","description":"Reroll Persuasion checks when haggling.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Fringer","treeId":"7c47d36dc1f77d9c","tags":["scout","skills","social"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.barter"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.6408bc9e8f582f5d"}}},{"_id":"77dd540f6fb2d972","name":"Connections","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":"","benefit":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","treeId":"b5bb4154688c66ab","tags":["force","noble","skills","social","striker","support"]},"effects":[{"_id":"6708f25b-1035-4044-99fb-a15527d65e5c","name":"Connections","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.economy.blackMarketMultiplier","mode":2,"value":"-1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Connections","effectType":"economy_bonus","economy":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.connections"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e58a8ad63c1d8771"}}},{"_id":"07b8bbac3481b79c","name":"Educated","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":"","benefit":"Sometimes you surprise others with your skill. Once per day, you may make an Untrained skill check as though you were Trained in the Skill. Exception: you cannot use this Talent to make an Untrained Use the Force check as though you were Trained in the skill, unless you have the Force Sensitivity feat. You can select this Talent multiple times; each time you do, you can use it one additional time per day. Each time you gain a level (including the level at which you select this Talent), you receive an amount of credits equal to 5,000 x your Class Level. You can spend these credits as you see fit. The credits appear in a civilized, accessible location of your choice or in your private bank account. Reference Book: Star Wars Saga Edition Starships of the Galaxy Prerequisites: , Trained in Knowledge (Technology) You are Trained in the Mechanics skill. Additionally, when installing new systems into a Vehicle, the efficiency of your designs reduces the time it takes to install the system by 25%. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisites: , Intelligence 13 Select a number of Skills equal to your Intelligence modifier that you are not Trained in. You may now use Trained-only applications of those Skills, and they are considered Class Skills. You are not considered Trained in those Skills for any other purposes, and must still satisfy any other requirements in order to use the skill. Homebrew Reference Book: Legacy of the Force Sourcebook Select one type of performance, such as acting, dancing, singing, or playing a musical instrument. You gain a +5 bonus on Persuasion checks to entertain for that type of performance. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Intelligence 13 You have the ability to acquire aid and information from a long list of people. You may reroll any Gather Information check, but the result of the reroll must be accepted, even if it is worse. Additionally, the DC for any Persuasion checks made to reduce the cost of Bribery is reduced by 5.","description":"Sometimes you surprise others with your skill. Once per day, you may make an Untrained skill check as though you were Trained in the Skill. Exception: you cannot use this Talent to make an Untrained Use the Force check as though you were Trained in the skill, unless you have the Force Sensitivity feat. You can select this Talent multiple times; each time you do, you can use it one additional time per day. Each time you gain a level (including the level at which you select this Talent), you receive an amount of credits equal to 5,000 x your Class Level. You can spend these credits as you see fit. The credits appear in a civilized, accessible location of your choice or in your private bank account. Reference Book: Star Wars Saga Edition Starships of the Galaxy Prerequisites: , Trained in Knowledge (Technology) You are Trained in the Mechanics skill. Additionally, when installing new systems into a Vehicle, the efficiency of your designs reduces the time it takes to install the system by 25%. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisites: , Intelligence 13 Select a number of Skills equal to your Intelligence modifier that you are not Trained in. You may now use Trained-only applications of those Skills, and they are considered Class Skills. You are not considered Trained in those Skills for any other purposes, and must still satisfy any other requirements in order to use the skill. Homebrew Reference Book: Legacy of the Force Sourcebook Select one type of performance, such as acting, dancing, singing, or playing a musical instrument. You gain a +5 bonus on Persuasion checks to entertain for that type of performance. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Intelligence 13 You have the ability to acquire aid and information from a long list of people. You may reroll any Gather Information check, but the result of the reroll must be accepted, even if it is worse. Additionally, the DC for any Persuasion checks made to reduce the cost of Bribery is reduced by 5.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","treeId":"b5bb4154688c66ab","tags":["ambush","damage-reduction","force","mechanics","noble","scaling","skills","social","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.educated"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.3e98c9f5a4f450ff"}}},{"_id":"22c13e540661139c","name":"Gimmick","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Slicer","prerequisites":"Trained in Use Computer","benefit":"You may choose to reroll any Use Computer check made to Improve Access on a computer, keeping the better of the two results. You can substitute your Use Computer Skill for any Gather Information check as long as you have access to a computer network. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You can use your Use Computer modifier in place of your Deception modifier to create a deceptive appearance with forged electronic documents. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You excel at causing havoc with computers and electronics. As a Standard Action, you can lock down a computer terminal by making a Use Computer check, making it potentially difficult for anyone else to access. That computer is considered Unfriendly to anyone other than you who attempts to use it, and the result of your Use Computer check replaces the computer's Will Defense on an attempt to change its Attitude. This effect ends if anyone else succeeds in adjusting the computer's Attitude to Indifferent. You cannot Take 20 on this Use Computer check. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You are an expert in electronic security. When you make a Mechanics check to Disable Device, you can do so without the help of a Security Kit. Additionally, something goes wrong only when you fail the Mechanics check by 10 or more. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: When attempting to damage or disrupt a computer system, you may make a DC 20 Use Computer check. If successful, the computer moves -5 steps on the Condition Track and becomes disabled. If working remotely from another terminal or device, the DC increases to 30. Homebrew Reference Book: New Republic Campaign Guide When making a Use Computer check to Access Information, Disable or Erase Program, Improve Access, or Issue Routine Command, you may make a DC 25 Use Computer check before making the command. If successful, the effects of Cover Tracks are automatically applied regardless of the actual check DC. Homebrew Reference Book: New Republic Campaign Guide You may grant a +2 bonus to a computer's Will Defense against Use Computer checks to Improve Access. If the attacking slicer fails their Use Computer check by 5 or more, the Attitude of the computer moves 2 steps toward Hostile (Instead of the normal 1 step towards Hostile).","description":"You may choose to reroll any Use Computer check made to Improve Access on a computer, keeping the better of the two results. You can substitute your Use Computer Skill for any Gather Information check as long as you have access to a computer network. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You can use your Use Computer modifier in place of your Deception modifier to create a deceptive appearance with forged electronic documents. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You excel at causing havoc with computers and electronics. As a Standard Action, you can lock down a computer terminal by making a Use Computer check, making it potentially difficult for anyone else to access. That computer is considered Unfriendly to anyone other than you who attempts to use it, and the result of your Use Computer check replaces the computer's Will Defense on an attempt to change its Attitude. This effect ends if anyone else succeeds in adjusting the computer's Attitude to Indifferent. You cannot Take 20 on this Use Computer check. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You are an expert in electronic security. When you make a Mechanics check to Disable Device, you can do so without the help of a Security Kit. Additionally, something goes wrong only when you fail the Mechanics check by 10 or more. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: When attempting to damage or disrupt a computer system, you may make a DC 20 Use Computer check. If successful, the computer moves -5 steps on the Condition Track and becomes disabled. If working remotely from another terminal or device, the DC increases to 30. Homebrew Reference Book: New Republic Campaign Guide When making a Use Computer check to Access Information, Disable or Erase Program, Improve Access, or Issue Routine Command, you may make a DC 25 Use Computer check before making the command. If successful, the effects of Cover Tracks are automatically applied regardless of the actual check DC. Homebrew Reference Book: New Republic Campaign Guide You may grant a +2 bonus to a computer's Will Defense against Use Computer checks to Improve Access. If the attacking slicer fails their Use Computer check by 5 or more, the Attitude of the computer moves 2 steps toward Hostile (Instead of the normal 1 step towards Hostile).","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Slicer","treeId":"64874e65579e4cf4","tags":["action-economy","condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","leader","mechanics","mobility","scaling","scoundrel","skills","slicing","social","striker","support","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.gimmick"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8d8937a416fc0d81"}}},{"_id":"f893666e0e137902","name":"Knack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fortune","prerequisites":"","benefit":"Once per day, you can reroll an attack roll and take the better result. You can select this Talent multiple times; each time you select this Talent, you can use it one additional time per day. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot You are possessed of incredible luck and an uncanny ability to succeed where others would fail. You can use each of the following actions once per encounter as a Standard Action: Elude Enemy: Make a single melee or ranged attack against any target within your Range. If you damage the target, you gain a +2 bonus to your Reflex Defense against this target until the beginning of your next turn. Escape: Make a single melee or ranged attack against any target within your Range. If that target successfully damages you before the start of your next turn, you can immediately move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Make your Own Luck: Make a single melee or ranged attack against any target within your Range. If you miss this target, you gain a +2 bonus on your next attack roll. Reference Book: Star Wars Saga Edition Scum and Villainy Once per encounter, as a Reaction, you become immune to all Mind-Affecting effects until the end of your next turn (you can choose to ignore this for beneficial effects). Any Mind-Affecting effects currently afflicting you are also removed, though you can choose to retain any beneficial effects you currently have. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisite: A successful hit against you is mitigated by an item you just happen to be wearing or carrying, or glances off your armor or clothing in just the right way. Once per encounter, as a Reaction, you can negate the damage from a single attack that would normally reduce you to 0 Hit Points. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot When making a ranged attack against a target with Cover, you can choose to reduce the benefit of that target's Cover by one step, from Improved Cover to Cover, or Cover to no Cover. You deal only half damage with this attack. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can consider any single d20 roll of 16 or higher to be a Natural 20. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can reroll the damage of one attack, keeping the better of the two results. Gambler's Fortune Talent data created by Sterling Hershey (source). Prerequisites: , Trained in Chosen Skill Select one of the following Skills: Knowledge (Any), Mechanics, Perception, or Use Computer. When making a reroll for that Skill, you may keep the better result.","description":"Once per day, you can reroll an attack roll and take the better result. You can select this Talent multiple times; each time you select this Talent, you can use it one additional time per day. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot You are possessed of incredible luck and an uncanny ability to succeed where others would fail. You can use each of the following actions once per encounter as a Standard Action: Elude Enemy: Make a single melee or ranged attack against any target within your Range. If you damage the target, you gain a +2 bonus to your Reflex Defense against this target until the beginning of your next turn. Escape: Make a single melee or ranged attack against any target within your Range. If that target successfully damages you before the start of your next turn, you can immediately move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Make your Own Luck: Make a single melee or ranged attack against any target within your Range. If you miss this target, you gain a +2 bonus on your next attack roll. Reference Book: Star Wars Saga Edition Scum and Villainy Once per encounter, as a Reaction, you become immune to all Mind-Affecting effects until the end of your next turn (you can choose to ignore this for beneficial effects). Any Mind-Affecting effects currently afflicting you are also removed, though you can choose to retain any beneficial effects you currently have. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisite: A successful hit against you is mitigated by an item you just happen to be wearing or carrying, or glances off your armor or clothing in just the right way. Once per encounter, as a Reaction, you can negate the damage from a single attack that would normally reduce you to 0 Hit Points. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot When making a ranged attack against a target with Cover, you can choose to reduce the benefit of that target's Cover by one step, from Improved Cover to Cover, or Cover to no Cover. You deal only half damage with this attack. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can consider any single d20 roll of 16 or higher to be a Natural 20. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can reroll the damage of one attack, keeping the better of the two results. Gambler's Fortune Talent data created by Sterling Hershey (source). Prerequisites: , Trained in Chosen Skill Select one of the following Skills: Knowledge (Any), Mechanics, Perception, or Use Computer. When making a reroll for that Skill, you may keep the better result.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Fortune","treeId":"cee9b9398682b7d0","tags":["action-economy","armor","controller","damage-reduction","defender","mechanics","melee","mobility","perception","positioning","ranged","scaling","scoundrel","skills","slicing","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.knack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ac6baadb9d65ff7f"}}},{"_id":"3e950b1c9d8cfb94","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d6+5","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":7,"flatDamageFormula":"1d6+5","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Large","Species":"Hutt","Nonheroic Level":0,"Class Levels":{"Noble":3,"Scoundrel":3,"Scout":3},"Destiny Points":1,"Force Points":4,"Dark Side Points":3,"Initiative":3,"Senses":"Perception +16","Languages":["Basic","Bocce","Bothese","High Galactic","Huttese","Shyriiwook (understand only)"],"Unassigned Languages":0,"Reflex Defense":20,"Flat-Footed Defense":19,"Fortitude Defense":22,"Will Defense":24,"Hit Points":58,"Damage Threshold":32,"Speed":"2 Squares","Melee Weapons":"Unarmed +7 (1d6+5)","Ranged Weapons":"By Weapon +5","Base Attack Bonus":6,"Grapple":12,"Attack Options":["Point-Blank Shot","Precise Shot"],"Special Actions":["Connections","Educated","Gimmick","Knack"],"Force Powers":[],"Force Secrets":[],"Force Techniques":[],"Strength":13,"Dexterity":8,"Constitution":13,"Intelligence":13,"Wisdom":15,"Charisma":12,"Talents":["Talents : Acute Senses","Barter","Connections","Educated","Gimmick","Knack"],"Feats":["Feats : Improved Defenses","Improved Damage Threshold","Linguist","Point-Blank Shot","Precise Shot","Skill Focus (Gather Information)","Skill Focus (Knowledge (Galactic Lore))","Skill Focus (Persuasion)","Skill Focus (Use Computer)","Weapon Proficiency (Pistols)","Weapon Proficiency (Rifles)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Deception","Gather Information","Knowledge (Galactic Lore)","Knowledge (Social Sciences)","Perception","must take second result)","Persuasion","may keep better result; may reroll to Haggle","must take second result)","Use Computer"],"Trained Skills":["Skills : Deception","Gather Information","Knowledge (Galactic Lore)","Knowledge (Social Sciences)","Perception","must take second result)","Persuasion","may keep better result; may reroll to Haggle","must take second result)","Use Computer"],"Species Traits":[],"Gear":"Comlink (Short-Range), Cybernetic Eye (Linked to Private Database)"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
{"_id":"65971b902161f8e5","name":"Captain Vischera","type":"npc","img":"icons/svg/mystery-man.svg","system":{"isDroid":false,"droidDegree":"","attributes":{"str":{"base":10,"racial":0,"enhancement":0,"temp":0},"dex":{"base":12,"racial":0,"enhancement":0,"temp":0},"con":{"base":10,"racial":0,"enhancement":0,"temp":0},"int":{"base":14,"racial":0,"enhancement":0,"temp":0},"wis":{"base":11,"racial":0,"enhancement":0,"temp":0},"cha":{"base":13,"racial":0,"enhancement":0,"temp":0}},"skills":{"acrobatics":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"dex","favorite":false},"climb":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"str","favorite":false},"deception":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"cha","favorite":false},"endurance":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"con","favorite":false},"gatherInformation":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"cha","favorite":false},"initiative":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"dex","favorite":false},"jump":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"str","favorite":false},"knowledgeBureaucracy":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeGalacticLore":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeLifeSciences":{"trained":true,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgePhysicalSciences":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeSocialSciences":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeTactics":{"trained":true,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeTechnology":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"mechanics":{"trained":false,"focused":fal