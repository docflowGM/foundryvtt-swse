 a +1 dodge bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a> against a selected target."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13}],"_source":"canonical-csv"}},"effects":[{"name":"Dodge","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"feat-defense-bonus","source":"Dodge","defenseType":"reflex"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.45366d4f3a5e443d"}}},{"_id":"25222b772979eb06","name":"Improved Defenses","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus to your Reflex, Fortitude, and Will Defense.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["defender","noble","non-force","scout","soldier","striker"],"bonus_feat_for":["Soldier","Scout","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +1 bonus to all <a href=\"/wiki/Defenses\" title=\"Defenses\">Defenses</a>."}},"effects":[{"name":"Improved Defenses","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.defenses.reflex.bonus","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"defense-bonus","defense":"reflex"}}},{"name":"Improved Defenses","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.defenses.fortitude.bonus","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"defense-bonus","defense":"fortitude"}}},{"name":"Improved Defenses","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.defenses.will.bonus","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":