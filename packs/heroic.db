g> Perception +9</p>\n<p><strong>Attack Options:</strong> Double Attack (Lightsabers), Severing Strike, Weapon Finesse</p>\n<p><strong>Special Actions:</strong> Adept Negotiator, Redirect Shot, Serenity</p>","derived":{},"npcProfile":{"kind":"heroic","mode":"play","sourceAuthority":"statblock","legalProfile":"heroic","legalState":"unchecked","importMode":"play","playReady":true,"statblockAuthority":true,"sourcePack":"heroic","normalizationVersion":1,"authority":{"hp":"statblock","defenses":"statblock","bab":"statblock","attacks":"statblock","skills":"statblock","damageThreshold":"statblock"}}},"items":[{"_id":"db7b3bea5c7c71c6","name":"Human","type":"species","img":"icons/svg/mystery-man.svg","system":{"size":"Medium","speed":6,"abilities":"None","skillBonuses":[],"special":["Bonus Feat: Humans gain one bonus feat at 1st level","Bonus Trained Skill: Humans gain one additional trained skill at 1st level"],"languages":["Basic"],"source":"Core","description":"","tags":[],"visionTraits":[],"naturalWeapons":[],"movementTraits":[],"environmentalTraits":[],"combatTraits":{"naturalArmor":0,"weaponProficiencies":[],"otherTraits":[]},"techTraits":[],"forceTraits":[],"socialTraits":[],"bonusFeats":1,"bonusTrainedSkills":1,"costNumeric":null},"effects":[],"folder":null,"sort":700,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.species.species-human"}}},{"_id":"903eb437295ca0e3","name":"Armor Proficiency (light)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with light armor and do not take armor check penalties on attack rolls.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":85,"tags":["armor","defender","non-force","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No penalty on attacks and no <a class=\"mw-redirect\" href=\"/wiki/Armor_Check_Pena