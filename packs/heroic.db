foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"73dd063a6f63ed23","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"c134ca596e32d3d7","name":"Disruptive","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"As a Standard Action, you can do or say something that catches your enemies off guard. All opponents within 6 squares of you, and within your line of sight take a -2 penalty to their Defenses until the start of your next turn. The penalty is negated if line of sight is broken. This Talent has a range of 6 squares at Starship Scale. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Walk the Line You can create opportunities to chip away at our opponents' defenses. You can use each of the following actions once per encounter as a Standard Action: Create Opening: Make a single melee or ranged attack against any target within your Range. If you damage the target, the target takes a -5 penalty to their Reflex Defense until the start of your next turn. Crippling Attack: Make a single melee or ranged attack against any target within your Range. Until the start of your next turn, the target takes a -2 penalty to their base speed. Vicious Attack: Make a melee or ranged attack within your Range against two opponents that are within 2 squares of each other. Make separate attack rolls at a -5 penalty against each target, but roll damage once only. Reference Book: Star Wars Saga Edition Scum and Villainy You can fill your opponent with doubt by making a Persuasion check as a Standard Action against a single target that can hear and understand you within 12 squares of you. If your check result equals or exceeds the target's Will Defense, the target takes a -2 penalty to its base speed, and if the target takes a Standard Action, it must also spend its Swift Action. This penalty lasts until the end of the target's next turn. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"As a Standard Action, you can do or say something that catches your enemies off guard. All opponents within 6 squares of you, and within your line of sight take a -2 penalty to their Defenses until the start of your next turn. The penalty is negated if line of sight is broken. This Talent has a range of 6 squares at Starship Scale. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Walk the Line You can create opportunities to chip away at our opponents' defenses. You can use each of the following actions once per encounter as a Standard Action: Create Opening: Make a single melee or ranged attack against any target within your Range. If you damage the target, the target takes a -5 penalty to their Reflex Defense until the start of your next turn. Crippling Attack: Make a single melee or ranged attack against any target within your Range. Until the start of your next turn, the target takes a -2 penalty to their base speed. Vicious Attack: Make a melee or ranged attack within your Range against two opponents that are within 2 squares of each other. Make separate attack rolls at a -5 penalty against each target, but roll damage once only. Reference Book: Star Wars Saga Edition Scum and Villainy You can fill your opponent with doubt by making a Persuasion check as a Standard Action against a single target that can hear and understand you within 12 squares of you. If your check result equals or exceeds the target's Will Defense, the target takes a -2 penalty to its base speed, and if the target takes a Standard Action, it must also spend its Swift Action. This penalty lasts until the end of the target's next turn. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["action-economy","defender","melee","mobility","positioning","ranged","scaling","scoundrel","skills","social","striker"]},"effects":[{"_id":"4eefbe8a-47cc-4cee-a02a-7c11b76bd6b5","name":"Disruptive","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.morale.bonuses_suppressed","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Disruptive"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.disruptive"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.91b335f8565b90ef"}}},{"_id":"fd5226c1b6e70312","name":"Walk the Line","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"Disruptive","benefit":"Enemies in line of sight take -2 to defenses until your next turn.","description":"Enemies in line of sight take -2 to all defenses until your next turn.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.disruptive"}],"_source":"canonical-csv"},"treeId":"67b59e020c1660eb","tags":["defender","feat-chain","scoundrel","talent-chain"]},"effects":[