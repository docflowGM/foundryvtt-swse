"sourceAuthority":"statblock","legalProfile":"heroic","legalState":"unchecked","importMode":"play","playReady":true,"statblockAuthority":true,"sourcePack":"heroic","normalizationVersion":1,"authority":{"hp":"statblock","defenses":"statblock","bab":"statblock","attacks":"statblock","skills":"statblock","damageThreshold":"statblock"}}},"items":[{"_id":"4ff9083e4c97ad69","name":"Felucian","type":"species","img":"icons/svg/mystery-man.svg","system":{"size":"medium","speed":6,"abilities":{},"skillBonuses":{},"special":"","languages":[],"source":"","description":"","tags":[]},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Felucian"}}},{"_id":"69091918c4d02852","name":"Armor Proficiency (light)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with light armor and do not take armor check penalties on attack rolls.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":85,"tags":["armor","defender","non-force","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No penalty on attacks and no <a class=\"mw-redirect\" href=\"/wiki/Armor_Check_Penalty\" title=\"Armor Check Penalty\">Armor Check Penalty</a> while wearing <a href=\"/wiki/Light_Armor\" title=\"Light Armor\">Light Armor</a>."}},"effects":[{"_id":"9781a3c7-4e7e-4af0-9dcc-cdea0524b414","name":"Armor Proficiency (Light)","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.armorProficiency.light","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Armor Proficiency (Light)","effectType":"armor_proficiency"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.773ec00effc7e96f"}}},{"_id":"90b2077cd8217e70","name":"Bantha Rush","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","bene