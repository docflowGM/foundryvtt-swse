lue":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"9ad8b020e0551184","name":"Skill Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +5 bonus on all checks with the selected skill.","prerequisite":"Trained in the chosen skill","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","noble","non-force","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"863991773bb8d4b1","name":"Weapon Finesse","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may use your Dexterity modifier instead of Strength for attack rolls with light melee weapons.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","melee","non-force","scoundrel","scout"],"bonus_feat_for":["Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Use <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> modifier instead of <a href=\"/wiki/Strength\" title=\"Strength\">Strength</a> modifier on attack rolls with Light Melee Weapons and <a href=\"/wiki/Lightsabers\" title=\"Lightsabers\">Lightsabers</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.252b67d6e31c377e"}}},{"_id":"8a62cac85395c5f9","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"e38d20aec3906600","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"539e1f253c896ecd","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"6eb2e8b1aef162fa","name":"Hidden Movement","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Camouflage","prerequisites":"","benefit":"Improved Stealth Any situation that would give you Concealment grants you Total Concealment instead. Reference Book: Star Wars Saga Edition Galaxy at War When Prone, you can spend a Swift Action to gain Concealment until the start of your next turn. If you stand up or move, you lose this benefit. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Improved Stealth Once per encounter, when you are within 2 squares of Cover or Concealment, you can move to that Cover or Concealment and make a Stealth check to hide as a single Move Action. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Improved Stealth You excel at fighting from the shadows, hitting your opponents when they least expect it. You can use each of the following actions once per encounter as a Standard Action: Blinding Strike: Make a single melee or ranged attack against an opponent within Range. If you damage the target, you gain Total Concealment against that target until the beginning of your next turn. Confusing Strike: Make a single melee or ranged attack against an opponent within Range. If this opponent is denied its Dexterity bonus to its Reflex Defense, or if you have Concealment from this opponent, a successful attack also causes the opponent to be able to take only a Swift Action on its next turn. Unexpected Attack: Make a melee or ranged attack within your Range against an opponent from whom you have Concealment. You gain a +2 bonus on this attack roll if you have Concealment, or a +5 bonus if you have Total Concealment. Reference Book: Star Wars Saga Edition Galaxy at War When you would normally provoke an Attack of Opportunity by moving out of a Threatened Area, you can roll a Stealth check, replacing your Reflex Defense with the results of your Stealth check if it is higher.","description":"Improved Stealth Any situation that would give you Concealment grants you Total Concealment instead. Reference Book: Star Wars Saga Edition Galaxy at War When Prone, you can spend a Swift Action to gain Concealment until the start of your next turn. If you stand up or move, you lose this benefit. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Improved Stealth Once per encounter, when you are within 2 squares of Cover or Concealment, you can move to that Cover or Concealment and make a Stealth check to hide as a single Move Action. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Improved Stealth You excel at fighting from the shadows, hitting your opponents when they least expect it. You can use each of the following actions once per encounter as a Standard Action: Blinding Strike: Make a single melee or ranged attack against an opponent within Range. If you damage the target, you gain Total Concealment against that target until the beginning of your next turn. Confusing Strike: Make a single melee or ranged attack against an opponent within Range. If this opponent is denied its Dexterity bonus to its Reflex Defense, or if you have Concealment from this opponent, a successful attack also causes the opponent to be able to take only a Swift Action on its next turn. Unexpected Attack: Make a melee or ranged attack within your Range against an opponent from whom you have Concealment. You gain a +2 bonus on this attack roll if you have Concealment, or a +5 bonus if you have Total Concealment. Reference Book: Star Wars Saga Edition Galaxy at War When you would normally provoke an Attack of Opportunity by moving out of a Threatened Area, you can roll a Stealth check, replacing your Reflex Defense with the results of your Stealth check if it is higher.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Camouflage","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.improved_stealth"}],"_source":"canonical-csv"},"treeId":"3926d582d2077489","tags":["action-economy","battlefield-control","controller","defender","leader","melee","mobility","positioning","ranged","scaling","scout","skills","stealth","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hidden_movement"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d0dad96e182d63d4"}}},{"_id":"716d340e4d819f16","name":"Improved Stealth","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Camouflage","prerequisites":"","benefit":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scout","costNumeric":null,"category":"Scout","tree":"Camouflage","treeId":"3926d582d2077489","tags":["action-economy","ambush","controller","mobility","perception","piloting","positioning","ranged","scout","skills","stealth","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_stealth"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.073115894cad8cf9"}}},{"_id":"f7533bcd79817ca0","name":"Knack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fortune","prerequisites":"","benefit":"Once per day, you can reroll an attack roll and take the better result. You can select this Talent multiple times; each time you select this Talent, you can use it one additional time per day. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot You are possessed of incredible luck and an uncanny ability to succeed where others would fail. You can use each of the following actions once per encounter as a Standard Action: Elude Enemy: Make a single melee or ranged attack against any target within your Range. If you damage the target, you gain a +2 bonus to your Reflex Defense against this target until the beginning of your next turn. Escape: Make a single melee or ranged attack against any target within your Range. If that target successfully damages you before the start of your next turn, you can immediately move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Make your Own Luck: Make a single melee or ranged attack against any target within your Range. If you miss this target, you gain a +2 bonus on your next attack roll. Reference Book: Star Wars Saga Edition Scum and Villainy Once per encounter, as a Reaction, you become immune to all Mind-Affecting effects until the end of your next turn (you can choose to ignore this for beneficial effects). Any Mind-Affecting effects currently afflicting you are also removed, though you can choose to retain any beneficial effects you currently have. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisite: A successful hit against you is mitigated by an item you just happen to be wearing or carrying, or glances off your armor or clothing in just the right way. Once per encounter, as a Reaction, you can negate the damage from a single attack that would normally reduce you to 0 Hit Points. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot When making a ranged attack against a target with Cover, you can choose to reduce the benefit of that target's Cover by one step, from Improved Cover to Cover, or Cover to no Cover. You deal only half damage with this attack. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can consider any single d20 roll of 16 or higher to be a Natural 20. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can reroll the damage of one attack, keeping the better of the two results. Gambler's Fortune Talent data created by Sterling Hershey (source). Prerequisites: , Trained in Chosen Skill Select one of the following Skills: Knowledge (Any), Mechanics, Perception, or Use Computer. When making a reroll for that Skill, you may keep the better result.","description":"Once per day, you can reroll an attack roll and take the better result. You can select this Talent multiple times; each time you select this Talent, you can use it one additional time per day. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot You are possessed of incredible luck and an uncanny ability to succeed where others would fail. You can use each of the following actions once per encounter as a Standard Action: Elude Enemy: Make a single melee or ranged attack against any target within your Range. If you damage the target, you gain a +2 bonus to your Reflex Defense against this target until the beginning of your next turn. Escape: Make a single melee or ranged attack against any target within your Range. If that target successfully damages you before the start of your next turn, you can immediately move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Make your Own Luck: Make a single melee or ranged attack against any target within your Range. If you miss this target, you gain a +2 bonus on your next attack roll. Reference Book: Star Wars Saga Edition Scum and Villainy Once per encounter, as a Reaction, you become immune to all Mind-Affecting effects until the end of your next turn (you can choose to ignore this for beneficial effects). Any Mind-Affecting effects currently afflicting you are also removed, though you can choose to retain any beneficial effects you currently have. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisite: A successful hit against you is mitigated by an item you just happen to be wearing or carrying, or glances off your armor or clothing in just the right way. Once per encounter, as a Reaction, you can negate the damage from a single attack that would normally reduce you to 0 Hit Points. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot When making a ranged attack against a target with Cover, you can choose to reduce the benefit of that target's Cover by one step, from Improved Cover to Cover, or Cover to no Cover. You deal only half damage with this attack. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can consider any single d20 roll of 16 or higher to be a Natural 20. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can reroll the damage of one attack, keeping the better of the two results. Gambler's Fortune Talent data created by Sterling Hershey (source). Prerequisites: , Trained in Chosen Skill Select one of the following Skills: Knowledge (Any), Mechanics, Perception, or Use Computer. When making a reroll for that Skill, you may keep the better result.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Fortune","treeId":"cee9b9398682b7d0","tags":["action-economy","armor","controller","damage-reduction","defender","mechanics","melee","mobility","perception","positioning","ranged","scaling","scoundrel","skills","slicing","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.knack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ac6baadb9d65ff7f"}}},{"_id":"8d25d63dcd890eda","name":"Skirmisher","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"When you move at least 2 squares before your attack and end your move in a different square from where you started, you gain a +1 bonus to all your Defenses until the start of your next turn. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Sneak Attack Whenever you would gain the benefit of the Talent and you successfully hit your opponent, you deal Sneak Attack damage in addition to the normal damage dealt by the attack. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"When you move at least 2 squares before your attack and end your move in a different square from where you started, you gain a +1 bonus to all your Defenses until the start of your next turn. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Sneak Attack Whenever you would gain the benefit of the Talent and you successfully hit your opponent, you deal Sneak Attack damage in addition to the normal damage dealt by the attack. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["controller","defender","mobility","positioning","precision","scoundrel","striker"]},"effects":[{"_id":"b27e05f0-9859-46a5-92ab-7f844073dc03","name":"Skirmisher","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Skirmisher"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.skirmisher"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7b23e0812d6a8985"}}},{"_id":"306f19f355b15b27","name":"Sneak Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["action-economy","battlefield-control","controller","defender","melee","mobility","positioning","precision","ranged","scaling","scoundrel","skills","social","striker"]},"effects":[{"_id":"3195415b-2276-403c-9fb1-5d323d38d31a","name":"Sneak Attack","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.flatfooted","mode":2,"value":"1d6"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Sneak Attack"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.sneak_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.1505abc8babeeb84"}}},{"_id":"9155cde09ead82a4","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+4","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":8,"flatDamageFormula":"1d4+4","useFlat":true}}}},{"_id":"1dc975f4ce8805b6","name":"Vibroblade","type":"weapon","img":"icons/svg/sword.svg","system":{"