red Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"6fcdac944359e9ec","name":"Blast Back","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Unpredictable","prerequisites":"","benefit":"Once per encounter when you miss a target with a single melee or ranged attack, as a Free Action you can move up to half your speed and make a second attack of the same type against a different target. This movement doesn't provoke Attacks of Opportunity. If you have the Combat Reflexes feat, you may use this Talent a number of times per encounter equal to your Dexterity bonus (minimum 1). You may still only use this Talent once per round.","description":"Once per encounter when you miss a target with a single melee or ranged attack, as a Free Action you can move up to half your speed and make a second attack of the same type against a different target. This movement doesn't provoke Attacks of Opportunity. If you have the Combat Reflexes feat, you may use this Talent a number of times per encounter equal to your Dexterity bonus (minimum 1). You may still only use this Talent once per round.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Unpredictable","treeId":"5a30489609182e8c","tags":["action-economy","controller","melee","mobility","positioning","ranged","scout","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.blast_back"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.2d486ece7350cedf"}}},{"_id":"9fb029e308048dde","name":"Hailfire","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Pistoleer","prerequisites":"Dual Weapon Mastery I","benefit":"With two pistols, attack as if autofire even without autofire, applying autofire penalties.","description":"When wielding two pistols, you may attack as if using autofire; autofire penalties apply.","class":"Gunslinger","costNumeric":null,"category":"Gunslinger","tree":"Pistoleer","treeId":"ed77ab2e234089ed","tags":["burst-damage","feat-chain","ranged","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hailfire"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.223ba62ffbabb9c2"}}},{"_id":"d6fc8f78c2d8bc25","name":"Improved Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Armor Specialist","prerequisites":"Armored Defense","benefit":"Your Reflex Defense bonus equals either your heroic level + half your armor bonus, or your armor bonus.","description":"Your Reflex Defense bonus equals either your heroic level plus half your armor bonus or your armor bonus.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Armor Specialist","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.armored_defense"}],"_source":"canonical-csv"},"treeId":"17cec542331cb4e4","tags":["armor","defender","feat-chain","soldier","striker","talent-chain"]},"effects":[{"_id":"842ee02b-8f7e-4a40-802a-c6fe553379a5","name":"Improved Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Improved Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.394809ed8baff1b9"}}},{"_id":"b91c510e148e73dd","name":"Second Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Unpredictable","prerequisites":"Blast Back","benefit":"Once per encounter, when you miss, move half your speed and attack another target without provoking attacks of opportunity; with Combat Reflexes, uses equal to Dex bonus (max once per round).","description":"Once per encounter, when you miss, move half your speed and attack another target.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Unpredictable","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.blast_back"}],"_source":"canonical-csv"},"treeId":"5a30489609182e8c","tags":["controller","feat-chain","mobility","scout","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"s