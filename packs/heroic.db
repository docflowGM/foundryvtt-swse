vehicle is hit in combat, you may make a Pilot check to negate the hit.","prerequisite":"Pilot 1 rank","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","scout","striker","sustained-damage"],"bonus_feat_for":["Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Negate one attack per round against the <a class=\"mw-redirect\" href=\"/wiki/Vehicle\" title=\"Vehicle\">Vehicle</a> you're piloting."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"b8dad0c963f046c6"}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1f2f70d34a17667d"}}},{"_id":"d3a0f7c70d218313","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"162978584073dc80","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"31dc7a7e51aab3a2","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"c5cfed67784e4890","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"9d32332da9fdab03","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"0c7c563feb954866","name":"Born Leader","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Naval Officer","prerequisites":"","benefit":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","description":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","class":"Noble","costNumeric":null,"category":"Noble","tree":"Naval Officer","treeId":"057a978a7dc1d5a7","tags":["armor","defender","noble","striker","support","sustained-damage"]},"effects":[{"_id":"f9275c38-3cb5-4ab3-aaa5-25e5722dcdd3","name":"Born Leader","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.will","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Born Leader"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.born_leader"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.6a66ba6e0834dd6f"}}},{"_id":"1c4fb443072e9e4b","name":"Demand Surrender","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Consular","prerequisites":"Farseeing","benefit":"Once per turn as a Swift Action, you can remove one ongoing Mind-Affecting effect (such as the effects of or Weaken Resolve Talents, or the effect of being moved to the end of the Condition Track by the Adept Negotiator Talent, or the ongoing effects of the Mind Trick Force Power) from a single allied target within line of sight. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide When you use Farseeing, or a Force Power or Talent that has Farseeing as a prerequisite, other Force-users with Farseeing in their Force Power Suite can Aid Another on your Use the Force check as a Reaction, if they are within 6 squares of you. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Once per round as a Swift Action, you grant one ally within 12 squares of you (and within your line of sight) Bonus Hit Points equal to 5 + your Charisma modifier. These Bonus Hit Points last until the beginning of your next turn (at which point any remaining Bonus Hit Points are lost), and any damage dealt to that ally comes out of Bonus Hit Points first. You take a -5 penalty on all Use the Force checks until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide","description":"Once per turn as a Swift Action, you can remove one ongoing Mind-Affecting effect (such as the effects of or Weaken Resolve Talents, or the effect of being moved to the end of the Condition Track by the Adept Negotiator Talent, or the ongoing effects of the Mind Trick Force Power) from a single allied target within line of sight. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide When you use Farseeing, or a Force Power or Talent that has Farseeing as a prerequisite, other Force-users with Farseeing in their Force Power Suite can Aid Another on your Use the Force check as a Reaction, if they are within 6 squares of you. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Once per round as a Swift Action, you grant one ally within 12 squares of you (and within your line of sight) Bonus Hit Points equal to 5 + your Charisma modifier. These Bonus Hit Points last until the beginning of your next turn (at which point any remaining Bonus Hit Points are lost), and any damage dealt to that ally comes out of Bonus Hit Points first. You take a -5 penalty on all Use the Force checks until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide","class":"Noble","costNumeric":null,"category":"Noble","tree":"Jedi Consular","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.presence"}],"_source":"canonical-csv"},"treeId":"e99cfa9db8493573","tags":["action-economy","condition-removal","controller","feat-chain","force","force-control","force-offense","leader","light-side","mobility","noble","positioning","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.demand_surrender"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.871638a983029bc4"}}},{"_id":"666034d8e72db40e","name":"Deployment Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Military Tactics","prerequisites":"","benefit":"You know how to use existing terrain to your best advantage. By using a Move Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, you and all allies within 10 squares of you can use whatever Cover is available to gain a +10 Cover bonus to Reflex Defense (instead of the normal +5 Cover bonus). Allies must be able to hear and understand you to gain this benefit, and the bonus lasts until the start of your next turn. This Talent provides no benefit to anyone who doesn't have Cover. This is a Mind-Affecting effect. Prerequisite: As a Reaction, you can choose to take one-half or all of the damage dealt to an adjacent ally by a single attack. Similarly, as a Reaction, an adjacent ally can choose to take one-half or all of the damage dealt to you by a single attack (even if they don't have this Talent). Prerequisites: , Field Tactics An Officer learns to counter the tactics of their enemies. As a Standard Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, opponents in your line of sight lose all competence, insight, and morale bonuses on attack rolls, as well as any dodge bonuses to Reflex Defense, until the start of your next turn. If one or more enemy Officers are within your line of sight, the highest level Officer among them can attempt to Oppose your Knowledge (Tactics) check as a Reaction. If their Skill Check result is higher than yours, your attempt to Outmaneuver your opponents fails. As a Swift Action, you can take a -2 penalty to one Defense (Reflex, Fortitude, or Will) to gain a +1 competence bonus to another Defense until the start of your next turn.","description":"You know how to use existing terrain to your best advantage. By using a Move Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, you and all allies within 10 squares of you can use whatever Cover is available to gain a +10 Cover bonus to Reflex Defense (instead of the normal +5 Cover bonus). Allies must be able to hear and understand you to gain this benefit, and the bonus lasts until the start of your next turn. This Talent provides no benefit to anyone who doesn't have Cover. This is a Mind-Affecting effect. Prerequisite: As a Reaction, you can choose to take one-half or all of the damage dealt to an adjacent ally by a single attack. Similarly, as a Reaction, an adjacent ally can choose to take one-half or all of the damage dealt to you by a single attack (even if they don't have this Talent). Prerequisites: , Field Tactics An Officer learns to counter the tactics of their enemies. As a Standard Action, you can make a DC 15 Knowledge (Tactics) check. If the check succeeds, opponents in your line of sight lose all competence, insight, and morale bonuses on attack rolls, as well as any dodge bonuses to Reflex Defense, until the start of your next turn. If one or more enemy Officers are within your line of sight, the highest level Officer among them can attempt to Oppose your Knowledge (Tactics) check as a Reaction. If their Skill Check result is higher than yours, your attempt to Outmaneuver your opponents fails. As a Swift Action, you can take a -2 penalty to one Defense (Reflex, Fortitude, or Will) to gain a +1 competence bonus to another Defense until the start of your next turn.","class":"Officer","costNumeric":null,"category":"Officer","tree":"Military Tactics","treeId":"9253ace716c3e966","tags":["action-economy","controller","defender","evasion","leader","mobility","positioning","scout","skills","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deployment_tactics"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8a5f8b5c9b9fabaf"}}},{"_id":"90c9914352dcfa6a","name":"Distant Command","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Leadership","prerequisites":"Born Leader","benefit":"You do not lose Born Leader’s benefits if out of line of sight.","description":"Born Leader remains active even when allies are not in line of sight.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Leadership","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.born_leader"}],"_source":"canonical-csv"},"treeId":"5964237d22681dc0","tags":["feat-chain","noble","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.distant_command"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.64fa257cd511314d"}}},{"_id":"a90c6ed49f18ad95","name":"Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Influence","prerequisites":"","benefit":"Once per encounter, you can make a Persuasion check as a Standard Action to demand surrender from an opponent who has been reduced to one-half or less of its hit points. If your check result equals or exceeds the target's Will Defense, it surrenders to you and your allies, drops any weapons it is holding, and takes no hostile actions. If the target is higher level than you, it gains a +5 bonus to its Will Defense. If you or any of your allies attack it, it no longer submits to your will and can act normally. You can only use this Talent against a particular target once per encounter. This is a Mind-Affecting effect. Prerequisites: , Weaken Resolve Prerequisite: Once per round, when you deal damage equal to or greater than the target's Damage Threshold, you can make a Persuasion check as a Free Action; if the result equals or exceeds the target's Will Defense, you fill the target with terror, causing it to flee from you at top speed for 1 minute. The target can't take Standard Actions, Swift Actions, or Full-Round Actions while fleeing, but the target stops fleeing and can act normally if it is wounded. As a Free Action or Reaction, the target can spend a Force Point (if it has not already spent one earlier in the round) to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your Character Level. This is a Mind-Affecting fear effect. Unlike with other Mind-Affecting effects, you need only to hail a Vehicle to weaken the crew's resolve. When you deal damage that equals or exceeds a Vehicle's Damage Threshold, you may use this Talent; in addition, you may Ready an Action to use this Talent after any Gunner on your Vehicle deals damage that equals or exceeds a Vehicle's Damage Threshold. You make your check against the Vehicle's Commander; all Nonheroic crews are assumed to have a Will Defense of 10. The effect is automatically negated if the target Vehicle's Challenge Level is greater than your Heroic Level or your Vehicle's Challenge Level. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion You get under an opponent's skin. Once per encounter, make a Persuasion check to Intimidate one creature within line of sight as a Standard Action. On a success, instead of the normal effect of an Intimidate application of the Persuasion skill, the affected creature can take only a single Swift Action on its next turn. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion Once per encounter, as a Reaction, you can make a Persuasion check to Intimidate one creature that is making a melee or ranged attack against you, and is within your line of sight. If you succeed, you impose a -5 penalty to that attack roll. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"Once per encounter, you can make a Persuasion check as a Standard Action to demand surrender from an opponent who has been reduced to one-half or less of its hit points. If your check result equals or exceeds the target's Will Defense, it surrenders to you and your allies, drops any weapons it is holding, and takes no hostile actions. If the target is higher level than you, it gains a +5 bonus to its Will Defense. If you or any of your allies attack it, it no longer submits to your will and can act normally. You can only use this Talent against a particular target once per encounter. This is a Mind-Affecting effect. Prerequisites: , Weaken Resolve Prerequisite: Once per round, when you deal damage equal to or greater than the target's Damage Threshold, you can make a Persuasion check as a Free Action; if the result equals or exceeds the target's Will Defense, you fill the target with terror, causing it to flee from you at top speed for 1 minute. The target can't take Standard Actions, Swift Actions, or Full-Round Actions while fleeing, but the target stops fleeing and can act normally if it is wounded. As a Free Action or Reaction, the target can spend a Force Point (if it has not already spent one earlier in the round) to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your Character Level. This is a Mind-Affecting fear effect. Unlike with other Mind-Affecting effects, you need only to hail a Vehicle to weaken the crew's resolve. When you deal damage that equals or exceeds a Vehicle's Damage Threshold, you may use this Talent; in addition, you may Ready an Action to use this Talent after any Gunner on your Vehicle deals damage that equals or exceeds a Vehicle's Damage Threshold. You make your check against the Vehicle's Commander; all Nonheroic crews are assumed to have a Will Defense of 10. The effect is automatically negated if the target Vehicle's Challenge Level is greater than your Heroic Level or your Vehicle's Challenge Level. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion You get under an opponent's skin. Once per encounter, make a Persuasion check to Intimidate one creature within line of sight as a Standard Action. On a success, instead of the normal effect of an Intimidate application of the Persuasion skill, the affected creature can take only a single Swift Action on its next turn. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion Once per encounter, as a Reaction, you can make a Persuasion check to Intimidate one creature that is making a melee or ranged attack against you, and is within your line of sight. If you succeed, you impose a -5 penalty to that attack roll. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Influence","treeId":"8375b9b26b679901","tags":["action-economy","damage-reduction","defender","force","force-defense","force-offense","melee","mobility","noble","positioning","ranged","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.presence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ec8f2ba706cc2c05"}}},{"_id":"57552ce947f625de","name":"Rally","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Leadership","prerequisites":"","benefit":"Unlike other Mind-Affecting Talents, affects both allied Vehicles and characters with less than half their Hit Points. The Vehicle gains a +2 bonus to its Reflex Defense, all crewmembers gain a +2 bonus to their Will Defense so long as they are on board, and all Gunners gain a +2 bonus on damage with Weapon Systems (before multiplier, if any). Any crewmember who has less than half its Hit Points also gains the normal benefits of this Talent even if it leaves the Vehicle, but note that these bonuses do not stack.","description":"Unlike other Mind-Affecting Talents, affects both allied Vehicles and characters with less than half their Hit Points. The Vehicle gains a +2 bonus to its Reflex Defense, all crewmembers gain a +2 bonus to their Will Defense so long as they are on board, and all Gunners gain a +2 bonus on damage with Weapon Systems (before multiplier, if any). Any crewmember who has less than half its Hit Points also gains the normal benefits of this Talent even if it leaves the Vehicle, but note that these bonuses do not stack.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Leadership","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.distant_command"}],"_source":"canonical-csv"},"treeId":"5964237d22681dc0","tags":["defender","noble","scaling","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.rally"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.962c8a24f9caaba0"}}},{"_id":"f6784c0d1f71f4cb","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+6","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":10,"flatDamageFormula":"1d4+6","useFlat":true}}}},{"_id":"807cf343a46ea9b9","name":"Sporting Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d4+6","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":300,"equipped":true,"description":"<p>A civilian-grade blaster pistol designed for sport shooting and personal defense. Less powerful than military models but widely available.</p>","properties":["Civilian"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":300,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-sporting-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":11,"flatDamageFormula":"3d4+6","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Human","Nonheroic Level":0,"Class Levels":{"Noble":8,"Officer":4},"Destiny Points":0,"Force Points":2,"Dark Side Points":0,"Initiative":6,"Senses":"Perception +12","Languages":["Basic","Bocce","High Galactic","Huttese","Mon Calamarian","Shyriiwook (understand only)"],"Unassigned Languages":0,"Reflex Defense":25,"Flat-Footed Defense":25,"Fortitude Defense":25,"Will Defense":28,"Hit Points":84,"Damage Threshold":25,"Speed":"6 Squares","Melee Weapons":"Unarmed +10 (1d4+6)","Ranged Weapons":"Sporting Blaster Pistol +11 (3d4+6)","Base Attack Bonus":10,"Grapple":10,"Attack Options":[],"Special Actions":["Born Leader","Command Cover (+2)","Demand Surrender","Deployment Tactics","Presence","Rally","Share Talent ( Deployment Tactics","Presence )"],"Force Powers":[],"Force Secrets":[],"Force Techniques":[],"Strength":10,"Dexterity":10,"Constitution":14,"Intelligence":15,"Wisdom":13,"Charisma":16,"Talents":["Talents : Born Leader","Demand Surrender","Deployment Tactics","Distant Command","Presence","Rally"],"Feats":["Feats : Armor Proficiency (Light)","Armor Proficiency (Medium)","Improved Defenses","Linguist","Skill Focus (Knowledge (Tactics))","Skill Focus (Pilot)","Skill Focus (Use Computer)","Vehicular Combat","Weapon Focus (Pistols)","Weapon Proficiency (Advanced Melee Weapons)","Weapon Proficiency (Pistols)","Weapon Proficiency (Rifles)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Deception","Gather Information","Knowledge (Bureaucracy)","Knowledge (Galactic Lore)","Knowledge (Tactics)","Perception","Persuasion","Pilot","Treat Injury","Use Computer"],"Trained Skills":["Skills : Deception","Gather Information","Knowledge (Bureaucracy)","Knowledge (Galactic Lore)","Knowledge (Tactics)","Perception","Persuasion","Pilot","Treat Injury","Use Computer"],"Species Traits":[],"Gear":"Sporting Blaster Pistol , Uniform"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
