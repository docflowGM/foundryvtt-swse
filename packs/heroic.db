Bolster Ally, Clear Mind, Skilled Advisor, Force Focus</p>","derived":{},"npcProfile":{"kind":"heroic","mode":"play","sourceAuthority":"statblock","legalProfile":"heroic","legalState":"unchecked","importMode":"play","playReady":true,"statblockAuthority":true,"sourcePack":"heroic","normalizationVersion":1,"authority":{"hp":"statblock","defenses":"statblock","bab":"statblock","attacks":"statblock","skills":"statblock","damageThreshold":"statblock"}}},"items":[{"_id":"4988c5bf589d200d","name":"Bothan","type":"species","img":"icons/svg/mystery-man.svg","system":{"size":"Medium","speed":6,"abilities":"+2 Dex, -2 Con","skillBonuses":["+2 Stealth","+2 Perception"],"special":["Heightened Awareness: May reroll any Perception check, must keep the result of the reroll even if worse"],"languages":["Basic","Bothese"],"source":"Core","description":"","tags":[],"visionTraits":[],"naturalWeapons":[],"movementTraits":[],"environmentalTraits":[],"combatTraits":{"naturalArmor":0,"weaponProficiencies":[],"otherTraits":[]},"techTraits":[],"forceTraits":[],"socialTraits":[],"bonusFeats":0,"bonusTrainedSkills":0,"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.species.species-bothan"}}},{"_id":"af196ee780dbbb97","name":"Force Sensitivity","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"You can make Use the Force checks and gain access to Force Talents.","prerequisite":"Non-Droid","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["feat-chain","force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You can make <a href=\"/wiki/Use_the_Force\" title=\"Use the Force\">Use the Force</a> checks and gain access to <a href=\"/wiki/Force_Talents\" title=\"Force Talents\">Force Talents</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ddbeb23013d9e917"}}},{"_id":"105c4b71c0f4361e","name":"Force Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"You learn a number of Force powers equal to 1 + your Wisdom modifier.","prerequisite":"Force Sensitivity, Trained in Use the Force","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["feat-chain","force","jedi","striker"],"bonus_feat_for":["Jedi"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"forcePowerGrants":1,"description":{"value":"Learn a number of <a href=\"/wiki/Force_Powers\" title=\"Force Powers\">Force Powers</a> equal to 1 + your <a href=\"/wiki/Wisdom\" title=\"Wisdom\">Wisdom</a> modifier (minimum 1)."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"usetheforce"}],"_source":"canonical-csv"}},"effects":[{"_id":"d1c60a9b-78e6-4601-85a4-320794fa5a91","name":"Force Training","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Force Training","effectType":"passive_effect","flagType":"Force Training"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.9b7b869a86f39190"}}},{"_id":"83f0729df6a579ff","name":"Martial Arts I","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Increases damage from Unarmed attacks by one die step; gain +1 bonus to Reflex Defense.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["defender","non-force","striker","unarmed"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Increases damage from <a class=\"mw-redirect\" href=\"/wiki/Unarmed\" title=\"Unarmed\">Unarmed</a> attacks by one die step; gain +1 bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"R