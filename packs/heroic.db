/p>\n<p><strong>Senses:</strong> Darkvision, Perception +19</p>\n<p><strong>Attack Options:</strong> Point-Blank Shot</p>\n<p><strong>Special Actions:</strong> Battle Analysis, Born Leader, Command Cover (+2), Combined Fire, Coordinate (+1), Deployment Tactics, It's a Trap!, Share Talent ( Battle Analysis, Deployment Tactics )</p>","derived":{},"npcProfile":{"kind":"heroic","mode":"play","sourceAuthority":"statblock","legalProfile":"heroic","legalState":"unchecked","importMode":"play","playReady":true,"statblockAuthority":true,"sourcePack":"heroic","normalizationVersion":1,"authority":{"hp":"statblock","defenses":"statblock","bab":"statblock","attacks":"statblock","skills":"statblock","damageThreshold":"statblock"}}},"items":[{"_id":"2c10936137fb70fc","name":"Sullustan","type":"species","img":"icons/svg/mystery-man.svg","system":{"size":"Medium","speed":6,"abilities":"+2 Dex, -2 Con","skillBonuses":["+2 Initiative","+2 Perception"],"special":[],"languages":["Sullustese","Basic"],"source":"Core","description":"","tags":[],"visionTraits":[],"naturalWeapons":[],"movementTraits":[],"environmentalTraits":[],"combatTraits":{"naturalArmor":0,"weaponProficiencies":[],"otherTraits":[]},"techTraits":[],"forceTraits":[],"socialTraits":[],"bonusFeats":0,"bonusTrainedSkills":0,"costNumeric":null},"effects":[],"folder":null,"sort":1200,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.species.species-sullustan"}}},{"_id":"ed55718d50950129","name":"Armor Proficiency (light)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with light armor and do not take armor check penalties on attack rolls.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":85,"tags":["armor","defender","non-force","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No penalty on attacks an