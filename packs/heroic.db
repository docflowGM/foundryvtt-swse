name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"c0e5e03af61acbb0","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"1b019760c3ba84c4","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"bb7007c1f7b00a26","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"e97ee41a390b7236","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"51354ede764f95fe","name":"Brutal Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Gladiatorial Combat","prerequisites":"Exotic Weapon Proficiency (Any)","benefit":"(Chosen Weapon) When you deal damage to a target with a melee or ranged attack, compare the attack roll to the targets' Will Defense. If the attack roll also meets or exceeds the target's Will Defense, the target takes a -2 penalty to their Reflex Defense until the end of your next turn. You treat all Exotic Weapons as a single weapon group. If you already have Feats or Talents that grant you proficiency with, or augment the use of, one Exotic Weapon, those Feats now apply to all Exotic Weapons. For example, if you already had Exotic Weapon Proficiency (Shyarn), and Weapon Focus (Shyarn), you are now proficient with, and possess the Weapon Focus Feat for, all Exotic Weapons. When you hit a moving opponent that is one size category larger than you or smaller with an Attack of Opportunity, you immediately end its current movement.","description":"(Chosen Weapon) When you deal damage to a target with a melee or ranged attack, compare the attack roll to the targets' Will Defense. If the attack roll also meets or exceeds the target's Will Defense, the target takes a -2 penalty to their Reflex Defense until the end of your next turn. You treat all Exotic Weapons as a single weapon group. If you already have Feats or Talents that grant you proficiency with, or augment the use of, one Exotic Weapon, those Feats now apply to all Exotic Weapons. For example, if you already had Exotic Weapon Proficiency (Shyarn), and Weapon Focus (Shyarn), you are now proficient with, and possess the Weapon Focus Feat for, all Exotic Weapons. When you hit a moving opponent that is one size category larger than you or smaller with an Attack of Opportunity, you immediately end its current movement.","class":"Gladiator","costNumeric":null,"category":"Gladiator","tree":"Gladiatorial Combat","treeId":"12a2a02b0901605d","tags":["controller","defender","feat-chain","leader","melee","mobility","positioning","ranged","striker","talent-chain"]},"effects":[{"_id":"931a54c4-04db-4448-ac4f-8b57094c235a","name":"Brutal Attack","icon":"icons/svg/sword.svg","changes":[{"key":"system.damage.melee","mode":2,"value":"1d6"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Brutal Attack"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.brutal_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d9f47bfdde76475f"}}},{"_id":"9aa626a04461dad9","name":"Cantina Brawler","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Brawler","prerequisites":"","benefit":"During the Surprise Round, you and all allies within 6 squares of you gain a +1 morale bonus on attack rolls. Additionally, until the end of the encounter, you retain this bonus to attack rolls against any target you or your allies damage during the Surprise Round. Reference Book: Star Wars Saga Edition Galaxy of Intrigue You know how to use an opponent's strength against it. Whenever you successfully Grapple an opponent, you deal damage equal to the opponent's Strength modifier (minimum 1 point). Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide When you successfully Grab an opponent, they must use a Full-Round Action instead of a Standard Action to break the Grab. Reference Book: Star Wars Saga Edition Scum and Villainy When your melee attack damages an opponent that is denied its Dexterity bonus to its Reflex Defense, that opponent cannot take Attacks of Opportunity until the end of its next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","description":"During the Surprise Round, you and all allies within 6 squares of you gain a +1 morale bonus on attack rolls. Additionally, until the end of the encounter, you retain this bonus to attack rolls against any target you or your allies damage during the Surprise Round. Reference Book: Star Wars Saga Edition Galaxy of Intrigue You know how to use an opponent's strength against it. Whenever you successfully Grapple an opponent, you deal damage equal to the opponent's Strength modifier (minimum 1 point). Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide When you successfully Grab an opponent, they must use a Full-Round Action instead of a Standard Action to break the Grab. Reference Book: Star Wars Saga Edition Scum and Villainy When your melee attack damages an opponent that is denied its Dexterity bonus to its Reflex Defense, that opponent cannot take Attacks of Opportunity until the end of its next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Brawler","treeId":"67fdd8dce9abd6c1","tags":["action-economy","ambush","defender","leader","melee","positioning","soldier","striker","support","sustained-damage"]},"effects":[{"_id":"ae746f18-a3bb-4d9a-9d7c-b685d8b9a4e4","name":"Cantina Brawler","icon":"icons/svg/fist.svg","changes":[{"key":"system.attacks.unarmed","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Cantina Brawler"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.cantina_brawler"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.430b73348460715e"}}},{"_id":"53d076d90adedba9","name":"Dastardly Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","tree":"Misfortune","prerequisites":"Combat Reflexes","description":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","benefit":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","class":"","category":"","costNumeric":null,"treeId":"67b59e020c1660eb","tags":["condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","lightsaber","melee","mobility","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9e4345faaaa94dd8"}}},{"_id":"325cefd18c11ea04","name":"Expert Grappler","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Brawler","prerequisites":"","benefit":"You are skilled at keeping your opponents off balance in melee combat. At the beginning of your turn, you can choose to designate an opponent no more than one size category larger or smaller than you. That opponent doesn't get to add their Strength bonus on attack rolls when targeting you. (If the opponent has a Strength penalty, they still suffer from that penalty.) The opponent's Strength modifier applies to damage, as usual. You can select a new opponent on your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","description":"You are skilled at keeping your opponents off balance in melee combat. At the beginning of your turn, you can choose to designate an opponent no more than one size category larger or smaller than you. That opponent doesn't get to add their Strength bonus on attack rolls when targeting you. (If the opponent has a Strength penalty, they still suffer from that penalty.) The opponent's Strength modifier applies to damage, as usual. You can select a new opponent on your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Brawler","treeId":"67fdd8dce9abd6c1","tags":["melee","soldier","striker"]},"effects":[{"_id":"45edf98f-a153-47dc-ab62-44370f495321","name":"Expert Grappler","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.grapple.bonus","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Expert Grappler","effectType":"grapple_bonus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.expert_grappler"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.916a526d8c166005"}}},{"_id":"e05f62dff2cbef3f","name":"Melee Smash","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Specialist","prerequisites":"","benefit":"Unrelenting Assault You twirl your Weapon around you in a blur, creating a circle of death around you. Any enemy target that begins its turn adjacent to you takes damage equal to your Strength bonus. You must be wielding a Melee Weapon to be using this Talent.","description":"Unrelenting Assault You twirl your Weapon around you in a blur, creating a circle of death around you. Any enemy target that begins its turn adjacent to you takes damage equal to your Strength bonus. You must be wielding a Melee Weapon to be using this Talent.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Melee Specialist","treeId":"fad8118981c532f0","tags":["melee","positioning","soldier","striker","sustained-damage"]},"effects":[{"_id":"2d692811-5c22-48b8-944d-45db89ca5e77","name":"Melee Smash","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.melee","mode":5,"value":"half_level"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Melee Smash"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.melee_smash"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e0ee525f4109cfde"}}},{"_id":"8489fa88354439b6","name":"Unstoppable","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Gladiatorial Combat","prerequisites":null,"benefit":"Once per encounter, reduce an effect that would move you down the condition track by 1 step.","description":"Once per encounter, reduce by 1 step the amount you would move down the condition track from an attack.","class":"Gladiator","costNumeric":null,"category":"Gladiator","tree":"Gladiatorial Combat","treeId":"12a2a02b0901605d","tags":["condition-removal","controller","damage-reduction","mobility"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.unstoppable"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9c0c0966b7c7c30e"}}},{"_id":"a8439413b02f8311","name":"Vibroknucklers","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d8+11",