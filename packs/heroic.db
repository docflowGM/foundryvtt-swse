tsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":24,"flatDamageFormula":"2d8+17","useFlat":true}}}},{"_id":"9abf0aa02008ee43","name":"Lightsaber (with Double Attack)","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d8+17","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":24,"flatDamageFormula":"2d8+17","useFlat":true}}}},{"_id":"9d9b6a63e8d7ccdf","name":"Sith War Sword","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d8+15","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Sith War Sword","npc":{"flatAttackBonus":26,"flatDamageFormula":"1d8+15","useFlat":true}}}},{"_id":"94079638fe35ebb6","name":"Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d6+10","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":500,"equipped":true,"description":"<p>The standard sidearm used throughout the galaxy. Reliable, common, and effective at close to medium range.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":500,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":22,"flatDamageFormula":"3d6+10","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Human","Nonheroic Level":0,"Class Levels":{"Jedi":7,"Knight":5,"Apprentice":4,"Lord":4},"Destiny Points":2,"Force Points":8,"Dark Side Points":15,"Initiative":17,"Senses":"Perception +17","Languages":["Basic","Mando'a","Sith"],"Unassigned Languages":0,"Reflex Defense":35,"Flat-Footed Defense":33,"Fortitude Defense":38,"Will Defense":35,"Immune":"Fear effects","Hit Points":185,"Damage Threshold":38,"Speed":"6 Squares","Melee Weapons":"Lightsaber +27 (2d8+17), Lightsaber +24 (2d8+17) and Lightsaber +24 (2d8+17) with Double Attack, Sith War Sword +26 (1d8+15)","Ranged Weapons":"Blaster Pistol +22 (3d6+10)","Base Attack Bonus":20,"Grapple":25,"Attack Options":["Double Attack (Lightsabers)","Whirlwind Attack","Wicked Strike"],"Special Actions":["Dark Healing","Melee Defense","Republic Military Training","Temptation"],"Force Powers":["Battle Strike","Dark Rage","Force Grip","Force Lightning","Force Scream","Force Stun","Force Whirlwind","Rebuke ( Force Suppression )","Surge"],"Force Secrets":["Force Secrets : Devastating Power","Distant Power","Shaped Power"],"Force Techniques":["Force Techniques : Dominate Mind","Force Power Mastery ( Force Whirlwind )","Improved Force Stun","Improved Move Light Object"],"Strength":20,"Dexterity":14,"Constitution":16,"Intelligence":15,"Wisdom":15,"Charisma":20,"Talents":["Talents : Armored Defense","Block","Dark Healing","Dark Side Adept","Dark Side Master","Deflect","Force Suppression","Force Warning","Multiattack Proficiency (Lightsabers)","Weapon Specialization (Lightsabers)","Wicked Strike"],"Feats":["Feats : Armor Proficiency (Light)","Double Attack (Lightsabers)","Force Sensitivity","Force Training (3)","Melee Defense","Republic Military Training","Weapon Focus (Lightsabers)","Weapon Focus (Simple Weapons)","Weapon Proficiency (Lightsabers)","Weapon Proficiency (Pistols)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Endurance","Initiative","Knowledge (Tactics)","Perception","Use the Force"],"Trained Skills":["Skills : Endurance","Initiative","Knowledge (Tactics)","Perception","Use the Force"],"Species Traits":[],"Gear":"Darth Malak's Battle Armor (+6 Reflex , +2 Fortitude ), Lightsaber ( Self-Built ), Sith War Sword (As War Sword with Sith Alchemical Weapon Template )"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
