":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"f6b69a0e06897af3","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"95fd1db9129a6d43","name":"Improved Sense Force","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may use the Sense Force ability of the Use the Force Skill as a Move Action rather than a Full-Round Action.","prerequisite":"Sense Force","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may use the Sense Force ability of the Use the Force Skill as a Move Action rather than a Full-Round Action.</p><p><strong>Related Power:</strong> Sense Force</p><p><strong>Prerequisites:</strong> Sense Force</p>","relatedPower":"Sense Force"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.ad67b8f3959860f2"}}},{"_id":"521db08a83b31041","name":"Channel Aggression","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Dark Side Devotee","prerequisites":"","benefit":"You let your anger swell into a Rage. As a Swift Action, you may spend a Force Point to gain a +2 Rage bonus on melee attack rolls and melee damage rolls for a number of rounds equal to 5 + your Constitution modifier. At the end of this duration, you move -1 step along the Condition Track. While Raging, you cannot use Skills that require patience and concentration, such as Mechanics, Stealth, or Use the Force. Prerequisite: Whenever you score a Critical Hit, you may spend a Force Point to also reduce the target's Speed by half until they are fully healed (that is, restored to maximum Hit Points). Prerequisites: , Channel Anger Whenever you use a Force Power with the [Dark Side] descriptor, you may reroll your Use the Force check, but you must accept the result of the reroll, even if it is worse. Upon choosing this Talent, you can no longer use Force Powers with the [Light Side] descriptor. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual","description":"You let your anger swell into a Rage. As a Swift Action, you may spend a Force Point to gain a +2 Rage bonus on melee attack rolls and melee damage rolls for a number of rounds equal to 5 + your Constitution modifier. At the end of this duration, you move -1 step along the Condition Track. While Raging, you cannot use Skills that require patience and concentration, such as Mechanics, Stealth, or Use the Force. Prerequisite: Whenever you score a Critical Hit, you may spend a Force Point to also reduce the target's Speed by half until they are fully healed (that is, restored to maximum Hit Points). Prerequisites: , Channel Anger Whenever you use a Force Power with the [Dark Side] descriptor, you may reroll your Use the Force check, but you must accept the result of the reroll, even if it is worse. Upon choosing this Talent, you can no longer use Force Powers with the [Light Side] descriptor. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual","class":"Force Adept","costNumeric":null,"category":"Force Adept","tree":"Dark Side Devotee","treeId":"96ef43a3054dcb58","tags":["action-economy","condition-removal","controller","damage-reduction","dark-side","force","force-control","force-offense","force-support","light-side","mechanics","medicine","melee","mobility","precision","skills","stealth","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.channel_aggression"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ef3ec55015c60bda"}}},{"_id":"f61b384ec13c3704","name":"Channel Anger","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Dark Side Devotee","prerequisites":"Channel Aggression","benefit":"Gain +2 melee attack and damage for a number of rounds equal to 5 + Constitution modifier, then move down one step on the condition track.","description":"Gain +2 melee attack and damage for a number of rounds equal to 5 + Constitution modifier, then move –1 down the condition track.","class":"Force Adept","costNumeric":null,"category":"Force Adept","tree":"Dark Side Devotee","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.channel_aggression"}],"_source":"canonical-csv"},"treeId":"96ef43a3054dcb58","tags":["condition-removal","controller","feat-chain","melee","mobility","striker","sustained-damage","talent-chain"]},"effects":[{"_id":"c7e68fc9-d1bc-484b-a797-a04a539232fe","name":"Channel Anger","icon":"icons/svg/fire.svg","changes":[{"key":"system.attacks.melee","mode":2,"value":"2"},{"key":"system.damage.melee","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Channel Anger"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.channel_anger"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.37ee909a7de54768"}}},{"_id":"9004a40558bb778f","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"a5a5ec57254b5a3f","name":"Elusive Target","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Guardian","prerequisites":null,"benefit":"If you are in a melee, ranged attacks against you take an additional -5 penalty (on top of the firing-into-melee penalty).","description":"Ranged attacks against you while in melee take an additional -5 penalty.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Guardian","treeId":"10c843cef8ce2798","tags":["force","force-offense","jedi","light-side","melee","positioning","ranged"]},"effects":[{"_id":"d82c4204-1b7d-41b9-b88a-062970ca8db9","name":"Elusive Target","icon":"icons/svg/wind.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"2","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Elusive Target"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.elusive_target"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a0ace6dcc1c67d48"}}},{"_id":"ecdf38786778b0ef","name":"Force Perception","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sense","prerequisites":"","benefit":"You may spend a Force Point to reroll an Initiative check, keeping the better of the two rolls. Additionally, if you roll a natural 20 on the Initiative check reroll, you immediately regain the Force Point spent to activate this talent. Prerequisite: By focusing on a specific creature in your line of sight, you can gauge how strong in The Force they are. This takes a Standard Action and requires a Use the Force check. If your check result meets or beats the target's Will Defense, you know whether or not they have the Force Sensitivity feat, you know how many Force Powers they know (but not which ones specifically), and you know how many Force Points they currently have. Prerequisites: , Farseeing See also: On the Force, Visions, and Discretion Whenever you use the Farseeing Force Power, you can spend a Force Point as a Swift Action to see into the target's past or future instead of the present. You declare how far into the target's past or future you wish to look, up to a maximum of 1 year per your Character Level. Any information gained about a target's future is subject to change, depending on whether steps are taken to alter that future. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide As a Standard Action, you can spend a Force Point to ignore all Concealment for 1 minute. Prerequisites: , Farseeing As a Swift Action, you can peer into the future in search of signs of danger, removing one use of the Farseeing Force Power from your active Force Power Suite (as though you had just activated the Force Power). Any time before the end of your next turn when you are the target of an attack or Force Power, you can force your attacker to reroll the attack roll (or Use the Force check) against you, keeping the second result. This counts as using the Farseeing Force Power against the attacker, but this Talent replaces the normal rules and effect of that Force Power. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisites: , Farseeing When you use the Farseeing Force Power, you can choose to target an object you hold instead of a character or creature. You can look into the targeted item's past, up to a maximum of 5 years per your Character Level. Any information gained about the object's past is based on the thoughts and emotions of the person holding or carrying the object at the time you perceive, which can skew the results of the vision. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to gain Low-Light Vision (see Visibility) for 1 minute or until the end of the encounter, whichever is longer. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Jedi Padawans Prerequisites: Once per encounter, you may spend a Force Point to gain a +1 insight bonus to your Reflex Defense and Will Defense for the remainder of the encounter, or until you are knocked unconscious.","description":"You may spend a Force Point to reroll an Initiative check, keeping the better of the two rolls. Additionally, if you roll a natural 20 on the Initiative check reroll, you immediately regain the Force Point spent to activate this talent. Prerequisite: By focusing on a specific creature in your line of sight, you can gauge how strong in The Force they are. This takes a Standard Action and requires a Use the Force check. If your check result meets or beats the target's Will Defense, you know whether or not they have the Force Sensitivity feat, you know how many Force Powers they know (but not which ones specifically), and you know how many Force Points they currently have. Prerequisites: , Farseeing See also: On the Force, Visions, and Discretion Whenever you use the Farseeing Force Power, you can spend a Force Point as a Swift Action to see into the target's past or future instead of the present. You declare how far into the target's past or future you wish to look, up to a maximum of 1 year per your Character Level. Any information gained about a target's future is subject to change, depending on whether steps are taken to alter that future. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide As a Standard Action, you can spend a Force Point to ignore all Concealment for 1 minute. Prerequisites: , Farseeing As a Swift Action, you can peer into the future in search of signs of danger, removing one use of the Farseeing Force Power from your active Force Power Suite (as though you had just activated the Force Power). Any time before the end of your next turn when you are the target of an attack or Force Power, you can force your attacker to reroll the attack roll (or Use the Force check) against you, keeping the second result. This counts as using the Farseeing Force Power against the attacker, but this Talent replaces the normal rules and effect of that Force Power. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisites: , Farseeing When you use the Farseeing Force Power, you can choose to target an object you hold instead of a character or creature. You can look into the targeted item's past, up to a maximum of 5 years per your Character Level. Any information gained about the object's past is based on the thoughts and emotions of the person holding or carrying the object at the time you perceive, which can skew the results of the vision. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to gain Low-Light Vision (see Visibility) for 1 minute or until the end of the encounter, whichever is longer. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Jedi Padawans Prerequisites: Once per encounter, you may spend a Force Point to gain a +1 insight bonus to your Reflex Defense and Will Defense for the remainder of the encounter, or until you are knocked unconscious.","costNumeric":null,"tree":"Sense","treeId":"d6b4331c0e31f7e3","tags":["action-economy","defender","force","force-defense","force-offense","light-side","mobility","scout","skills","stealth","striker","support"]},"effects":[{"name":"Force Perception (Trained)","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.skills.perception.trained","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Force Perception","effectType":"skill-trained"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_perception"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a358402a9fc26c02"}}},{"_id":"2287fa6cd77bfac3","name":"Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Influence","prerequisites":"","benefit":"Once per encounter, you can make a Persuasion check as a Standard Action to demand surrender from an opponent who has been reduced to one-half or less of its hit points. If your check result equals or exceeds the target's Will Defense, it surrenders to you and your allies, drops any weapons it is holding, and takes no hostile actions. If the target is higher level than you, it gains a +5 bonus to its Will Defense. If you or any of your allies attack it, it no longer submits to your will and can act normally. You can only use this Talent against a particular target once per encounter. This is a Mind-Affecting effect. Prerequisites: , Weaken Resolve Prerequisite: Once per round, when you deal damage equal to or greater than the target's Damage Threshold, you can make a Persuasion check as a Free Action; if the result equals or exceeds the target's Will Defense, you fill the target with terror, causing it to flee from you at top speed for 1 minute. The target can't take Standard Actions, Swift Actions, or Full-Round Actions while fleeing, but the target stops fleeing and can act normally if it is wounded. As a Free Action or Reaction, the target can spend a Force Point (if it has not already spent one earlier in the round) to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your Character Level. This is a Mind-Affecting fear effect. Unlike with other Mind-Affecting effects, you need only to hail a Vehicle to weaken the crew's resolve. When you deal damage that equals or exceeds a Vehicle's Damage Threshold, you may use this Talent; in addition, you may Ready an Action to use this Talent after any Gunner on your Vehicle deals damage that equals or exceeds a Vehicle's Damage Threshold. You make your check against the Vehicle's Commander; all Nonheroic crews are assumed to have a Will Defense of 10. The effect is automatically negated if the target Vehicle's Challenge Level is greater than your Heroic Level or your Vehicle's Challenge Level. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion You get under an opponent's skin. Once per encounter, make a Persuasion check to Intimidate one creature within line of sight as a Standard Action. On a success, instead of the normal effect of an Intimidate application of the Persuasion skill, the affected creature can take only a single Swift Action on its next turn. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion Once per encounter, as a Reaction, you can make a Persuasion check to Intimidate one creature that is making a melee or ranged attack against you, and is within your line of sight. If you succeed, you impose a -5 penalty to that attack roll. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"Once per encounter, you can make a Persuasion check as a Standard Action to demand surrender from an opponent who has been reduced to one-half or less of its hit points. If your check result equals or exceeds the target's Will Defense, it surrenders to you and your allies, drops any weapons it is holding, and takes no hostile actions. If the target is higher level than you, it gains a +5 bonus to its Will Defense. If you or any of your allies attack it, it no longer submits to your will and can act normally. You can only use this Talent against a particular target once per encounter. This is a Mind-Affecting effect. Prerequisites: , Weaken Resolve Prerequisite: Once per round, when you deal damage equal to or greater than the target's Damage Threshold, you can make a Persuasion check as a Free Action; if the result equals or exceeds the target's Will Defense, you fill the target with terror, causing it to flee from you at top speed for 1 minute. The target can't take Standard Actions, Swift Actions, or Full-Round Actions while fleeing, but the target stops fleeing and can act normally if it is wounded. As a Free Action or Reaction, the target can spend a Force Point (if it has not already spent one earlier in the round) to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your Character Level. This is a Mind-Affecting fear effect. Unlike with other Mind-Affecting effects, you need only to hail a Vehicle to weaken the crew's resolve. When you deal damage that equals or exceeds a Vehicle's Damage Threshold, you may use this Talent; in addition, you may Ready an Action to use this Talent after any Gunner on your Vehicle deals damage that equals or exceeds a Vehicle's Damage Threshold. You make your check against the Vehicle's Commander; all Nonheroic crews are assumed to have a Will Defense of 10. The effect is automatically negated if the target Vehicle's Challenge Level is greater than your Heroic Level or your Vehicle's Challenge Level. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion You get under an opponent's skin. Once per encounter, make a Persuasion check to Intimidate one creature within line of sight as a Standard Action. On a success, instead of the normal effect of an Intimidate application of the Persuasion skill, the affected creature can take only a single Swift Action on its next turn. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion Once per encounter, as a Reaction, you can make a Persuasion check to Intimidate one creature that is making a melee or ranged attack against you, and is within your line of sight. If you succeed, you impose a -5 penalty to that attack roll. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Influence","treeId":"8375b9b26b679901","tags":["action-economy","damage-reduction","defender","force","force-defense","force-offense","melee","mobility","noble","positioning","ranged","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.presence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ec8f2ba706cc2c05"}}},{"_id":"59683c3b59ee5200","name":"Resilience","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Guardian","prerequisites":"","benefit":"Trained in Endurance Once per encounter, when using the Talent or the Recover Action and you are at one-half your total Hit Points or less, you regain a number of Hit Points equal to your Character Level. Homebrew Reference Book: New Jedi Order Campaign Guide","description":"Trained in Endurance Once per encounter, when using the Talent or the Recover Action and you are at one-half your total Hit Points or less, you regain a number of Hit Points equal to your Character Level. Homebrew Reference Book: New Jedi Order Campaign Guide","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Guardian","treeId":"10c843cef8ce2798","tags":["action-economy","force","jedi","light-side","striker"]},"effects":[{"_id":"dc721d7f-cc15-4964-96ee-ebc3c688f55e","name":"Resilience","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.fortitude","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Resilience"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.resilience"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.0dde210ea6d197ef"}}},{"_id":"df3e9076a46ceb63","name":"Force Lightning","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":4,"discipline":"dark-side","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Instantaneous","effect":"<p>You unleash devastating arcs of Force Lightning from your fingertips. The target takes lightning damage based on your Use the Force check result.</p>","special":"<p>This is a Dark Side power. Using it gains you a Dark Side Point.</p>","descriptor":["Dark Side","Force Lightning"],"dcChart":[{"dc":15,"effect":"2d6 lightning damage","description":"Target takes 2d6 lightning damage"},{"dc":20,"effect":"4d6 lightning damage","description":"Target takes 4d6 lightning damage"},{"dc":25,"effect":"6d6 lightning damage + stun","description":"Target takes 6d6 lightning damage and is stunned for 1 round"},{"dc":30,"effect":"8d6 lightning damage + stun 1d4","description":"Target takes 8d6 lightning damage and is stunned for 1d4 rounds"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["attack","damage","dark-side","lightning"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.0a422b939edfad56"}}},{"_id":"7ee5df9b2b92dd2d","name":"Mind Trick","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telepathic","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 minute or until completed","effect":"<p>You influence a weak mind to believe what you tell them or follow a simple suggestion. The target must make a Will save (DC = your UTF check) or be affected.</p>","special":"<p>The suggestion must be reasonable and the target must be able to understand you.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["mind-control","suggestion","social"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.e6649f366d6c5737"}}},{"_id":"2543d0c4352994ec","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"a89738808b9d6ee7","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}},{"_id":"b790f2b517347787","name":"Vital Transfer","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":3,"discipline":"vital","useTheForce":15,"time":"Standard Action","range":"Touch","target":"One living creature","duration":"Instantaneous","effect":"<p>You channel the Force to heal injuries and restore vitality. The target recovers hit points based on your Use the Force check result.</p>","special":"<p>You cannot heal yourself with this power.</p>","descriptor":["Vital","Healing"],"dcChart":[{"dc":15,"effect":"2d6 healing","description":"Target heals 2d6 hit points"},{"dc":20,"effect":"4d6 healing","description":"Target heals 4d6 hit points"},{"dc":25,"effect":"6d6 healing + condition","description":"Target heals 6d6 hit points and removes one ongoing condition"},{"dc":30,"effect":"8d6 healing + all conditions","description":"Target heals 8d6 hit points and removes all ongoing conditions"}],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["healing","vital","support"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.00b65e47a4dd7d76"}}},{"_id":"6c8542cab175626a","name":"Lightsaber","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d8+6","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":12,"flatDamageFormula":"2d8+6","useFlat":true}}}},{"_id":"a10ac72186d39379","name":"Lightsaber","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d8+6","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":7,"flatDamageFormula":"2d8+6","useFlat":true}}}},{"_id":"386103a87a0d48cd","name":"Lightsaber (with Double Attack)","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d8+6","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"mel