e","ability":"int","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.3a847230d573a623"}}},{"_id":"9342aa6823c0311b","name":"Strong in the Force","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"Roll d8s instead of d6s when you spend a Force Point.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Roll d8s instead of d6s when you spend a <a class=\"mw-redirect\" href=\"/wiki/Force_Point\" title=\"Force Point\">Force Point</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.71892687abbed346"}}},{"_id":"6037c15139d2c257","name":"Weapon Finesse","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may use your Dexterity modifier instead of Strength for attack rolls with light melee weapons.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","melee","non-force","scoundrel","scout"],"bonus_feat_for":["Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Use <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> modifier instead of <a href=\"/wiki/Strength\" title=\"Strength\">Strength</a> modifier on attack rolls with Light Melee Weapons and <a href=\"/wiki/Lightsabers\" title=\"Lightsabers\">Lightsabers</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.252b67d6e31c377e"}}},{"_id":"d957879d836c9486","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"8503aa0fa75ff71c","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"ef6ba1777a356254","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"e8151926d70abcc5","name":"Force Power Mastery","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"Choose a single Force Power. You may Take 10 on Use the Force checks to activate this Force Power even when distracted or threatened.","prerequisite":"","special":"You may select this Force Technique multiple times; each time you select this Force Technique, it applies to a different Force Power.","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>Choose a single Force Power. You may Take 10 on Use the Force checks to activate this Force Power even when distracted or threatened.</p><p><strong>Special:</strong> You may select this Force Technique multiple times; each time you select this Force Technique, it applies to a different Force Power.</p>","relatedPower":""},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.07cea7e3e8b21d69"}}},{"_id":"4878615611fd0969","name":"Improved Force Trance","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"Each hour you remain in a Force Trance, you regain a number of Hit Points equal to 2 x your Character Level.","prerequisite":"Force Trance","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>Each hour you remain in a Force Trance, you regain a number of Hit Points equal to 2 x your Character Level.</p><p><strong>Related Power:</strong> Force Trance</p><p><strong>Prerequisites:</strong> Force Trance</p>","relatedPower":"Force Trance"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.93b96db5b560e14a"}}},{"_id":"2a794680fa0ee00c","name":"Improved Sense Surroundings","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may use the Sense Surroundings application of the Use the Force Skill as a Free Action rather than a Swift Action.","prerequisite":"Sense Surroundings","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may use the Sense Surroundings application of the Use the Force Skill as a Free Action rather than a Swift Action.</p><p><strong>Related Power:</strong> Sense Surroundings</p><p><strong>Prerequisites:</strong> Sense Surroundings</p>","relatedPower":"Sense Surroundings"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.4955b5076ca5da89"}}},{"_id":"f48d202cdbb68ec0","name":"Acrobatic Recovery","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"You may Take 10 on Acrobatics checks to Tumble, even when distracted or threatened. Additionally, each threatened or occupied square that you Tumble through only counts as 1 square of movement.","description":"You may Take 10 on Acrobatics checks to Tumble, even when distracted or threatened. Additionally, each threatened or occupied square that you Tumble through only counts as 1 square of movement.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["controller","jedi","lightsaber","melee","mobility","positioning","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.acrobatic_recovery"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5d4a63123e5a5eb4"}}},{"_id":"316b5ac229a7a1d8","name":"Block","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith Alchemy","prerequisites":"","benefit":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","description":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Sith Alchemy","treeId":"a67faf2ae089ab5d","tags":["action-economy","armor","dark-side","defender","force","force-offense","jedi","lightsaber","melee","mobility","ranged","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.block"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9379daa94a228c04"}}},{"_id":"b742963677a5990b","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"de8c4984f61dfd1c","name":"Force Perception","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sense","prerequisites":"","benefit":"You may spend a Force Point to reroll an Initiative check, keeping the better of the two rolls. Additionally, if you roll a natural 20 on the Initiative check reroll, you immediately regain the Force Point spent to activate this talent. Prerequisite: By focusing on a specific creature in your line of sight, you can gauge how strong in The Force they are. This takes a Standard Action and requires a Use the Force check. If your check result meets or beats the target's Will Defense, you know whether or not they have the Force Sensitivity feat, you know how many Force Powers they know (but not which ones specifically), and you know how many Force Points they currently have. Prerequisites: , Farseeing See also: On the Force, Visions, and Discretion Whenever you use the Farseeing Force Power, you can spend a Force Point as a Swift Action to see into the target's past or future instead of the present. You declare how far into the target's past or future you wish to look, up to a maximum of 1 year per your Character Level. Any information gained about a target's future is subject to change, depending on whether steps are taken to alter that future. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide As a Standard Action, you can spend a Force Point to ignore all Concealment for 1 minute. Prerequisites: , Farseeing As a Swift Action, you can peer into the future in search of signs of danger, removing one use of the Farseeing Force Power from your active Force Power Suite (as though you had just activated the Force Power). Any time before the end of your next turn when you are the target of an attack or Force Power, you can force your attacker to reroll the attack roll (or Use the Force check) against you, keeping the second result. This counts as using the Farseeing Force Power against the attacker, but this Talent replaces the normal rules and effect of that Force Power. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisites: , Farseeing When you use the Farseeing Force Power, you can choose to target an object you hold instead of a character or creature. You can look into the targeted item's past, up to a maximum of 5 years per your Character Level. Any information gained about the object's past is based on the thoughts and emotions of the person holding or carrying the object at the time you perceive, which can skew the results of the vision. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to gain Low-Light Vision (see Visibility) for 1 minute or until the end of the encounter, whichever is longer. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Jedi Padawans Prerequisites: Once per encounter, you may spend a Force Point to gain a +1 insight bonus to your Reflex Defense and Will Defense for the remainder of the encounter, or until you are knocked unconscious.","description":"You may spend a Force Point to reroll an Initiative check, keeping the better of the two rolls. Additionally, if you roll a natural 20 on the Initiative check reroll, you immediately regain the Force Point spent to activate this talent. Prerequisite: By focusing on a specific creature in your line of sight, you can gauge how strong in The Force they are. This takes a Standard Action and requires a Use the Force check. If your check result meets or beats the target's Will Defense, you know whether or not they have the Force Sensitivity feat, you know how many Force Powers they know (but not which ones specifically), and you know how many Force Points they currently have. Prerequisites: , Farseeing See also: On the Force, Visions, and Discretion Whenever you use the Farseeing Force Power, you can spend a Force Point as a Swift Action to see into the target's past or future instead of the present. You declare how far into the target's past or future you wish to look, up to a maximum of 1 year per your Character Level. Any information gained about a target's future is subject to change, depending on whether steps are taken to alter that future. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide As a Standard Action, you can spend a Force Point to ignore all Concealment for 1 minute. Prerequisites: , Farseeing As a Swift Action, you can peer into the future in search of signs of danger, removing one use of the Farseeing Force Power from your active Force Power Suite (as though you had just activated the Force Power). Any time before the end of your next turn when you are the target of an attack or Force Power, you can force your attacker to reroll the attack roll (or Use the Force check) against you, keeping the second result. This counts as using the Farseeing Force Power against the attacker, but this Talent replaces the normal rules and effect of that Force Power. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisites: , Farseeing When you use the Farseeing Force Power, you can choose to target an object you hold instead of a character or creature. You can look into the targeted item's past, up to a maximum of 5 years per your Character Level. Any information gained about the object's past is based on the thoughts and emotions of the person holding or carrying the object at the time you perceive, which can skew the results of the vision. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to gain Low-Light Vision (see Visibility) for 1 minute or until the end of the encounter, whichever is longer. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Jedi Padawans Prerequisites: Once per encounter, you may spend a Force Point to gain a +1 insight bonus to your Reflex Defense and Will Defense for the remainder of the encounter, or until you are knocked unconscious.","costNumeric":null,"tree":"Sense","treeId":"d6b4331c0e31f7e3","tags":["action-economy","defender","force","force-defense","force-offense","light-side","mobility","scout","skills","stealth","striker","support"]},"effects":[{"name":"Force Perception (Trained)","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.skills.perception.trained","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Force Perception","effectType":"skill-trained"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_perception"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a358402a9fc26c02"}}},{"_id":"15d184d2d24a4311","name":"Juyo","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"Prerequisites: Double Attack (Lightsabers), Skill Focus (Use the Force), Base Attack Bonus +12","benefit":"Weapon Focus (Lightsabers), Weapon Specialization (Lightsabers), Base Attack Bonus +12 When attacking with a Lightsaber, you score a critical hit on a natural roll of 19 or 20. However, a natural 19 is not considered an automatic hit; if you roll a natural 19 and still miss the target, you do not score a critical hit. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - The Dark Side You may make a Deception check as a Swift Action (instead of a Standard Action) when attempting to Feint in combat. Maho-Kai Lightsaber Form Talent created by Wikia user SirenEyes. Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you may choose to forgo an attack and instead activate a Force Power that requires a Standard Action or Move Action to activate. When activating a Force Power in this manner, apply the attack roll penalty to the Use the Force check to activate the Force Power. You may only activate one Force Power in this manner each Round. Tripzest Lightsaber Form Talent created by Wikia user Droidscotty.","description":"Weapon Focus (Lightsabers), Weapon Specialization (Lightsabers), Base Attack Bonus +12 When attacking with a Lightsaber, you score a critical hit on a natural roll of 19 or 20. However, a natural 19 is not considered an automatic hit; if you roll a natural 19 and still miss the target, you do not score a critical hit. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - The Dark Side You may make a Deception check as a Swift Action (instead of a Standard Action) when attempting to Feint in combat. Maho-Kai Lightsaber Form Talent created by Wikia user SirenEyes. Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you may choose to forgo an attack and instead activate a Force Power that requires a Standard Action or Move Action to activate. When activating a Force Power in this manner, apply the attack roll penalty to the Use the Force check to activate the Force Power. You may only activate one Force Power in this manner each Round. Tripzest Lightsaber Form Talent created by Wikia user Droidscotty.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["action-economy","burst-damage","controller","dark-side","feat-chain","force","force-control","force-offense","jedi","lightsaber","melee","mobility","precision","skills","social","striker","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.juyo"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5fd19be0deca1115"}}},{"_id":"86e5faf6dfa5f77c","name":"Lightsaber Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Niman When you use the Talent, you gain twice the normal deflection bonus to your Reflex Defense when you are wielding two Lightsabers. Prerequisite: When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Talent increases by 2 (to a maximum of +5). When wielding a Lightsaber, you gain a +1 bonus to your Reflex Defense and Will Defense.","description":"Niman When you use the Talent, you gain twice the normal deflection bonus to your Reflex Defense when you are wielding two Lightsabers. Prerequisite: When wielding a single Lightsaber in one hand, the deflection bonus you gain from the Talent increases by 2 (to a maximum of +5). When wielding a Lightsaber, you gain a +1 bonus to your Reflex Defense and Will Defense.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["defender","jedi","lightsaber","melee","striker"]},"effects":[{"_id":"fcdbf882-923a-4095-b0df-a1079c214099","name":"Lightsaber Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Lightsaber Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.lightsaber_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e8bf1222fd6289e4"}}},{"_id":"ad71dc129da2f7d9","name":"Redirect Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Whenever you redirect a deflected blaster bolt (see the Talent), you gain a +5 bonus on your ranged attack roll.","description":"Whenever you redirect a deflected blaster bolt (see the Talent), you gain a +5 bonus on your ranged attack roll.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.deflect"},{"type":"bab","min":5}],"_source":"canonical-csv"},"treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","positioning","ranged","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.redirect_shot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.941c1dfd00e697da"}}},{"_id":"e197b657990db2e3","name":"Soresu","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"Block, Deflect","benefit":"Reroll Use the Force checks for Block and Deflect.","description":"When using Block or Deflect, you may reroll your Use the Force check.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["feat-chain","force","jedi","lightsaber","melee","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.soresu"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.af8c6f9b6c06b448"}}},{"_id":"d77f4545d3837e31","name":"Battle Strike","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You channel the Force to enhance your next melee attack. Your next melee attack this round gains a +1d6 bonus to damage.</p>","special":"<p>This bonus damage is Force damage and bypasses Damage Reduction.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["enhancement","damage","melee"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f177dc6d65f76de9"}}},{"_id":"df9cbc720cb62223","name":"Sever Force","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":6,"discipline":"dark-side","useTheForce":30,"time":"1 minute","range":"Touch","target":"One Force-sensitive creature","duration":"Permanent","effect":"<p>You permanently sever a Force user's connection to the Force. The target loses all Force abilities permanen