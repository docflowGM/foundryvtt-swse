ions","description":"You can Catch a Second Wind as a Reaction, instead of as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide When you use the Aid Another Action to Suppress an Enemy, that enemy takes a -5 penalty on its next attack instead of the normal -2 penalty. Only 1 character may gain the benefits of this Talent against a given target at a time. Reference Book: Star Wars Saga Edition Unknown Regions","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Commando","treeId":"798ed0945cbdac1c","tags":["action-economy","mobility","soldier"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.tough_as_nails"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.916b0a6197bf85a6"}}},{"_id":"6e572050f96f0215","name":"Twin Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Pistoleer","prerequisites":"Dual Weapon Mastery I, Rapid Shot","benefit":"With two pistols and Rapid Shot, gain +2 damage.","description":"When using Rapid Shot with two pistols, gain +2 damage.","class":"Gunslinger","costNumeric":null,"category":"Gunslinger","tree":"Pistoleer","treeId":"ed77ab2e234089ed","tags":["feat-chain","ranged","striker","talent-chain"]},"effects":[{"_id":"a5143862-fe8e-4a7c-b1ca-77e1f59769e5","name":"Twin Shot","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.ranged","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Twin Shot"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.twin_shot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.c219dc05ccc7db81"}}},{"_id":"ee97fa81b54732f4","name":"Knife","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+10","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","curr