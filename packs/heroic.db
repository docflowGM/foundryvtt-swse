eapons":"S-5 Heavy Blaster Pistol +17 (3d8+5), S-5 Heavy Blaster Pistol +17 (1d2+5) plus Paralytic Poison, Naboo Royal Blaster +17 (3d6+5)","Base Attack Bonus":11,"Grapple":15,"Attack Options":["Far Shot","Point-Blank Shot","Precise Shot"],"Special Actions":["Battle Analysis","Command Cover (+1)","Deployment Tactics","Draw Fire","Harm's Way","Quick Draw","Share Talent ( Harm's Way )"],"Force Powers":[],"Force Secrets":[],"Force Techniques":[],"Strength":16,"Dexterity":18,"Constitution":14,"Intelligence":15,"Wisdom":14,"Charisma":13,"Talents":["Talents : Armored Defense","Battle Analysis","Deployment Tactics","Draw Fire","Greater Weapon Focus (Pistols)","Harm's Way"],"Feats":["Feats : Armor Proficiency (Light)","Armor Proficiency (Medium)","Far Shot","Martial Arts I","Point-Blank Shot","Precise Shot","Quick Draw","Weapon Focus (Pistols)","Weapon Proficiency (Advanced Melee Weapons)","Weapon Proficiency (Heavy Weapons)","Weapon Proficiency (Pistols)","Weapon Proficiency (Rifles)","Weapon Proficiency (Simple Weapons)"],"Skills":["Skills : Climb","Initiative","Knowledge (Tactics)","Mechanics","Perception","Pilot"],"Trained Skills":["Skills : Climb","Initiative","Knowledge (Tactics)","Mechanics","Perception","Pilot"],"Species Traits":[],"Gear":"Security Officer Uniform (As Blast Helmet and Vest (+2 Reflex )), Naboo Royal Blaster (As Blaster Pistol ), S-5 Heavy Blaster Pistol , Comlink (Short-Range, Encrypted)"},"mode":"play","sourcePack":"heroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1}}}}
{"_id":"9669fa7f8f77b1c0","name":"Hosk Trey'lis","type":"npc","img":"icons/svg/mystery-man.svg","system":{"isDroid":false,"droidDegree":"","attributes":{"str":{"base":12,"racial":0,"enhancement":0,"temp":0},"dex":{"base":13,"racial":0,"enhancement":0,"temp":0},"con":{"base":10,"racial":0,"enhancement":0,"temp":0},"int":{"base":14,"racial":0,"enhancement":0,"temp":0},"wis":{"base":15,"racial":0,"enhancement":0,"temp":0},"cha":{"base":14,"racial":0,"enhancement":0,"temp":0}},"skills":{"acrobatics":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"dex","favorite":false},"climb":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"str","favorite":false},"deception":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"cha","favorite":false},"endurance":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"con","favorite":false},"gatherInformation":{"trained":true,"focused":true,"miscMod":0,"selectedAbility":"cha","favorite":false},"initiative":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"dex","favorite":false},"jump":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"str","favorite":false},"knowledgeBureaucracy":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeGalacticLore":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeLifeSciences":{"trained":true,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgePhysicalSciences":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeSocialSciences":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeTactics":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"knowledgeTechnology":{"trained":false,"focused":false,"miscMod":0,"selectedAbility":"int","favorite":false},"mechanics":{"trained":false,"focused":false,"