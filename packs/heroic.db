,"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"c7542d156ff99011","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"4d2bbe339048c574","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"4f8e97b4f6afe369","name":"Bolster Ally","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"Inspire Confidence Whenever you hit an opponent with a melee or ranged attack, you can (as a Free Action) choose to give one ally within your line of sight a bonus to damage on their next attack equal to their Character Level. Once their fervor has been ignited, the affected ally doesn't need to remain within line of sight of you; if their next attack misses, they lose the bonus to damage granted by this Talent. Prerequisites: , Inspire Confidence, Ignite Fervor Whenever an ally within line of sight of you makes an attack that moves an opponent down the Condition Track (such as dealing damage that equals of exceeds the target's Damage Threshold), that ally moves the target an additional -1 step down the Condition Track. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Inspire Confidence Your allies hold you in such esteem that when you are threatened or injured, you can impel them to action. You can use each of the following actions once per encounter: Guardian: Choose one ally as a Swift Action. As long as you remain within 6 squares of the ally, you gain a +2 bonus to your Reflex Defense until the start of your next turn. Reprisal: Make a single melee or ranged attack against any target within your Range as a Standard Action. If your attack roll succeeds and if that target attacks you before the end of your next turn, one ally within 6 squares can make an attack against that target as a Reaction. To Me!: Spend a Swift Action. Whenever you take any damage before the beginning of your next turn, each ally within line of sight can move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","description":"Inspire Confidence Whenever you hit an opponent with a melee or ranged attack, you can (as a Free Action) choose to give one ally within your line of sight a bonus to damage on their next attack equal to their Character Level. Once their fervor has been ignited, the affected ally doesn't need to remain within line of sight of you; if their next attack misses, they lose the bonus to damage granted by this Talent. Prerequisites: , Inspire Confidence, Ignite Fervor Whenever an ally within line of sight of you makes an attack that moves an opponent down the Condition Track (such as dealing damage that equals of exceeds the target's Damage Threshold), that ally moves the target an additional -1 step down the Condition Track. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Inspire Confidence Your allies hold you in such esteem that when you are threatened or injured, you can impel them to action. You can use each of the following actions once per encounter: Guardian: Choose one ally as a Swift Action. As long as you remain within 6 squares of the ally, you gain a +2 bonus to your Reflex Defense until the start of your next turn. Reprisal: Make a single melee or ranged attack against any target within your Range as a Standard Action. If your attack roll succeeds and if that target attacks you before the end of your next turn, one ally within 6 squares can make an attack against that target as a Reaction. To Me!: Spend a Swift Action. Whenever you take any damage before the beginning of your next turn, each ally within line of sight can move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","condition-removal","controller","defender","force","force-control","force-defense","force-offense","leader","melee","mobility","noble","positioning","ranged","striker","support"]},"effects":[{"_id":"c5626626-5e0d-4051-b4c2-928434aef891","name":"Bolster Ally","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.hp.regen","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Bolster Ally"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.bolster_ally"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d6e7f7178e643717"}}},{"_id":"dfd85b54d0911b8d","name":"Educated","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":"","benefit":"Sometimes you surprise others with your skill. Once per day, you may make an Untrained skill check as though you were Trained in the Skill. Exception: you cannot use this Talent to make an Untrained Use the Force check as though you were Trained in the skill, unless you have the Force Sensitivity feat. You can select this Talent multiple times; each time you do, you can use it one additional time per day. Each time you gain a level (including the level at which you select this Talent), you receive an amount of credits equal to 5,000 x your Class Level. You can spend these credits as you see fit. The credits appear in a civilized, accessible location of your choice or in your private bank account. Reference Book: Star Wars Saga Edition Starships of the Galaxy Prerequisites: , Trained in Knowledge (Technology) You are Trained in the Mechanics skill. Additionally, when installing new systems into a Vehicle, the efficiency of your designs reduces the time it takes to install the system by 25%. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisites: , Intelligence 13 Select a number of Skills equal to your Intelligence modifier that you are not Trained in. You may now use Trained-only applications of those Skills, and they are considered Class Skills. You are not considered Trained in those Skills for any other purposes, and must still satisfy any other requirements in order to use the skill. Homebrew Reference Book: Legacy of the Force Sourcebook Select one type of performance, such as acting, dancing, singing, or playing a musical instrument. You gain a +5 bonus on Persuasion checks to entertain for that type of performance. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Intelligence 13 You have the ability to acquire aid and information from a long list of people. You may reroll any Gather Information check, but the result of the reroll must be accepted, even if it is worse. Additionally, the DC for any Persuasion checks made to reduce the cost of Bribery is reduced by 5.","description":"Sometimes you surprise others with your skill. Once per day, you may make an Untrained skill check as though you were Trained in the Skill. Exception: you cannot use this Talent to make an Untrained Use the Force check as though you were Trained in the skill, unless you have the Force Sensitivity feat. You can select this Talent multiple times; each time you do, you can use it one additional time per day. Each time you gain a level (including the level at which you select this Talent), you receive an amount of credits equal to 5,000 x your Class Level. You can spend these credits as you see fit. The credits appear in a civilized, accessible location of your choice or in your private bank account. Reference Book: Star Wars Saga Edition Starships of the Galaxy Prerequisites: , Trained in Knowledge (Technology) You are Trained in the Mechanics skill. Additionally, when installing new systems into a Vehicle, the efficiency of your designs reduces the time it takes to install the system by 25%. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisites: , Intelligence 13 Select a number of Skills equal to your Intelligence modifier that you are not Trained in. You may now use Trained-only applications of those Skills, and they are considered Class Skills. You are not considered Trained in those Skills for any other purposes, and must still satisfy any other requirements in order to use the skill. Homebrew Reference Book: Legacy of the Force Sourcebook Select one type of performance, such as acting, dancing, singing, or playing a musical instrument. You gain a +5 bonus on Persuasion checks to entertain for that type of performance. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Intelligence 13 You have the ability to acquire aid and information from a long list of people. You may reroll any Gather Information check, but the result of the reroll must be accepted, even if it is worse. Additionally, the DC for any Persuasion checks made to reduce the cost of Bribery is reduced by 5.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","treeId":"b5bb4154688c66ab","tags":["ambush","damage-reduction","force","mechanics","noble","scaling","skills","social","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.educated"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.3e98c9f5a4f450ff"}}},{"_id":"816d08bc642589ad","name":"Ignite Fervor","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"You can't on yourself.","description":"You can't on yourself.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.bolster_ally"},{"type":"talent","id":"swse.talent.inspire_confidence"}],"_source":"canonical-csv"},"treeId":"72d32ebcbb607314","tags":["noble"]},"effects":[{"_id":"464d9fb0-db44-4d22-8e5b-a00df6ec0f8e","name":"Ignite Fervor","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.allies","mode":2,"value":"level"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Ignite Fervor"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.ignite_fervor"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.0703de963a247170"}}},{"_id":"d92a2d420cff0ed7","name":"Inspire Confidence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","description":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","controller","defender","leader","mobility","noble","striker","support"]},"effects":[{"_id":"1faa089c-9609-46d8-8543-9a68ace3553b","name":"Inspire Confidence","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Confidence"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_confidence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4d8882a28da30454"}}},{"_id":"e6e8e47ccd43756a","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+3","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":5,"flatDamageFormula":"1d4+3","useFlat":true}}}},{"_id":"9c2e3d38a4d53eb1","name":"Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d6+3","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":500,"equipped":true,"description":"<p>The standard sidearm used throughout the galaxy. Reliable, common, and effective at close to medium range.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":500,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compen