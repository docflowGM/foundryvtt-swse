our Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"a2582f7ee037f19f","name":"Armored Mandalorian","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mandalorian Warrior","prerequisites":"Dexterity 13, Mandalorian Glory","benefit":"Add your armor's Fortitude Defense bonus to Elite Trooper Damage Reduction; lightsabers that do not ignore DR still do not ignore this DR.","description":"Add your armor's Fortitude Defense bonus to your damage reduction; lightsabers that normally ignore DR do not ignore yours.","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Mandalorian Warrior","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13},{"type":"talent","id":"swse.talent.mandalorian_glory"}],"_source":"canonical-csv"},"treeId":"4b8857716e056f62","tags":["armor","damage-reduction","defender","feat-chain","lightsaber","melee","soldier","striker","talent-chain"]},"effects":[{"_id":"0841e981-1512-4f79-9ce3-9ad24a587a68","name":"Armored Mandalorian","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damageReduction","mode":5,"value":"armor_fortitude_bonus"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Mandalorian"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_mandalorian"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.c3b22fdc6ca5af8e"}}},{"_id":"2c1a8eb919ff5fb8","name":"Burning Assault","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Rocket Jumper","prerequisites":"Jet Pack Training","benefit":"Expend a charge to make an attack as a flamethrower; cannot use while flying.","description":"","class":"Soldier","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.jet_pack_training"}],"_source":"canonical-csv"},"treeId":"1f50c63b6f08de10","tree":"Rocket Jumper","tags":["feat-chain","heavy-weapons","mobility","ranged","soldier","talent-chain"]},"effects":[{"_id":"47df0bb1-0bd6-47eb-9040-0eed4f41eba3","name":"Burning Assault","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks.flamethrower","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Burning Assault"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.burning_assault"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.be617461ca46a5ad"}}},{"_id":"c2defb0058d9c239","name":"Expert Grappler","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Brawler","prerequisites":"","benefit":"You are skilled at keeping your opponents off balance in melee combat. At the beginning of your turn, you can choose to designate an opponent no more than one size category larger or smaller than you. That opponent doesn't get to add their Strength bonus on attack rolls when targeting you. (If the opponent has a Strength penalty, they still suffer from that penalty.) The opponent's Strength modifier applies to damage, as usual. You can select a new opponent on your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","description":"You are skilled at keeping your opponents off balance in melee combat. At the beginning of your turn, you can choose to designate an opponent no more than one size category larger or smaller than you. That opponent doesn't get to add their Strength bonus on attack rolls when targeting you. (If the opponent has a Strength penalty, they still suffer from that penalty.) The opponent's Strength modifier applies to damage, as usual. You can select a new opponent on your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Brawler","treeId":"67fdd8dce9abd6c1","tags":["melee","soldier","striker"]},"effects":[{"_id":"45edf98f-a153-47dc-ab62-44370f495321","name":"Expert Grappler","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.grapple.bonus","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Expert Grappler","effectType":"grapple_bonus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.expert_grappler"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.916a526d8c166005"}}},{"_id":"43568237bfcdcb6f","name":"Jet Pack Training","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Rocket Jumper","prerequisites":"","benefit":"As a Standard Action you can expend one of your Jet Pack's charges to make an attack with the Jet Pack, treating it as a Flamethrower. You cannot use this Talent when you are flying. You are considered proficient in the Flamethrower for purposes of making this attack. Prerequisite: You always use the proper trajectories to maximize the efficiency of your rocket-pack burn rates. You increase your fly Speed by 2 squares when using a Jet Pack. Prerequisite: Once per encounter, as a Reaction when an opponent moves adjacent to you, you can expend one charge of your Jet Pack to fly and Move your Speed, or Withdraw. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Clones Once per round (as a Reaction), when you are airborne with a Jet Pack or Rocket Pack, you may negate a successful attack by making a Pilot check. The DC of the check is equal to the result of the attack roll you wish to negate. In addition, when flying a Jet Pack, you are considered proficient with its integrated weapons. This includes any piece of equipment integrated to the Jet Pack, though it does not apply to equipment integrated into armor to which the Jet Pack might be mounted. If you have taken the Starship Tactics feat, you may activate Starship Maneuvers as appropriate while flying a Jet Pack.","description":"As a Standard Action you can expend one of your Jet Pack's charges to make an attack with the Jet Pack, treating it as a Flamethrower. You cannot use this Talent when you are flying. You are considered proficient in the Flamethrower for purposes of making this attack. Prerequisite: You always use the proper trajectories to maximize the efficiency of your rocket-pack burn rates. You increase your fly Speed by 2 squares when using a Jet Pack. Prerequisite: Once per encounter, as a Reaction when an opponent moves adjacent to you, you can expend one charge of your Jet Pack to fly and Move your Speed, or Withdraw. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Clones Once per round (as a Reaction), when you are airborne with a Jet Pack or Rocket Pack, you may negate a successful attack by making a Pilot check. The DC of the check is equal to the result of the attack roll you wish to negate. In addition, when flying a Jet Pack, you are considered proficient with its integrated weapons. This includes any piece of equipment integrated to the Jet Pack, though it does not apply to equipment integrated into armor to which the Jet Pack might be mounted. If you have taken the Starship Tactics feat, you may activate Starship Maneuvers as appropriate while flying a Jet Pack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Rocket Jumper","treeId":"1f50c63b6f08de10","tags":["action-economy","armor","controller","defender","heavy-weapons","mobility","positioning","ranged","soldier","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.jet_pack_training"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d3a642f2ceb21ed4"}}},{"_id":"07b36eea2c477187","name":"Mandalorian Glory","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mandalorian Warrior","prerequisites":"Prerequisites: Dexterity 13","benefit":"Prerequisites: Dexterity 13, , Proficient with Armor Mandalorians wear armor constantly and learn to adjust to take an impact on the strongest section of their armor. You add your armor's Fortitude Defense bonus as an Equipment bonus to your Elite Trooper Damage Reduction (with a maximum bonus equal to your base Elite Trooper DR). Additionally, if a Lightsaber does not ignore the DR of the armor you are wearing (such as Cortosis Weave/Phrik Alloy General Template), a Lightsaber does not ignore your Elite Trooper Damage Reduction. Veteran Mandalorians know how to move on the battlefield. Once per encounter, on your turn, you can Move up to your Speed as a Free Action before any other Action. Mandalorians can be ferocious fighters. Select one weapon group or Exotic Weapon you are proficient with. Once per encounter, when making more than one attack in a round, you can add one damage die to each successful hit with the selected weapon group or Exotic Weapon. You can take this Talent more than once, selecting a different Exotic Weapon or weapon group each time. Above everything else, Mandalorians fight for glory in battle. Once per encounter, when you reduce an opponent's Hit Points to 0, you gain a +5 attack bonus with your next attack roll during the same encounter.","description":"Prerequisites: Dexterity 13, , Proficient with Armor Mandalorians wear armor constantly and learn to adjust to take an impact on the strongest section of their armor. You add your armor's Fortitude Defense bonus as an Equipment bonus to your Elite Trooper Damage Reduction (with a maximum bonus equal to your base Elite Trooper DR). Additionally, if a Lightsaber does not ignore the DR of the armor you are wearing (such as Cortosis Weave/Phrik Alloy General Template), a Lightsaber does not ignore your Elite Trooper Damage Reduction. Veteran Mandalorians know how to move on the battlefield. Once per encounter, on your turn, you can Move up to your Speed as a Free Action before any other Action. Mandalorians can be ferocious fighters. Select one weapon group or Exotic Weapon you are proficient with. Once per encounter, when making more than one attack in a round, you can add one damage die to each successful hit with the selected weapon group or Exotic Weapon. You can take this Talent more than once, selecting a different Exotic Weapon or weapon group each time. Above everything else, Mandalorians fight for glory in battle. Once per encounter, when you reduce an opponent's Hit Points to 0, you gain a +5 attack bonus with your next attack roll during the same encounter.","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Mandalorian Warrior","treeId":"4b8857716e056f62","tags":["action-economy","armor","battlefield-control","controller","damage-reduction","defender","feat-chain","lightsaber","melee","mobility","soldier","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.mandalorian_glory"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.2ed2cffbd702c1c3"}}},{"_id":"edfbb13f8a931665","name":"Skirmisher","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"When you move at least 2 squares before your attack and end your move in a different square from where you started, you gain a +1 bonus to all your Defenses until the start of your next turn. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Sneak Attack Whenever you would gain the benefit of the Talent and you successfully hit your opponent, you deal Sneak Attack damage in addition to the normal damage dealt by the attack. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"When you move at least 2 squares before your attack and end your move in a different square from where you started, you gain a +1 bonus to all your Defenses until the start of your next turn. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Sneak Attack Whenever you would gain the benefit of the Talent and you successfully hit your opponent, you deal Sneak Attack damage in addition to the normal damage dealt by the attack. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["controller","defender","mobility","positioning","precision","scoundrel","striker"]},"effects":[{"_id":"b27e05f0-9859-46a5-92ab-7f844073dc03","name":"Skirmisher","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Skirmisher"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.skirmisher"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7b23e0812d6a8985"}}},{"_id":"1179c19ae23132ad","name":"Weapon Specialization","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Combat","prerequisites":"Weapon Focus","benefit":"+2 melee damage.","description":"Gain +2 damage with a chosen weapon.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Combat","treeId":"2359c05ff13f3feb","tags":["feat-chain","jedi","lightsaber","melee","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.weapon_specialization"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.41426ecd7fade0b0"}}},{"_id":"421b969007a189bf","name":"Combat Gloves","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d6+11","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Combat Gloves","npc":{"flatAttackBonus":15,"flatDamageFormula":"1d6+11","useFlat":true}}}},{"_id":"4b03a80039a1bc05","name":"Knife","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+8","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Knife","npc":{"flatAttackBonus":15,"flatDamageFormula":"1d4+8","useFlat":true}}}},{"_id":"3978e49dcefa8078","name":"Heavy Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+6","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1.3,"cost":750,"equipped":true,"description":"<p>A more powerful variant of the standard blaster pistol, delivering higher damage at the cost of increased weight and power consumption.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","profici