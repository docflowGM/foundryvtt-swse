","prerequisite":"Dual Weapon Mastery I","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["damage-reduction","dual-wield","feat-chain","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Take a -2 penalty on attacks when attacking with two weapons, or both ends of a double weapon."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":15},{"type":"bab","min":6}],"_source":"canonical-csv"}},"effects":[{"_id":"fa217f33-b718-45d3-b256-9226da60389d","name":"Dual Weapon Mastery II","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Dual Weapon Mastery II","effectType":"special","requiresCustomLogic":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c7c99a77ebee1c0c"}}},{"_id":"efb8c83deb0deecd","name":"Flurry","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"","prerequisite":"","special":"","normalText":"","sourcebook":"Knights of the Old Republic Campaign Guide","page":26,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Increases attack bonus, with penalties to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.0536f81eff886234"}}},{"_id":"4a3f9e8bde6c516a","name":"Improved Damage Threshold","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Your damage threshold increases by 5.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["defender","non-force","scout","soldier","striker"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"<a class=\"mw-redirect\" href=\"/wiki/Damage_Threshold\" title=\"Damage Threshold\">Damage Threshold</a> increases by 5 points."}},"effects":[{"name":"Improved Damage Threshold","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.damageThreshold","mode":2,"value":"5","priority":20}],"transfer":true}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.96666de28ba99b64"}}},{"_id":"af0ee62bc92550c2","name":"Linguist","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a number of additional Languages equal to 1 + your Intelligence modifier (Minimum 1). If your Intelligence modifier increases so does the number of languages granted by this Feat.","prerequisite":"Int 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["feat-chain","leader","noble","non-force","striker"],"bonus_feat_for":["Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain bonus <a href=\"/wiki/Languages\" title=\"Languages\">Languages</a> equal to 1 + your <a href=\"/wiki/Intelligence\" title=\"Intelligence\">Intelligence</a> modifier (minimum 1)."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"int","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.5afd91fb081e576b"}}},{"_id":"3e3dcb16390fe25a","name":"Martial Arts I","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Increases damage from Unarmed attacks by one die step; gain +1 bonus to Reflex Defense.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["defender","non-force","striker","unarmed"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Increases damage from <a class=\"mw-redirect\" href=\"/wiki/Unarmed\" title=\"Unarmed\">Unarmed</a> attacks by one die step; gain +1 bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.92f927c92ded9fcf"}}},{"_id":"276d76698e5cc2ff","name":"Mighty Swing","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Once per encounter, you may reroll a melee attack roll and take the better result.","prerequisite":"Base attack bonus +6","special":"","normalText":"","sourcebook":"Galaxy at War","page":26,"tags":["feat-chain","melee","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Spend two <a href=\"/wiki/Swift_Actions\" title=\"Swift Actions\">Swift Actions</a> to deal extra damage in melee."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"str","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.dd2c0e394cdf08ba"}}},{"_id":"cc309fb85f9628d0","name":"Pin","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may attempt to pin a grappled opponent. If successful, the target is immobilized until they escape the grapple.","prerequisite":"Int 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"<a class=\"mw-redirect\" href=\"/wiki/Grappled\" title=\"Grappled\">Grappled</a> opponent is <a class=\"mw-redirect\" href=\"/wiki/Pinned\" title=\"Pinned\">Pinned</a> for one round, can't move, and and loses its <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c238f3f722689a3a"}}},{"_id":"28988c61b58a3bdc","name":"Skill Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +5 bonus on all checks with the selected skill.","prerequisite":"Trained in the chosen skill","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","noble","non-force","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"2c59764cc003fa0a","name":"Skill Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You become trained in one additional skill. You may take this feat multiple times.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["noble","non-force","scaling","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You become <a class=\"mw-redirect\" href=\"/wiki/Trained\" title=\"Trained\">Trained</a> in one Class Skill."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"b88f930283f833ae","name":"Skill Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You become trained in one additional skill. You may take this feat multiple times.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["noble","non-force","scaling","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You become <a class=\"mw-redirect\" href=\"/wiki/Trained\" title=\"Trained\">Trained</a> in one Class Skill."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"f28e97efc6e03352","name":"Toughness","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain +5 hit points.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["non-force","scout","soldier","striker"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +1 Hit Point per Character Level."}},"effects":[{"name":"Toughness","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.hitPoints.bonusPerLevel","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"hit-points","perLevel":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.11db29efd899c438"}}},{"_id":"14d2c5e2b3d225dc","name":"Unstoppable Force","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"You may spend a Force Point to ignore damage reduction or energy resistance when using a damaging Force power.","prerequisite":"Trained in Use the Force","special":"","normalText":"","sourcebook":"The Force Unleashed Campaign Guide","page":35,"tags":["damage-reduction","defender","feat-chain","force","force-offense","jedi","striker"],"bonus_feat_for":["Jedi"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain a +5 bonus to <a class=\"mw-redirect\" href=\"/wiki/Fortitude_Defense\" title=\"Fortitude Defense\">Fortitude Defense</a> and <a class=\"mw-redirect\" href=\"/wiki/Will_Defense\" title=\"Will Defense\">Will Defense</a> against any effect requiring a <a href=\"/wiki/Use_the_Force\" title=\"Use the Force\">Use the Force</a> check."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.0a6c87a410bee1f2"}}},{"_id":"8d548af5e14c5f15","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"e3361a11cdc7942c","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"f9e05794b968065f","name":"Battle Analysis","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":"Trained in Initiative","benefit":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus. When you use the Mechanics skill to Handle Explosives, the explosion deals +2 dice of damage. You may take this Talent multiple times; its effects stack. You can distract opponents and convince them that you are the most tempting (or most dangerous) target in the area. As a Swift Action, make a Persuasion check and compare the result to the Will Defense of all opponents within line of sight. If the check result exceeds an opponent's Will Defense, that opponent cannot attack any character within 6 squares of you until the start of your next turn as long as you do not have Cover against that opponent. (The affected opponent may still attack you, however.) If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per round, you may spend a Swift Action to shield a single adjacent ally from attacks, taking the damage and suffering the ill effects in your ally's stead. Until the start of your next turn, any attack made against the protected ally targets you instead. You may elect not to shield your protected ally against a given attack, provided the decision is made before the attack roll is made. If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per day as a Swift Action, you can move +5 steps on the Condition Track. This does not remove any Persistent Conditions that may be affecting you. This Talent does not affect the Condition Track of a Vehicle. You can select this talent multiple times. Each time you select this Talent, you can use it one additional time per day. You can catch a Second Wind one extra time per day. If you have this Talent and the Extra Second Wind feat, you can catch your Second Wind a total of three times per day. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisite: Whenever you have the benefit of Cover, you can spend two Swift Actions to treat it as Improved Cover until the start of your next turn. Reference Book: Star Wars Saga Edition Threats of the Galaxy Prerequisite: When one or more allies uses the Aid Another Action to give you a bonus to your attack roll, you gain a circumstance bonus equal to the total bonus provided to your damage roll. Homebrew Reference Book: Legacy of the Force Sourcebook You add an additional die of damage when attacking with any weapon that has a Burst radius.","description":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus. When you use the Mechanics skill to Handle Explosives, the explosion deals +2 dice of damage. You may take this Talent multiple times; its effects stack. You can distract opponents and convince them that you are the most tempting (or most dangerous) target in the area. As a Swift Action, make a Persuasion check and compare the result to the Will Defense of all opponents within line of sight. If the check result exceeds an opponent's Will Defense, that opponent cannot attack any character within 6 squares of you until the start of your next turn as long as you do not have Cover against that opponent. (The affected opponent may still attack you, however.) If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per round, you may spend a Swift Action to shield a single adjacent ally from attacks, taking the damage and suffering the ill effects in your ally's stead. Until the start of your next turn, any attack made against the protected ally targets you instead. You may elect not to shield your protected ally against a given attack, provided the decision is made before the attack roll is made. If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per day as a Swift Action, you can move +5 steps on the Condition Track. This does not remove any Persistent Conditions that may be affecting you. This Talent does not affect the Condition Track of a Vehicle. You can select this talent multiple times. Each time you select this Talent, you can use it one additional time per day. You can catch a Second Wind one extra time per day. If you have this Talent and the Extra Second Wind feat, you can catch your Second Wind a total of three times per day. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisite: Whenever you have the benefit of Cover, you can spend two Swift Actions to treat it as Improved Cover until the start of your next turn. Reference Book: Star Wars Saga Edition Threats of the Galaxy Prerequisite: When one or more allies uses the Aid Another Action to give you a bonus to your attack roll, you gain a circumstance bonus equal to the total bonus provided to your damage roll. Homebrew Reference Book: Legacy of the Force Sourcebook You add an additional die of damage when attacking with any weapon that has a Burst radius.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Commando","treeId":"798ed0945cbdac1c","tags":["action-economy","battlefield-control","burst-damage","condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","mechanics","mobility","piloting","positioning","ranged","scaling","shields","skills","social","soldier","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.battle_analysis"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7df2e8e4f18dc909"}}},{"_id":"af926b3d282de2b2","name":"Commanding Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mercenary","prerequisites":"","benefit":"Your abilities on the battlefield are well known and feared. When you reduce an opponent to 0 Hit Points with an attack, you can make a Persuasion check as a Free Action against all targets within 6 squares. If your Persuasion check exceeds the target's Will Defense, that target takes a -2 penalty on attack rolls for the remainder of the encounter. This Talent affects any given target only once per encounter. This is a Mind-Affecting Fear effect. Your training makes you confident and disciplined in combat. When you successfully deal damage to an opponent in combat, you gain a +5 morale bonus to Will Defense until the start of your next turn. You lose this bonus to Will Defense if you are Surprised or Flat-Footed for any reason.","description":"Your abilities on the battlefield are well known and feared. When you reduce an opponent to 0 Hit Points with an attack, you can make a Persuasion check as a Free Action against all targets within 6 squares. If your Persuasion check exceeds the target's Will Defense, that target takes a -2 penalty on attack rolls for the remainder of the encounter. This Talent affects any given target only once per encounter. This is a Mind-Affecting Fear effect. Your training makes you confident and disciplined in combat. When you successfully deal damage to an opponent in combat, you gain a +5 morale bonus to Will Defense until the start of your next turn. You lose this bonus to Will Defense if you are Surprised or Flat-Footed for any reason.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Mercenary","treeId":"4007fa87192b5884","tags":["action-economy","ambush","battlefield-control","controller","damage-reduction","defender","leader","positioning","skills","social","soldier","striker"]},"effects":[{"_id":"ff1494c0-5d9c-4bd3-9b5c-bc93f28f4ea2","name":"Commanding Presence","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.leadership","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Commanding Presence"}}},{"name":"Commanding Presence (Class Skill)","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.skills.persuasion.classSkill","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Commanding Presence","effectType":"class-skill"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.commanding_presence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.438e13c99c7b53a6"}}},{"_id":"3f21d2b2ce0e50c5","name":"Demand Surrender","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Consular","prerequisites":"Farseeing","benefit":"Once per turn as a Swift Action, you can remove one ongoing Mind-Affecting effect (such as the effects of or Weaken Resolve Talents, or the effect of being moved to the end of the Condition Track by the Adept Negotiator Talent, or the ongoing effects of the Mind Trick Force Power) from a single allied target within line of sight. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide When you use Farseeing, or a Force Power or Talent that has Farseeing as a prerequisite, other Force-users with Farseeing in their Force Power Suite can Aid Another on your Use the Force check as a Reaction, if they are within 6 squares of you. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Once per round as a Swift Action, you grant one ally within 12 squares of you (and within your line of sight) Bonus Hit Points equal to 5 + your Charisma modifier. These Bonus Hit Points last until the beginning of your next turn (at which point any remaining Bonus Hit Points are lost), and any damage dealt to that ally comes out of Bonus Hit Points first. You take a -5 penalty on all Use the Force checks until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide","description":"Once per turn as a Swift Action, you can remove one ongoing Mind-Affecting effect (such as the effects of or Weaken Resolve Talents, or the effect of being moved to the end of the Condition Track by the Adept Negotiator Talent, or the ongoing effects of the Mind Trick Force Power) from a single allied target within line of sight. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide When you use Farseeing, or a Force Power or Talent that has Farseeing as a prerequisite, other Force-users with Farseeing in their Force Power Suite can Aid Another on your Use the Force check as a Reaction, if they are within 6 squares of you. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Once per round as a Swift Action, you grant one ally within 12 squares of you (and within your line of sight) Bonus Hit Points equal to 5 + your Charisma modifier. These Bonus Hit Points last until the beginning of your next turn (at which point any remaining Bonus Hit Points are lost), and any damage dealt to that ally comes out of Bonus Hit Points first. You take a -5 penalty on all Use the Force checks until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide","class":"Noble","costNumeric":null,"category":"Noble","tree":"Jedi Consular","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.presence"}],"_source":"canonical-csv"},"treeId":"e99cfa9db8493573","tags":["action-economy","condition-removal","controller","feat-chain","force","force-control","force-offense","leader","light-side","mobility","noble","positioning","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.demand_surrender"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.871638a983029bc4"}}},{"_id":"a6794e22002a4846","name":"Devastating Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"","benefit":"This replaces the effects of the Talent.","description":"This replaces the effects of the Talent.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["soldier"]},"effects":[{"_id":"69f7a1a0-603e-4b5e-a42a-15f770230266","name":"Devastating Attack","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.combat.weaponGroupThresholdReduction","mode":2,"value":"5"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Devastating Attack","effectType":"threshold_reduction","weaponGroupSpecific":true,"notes":"Weapon group specific - applies when using designated weapon group"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.devastating_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.383915a7d11e1225"}}},{"_id":"35cfef21bb7c41f9","name":"Greater Weapon Focus","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"","benefit":"Prerequisites: (Chosen Weapon), Devastating Attack (Chosen Weapon) Choose a single Exotic Weapon or weapon group with which you're proficient. Whenever you make a successful attack against a target using the chosen Exotic Weapon or weapon from the chosen group, you treat your target's Damage Threshold as if it were 10 points lower when determining the results of your attack. Prerequisites: (Chosen Weapon), Penetrating Attack (Chosen Weapon) Choose a single Exotic Weapon or weapon group with which you're proficient. Whenever you make a successful attack against a target using the chosen Exotic Weapon or weapon from the chosen group, you treat your target's Damage Reduction as if it were 10 points lower when determining the results of your attack. Prerequisites: (Chosen Weapon), Weapon Specialization (Chosen Weapon)","description":"Prerequisites: (Chosen Weapon), Devastating Attack (Chosen Weapon) Choose a single Exotic Weapon or weapon group with which you're proficient. Whenever you make a successful attack against a target using the chosen Exotic Weapon or weapon from the chosen group, you treat your target's Damage Threshold as if it were 10 points lower when determining the results of your attack. Prerequisites: (Chosen Weapon), Penetrating Attack (Chosen Weapon) Choose a single Exotic Weapon or weapon group with which you're proficient. Whenever you make a successful attack against a target using the chosen Exotic Weapon or weapon from the chosen group, you treat your target's Damage Reduction as if it were 10 points lower when determining the results of your attack. Prerequisites: (Chosen Weapon), Weapon Specialization (Chosen Weapon)","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["damage-reduction","defender","soldier","striker"]},"effects":[{"_id":"7a2683eb-2396-4638-aa86-e28807081035","name":"Greater Weapon Focus","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks.melee","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Greater Weapon Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.greater_weapon_focus"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.642c6c8643db7470"}}},{"_id":"e0008403c677038e","name":"Greater Weapon Specialisation (Simple Weapons)","type":"talent","img":"icons/svg/aura.svg","system":{"tree":"Unknown","prerequisite":"","benefit":"","special":"","uses":{"current":0,"max":0,"perEncounter":false,"perDay":false}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Greater Weapon Specialisation"}}},{"_id":"9916cac59f732deb","name":"Indomitable","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":null,"benefit":"Once per day, move +5 steps up the condition track (not persistent conditions); may be taken multiple times.","description":"","class":"Soldier","costNumeric":null,"category":"Soldier","treeId":"798ed0945cbdac1c","tree":"Commando","tags":["condition-removal","controller","mobility","scaling","soldier","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.indomitable"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.b8aaf500d3069938"}}},{"_id":"588fa71d28fcd67a","name":"Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Influence","prerequisites":"","benefit":"Once per encounter, you can make a Persuasion check as a Standard Action to demand surrender from an opponent who has been reduced to one-half or less of its hit points. If your check result equals or exceeds the target's Will Defense, it surrenders to you and your allies, drops any weapons it is holding, and takes no hostile actions. If the target is higher level than you, it gains a +5 bonus to its Will Defense. If you or any of your allies attack it, it no longer submits to your will and can act normally. You can only use this Talent against a particular target once per encounter. This is a Mind-Affecting effect. Prerequisites: , Weaken Resolve Prerequisite: Once per round, when you deal damage equal to or greater than the target's Damage Threshold, you can make a Persuasion check as a Free Action; if the result equals or exceeds the target's Will Defense, you fill the target with terror, causing it to flee from you at top speed for 1 minute. The target can't take Standard Actions, Swift Actions, or Full-Round Actions while fleeing, but the target stops fleeing and can act normally if it is wounded. As a Free Action or Reaction, the target can spend a Force Point (if it has not already spent one earlier in the round) to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your Character Level. This is a Mind-Affecting fear effect. Unlike with other Mind-Affecting effects, you need only to hail a Vehicle to weaken the crew's resolve. When you deal damage that equals or exceeds a Vehicle's Damage Threshold, you may use this Talent; in addition, you may Ready an Action to use this Talent after any Gunner on your Vehicle deals damage that equals or exceeds a Vehicle's Damage Threshold. You make your check against the Vehicle's Commander; all Nonheroic crews are assumed to have a Will Defense of 10. The effect is automatically negated if the target Vehicle's Challenge Level is greater than your Heroic Level or your Vehicle's Challenge Level. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion You get under an opponent's skin. Once per encounter, make a Persuasion check to Intimidate one creature within line of sight as a Standard Action. On a success, instead of the normal effect of an Intimidate application of the Persuasion skill, the affected creature can take only a single Swift Action on its next turn. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion Once per encounter, as a Reaction, you can make a Persuasion check to Intimidate one creature that is making a melee or ranged attack against you, and is within your line of sight. If you succeed, you impose a -5 penalty to that attack roll. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"Once per encounter, you can make a Persuasion check as a Standard Action to demand surrender from an opponent who has been reduced to one-half or less of its hit points. If your check result equals or exceeds the target's Will Defense, it surrenders to you and your allies, drops any weapons it is holding, and takes no hostile actions. If the target is higher level than you, it gains a +5 bonus to its Will Defense. If you or any of your allies attack it, it no longer submits to your will and can act normally. You can only use this Talent against a particular target once per encounter. This is a Mind-Affecting effect. Prerequisites: , Weaken Resolve Prerequisite: Once per round, when you deal damage equal to or greater than the target's Damage Threshold, you can make a Persuasion check as a Free Action; if the result equals or exceeds the target's Will Defense, you fill the target with terror, causing it to flee from you at top speed for 1 minute. The target can't take Standard Actions, Swift Actions, or Full-Round Actions while fleeing, but the target stops fleeing and can act normally if it is wounded. As a Free Action or Reaction, the target can spend a Force Point (if it has not already spent one earlier in the round) to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your Character Level. This is a Mind-Affecting fear effect. Unlike with other Mind-Affecting effects, you need only to hail a Vehicle to weaken the crew's resolve. When you deal damage that equals or exceeds a Vehicle's Damage Threshold, you may use this Talent; in addition, you may Ready an Action to use this Talent after any Gunner on your Vehicle deals damage that equals or exceeds a Vehicle's Damage Threshold. You make your check against the Vehicle's Commander; all Nonheroic crews are assumed to have a Will Defense of 10. The effect is automatically negated if the target Vehicle's Challenge Level is greater than your Heroic Level or your Vehicle's Challenge Level. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion You get under an opponent's skin. Once per encounter, make a Persuasion check to Intimidate one creature within line of sight as a Standard Action. On a success, instead of the normal effect of an Intimidate application of the Persuasion skill, the affected creature can take only a single Swift Action on its next turn. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion Once per encounter, as a Reaction, you can make a Persuasion check to Intimidate one creature that is making a melee or ranged attack against you, and is within your line of sight. If you succeed, you impose a -5 penalty to that attack roll. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Influence","treeId":"8375b9b26b679901","tags":["action-economy","damage-reduction","defender","force","force-defense","force-offense","melee","mobility","noble","positioning","ranged","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.presence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ec8f2ba706cc2c05"}}},{"_id":"cd5896459fa59a52","name":"Tough as Nails","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":"","benefit":"You can Catch a Second Wind as a Reaction, instead of as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide When you use the Aid Another Action to Suppress an Enemy, that enemy takes a -5 penalty on its next attack instead of the normal -2 penalty. Only 1 character may gain the benefits of this Talent against a given target at a time. Reference Book: Star Wars Saga Edition Unknown Regions","description":"You can Catch a Second Wind as a Reaction, instead of as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide When you use the Aid Another Action to Suppress an Enemy, that enemy takes a -5 penalty on its next attack instead of the normal -2 penalty. Only 1 character may gain the benefits of this Talent against a given target at a time. Reference Book: Star Wars Saga Edition Unknown Regions","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Commando","treeId":"798ed0945cbdac1c","tags":["action-economy","mobility","soldier"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.tough_as_nails"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.916b0a6197bf85a6"}}},{"_id":"a03c8ddfa54cd1fb","name":"Weapon Specialisation (Simple Weapons)","type":"talent","img":"icons/svg/aura.svg","system":{"tree":"Unknown","prerequisite":"","benefit":"","special":"","uses":{"current":0,"max":0,"perEncounter":false,"perDay":false}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Weapon Specialisation"}}},{"_id":"14da237530c40e33","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d8+21","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":28,"flatDamageFormula":"1d8+21","useFlat":true}}}},{"_id":"c2a4bcead9ec0a6f","name":"Sceptre of Power (with Mighty Swing)","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d10+28(AmphistaffPoison)","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Sceptre of Power","npc":{"flatAttackBonus":30,"flatDamageFormula":"2d10+28(AmphistaffPoison)","useFlat":true}}}},{"_id":"abd8a1548d1c3ff9","name":"Flurry","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","prop