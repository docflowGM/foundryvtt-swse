system.armorProficiency.light","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Armor Proficiency (Light)","effectType":"armor_proficiency"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.773ec00effc7e96f"}}},{"_id":"196539b28fb2f984","name":"Armor Proficiency (medium)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with medium armor and do not take armor check penalties on attack rolls.","prerequisite":"Armor Proficiency (Light)","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":85,"tags":["armor","defender","feat-chain","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No penalty on attacks and no <a class=\"mw-redirect\" href=\"/wiki/Armor_Check_Penalty\" title=\"Armor Check Penalty\">Armor Check Penalty</a> while wearing <a href=\"/wiki/Light_Armor\" title=\"Light Armor\">Light Armor</a> or <a href=\"/wiki/Medium_Armor\" title=\"Medium Armor\">Medium Armor</a>."}},"effects":[{"_id":"af0983df-e771-4593-8f88-f0aa43612597","name":"Armor Proficiency (Medium)","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.armorProficiency.medium","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Armor Proficiency (Medium)","effectType":"armor_proficiency"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.d445051370a88a7f"}}},{"_id":"c37361998e5256d8","name":"Crush","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"You may spend a Force Point to move a target -1 step down the condition track when using Force Grip.","prerequisite":"Trained in Use the Force, Force Grip","special":"","normalText":"","sourcebook":"The Force Unleashed Campai