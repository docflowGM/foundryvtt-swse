ame":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"0571dc1cf35d0321","name":"Devastating Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"","benefit":"This replaces the effects of the Talent.","description":"This replaces the effects of the Talent.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["soldier"]},"effects":[{"_id":"69f7a1a0-603e-4b5e-a42a-15f770230266","name":"Devastating Attack","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.combat.weaponGroupThresholdReduction","mode":2,"value":"5"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Devastating Attack","effectType":"threshold_reduction","weaponGroupSpecific":true,"notes":"Weapon group specific - applies when using designated weapon group"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.devastating_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.383915a7d11e1225"}}},{"_id":"806b4b1fc488d1e6","name":"Dual Weapon Flourish I","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Duelist","prerequisites":"Prerequisites: Trained in Deception, Weapon Finesse","benefit":"Prerequisites: Dual Weapon Mastery I, Dual Weapon Mastery II, , Master of Elegance, Weapon Finesse When wielding only two light melee weapons or two Lightsabers, once per turn on your turn, you can make a Full Attack Action as a Standard Action, rather than a Full-Round Action, provided you attack with both weapons during the attack. You apply the normal penalties for fighting with two weapons to both of these attacks. Prerequisites: or Single Weapon Flourish I, Weapon Finesse You may add your Dexterity bonus (instead of your Strength bonus) on damage rolls when wielding a light melee weapon. When you wield a light melee weapon two-handed, you may apply double your Dexterity bonus (instead of double your Strength bonus) to the damage. Whenever you make multiple attacks with Advanced Melee Weapons as a Full Attack Action, you reduce the penalty on your attack rolls by 2 points. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2 points. Once per encounter, as a Free Action on your turn, you can make an attack with a light melee weapon or Lightsaber after a successful Feint. When you wield only a single light melee weapon, or a single Lightsaber, and use the Full Attack Action, once per turn; you can Move up to your Speed as a Free Action at any time during your turn.","description":"Prerequisites: Dual Weapon Mastery I, Dual Weapon Mastery II, , Master of Elegance, Weapon Finesse When wielding only two light melee weapons or two Lightsabers, once per turn on your turn, you can make a Full Attack Action as a Standard Action, rather than a Full-Round Action, provided you attack with both weapons during the attack. You apply the normal penalties for fighting with two weapons to both of these attacks. Prerequisites: or Single Weapon Flourish I, Weapon Finesse You may add your Dexterity bonus (instead of your Strength bonus) on damage rolls when wielding a light melee weapon. When you wield a light melee weapon two-handed, you may apply double your Dexterity bonus (instead of double your Strength bonus) to the damage. Whenever you make multiple attacks with Advanced Melee Weapons as a Full Attack Action, you reduce the penalty on your attack rolls by 2 points. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2 points. Once per encounter, as a Free Action on your turn, you can make an attack with a light melee weapon or Lightsaber after a successful Feint. When you wield only a single light melee weapon, or a single Lightsaber, and use the Full Attack Action, once per turn; you can Move up to your Speed as a Free Action at any time during your turn.","class":"Melee Duelist","costNumeric":null,"category":"Melee Duelist","tree":"Melee Duelist","treeId":"1381bb8c9a838279","tags":["action-economy","burst-damage","controller","damage-reduction","dual-wield","feat-chain","lightsaber","melee","mobility","scaling","striker","sustained-damage","talent-chain"]},"effects":[{"_id":"4f9b4473-b5bf-4389-b36a-2d31234a5140","name":"Dual Weapon Flourish I","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks.dualWield","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Dual Weapon Flourish I"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.dual_weapon_flourish_i"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5004013069710c3e"}}},{"_id":"e24da9c82d3ed68d","name":"Melee Smash","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Specialist","prerequisites":"","benefit":"Unrelenting Assault You twirl your Weapon around you in a blur, creating a circle of death around you. Any enemy target that begins its turn adjacent to you takes damage equal to your Strength bonus. You must be wielding a Melee Weapon to be using this Talent.","description":"Unrelenting Assault You twirl your Weapon around you in a blur, creating a circle of death around you. Any enemy target that begins its turn adjacent to you takes damage equal to your Strength bonus. You must be wielding a Melee Weapon to be using this Talent.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Melee Specialist","treeId":"fad8118981c532f0","tags":["melee","positioning","soldier","striker","sustained-damage"]},"effects":[{"_id":"2d692811-5c22-48b8-944d-45db89ca5e77","name":"Melee Smash","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.melee","mode":5,"value":"half_level"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Melee Smash"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.melee_smash"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e0ee525f4109cfde"}}},{"_id":"048cbfaab6f68bf2","name":"Stunning Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Specialist","prerequisites":"","benefit":"When you damage an opponent with a melee attack that moves the target down the Condition Track, the target cannot take any Action requiring a Standard Action or a Full-Round Action on its next turn.","description":"When you damage an opponent with a melee attack that moves the target down the Condition Track, the target cannot take any Action requiring a Standard Action or a Full-Round Action on its next turn.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Melee Specialist","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.melee_smash"}],"_source":"canonical-csv"},"treeId":"fad8118981c532f0","tags":["action-economy","condition-re