":"<p>The traditional weapon of the Wookiees. Fires explosive quarrels propelled by magnetic acceleration.</p>\n      <p><strong>Special:</strong> Requires Strength 13+ to use effectively. Critical threat range 19-20.</p>","properties":["Wookiee","Critical 19-20","Strength Required"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"rifles","subcategory":"rifle","costNumeric":1500,"category":"rifle"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-bowcaster"},"swse":{"npc":{"flatAttackBonus":9,"flatDamageFormula":"4d10+5","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Wookiee","Nonheroic Level":0,"Class Levels":{"Scout":6,"Scoundrel":4},"Destiny Points":2,"Force Points":5,"Dark Side Points":0,"Initiative":11,"Senses":"Perception +10","Languages":["Basic (Understand only)","Huttese (Understand only)","Shyriiwook"],"Unassigned Languages":0,"Reflex Defense":24,"Flat-Footed Defense":22,"Fortitude Defense":26,"Will Defense":21,"Hit Points":110,"Damage Threshold":26,"Speed":"6 Squares; Powerful Charge","Melee Weapons":"Unarmed +11 (1d6+9), Unarmed +15 (1d6+14) with Powerful Charge","Ranged Weapons":"Bowcaster +8 (3d10+5), Bowcaster +6 (4d10+5) with Rapid Shot, Bowcaster +9 (4d10+5) with Deadeye","Base Attack Bonus":7,"Grapple":11,"Attack Options":["Careful Shot","Deadeye","Point-Blank Shot","Precise Shot","Rapid Shot","Stellar Warrior"],"Special Actions":["Extreme Effort","Rage (2/Day)"],"Force Powers":[],"Force Secrets":[],"Force Techniques":[],"Strength":19,"Dexterity":13,"Constitution":20,"Intelligence":12,"Wisdom":10,"Charisma":10,"Talents":["Talents : Acute Senses","Extreme Effort","Jury-Rigger","Spacehound","Stellar Warrior"],"Feats":["Feats : Careful Shot","Crush","Deadeye","Extra Rage","Martial Arts I","Pin","Point-Blank Shot","Powerful Charge","Precise Shot","Rapid Shot","Shake