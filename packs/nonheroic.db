ext":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"54e3c321b28cfe1d","name":"Controlled Burst","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"Weapon Focus (Simple Weapons)","benefit":"Base Attack Bonus +12 Once per encounter, when making an Autofire attack, you can treat the attack as a 6-Square Cone. Making this attack consumes 20 shots from the weapon's Power Pack. Reference Book: Star Wars Saga Edition Unknown Regions Whenever you make multiple attacks with any type of Simple Weapon as a Full-Round Action (see Full Attack), you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. Reference Book: Star Wars Saga Edition Unknown Regions As a Standard Action, you can throw two weapons simultaneously. Both weapons target the same enemy or target square and are thrown with one hand. Make separate attack rolls for each weapon, each at a -10 penalty. The weapons must be similar, such as two Grenades or two Knives, and they must be no larger than one size category smaller than you. The attack cannot exceed Short Range (typically 8 squares). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Weapon Proficiency (Heavy Weapons), Strength 15 When attacking with an Autofire-capable weapon, you may deal +1 die of damage. This increased damage die stacks with the increased damage from the Burst Fire and Rapid Shot Feats. Homebrew Reference Book: Legacy of the Force Sourcebook Choose one Exotic Weapon or one of the following weapon groups: Advanced Melee Weapons, Lightsabers, or Simple Weapons. You take no penalty on your attack roll when using the Rapid Strike feat with such weapons. You may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group.","description":"Base Attack Bonus +12 Once per encounter, when making an Autofire attack, you can treat the attack as a 6-Square Cone. Making this attack consumes 20 shots from the weapon's Power Pack. Reference Book: Star Wars Saga Edition Unknown Regions Whenever you make multiple attacks with any type of Simple Weapon as a Full-Round Action (see Full Attack), you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. Reference Book: Star Wars Saga Edition Unknown Regions As a Standard Action, you can throw two weapons simultaneously. Both weapons target the same enemy or target square and are thrown with one hand. Make separate attack rolls for each weapon, each at a -10 penalty. The weapons must be similar, such as two Grenades or two Knives, and they must be no larger than one size category smaller than you. The attack cannot exceed Short Range (typically 8 squares). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Weapon Proficiency (Heavy Weapons), Strength 15 When attacking with an Autofire-capable weapon, you may deal +1 die of damage. This increased damage die stacks with the increased damage from the Burst Fire and Rapid Shot Feats. Homebrew Reference Book: Legacy of the Force Sourcebook Choose one Exotic Weapon or one of the following weapon groups: Advanced Melee Weapons, Lightsabers, or Simple Weapons. You take no penalty on your attack roll when using the Rapid Strike feat with such weapons. You may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group.","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["action-economy","burst-damage","damage-reduction","dual-wield","feat-chain","force","force-offense","heavy-weapons","lightsaber","melee","positioning","ranged","scaling","soldier","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.controlled_burst"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.3e35df4fce7082a3"}}},{"_id":"38e900dab0b2d00b","name":"Harm's Way","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Protection","prerequisites":"","benefit":"Whenever you take damage on behalf of an ally through the use of a Talent (including ), you gain Damage Reduction equal to your Class Level until the end of your next turn. Whenever you take damage on behalf of an ally through the use of a Talent (including ), your Damage Threshold is increased by 5 points. As a Swift Action, designate one adjacent ally. Until the end of your next turn, as long as that ally remains adjacent to you, you are considered to be providing that ally with Soft Cover against all attacks.","description":"Whenever you take damage on behalf of an ally through the use of a Talent (including ), you gain Damage Reduction equal to your Class Level until the end of your next turn. Whenever you take damage on behalf of an ally through the use of a Talent (including ), your Damage Threshold is increased by 5 points. As a Swift Action, designate one adjacent ally. Until the end of your next turn, as long as that ally remains adjacent to you, you are considered to be providing that ally with Soft Cover against all attacks.","class":"Soldier","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"cb5493f65f0bdb62"}],"_source":"fix5F-canonical"},"tree":"Protection","treeId":"c92c2cbc79b8a515","tags":["action-economy","damage-reduction","defender","mobility","positioning","soldier","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.harms_way"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.fde8157b6d097e12"}}},{"_id":"74cd165e47939232","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d8+3,AreaAttack","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":15,"flatDamageFormula":"1d8+3,AreaAttack","useFlat":true}}}},{"_id":"43f2c44e8582c449","name":"Blaster Rifle","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+1,1-SquareSplash","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":4,"cost":1000,"equipped":true,"description":"<p>The standard military rifle used by armed forces across the galaxy. Reliable and effective at medium to long range.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"rifles","subcategory":"rifle","costNumeric":1000,"category":"rifle"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-blaster-rifle"},"swse":{"npc":{"flatAttackBonus":15,"flatDamageFormula":"3d8+1,1-SquareSplash","useFlat":true}}}},{"_id":