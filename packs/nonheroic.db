s":1,"costNumeric":null},"effects":[],"folder":null,"sort":700,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.species.species-human"}}},{"_id":"feb8815d622d9f33","name":"Dodge","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"During your turn, you designate an opponent and receive a +1 dodge bonus to your Reflex Defense against attacks from that opponent. You can select a new opponent on any action. A situation that makes you lose your Dexterity bonus to Reflex Defense (if any) also makes you lose dodge bonuses. Also, dodge bonuses stack with each other, unlike most other types of bonuses.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":84,"tags":["action-economy","defender","evasion","feat-chain","non-force","scaling","scout","striker"],"bonus_feat_for":["Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain a +1 dodge bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a> against a selected target."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13}],"_source":"canonical-csv"}},"effects":[{"name":"Dodge","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"feat-defense-bonus","source":"Dodge","defenseType":"reflex"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.45366d4f3a5e443d"}}},{"_id":"04985633f4f072bb","name":"Improved Defenses","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus to your Reflex, Fortitude, and Will Defense.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["defender","noble","non-force","scout","soldier","striker"],"bonus_feat_for":["Soldier","Scout","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +1 bonus to all <a href=\"/wiki/Defenses\" title=\"Defenses\">Defenses</a>."}},"effects":[{"name":"Improved Defenses","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.defenses.reflex.bonus","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"defense-bonus","defense":"reflex"}}},{"name":"Improved Defenses","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.defenses.fortitude.bonus","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"defense-bonus","defense":"fortitude"}}},{"name":"Improved Defenses","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.defenses.will.bonus","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"defense-bonus","defense":"will"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.f8e2a30390d870e7"}}},{"_id":"6d9c7f6808c06ca2","name":"Linguist","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a number of additional Languages equal to 1 + your Intelligence modifier (Minimum 1). If your Intelligence modifier increases so does the number of languages granted by this Feat.","prerequisite":"Int 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["feat-chain","leader","noble","non-force","striker"],"bonus_feat_for":["Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain bonus <a href=\"/wiki/Languages\" title=\"Languages\">Languages</a> equal to 1 + your <a href=\"/wiki/Intelligence\" title=\"Intelligence\">Intelligence</a> modifier (minimum 1)."},"prerequisitesStructured":{"type":"a