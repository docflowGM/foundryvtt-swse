mg":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"d6fb5b9db21f44a1","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"c657a1292ef7f84a","name":"Shaped Explosion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sabotage","prerequisites":"Skilled Demolitionist","benefit":"Create blasts in a line or cone: length = 2× radius; cone length = 3× blast radius; origin from explosive’s square.","description":"Explosions may be shaped into a line or cone originating from the explosive's square.","class":"Saboteur","costNumeric":null,"category":"Saboteur","tree":"Sabotage","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.skilled_demolitionist"}],"_source":"canonical-csv"},"treeId":"8897a36d59662ee9","tags":["feat-chain","positioning","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.shaped_explosion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7ab4fcbe5a8b7714"}}},{"_id":"1393d814981d8e4d","name":"Skilled Demolitionist","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sabotage","prerequisites":"Any two Talents from the Sabotage Talent Tree","benefit":"Shaped Explosion You know how to set large charges and use dozens of charges for extremely large explosives. You increase the Burst radius of any Mines or Explosives by 1 square. You can place a Mine as a Standard Action instead of a Full-Round Action. Prerequisite: You know how to set charges to direct a blast in a specific direction or manner. You can shape an explosion caused by Explosives or Mines that you set into a line or a cone instead of a radius. The length of the line is equal to 2 x the radius of the explosive Burst; the length of the cone is equal to 3 x the radius of the Burst, and either the line or the cone originates from the square where the Explosives are placed. You can set a Detonator as a Swift Action, and your Explosives never go off as the Detonator is being placed, even if you fail the check by 10 or more. You must still roll to determine if the charge otherwise goes off as planned (see Handle Explosives). Expect the Unexpected Talent created by Wikia user Admire Lucas. The range for Unexpected Results increases by 1; that is, it triggers on an attack from an eligible weapon against you on a Natural 1 or 2. Malicious Glitches Talent created by Wikia user Admire Lucas. Whenever Unexpected Results would trigger, the wielder must choose to either take half the damage that would have been dealt against you, or roll 2d20 for a result on the Glitch table, below.","description":"Shaped Explosion You know how to set large charges and use dozens of charges for extremely large explosives. You increase the Burst radius of any Mines or Explosives by 1 square. You can place a Mine as a Standard Action instead of a Full-Round Action. Prerequisite: You know how to set charges to direct a blast in a specific direction or manner. You can shape an explosion caused by Explosives or Mines that you set into a line or a cone instead of a radius. The length of the line is equal to 2 x the radius of the explosive Burst; the length of the cone is equal to 3 x the radius of the Burst, and either the line or the cone originates from the square where the Explosives are placed. You can set a Detonator as a Swift Action, and your Explosives never go off as the Detonator is being placed, even if you fail the check by 10 or more. You must still roll to determine if the charge otherwise goes off as planned (see Handle Explosives). Expect the Unexpected Talent created by Wikia user Admire Lucas. The range for Unexpected Results increases by 1; that is, it triggers on an attack from an eligible weapon against you on a Natural 1 or 2. Malicious Glitches Talent created by Wikia user Admire Lucas. Whenever Unexpected Results would trigger, the wielder must choose to either take half the damage that would have been dealt against you, or roll 2d20 for a result on the Glitch table, below.","class":"Saboteur","costNumeric":null,"category":"Saboteur","tree":"Sabotage","treeId":"8897a36d59662ee9","tags":["action-economy","burst-damage","feat-chain","mobility","positioning","striker","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.skilled_demolitionist"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.c3a67c14c713a7a3"}}},{"_id":"542d845eeb380879","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+2","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":9,"flatDamageFormula":"1d4+2","useFlat":true}}}},{"_id":"6158894b52d17485","name":"Bayonet","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d8+3","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Bayonet","npc":{"flatAttackBonus":9,"flatDamageFormula":"1d8+3","useFlat":true}}}},{"_id":"928c23d528f189a5","name":"Rail Detonator Gun","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+1,1-SquareSplash","damageType":"kinetic","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":5,"cost":1900,"equipped":true,"description":"<p>A rail gun that fires explosive projectiles.</p>","properties":["Military"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"rifles","subcategory":"rifle","costNumeric":1900,"category":"rifle"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-rail-detonator-gun"},"swse":{"npc":{"flatAttackBonus":10,"flatDamageFormula":"3d8+1,1-Squ