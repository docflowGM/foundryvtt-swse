ttle Strike"}}},{"_id":"6a0cf702eb37467a","name":"Dark Rage )","type":"feat","img":"icons/svg/book.svg","system":{"featType":"general","prerequisite":"","benefit":"","special":"","normalText":"","bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Dark Rage )"}}},{"_id":"535a0f5104982de2","name":"Attune Weapon","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Force Item","prerequisites":null,"benefit":"Grant a melee weapon +1 attack.","description":"Gain +1 attack with a chosen melee weapon.","class":"Force Adept","costNumeric":null,"category":"Force Adept","tree":"Force Item","treeId":"01e443d93e47f9c4","tags":["force","force-offense","leader","melee","striker"]},"effects":[{"_id":"1fd6da0e-f546-4a44-a963-338b37a13313","name":"Attune Weapon","icon":"icons/svg/sword.svg","changes":[{"key":"system.attacks.melee","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Attune Weapon"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.attune_weapon"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.aa9b67c6737c2549"}}},{"_id":"55c0e3ddd8902532","name":"Damage Reduction 10","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Control","prerequisites":null,"benefit":"Gain DR 10 for one minute.","description":"Gain damage reduction 10 for one minute.","costNumeric":null,"tree":"Control","treeId":"d3661aa9906bdc79","tags":["defender","force"]},"effects":[{"_id":"a33bfc46-2971-4f80-b25b-3facd242fa76","name":"Damage Reduction 10","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damageReduction","mode":5,"value":"10"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Damage Reduction 10"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.damage_reduction_10"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.35b42e14e3ef7d0d"}}},{"_id":"3857df60c5957d29","name":"Empower Weapon","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Force Item","prerequisites":"","benefit":"You can hurl Simple Weapons (Melee), or Advanced Melee Weapons your size or smaller as a Standard Action, treating it as a Thrown Weapon. The Thrown Weapon deals normal weapon damage if it hits. If the weapon deals piercing or slashing damage, it becomes embedded in your target, remaining there and causing an additional die of damage each round at the end of the target's turn, and also when it is removed (removing the embedded weapon is a Swift Action, and an adjacent ally can remove the embedded weapon for you). Your target must be within 6 squares of you. The weapon does not automatically return to you, but you can retrieve it with the Move Object Force Power (dealing an additional die of damage in the process, if the weapon is embedded in the target, as above). Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisite:","description":"You can hurl Simple Weapons (Melee), or Advanced Melee Weapons your size or smaller as a Standard Action, treating it as a Thrown Weapon. The Thrown Weapon deals normal weapon damage if it hits. If the weapon deals piercing or slashing damage, it becomes embedded in your target, remaining there and causing an additional die of damage each round at the end of the target's turn, and also when it is removed (removing the embedded weapon is a Swift Action, and an adjacent ally can remove the embedded weapon for you). Your target must be within 6 squares of you. The weapon does not automatically return to you, but you can retrieve it with the Move Object Force Power (dealing an additional die of damage in the process, if the weapon is embedded in the target, as above). Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisite:","class":"Force Adept","costNumeric":null,"category":"Force Adept","tree":"Force Item","treeId":"01e443d93e47f9c4","tags":["action-economy","controller","force","force-control","force-offense","melee","mobility","positioning","ranged","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.empower_weapon"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5218d5971b78119b"}}},{"_id":"113a9190b2e1c646","name":"Equilibrium","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Force Adept","prerequisites":"","benefit":"The Force shields you against ailments, toxins, and radiation poisoning, making you immune to Disease, Poison, and Radiation. Reference Book: Star Wars Saga Edition Unknown Regions You are particularly in tune with The Living Force. When you successfully use Search Your Feelings, you gain a Force Point that must be used before the end of the encounter. If you use this Force Point in a manner that would end in unfavorable results (per Search Your Feelings), you raise your Dark Side Score by 1. lf you use the Force Point in an action that would normally raise your Dark Side Score, you raise your Dark Side Score by 2 instead. Reference Book: Star Wars Saga Edition Unknown Regions","description":"The Force shields you against ailments, toxins, and radiation poisoning, making you immune to Disease, Poison, and Radiation. Reference Book: Star Wars Saga Edition Unknown Regions You are particularly in tune with The Living Force. When you successfully use Search Your Feelings, you gain a Force Point that must be used before the end of the encounter. If you use this Force Point in a manner that would end in unfavorable results (per Search Your Feelings), you raise your Dark Side Score by 1. lf you use the Force Point in an action that would normally raise your Dark Side Score, you raise your Dark Side Score by 2 instead. Reference Book: Star Wars Saga Edition Unknown Regions","costNumeric":null,"tree":"Force Adept","treeId":"e35ee41362604227","tags":["action-economy","dark-side","defender","force","shields","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.equilibrium"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.328a880e60f2320f"}}},{"_id":"9d8aa3516b7fcd91","name":"Force Harmony","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Control","prerequisites":null,"benefit":"Once per encounter, activate a Force talent that requires a Force Point without spending one.","description":"Once per encounter, activate a Force talent that normally requires a Force Point without spending one.","costNumeric":null,"tree":"Control","treeId":"d3661aa9906bdc79","tags":["force"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_harmony"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5b949c8cd8e78ee8"}}},{"_id":"9842bdfdde735624","name":"Master of Elegance","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Duelist","prerequisites":"","benefit":"Prerequisites: Double Attack with either Advanced Melee Weapons, an Exotic Weapon (Melee), or Lightsabers; , Single Weapon Flourish I, Weapon Finesse When you wield only a single light melee weapon, or a single Lightsaber, once per turn on your turn, you can make a Full Attack Action as a Standard Action, instead of a Full-Round Action.","description":"Prerequisites: Double Attack with either Advanced Melee Weapons, an Exotic Weapon (Melee), or Lightsabers; , Single Weapon Flourish I, Weapon Finesse When you wield only a single light melee weapon, or a single Lightsaber, once per turn on your turn, you can make a Full Attack Action as a Standard Action, instead of a Full-Round Action.","class":"Melee Duelist","costNumeric":null,"category":"Melee Duelist","tree":"Melee Duelist","treeId":"1381bb8c9a838279","tags":["action-economy","lightsaber","melee","sustained-damage"]},"effects":[{"_id":"7e0e71c5-4333-442a-ae60-0b4a8d53f64b","name":"Master of Elegance","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.light_melee","mode":2,"value":"dex_bonus"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Master of Elegance"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.master_of_elegance"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.fc986d810732ff3a"}}},{"_id":"8a100f87553803ef","name":"Psychic Citadel","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Telepath","prerequisites":"","benefit":"Whenever another creature targets you with a Force Power with the [Mind-Affecting] descriptor, it automatically takes Force damage equal to 1d6 x your Wisdom modifier (minimum x1). Whenever you use a Force Power with the [Mind-Affecting] descriptor successfully against a target, until the end of your next turn you gain a +2 Force bonus on Skill Checks made to activate [Mind-Affecting] Force Powers and Force Talents against that same target.","description":"Whenever another creature targets you with a Force Power with the [Mind-Affecting] descriptor, it automatically takes Force damage equal to 1d6 x your Wisdom modifier (minimum x1). Whenever you use a Force Power with the [Mind-Affecting] descriptor successfully against a target, until the end of your next turn you gain a +2 Force bonus on Skill Checks made to activate [Mind-Affecting] Force Powers and Force Talents against that same target.","class":"Force Adept","costNumeric":null,"category":"Force Adept","tree":"Telepath","treeId":"d25dc04b0e16f107","tags":["force","force-offense","striker","support"]},"effects":[{"_id":"9a4e11f7-00fa-4f0a-92b4-b266da2befc6","name":"Psychic Citadel","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.will","mode":2,"value":"level"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Psychic Citadel"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.psychic_citadel"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.546034f073eab1fd"}}},{"_id":"0c07998f70bf4b83","name":"Single Weapon Flourish I","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Duelist","prerequisites":"Double Attack, Weapon Finesse","benefit":"With one light melee weapon or lightsaber, you can move your speed as a free action.","description":"When wielding a single light melee weapon or lightsaber, move your speed as a free action.","class":"Melee Duelist","costNumeric":null,"category":"Melee Duelist","tree":"Melee Duelist","treeId":"1381bb8c9a838279","tags":["action-economy","controller","feat-chain","lightsaber","melee","mobility","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.single_weapon_flourish_i"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.499cfbb7489b1244"}}},{"_id":"22322cfc7c51e834","name":"Single Weapon Flourish II","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Duelist","prerequisites":"Master of Elegance, Single Weapon Flourish I","benefit":"With one light melee weapon or lightsaber, you may make a full attack as a standard action (once per turn).","description":"Once per turn, make a full attack as a standard action when wielding a single light melee weapon or lightsaber.","class":"Melee Duelist","costNumeric":null,"category":"Melee Duelist","tree":"Melee Duelist","treeId":"1381bb8c9a838279","tags":["action-economy","feat-chain","lightsaber","melee","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.single_weapon_flourish_ii"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.bf23bf3704382723"}}},{"_id":"c101633f8c69fc63","name":"Weapon Specialization (Lightsabers)","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Duelist","tree":"Duelist","prerequisites":"","description":"Greater Weapon Focus (Lightsabers) You gain a +2 bonus on melee damage rolls with Lightsabers. This bonus stacks with the bonus granted by the Talent. Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. See also: Maiming Foes When you deal damage with a Lightsaber that is equal to or greater than both the target's current Hit Points and the target's Damage Threshold (that is, when you would deal enough damage to kill your target), you may choose to use this Talent. Instead of dealing full damage, you instead deal half damage to your target and move it -1 step on the Condition Track. In addition, you sever one of your target's arms at the wrist or elbow joint, or one of the target's legs at the knee or ankle joint (your choice). Severing part of an arm prevents the target from wielding weapons or using tools in that hand, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Severing part of a leg knocks the target Prone, reduces the target's Speed by half, reduces its Carrying Capacity by half, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Because of the severity of such an injury, losing part of a limb causes a Persistent Condition that can only be removed by having Surgery successfully performed on you. A Cybernetic Prosthesis negates these reductions and penalties. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","benefit":"Greater Weapon Focus (Lightsabers) You gain a +2 bonus on melee damage rolls with Lightsabers. This bonus stacks with the bonus granted by the Talent. Whenever you make multiple attacks with any type of Lightsaber as part of a Full Attack, you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. See also: Maiming Foes When you deal damage with a Lightsaber that is equal to or greater than both the target's current Hit Points and the target's Damage Threshold (that is, when you would deal enough damage to kill your target), you may choose to use this Talent. Instead of dealing full damage, you instead deal half damage to your target and move it -1 step on the Condition Track. In addition, you sever one of your target's arms at the wrist or elbow joint, or one of the target's legs at the knee or ankle joint (your choice). Severing part of an arm prevents the target from wielding weapons or using tools in that hand, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Severing part of a leg knocks the target Prone, reduces the target's Speed by half, reduces its Carrying Capacity by half, and imposes a -5 penalty on Skill Checks and Ability Checks keyed to Strength and Dexterity. Because of the severity of such an injury, losing part of a limb causes a Persistent Condition that can only be removed by having Surgery successfully performed on you. A Cybernetic Prosthesis negates these reductions and penalties. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","class":"","category":"","costNumeric":null,"treeId":"b3c5d90b5036f39b","tags":["burst-damage","condition-removal","controller","damage-reduction","defender","force","force-control","force-offense","leader","lightsaber","melee","mobility","scaling","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.00a9210772a64a19"}}},{"_id":"b7d41166d7c0311b","name":"Battle Strike","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You channel the Force to enhance your next melee attack. Your next melee attack this round gains a +1d6 bonus to damage.</p>","special":"<p>This bonus damage is Force damage and bypasses Damage Reduction.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["enhancement","damage","melee"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f177dc6d65f76de9"}}},{"_id":"86955e23713c9fa3","name":"Dark Rage","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Dark Rage"}}},{"_id":"95b4974ce532c190","name":"Surge","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"vital","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You use the Force to push your body beyond normal limits. You gain an additional move action this turn.</p>","special":"<p>This extra move action can be used to move or perform other move-action tasks.</p>","descriptor":["Vital"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["enhancement","action-economy","movement"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.1ac1084ca8f07114"}}},{"_id":"70ccdc48d4d8ac2f","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"d