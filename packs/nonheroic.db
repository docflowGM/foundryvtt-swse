item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"faec2fa1cd36747f","name":"Harm's Way","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Protection","prerequisites":"","benefit":"Whenever you take damage on behalf of an ally through the use of a Talent (including ), you gain Damage Reduction equal to your Class Level until the end of your next turn. Whenever you take damage on behalf of an ally through the use of a Talent (including ), your Damage Threshold is increased by 5 points. As a Swift Action, designate one adjacent ally. Until the end of your next turn, as long as that ally remains adjacent to you, you are considered to be providing that ally with Soft Cover against all attacks.","description":"Whenever you take damage on behalf of an ally through the use of a Talent (including ), you gain Damage Reduction equal to your Class Level until the end of your next turn. Whenever you take damage on behalf of an ally through the use of a Talent (including ), your Damage Threshold is increased by 5 points. As a Swift Action, designate one adjacent ally. Until the end of your next turn, as long as that ally remains adjacent to you, you are considered to be providing that ally with Soft Cover against all attacks.","class":"Soldier","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"cb5493f65f0bdb62"}],"_source":"fix5F-canonical"},"tree":"Protection","treeId":"c92c2cbc79b8a515","tags":["action-economy","damage-reduction","defender","mobility","positioning","soldier","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.harms_way"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.fde8157b6d097e12"}}},{"_id":"1d4abfcb3ae366ab","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d6+2","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":8,"flatDamageFormula":"1d6+2","useFlat":true}}}},{"_id":"4a391ad68e5e2e2f","name":"Ceremonial Staff","type":"weapon","img":"icons/svg/sword.