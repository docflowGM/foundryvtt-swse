Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"74faa4253c2e3aa7","name":"Cast Suspicion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Provocateur","prerequisites":"","benefit":"Whenever an ally within your line of sight is missed by a ranged attack, you can (as a Reaction, once per turn) designate one enemy adjacent to that ally. Compare the attack roll of the missed attack to the Reflex Defense of that enemy; if the attack would hit, the attack targets that enemy and is resolved as normal. Prerequisite: Whenever an enemy within your line of sight uses the Aid Another Action to grant one of its allies a bonus, you can (as a Reaction) designate one ally within your line of sight. The enemy automatically fails to aid its ally, and the ally you designate gains a +2 bonus on its next attack roll made before the end of your next turn. Prerequisites: , Friend or Foe As a Standard Action, make a Persuasion check against the Will Defense of one enemy within your line of sight that can hear and understand you. If your check result equals or exceeds the target's Will Defense, that target immediately makes an attack (as a Free Action) against another target of your choice. This can be a melee attack against an adjacent target or a ranged attack against a target within the attacker's Point-Blank Range. The target gains a +5 bonus to its Will Defense if it is of a higher level than you. This is a Mind-Affecting effect.","description":"Whenever an ally within your line of sight is missed by a ranged attack, you can (as a Reaction, once per turn) designate one enemy adjacent to that ally. Compare the attack roll of the missed attack to the Reflex Defense of that enemy; if the attack would hit, the attack targets that enemy and is resolved as normal. Prerequisite: Whenever an enemy within your line of sight uses the Aid Another Action to grant one of its allies a bonus, you can (as a Reaction) designate one ally within your line of sight. The enemy automatically fails to aid its ally, and the ally you designate gains a +2 bonus on its next attack roll made before the end of your next turn. Prerequisites: , Friend or Foe As a Standard Action, make a Persuasion check against the Will Defense of one enemy within your line of sight that can hear and understand you. If your check result equals or exceeds the target's Will Defense, that target immediately makes an attack (as a Free Action) against another target of your choice. This can be a melee attack against an adjacent target or a ranged attack against a target within the attacker's Point-Blank Range. The target gains a +5 bonus to its Will Defense if it is of a higher level than you. This is a Mind-Affecting effect.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Provocateur","treeId":"da34105c875650ae","tags":["action-economy","defender","leader","melee","noble","positioning","ranged","skills","social","striker","support"]},"effects":[{"_id":"c6a962d9-bdbf-4119-82bb-4d0344f3bf83","name":"Cast Suspicion","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.morale.suppressed","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Cast Suspicion"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.cast_suspicion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9408056ede41b43f"}}},{"_id":"00f049f28f9c3622","name":"Coordinate","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Leadership","prerequisites":null,"benefit":"All allies in line of sight gain +1 when using aid another (maximum +5).","description":"All allies gain +1 when using Aid Another, up to +5.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Leadership","canonicalName":"Coordinate","canonicalTree":"Bab +12","treeId":"5964237d22681dc0","tags":["noble","striker"]},"effects":[{"_id":"25b28077-6a3c-43d8-97ba-a128e768f614","name":"Coordinate","icon":"icons/svg/handshake.svg","changes":[{"key":"system.actions.aidAnother","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Coordinate"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.coordinate"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a52044feeab3fe05"}}},{"_id":"30be8cdb6f32ebe8","name":"Inspire Confidence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","description":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","controller","defender","leader","mobility","noble","striker","support"]},"effects":[{"_id":"1faa089c-9609-46d8-8543-9a68ace3553b","name":"Inspire Confidence","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Confidence"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_confidence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4d8882a28da30454"}}},{"_id":"7e39cde7c9eb3ec1","name":"Coufee","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+2","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Coufee","npc":{"flatAttackBonus":4,"flatDamageFormula":"1d4+2","useFlat":true}}}},{"_id":"d3a5aacd60fd87a7","name":"Nonheroic","type":"class","img":"icons/svg/mystery-man.svg","system":{"level":2,"classId":"nonheroic","class_name":"Nonheroic","base_class":false,"hitDie":"1d4","hitDieValue":4,"babProgression":"nonheroic","isNonheroic":true,"defenses":{"fortitude":0,"reflex":0,"will":0},"classSkills":["acrobatics","climb","deception","endurance","gatherInformation","initiative","jump","knowledgeBureaucracy","knowledgeGalacticLore","knowledgeLifeSciences","knowledgePhysicalSciences","knowledgeSocialSciences","knowledgeTactics","knowledgeTechnology","mechanics","perception","persuasion","pilot","ride","stealth","survival","swim","treatInjury","useComputer"],"class_skills":["acrobatics","climb","deception","endurance","gatherInformation","initiative","jump","knowledgeBureaucracy","knowledgeGalacticLore","knowledgeLifeSciences","knowledgePhysicalSciences","knowledgeSocialSciences","knowledgeTactics","knowle