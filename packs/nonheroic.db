ffects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"09f1af1a5f9ecfd7","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"179784932838ed14","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"0ab5b4e8adb43c6a","name":"Improved Move Light Object","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may make a Use the Force check to Move Light Object as a Swift Action instead of a Move Action. Using the light object as a projectile weapon requires a Move Action (instead of a Standard Action).","prerequisite":"Move Light Object","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may make a Use the Force check to Move Light Object as a Swift Action instead of a Move Action. Using the light object as a projectile weapon requires a Move Action (instead of a Standard Action).</p><p><strong>Related Power:</strong> Move Light Object</p><p><strong>Prerequisites:</strong> Move Light Object</p>","relatedPower":"Move Light Object"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.c406600924a7780e"}}},{"_id":"bfaa7ffb3e3c49ee","name":"Improved Sense Surroundings","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may use the Sense Surroundings application of the Use the Force Skill as a Free Action rather than a Swift Action.","prerequisite":"Sense Surroundings","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may use the Sense Surroundings application of the Use the Force Skill as a Free Action rather than a Swift Action.</p><p><strong>Related Power:</strong> Sense Surroundings</p><p><strong>Prerequisites:</strong> Sense Surroundings</p>","relatedPower":"Sense Surroundings"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.4955b5076ca5da89"}}},{"_id":"010e25b9e39e0b98","name":"Attune Weapon","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Force Item","prerequisites":null,"benefit":"Grant a melee weapon +1 attack.","description":"Gain +1 attack with a chosen melee weapon.","class":"Force Adept","costNumeric":null,"category":"Force Adept","tree":"Force Item","treeId":"01e443d93e47f9c4","tags":["force","force-offense","leader","melee","striker"]},"effects":[{"_id":"1fd6da0e-f546-4a44-a963-338b37a13313","name":"Attune Weapon","icon":"icons/svg/sword.svg","changes":[{"key":"system.attacks.melee","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Attune Weapon"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.attune_weapon"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.aa9b67c6737c2549"}}},{"_id":"be703c1a82eaa1be","name":"Charm Beast","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Felucian Shaman","prerequisites":"Force Blast","benefit":"Whenever you manage to shift the Attitude of a Beast to Indifferent or Friendly, you may treat that creature as a domesticated animal- but for you only (it remains undomesticated in its response to other creatures). Additionally, you may use this Beast as a Mount, as per the Ride skill, provided that it is at least one size category larger than you and has a comfortable place for you to sit. When you use the Force Blast Force Power, you can spend a Force Point to compare the result of your Use the Force check to the Reflex Defense of all other characters, creatures, and Droids within 2 squares of your target. If you exceed the Reflex Defense of those secondary targets, they also take damage from the Force Blast, and if you fail to exceed their Reflex Defense, they take half damage instead. This is considered to be an Area Attack against the secondary targets (but not against the original target). You can use the Telepathy application of the Use the Force skill as a Swift Action, and you automatically succeed (no roll required) if your target is a willing recipient on the same planet. You can spend a Force Point to infuse an unpowered melee weapon (one that does not require an Energy Cell) with the strength of The Force, making it resistant to the attacks of other Weapons. Infusing the weapon takes a Full-Round Action.","description":"Whenever you manage to shift the Attitude of a Beast to Indifferent or Friendly, you may treat that creature as a domesticated animal- but for you only (it remains undomesticated in its response to other creatures). Additionally, you may use this Beast as a Mount, as per the Ride skill, provided that it is at least one size category larger than you and has a comfortable place for you to sit. When you use the Force Blast Force Power, you can spend a Force Point to compare the result of your Use the Force check to the Reflex Defense of all other characters, creatures, and Droids within 2 squares of your target. If you exceed the Reflex Defense of those secondary targets, they also take damage from the Force Blast, and if you fail to exceed their Reflex Defense, they take half damage instead. This is considered to be an Area Attack against the secondary targets (but not against the original target). You can use the Telepathy application of the Use the Force skill as a Swift Action, and you automatically succeed (no roll required) if your target is a willing recipient on the same planet. You can spend a Force Point to infuse an unpowered melee weapon (one that does not require an Energy Cell) with the strength of The Force, making it resistant to the attacks of other Weapons. Infusing the weapon takes a Full-Round Action.","class":"Force Adept","costNumeric":null,"category":"Force Adept","tree":"Felucian Shaman","treeId":"8a61bf426391431b","tags":["action-economy","battlefield-control","defender","feat-chain","force","force-defense","force-offense","melee","mobility","positioning","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.charm_beast"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.bab9a1ce285f98b9"}}},{"_id":"76bb28d7bac3dc2d","name":"Command Beast","type":"talent","img":"icons/svg/aura.svg","system":{"tree":"Unknown","prerequisite":"","benefit":"","special":"","uses":{"current":0,"max":0,"perEncounter":false,"perDay":false}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Command Beast"}}},{"_id":"733042e104ba6333","name":"Damage Reduction 10","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Control","prerequisites":null,"benefit":"Gain DR 10 for one minute.","description":"Gain damage reduction 10 for one minute.","costNumeric":null,"tree":"Control","treeId":"d3661aa9906bdc79","tags":["defender","force"]},"effects":[{"_id":"a33bfc46-2971-4f80-b25b-3facd242fa76","name":"Damage Reduction 10","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damageReduction","mode":5,"value":"10"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Damage Reduction 10"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.damage_reduction_10"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.35b42e14e3ef7d0d"}}},{"_id":"ca8446ab9ccffc14","name":"Dark Side Savant","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Dark Side","prerequisites":"Prerequisites: At least one Talent from the Dark Side Talent Tree, Force Storm, Hatred","benefit":"You can spend a Force Point to increase the result of a Use the Force check made to activate a Force Power with the [Dark Side] descriptor. (Normally Force Points cannot be used to increase results of [Dark Side] or [Light Side] Force Powers.) Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - The Dark Side","description":"You can spend a Force Point to increase the result of a Use the Force check made to activate a Force Power with the [Dark Side] descriptor. (Normally Force Points cannot be used to increase results of [Dark Side] or [Light Side] Force Powers.) Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - The Dark Side","costNumeric":null,"tree":"Dark Side","treeId":"de95d37c72b1c4cd","tags":["dark-side","feat-chain","force","light-side","support","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.dark_side_savant"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.b47beb909e6fce63"}}},{"_id":"1c173723b3b24880","name":"Empower Weapon","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Force Item","prerequisites":"","benefit":"You can hurl Simple Weapons (Melee), or Advanced Melee Weapons your size or smaller as a Standard Action, treating it as a Thrown Weapon. The Thrown Weapon deals normal weapon damage if it hits. If the weapon deals piercing or slashing damage, it becomes embedded in your target, remaining there and causing an additional die of damage each round at the end of the target's turn, and also when it is removed (removing the embedded weapon is a Swift Action, and an adjacent ally can remove the embedded weapon for you). Your target must be within 6 squares of you. The weapon does not automatically return to you, but you can retrieve it with the Move Object Force Power (dealing an additional die of damage in the process, if the weapon is embedded in the target, as above). Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisite:","description":"You can hurl Simple Weapons (Melee), or Advanced Melee Weapons your size or smaller as a Standard Action, treating it as a Thrown Weapon. The Thrown Weapon deals normal weapon damage if it hits. If the weapon deals piercing or slashing damage, it becomes embedded in your target, remaining there and causing an additional die of damage each round at the end of the target's turn, and also when it is removed (removing the embedded weapon is a Swift Action, and an adjacent ally can remove the embedded weapon for you). Your target must be within 6 squares of you. The weapon does not automatically return to you, but you can retrieve it with the Move Object Force Power (dealing an additional die of damage in the process, if the weapon is embedded in the target, as above). Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisite:","class":"Force Adept","costNumeric":null,"category":"Force Adept","tree":"Force Item","treeId":"01e443d93e47f9c4","tags":["action-economy","controller","force","force-control","force-offense","melee","mobility","positioning","ranged","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.empower_weapon"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5218d5971b78119b"}}},{"_id":"0cacaf2f59096133","name":"Wild Sense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Beastwarden","prerequisites":"Charm Beast","benefit":"Once per turn, touch the mind of an indifferent or better beast within 12 squares and line of sight to use the beast’s Perception and line of sight as your own.","description":"Once per turn, touch the mind of a beast within 12 squares and line of sight to use its Perception and senses.","class":"Force Adept","costNumeric":null,"category":"Force Adept","tree":"Beastwarden","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.charm_beast"}],"_source":"canonical-csv"},"treeId":"ed899f9f41fc1391","tags":["feat-chain","force","perception","positioning","skills","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.wild_sense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.b6e75c52f5d66ade"}}},{"_id":"cb38116ee380603f","name":"Battle Strike","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You channel the Force to enhance your next melee attack. Your next melee attack this round gains a +1d6 bonus to damage.</p>","special":"<p>This bonus damage is Force damage and bypasses Damage Reduction.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["enhancement","damage","melee"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f177dc6d65f76de9"}}},{"_id":"a8033920dc99d23c","name":"Dark Rage","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"","special":"","descriptor":"","dcChart":"","maintainable":false,"inSuite":true,"uses":{"current":1,"max":1,"perDay":true}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Dark Rage"}}},{"_id":"fc0d7a6deb7ac4d8","name":"Force Grip","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":3,"discipline":"dark-side","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Concentration","effect":"<p>You use the Force to telekinetically choke or crush your target. The target takes damage each round based on your Use the Force check result.</p>","special":"<p>This is a Dark Side power. The target is immobilized while gripped.</p>","descriptor":["Dark Side","Telekinetic"],"dcChart":[{"dc":15,"effect":"2d6 damage/round","description":"Target takes 2d6 damage per round and is immobilized"},{"dc":20,"effect":"4d6 damage/round","description":"Target takes 4d6 damage per round and is immobilized"},{"dc":25,"effect":"6d6 damage/round + lift","description":"Target takes 6d6 damage per round, is immobilized, and lifted off ground"},{"dc":30,"effect":"8d6 damage/round + crush","description":"Target takes 8d6 damage per round and is being crushed (fort save or die)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["attack","damage","dark-side","telekinetic","immobilize"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f41a957f71e98a6a"}}},{"_id":"b3faaa6d635775aa","name":"Force Lightning","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":4,"discipline":"dark-side","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Instantaneous","effect":"<p>You unleash devastating arcs of Force Lightning from your fingertips. The target takes lightning damage based on your Use the Force check result.</p>","special":"<p>This is a Dark Side power. Using it gains you a Dark Side Point.</p>","descriptor":["Dark Side","Force Lightning"],"dcChart":[{"dc":15,"effect":"2d6 lightning damage","description":"Target takes 2d6 lightning damage"},{"dc":20,"effect":"4d6 lightning damage","description":"Target takes 4d6 lightning damage"},{"dc":25,"effect":"6d6 lightning damage + stun","description":"Target takes 6d6 lightning damage and is stunned for 1 round"},{"dc":30,"effect":"8d6 lightning damage + stun 1d4","description":"Target takes 8d6 lightning damage and is stunned for 1d4 rounds"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["attack","damage","dark-side","lightning"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.0a422b939edfad56"}}},{"_id":"be9298610127ccbc","name":"Force Slam","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One creature or object","duration":"Instantaneous","effect":"<p>You use telekinetic force to violently slam your target against a surface. The target takes 4d6 damage and is knocked prone.</p>","special":"<p>The target must be within 6 squares of a solid surface (wall, floor, ceiling).</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":97,"tags":["attack","damage","telekinetic","prone"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.462a6c23e00c4dfc"}}},{"_id":"a5fc2881502bc4fc","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"66166f6c0f51b9ce","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}},{"_id":"8830213431de7ed0","name":"Surge","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"vital","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You use the Force to push your body beyond normal limits. You gain an additional move action this turn.</p>","sp