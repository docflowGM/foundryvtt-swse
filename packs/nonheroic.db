tion Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"88d3b3f572d42522","name":"Leading Feint","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fencing","prerequisites":"Noble Fencing Style","benefit":"When you damage an opponent, you may attempt a Deception check to feint; if successful, one ally within 12 squares treats the target as flat-footed against your opponent.","description":"After damaging an opponent, you may feint to make the target flat-footed against an ally.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Fencing","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.noble_fencing_style"}],"_source":"canonical-csv"},"treeId":"9df067790c87e6bc","tags":["controller","feat-chain","noble","positioning","skills","social","striker","support","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.leading_feint"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d68318a928d3d5c7"}}},{"_id":"942df2b6da530682","name":"Noble Fencing Style","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fencing","prerequisites":"","benefit":"As a Reaction, you can designate an enemy you have just hit with a melee attack. The enemy takes only half damage from the attack, but takes a -5 penalty on attacks made against you until the end of your next turn. A single target may only be affected by this Talent once per round. This is a Mind-Affecting effect. Prerequisite: Whenever you successfully damage an opponent with a melee attack, you can make a Deception check to Feint against that target as a Swift Action. If successful, you designate an ally within 12 squares; your target is designated Flat-Footed against the first attack that ally makes against your target before the beginning of your next turn. Prerequisites: , Base Attack Bonus +5 Once per encounter, as a Reaction, you can make a single melee attack against an adjacent enemy who just damaged you. Prerequisites: , Base Attack Bonus +5 When you hit a character with a melee attack, you can choose to have the attack deal only half damage and switch places with that foe. Your foe must be no more than one size category larger than you, and you must end up occupying a space that was previously occupied by your target (And vice versa) to use this Talent. This movement does not provoke Attacks of Opportunity.","description":"As a Reaction, you can designate an enemy you have just hit with a melee attack. The enemy takes only half damage from the attack, but takes a -5 penalty on attacks made against you until the end of your next turn. A single target may only be affected by this Talent once per round. This is a Mind-Affecting effect. Prerequisite: Whenever you successfully damage an opponent with a melee attack, you can make a Deception check to Feint against that target as a Swift Action. If successful, you designate an ally within 12 squares; your target is designated Flat-Footed against the first attack that ally makes against your target before the beginning of your next turn. Prerequisites: , Base Attack Bonus +5 Once per encounter, as a Reaction, you can make a single melee attack against an adjacent enemy who just damaged you. Prerequisites: , Base Attack Bonus +5 When you hit a character with a melee attack, you can choose to have the attack deal only half damage and switch places with that foe. Your foe must be no more than one size category larger than you, and you must end up occupying a space that was previously occupied by your target (And vice versa) to use this Talent. This movement does not provoke Attacks of Opportunity.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Fencing","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"deceptionandpersuasion"}],"_source":"fix2-auto"},"treeId":"9df067790c87e6bc","tags":["action-economy","controller","melee","mobility","noble","positioning","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.noble_fencing_style"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.00c3231e4a4173fa"}}},{"_id":"28c1709faec67c45","name":"Personal Affront","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fencing","prerequisites":"Noble Fencing Style, base attack bonus +5","benefit":"Once per encounter, make a single melee attack against an adjacent enemy who just damaged you.","description":"Once per encounter, make a melee attack against an adjacent enemy who just damaged you.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Fencing","prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":5},{"type":"talent","id":"swse.talent.noble_fencing_style"}],"_source":"canonical-csv"},"treeId":"9df067790c87e6bc","tags":["feat-chain","melee","noble","positioning","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.personal_affront"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8b8c0f8c9d62f410"}}},{"_id":"1c847d21144325a9","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d10+3","damageType":"kinetic","atta