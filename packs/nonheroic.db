:1,"bonusTrainedSkills":1,"costNumeric":null},"effects":[],"folder":null,"sort":700,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.species.species-human"}}},{"_id":"44e4837548fa21cb","name":"Force Sensitivity","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"You can make Use the Force checks and gain access to Force Talents.","prerequisite":"Non-Droid","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["feat-chain","force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You can make <a href=\"/wiki/Use_the_Force\" title=\"Use the Force\">Use the Force</a> checks and gain access to <a href=\"/wiki/Force_Talents\" title=\"Force Talents\">Force Talents</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ddbeb23013d9e917"}}},{"_id":"7251e4af06a01816","name":"Force Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"You learn a number of Force powers equal to 1 + your Wisdom modifier.","prerequisite":"Force Sensitivity, Trained in Use the Force","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["feat-chain","force","jedi","striker"],"bonus_feat_for":["Jedi"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"forcePowerGrants":1,"description":{"value":"Learn a number of <a href=\"/wiki/Force_Powers\" title=\"Force Powers\">Force Powers</a> equal to 1 + your <a href=\"/wiki/Wisdom\" title=\"Wisdom\">Wisdom</a> modifier (minimum 1)."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"usetheforce"}],"_source":"canonical-csv"}},"effects":[{"_id":"d1c60a9b-78e6-4601-85a4-320794fa5a91","name":"Force Training","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Force Training","effectType":"passive_effect","flagType":"Force Training"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.9b7b869a86f39190"}}},{"_id":"f4e5724144457461","name":"Melee Defense","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"As a swift action, you may take a -5 penalty on melee attack rolls to gain a +5 bonus to your Reflex Defense against melee attacks until the start of your next turn.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["action-economy","defender","melee","mobility","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Trade attack bonus on melee attacks for a dodge bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"int","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.3a847230d573a623"}}},{"_id":"23fd274ea6a3e000","name":"Skill Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +5 bonus on all checks with the selected skill.","prerequisite":"Trained in the chosen skill","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","noble","non-force","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"f1b5d0d56d9691be","name":"Strong in the Force","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"Roll d8s instead of d6s when you spend a Force Point.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Roll d8s instead of d6s when you spend a <a class=\"mw-redirect\" href=\"/wiki/Force_Point\" title=\"Force Point\">Force Point</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.71892687abbed346"}}},{"_id":"021f024251aee940","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"305e9f8ab7bfff34","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"2cc7d46accaad2eb","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"0da239e9feb611e0","name":"Affliction","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith","prerequisites":"","benefit":"Once per encounter, as a Reaction when you damage a Force-sensitive opponent, the dark taint of your power allows you to sap some of the opponent's strength, and convert it to personal power, regaining one spent Force Power. Additionally, the target loses one Force Point. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide See also: Sith Alchemy Talent Tree","description":"Once per encounter, as a Reaction when you damage a Force-sensitive opponent, the dark taint of your power allows you to sap some of the opponent's strength, and convert it to personal power, regaining one spent Force Power. Additionally, the target loses one Force Point. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide See also: Sith Alchemy Talent Tree","class":"Sith Apprentice","costNumeric":null,"category":"Sith Apprentice","tree":"Sith","treeId":"d1037bc7a08ea80b","tags":["action-economy","dark-side","force","force-offense","jedi","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.affliction"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.776a0fa8ae532ccc"}}},{"_id":"d28e923b7c312658","name":"Dark Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Dark Side","prerequisites":"","benefit":"Power of the Dark Side Whenever an ally of equal or higher level than you is killed or reduced to 0 hit points within your line of sight, you gain a +2 Force bonus on attack rolls and damage rolls until the end of the encounter. (Since Force bonuses do not stack, you don't get a higher bonus if more than one ally falls in the same encounter.)","description":"Power of the Dark Side Whenever an ally of equal or higher level than you is killed or reduced to 0 hit points within your line of sight, you gain a +2 Force bonus on attack rolls and damage rolls until the end of the encounter. (Since Force bonuses do not stack, you don't get a higher bonus if more than one ally falls in the same encounter.)","costNumeric":null,"tree":"Dark Side","prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"cha","min":13},{"type":"talent","id":"swse.talent.power_of_the_dark_side"}],"_source":"canonical-csv"},"treeId":"de95d37c72b1c4cd","tags":["damage-reduction","dark-side","force","force-offense","scaling","striker","support"]},"effects":[{"_id":"b278be01-b200-4515-abdb-7137e70ffebf","name":"Dark Presence","icon":"icons/svg/moon.svg","changes":[{"key":"system.defenses.all","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Dark Presence"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.dark_presence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.606e14c428f1d159"}}},{"_id":"7a7aa868005448da","name":"Force Focus","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Control","prerequisites":null,"benefit":"DC 15 Use the Force check to regain one Force power.","description":"Make a Use the Force check to regain one expended Force power.","costNumeric":null,"tree":"Control","treeId":"d3661aa9906bdc79","tags":["force"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_focus"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.af51d4e76675b183"}}},{"_id":"47203712be5dbbc2","name":"Illusion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Krath","prerequisites":"","benefit":"As a Swift Action, you can reduce the penalty for large by one half (rounded down, minimum -1). You have a natural ability to use Dark Side artifacts, such as Sith Talismans and alchemical items. Once per encounter, you may spend a Force Point to treat the damage from a Sith Alchemical Weapon as though you had rolled the maximum damage on the dice. Once per encounter, using rudimentary Sith sorcery, you channel Dark Side energy in a manner that boosts one use of a Force Power. As a Swift Action, you can add 1 die of damage (if the Force Power deals damage) or extend the range of the Force Power by 6 squares (if it has a range beyond yourself or a single target). Using this Talent automatically adds the [Dark Side] descriptor to the Force Power used.","description":"As a Swift Action, you can reduce the penalty for large by one half (rounded down, minimum -1). You have a natural ability to use Dark Side artifacts, such as Sith Talismans and alchemical items. Once per encounter, you may spend a Force Point to treat the damage from a Sith Alchemical Weapon as though you had rolled the maximum damage on the dice. Once per encounter, using rudimentary Sith sorcery, you channel Dark Side energy in a manner that boosts one use of a Force Power. As a Swift Action, you can add 1 die of damage (if the Force Power deals damage) or extend the range of the Force Power by 6 squares (if it has a range beyond yourself or a single target). Using this Talent automatically adds the [Dark Side] descriptor to the Force Power used.","costNumeric":null,"tree":"Krath","treeId":"d29a7261c1be4b83","tags":["action-economy","damage-reduction","dark-side","force","force-offense","mobility","positioning","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.illusion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8793a955bce166d2"}}},{"_id":"a40d92bb9d2ceeda","name":"Power of the Dark Side","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Dark Side","prerequisites":"Dark Side Score equal to Wisdom Score","benefit":"Charisma 13 As a Standard Action, you grant yourself and all allies within 6 squares of you a +1 Force bonus to all Defenses until the end of the encounter. These bonuses are lost if you fall unconscious or die. Affected allies that move out of range lose the benefits for as long as they remain out of range. Prerequisite: Once per day, you can use a Force Power that normally takes a Standard Action or a Move Action as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Sometimes your anger consumes you. As a Swift Action, you can take a -5 penalty to your Will Defense to gain a +2 Force bonus on attack rolls. The penalty and bonus last until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever an effect would normally move you down the Condition Track, you may spend a Force Point and increase your Dark Side Score by 1 to negate that movement down the Condition Track. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Once per encounter as a Swift Action, you can return one Force Power with the [Dark Side] descriptor to your Force Power Suite without spending a Force Point. You can select this Talent multiple times. Each time you select it, you can use it one additional time per encounter. Reference Book: Star Wars Saga Edition Threats of the Galaxy As a Standard Action, you can spend a Force Point to drain the knowledge of an opponent you touch; you must succeed on a Use the Force check (DC equal to the target's Will Defense) to activate this Talent, and if you fail to activate this Talent, you may not try again on the same target for one day. If successful, you immediately become Trained in one Skill that the target is Trained in; if you are already Trained in that Skill, you instead gain Skill Focus in that Skill. This effect lasts for one day. Additionally, your target moves -1 Persistent step along the Condition Track, and the Persistent Condition can be removed only by resting for 8 hours. Additionally, you can choose to instead sift through the mind of the target, looking for a specific piece of knowledge or information. Doing so requires you to make a Perception check against the target's Will Defense; success indicates that you pull the relevant information from the target's mind. When you do so, you do not gain the bonus Trained Skill or Skill Focus normally granted by this Talent, but otherwise the Talent functions as normal. Using this Talent increases your Dark Side Score by 1. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual When you die, you become a Dark Side Spirit until the end of the encounter. You continue to occupy a space in this form, but other creatures can occupy the same space or move through your space without impediment. As a Standard Action, you can attempt to possess an adjacent target. You must succeed on a Use the Force check against an adjacent target's Will Defense. If your check result equals or exceeds the target's Will Defense, you deal 8d6 points of Stun damage to the target; if you reduce the target to 0 Hit Points or move it to the bottom of the Condition Track with this attack, you possess the target as though it were a willing host. Alternatively, as a Standard Action, you can transfer your essence into a single adjacent object, such as a Holocron or a Lightsaber. If you do so, you lie dormant within the object until another creature attempts to use that object, at which time you can emerge and attempt to possess the creature, as described above. If you do not possess a creature or object within 10 rounds of manifesting as a Dark Side Spirit, your spirit dissipates and ceases to exist. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: When you roll a Natural 20 on a Use the Force check to activate a Force Power that directly deals damage to a target, you can choose not to regain all of your spent Force Powers as normal and instead the targets damaged by the Force Power take half that damage again at the start of their next turn. Only Force Powers that directly damage the target are subject to this Talent, including Corruption, Force Blast, Force Grip, Force Lightning, Force Slam, Force Thrust (only when spending a Force Point), and Repulse (only when spending a Force Point). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: You can create balls of unnatural energy, enabling you to make a ranged attack roll against the Reflex Defense of one target within 12 squares and line of sight, dealing 2d6 points of energy damage to the target on a successful attack. Using this Talent increases your Dark Side Score by 1. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Swift Power When using a Force Power that directly inflicts damage, you treat the target's Damage Threshold as though it were 5 points lower when determining if the target moves along the Condition Track. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: Whenever your character moves 3 or more squares in a round you gain Concealment; you may choose not to use this Talent when you move.","description":"Charisma 13 As a Standard Action, you grant yourself and all allies within 6 squares of you a +1 Force bonus to all Defenses until the end of the encounter. These bonuses are lost if you fall unconscious or die. Affected allies that move out of range lose the benefits for as long as they remain out of range. Prerequisite: Once per day, you can use a Force Power that normally takes a Standard Action or a Move Action as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Sometimes your anger consumes you. As a Swift Action, you can take a -5 penalty to your Will Defense to gain a +2 Force bonus on attack rolls. The penalty and bonus last until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever an effect would normally move you down the Condition Track, you may spend a Force Point and increase your Dark Side Score by 1 to negate that movement down the Condition Track. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Once per encounter as a Swift Action, you can return one Force Power with the [Dark Side] descriptor to your Force Power Suite without spending a Force Point. You can select this Talent multiple times. Each time you select it, you can use it one additional time per encounter. Reference Book: Star Wars Saga Edition Threats of the Galaxy As a Standard Action, you can spend a Force Point to drain the knowledge of an opponent you touch; you must succeed on a Use the Force check (DC equal to the target's Will Defense) to activate this Talent, and if you fail to activate this Talent, you may not try again on the same target for one day. If successful, you immediately become Trained in one Skill that the target is Trained in; if you are already Trained in that Skill, you instead gain Skill Focus in that Skill. This effect lasts for one day. Additionally, your target moves -1 Persistent step along the Condition Track, and the Persistent Condition can be removed only by resting for 8 hours. Additionally, you can choose to instead sift through the mind of the target, looking for a specific piece of knowledge or information. Doing so requires you to make a Perception check against the target's Will Defense; success indicates that you pull the relevant information from the target's mind. When you do so, you do not gain the bonus Trained Skill or Skill Focus normally granted by this Talent, but otherwise the Talent functions as normal. Using this Talent increases your Dark Side Score by 1. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual When you die, you become a Dark Side Spirit until the end of the encounter. You continue to occupy a space in this form, but other creatures can occupy the same space or move through your space without impediment. As a Standard Action, you can attempt to possess an adjacent target. You must succeed on a Use the Force check against an adjacent target's Will Defense. If your check result equals or exceeds the target's Will Defense, you deal 8d6 points of Stun damage to the target; if you reduce the target to 0 Hit Points or move it to the bottom of the Condition Track with this attack, you possess the target as though it were a willing host. Alternatively, as a Standard Action, you can transfer your essence into a single adjacent object, such as a Holocron or a Lightsaber. If you do so, you lie dormant within the object until another creature attempts to use that object, at which time you can emerge and attempt to possess the creature, as described above. If you do not possess a creature or object within 10 rounds of manifesting as a Dark Side Spirit, your spirit dissipates and ceases to exist. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: When you roll a Natural 20 on a Use the Force check to activate a Force Power that directly deals damage to a target, you can choose not to regain all of your spent Force Powers as normal and instead the targets damaged by the Force Power take half that damage again at the start of their next turn. Only Force Powers that directly damage the target are subject to this Talent, including Corruption, Force Blast, Force Grip, Force Lightning, Force Slam, Force Thrust (only when spending a Force Point), and Repulse (only when spending a Force Point). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: You can create balls of unnatural energy, enabling you to make a ranged attack roll against the Reflex Defense of one target within 12 squares and line of sight, dealing 2d6 points of energy damage to the target on a successful attack. Using this Talent increases your Dark Side Score by 1. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Swift Power When using a Force Power that directly inflicts damage, you treat the target's Damage Threshold as though it were 5 points lower when determining if the target moves along the Condition Track. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: Whenever your character moves 3 or more squares in a round you gain Concealment; you may choose not to use this Talent when you move.","costNumeric":null,"tree":"Dark Side","treeId":"de95d37c72b1c4cd","tags":["action-economy","condition-removal","controller","damage-reduction","dark-side","defender","feat-chain","force","force-control","force-defense","force-offense","leader","light-side","lightsaber","melee","mobility","perception","positioning","ranged","scaling","skills","stealth","striker","support","sustained-damage","talent-chain"]},"effects":[{"_id":"b3ad7fe2-78a8-42b3-83dc-385122d061ed","name":"Power of the Dark Side","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Power of the Dark Side"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.power_of_the_dark_side"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.627bd3abd30b973f"}}},{"_id":"c2f16a0badbf54e5","name":"Swift Power","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Dark Side","prerequisites":"Power of the Dark Side","benefit":"Once per day, use a swift action in place of a move or standard action to activate a Force power.","description":"Once per day, activate a Force power as a swift action.","costNumeric":null,"tree":"Dark Side","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.power_of_the_dark_side"}],"_source":"canonical-csv"},"treeId":"de95d37c72b1c4cd","tags":["action-economy","controller","dark-side","feat-chain","force","force-control","mobility","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.swift_power"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.09609e71ba6cd4aa"}}},{"_id":"35e370774c5568e6","name":"Dark Rage","type":"force-power","img":"icons/svg/eye.svg","system":{"powerLevel":1,"discipline":"Unknown","useTheForce":"","time":"standard","range":"","target":"","duration":"","effect":"",