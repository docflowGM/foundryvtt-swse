","Damage Threshold":15,"Speed":"6 Squares","Melee Weapons":"Knife +4 (1d4+1)","Ranged Weapons":"Hold-Out Blaster Pistol +5 (3d4+2)","Attack Options":["Knife","Hold-Out Blaster Pistol"],"Force Powers":["Dark Rage","Mind Trick","Surge"],"Force Secrets":[],"Force Techniques":[],"Strength":"8","Dexterity":"10","Constitution":"10","Intelligence":"12","Wisdom":"14","Charisma":"13","Talents":["Dark Presence","Power of the Dark Side","Presence"],"Feats":["Force Sensitivity","Force Training","Linguist","Skill Training (Knowledge (Galactic Lore))","Skill Training (Persuasion)","Skill Training (Use Computer)","Skill Training (Use the Force)","Weapon Proficiency (Pistols)","Weapon Proficiency (Simple Weapons)"],"Trained Skills":["Deception","Perception","Persuasion","Use the Force"],"Gear":"Hold-Out Blaster Pistol , Knife","Melee Attack":"","Ranged Attack":"","Species Bonuses":["Attack Bonus"]},"mode":"play","sourcePack":"nonheroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1,"statblockAuthority":true,"normalizationVersion":2,"nonheroicLegalSkeletonVersion":1,"nonheroicLegalSkeletonStatus":"partial-legal-ready"},"npcLegalReview":{"phase10_10":{"mixedClassItemsCreated":true,"createdClassIds":["nonheroic","noble"],"statblockValuesPreserved":true,"nonheroicFirstValid":true}}}}}
