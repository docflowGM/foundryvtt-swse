 , Portable Computer , Utility Belt</p>\n<p><strong>Attack Options:</strong> Knife, Blaster Pistol, Hold-Out Blaster Pistol</p>","derived":{},"npcProfile":{"kind":"nonheroic","mode":"play","sourceAuthority":"statblock","legalProfile":"nonheroic-to-heroic","legalState":"legal-with-statblock-overrides","importMode":"play","playReady":true,"statblockAuthority":true,"sourcePack":"nonheroic","normalizationVersion":2,"authority":{"hp":"statblock","defenses":"statblock","bab":"statblock","attacks":"statblock","skills":"statblock","damageThreshold":"statblock","abilities":"statblock","features":"statblock"},"progressionReady":true,"progressionSkeleton":{"version":1,"source":"nonheroic-compendium-phase10.6","status":"mixed-class-items-created","bucket":"mixed","nonheroicFirstRule":"nonheroic-levels-must-precede-heroic-levels","nonheroicFirstValid":true,"totalLevels":7,"entries":[{"order":1,"classId":"nonheroic","name":"Nonheroic","levels":3,"source":"raw.Nonheroic Level","confidence":"exact"},{"order":2,"classId":"scoundrel","name":"Scoundrel","levels":4,"source":"raw.Class Levels","confidence":"exact"}],"warnings":[],"classItemsCreated":true,"statblockValuesPreserved":true,"classItemCreation":{"phase":"10.10","status":"created","createdClassIds":["nonheroic","scoundrel"],"missingClassIds":[],"statblockValuesPreserved":true,"note":"Mixed nonheroic-to-heroic compendium actor received class item skeletons from its progression skeleton. HP, defenses, BAB, skills, attacks, feats, talents, Force powers, and raw source data were not recalculated."},"progressionLegalCandidate":true,"mixedNonheroicHeroicClassItemsCreated":true}}},"items":[{"_id":"7f205d419607032e","name":"Nonheroic","type":"species","img":"icons/svg/mystery-man.svg","system":{"size":"medium","speed":6,"abilities":{},"skillBonuses":{},"special":"","languages":[],"source":"","description":"","tags":[]},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Nonheroic"}}},{"_id":"9842f07db1d1d2d9","name":"Point-