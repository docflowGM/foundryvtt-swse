orce","positioning","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Take a -2 penalty on a ranged attack roll to deal +1 die of damage."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.94b8751efb03536a"}}},{"_id":"5310441fb8ed9964","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"bacfd4d4813fa9d0","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"3c63e7dc12777167","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"8f2b864bb4d66cfd","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"1899039a1027260b","name":"Acute Senses","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Master Scout","prerequisites":"","benefit":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","description":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Master Scout","treeId":"dca33c0215264a02","tags":["action-economy","armor","controller","damage-reduction","defender","force","force-control","force-defense","force-offense","melee","mobility","positioning","ranged","scout","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.acute_senses"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f0166d26d9f6252a"}}},{"_id":"b6bfda5448053af7","name":"Expert Tracker","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Awareness","prerequisites":"Acute Senses","benefit":"No penalty on Survival checks to track at normal speed.","description":"Track at normal speed without penalty.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Awareness","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.acute_senses"}],"_source":"canonical-csv"},"treeId":"1c48d1cd9ab1f5c8","tags":["feat-chain","mobility","scout","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.expert_tracker"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.16e18057bc92365c"}}},{"_id":"c8482bfc4bf68cf2","name":"Hunter's Mark","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Bounty Hunter","prerequisites":"","benefit":"Once per encounter as a Free Action, you may designate an opponent. For the rest of the encounter, when you succeed on a melee or ranged attack against that opponent, you gain a bonus on damage equal to your Class Level. Your skill as a Bounty Hunter is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. You may choose to reroll any Gather Information checks made to Locate Individual, but you must accept the result of the reroll, even if it is worse. Prerequisites: , Hunter's Target This Talent applies only to an opponent you've designated as your Hunter's Target. Any attack or effect originating from the target that would normally move you along the Condition Track does not, in fact, move you along the Condition Track. Prerequisites: , Hunter's Target Prerequisites: , Hunter's Target, Nowhere to Hide Prerequisites: , Hunter's Target","description":"Once per encounter as a Free Action, you may designate an opponent. For the rest of the encounter, when you succeed on a melee or ranged attack against that opponent, you gain a bonus on damage equal to your Class Level. Your skill as a Bounty Hunter is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. You may choose to reroll any Gather Information checks made to Locate Individual, but you must accept the result of the reroll, even if it is worse. Prerequisites: , Hunter's Target This Talent applies only to an opponent you've designated as your Hunter's Target. Any attack or effect originating from the target that would normally move you along the Condition Track does not, in fact, move you along the Condition Track. Prerequisites: , Hunter's Target Prerequisites: , Hunter's Target, Nowhere to Hide Prerequisites: , Hunter's Target","class":"Bounty Hunter","costNumeric":null,"category":"Bounty Hunter","tree":"Bounty Hunter","treeId":"a47ed82a822e3962","tags":["action-economy","condition-removal","controller","dual-wield","melee","mobility","positioning","ranged","scoundrel","skills","social","stealth","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hunters_mark"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.74fb6b37af983a4c"}}},{"_id":"55a07b3de99750fb","name":"Hunter's Target","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Bounty Hunter","prerequisites":"Quick Draw","benefit":"As a Standard Action, you can instill bone-chilling fear in an opponent whom you selected for your . Make a Persuasion check against your target's Will Defense. If you equal or exceed your target's Will Defense, that target takes a -5 penalty to its Will Defense. This is a Mind-Affecting effect. The penalty remains as long as you have line of sight to your target and immediately ends if the line of sight is broken. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Once per turn, whenever an opponent whom you selected for your attempts to Withdraw, you can make an Attack of Opportunity against that target. Reference Book: Star Wars Saga Edition Unknown Regions You are fast with the binders. As a Swift Action, when you successfully use the Grab Action against a target, you can use Binder Cuffs or similar restraints to bind one of the target's arms to one of your arms or to an adjacent object. You cannot use improvised materials, such as Mesh Tape, for this Talent, and the binders must be in your hands or readily available. You and the target both take a -2 penalty to attack rolls and Reflex Defense while bound together. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Whenever you damage an opponent whom you selected for your , all allies gain a +2 bonus on their next attack roll against that opponent until the start of your next turn.","description":"As a Standard Action, you can instill bone-chilling fear in an opponent whom you selected for your . Make a Persuasion check against your target's Will Defense. If you equal or exceed your target's Will Defense, that target takes a -5 penalty to its Will Defense. This is a Mind-Affecting effect. The penalty remains as long as you have line of sight to your target and immediately ends if the line of sight is broken. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Once per turn, whenever an opponent whom you selected for your attempts to Withdraw, you can make an Attack of Opportunity against that target. Reference Book: Star Wars Saga Edition Unknown Regions You are fast with the binders. As a Swift Action, when you successfully use the Grab Action against a target, you can use Binder Cuffs or similar restraints to bind one of the target's arms to one of your arms or to an adjacent object. You cannot use improvised materials, such as Mesh Tape, for this Talent, and the binders must be in your hands or readily available. You and the target both take a -2 penalty to attack rolls and Reflex Defense while bound together. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Whenever you damage an opponent whom you selected for your , all allies gain a +2 bonus on their next attack roll against that opponent until the start of your next turn.","class":"Bounty Hunter","costNumeric":null,"category":"Bounty Hunter","tree":"Bounty Hunter","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.hunters_mark"}],"_source":"canonical-csv"},"treeId":"a47ed82a822e3962","tags":["action-economy","defender","feat-chain","mobility","positioning","scoundrel","skills","social","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hunters_target"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.907906934ba3c563"}}},{"_id":"c442f4934b80525a","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+7","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"descrip