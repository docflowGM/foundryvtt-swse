on), Weapon Specialization (Chosen Weapon)","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["damage-reduction","defender","soldier","striker"]},"effects":[{"_id":"7a2683eb-2396-4638-aa86-e28807081035","name":"Greater Weapon Focus","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks.melee","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Greater Weapon Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.greater_weapon_focus"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.642c6c8643db7470"}}},{"_id":"d55bc5957ee9a060","name":"Greater Weapon Specialization","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"Greater Weapon Focus, Weapon Specialization","benefit":"Gain +2 damage with the chosen proficient weapon.","description":"Gain +2 additional damage with a chosen proficient weapon.","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Weapon Master","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.weapon_specialization"}],"_source":"canonical-csv"},"treeId":"2f720d8b061f9bd0","tags":["feat-chain","soldier","striker","talent-chain"]},"effects":[{"_id":"771be58e-c672-412d-af10-303bcd8b76b4","name":"Greater Weapon Specialization","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.melee","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Greater Weapon Specialization"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.greater_weapon_specialization"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e9820b341bf94de1"}}},{"_id":"6fcdcd9a8ee80ab3","name":"Penetrating Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"Weapon Focus (Chosen Weapon)","benefit":"This replaces the effects of the Talent. Choose one Exotic Weapon or weapon group with which you're proficient. You gain a +1 bonus on attack rolls with the chosen Exotic Weapon or weapon from the chosen group. This bonus stacks with the bonus granted by the Weapon Focus feat. You may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group.","description":"This replaces the effects of the Talent. Choose one Exotic Weapon or weapon group with which you're proficient. You gain a +1 bonus on attack rolls with the chosen Exotic Weapon or weapon from the chosen group. This bonus stacks with the bonus granted by the Weapon Focus feat. You may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["feat-chain","leader","scaling","soldier","striker","talent-chain"]},"effects":[{"_id":"a0fba2f5-3da6-476e-9ac5-900be2d16e6b","name":"Penetrating Attack","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.combat.weaponGroupDRReduction","mode":2,"value":"5"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Penetrating Attack","effectType":"dr_reduction","weaponGroupSpecific":true,"notes":"Weapon group specific - applies when using designated weapon group"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.penetrating_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7d547902b8d9109e"}}},{"_id":"b40cf9996545d299","name":"Weapon Specialization","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Combat","prerequisites":"Weapon Focus","benefit":"+2 melee damage.","description":"Gain +2 damage with a chosen weapon.","class":"Jedi","costNumeric":null