ip":{"default":0},"flags":{"swse":{"id":"swse.talent.fools_luck"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5319a796f2c4ff64"}}},{"_id":"ae0e5ac1265715d8","name":"Impel Ally I","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mastermind","prerequisites":"","benefit":"You can spend two Swift Actions to grant one ally the ability to take a Standard Action or Move Action. The ally must move immediately on your turn, before you do anything else, or else the opportunity is wasted. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisites: , I Once per encounter, you can spend three Swift Actions on consecutive turns to grant one ally the ability to take a Standard Action and a Move Action. The ally must act immediately on your turn when the final Swift Action is spent, before you do anything else, or the opportunity is wasted. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , I As a Standard Action, you can designate a target to be the object of your allies' wrath. While your allies have line of sight to you or until you are unconscious or dead, your allies gain a +2 morale bonus on attack rolls against the target and a +2 morale bonus on Skill Checks against that target. You can designate a new target on any round by using another Standard Action. You can only use this Talent against one opponent at a time. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , I When an ally uses an Action granted to him or her by you, the ally can reroll any attack or check made during that Action, taking the better result. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , I Once per encounter, you can spend three Swift Actions on consecutive turns to increase the speed of all allies within your line of sight of you by 2. The increased speed lasts until the start of your next turn after the third Swift Action is spent. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"You can spend two Swift Actions to grant one ally the ability to take a Standard Action or Move Action. The ally must move immediately on your turn, before you do anything else, or else the opportunity is wasted. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisites: , I Once per encounter, you can spend three Swift Actions on consecutive turns to grant one ally the ability to take a Standard Action and a Move Action. The ally must act immediately on your turn when the final Swift Action is spent, before you do anything else, or the opportunity is wasted. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , I As a Standard Action, you can designate a target to be the object of your allies' wrath. While your allies have line of sight to you or until you are unconscious or dead, your allies gain a +2 morale bonus on attack rolls against the target and a +2 morale bonus on Skill Checks against that target. You can designate a new target on any round by using another Standard Action. You can only use this Talent against one opponent at a time. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , I When an ally uses an Action granted to him or her by you, the ally can reroll any attack or check made during that Action, taking the better result. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , I Once per encounter, you can spend three Swift Actions on consecutive turns to increase the speed of all allies within your line of sight of you by 2. The increased speed lasts until the start of your next turn after the third Swift Action is spent. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Mastermind","treeId":"560cc7994b357a0d","tags":["action-economy","controller","leader","mobility","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.impel_ally_i"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.aa32a31a179fe5c1"}}},{"_id":"67b31a5d867f3ced","name":"Impel Ally II","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mastermind","prerequisites":"Impel Ally I","benefit":"Designated ally can make a standard or move action immediately or the effect is wasted.","description":"An ally may immediately take a move or standard action or lose it.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Mastermind","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.impel_ally_i"}],"_source":"canonical-csv"},"treeId":"560cc7994b357a0d","tags":["action-economy","controller","feat-chain","mobility","support","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.impel_ally_ii"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.b11a87e70f957ed2"}}},{"_id":"a3c4d1e834a9c7d2","name":"Inspire Fear I","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Infamy","prerequisites":"","benefit":"As , except that the penalty increases to -2. Prerequisites: , I As , except that the penalty increases to -5. Your reputation as a Crime Lord is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. Prerequisites: , I, II, Notorious Any opponent that is reduced to half Hit Points or fewer while within 6 squares of you takes a -2 penalty on all attack rolls and Skill Checks for the duration of the encounter. This is a Mind-Affecting Fear effect.","description":"As , except that the penalty increases to -2. Prerequisites: , I As , except that the penalty increases to -5. Your reputation as a Crime Lord is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. Prerequisites: , I, II, Notorious Any opponent that is reduced to half Hit Points or fewer while within 6 squares of you takes a -2 penalty on all attack rolls and Skill Checks for the duration of the encounter. This is a Mind-Affecting Fear effect.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Infamy","treeId":"c1be604242cb328f","tags":["damage-reduction","positioning","skills","social","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_fear_i"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.cf4b1e5b126a2a7e"}}},{"_id":"4b241a17518b9432","name":"Inspire Fear II","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Infamy","prerequisites":"Inspire Fear I","benefit":"Increase penalties to -2 on affected rolls.","description":"Increase Inspire Fear penalties to –2.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Infamy","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.inspire_fear_i"}],"_source":"canonical-csv"},"treeId":"c1be604242cb328f","tags":["feat-chain","talent-chain"]},"effects":[{"_id":"93101939-886b-4faf-a5cd-092f86e11d0f","name":"Inspire Fear II","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.morale.penalty","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Fear II"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_fear_ii"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.71bc6b43ab504b90"}}},{"_id":"58045d467e476d54","name":"Inspire Fear III","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Infamy","prerequisites":"Inspire Fear II","benefit":"Increase penalties to -5 on affected rolls.","description":"Increase Inspire Fear penalties to –5.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Infamy","treeId":"c1be604242cb328f","tags":["feat-chain","talent-chain"]},"effects":[{"_id":"6faffa94-f0e3-49f2-9f5d-28c547b44f0b","name":"Inspire Fear III","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.morale.penalty","mode":2,"value":"5"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Fear III"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_fear_iii"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.bd11bfb793096483"}}},{"_id":"1acfd6435c7998f8","name":"Knack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fortune","prerequisites":"","benefit":"Once per day, you can reroll an attack roll and take the better result. You can select this Talent multiple times; each time you select this Talent, you can use it one additional time per day. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot You are possessed of incredible luck and an uncanny ability to succeed where others would fail. You can use each of the following actions once per encounter as a Standard Action: Elude Enemy: Make a single melee or ranged attack against any target within your Range. If you damage the target, you gain a +2 bonus to your Reflex Defense against this target until the beginning of your next turn. Escape: Make a single melee or ranged attack against any target within your Range. If that target successfully damages you before the start of your next turn, you can immediately move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Make your Own Luck: Make a single melee or ranged attack against any target within your Range. If you miss this target, you gain a +2 bonus on your next attack roll. Reference Book: Star Wars Saga Edition Scum and Villainy Once per encounter, as a Reaction, you become immune to all Mind-Affecting effects until the end of your next turn (you can choose to ignore this for beneficial effects). Any Mind-Affecting effects currently afflicting you are also removed, though you can choose to retain any beneficial effects you currently have. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisite: A successful hit against you is mitigated by an item you just happen to be wearing or carrying, or glances off your armor or clothing in just the right way. Once per encounter, as a Reaction, you can negate the damage from a single attack that would normally reduce you to 0 Hit Points. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot When making a ranged attack against a target with Cover, you can choose to reduce the benefit of that target's Cover by one step, from Improved Cover to Cover, or Cover to no Cover. You deal only half damage with this attack. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can consider any single d20 roll of 16 or higher to be a Natural 20. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can reroll the damage of one attack, keeping the better of the two results. Gambler's Fortune Talent data created by Sterling Hershey (source). Prerequisites: , Trained in Chosen Skill Select one of the following Skills: Knowledge (Any), Mechanics, Perception, or Use Computer. When making a reroll for that Skill, you may keep the better result.","description":"Once per day, you can reroll an attack roll and take the better result. You can select this Talent multiple times; each time you select this Talent, you can use it one additional time per day. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot You are possessed of incredible luck and an uncanny ability to succeed where others would fail. You can use each of the following actions once per encounter as a Standard Action: Elude Enemy: Make a single melee or ranged attack against any target within your Range. If you damage the target, you gain a +2 bonus to your Reflex Defense against this target until the beginning of your next turn. Escape: Make a single melee or ranged attack against any target within your Range. If that target successfully damages you before the start of your next turn, you can immediately move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Make your Own Luck: Make a single melee or ranged attack against any target within your Range. If you miss this target, you gain a +2 bonus on your next attack roll. Reference Book: Star Wars Saga Edition Scum and Villainy Once per encounter, as a Reaction, you become immune to all Mind-Affecting effects until the end of your next turn (you can choose to ignore this for beneficial effects). Any Mind-Affecting effects currently afflicting you are also removed, though you can choose to retain any beneficial effects you currently have. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisite: A successful hit against you is mitigated by an item you just happen to be wearing or carrying, or glances off your armor or clothing in just the right way. Once per encounter, as a Reaction, you can negate the damage from a single attack that would normally reduce you to 0 Hit Points. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot When making a ranged attack against a target with Cover, you can choose to reduce the benefit of that target's Cover by one step, from Improved Cover to Cover, or Cover to no Cover. You deal only half damage with this attack. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can consider any single d20 roll of 16 or higher to be a Natural 20. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Lucky Shot Once per encounter, you can reroll the damage of one attack, keeping the better of the two results. Gambler's Fortune Talent data created by Sterling Hershey (source). Prerequisites: , Trained in Chosen Skill Select one of the following Skills: Knowledge (Any), Mechanics, Perception, or Use Computer. When making a reroll for that Skill, you may keep the better result.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Fortune","treeId":"cee9b9398682b7d0","tags":["action-economy","armor","controller","damage-reduction","defender","mechanics","melee","mobility","perception","positioning","ranged","scaling","scoundrel","skills","slicing","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.knack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ac6baadb9d65ff7f"}}},{"_id":"b1844a12b5d1e615","name":"Lucky Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fortune","prerequisites":"Knack","benefit":"Once per day, reroll an attack roll.","description":"Once per day, reroll an attack roll and take the better result.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Fortune","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.knack"}],"_source":"canonical-csv"},"treeId":"cee9b9398682b7d0","tags":["feat-chain","ranged","scoundrel","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.lucky_shot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5fbf1a3504865fba"}}},{"_id":"dc7e562ae8f2c436","name":"Skirmisher","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"When you move at least 2 squares before your attack and end your move in a different square from where you started, you gain a +1 bonus to all your Defenses until the start of your next turn. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Sneak Attack Whenever you would gain the benefit of the Talent and you successfully hit your opponent, you deal Sneak Attack damage in addition to the normal damage dealt by the attack. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"When you move at least 2 squares before your attack and end your move in a different square from where you started, you gain a +1 bonus to all your Defenses until the start of your next turn. Reference Book: Star Wars Saga Edition Galaxy at War Prerequisites: , Sneak Attack Whenever you would gain the benefit of the Talent and you successfully hit your opponent, you deal Sneak Attack damage in addition to the normal damage dealt by the attack. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["controller","defender","mobility","positioning","precision","scoundrel","striker"]},"effects":[{"_id":"b27e05f0-9859-46a5-92ab-7f844073dc03","name":"Skirmisher","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Skirmisher"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.skirmisher"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7b23e0812d6a8985"}}},{"_id":"0befc0a71eda9e18","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+6","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":9,"flatDamageFormula":"1d4+6","useFlat":true}}}},{"_id":"4462b56edd036bdc","name":"Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+8","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":500,"equipped":true,"description":"<p>The standard sidearm used throughout the galaxy. Reliable, common, and effective at close to medium range.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":500,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":13,"flatDamageFormula":"3d8+8","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Bith","Nonheroic Level":0,"Class Levels":{"Medium Bith Scoundrel":7,"Crime Lord":5,"Gunslinger":2},"Force Points":4,"Dark Side Points":14,"Languages":["Basic","Bith","Huttese"],"Unassigned Languages":1,"Reflex Defense":30,"Flat-Footed Defense":28,"Fortitude Defense":24,"Will Defense":30,"Hit Points":"65","Damage Threshold":24,"Speed":"6 Squares","Melee Weapons":"Unarmed +9 (1d4+6)","Ranged Weapons":"Blaster Pistol +13 (3d8+8)","Attack Options":["Unarmed","Blaster Pistol"],"Force Powers":[],"Force Secrets":[],"Force Techniques":[],"Strength":"9","Dexterity":"15","Constitution":"10","Intelligence":"14","Wisdom":"14","Charisma":"16","Talents":["Deceptive Shot","Fool's Luck","Impel Ally I","Impel Ally II","Inspire Fear I","Inspire Fear II","Inspire Fear III","Knack","Lucky Shot","Skirmisher"],"Feats":["Dual Weapon Mastery I","Dual Weapon Mastery II","Quick Draw","Point-Blank Shot","Precise Shot","Running Attack","Skill Focus (Deception)","Skill Training (Persuasion)","Weapon Focus (Pistols)","Weapon Proficiency (Pistols)","Weapon Proficiency (Simple Weapons)"],"Trained Skills":["Acrobatics","Deception","Gather Information","Initiative","Perception","Persuasion","Stealth"],"Gear":"Heavy Blaster Pistol (2), Comlink (Short-Range), Datapad , 500 credits, Dark Clothing, Various Personal Belongings","Melee Attack":"","Ranged Attack":"","Species Bonuses":["Attack Bonus"],"Species Traits":["Evolved Intellect","Meditative Trace","Scent"]},"mode":"play","sourcePack":"nonheroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1,"statblockAuthority":true,"normalizationVersion":2,"nonheroicLegalSkeletonVersion":1,"nonheroicLegalSkeletonStatus":"heroic-profile"}}}}
