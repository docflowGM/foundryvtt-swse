also makes you lose dodge bonuses. Also, dodge bonuses stack with each other, unlike most other types of bonuses.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":84,"tags":["action-economy","defender","evasion","feat-chain","non-force","scaling","scout","striker"],"bonus_feat_for":["Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain a +1 dodge bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a> against a selected target."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13}],"_source":"canonical-csv"}},"effects":[{"name":"Dodge","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"feat-defense-bonus","source":"Dodge","defenseType":"reflex"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.45366d4f3a5e443d"}}},{"_id":"c4669fdcb2e8153b","name":"Point-Blank Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on ranged attacks and damage against foes within Point-Blank <a class=\"mw-redirect\" href=\"/wiki/Range\" title=\"Range\">Range</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.05459ac4d439f229"}}},{"_id":"1a5b7d610729d699","name":"Skill Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You become trained in one additional skill. You may take this feat mul