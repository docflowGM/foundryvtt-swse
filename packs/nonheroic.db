","mobility","non-force","ranged","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You ignore <a class=\"mw-redirect\" href=\"/wiki/Soft_Cover\" title=\"Soft Cover\">Soft Cover</a> when making a ranged attack."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":4}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.56367f3943ee8c17"}}},{"_id":"c28bb3b9be7eaffb","name":"Toughness","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain +5 hit points.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["non-force","scout","soldier","striker"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +1 Hit Point per Character Level."}},"effects":[{"name":"Toughness","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.hitPoints.bonusPerLevel","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"hit-points","perLevel":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.11db29efd899c438"}}},{"_id":"1ac0f506be5f0d45","name":"Triple Crit","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"When you score a critical hit with the selected weapon group, you deal triple damage instead of double.","prerequisite":"Weapon Focus with selected weapon group, base attack bonus +12","special":"","normalText":"","sourcebook":"Galaxy at War","page":27,"tags":["feat-chain","non-force","precision","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Deal triple damage on a <a class=\"mw-redirect\" href=\"/wiki/Critical_Hit\" title=\"Critical Hit\">Critical Hit</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":8}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.3d4a4e93ced26712"}}},{"_id":"a1875ff68c0873d9","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"05067fd590a3de49","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"887929085a677dd0","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"f7612cfa0afec00b","name":"Dastardly Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","tree":"Misfortune","prerequisites":"Combat Reflexes","description":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","benefit":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","class":"","category":"","costNumeric":null,"treeId":"67b59e020c1660eb","tags":["condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","lightsaber","melee","mobility","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9e4345faaaa94dd8"}}},{"_id":"1b4a58b271d7d311","name":"Deceptive Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Gunslinger","prerequisites":null,"benefit":"Target in line of sight within 6 squares; Deception vs Will imposes loss of Dexterity to Defense until next turn.","description":"Make a Deception check vs Will Defense; if successful, the target loses Dexterity to Defense until the end of your next turn.","class":"Gunslinger","costNumeric":null,"category":"Gunslinger","tree":"Gunslinger","treeId":"cb6f775cd227a3e3","tags":["defender","positioning","ranged","skills","social"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deceptive_shot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.b1afecfea833a2a5"}}},{"_id":"bbba80e3f05f67a5","name":"Multiattack Proficiency (pistols)","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Gunslinger","prerequisites":"","benefit":"Dual Weapon Mastery I, Weapon Focus (Pistols) Immediately after making a Full Attack where you attack with two Pistols, you may move up to your Speed as a Free Action. Reference Book: Star Wars Saga Edition Galaxy of Intrigue You are a master of the elegant, if archaic, custom of dueling with Pistols. You can use each of the following Actions once per encounter as a Standard Action: End Game: You make a single ranged attack with a Pistol against an opponent within Range. The opponent's Damage Threshold is halved (rounded down) for the purpose of this attack. Snap Aiming: You make a single ranged attack with the benefits of Aiming. Stand Ready: You gain a +4 bonus to your Reflex Defense until the end of your next turn and make a single ranged attack. Reference Book: Star Wars Saga Edition Scum and Villainy If you are within 6 squares of a target and are armed with a Pistol or a Rifle, you can act as though you occupied the nearest square adjacent to the target for purposes of determining whether or not you or any allies are Flanking that target. You may only be considered to be Flanking a single target at a time. You must spend a Swift Action on your turn to designate the target you Flank at range. Reference Book: Star Wars Saga Edition Unknown Regions When moving away from a pursuing target, if you either Run or use two Move Actions during this turn, you can make a single ranged attack with a -5 penalty as part of your Move Action. You can spend a Force Point to avoid the penalty. Reference Book: Star Wars Saga Edition Unknown Regions","description":"Dual Weapon Mastery I, Weapon Focus (Pistols) Immediately after making a Full Attack where you attack with two Pistols, you may move up to your Speed as a Free Action. Reference Book: Star Wars Saga Edition Galaxy of Intrigue You are a master of the elegant, if archaic, custom of dueling with Pistols. You can use each of the following Actions once per encounter as a Standard Action: End Game: You make a single ranged attack with a Pistol against an opponent within Range. The opponent's Damage Threshold is halved (rounded down) for the purpose of this attack. Snap Aiming: You make a single ranged attack with the benefits of Aiming. Stand Ready: You gain a +4 bonus to your Reflex Defense until the end of your next turn and make a single ranged attack. Reference Book: Star Wars Saga Edition Scum and Villainy If you are within 6 squares of a target and are armed with a Pistol or a Rifle, you can act as though you occupied the nearest square adjacent to the target for purposes of determining whether or not you or any allies are Flanking that target. You may only be considered to be Flanking a single target at a time. You must spend a Swift Action on your turn to designate the target you Flank at range. Reference Book: Star Wars Saga Edition Unknown Regions When moving away from a pursuing target, if you either Run or use two Move Actions during this turn, you can make a single ranged attack with a -5 penalty as part of your Move Action. You can spend a Force Point to avoid the penalty. Reference Book: Star Wars Saga Edition Unknown Regions","class":"Gunslinger","costNumeric":null,"category":"Gunslinger","tree":"Gunslinger","treeId":"cb6f775cd227a3e3","tags":["action-economy","controller","defender","dual-wield","evasion","force","force-control","force-defense","force-offense","mobility","positioning","ranged","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.multiattack_proficiency_pistols"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.b812c197daea93fd"}}},{"_id":"ac075fca2ddcbd04","name":"Sneak Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Misfortune","treeId":"67b59e020c1660eb","tags":["action-economy","battlefield-control","controller","defender","melee","mobility","positioning","precision","ranged","scaling","scoundrel","skills","social","striker"]},"effects":[{"_id":"3195415b-2276-403c-9fb1-5d323d38d31a","name":"Sneak Attack","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.flatfooted","mode":2,"value":"1d6"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Sneak Attack"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.sneak_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.1505abc8babeeb84"}}},{"_id":"41199d27b7f75a98","name":"Trigger Work","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Gunslinger","prerequisites":null,"benefit":"No penalty to attack when using Rapid Shot.","description":"You take no attack penalty when using Rapid Shot.","class":"Gunslinger","costNumeric":null,"category":"Gunslinger","tree":"Gunslinger","treeId":"cb6f775cd227a3e3","tags":["ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.trigger_work"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.86c10d63bba2d9c8"}}},{"_id":"dd38dde6eccb79aa","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+7","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":12,"flatDamageFormula":"1d4+7","useFlat":true}}}},{"_id":"3149e3959c7c6abb","name":"Heavy Blaster Pistol (with Trigger Work)","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"4d8+9","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"rang