ol","costNumeric":750,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-heavy-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":12,"flatDamageFormula":"4d8+9","useFlat":true}}}},{"_id":"3c64b3c5d4a2ae7d","name":"Trigger Work","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4","damageType":"kinetic","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Trigger Work","npc":{"useFlat":true}}}},{"_id":"e3883341d21e5d0a","name":"Thermal Detonator (4)","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"8d6+6,4-SquareBurst","damageType":"kinetic","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":2000,"equipped":true,"description":"<p>An extremely powerful explosive device. Creates a massive blast that can level buildings.</p>\n      <p><strong>Special:</strong> 4-square radius burst. Reflex save DC 20 for half damage. Extremely dangerous and often illegal.</p>","properties":["Grenade","Area Effect","Explosive","Single Use","Restricted"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"simple","subcategory":"grenade","costNumeric":2000,"category":"grenade"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-thermal-detonator"},"swse":{"npc":{"flatAttackBonus":14,"flatDamageFormula":"8d6+6,4-SquareBurst","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Trandoshan","Nonheroic Level":0,"Class Levels":{"Medium Trandoshan Scoundrel":7,"Gunslinger":6},"Force Points":2,"Dark Side Points":6,"Langu