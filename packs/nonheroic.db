tem":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"f80c370d1944c4de","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"ae4b36d46147cc7e","name":"Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"6c4684b981af0b08","name":"Controlled Burst","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"Weapon Focus (Simple Weapons)","benefit":"Base Attack Bonus +12 Once per encounter, when making an Autofire attack, you can treat the attack as a 6-Square Cone. Making this attack consumes 20 shots from the weapon's Power Pack. Reference Book: Star Wars Saga Edition Unknown Regions Whenever you make multiple attacks with any type of Simple Weapon as a Full-Round Action (see Full Attack), you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. Reference Book: Star Wars Saga Edition Unknown Regions As a Standard Action, you can throw two weapons simultaneously. Both weapons target the same enemy or target square and are thrown with one hand. Make separate attack rolls for each weapon, each at a -10 penalty. The weapons must be similar, such as two Grenades or two Knives, and they must be no larger than one size category smaller than you. The attack cannot exceed Short Range (typically 8 squares). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Weapon Proficiency (Heavy Weapons), Strength 15 When attacking with an Autofire-capable weapon, you may deal +1 die of damage. This increased damage die stacks with the increased damage from the Burst Fire and Rapid Shot Feats. Homebrew Reference Book: Legacy of the Force Sourcebook Choose one Exotic Weapon or one of the following weapon groups: Advanced Melee Weapons, Lightsabers, or Simple Weapons. You take no penalty on your attack roll when using the Rapid Strike feat with such weapons. You may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group.","description":"Base Attack Bonus +12 Once per encounter, when making an Autofire attack, you can treat the attack as a 6-Square Cone. Making this attack consumes 20 shots from the weapon's Power Pack. Reference Book: Star Wars Saga Edition Unknown Regions Whenever you make multiple attacks with any type of Simple Weapon as a Full-Round Action (see Full Attack), you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2. Reference Book: Star Wars Saga Edition Unknown Regions As a Standard Action, you can throw two weapons simultaneously. Both weapons target the same enemy or target square and are thrown with one hand. Make separate attack rolls for each weapon, each at a -10 penalty. The weapons must be similar, such as two Grenades or two Knives, and they must be no larger than one size category smaller than you. The attack cannot exceed Short Range (typically 8 squares). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Weapon Proficiency (Heavy Weapons), Strength 15 When attacking with an Autofire-capable weapon, you may deal +1 die of damage. This increased damage die stacks with the increased damage from the Burst Fire and Rapid Shot Feats. Homebrew Reference Book: Legacy of the Force Sourcebook Choose one Exotic Weapon or one of the following weapon groups: Advanced Melee Weapons, Lightsabers, or Simple Weapons. You take no penalty on your attack roll when using the Rapid Strike feat with such weapons. You may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group.","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["action-economy","burst-damage","damage-reduction","dual-wield","feat-chain","force","force-offense","heavy-weapons","lightsaber","melee","positioning","ranged","scaling","soldier","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.controlled_burst"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.3e35df4fce7082a3"}}},{"_id":"cecedd286084c8ce","name":"Greater Weapon Focus","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"","benefit":"Prerequisites: (Chosen Weapon), Devastating Attack (Chosen Weapon) Choose a single Exotic Weapon or weapon group with which you're proficient. Whenever you make a successful attack against a target using the chosen Exotic Weapon or weapon from the chosen group, you treat your target's Damage Threshold as if it were 10 points lower when determining the results of your attack. Prerequisites: (Chosen Weapon), Penetrating Attack (Chosen Weapon) Choose a single Exotic Weapon or weapon group with which you're proficient. Whenever you make a successful attack against a target using the chosen Exotic Weapon or weapon from the chosen group, you treat your target's Damage Reduction as if it were 10 points lower when determining the results of your attack. Prerequisites: (Chosen Weapon), Weapon Specialization (Chosen Weapon)","description":"Prerequisites: (Chosen Weapon), Devastating Attack (Chosen Weapon) Choose a single Exotic Weapon or weapon group with which you're proficient. Whenever you make a successful attack against a target using the chosen Exotic Weapon or weapon from the chosen group, you treat your target's Damage Threshold as if it were 10 points lower when determining the results of your attack. Prerequisites: (Chosen Weapon), Penetrating Attack (Chosen Weapon) Choose a single Exotic Weapon or weapon group with which you're proficient. Whenever you make a successful attack against a target using the chosen Exotic Weapon or weapon from the chosen group, you treat your target's Damage Reduction as if it were 10 points lower when determining the results of your attack. Prerequisites: (Chosen Weapon), Weapon Specialization (Chosen Weapon)","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["damage-reduction","defender","soldier","striker"]},"effects":[{"_id":"7a2683eb-2396-4638-aa86-e28807081035","name":"Greater Weapon Focus","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks.melee","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Greater Weapon Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.greater_weapon_focus"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.642c6c8643db7470"}}},{"_id":"fcf795b62d737e6c","name":"Greater Weapon Specialization","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"Greater Weapon Focus, Weapon Specialization","benefit":"Gain +2 damage with the chosen proficient weapon.","description":"Gain +2 additional damage with a chosen proficient weapon.","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Weapon Master","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.weapon_specialization"}],"_source":"canonical-csv"},"treeId":"2f720d8b061f9bd0","tags":["feat-chain","soldier","striker","talent-chain"]},"effects":[{"_id":"771be58e-c672-412d-af10-303bcd8b76b4","name":"Greater Weapon Specialization","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.melee","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Greater Weapon Specialization"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.greater_weapon_specialization"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e9820b341bf94de1"}}},{"_id":"72de391767a3ad99","name":"Improved Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Armor Specialist","prerequisites":"Armored Defense","benefit":"Your Reflex Defense bonus equals either your heroic level + half your armor bonus, or your armor bonus.","description":"Your Reflex Defense bonus equals either your heroic level plus half your armor bonus or your armor bonus.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Armor Specialist","prerequisitesStructured":{"type":"all","conditions":[{"type":"talen