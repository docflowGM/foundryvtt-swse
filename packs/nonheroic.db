","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"eb575c73597c569a","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"59b2b0c3432b56fa","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"4d3fd38734dac63e","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"2cb701bafd609ef9","name":"Hyperdriven","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Spacer","prerequisites":null,"benefit":"Once per day, add your class level to an attack, skill, or ability check.","description":"Once per day, add your class level to an attack roll, skill check, or ability check.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Spacer","treeId":"5ea8c79492d40713","tags":["scoundrel","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hyperdriven"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.29f73c36cabdeaf5"}}},{"_id":"c444c7f8e89a272e","name":"Penetrating Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"Weapon Focus (Chosen Weapon)","benefit":"This replaces the effects of the Talent. Choose one Exotic Weapon or weapon group with which you're proficient. You gain a +1 bonus on attack rolls with the chosen Exotic Weapon or weapon from the chosen group. This bonus stacks with the bonus granted by the Weapon Focus feat. You may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group.","description":"This replaces the effects of the Talent. Choose one Exotic Weapon or weapon group with which you're proficient. You gain a +1 bonus on attack rolls with the chosen Exotic Weapon or weapon from the chosen group. This bonus stacks with the bonus granted by the Weapon Focus feat. You may select this Talent multiple times. Each time you select this Talent, it applies to a different Exotic Weapon or weapon group.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["feat-chain","leader","scaling","soldier","striker","talent-chain"]},"effects":[{"_id":"a0fba2f5-3da6-476e-9ac5-900be2d16e6b","name":"Penetrating Attack","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.combat.weaponGroupDRReduction","mode":2,"value":"5"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Penetrating Attack","effectType":"dr_reduction","weaponGroupSpecific":true,"notes":"Weapon group specific - applies when using designated weapon group"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.penetrating_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7d547902b8d9109e"}}},{"_id":"06b104c17474dcaa","name":"Spacehound","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Spacer","prerequisites":"","benefit":"You gain a +1 bonus on attack rolls made while aboard a Starship. This bonus applies to attacks made with Starship Weapons, as well as personal weapons used aboard a Starship. Prerequisite: Whenever you roll a Natural 20 on an attack roll made aboard a Starship, you gain one temporary Force Point. If the Force Point is not used before the end of the encounter, it is lost. This Talent works with both Weapon Systems and personal weapons used aboard a Starship. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Starship Raider When adjacent to an obstacle or barrier, you gain a +2 Cover bonus to your Reflex Defense. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Starship Raider Whether you are taking on military targets on behalf of a resistance movement or you are out for personal gain, you are experienced at raiding Starships and similar targets. You can use each if the following Actions once per encounter: Clear a Path: Your attack forces an enemy to alter course or move out of your way. You must be fighting aboard a Starship to use this Action. As a Standard Action, make a ranged attack. If the attack hits, on its next turn your target must move its Speed to a square that is not adjacent to you. If the target is an enemy Starfighter engaged in a Dogfight, the target instead must attempt to disengage from the Dogfight. Covering Fire: You squeeze off several shots as you escape pursuing enemies. As a Full-Round Action, if you are the Pilot of a Vehicle, you may move the Vehicle up to twice its Speed and make a single ranged attack with one of the Pilot-controlled Vehicle Weapons at any point during that movement. If you hit and deal damage to a Vehicle with this attack, the target Vehicle takes a -2 penalty to attack rolls against your Vehicle until the end of your turn. Disabling Fire: Make a ranged attack with your Vehicle Weapon. If you make this attack against a Vehicle and hit and deal damage, you can choose one of the following to take effect until the end of your next turn: One of the target's Vehicle Weapons ceases to function. The target's Shield Rating is reduced to 0. The target's Hyperdrive is disabled. The target's Speed is reduced to 2 squares (Character Scale). Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Stellar Warrior Once per encounter, while on or in a Vehicle, you can move up to one-half your speed, or move the Vehicle up to one-half its speed if you are the Pilot, as a Swift Action. This movement does not provoke Attacks of Opportunity.","description":"You gain a +1 bonus on attack rolls made while aboard a Starship. This bonus applies to attacks made with Starship Weapons, as well as personal weapons used aboard a Starship. Prerequisite: Whenever you roll a Natural 20 on an attack roll made aboard a Starship, you gain one temporary Force Point. If the Force Point is not used before the end of the encounter, it is lost. This Talent works with both Weapon Systems and personal weapons used aboard a Starship. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Starship Raider When adjacent to an obstacle or barrier, you gain a +2 Cover bonus to your Reflex Defense. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Starship Raider Whether you are taking on military targets on behalf of a resistance movement or you are out for personal gain, you are experienced at raiding Starships and similar targets. You can use each if the following Actions once per encounter: Clear a Path: Your attack forces an enemy to alter course or move out of your way. You must be fighting aboard a Starship to use this Action. As a Standard Action, make a ranged attack. If the attack hits, on its next turn your target must move its Speed to a square that is not adjacent to you. If the target is an enemy Starfighter engaged in a Dogfight, the target instead must attempt to disengage from the Dogfight. Covering Fire: You squeeze off several shots as you escape pursuing enemies. As a Full-Round Action, if you are the Pilot of a Vehicle, you may move the Vehicle up to twice its Speed and make a single ranged attack with one of the Pilot-controlled Vehicle Weapons at any point during that movement. If you hit and deal damage to a Vehicle with this attack, the target Vehicle takes a -2 penalty to attack rolls against your Vehicle until the end of your turn. Disabling Fire: Make a ranged attack with your Vehicle Weapon. If you make this attack against a Vehicle and hit and deal damage, you can choose one of the following to take effect until the end of your next turn: One of the target's Vehicle Weapons ceases to function. The target's Shield Rating is reduced to 0. The target's Hyperdrive is disabled. The target's Speed is reduced to 2 squares (Character Scale). Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Stellar Warrior Once per encounter, while on or in a Vehicle, you can move up to one-half your speed, or move the Vehicle up to one-half its speed if you are the Pilot, as a Swift Action. This movement does not provoke Attacks of Opportunity.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Spacer","treeId":"5ea8c79492d40713","tags":["action-economy","controller","damage-reduction","defender","force","force-control","force-defense","force-offense","mobility","positioning","ranged","scaling","scoundrel","shields","striker","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.spacehound"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.fe0c3a64ca460542"}}},{"_id":"bcd09770b4ac683f","name":"Starship Raider","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Spacer","prerequisites":"Spacehound","benefit":"+1 attack aboard starships, including with personal weapons.","description":"Gain +1 attack aboard starships with personal weapons.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Spacer","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.spacehound"}],"_source":"canonical-csv"},"treeId":"5ea8c79492d40713","tags":["feat-chain","scoundrel","striker","talent-chain"]},"effects":[{"_id":"e4be147d-37ec-4006-90a5-976c3d591ef7","name":"Starship Raider","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Starship Raider"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.starship_raider"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.224906e573330bf2"}}},{"_id":"b08278e1dfb031d6","name":"Weapon Specialization","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Combat","prerequisites":"Weapon Focus","benefit":"+2 melee damage.","description":"Gain +2 damage with a chosen weapon.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Combat","treeId":"2359c05ff13f3feb","tags":["feat-chain","jedi","lightsaber","melee","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.weapon_specialization"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.41426ecd7fade0b0"}}},{"_id":"df42eedaeebfce86","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+6","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":11,"flatDamageFormula":"1d4+6","useFlat":true}}}},{"_id":"e24bd40aab07fcd7","name":"Vibroblade","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d6+6","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":2,"