grade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"b83c34e835c1d43f","name":"Expert Shaper","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Shaper","prerequisites":"Biotech Surgery","benefit":"You can temporarily mend a damaged or disabled Biotech device using the Treat Injury Skill as a Standard Action instead of a Full-Round Action. You may reroll any Treat Injury check made to repair or modify a Biotech object, but the result of the reroll must be accepted, even if it is worse. Prerequisite: Whenever you temporarily mend a Biotech device using the Treat Injury Skill, the mended device moves +4 steps on the Condition Track. In addition, the mended device only moves -3 steps down the Condition Track at the end of the scene or encounter, and is only disabled if this reduction brings it to -5 steps on the Condition Track. Whenever you use the Biotech Surgery Feat to install a Bio-Implant, the Bio-Implant's attack bonus against the recipient's Fortitude Defense is halved.","description":"You can temporarily mend a damaged or disabled Biotech device using the Treat Injury Skill as a Standard Action instead of a Full-Round Action. You may reroll any Treat Injury check made to repair or modify a Biotech object, but the result of the reroll must be accepted, even if it is worse. Prerequisite: Whenever you temporarily mend a Biotech device using the Treat Injury Skill, the mended device moves +4 steps on the Condition Track. In addition, the mended device only moves -3 steps down the Condition Track at the end of the scene or encounter, and is only disabled if this reduction brings it to -5 steps on the Condition Track. Whenever you use the Biotech Surgery Feat to install a Bio-Implant, the Bio-Implant's attack bonus against the recipient's Fortitude Defense is halved.","class":"Shaper","costNumeric":null,"category":"Shaper","tree":"Shaper","treeId":"cdbee578d65154fc","tags":["action-economy","condition-removal","controller","defender","feat-chain","mechanics","mobility","skills","striker","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.expert_shaper"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f9047f30ef6712af"}}},{"_id":"422c1c94ee2bd3da","name":"Inspire Confidence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","description":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","controller","defender","leader","mobility","noble","striker","support"]},"effects":[{"_id":"1faa089c-9609-46d8-8543-9a68ace3553b","name":"Inspire Confidence","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Confidence"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_confidence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4d8882a28da30454"}}},{"_id":"628e4374314089aa","name":"Precision Implant","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Implant","prerequisites":"","benefit":"Once per encounter as a Standard Action, you can give one adjacent living creature a . The target must be willing to receive this Implant, which grants the target a +1 Equipment bonus on attack rolls until the end of the encounter.","description":"Once per encounter as a Standard Action, you can give one adjacent living creature a . The target must be willing to receive this Implant, which grants the target a +1 Equipment bonus on attack rolls until the end of the encounter.","class":"Shaper","costNumeric":null,"category":"Shaper","tree":"Implant","treeId":"d8a71a6c5b2b7581","tags":["action-economy","leader","positioning","strike