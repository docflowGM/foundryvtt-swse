lent against a given target at a time. Reference Book: Star Wars Saga Edition Unknown Regions","description":"You can Catch a Second Wind as a Reaction, instead of as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide When you use the Aid Another Action to Suppress an Enemy, that enemy takes a -5 penalty on its next attack instead of the normal -2 penalty. Only 1 character may gain the benefits of this Talent against a given target at a time. Reference Book: Star Wars Saga Edition Unknown Regions","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Commando","treeId":"798ed0945cbdac1c","tags":["action-economy","mobility","soldier"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.tough_as_nails"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.916b0a6197bf85a6"}}},{"_id":"5139fcc19888c640","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d6+7","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":11,"flatDamageFormula":"1d6+7","useFlat":true}}}},{"_id":"d97b87c22ea11a52","name":"Stun Baton","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d6+7(Stun)","damageType":"stun","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1.5,"cost":250,"equipped":true,"description":"<p>A non-lethal weapon that delivers an electrical shock to stun targets.</p>\n      <p><strong>Special:</strong> Deals stun damage only. Target must make Fortitude save or be stunned.</p>","properties":["Stun","Non-Lethal"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"simple","subcategory":"simple","costNumeric":250,"categ