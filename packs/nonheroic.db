":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"49f3479602e6dfd6","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"d2828ef8827f8b6e","name":"Devastating Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"","benefit":"This replaces the effects of the Talent.","description":"This replaces the effects of the Talent.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["soldier"]},"effects":[{"_id":"69f7a1a0-603e-4b5e-a42a-15f770230266","name":"Devastating Attack","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.combat.weaponGroupThresholdReduction","mode":2,"value":"5"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Devastating Attack","effectType":"threshold_reduction","weaponGroupSpecific":true,"notes":"Weapon group specific - applies when using designated weapon group"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.devastating_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.383915a7d11e1225"}}},{"_id":"b806d74d3513dd02","name":"Evasion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Survivor","prerequisites":null,"benefit":"If hit by an area attack, take half or no damage.","description":"Take half or no damage from area attacks.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Survivor","treeId":"9b06340233eb3cdd","tags":["battlefield-control","evasion","scout","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.evasion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5400bc8cb1200624"}}},{"_id":"a822e9130207c4a6","name":"Jet Pack Training","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Rocket Jumper","prerequisites":"","benefit":"As a Standard Action you can expend one of your Jet Pack's charges to make an attack with the Jet Pack, treating it as a Flamethrower. You cannot use this Talent when you are flying. You are considered proficient in the Flamethrower for purposes of making this attack. Prerequisite: You always use the proper trajectories to maximize the efficiency of your rocket-pack burn rates. You increase your fly Speed by 2 squares when using a Jet Pack. Prerequisite: Once per encounter, as a Reaction when an opponent moves adjacent to you, you can expend one charge of your Jet Pack to fly and Move your Speed, or Withdraw. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Clones Once per round (as a Reaction), when you are airborne with a Jet Pack or Rocket Pack, you may negate a successful attack by making a Pilot check. The DC of the check is equal to the result of the attack roll you wish to negate. In addition, when flying a Jet Pack, you are considered proficient with its integrated weapons. This includes any piece of equipment integrated to the Jet Pack, though it does not apply to equipment integrated into armor to which the Jet Pack might be mounted. If you have taken the Starship Tactics feat, you may activate Starship Maneuvers as appropriate while flying a Jet Pack.","description":"As a Standard Action you can expend one of your Jet Pack's charges to make an attack with the Jet Pack, treating it as a Flamethrower. You cannot use this Talent when you are flying. You are considered proficient in the Flamethrower for purposes of making this attack. Prerequisite: You always use the proper trajectories to maximize the efficiency of your rocket-pack burn rates. You increase your fly Speed by 2 squares when using a Jet Pack. Prerequisite: Once per encounter, as a Reaction when an opponent moves adjacent to you, you can expend one charge of your Jet Pack to fly and Move your Speed, or Withdraw. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Clones Once per round (as a Reaction), when you are airborne with a Jet Pack or Rocket Pack, you may negate a successful attack by making a Pilot check. The DC of the check is equal to the result of the attack roll you wish to negate. In addition, when flying a Jet Pack, you are considered proficient with its integrated weapons. This includes any piece of equipment integrated to the Jet Pack, though it does not apply to equipment integrated into armor to which the Jet Pack might be mounted. If you have taken the Starship Tactics feat, you may activate Starship Maneuvers as appropriate while flying a Jet Pack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Rocket Jumper","treeId":"1f50c63b6f08de10","tags":["action-economy","armor","controller","defender","heavy-weapons","mobility","positioning","ranged","soldier","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.jet_pack_training"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d3a642f2ceb21ed4"}}},{"_id":"aa83c8c2d278a72e","name":"Sizing Up","type":"talent","img":"icons/svg/aura.svg","system":{"tree":"Unknown","prerequisite":"","benefit":"","special":"","uses":{"current":0,"max":0,"perEncounter":false,"perDay":false}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Sizing Up"}}},{"_id":"ed91edc47a077a13","name":"Tested in Battle","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Veteran","tree":"Veteran","prerequisites":"","description":"You know from first-hand experience that victory goes to those willing to take a chance. You can add your Wisdom bonus (minimum +1) to the damage roll when you make a successful Charge attack. Prerequisites: , Trained in Initiative You have seen more action in more places than most people know exist, and little in the galaxy gets you rattled. Any character using a Fear effect on you must roll twice, keeping the lower result on any Skill Checks and attack rolls. When you catch a Second Wind, you move +2 steps on the Condition Track in addition to regaining Hit Points.","benefit":"You know from first-hand experience that victory goes to those willing to take a chance. You can add your Wisdom bonus (minimum +1) to the damage roll when you make a successful Charge attack. Prerequisites: , Trained in Initiative You have seen more action in more places than most people know exist, and little in the galaxy gets you rattled. Any character using a Fear effect on you must roll twice, keeping the lower result on any Skill Checks and attack rolls. When you catch a Second Wind, you move +2 steps on the Condition Track in addition to regaining Hit Points.","class":"","category":"","costNumeric":null,"treeId":"96c390430d7a4975","tags":["action-economy","condition-removal","controller","mobility","scout","skills","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.cccea4e91352482a"}}},{"_id":"f385b077b8878ada","name":"Combat Gloves","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d6+7","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Combat Gloves","npc":{"flatAttackBonus":9,"flatDamageFormula":"1d6+7","useFlat":true}}}},{"_id":"2d2b060c590ce7d2","name":"Vibroblade","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d6+6","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":2,"cost":500,"equipped":true,"description":"<p>A blade weapon enhanced with ultrasonic vibrations that increase its cutting power.</p>\n      <p><strong>Special:</strong> Vibroweapon. Critical threat range 19-20.</p>","properties":["Vibroweapon","Critical 19-20"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"advanced-melee","subcategory":"advanced","costNumeric":500,"category":"advanced"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-vibroblade"},"swse":{"npc":{"flatAttackBonus":9,"flatDamageFormula":"2d6+6","useFlat":true}}}},{"_id":"44b9168b13fd8980","name":"Blaster Carbine","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+4","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":2.5,"cost":900,"eq