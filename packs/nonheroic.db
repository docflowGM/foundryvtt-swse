nership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"db383fb915768281","name":"Vehicular Combat","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Once per round, when your vehicle is hit in combat, you may make a Pilot check to negate the hit.","prerequisite":"Pilot 1 rank","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","scout","striker","sustained-damage"],"bonus_feat_for":["Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Negate one attack per round against the <a class=\"mw-redirect\" href=\"/wiki/Vehicle\" title=\"Vehicle\">Vehicle</a> you're piloting."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"b8dad0c963f046c6"}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1f2f70d34a17667d"}}},{"_id":"f2aa5bcdf5cc4c8f","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"32b08f97602913c9","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"b97eeea5fe0fef18","name":"Assault Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Military Tactics","prerequisites":"Trained in Initiative","benefit":"You can use the , Deployment Tactics, or Field Tactics Talent as a Swift Action, instead of a Move Action (provided you have the Talent in question). Reference Book: Star Wars Saga Edition Unknown Regions During the first round of combat in an encounter (after the Surprise Round, if any), you can take your turn before any of your allies, but you must use either the Share Talent Prestige Class ability or a Talent from one of the following Talent Trees as part of your turn: Commando Talent Tree, Leadership Talent Tree, or Military Tactics Talent Tree. On the subsequent round, you return to your normal place in the Initiative Order. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisite: When you use the Talent on an enemy, the target takes a cumulative -1 penalty to its Reflex Defense each time it is damaged by one of your allies (maximum -5 penalty). This penalty applies until the end of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide As a Swift Action, once per encounter, you can grant bonus Hit Points equal to 5 + one-half your Character Level to allies within 20 squares of you and in your line of sight. Damage is subtracted from the bonus Hit Points first, and any bonus Hit Points remaining at the end of the encounter go away. Bonus Hit Points from multiple sources do not stack. Reference Book: Star Wars Saga Edition Unknown Regions Your tactics confuse enemy commanders and tacticians that can see or otherwise observe your forces in action, such as when using sensors. After using the Share Talent special quality, make a Knowledge (Tactics) check as a Free Action. The result replaces the DC of any Talents that use Knowledge (Tactics) from the Military Tactics Talent Tree used against your or your allies. Reference Book: Star Wars Saga Edition Unknown Regions If you have already used a Talent in an encounter before granting the same Talent to an ally with your Share Talent special quality in the same encounter, any character who benefits from Share Talent gains one of the following bonuses when using that talent (if the Talent can be affected by more than one effect, the character using the Talent selects the desired effect): Reduce the Talent's DC by 5. Gain an additional +2 bonus to any bonus to attack, Defense, or damage used by the Talent. Reduce the amount of damage taken by the character through the use of the Talent by 10 points. Reference Book: Star Wars Saga Edition Unknown Regions","description":"You can use the , Deployment Tactics, or Field Tactics Talent as a Swift Action, instead of a Move Action (provided you have the Talent in question). Reference Book: Star Wars Saga Edition Unknown Regions During the first round of combat in an encounter (after the Surprise Round, if any), you can take your turn before any of your allies, but you must use either the Share Talent Prestige Class ability or a Talent from one of the following Talent Trees as part of your turn: Commando Talent Tree, Leadership Talent Tree, or Military Tactics Talent Tree. On the subsequent round, you return to your normal place in the Initiative Order. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisite: When you use the Talent on an enemy, the target takes a cumulative -1 penalty to its Reflex Defense each time it is damaged by one of your allies (maximum -5 penalty). This penalty applies until the end of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide As a Swift Action, once per encounter, you can grant bonus Hit Points equal to 5 + one-half your Character Level to allies within 20 squares of you and in your line of sight. Damage is subtracted from the bonus Hit Points first, and any bonus Hit Points remaining at the end of the encounter go away. Bonus Hit Points from multiple sources do not stack. Reference Book: Star Wars Saga Edition Unknown Regions Your tactics confuse enemy commanders and tacticians that can see or otherwise observe your forces in action, such as when using sensors. After using the Share Talent special quality, make a Knowledge (Tactics) check as a Free Action. The result replaces the DC of any Talents that use Knowledge (Tactics) from the Military Tactics Talent Tree used against your or your allies. Reference Book: Star Wars Saga Edition Unknown Regions If you have already used a Talent in an encounter before granting the same Talent to an ally with your Share Talent special quality in the same encounter, any character who benefits from Share Talent gains one of the following bonuses when using that talent (if the Talent can be affected by more than one effect, the character using the Talent selects the desired effect): Reduce the Talent's DC by 5. Gain an additional +2 bonus to any bonus to attack, Defense, or damage used by the Talent. Reduce the amount of damage taken by the character through the use of the Talent by 10 points. Reference Book: Star Wars Saga Edition Unknown Regions","class":"Officer","costNumeric":null,"category":"Officer","tree":"Military Tactics","treeId":"9253ace716c3e966","tags":["action-economy","ambush","controller","damage-reduction","defender","feat-chain","force","force-control","force-defense","force-offense","leader","leadership","mobility","positioning","scaling","scout","skills","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.assault_tactics"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d9fe8a0c76d845d4"}}},{"_id":"27da10258df865c0","name":"Coordinate","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Leadership","prerequisites":null,"benefit":"All allies in line of sight gain +1 when using aid another (maximum +5).","description":"All allies gain +1 when using Aid Another, up to +5.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Leadership","canonicalName":"Coordinate","canonicalTree":"Bab +12","treeId":"5964237d22681dc0","tags":["noble","striker"]},"effects":[{"_id":"25b28077-6a3c-43d8-97ba-a128e768f614","name":"Coordinate","icon":"icons/svg/handshake.svg","changes":[{"key":"system.actions.aidAnother","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Coordinate"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.coordinate"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a52044feeab3fe05"}}},{"_id":"79e21f50fe4e7619","name":"Inspire Confidence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","description":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","controller","defender","leader","mobility","noble","striker","support"]},"effects":[{"_id":"1faa089c-9609-46d8-8543-9a68ace3553b","name":"Inspire Confidence","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Confidence"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_confidence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4d8882a28da30454"}}},{"_id":"70991091c7d914fb","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+2","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"m