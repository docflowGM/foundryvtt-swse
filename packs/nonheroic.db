d573a623"}}},{"_id":"30581a86850a1564","name":"Point-Blank Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on ranged attacks and damage against foes within Point-Blank <a class=\"mw-redirect\" href=\"/wiki/Range\" title=\"Range\">Range</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.05459ac4d439f229"}}},{"_id":"e7b9805e31b383fd","name":"Quick Draw","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may draw or holster a weapon as a swift action instead of a move action.","prerequisite":"Base attack bonus +1","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["action-economy","controller","feat-chain","mobility","non-force","scoundrel","soldier"],"bonus_feat_for":["Soldier","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Draw weapon as a <a class=\"mw-redirect\" href=\"/wiki/Swift_Action\" title=\"Swift Action\">Swift Action</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.44705a692e2f01a6"}}},{"_id":"8600da7f0447fdee","name":"Skill Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +5 bonus on all checks with the selected skill.","prerequisite":"Trained in the chosen skill","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","noble","non-force","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"b67b8a2687d1ffef","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"f18db6de206a83e9","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"a8e0d05bc3cee826","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"48d9e556f7bbab3f","name":"Battle Analysis","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Commando","prerequisites":"Trained in Initiative","benefit":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus. When you use the Mechanics skill to Handle Explosives, the explosion deals +2 dice of damage. You may take this Talent multiple times; its effects stack. You can distract opponents and convince them that you are the most tempting (or most dangerous) target in the area. As a Swift Action, make a Persuasion check and compare the result to the Will Defense of all opponents within line of sight. If the check result exceeds an opponent's Will Defense, that opponent cannot attack any character within 6 squares of you until the start of your next turn as long as you do not have Cover against that opponent. (The affected opponent may still attack you, however.) If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per round, you may spend a Swift Action to shield a single adjacent ally from attacks, taking the damage and suffering the ill effects in your ally's stead. Until the start of your next turn, any attack made against the protected ally targets you instead. You may elect not to shield your protected ally against a given attack, provided the decision is made before the attack roll is made. If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per day as a Swift Action, you can move +5 steps on the Condition Track. This does not remove any Persistent Conditions that may be affecting you. This Talent does not affect the Condition Track of a Vehicle. You can select this talent multiple times. Each time you select this Talent, you can use it one additional time per day. You can catch a Second Wind one extra time per day. If you have this Talent and the Extra Second Wind feat, you can catch your Second Wind a total of three times per day. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisite: Whenever you have the benefit of Cover, you can spend two Swift Actions to treat it as Improved Cover until the start of your next turn. Reference Book: Star Wars Saga Edition Threats of the Galaxy Prerequisite: When one or more allies uses the Aid Another Action to give you a bonus to your attack roll, you gain a circumstance bonus equal to the total bonus provided to your damage roll. Homebrew Reference Book: Legacy of the Force Sourcebook You add an additional die of damage when attacking with any weapon that has a Burst radius.","description":"When you make a ranged attack with a Pistol or Rifle, all allies within 6 squares of you when you made the attack gain a +1 bonus to Reflex Defense until the start of your next turn. Allies within range don't need to be within your line of sight to gain the bonus. When you use the Mechanics skill to Handle Explosives, the explosion deals +2 dice of damage. You may take this Talent multiple times; its effects stack. You can distract opponents and convince them that you are the most tempting (or most dangerous) target in the area. As a Swift Action, make a Persuasion check and compare the result to the Will Defense of all opponents within line of sight. If the check result exceeds an opponent's Will Defense, that opponent cannot attack any character within 6 squares of you until the start of your next turn as long as you do not have Cover against that opponent. (The affected opponent may still attack you, however.) If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per round, you may spend a Swift Action to shield a single adjacent ally from attacks, taking the damage and suffering the ill effects in your ally's stead. Until the start of your next turn, any attack made against the protected ally targets you instead. You may elect not to shield your protected ally against a given attack, provided the decision is made before the attack roll is made. If you are the Pilot of a Vehicle, you may use this Talent to protect allied Vehicles. You may use it to protect Vehicles no more than one size category larger than your own. Once per day as a Swift Action, you can move +5 steps on the Condition Track. This does not remove any Persistent Conditions that may be affecting you. This Talent does not affect the Condition Track of a Vehicle. You can select this talent multiple times. Each time you select this Talent, you can use it one additional time per day. You can catch a Second Wind one extra time per day. If you have this Talent and the Extra Second Wind feat, you can catch your Second Wind a total of three times per day. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Prerequisite: Whenever you have the benefit of Cover, you can spend two Swift Actions to treat it as Improved Cover until the start of your next turn. Reference Book: Star Wars Saga Edition Threats of the Galaxy Prerequisite: When one or more allies uses the Aid Another Action to give you a bonus to your attack roll, you gain a circumstance bonus equal to the total bonus provided to your damage roll. Homebrew Reference Book: Legacy of the Force Sourcebook You add an additional die of damage when attacking with any weapon that has a Burst radius.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Commando","treeId":"798ed0945cbdac1c","tags":["action-economy","battlefield-control","burst-damage","condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","mechanics","mobility","piloting","positioning","ranged","scaling","shields","skills","social","soldier","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.battle_analysis"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7df2e8e4f18dc909"}}},{"_id":"7913469372e08fe2","name":"Bolster Ally","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"Inspire Confidence Whenever you hit an opponent with a melee or ranged attack, you can (as a Free Action) choose to give one ally within your line of sight a bonus to damage on their next attack equal to their Character Level. Once their fervor has been ignited, the affected ally doesn't need to remain within line of sight of you; if their next attack misses, they lose the bonus to damage granted by this Talent. Prerequisites: , Inspire Confidence, Ignite Fervor Whenever an ally within line of sight of you makes an attack that moves an opponent down the Condition Track (such as dealing damage that equals of exceeds the target's Damage Threshold), that ally moves the target an additional -1 step down the Condition Track. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Inspire Confidence Your allies hold you in such esteem that when you are threatened or injured, you can impel them to action. You can use each of the following actions once per encounter: Guardian: Choose one ally as a Swift Action. As long as you remain within 6 squares of the ally, you gain a +2 bonus to your Reflex Defense until the start of your next turn. Reprisal: Make a single melee or ranged attack against any target within your Range as a Standard Action. If your attack roll succeeds and if that target attacks you before the end of your next turn, one ally within 6 squares can make an attack against that target as a Reaction. To Me!: Spend a Swift Action. Whenever you take any damage before the beginning of your next turn, each ally within line of sight can move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","description":"Inspire Confidence Whenever you hit an opponent with a melee or ranged attack, you can (as a Free Action) choose to give one ally within your line of sight a bonus to damage on their next attack equal to their Character Level. Once their fervor has been ignited, the affected ally doesn't need to remain within line of sight of you; if their next attack misses, they lose the bonus to damage granted by this Talent. Prerequisites: , Inspire Confidence, Ignite Fervor Whenever an ally within line of sight of you makes an attack that moves an opponent down the Condition Track (such as dealing damage that equals of exceeds the target's Damage Threshold), that ally moves the target an additional -1 step down the Condition Track. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Inspire Confidence Your allies hold you in such esteem that when you are threatened or injured, you can impel them to action. You can use each of the following actions once per encounter: Guardian: Choose one ally as a Swift Action. As long as you remain within 6 squares of the ally, you gain a +2 bonus to your Reflex Defense until the start of your next turn. Reprisal: Make a single melee or ranged attack against any target within your Range as a Standard Action. If your attack roll succeeds and if that target attacks you before the end of your next turn, one ally within 6 squares can make an attack against that target as a Reaction. To Me!: Spend a Swift Action. Whenever you take any damage before the beginning of your next turn, each ally within line of sight can move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","condition-removal","controller","defender","force","force-control","force-defense","force-offense","leader","melee","mobility","noble","positioning","ranged","striker","support"]},"effects":[{"_id":"c5626626-5e0d-4051-b4c2-928434aef891","name":"Bolster Ally","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.hp.regen","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Bolster Ally"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.bolster_ally"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d6e7f7178e643717"}}},{"_id":"07eaaf98bf0c95aa","name":"Harm's Way","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Protection","prerequisites":"","benefit":"Whenever you take damage on behalf of an ally through the use of a Talent (including ), you gain Damage Reduction equal to your Class Level until the end of your next turn. Whenever you take damage on behalf of an ally through the use of a Talent (including ), your Damage Threshold is increased by 5 points. As a Swift Action, designate one adjacent ally. Until the end of your next turn, as long as that ally remains adjacent to you, you are considered to be providing that ally with Soft Cover against all attacks.","description":"Whenever you take damage on behalf of an ally through the use of a Talent (including ), you gain Damage Reduction equal to your Class Level until the end of your next turn. Whenever you take damage on behalf of an ally through the use of a Talent (including ), your Damage Threshold is increased by 5 points. As a Swift Action, designate one adjacent ally. Until the end of your next turn, as long as that ally remains adjacent to you, you are considered to be providing that ally with Soft Cover against all attacks.","class":"Soldier","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"cb5493f65f0bdb62"}],"_source":"fix5F-canonical"},"tree":"Protection","treeId":"c92c2cbc79b8a515","tags":["action-economy","damage-reduction","defender","mobility","positioning","soldier","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.harms_way"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.fde8157b6d097e12"}}},{"_id":"49e6f6aa0e85f5c9","name":"Inspire Confidence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","description":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","controller","defender","leader","mobility","noble","striker","support"]},"effects":[{"_id":"1faa089c-9609-46d8-8543-9a68ace3553b","name":"Inspire Confidence","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Confidence"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_confidence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4d8882a28da30454"}}},{"_id":"0d3a0fe611dbfc3a","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d8+3","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":6,"flatDamageFormula":"1d8+3","useFlat":true}}}},{"_id":"e6d257f1b7bd97b9","name":"Sporting Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d4+3","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":300,"equipped":true,"description":"<p>A civilian-grade blaster pistol designed for sport shooting and personal defense. Less powerful than military models but widely available.</p>","properties":["Civilian"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":300,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-sporting-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":6,"flatDamageFormula":"3d4+3","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Human","Nonheroic Level":0,"Class Levels":{"Medium Human Noble":3,"Soldier":3},"Force Points":4,"Dark Side Points":0,"Languages":["Basic","Gran","Gungan","High Galactic","Rodese"],"Unassigned Languages":0,"Reflex Defense":20,"Flat-Footed Defense":17,"Fortitude Defense":1