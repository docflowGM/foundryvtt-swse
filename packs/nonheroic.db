71","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"de4b790c9bb3015f","name":"Electronic Sabotage","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Slicer","prerequisites":"","benefit":"Trained in Use Computer You can substitute a Use Computer check for a Mechanics check when disabling a computerized device. The effort takes 1 minute and the DC is equal to the computer's Will Defense. In addition, whenever anyone accesses the afflicted computer using a Droid or another computer, that computer or Droid's Attitude immediately becomes Unfriendly. Homebrew Reference Book: New Republic Campaign Guide","description":"Trained in Use Computer You can substitute a Use Computer check for a Mechanics check when disabling a computerized device. The effort takes 1 minute and the DC is equal to the computer's Will Defense. In addition, whenever anyone accesses the afflicted computer using a Droid or another computer, that computer or Droid's Attitude immediately becomes Unfriendly. Homebrew Reference Book: New Republic Campaign Guide","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Slicer","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"usecomputer"}],"_source":"fix5F-canonical"},"treeId":"64874e65579e4cf4","tags":["defender","mechanics","scoundrel","skills","slicing"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.electronic_sabotage"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.0290634450ab1637"}}},{"_id":"6a1fa0d93eab6ed2","name":"Gimmick","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Slicer","prerequisites":"Trained in Use Computer","benefit":"You may choose to reroll any Use Computer check made to Improve Access on a computer, keeping the better of the two results. You can substitute your Use Computer Skill for any Gather Information check as long as you have access to a computer network. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You can use your Use Computer modifier in place of your Deception modifier to create a deceptive appearance with forged electronic documents. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You excel at causing havoc with computers and electronics. As a Standard Action, you can lock down a computer terminal by making a Use Computer check, making it potentially difficult for anyone else to access. That computer is considered Unfriendly to anyone other than you who attempts to use it, and the result of your Use Computer check replaces the computer's Will Defense on an attempt to change its Attitude. This effect ends if anyone else succeeds in adjusting the computer's Attitude to Indifferent. You cannot Take 20 on this Use Computer check. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You are an expert in electronic security. When you make a Mechanics check to Disable Device, you can do so without the help of a Security Kit. Additionally, something goes wrong only when you fail the Mechanics check by 10 or more. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: When attempting to damage or disrupt a computer system, you may make a DC 20 Use Computer check. If successful, the computer moves -5 steps on the Condition Track and becomes disabled. If working remotely from another terminal or device, the DC increases to 30. Homebrew Reference Book: New Republic Campaign Guide When making a Use Computer check to Access Information, Disable or Erase Program, Improve Access, or Issue Routine Command, you may make a DC 25 Use Computer check before making the command. If successful, the effects of Cover Tracks are automatically applied regardless of the actual check DC. Homebrew Reference Book: New Republic Campaign Guide You may grant a +2 bonus to a computer's Will Defense against Use Computer checks to Improve Access. If the attacking slicer fails their Use Computer check by 5 or more, the Attitude of the computer moves 2 steps toward Hostile (Instead of the normal 1 step towards Hostile).","description":"You may choose to reroll any Use Computer check made to Improve Access on a computer, keeping the better of the two results. You can substitute your Use Computer Skill for any Gather Information check as long as you have access to a computer network. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You can use your Use Computer modifier in place of your Deception modifier to create a deceptive appearance with forged electronic documents. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You excel at causing havoc with computers and electronics. As a Standard Action, you can lock down a computer terminal by making a Use Computer check, making it potentially difficult for anyone else to access. That computer is considered Unfriendly to anyone other than you who attempts to use it, and the result of your Use Computer check replaces the computer's Will Defense on an attempt to change its Attitude. This effect ends if anyone else succeeds in adjusting the computer's Attitude to Indifferent. You cannot Take 20 on this Use Computer check. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You are an expert in electronic security. When you make a Mechanics check to Disable Device, you can do so without the help of a Security Kit. Additionally, something goes wrong only when you fail the Mechanics check by 10 or more. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: When attempting to damage or disrupt a computer system, you may make a DC 20 Use Computer check. If successful, the computer moves -5 steps on the Condition Track and becomes disabled. If working remotely from another terminal or device, the DC increases to 30. Homebrew Reference Book: New Republic Campaign Guide When making a Use Computer check to Access Information, Disable or Erase Program, Improve Access, or Issue Routine Command, you may make a DC 25 Use Computer check before making the command. If successful, the effects of Cover Tracks are automatically applied regardless of the actual check DC. Homebrew Reference Book: New Republic Campaign Guide You may grant a +2 bonus to a computer's Will Defense against Use Computer checks to Improve Access. If the attacking slicer fails their Use Computer check by 5 or more, the Attitude of the computer moves 2 steps toward Hostile (Instead of the normal 1 step towards Hostile).","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Slicer","treeId":"64874e65579e4cf4","tags":["action-economy","condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","leader","mechanics","mobility","scaling","scoundrel","skills","slicing","social","striker","support","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.gimmick"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8d8937a416fc0d81"}}},{"_id":"f74ccc9e571a81db","name":"Master Slicer","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Slicer","prerequisites":"Gimmick","benefit":"Reroll Use Computer checks to improve access to computers.","description":"Reroll Use Computer checks to improve access.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Slicer","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.gimmick"}],"_source":"canonical-csv"},"treeId":"64874e65579e4cf4","tags":["feat-chain","scaling","scoundrel","talent-chain"]},"effects":[{"_id":"0fb45306-0091-4a1e-94f0-46b013c5b671","name":"Master Slicer","icon":"icons/svg/laptop.svg","changes":[{"key":"system.skills.useComputer.misc","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Master Slicer"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.master_slicer"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.bae4b0a8a3554cca"}}},{"_id":"39dd682b627cf4dc","name":"Trace","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Slicer","prerequisites":null,"benefit":"Substitute Use Computer for Gather Information if you have computer access.","description":"Use Computer replaces Gather Information when accessing networks.","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Slicer","treeId":"64874e65579e4cf4","tags":["scoundrel"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.trace"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.54065380bb20e8d8"}}},{"_id":"d0003fd8510aa64c","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+3","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"typ