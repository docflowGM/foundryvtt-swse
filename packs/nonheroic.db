coundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"1fc8674c9cdd7450","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"8f8a42a8caebf7ea","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"c9aceedc4196ce0f","name":"Improved Initiative","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Awareness","prerequisites":"Acute Senses","benefit":"Reroll Initiative checks.","description":"Reroll Initiative checks and keep the better result.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Awareness","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.acute_senses"}],"_source":"canonical-csv"},"treeId":"1c48d1cd9ab1f5c8","tags":["feat-chain","scout","skills","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_initiative"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9840f0e8b8f53bb5"}}},{"_id":"74d49b2a61bac0cb","name":"Improved Stealth","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Camouflage","prerequisites":"","benefit":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scout","costNumeric":null,"category":"Scout","tree":"Camouflage","treeId":"3926d582d2077489","tags":["action-economy","ambush","controller","mobility","perception","piloting","positioning","ranged","scout","skills","stealth","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_stealth"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.073115894cad8cf9"}}},{"_id":"08ccb0d4f54cd164","name":"Power of the Dark Side","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Dark Side","prerequisites":"Dark Side Score equal to Wisdom Score","benefit":"Charisma 13 As a Standard Action, you grant yourself and all allies within 6 squares of you a +1 Force bonus to all Defenses until the end of the encounter. These bonuses are lost if you fall unconscious or die. Affected allies that move out of range lose the benefits for as long as they remain out of range. Prerequisite: Once per day, you can use a Force Power that normally takes a Standard Action or a Move Action as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Sometimes your anger consumes you. As a Swift Action, you can take a -5 penalty to your Will Defense to gain a +2 Force bonus on attack rolls. The penalty and bonus last until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever an effect would normally move you down the Condition Track, you may spend a Force Point and increase your Dark Side Score by 1 to negate that movement down the Condition Track. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Once per encounter as a Swift Action, you can return one Force Power with the [Dark Side] descriptor to your Force Power Suite without spending a Force Point. You can select this Talent multiple times. Each time you select it, you can use it one additional time per encounter. Reference Book: Star Wars Saga Edition Threats of the Galaxy As a Standard Action, you can spend a Force Point to drain the knowledge of an opponent you touch; you must succeed on a Use the Force check (DC equal to the target's Will Defense) to activate this Talent, and if you fail to activate this Talent, you may not try again on the same target for one day. If successful, you immediately become Trained in one Skill that the target is Trained in; if you are already Trained in that Skill, you instead gain Skill Focus in that Skill. This effect lasts for one day. Additionally, your target moves -1 Persistent step along the Condition Track, and the Persistent Condition can be removed only by resting for 8 hours. Additionally, you can choose to instead sift through the mind of the target, looking for a specific piece of knowledge or information. Doing so requires you to make a Perception check against the target's Will Defense; success indicates that you pull the relevant information from the target's mind. When you do so, you do not gain the bonus Trained Skill or Skill Focus normally granted by this Talent, but otherwise the Talent functions as normal. Using this Talent increases your Dark Side Score by 1. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual When you die, you become a Dark Side Spirit until the end of the encounter. You continue to occupy a space in this form, but other creatures can occupy the same space or move through your space without impediment. As a Standard Action, you can attempt to possess an adjacent target. You must succeed on a Use the Force check against an adjacent target's Will Defense. If your check result equals or exceeds the target's Will Defense, you deal 8d6 points of Stun damage to the target; if you reduce the target to 0 Hit Points or move it to the bottom of the Condition Track with this attack, you possess the target as though it were a willing host. Alternatively, as a Standard Action, you can transfer your essence into a single adjacent object, such as a Holocron or a Lightsaber. If you do so, you lie dormant within the object until another creature attempts to use that object, at which time you can emerge and attempt to possess the creature, as described above. If you do not possess a creature or object within 10 rounds of manifesting as a Dark Side Spirit, your spirit dissipates and ceases to exist. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: When you roll a Natural 20 on a Use the Force check to activate a Force Power that directly deals damage to a target, you can choose not to regain all of your spent Force Powers as normal and instead the targets damaged by the Force Power take half that damage again at the start of their next turn. Only Force Powers that directly damage the target are subject to this Talent, including Corruption, Force Blast, Force Grip, Force Lightning, Force Slam, Force Thrust (only when spending a Force Point), and Repulse (only when spending a Force Point). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: You can create balls of unnatural energy, enabling you to make a ranged attack roll against the Reflex Defense of one target within 12 squares and line of sight, dealing 2d6 points of energy damage to the target on a successful attack. Using this Talent increases your Dark Side Score by 1. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Swift Power When using a Force Power that directly inflicts damage, you treat the target's Damage Threshold as though it were 5 points lower when determining if the target moves along the Condition Track. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: Whenever your character moves 3 or more squares in a round you gain Concealment; you may choose not to use this Talent when you move.","description":"Charisma 13 As a Standard Action, you grant yourself and all allies within 6 squares of you a +1 Force bonus to all Defenses until the end of the encounter. These bonuses are lost if you fall unconscious or die. Affected allies that move out of range lose the benefits for as long as they remain out of range. Prerequisite: Once per day, you can use a Force Power that normally takes a Standard Action or a Move Action as a Swift Action. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Sometimes your anger consumes you. As a Swift Action, you can take a -5 penalty to your Will Defense to gain a +2 Force bonus on attack rolls. The penalty and bonus last until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever an effect would normally move you down the Condition Track, you may spend a Force Point and increase your Dark Side Score by 1 to negate that movement down the Condition Track. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual Once per encounter as a Swift Action, you can return one Force Power with the [Dark Side] descriptor to your Force Power Suite without spending a Force Point. You can select this Talent multiple times. Each time you select it, you can use it one additional time per encounter. Reference Book: Star Wars Saga Edition Threats of the Galaxy As a Standard Action, you can spend a Force Point to drain the knowledge of an opponent you touch; you must succeed on a Use the Force check (DC equal to the target's Will Defense) to activate this Talent, and if you fail to activate this Talent, you may not try again on the same target for one day. If successful, you immediately become Trained in one Skill that the target is Trained in; if you are already Trained in that Skill, you instead gain Skill Focus in that Skill. This effect lasts for one day. Additionally, your target moves -1 Persistent step along the Condition Track, and the Persistent Condition can be removed only by resting for 8 hours. Additionally, you can choose to instead sift through the mind of the target, looking for a specific piece of knowledge or information. Doing so requires you to make a Perception check against the target's Will Defense; success indicates that you pull the relevant information from the target's mind. When you do so, you do not gain the bonus Trained Skill or Skill Focus normally granted by this Talent, but otherwise the Talent functions as normal. Using this Talent increases your Dark Side Score by 1. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual When you die, you become a Dark Side Spirit until the end of the encounter. You continue to occupy a space in this form, but other creatures can occupy the same space or move through your space without impediment. As a Standard Action, you can attempt to possess an adjacent target. You must succeed on a Use the Force check against an adjacent target's Will Defense. If your check result equals or exceeds the target's Will Defense, you deal 8d6 points of Stun damage to the target; if you reduce the target to 0 Hit Points or move it to the bottom of the Condition Track with this attack, you possess the target as though it were a willing host. Alternatively, as a Standard Action, you can transfer your essence into a single adjacent object, such as a Holocron or a Lightsaber. If you do so, you lie dormant within the object until another creature attempts to use that object, at which time you can emerge and attempt to possess the creature, as described above. If you do not possess a creature or object within 10 rounds of manifesting as a Dark Side Spirit, your spirit dissipates and ceases to exist. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: When you roll a Natural 20 on a Use the Force check to activate a Force Power that directly deals damage to a target, you can choose not to regain all of your spent Force Powers as normal and instead the targets damaged by the Force Power take half that damage again at the start of their next turn. Only Force Powers that directly damage the target are subject to this Talent, including Corruption, Force Blast, Force Grip, Force Lightning, Force Slam, Force Thrust (only when spending a Force Point), and Repulse (only when spending a Force Point). Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: You can create balls of unnatural energy, enabling you to make a ranged attack roll against the Reflex Defense of one target within 12 squares and line of sight, dealing 2d6 points of energy damage to the target on a successful attack. Using this Talent increases your Dark Side Score by 1. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisites: , Swift Power When using a Force Power that directly inflicts damage, you treat the target's Damage Threshold as though it were 5 points lower when determining if the target moves along the Condition Track. Homebrew Reference Book: Legacy of the Force Sourcebook Prerequisite: Whenever your character moves 3 or more squares in a round you gain Concealment; you may choose not to use this Talent when you move.","costNumeric":null,"tree":"Dark Side","treeId":"de95d37c72b1c4cd","tags":["action-economy","condition-removal","controller","damage-reduction","dark-side","defender","feat-chain","force","force-control","force-defense","force-offense","leader","light-side","lightsaber","melee","mobility","perception","positioning","ranged","scaling","skills","stealth","striker","support","sustained-damage","talent-chain"]},"effects":[{"_id":"b3ad7fe2-78a8-42b3-83dc-385122d061ed","name":"Power of the Dark Side","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Power of the Dark Side"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.power_of_the_dark_side"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.627bd3abd30b973f"}}},{"_id":"cf2db1665083f0dc","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+4","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":5,"flatDamageFormula":"1d4+4","useFlat":true}}}},{"_id":"a7c2ac75df84abd0","name":"Knife","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+4","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cos