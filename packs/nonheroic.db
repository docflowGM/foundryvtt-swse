e":"play","sourceAuthority":"statblock","legalProfile":"heroic","legalState":"unchecked","importMode":"play","playReady":true,"statblockAuthority":true,"sourcePack":"nonheroic","normalizationVersion":2,"authority":{"hp":"statblock","defenses":"statblock","bab":"statblock","attacks":"statblock","skills":"statblock","damageThreshold":"statblock","abilities":"statblock","features":"statblock"},"progressionReady":false,"progressionSkeleton":{"version":1,"source":"nonheroic-compendium-phase10.6","status":"heroic-profile","bucket":"heroicOnly","nonheroicFirstRule":"nonheroic-levels-must-precede-heroic-levels","nonheroicFirstValid":false,"totalLevels":9,"entries":[{"order":1,"classId":"scout","name":"Scout","levels":7,"source":"raw.Class Levels","confidence":"descriptor-stripped","rawName":"Medium Scout"},{"order":2,"classId":"force-adept","name":"Force Adept","levels":2,"source":"raw.Class Levels","confidence":"exact"}],"warnings":["No nonheroic levels detected; treat this entry as heroic/statblock despite living in the nonheroic pack.","Removed leading descriptor from class label: \"Medium\""],"classItemsCreated":false,"statblockValuesPreserved":true}}},"items":[{"_id":"7d20a224ee813cf4","name":"Human","type":"species","img":"icons/svg/mystery-man.svg","system":{"size":"Medium","speed":6,"abilities":"None","skillBonuses":[],"special":["Bonus Feat: Humans gain one bonus feat at 1st level","Bonus Trained Skill: Humans gain one additional trained skill at 1st level"],"languages":["Basic"],"source":"Core","description":"","tags":[],"visionTraits":[],"naturalWeapons":[],"movementTraits":[],"environmentalTraits":[],"combatTraits":{"naturalArmor":0,"weaponProficiencies":[],"otherTraits":[]},"techTraits":[],"forceTraits":[],"socialTraits":[],"bonusFeats":1,"bonusTrainedSkills":1,"costNumeric":null},"effects":[],"folder":null,"sort":700,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.species.species-human"}}},{"_id":"c076e17a6aa7440e","name":"Dodge","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"During your turn, you designate an opponent and receive a +1 dodge bonus to your Reflex Defense against attacks from that opponent. You can select a new opponent on any action. A situation that makes you lose your Dexterity bonus to Reflex Defense (if any) also makes you lose dodge bonuses. Also, dodge bonuses stack with each other, unlike most other types of bonuses.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":84,"tags":["action-economy","defender","evasion","feat-chain","non-force","scaling","scout","striker"],"bonus_feat_for":["Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain a +1 dodge bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a> against a selected target."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13}],"_source":"canonical-csv"}},"effects":[{"name":"Dodge","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"feat-defense-bonus","source":"Dodge","defenseType":"reflex"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.45366d4f3a5e443d"}}},{"_id":"0442fb944f2a5193","name":"Force Sensitivity","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"You can make Use the Force checks and gain access to Force Talents.","prerequisite":"Non-Droid","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["feat-chain","force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You can make <a href=\"/wiki/Use_the_Force\" title=\"Use the Force\">Use the Force</a> checks and gain access to <a href=\"/wiki/Force_Talents\" title=\"Force Talents\">Force Talents</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ddbeb23013d9e917"}}},{"_id":"cf6db54f16735d6e","name":"Force Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"force","benefit":"You learn a number of Force powers equal to 1 + your Wisdom modifier.","prerequisite":"Force Sensitivity, Trained in Use the Force","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["feat-chain","force","jedi","striker"],"bonus_feat_for":["Jedi"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"forcePowerGrants":1,"description":{"value":"Learn a number of <a href=\"/wiki/Force_Powers\" title=\"Force Powers\">Force Powers</a> equal to 1 + your <a href=\"/wiki/Wisdom\" title=\"Wisdom\">Wisdom</a> modifier (minimum 1)."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"usetheforce"}],"_source":"canonical-csv"}},"effects":[{"_id":"d1c60a9b-78e6-4601-85a4-320794fa5a91","name":"Force Training","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Force Training","effectType":"passive_effect","flagType":"Force Training"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.9b7b869a86f39190"}}},{"_id":"2d48c8b114303b71","name":"Mobility","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +5 bonus to Reflex Defense against attacks of opportunity provoked by movement.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["controller","defender","feat-chain","mobility","non-force","scout","striker"],"bonus_feat_for":["Scout"],"uses":{"current":0,"max":0,"perDay":false},"c