sv"}},"effects":[{"name":"Dodge","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"feat-defense-bonus","source":"Dodge","defenseType":"reflex"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.45366d4f3a5e443d"}}},{"_id":"b81559d8eb2dbc84","name":"Linguist","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a number of additional Languages equal to 1 + your Intelligence modifier (Minimum 1). If your Intelligence modifier increases so does the number of languages granted by this Feat.","prerequisite":"Int 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["feat-chain","leader","noble","non-force","striker"],"bonus_feat_for":["Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain bonus <a href=\"/wiki/Languages\" title=\"Languages\">Languages</a> equal to 1 + your <a href=\"/wiki/Intelligence\" title=\"Intelligence\">Intelligence</a> modifier (minimum 1)."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"int","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.5afd91fb081e576b"}}},{"_id":"67be22dac6865e60","name":"Melee Defense","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"As a swift action, you may take a -5 penalty on melee attack rolls to gain a +5 bonus to your Reflex Defense against melee attacks until the start of your next turn.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["action-economy","defender","melee","mobility","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Trade attack bonus on melee attacks for a dodge bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"int","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.3a847230d573a623"}}},{"_id":"b67329018b5cffe4","name":"Opportunistic Retreat","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"","prerequisite":"","special":"","normalText":"","sourcebook":"Scum and Villainy","page":27,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Sacrifice <a class=\"mw-redirect\" href=\"/wiki/Attack_of_Opportunity\" title=\"Attack of Opportunity\">Attack of Opportunity</a> to move at half speed."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.513f0d9e7eb6965b"}}},{"_id":"3412cac24f3db181","name":"Skill Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +5 bonus on all checks with the selected skill.","prerequisite":"Trained in the chosen skill","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","noble","non-force","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"80ae9d9113982270","name":"Skill Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +5 bonus on all checks with the selected skill.","prerequisite":"Trained in the chosen skill","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","noble","non-force","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"06e08735ee039637","name":"Slippery Maneuver","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may reroll a check made to escape a grapple or avoid being pinned and take the better result.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Galaxy at War","page":27,"tags":["evasion","feat-chain","non-force","scout"],"bonus_feat_for":["Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Dodge two targets, <a href=\"/wiki/Withdraw\" title=\"Withdraw\">Withdraw</a> at full Speed."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.03e16cbf16cdc81d"}}},{"_id":"a91a96d7c7bccbb0","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"440ebfc8c8cbfa1c","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"e3c6940f93b43659","name":"Dirty Tactics","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Disgrace","prerequisites":"","benefit":"During a Surprise Round, before combat begins, if you are not Surprised you can give up your Standard Action to allow all non-Surprised allies within your line of sight to take an extra Move Action during the Surprise Round. Allies can spend this Move Action to instead reroll their Initiative checks and take the better of the two results as a Free Action before combat begins. You deliver a scathing rebuke against a target to erode its will and fill it with doubt. Make a Persuasion check as a Standard Action against the target's Will Defense. If successful, you impose a -2 penalty to all the target's Defenses until the end of your next turn. You can use this ability only against targets that can clearly hear and understand your language. Once per encounter, as a Standard Action, you can grant a tactical advantage to all allies within your line of sight. When an ally Flanks an opponent, that ally gains a +4 Flanking bonus on melee attack rolls instead of the normal +2 bonus. Allies lose this benefit immediately if line of sight is broken or if you are unconscious or dead, or at the end of the encounter. Prerequisite: As a Swift Action once per turn, you can make a Persuasion check against the Will Defense of all opponents within your line of sight. If successful, a target cannot attack you if one of your allies is within 6 squares of you. Prerequisites: , Misplaced Loyalty You have mastered the art of saying one thing and doing another, allowing you to deceive your enemies to keep your machinations hidden. You can use each of the following actions once per encounter as a Standard Action: False Security: Make a single melee or ranged attack against a target within your Range. At any time before the beginning of your next turn, you can make a single attack against that target as a Reaction if that target attacks you. Nonthreatening: Make a single melee or ranged attack against a target within your Range. Until the beginning of your next turn, that opponent cannot make any attacks against you except for Attacks of Opportunity. This is a Mind-Affecting effect. Tricky Target: Make a single melee or ranged attack against a target within your range that has not attacked you since the end of your last turn. You gain a +2 bonus on your attack roll and damage roll for this attack. You gain a +5 bonus to your Will Defense against Skill Checks made to read your emotions and influence your Attitude. In addition, whenever you successfully Feint a target in combat, that target is Flat-Footed against all your attacks until the end of your next turn.","description":"During a Surprise Round, before combat begins, if you are not Surprised you can give up your Standard Action to allow all non-Surprised allies within your line of sight to take an extra Move Action during the Surprise Round. Allies can spend this Move Action to instead reroll their Initiative checks and take the better of the two results as a Free Action before combat begins. You deliver a scathing rebuke against a target to erode its will and fill it with doubt. Make a Persuasion check as a Standard Action against the target's Will Defense. If successful, you impose a -2 penalty to all the target's Defenses until the end of your next turn. You can use this ability only against targets that can clearly hear and understand your language. Once per encounter, as a Standard Action, you can grant a tactical advantage to all allies within your line of sight. When an ally Flanks an opponent, that ally gains a +4 Flanking bonus on melee attack rolls instead of the normal +2 bonus. Allies lose this benefit immediately if line of sight is broken or if you are unconscious or dead, or at the end of the encounter. Prerequisite: As a Swift Action once per turn, you can make a Persuasion check against the Will Defense of all opponents within your line of sight. If successful, a target cannot attack you if one of your allies is within 6 squares of you. Prerequisites: , Misplaced Loyalty You have mastered the art of saying one thing and doing another, allowing you to deceive your enemies to keep your machinations hidden. You can use each of the following actions once per encounter as a Standard Action: False Security: Make a single melee or ranged attack against a target within your Range. At any time before the beginning of your next turn, you can make a single attack against that target as a Reaction if that target attacks you. Nonthreatening: Make a single melee or ranged attack against a target within your Range. Until the beginning of your next turn, that opponent cannot make any attacks against you except for Attacks of Opportunity. This is a Mind-Affecting effect. Tricky Target: Make a single melee or ranged attack against a target within your range that has not attacked you since the end of your last turn. You gain a +2 bonus on your attack roll and damage roll for this attack. You gain a +5 bonus to your Will Defense against Skill Checks made to read your emotions and influence your Attitude. In addition, whenever you successfully Feint a target in combat, that target is Flat-Footed against all your attacks until the end of your next turn.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Disgrace","treeId":"e91cc675fbf9ba6e","tags":["action-economy","ambush","controller","defender","leader","melee","mobility","noble","positioning","ranged","scout","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.dirty_tactics"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.1e7a0010a589b870"}}},{"_id":"91de73a7eadadaca","name":"Innocuous","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Trickery","prerequisites":"","benefit":"While you occupy a square adjacent to another creature, you can use a Swift Action to gain a +2 Cover bonus to your Reflex Defense until the start of your next turn or until you are no longer adjacent to another creature, whichever comes first. As a Swift Action, you can make a Deception check against a single enemy within 6 squares of you and in line of sight. If the check equals or exceeds the target's Will Defense, the target takes a -5 penalty on all attacks made against you until the start of your next turn.","description":"While you occupy a square adjacent to another creature, you can use a Swift Action to gain a +2 Cover bonus to your Reflex Defense until the start of your next turn or until you are no longer adjacent to another creature, whichever comes first. As a Swift Action, you can make a Deception check against a single enemy within 6 squares of you and in line of sight. If the check equals or exceeds the target's Will Defense, the target takes a -5 penalty on all attacks made against you until the start of your next turn.","class":"Charlatan","costNumeric":null,"category":"Charlatan","tree":"Trickery","treeId":"ab9b75bc19f8e983","tags":["action-economy","defender","mobility","positioning","skills","social","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.innocuous"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.0fa7aace1d7606c6"}}},{"_id":"4eaa5a4bca4d0ed3","name":"Misplaced Loyalty","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Disgrace","prerequisites":"Dirty Tactics","benefit":"Once per turn, make Persuasion vs Will Defense against all opponents in line of sight; the chosen target cannot attack you or one ally within 6 squares.","description":"Once per turn, a Persuasion check prevents enemies in line of sight from attacking you or one ally.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Disgrace","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.dirty_tactics"}],"_source":"canonical-csv"},"treeId":"e91cc675fbf9ba6e","tags":["defender","feat-chain","noble","positioning","skills","social","support","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.misplaced_loyalty"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4635850263c7bf94"}}},{"_id":"594ff6fb04001a0b","name":"Two-Faced","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Disgrace","prerequisites":"Misplaced Loyalty","benefit":"Each once per encounter after you attack: if you use the same attack, you may attack as a reaction; or an opponent cannot attack you; or gain +2 attack if they haven't attacked.","description":"After you attack, choose one benefit affecting enemy attacks or your own attack rolls.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Disgrace","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.misplaced_loyalty"}],"_source":"canonical-csv"},"treeId":"e91cc675fbf9ba6e","tags":["action-economy","feat-chain","noble","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.two_faced"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.cef9b7ca6a26f4a6"}}},{"_id":"0562c9a139011b0d","name":"Unreadable","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Disgrace","prerequisites":null,"benefit":"+5 Will Defense vs checks to read your emotions; when you feint in combat, the target is flat-footed against you.","description":"Gain +5 Will Defense against checks to read your emotions; feinted enemies are flat-footed.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Disgrace","treeId":"e91cc675fbf9ba6e","tags":["controller","defender","noble","striker"]},"effects":[{"_id":"2eebd8ab-208e-47f3-9fef-94255136aabc","name":"Unreadable","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.will","mode":2,"value":"5"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Unreadable"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.unreadable"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.01bcee2365b82ce6"}}},{"_id":"6391b219b11f603a","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+3","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":4,"flatDamageFormula":"1d4+3","useFlat":true}}}},{"_id":"7c501b6d869a74b7","name":"Hold-Out Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d4+4","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":0.5,"cost":300,"equipped":true,"description":"<p>A small, easily concealed blaster pistol.</p>","properties":["Illegal","Inaccurate"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":300,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-hold-out-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":7,"flatDamageFormula":"3d4+4","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Human","Nonheroic Level":0,"Class Levels":{"Medium Human Noble":7,"Charlatan":1},"Force Points":4,"Dark Side Points":4,"Languages":["Basic","Bothese","High Galac