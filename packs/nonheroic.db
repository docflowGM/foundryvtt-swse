]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"a717819019f3450c","name":"Flurry Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Critical Master","prerequisites":null,"benefit":"When you score a critical hit, make an additional attack against a target in range once per turn.","description":"Once per turn, when you score a critical hit, make an additional attack against a target in range.","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Critical Master","treeId":"71e99c646b18d85c","tags":["positioning","precision","soldier","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.flurry_attack"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9e2092257b53cd21"}}},{"_id":"5aa3936ab166399d","name":"Harm's Way","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Protection","prerequisites":"","benefit":"Whenever you take damage on behalf of an ally through the use of a Talent (including ), you gain Damage Reduction equal to your Class Level until the end of your next turn. Whenever you take damage on behalf of an ally through the use of a Talent (including ), your Damage Threshold is increased by 5 points. As a Swift Action, designate one adjacent ally. Until the end of your next turn, as long as that ally remains adjacent to you, you are considered to be providing that ally with Soft Cover against all attacks.","description":"Whenever you take damage on behalf of an ally through the use of a Talent (including ), you gain Damage Reduction equal to your Class Level until the end of your next turn. Whenever you take damage on behalf of an ally through the use of a Talent (including ), your Damage Threshold is increased by 5 points. As a Swift Action, designate one adjacent ally. Until the end of your next turn, as long as that ally remains adjacent to you, you are considered to be providing that ally with Soft Cover against all attacks.","class":"Soldier","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"cb5493f65f0bdb62"}],"_source":"fix5F-canonical"},"tree":"Protection","treeId":"c92c2cbc79b8a515","tags":["action-economy","damage-reduction","defender","mobility","positioning","soldier","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.harms_way"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.fde8157b6d097e12"}}},{"_id":"d0d11aaec58e878f","name":"Weapon Specialization","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Combat","prerequisites":"Weapon Focus","benefit":"+2 melee damage.","description":"Gain +2 damage with a chosen weapon.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Combat","treeId":"2359c05ff13f3feb","tags":["feat-chain","jedi","lightsaber","melee","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.weapon_specialization"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.41426ecd7fade0b0"}}},{"_id":"058e9bbd6eb3b892","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d6+6","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""}