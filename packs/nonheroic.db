.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"4a4318e1c571d43c","name":"Expert Grappler","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Brawler","prerequisites":"","benefit":"You are skilled at keeping your opponents off balance in melee combat. At the beginning of your turn, you can choose to designate an opponent no more than one size category larger or smaller than you. That opponent doesn't get to add their Strength bonus on attack rolls when targeting you. (If the opponent has a Strength penalty, they still suffer from that penalty.) The opponent's Strength modifier applies to damage, as usual. You can select a new opponent on your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","description":"You are skilled at keeping your opponents off balance in melee combat. At the beginning of your turn, you can choose to designate an opponent no more than one size category larger or smaller than you. That opponent doesn't get to add their Strength bonus on attack rolls when targeting you. (If the opponent has a Strength penalty, they still suffer from that penalty.) The opponent's Strength modifier applies to damage, as usual. You can select a new opponent on your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Brawler","treeId":"67fdd8dce9abd6c1","tags":["melee","soldier","striker"]},"effects":[{"_id":"45edf98f-a153-47dc-ab62-44370f495321","name":"Expert Grappler","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.grapple.bonus","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Expert Grappler","effectType":"grapple_bonus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.expert_grappler"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.916a526d8c166005"}}},{"_id":"865f916eb1f04fc4","name":"Gun Club","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Republic Commando","prerequisites":"","benefit":"If you use a Ranged Weapon as a Melee Weapon (as with the Talent), you gain a +2 bonus to melee attack rolls with that Weapon.","description":"If you use a Ranged Weapon as a Melee Weapon (as with the Talent), you gain a +2 bonus to melee attack rolls with that Weapon.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Republic Commando","treeId":"cb3751283ea8fa3d","tags":["melee","positioning","ranged","soldier","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.gun_club"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.bff3997bbdecc98a"}}},{"_id":"7bf7080317478553","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+4","damageType":"kinetic","attackBonus":0,"attackAttr