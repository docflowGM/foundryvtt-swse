,{"_id":"e980c32c9eadbb0d","name":"Rapid Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"When making a full attack with a ranged weapon, you may make one additional attack. All attacks take a -2 penalty.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","positioning","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Take a -2 penalty on a ranged attack roll to deal +1 die of damage."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.94b8751efb03536a"}}},{"_id":"b30b1a8cc591a177","name":"Running Attack","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may make a single melee or ranged attack at any point during a move action taken on your turn.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["action-economy","controller","feat-chain","melee","mobility","non-force","positioning","ranged","scout","soldier"],"bonus_feat_for":["Scout","Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Move before and after making an attack."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.4d6a68d553fb0449"}}},{"_id":"9a8d271e224a06cb","name":"Skill Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You become trained in one additional skill. You may take this feat multiple times.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["noble","non-force","scaling","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You become <a class=\"mw-redirect\" href=\"/wiki/Trained\" title=\"Trained\">Trained</a> in one Class Skill."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"7264cd275f70d568","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"cf9f4b8b42893f04","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"92baa1c7a245e0e0","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"934e8c9c983b1ba4","name":"Hidden Movement","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Camouflage","prerequisites":"","benefit":"Improved Stealth Any situation that would give you Concealment grants you Total Concealment instead. Reference Book: Star Wars Saga Edition Galaxy at War When Prone, you can spend a Swift Action to gain Concealment until the start of your next turn. If you stand up or move, you lose this benefit. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Improved Stealth Once per encounter, when you are within 2 squares of Cover or Concealment, you can move to that Cover or Concealment and make a Stealth check to hide as a single Move Action. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Improved Stealth You excel at fighting from the shadows, hitting your opponents when they least expect it. You can use each of the following actions once per encounter as a Standard Action: Blinding Strike: Make a single melee or ranged attack against an opponent within Range. If you damage the target, you gain Total Concealment against that target until the beginning of your next turn. Confusing Strike: Make a single melee or ranged attack against an opponent within Range. If this opponent is denied its Dexterity bonus to its Reflex Defense, or if you have Concealment from this opponent, a successful attack also causes the opponent to be able to take only a Swift Action on its next turn. Unexpected Attack: Make a melee or ranged attack within your Range against an opponent from whom you have Concealment. You gain a +2 bonus on this attack roll if you have Concealment, or a +5 bonus if you have Total Concealment. Reference Book: Star Wars Saga Edition Galaxy at War When you would normally provoke an Attack of Opportunity by moving out of a Threatened Area, you can roll a Stealth check, replacing your Reflex Defense with the results of your Stealth check if it is higher.","description":"Improved Stealth Any situation that would give you Concealment grants you Total Concealment instead. Reference Book: Star Wars Saga Edition Galaxy at War When Prone, you can spend a Swift Action to gain Concealment until the start of your next turn. If you stand up or move, you lose this benefit. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Improved Stealth Once per encounter, when you are within 2 squares of Cover or Concealment, you can move to that Cover or Concealment and make a Stealth check to hide as a single Move Action. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Improved Stealth You excel at fighting from the shadows, hitting your opponents when they least expect it. You can use each of the following actions once per encounter as a Standard Action: Blinding Strike: Make a single melee or ranged attack against an opponent within Range. If you damage the target, you gain Total Concealment against that target until the beginning of your next turn. Confusing Strike: Make a single melee or ranged attack against an opponent within Range. If this opponent is denied its Dexterity bonus to its Reflex Defense, or if you have Concealment from this opponent, a successful attack also causes the opponent to be able to take only a Swift Action on its next turn. Unexpected Attack: Make a melee or ranged attack within your Range against an opponent from whom you have Concealment. You gain a +2 bonus on this attack roll if you have Concealment, or a +5 bonus if you have Total Concealment. Reference Book: Star Wars Saga Edition Galaxy at War When you would normally provoke an Attack of Opportunity by moving out of a Threatened Area, you can roll a Stealth check, replacing your Reflex Defense with the results of your Stealth check if it is higher.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Camouflage","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.improved_stealth"}],"_source":"canonical-csv"},"treeId":"3926d582d2077489","tags":["action-economy","battlefield-control","controller","defender","leader","melee","mobility","positioning","ranged","scaling","scout","skills","stealth","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hidden_movement"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d0dad96e182d63d4"}}},{"_id":"fd61670b8ccfc034","name":"Improved Stealth","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Camouflage","prerequisites":"","benefit":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scou