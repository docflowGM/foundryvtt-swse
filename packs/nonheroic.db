,"soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"cb3846b7c94dea48","name":"Connections","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lineage","prerequisites":"","benefit":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"You have Influential Contacts within a certain organization, planet, or region who can provide concrete information to you on certain subjects. Once per day, you can have one of these contacts make a Skill Check on your behalf. The contact always Takes 20 on the Skill Check (even if the Skill would normally not allow Taking 20) and has a Skill modifier equal to 5 + one-half your Heroic Level. Contacting your Influential Contacts and receiving the benefit of the Skill Check takes a number of minutes equal to 10 x the Skill Check result. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: , Influential Friends You have a powerful contact who has an extended sphere of influence. The contact could be an Imperial Senator, a high-level military officer, a regional governor, an infamous crime lord, or another person of similar significance. Once per encounter, you can invoke the name or office of your powerful contact and Take 20 on one Persuasion check, with no increase in the time needed to make the check. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Lineage","treeId":"b5bb4154688c66ab","tags":["force","noble","skills","social","striker","support"]},"effects":[{"_id":"6708f25b-1035-4044-99fb-a15527d65e5c","name":"Connections","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.economy.blackMarketMultiplier","mode":2,"value":"-1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Connections","effectType":"economy_bonus","economy":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.connections"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e58a8ad63c1d8771"}}},{"_id":"0aec7d60d070ac0d","name":"Fool's Luck","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fortune","prerequisites":"","benefit":"Once per encounter, you can turn a Critical Hit against you into a normal hit. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Once per encounter, as a Reaction, you gain a +5 luck bonus to any one Defense until the start of your next turn. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"Once per encounter, you can turn a Critical Hit against you into a normal hit. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Once per encounter, as a Reaction, you gain a +5 luck bonus to any one Defense until the start of your next turn. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Fortune","treeId":"cee9b9398682b7d0","tags":["action-economy","defender","precision","scoundrel","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.fools_luck"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5319a796f2c4ff64"}}},{"_id":"d932b95a2de91b47","name":"Inspire Confidence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Inspiration","prerequisites":"","benefit":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","description":"You can't in yourself. As a Swift Action, you can encourage one of your allies within line of sight to make haste with a Skill Check. On that ally's next turn, that ally can make a Skill Check that normally requires a Standard Action, as a Move Action instead. Prerequisite: You can share your strength of will with your allies. Once per encounter as a Swift Action, you can grant all allies within line of sight a +2 morale bonus to their Will Defense. This bonus lasts for the remainder of the encounter, and once it is granted your allies need not remain within line of sight of you to retain this bonus.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Inspiration","treeId":"72d32ebcbb607314","tags":["action-economy","controller","defender","leader","mobility","noble","striker","support"]},"effects":[{"_id":"1faa089c-9609-46d8-8543-9a68ace3553b","name":"Inspire Confidence","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Inspire Confidence"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_confidence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4d8882a28da30454"}}},{"_id":"567746f33080348c","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+2","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":3,"flatDamageFormula":"1d4+2","useFlat":true}}}},{"_id":"1e1f6949bd168e3d","name":"Heavy Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+2","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1.3,"cost":750,"equipped":true,"description":"<p>A more powerful variant of the standard blaster pistol, delivering higher damage at the cost of increased weight and power consumption.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":750,"category":"pi