eapon)","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Weapon Master","treeId":"2f720d8b061f9bd0","tags":["damage-reduction","defender","soldier","striker"]},"effects":[{"_id":"7a2683eb-2396-4638-aa86-e28807081035","name":"Greater Weapon Focus","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks.melee","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Greater Weapon Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.greater_weapon_focus"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.642c6c8643db7470"}}},{"_id":"91a7ebd02f5be057","name":"Greater Weapon Specialization","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Weapon Master","prerequisites":"Greater Weapon Focus, Weapon Specialization","benefit":"Gain +2 damage with the chosen proficient weapon.","description":"Gain +2 additional damage with a chosen proficient weapon.","class":"Elite Trooper","costNumeric":null,"category":"Elite Trooper","tree":"Weapon Master","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.weapon_specialization"}],"_source":"canonical-csv"},"treeId":"2f720d8b061f9bd0","tags":["feat-chain","soldier","striker","talent-chain"]},"effects":[{"_id":"771be58e-c672-412d-af10-303bcd8b76b4","name":"Greater Weapon Specialization","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.melee","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Greater Weapon Specialization"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.greater_weapon_specialization"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.e9820b341bf94de1"}}},{"_id":"708482babcfeb97e","name":"Improved Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Armor Specialist","prerequisites":"Arm