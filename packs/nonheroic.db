core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"234f3578022fcef2","name":"Weapon Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +1 bonus on attack rolls with the selected weapon group.","prerequisite":"Proficient with selected weapon group","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on attack rolls with chosen weapon."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c41814601364b643"}}},{"_id":"1ac93664ebc9587b","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"ed88b75219ac3b15","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"ab9a4e772413dab8","name":"Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Knight's Armor","prerequisites":"","benefit":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","description":"When calculating your Reflex Defense, you may add your Heroic Level plus one-half your Armor bonus (rounded down), or your Armor bonus alone, whichever is higher. This Talent counts as both the Talent and the Improved Talent for the purposes of prerequisites. You are adept at using a Cortosis Gauntlet to parry Lightsaber attacks. You gain a +2 bonus when making an opposed Unarmed melee attack roll against a Lightsaber attack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Knight's Armor","treeId":"ea01d740c91888b3","tags":["armor","defender","lightsaber","melee","scaling","soldier","striker","sustained-damage","unarmed"]},"effects":[{"_id":"28f1f3db-0c6f-4614-bdcf-000f1542a25b","name":"Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex.misc","mode":2,"value":"1","priority":20}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.4c236343b01ea763"}}},{"_id":"ed483f7fb988fef8","name":"Attune Armor","type":"talent","img":"icons/svg/aura.svg","system":{"tree":"Unknown","prerequisite":"","benefit":"","special":"","uses":{"current":0,"max":0,"perEncounter":false,"perDay":false}},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Attune Armor"}}},{"_id":"7dc3d5043fda846d","name":"Block","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith Alchemy","prerequisites":"","benefit":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","description":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Sith Alchemy","treeId":"a67faf2ae089ab5d","tags":["action-economy","armor","dark-side","defender","force","force-offense","jedi","lightsaber","melee","mobility","ranged","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.block"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9379daa94a228c04"}}},{"_id":"a4629d392e0c17e4","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"550edf6df6dda94a","name":"Improved Armored Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Armor Specialist","prerequisites":"Armored Defense","benefit":"Your Reflex Defense bonus equals either your heroic level + half your armor bonus, or your armor bonus.","description":"Your Reflex Defense bonus equals either your heroic level plus half your armor bonus or your armor bonus.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Armor Specialist","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.armored_defense"}],"_source":"canonical-csv"},"treeId":"17cec542331cb4e4","tags":["armor","defender","feat-chain","soldier","striker","talent-chain"]},"effects":[{"_id":"842ee02b-8f7e-4a40-802a-c6fe553379a5","name":"Improved Armored Defense","icon":"icons/svg/shield.svg","changes":[{"key":"system.defenses.reflex","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Improved Armored Defense"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_armored_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.394809ed8baff1b9"}}},{"_id":"cfc4416aa5d7f10f","name":"Battle Strike","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You channel the Force to enhance your next melee attack. Your next melee attack this round gains a +1d6 bonus to damage.</p>","special":"<p>This bonus damage is Force damage and bypasses Damage Reduction.</p>","descriptor":["Telekinetic"],"dcChart":[],"ma