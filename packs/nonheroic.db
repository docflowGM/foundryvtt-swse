p":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.species.species-human"}}},{"_id":"5faf0964915c5d52","name":"Armor Proficiency (light)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with light armor and do not take armor check penalties on attack rolls.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":85,"tags":["armor","defender","non-force","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"No penalty on attacks and no <a class=\"mw-redirect\" href=\"/wiki/Armor_Check_Penalty\" title=\"Armor Check Penalty\">Armor Check Penalty</a> while wearing <a href=\"/wiki/Light_Armor\" title=\"Light Armor\">Light Armor</a>."}},"effects":[{"_id":"9781a3c7-4e7e-4af0-9dcc-cdea0524b414","name":"Armor Proficiency (Light)","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.armorProficiency.light","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Armor Proficiency (Light)","effectType":"armor_proficiency"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.773ec00effc7e96f"}}},{"_id":"ec4c2e73fda432eb","name":"Martial Arts I","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Increases damage from Unarmed attacks by one die step; gain +1 bonus to Reflex Defense.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["defender","non-force","striker","unarmed"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Increases damage from <a class=\"mw-redirect\" href=\"/wiki/Unarmed\" title=\"Unarmed\">Unarmed</a> attacks by one die step; gain +1 bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.92f927c92ded9fcf"}}},{"_id":"53ea9ed421ca7e8f","name":"Martial Arts II","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Increases damage from Unarmed attacks by one die step; gain +1 bonus to Reflex Defense.","prerequisite":"Martial Arts I, Base Attack Bonus +3","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["defender","feat-chain","non-force","striker","unarmed"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Increases damage from <a class=\"mw-redirect\" href=\"/wiki/Unarmed\" title=\"Unarmed\">Unarmed</a> attacks by one die step; gain +1 bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":3}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.5bedd71f0eead6b9"}}},{"_id":"c9cdd614413888b2","name":"Pin","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may attempt to pin a grappled opponent. If successful, the target is immobilized until they escape the grapple.","prerequisite":"Int 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"<a class=\"mw-redirect\" href=\"/wiki/Grappled\" title=\"Grappled\">Grappled</a> opponent is <a class=\"mw-redirect\" href=\"/wiki/Pinned\" title=\"Pinned\">Pinned</a> for one round, can't move, and and loses its <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.c238f3f722689a3a"}}},{"_id":"c910f7f9427833a3","name":"Point-Blank Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on ranged attacks and damage against foes within Point-Blank <a class=\"mw-redirect\" href=\"/wiki/Range\" title=\"Range\">Range</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.05459ac4d439f229"}}},{"_id":"8516c820d3f695c7","name":"Running Attack","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may make a single melee or ranged attack at any point during a move action taken on your turn.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["action-economy","controller","feat-chain","melee","mobility","non-force","positioning","ranged","scout","soldier"],"bonus_feat_for":["Scout","Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Move before and after making an attack."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.4d6a68d553fb0449"}}},{"_id":"0f37f5a0df6aeb4a","name":"Skill Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +5 bonus on all checks with the selected skill.","prerequisite":"Trained in the chosen skill","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","noble","non-force","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"d4f610df80adbce5","name":"Skill Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You become trained in one additional skill. You may take this feat multiple times.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["noble","non-force","scaling","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You become <a class=\"mw-redirect\" href=\"/wiki/Trained\" title=\"Trained\">Trained</a> in one Class Skill."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"e88a10f2660fae8d","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"69a5759a3f0c044c","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"434e5e809910b1f2","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"754d688783889c95","name":"Dastardly Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","tree":"Misfortune","prerequisites":"Combat Reflexes","description":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","benefit":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","class":"","category":"","costNumeric":null,"treeId":"67b59e020c1660eb","tags":["condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","lightsaber","melee","mobility","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9e4345faaaa94dd8"}}},{"_id":"f8c5aa72db6d82c6","name":"Hidden Movement","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Camouflage","prerequisites":"","benefit":"Improved Stealth Any situation that would give you Concealment grants you Total Concealment instead. Reference Book: Star Wars Saga Edition Galaxy at War When Prone, you can spend a Swift Action to gain Concealment until the start of your next turn. If you stand up or move, you lose this benefit. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Improved Stealth Once per encounter, when you are within 2 squares of Cover or Concealment, you can move to that Cover or Concealment and make a Stealth check to hide as a single Move Action. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Improved Stealth You excel at fighting from the shadows, hitting your opponents when they least expect it. You can use each of the following actions once per encounter as a Standard Action: Blinding Strike: Make a single melee or ranged attack against an opponent within Range. If you damage the target, you gain Total Concealment against that target until the beginning of your next turn. Confusing Strike: Make a single melee or ranged attack against an opponent within Range. If this opponent is denied its Dexterity bonus to its Reflex Defense, or if you have Concealment from this opponent, a successful attack also causes the opponent to be able to take only a Swift Action on its next turn. Unexpected Attack: Make a melee or ranged attack within your Range against an opponent from whom you have Concealment. You gain a +2 bonus on this attack roll if you have Concealment, or a +5 bonus if you have Total Concealment. Reference Book: Star Wars Saga Edition Galaxy at War When you would normally provoke an Attack of Opportunity by moving out of a Threatened Area, you can roll a Stealth check, replacing your Reflex Defense with the results of your Stealth check if it is higher.","description":"Improved Stealth Any situation that would give you Concealment grants you Total Concealment instead. Reference Book: Star Wars Saga Edition Galaxy at War When Prone, you can spend a Swift Action to gain Concealment until the start of your next turn. If you stand up or move, you lose this benefit. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Improved Stealth Once per encounter, when you are within 2 squares of Cover or Concealment, you can move to that Cover or Concealment and make a Stealth check to hide as a single Move Action. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Improved Stealth You excel at fighting from the shadows, hitting your opponents when they least expect it. You can use each of the following actions once per encounter as a Standard Action: Blinding Strike: Make a single melee or ranged attack against an opponent within Range. If you damage the target, you gain Total Concealment against that target until the beginning of your next turn. Confusing Strike: Make a single melee or ranged attack against an opponent within Range. If this opponent is denied its Dexterity bonus to its Reflex Defense, or if you have Concealment from this opponent, a successful attack also causes the opponent to be able to take only a Swift Action on its next turn. Unexpected Attack: Make a melee or ranged attack within your Range against an opponent from whom you have Concealment. You gain a +2 bonus on this attack roll if you have Concealment, or a +5 bonus if you have Total Concealment. Reference Book: Star Wars Saga Edition Galaxy at War When you would normally provoke an Attack of Opportunity by moving out of a Threatened Area, you can roll a Stealth check, replacing your Reflex Defense with the results of your Stealth check if it is higher.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Camouflage","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.improved_stealth"}],"_source":"canonical-csv"},"treeId":"3926d582d2077489","tags":["action-economy","battlefield-control","controller","defender","leader","melee","mobility","positioning","ranged","scaling","scout","skills","stealth","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hidden_movement"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d0dad96e182d63d4"}}},{"_id":"5185e3070bb967d7","name":"Improved Stealth","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Camouflage","prerequisites":"","benefit":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scout","costNumeric":null,"category":"Scout","tree":"Camouflage","treeId":"3926d582d2077489","tags":["action-economy","ambush","controller","mobility","perception","piloting","positioning","ranged","scout","skills","stealth","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_stealth"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.073115894cad8cf9"}}},{"_id":"f47fca4fa959cfbe","name":"Sneak Attack","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","prerequisites":"","benefit":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"Any time your opponent is Flat-Footed or otherwise denied its Dexterity bonus to Reflex Defense, you deal an additional 1d6 points of damage with a successful melee or ranged attack. You must be within 6 squares of the target to make a with a ranged weapon. You may select this Talent multiple times. Each time you select it, your damage increases by +1d6 (Maximum +10d6). Prerequisite: You can take advantage of your adversary's distractions, no matter how momentary or fleeting. Once per turn, when you Flank a target, you can treat that target as if they were Flat-Footed for one of your attacks. Reference Book: Star Wars Saga Edition Scum and Villainy If you succeed on a Deception check against a target's Will Defense as a Swift Action, until the start of your next turn you can move though the Threatened Area of that target as part of your Move Action without provoking an Attack of Opportunity. Each Threatened square that you move through counts as 2 squares of movement. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Point-Blank Shot You can use the Talent against a target within 12 squares, instead of within 6 squares. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide You excel at seduction through deception. If you fail a Persuasion check to change a target's Attitude, you can immediately reroll the check using your Deception skill in lieu of your Persuasion skill. You must accept the result of the reroll, even if it is worse. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per encounter as a Move Action, you can attempt to seize a held, carried, or worn object from an adjacent target by making a Disarm attack, with a +10 bonus on your attack roll. If the attack succeeds, you are now holding the object, and you cannot use this Talent in place of the Disarm Action. You cannot conceal the use of this Talent from the target. Reference Book: Star Wars Saga 