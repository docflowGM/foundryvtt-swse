 Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"8015e9d0947b458e","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"15bd84c78bfc1278","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"b5a93092a306ef49","name":"Acute Senses","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Master Scout","prerequisites":"","benefit":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","description":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Master Scout","treeId":"dca33c0215264a02","tags":["action-economy","armor","controller","damage-reduction","defender","force","force-control","force-defense","force-offense","melee","mobility","positioning","ranged","scout","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.acute_senses"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f0166d26d9f6252a"}}},{"_id":"ea59e2ba40bd177b","name":"Dastardly Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","tree":"Misfortune","prerequisites":"Combat Reflexes","description":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","benefit":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","class":"","category":"","costNumeric":null,"treeId":"67b59e020c1660eb","tags":["condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","lightsaber","melee","mobility","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9e4345faaaa94dd8"}}},{"_id":"1034bc1f1cd6a4c8","name":"Hidden Movement","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Camouflage","prerequisites":"","benefit":"Improved Stealth Any situation that would give you Concealment grants you Total Concealment instead. Reference Book: Star Wars Saga Edition Galaxy at War When Prone, you can spend a Swift Action to gain Concealment until the start of your next turn. If you stand up or move, you lose this benefit. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Improved Stealth Once per encounter, when you are within 2 squares of Cover or Concealment, you can move to that Cover or Concealment and make a Stealth check to hide as a single Move Action. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Improved Stealth You excel at fighting from the shadows, hitting your opponents when they least expect it. You can use each of the following actions once per encounter as a Standard Action: Blinding Strike: Make a single melee or ranged attack against an opponent within Range. If you damage the target, you gain Total Concealment against that target until the beginning of your next turn. Confusing Strike: Make a single melee or ranged attack against an opponent within Range. If this opponent is denied its Dexterity bonus to its Reflex Defense, or if you have Concealment from this opponent, a successful attack also causes the opponent to be able to take only a Swift Action on its next turn. Unexpected Attack: Make a melee or ranged attack within your Range against an opponent from whom you have Concealment. You gain a +2 bonus on this attack roll if you have Concealment, or a +5 bonus if you have Total Concealment. Reference Book: Star Wars Saga Edition Galaxy at War When you would normally provoke an Attack of Opportunity by moving out of a Threatened Area, you can roll a Stealth check, replacing your Reflex Defense with the results of your Stealth check if it is higher.","description":"Improved Stealth Any situation that would give you Concealment grants you Total Concealment instead. Reference Book: Star Wars Saga Edition Galaxy at War When Prone, you can spend a Swift Action to gain Concealment until the start of your next turn. If you stand up or move, you lose this benefit. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Improved Stealth Once per encounter, when you are within 2 squares of Cover or Concealment, you can move to that Cover or Concealment and make a Stealth check to hide as a single Move Action. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Improved Stealth You excel at fighting from the shadows, hitting your opponents when they least expect it. You can use each of the following actions once per encounter as a Standard Action: Blinding Strike: Make a single melee or ranged attack against an opponent within Range. If you damage the target, you gain Total Concealment against that target until the beginning of your next turn. Confusing Strike: Make a single melee or ranged attack against an opponent within Range. If this opponent is denied its Dexterity bonus to its Reflex Defense, or if you have Concealment from this opponent, a successful attack also causes the opponent to be able to take only a Swift Action on its next turn. Unexpected Attack: Make a melee or ranged attack within your Range against an opponent from whom you have Concealment. You gain a +2 bonus on this attack roll if you have Concealment, or a +5 bonus if you have Total Concealment. Reference Book: Star Wars Saga Edition Galaxy at War When you would normally provoke an Attack of Opportunity by moving out of a Threatened Area, you can roll a Stealth check, replacing your Reflex Defense with the results of your Stealth check if it is higher.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Camouflage","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.improved_stealth"}],"_source":"canonical-csv"},"treeId":"3926d582d2077489","tags":["action-economy","battlefield-control","controller","defender","leader","melee","mobility","positioning","ranged","scaling","scout","skills","stealth","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hidden_movement"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d0dad96e182d63d4"}}},{"_id":"86de8188dda3d2d6","name":"Hunter's Mark","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Bounty Hunter","prerequisites":"","benefit":"Once per encounter as a Free Action, you may designate an opponent. For the rest of the encounter, when you succeed on a melee or ranged attack against that opponent, you gain a bonus on damage equal to your Class Level. Your skill as a Bounty Hunter is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. You may choose to reroll any Gather Information checks made to Locate Individual, but you must accept the result of the reroll, even if it is worse. Prerequisites: , Hunter's Target This Talent applies only to an opponent you've designated as your Hunter's Target. Any attack or effect originating from the target that would normally move you along the Condition Track does not, in fact, move you along the Condition Track. Prerequisites: , Hunter's Target Prerequisites: , Hunter's Target, Nowhere to Hide Prerequisites: , Hunter's Target","description":"Once per encounter as a Free Action, you may designate an opponent. For the rest of the encounter, when you succeed on a melee or ranged attack against that opponent, you gain a bonus on damage equal to your Class Level. Your skill as a Bounty Hunter is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. You may choose to reroll any Gather Information checks made to Locate Individual, but you must accept the result of the reroll, even if it is worse. Prerequisites: , Hunter's Target This Talent applies only to an opponent you've designated as your Hunter's Target. Any attack or effect originating from the target that would normally move you along the Condition Track does not, in fact, move you along the Condition Track. Prerequisites: , Hunter's Target Prerequisites: , Hunter's Target, Nowhere to Hide Prerequisites: , Hunter's Target","class":"Bounty Hunter","costNumeric":null,"category":"Bounty Hunter","tree":"Bounty Hunter","treeId":"a47ed82a822e3962","tags":["action-economy","condition-removal","controller","dual-wield","melee","mobility","positioning","ranged","scoundrel","skills","social","stealth","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hunters_mark"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.74fb6b37af983a4c"}}},{"_id":"f721641991d78c12","name":"Hunter's Target","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Bounty Hunter","prerequisites":"Quick Draw","benefit":"As a Standard Action, you can instill bone-chilling fear in an opponent whom you selected for your . Make a Persuasion check against your target's Will Defense. If you equal or exceed your target's Will Defense, that target takes a -5 penalty to its Will Defense. This is a Mind-Affecting effect. The penalty remains as long as you have line of sight to your target and immediately ends if the line of sight is broken. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Once per turn, whenever an opponent whom you selected for your attempts to Withdraw, you can make an Attack of Opportunity against that target. Reference Book: Star Wars Saga Edition Unknown Regions You are fast with the binders. As a Swift Action, when you successfully use the Grab Action against a target, you can use Binder Cuffs or similar restraints to bind one of the target's arms to one of your arms or to an adjacent object. You cannot use improvised materials, such as Mesh Tape, for this Talent, and the binders must be in your hands or readily available. You and the target both take a -2 penalty to attack rolls and Reflex Defense while bound together. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Whenever you damage an opponent whom you selected for your , all allies gain a +2 bonus on their next attack roll against that opponent until the start of your next turn.","description":"As a Standard Action, you can instill bone-chilling fear in an opponent whom you selected for your . Make a Persuasion check against your target's Will Defense. If you equal or exceed your target's Will Defense, that target takes a -5 penalty to its Will Defense. This is a Mind-Affecting effect. The penalty remains as long as you have line of sight to your target and immediately ends if the line of sight is broken. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Once per turn, whenever an opponent whom you selected for your attempts to Withdraw, you can make an Attack of Opportunity against that target. Reference Book: Star Wars Saga Edition Unknown Regions You are fast with the binders. As a Swift Action, when you successfully use the Grab Action against a target, you can use Binder Cuffs or similar restraints to bind one of the target's arms to one of your arms or to an adjacent object. You cannot use improvised materials, such as Mesh Tape, for this Talent, and the binders must be in your hands or readily available. You and the target both take a -2 penalty to attack rolls and Reflex Defense while bound together. Reference Book: Star Wars Saga Edition Galaxy of Intrigue Whenever you damage an opponent whom you selected for your , all allies gain a +2 bonus on their next attack roll against that opponent until the start of your next turn.","class":"Bounty Hunter","costNumeric":null,"category":"Bounty Hunter","tree":"Bounty Hunter","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.hunters_mark"}],"_source":"canonical-csv"},"treeId":"a47ed82a822e3962","tags":["action-economy","defender","feat-chain","mobility","positioning","scoundrel","skills","social","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hunters_target"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.907906934ba3c563"}}},{"_id":"be6d21b6f3d2db9d","name":"Improved Stealth","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Camouflage","prerequisites":"","benefit":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scout","costNumeric":null,"category":"Scout","tree":"Camouflage","treeId":"3926d582d2077489","tags":["action-economy","ambush","controller","mobility","perception","piloting","positioning","ranged","scout","skills","stealth","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_stealth"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.073115894cad8cf9"}}},{"_id":"d866d251c5c8bf74","name":"Keen Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Awareness","prerequisites":"Acute Senses","benefit":"Ignore penalties against opponents with concealment (except total concealment).","description":"Ignore concealment penalties except total concealment.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Awareness","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.acute_senses"}],"_source":"canonical-csv"},"treeId":"1c48d1cd9ab1f5c8","tags":["feat-chain","ranged","scout","talent-chain"]},"effects":[{"_id":"ef19c1fd-23a5-4d9c-9a58-fbe2725f4f2c","name":"Keen Shot","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.ranged.concealmentPenalty","mode":5,"value":"0"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Keen Shot","effectType":"concealment_penalty"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.keen_shot"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.aca0598e9b0eb935"}}},{"_id":"0087e5f4d02a1f30","name":"Total Concealment","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Camouflage","prerequisites":"Hidden Movement","benefit":"Gain total concealment in place of any concealment.","description":"Gain total concealment whenever you have concealment.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Camouflage","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.hidden_movement"}],"_source":"canonical-csv"},"treeId":"3926d582d2077489","tags":["feat-chain","scout","talent-chain"]},"effects":[{"_id":"aeae9786-1d24-49e7-90ba-f426aac27eac","name":"Total Concealment","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.stealth.concealment","mode":5,"value":"total"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Total Concealment"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.total_concealment"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9d183b40a16b1376"}}},{"_id":"90c86a16998a0b1c","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d10+9","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":15,"flatDamageFormula":"1d10+9","useFlat":true}}}},{"_id":"6a820eb72499e531","name":"Blaster Rifle","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+7","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":4,"cost":1000,"equipped":true,"description":"<p>The standard military rifle used by armed forces across the galaxy. Reliable and effective at medium to long range.</p>","properties":[],"ammunitio