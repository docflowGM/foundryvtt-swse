Intelligence modifier increases so does the number of languages granted by this Feat.","prerequisite":"Int 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["feat-chain","leader","noble","non-force","striker"],"bonus_feat_for":["Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain bonus <a href=\"/wiki/Languages\" title=\"Languages\">Languages</a> equal to 1 + your <a href=\"/wiki/Intelligence\" title=\"Intelligence\">Intelligence</a> modifier (minimum 1)."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"int","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.5afd91fb081e576b"}}},{"_id":"d7be61a0eeb3c4cb","name":"Melee Defense","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"As a swift action, you may take a -5 penalty on melee attack rolls to gain a +5 bonus to your Reflex Defense against melee attacks until the start of your next turn.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["action-economy","defender","melee","mobility","non-force","soldier","striker"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Trade attack bonus on melee attacks for a dodge bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"int","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.3a847230d573a623"}}},{"_id":"32d59db6f9d67438","name":"Point-Blank Shot","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"+1 bonus on ranged attacks and damage against foes within Point-Blank <a class=\"mw-redirect\" href=\"/wiki/Range\" title=\"Range\">Range</a>."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.05459ac4d439f229"}}},{"_id":"64157a9bb5eb7cef","name":"Quick Draw","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You may draw or holster a weapon as a swift action instead of a move action.","prerequisite":"Base attack bonus +1","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["action-economy","controller","feat-chain","mobility","non-force","scoundrel","soldier"],"bonus_feat_for":["Soldier","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Draw weapon as a <a class=\"mw-redirect\" href=\"/wiki/Swift_Action\" title=\"Swift Action\">Swift Action</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.44705a692e2f01a6"}}},{"_id":"b5033d78ace94960","name":"Skill Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +5 bonus on all checks with the selected skill.","prerequisite":"Trained in the chosen skill","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","noble","non-force","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"c3f415447b0e231b","name":"Skill Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +5 bonus on all checks with the selected skill.","prerequisite":"Trained in the chosen skill","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","noble","non-force","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"9573405731848f0b","name":"Skill Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You become trained in one additional skill. You may take this feat multiple times.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["noble","non-force","scaling","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You become <a class=\"mw-redirect\" href=\"/wiki/Trained\" title=\"Trained\">Trained</a> in one Class Skill."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"a3171321dc73c69f","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"36c292d5db502f66","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"acb065079941f12a","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"1c383ceadc648042","name":"Acute Senses","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Master Scout","prerequisites":"","benefit":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","description":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Master Scout","treeId":"dca33c0215264a02","tags":["action-economy","armor","controller","damage-reduction","defender","force","force-control","force-defense","force-offense","melee","mobility","positioning","ranged","scout","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.acute_senses"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f0166d26d9f6252a"}}},{"_id":"1505d89270ab9a8b","name":"Hidden Movement","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Camouflage","prerequisites":"","benefit":"Improved Stealth Any situation that would give you Concealment grants you Total Concealment instead. Reference Book: Star Wars Saga Edition Galaxy at War When Prone, you can spend a Swift Action to gain Concealment until the start of your next turn. If you stand up or move, you lose this benefit. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Improved Stealth Once per encounter, when you are within 2 squares of Cover or Concealment, you can move to that Cover or Concealment and make a Stealth check to hide as a single Move Action. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Improved Stealth You excel at fighting from the shadows, hitting your opponents when they least expect it. You can use each of the following actions once per encounter as a Standard Action: Blinding Strike: Make a single melee or ranged attack against an opponent within Range. If you damage the target, you gain Total Concealment against that target until the beginning of your next turn. Confusing Strike: Make a single melee or ranged attack against an opponent within Range. If this opponent is denied its Dexterity bonus to its Reflex Defense, or if you have Concealment from this opponent, a successful attack also causes the opponent to be able to take only a Swift Action on its next turn. Unexpected Attack: Make a melee or ranged attack within your Range against an opponent from whom you have Concealment. You gain a +2 bonus on this attack roll if you have Concealment, or a +5 bonus if you have Total Concealment. Reference Book: Star Wars Saga Edition Galaxy at War When you would normally provoke an Attack of Opportunity by moving out of a Threatened Area, you can roll a Stealth check, replacing your Reflex Defense with the results of your Stealth check if it is higher.","description":"Improved Stealth Any situation that would give you Concealment grants you Total Concealment instead. Reference Book: Star Wars Saga Edition Galaxy at War When Prone, you can spend a Swift Action to gain Concealment until the start of your next turn. If you stand up or move, you lose this benefit. Reference Book: Star Wars Saga Edition Unknown Regions Prerequisites: , Improved Stealth Once per encounter, when you are within 2 squares of Cover or Concealment, you can move to that Cover or Concealment and make a Stealth check to hide as a single Move Action. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Improved Stealth You excel at fighting from the shadows, hitting your opponents when they least expect it. You can use each of the following actions once per encounter as a Standard Action: Blinding Strike: Make a single melee or ranged attack against an opponent within Range. If you damage the target, you gain Total Concealment against that target until the beginning of your next turn. Confusing Strike: Make a single melee or ranged attack against an opponent within Range. If this opponent is denied its Dexterity bonus to its Reflex Defense, or if you have Concealment from this opponent, a successful attack also causes the opponent to be able to take only a Swift Action on its next turn. Unexpected Attack: Make a melee or ranged attack within your Range against an opponent from whom you have Concealment. You gain a +2 bonus on this attack roll if you have Concealment, or a +5 bonus if you have Total Concealment. Reference Book: Star Wars Saga Edition Galaxy at War When you would normally provoke an Attack of Opportunity by moving out of a Threatened Area, you can roll a Stealth check, replacing your Reflex Defense with the results of your Stealth check if it is higher.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Camouflage","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.improved_stealth"}],"_source":"canonical-csv"},"treeId":"3926d582d2077489","tags":["action-economy","battlefield-control","controller","defender","leader","melee","mobility","positioning","ranged","scaling","scout","skills","stealth","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.hidden_movement"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d0dad96e182d63d4"}}},{"_id":"d4503dc96aa645e2","name":"Improved Stealth","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Camouflage","prerequisites":"","benefit":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"You're very good at hiding when mobile. You take no penalty on your Stealth check when moving your normal Speed. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). You may choose to reroll any Stealth check, but the result of the reroll must be accepted, even if it is worse. This Talent applies to Stealth checks made while Piloting a Starship (see Starship Stealth). Prerequisite: During a Surprise Round, if you make a ranged attack against a target that is Surprised, you can Aim at the target as a Free Action. Reference Book: Star Wars Saga Edition Galaxy at War If you start your turn with Total Concealment or Total Cover from a target, during that turn you can make a Stealth check as a Swift Action, opposed by the target's Perception check. If you succeed, the target is considered Flat-Footed against you until the end of your turn. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scout","costNumeric":null,"category":"Scout","tree":"Camouflage","treeId":"3926d582d2077489","tags":["action-economy","ambush","controller","mobility","perception","piloting","positioning","ranged","scout","skills","stealth","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_stealth"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.073115894cad8cf9"}}},{"_id":"963cefedafdb8d9e","name":"Gimmick","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Slicer","prerequisites":"Trained in Use Computer","benefit":"You may choose to reroll any Use Computer check made to Improve Access on a computer, keeping the better of the two results. You can substitute your Use Computer Skill for any Gather Information check as long as you have access to a computer network. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You can use your Use Computer modifier in place of your Deception modifier to create a deceptive appearance with forged electronic documents. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You excel at causing havoc with computers and electronics. As a Standard Action, you can lock down a computer terminal by making a Use Computer check, making it potentially difficult for anyone else to access. That computer is considered Unfriendly to anyone other than you who attempts to use it, and the result of your Use Computer check replaces the computer's Will Defense on an attempt to change its Attitude. This effect ends if anyone else succeeds in adjusting the computer's Attitude to Indifferent. You cannot Take 20 on this Use Computer check. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You are an expert in electronic security. When you make a Mechanics check to Disable Device, you can do so without the help of a Security Kit. Additionally, something goes wrong only when you fail the Mechanics check by 10 or more. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: When attempting to damage or disrupt a computer system, you may make a DC 20 Use Computer check. If successful, the computer moves -5 steps on the Condition Track and becomes disabled. If working remotely from another terminal or device, the DC increases to 30. Homebrew Reference Book: New Republic Campaign Guide When making a Use Computer check to Access Information, Disable or Erase Program, Improve Access, or Issue Routine Command, you may make a DC 25 Use Computer check before making the command. If successful, the effects of Cover Tracks are automatically applied regardless of the actual check DC. Homebrew Reference Book: New Republic Campaign Guide You may grant a +2 bonus to a computer's Will Defense against Use Computer checks to Improve Access. If the attacking slicer fails their Use Computer check by 5 or more, the Attitude of the computer moves 2 steps toward Hostile (Instead of the normal 1 step towards Hostile).","description":"You may choose to reroll any Use Computer check made to Improve Access on a computer, keeping the better of the two results. You can substitute your Use Computer Skill for any Gather Information check as long as you have access to a computer network. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You can use your Use Computer modifier in place of your Deception modifier to create a deceptive appearance with forged electronic documents. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You excel at causing havoc with computers and electronics. As a Standard Action, you can lock down a computer terminal by making a Use Computer check, making it potentially difficult for anyone else to access. That computer is considered Unfriendly to anyone other than you who attempts to use it, and the result of your Use Computer check replaces the computer's Will Defense on an attempt to change its Attitude. This effect ends if anyone else succeeds in adjusting the computer's Attitude to Indifferent. You cannot Take 20 on this Use Computer check. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You are an expert in electronic security. When you make a Mechanics check to Disable Device, you can do so without the help of a Security Kit. Additionally, something goes wrong only when you fail the Mechanics check by 10 or more. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: When attempting to damage or disrupt a computer system, you may make a DC 20 Use Computer check. If successful, the computer moves -5 steps on the Condition Track and becomes disabled. If working remotely from another terminal or device, the DC increases to 30. Homebrew Reference Book: New Republic Campaign Guide When making a Use Computer check to Access Information, Disable or Erase Program, Improve Access, or Issue Routine Command, you may make a DC 25 Use Computer check before making the command. If successful, the effects of Cover Tracks are automatically applied regardless of the actual check DC. Homebrew Reference Book: New Republic Campaign Guide You may grant a +2 bonus to a computer's Will Defense against Use Computer checks to Improve Access. If the attacking slicer fails their Use Computer check by 5 or more, the Attitude of the computer moves 2 steps toward Hostile (Instead of the normal 1 step towards Hostile).","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Slicer","treeId":"64874e65579e4cf4","tags":["action-economy","condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","leader","mechanics","mobility","scaling","scoundrel","skills","slicing","social","striker","support","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.gimmick"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8d8937a416fc0d81"}}},{"_id":"832e17e584583812","name":"Vibrodagger","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d4+5","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":0.5,"cost":250,"equipped":true,"description":"<p>A small vibroweapon easily concealed. Popular with assassins and spies.</p>\n      <p><strong>Special:</strong> Vibroweapon. Critical threat range 19-20. Can be thrown (range 6 squares).</p>","properties":["Vibroweapon","Critical 19-20","Concealable"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"advanced-melee","subcategory":"advanced","costNumeric":250,"category":"advanced"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-vibrodagger"},"swse":{"npc":{"flatAttackBonus":1,"flatDamageFormula":"2d4+5","useFlat":true}}}},{"_id":"0ffc751da4404c3d","name":"Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d6+4","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":500,"equipped":true,"description":"<p>The standard sidearm used throughout the galaxy. Reliable, common, and effective at close to medium range.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":500,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":8,"flatDamageFormula":"3d6+4","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Bothan","Nonheroic Level":0,"Class Levels":{"Medium Bothan Scoundrel":2,"Scout":6},"Force Points":5,"Dark Side Points":0,"Languages":["Basic","Bothese"],"Unassigned Languages":5,"Reflex Defense":23,"Flat-Footed Defense":20,"Fortitude Defense":19,"Will Defense":22,"Hit Points":"48","Damage Threshold":19,"Speed":"6 Squares","Melee Weapons":"Vibrodagger +1 (2d4+5)","Ranged Weapons":"Blaster Pistol +8 (3d6+4)","Attack Options":["Vibrodagger","Blaster Pistol"],"Force Powers":[],"Force Secrets":[],"Force Techniques":[],"Strength":"12","Dexterity":"16","Constitution":"10","Intelligence":"14","Wisdom":"12","Charisma":"13","Talents":["Acute Senses","Hidden Movement","Improved Stealth","Gimmick"],"Feats":["Combat Reflexes","Improved Disarm","Linguist","Melee Defense","Point-Blank Shot","Quick Draw","Skill Focus (Deception)","Skill Focus (Gather Information)","Skill Training (Use Computer)","Weapon Proficiency (Pistols)","Weapon Proficiency (Rifles)","Weapon Proficiency (Simple Weapons)"],"Trained Skills":["Acrobatics","Deception","Gather Information","Perception","Persuasion","Stealth"],"Gear":"Blaster Pistol , Vibrodagger","Melee Attack":"Defense, Defense","Ranged Attack":"","Species Bonuses":["Attack Bonus","Conditional Bonus Feat"],"Species Traits":["Conditional Bonus Feat ( Skill Focus (Gather Information) )","Iron Will"]},"mode":"play","sourcePack":"nonheroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1,"statblockAuthority"