ack and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","class":"","category":"","costNumeric":null,"treeId":"67b59e020c1660eb","tags":["condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","lightsaber","melee","mobility","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9e4345faaaa94dd8"}}},{"_id":"3c3049a61a683b7e","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+1","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":3,"flatDamageFormula":"1d4+1","useFlat":true}}}},{"_id":"8f048defb40eee30","name":"Vibrodagger","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d4+1","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":0.5,"cost":250,"equipped":true,"description":"<p>A small vibroweapon easily concealed. Popular with assassins and spies.</p>\n      <p><strong>Special:</strong> Vibroweapon. Critical threat range 19-20. Can be thrown (range 6 squares).</p>","properties":["Vibroweapon