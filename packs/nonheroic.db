Compendium.foundryvtt-swse.species.species-human"}}},{"_id":"f05e5301d32ec42e","name":"Acrobatic Strike","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You can use Acrobatics to tumble through an enemy’s space and gain a +2 bonus on your next melee attack against that enemy.","prerequisite":"Acrobatics 15 ranks","special":"","normalText":"","sourcebook":"Galaxy at War","page":23,"tags":["feat-chain","melee","non-force","scout","striker"],"bonus_feat_for":["Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +2 competence bonus on next attack against opponent you <a class=\"mw-redirect\" href=\"/wiki/Tumble\" title=\"Tumble\">Tumble</a> past."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"skillTrained","skill":"a6c5e98148aad9a9"}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.419a502e59264382"}}},{"_id":"ca6ef410647dec07","name":"Dual Weapon Mastery I","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You reduce the penalty for fighting with two weapons by 2.","prerequisite":"Dex 13, Two-Weapon Fighting","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":86,"tags":["damage-reduction","dual-wield","feat-chain","non-force","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Take a -5 penalty on attacks when attacking with two weapons, or both ends of a double weapon."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"dex","min":13},{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[{"_id":"5e1f7aa0-8f41-4f6e-9a16-1710b2de25e9","name":"Dual Weapon Mastery I","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat",