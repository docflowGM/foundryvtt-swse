 proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"abeed82fb3a4c9be","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"8525c51b1947ade0","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"d1988c23cf8512f1","name":"Jet Pack Training","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Rocket Jumper","prerequisites":"","benefit":"As a Standard Action you can expend one of your Jet Pack's charges to make an attack with the Jet Pack, treating it as a Flamethrower. You cannot use this Talent when you are flying. You are considered proficient in the Flamethrower for purposes of making this attack. Prerequisite: You always use the proper trajectories to maximize the efficiency of your rocket-pack burn rates. You increase your fly Speed by 2 squares when using a Jet Pack. Prerequisite: Once per encounter, as a Reaction when an opponent moves adjacent to you, you can expend one charge of your Jet Pack to fly and Move your Speed, or Withdraw. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Clones Once per round (as a Reaction), when you are airborne with a Jet Pack or Rocket Pack, you may negate a successful attack by making a Pilot check. The DC of the check is equal to the result of the attack roll you wish to negate. In addition, when flying a Jet Pack, you are considered proficient with its integrated weapons. This includes any piece of equipment integrated to the Jet Pack, though it does not apply to equipment integrated into armor to which the Jet Pack might be mounted. If you have taken the Starship Tactics feat, you may activate Starship Maneuvers as appropriate while flying a Jet Pack.","description":"As a Standard Action you can expend one of your Jet Pack's charges to make an attack with the Jet Pack, treating it as a Flamethrower. You cannot use this Talent when you are flying. You are considered proficient in the Flamethrower for purposes of making this attack. Prerequisite: You always use the proper trajectories to maximize the efficiency of your rocket-pack burn rates. You increase your fly Speed by 2 squares when using a Jet Pack. Prerequisite: Once per encounter, as a Reaction when an opponent moves adjacent to you, you can expend one charge of your Jet Pack to fly and Move your Speed, or Withdraw. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Clones Once per round (as a Reaction), when you are airborne with a Jet Pack or Rocket Pack, you may negate a successful attack by making a Pilot check. The DC of the check is equal to the result of the attack roll you wish to negate. In addition, when flying a Jet Pack, you are considered proficient with its integrated weapons. This includes any piece of equipment integrated to the Jet Pack, though it does not apply to equipment integrated into armor to which the Jet Pack might be mounted. If you have taken the Starship Tactics feat, you may activate Starship Maneuvers as appropriate while flying a Jet Pack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Rocket Jumper","treeId":"1f50c63b6f08de10","tags":["action-economy","armor","controller","defender","heavy-weapons","mobility","positioning","ranged","soldier","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.jet_pack_training"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d3a642f2ceb21ed4"}}},{"_id":"26a27fd9c4853c40","name":"Improved Trajectory","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Rocket Jumper","prerequisites":"Jet Pack Training","benefit":"Increase fly speed by 2 squares.","description":"","class":"Soldier","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.jet_pack_training"}],"_source":"canonical-csv"},"treeId":"1f50c63b6f08de10","tree":"Rocket Jumper","tags":["feat-chain","heavy-weapons","mobility","positioning","soldier","talent-chain"]},"effects":[{"_id":"af58f7ae-04a6-4967-b9d1-02cede4bfed7","name":"Improved Trajectory","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.speed","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Improved Trajectory"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.improved_trajectory"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f96f1d48cf6604c2"}}},{"_id":"0cd9452665d16d4d","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+2","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":4,"flatDamageFormula":"1d4+2","useFlat":true}}}},{"_id":"250ee8ba1a15513c","name":"Double-Barreled Blaster Carbine","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d8+1","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1.9,"cost":1200,"equipped":true,"description":"<p>A double-barreled carbine that can fire both barrels.</p>","properties":["Restricted","Inaccurate"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficien