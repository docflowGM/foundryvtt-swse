e":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"10a4e1dfc528840b","name":"Skill Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +5 bonus on all checks with the selected skill.","prerequisite":"Trained in the chosen skill","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","noble","non-force","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"3c912ebcd2cf9cfd","name":"Skill Focus","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain a +5 bonus on all checks with the selected skill.","prerequisite":"Trained in the chosen skill","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","noble","non-force","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"44cfec3a48612b32","name":"Toughness","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You gain +5 hit points.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["non-force","scout","soldier","striker"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Gain +1 Hit Point per Character Level."}},"effects":[{"name":"Toughness","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.hitPoints.bonusPerLevel","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"hit-points","perLevel":true}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.11db29efd899c438"}}},{"_id":"e98d0828c9b87d20","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"d0e93984bce85f79","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"6eb5e39abd417456","name":"Attract Minion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Mastermind","prerequisites":"","benefit":"Impel Ally I, Impel Ally II You attract a particularly skilled and powerful Minion. The Minion is a Nonheroic character with a Class Level equal to your Character Level. This Talent otherwise functions as the Talent. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Whenever you are adjacent to a minion gained with the Talent, once per turn as a Reaction to being attacked you can redirect the attack against that minion. Compare the attack roll to the minion's Defenses and resolve the attack as normal. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Bodyguard I Prerequisites: , Bodyguard I, Bodyguard II Prerequisite: Whenever you are adjacent to a Minion, you increase any Cover bonus to your Reflex Defense by +2. Reference Book: Star Wars Saga Edition Scum and Villainy Spend two Swift Actions to select two allies. Each ally can move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Reference Book: Star Wars Saga Edition Scum and Villainy Spend two Swift Actions to grant all allies that are in your line of sight and within 6 squares of you the ability to use the Withdraw Action as a Swift Action until the start of your next turn. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Whenever one of your minions is killed, he or she is replaced by another minion of the same level. This replacement occurs 24 hours later.","description":"Impel Ally I, Impel Ally II You attract a particularly skilled and powerful Minion. The Minion is a Nonheroic character with a Class Level equal to your Character Level. This Talent otherwise functions as the Talent. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Whenever you are adjacent to a minion gained with the Talent, once per turn as a Reaction to being attacked you can redirect the attack against that minion. Compare the attack roll to the minion's Defenses and resolve the attack as normal. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisites: , Bodyguard I Prerequisites: , Bodyguard I, Bodyguard II Prerequisite: Whenever you are adjacent to a Minion, you increase any Cover bonus to your Reflex Defense by +2. Reference Book: Star Wars Saga Edition Scum and Villainy Spend two Swift Actions to select two allies. Each ally can move 2 squares as a Reaction. This movement does not provoke Attacks of Opportunity. Reference Book: Star Wars Saga Edition Scum and Villainy Spend two Swift Actions to grant all allies that are in your line of sight and within 6 squares of you the ability to use the Withdraw Action as a Swift Action until the start of your next turn. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Whenever one of your minions is killed, he or she is replaced by another minion of the same level. This replacement occurs 24 hours later.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Mastermind","treeId":"560cc7994b357a0d","tags":["action-economy","controller","defender","leader","mobility","positioning","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.attract_minion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.2b31cb2ea7ad64b9"}}},{"_id":"031a0c0ec968f10c","name":"Born Leader","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Naval Officer","prerequisites":"","benefit":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","description":"Prerequisites: Charisma 13, Intelligence 13, When you are the Commander of a Capital Ship, calculate its Reflex Defense using your Heroic Level plus one-half the ship's armor bonus (rounded down), the Pilot's Heroic Level, or the ship's Armor bonus, whichever is highest. In addition, all Gunners on your ship add one-half your Heroic Level, or one-half their Heroic Level, whichever is more, to damage rolls with Vehicle Weapons. Finally, you treat any generic crew as being one quality level higher (maximum of Ace, see Crew Quality).","class":"Noble","costNumeric":null,"category":"Noble","tree":"Naval Officer","treeId":"057a978a7dc1d5a7","tags":["armor","defender","noble","striker","support","sustained-damage"]},"effects":[{"_id":"f9275c38-3cb5-4ab3-aaa5-25e5722dcdd3","name":"Born Leader","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.defenses.will","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Born Leader"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.born_leader"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.6a66ba6e0834dd6f"}}},{"_id":"9951eed356f2a982","name":"Demand Surrender","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Consular","prerequisites":"Farseeing","benefit":"Once per turn as a Swift Action, you can remove one ongoing Mind-Affecting effect (such as the effects of or Weaken Resolve Talents, or the effect of being moved to the end of the Condition Track by the Adept Negotiator Talent, or the ongoing effects of the Mind Trick Force Power) from a single allied target within line of sight. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide When you use Farseeing, or a Force Power or Talent that has Farseeing as a prerequisite, other Force-users with Farseeing in their Force Power Suite can Aid Another on your Use the Force check as a Reaction, if they are within 6 squares of you. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Once per round as a Swift Action, you grant one ally within 12 squares of you (and within your line of sight) Bonus Hit Points equal to 5 + your Charisma modifier. These Bonus Hit Points last until the beginning of your next turn (at which point any remaining Bonus Hit Points are lost), and any damage dealt to that ally comes out of Bonus Hit Points first. You take a -5 penalty on all Use the Force checks until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide","description":"Once per turn as a Swift Action, you can remove one ongoing Mind-Affecting effect (such as the effects of or Weaken Resolve Talents, or the effect of being moved to the end of the Condition Track by the Adept Negotiator Talent, or the ongoing effects of the Mind Trick Force Power) from a single allied target within line of sight. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide When you use Farseeing, or a Force Power or Talent that has Farseeing as a prerequisite, other Force-users with Farseeing in their Force Power Suite can Aid Another on your Use the Force check as a Reaction, if they are within 6 squares of you. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Once per round as a Swift Action, you grant one ally within 12 squares of you (and within your line of sight) Bonus Hit Points equal to 5 + your Charisma modifier. These Bonus Hit Points last until the beginning of your next turn (at which point any remaining Bonus Hit Points are lost), and any damage dealt to that ally comes out of Bonus Hit Points first. You take a -5 penalty on all Use the Force checks until the beginning of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide","class":"Noble","costNumeric":null,"category":"Noble","tree":"Jedi Consular","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.presence"}],"_source":"canonical-csv"},"treeId":"e99cfa9db8493573","tags":["action-economy","condition-removal","controller","feat-chain","force","force-control","force-offense","leader","light-side","mobility","noble","positioning","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.demand_surrender"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.871638a983029bc4"}}},{"_id":"000a010c6ca7221e","name":"Fool's Luck","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Fortune","prerequisites":"","benefit":"Once per encounter, you can turn a Critical Hit against you into a normal hit. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Once per encounter, as a Reaction, you gain a +5 luck bonus to any one Defense until the start of your next turn. Reference Book: Star Wars Saga Edition Scum and Villainy","description":"Once per encounter, you can turn a Critical Hit against you into a normal hit. Reference Book: Star Wars Saga Edition Scum and Villainy Prerequisite: Once per encounter, as a Reaction, you gain a +5 luck bonus to any one Defense until the start of your next turn. Reference Book: Star Wars Saga Edition Scum and Villainy","class":"Scoundrel","costNumeric":null,"category":"Scoundrel","tree":"Fortune","treeId":"cee9b9398682b7d0","tags":["action-economy","defender","precision","scoundrel","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.fools_luck"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.5319a796f2c4ff64"}}},{"_id":"86d900fe090812bc","name":"Inspire Fear I","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Infamy","prerequisites":"","benefit":"As , except that the penalty increases to -2. Prerequisites: , I As , except that the penalty increases to -5. Your reputation as a Crime Lord is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. Prerequisites: , I, II, Notorious Any opponent that is reduced to half Hit Points or fewer while within 6 squares of you takes a -2 penalty on all attack rolls and Skill Checks for the duration of the encounter. This is a Mind-Affecting Fear effect.","description":"As , except that the penalty increases to -2. Prerequisites: , I As , except that the penalty increases to -5. Your reputation as a Crime Lord is known throughout the galaxy, even on fringe worlds. When you are not Disguised, you may reroll any Persuasion checks made to Intimidate, keeping the better of the two results. Prerequisites: , I, II, Notorious Any opponent that is reduced to half Hit Points or fewer while within 6 squares of you takes a -2 penalty on all attack rolls and Skill Checks for the duration of the encounter. This is a Mind-Affecting Fear effect.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Infamy","treeId":"c1be604242cb328f","tags":["damage-reduction","positioning","skills","social","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.inspire_fear_i"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.cf4b1e5b126a2a7e"}}},{"_id":"0f469f6829d320a0","name":"Intimidating Defense","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Influence","prerequisites":"Presence, Persuasion","benefit":"Once per encounter, if the opponent has attacked you, make Persuasion vs Will Defense; impose -5 on that attack (+5 if opponent is higher level).","description":"After an opponent attacks you, impose a -5 penalty on their next attack.","class":"Noble","costNumeric":null,"category":"Noble","tree":"Influence","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.presence"}],"_source":"canonical-csv"},"treeId":"8375b9b26b679901","tags":["defender","feat-chain","noble","skills","social","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.intimidating_defense"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.de751f28fc269c85"}}},{"_id":"33755f2ff5292e05","name":"Notorious","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Infamy","prerequisites":"","benefit":"Your reputation as a crime lord is known throughout the galaxy, even on fringe worlds. When you are not disguised, you may reroll any Persuasion checks made to intimidate others, keeping the better result.","description":"Your reputation as a crime lord is known throughout the galaxy, even on fringe worlds. When you are not disguised, you may reroll any Persuasion checks made to intimidate others, keeping the better result.","class":"Crime Lord","costNumeric":null,"category":"Crime Lord","tree":"Infamy","treeId":"c1be604242cb328f","tags":["leader","scoundrel","skills","social","striker","support"],"summary":"When not disguised, reroll Persuasion checks to intimidate and keep the better result.","source":"Saga Edition Core Rulebook","page":210},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.notorious_infamy"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.09744041cdcc9e22"}}},{"_id":"2307246b015d4298","name":"Presence","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Influence","prerequisites":"","benefit":"Once per encounter, you can make a Persuasion check as a Standard Action to demand surrender from an opponent who has been reduced to one-half or less of its hit points. If your check result equals or exceeds the target's Will Defense, it surrenders to you and your allies, drops any weapons it is holding, and takes no hostile actions. If the target is higher level than you, it gains a +5 bonus to its Will Defense. If you or any of your allies attack it, it no longer submits to your will and can act normally. You can only use this Talent against a particular target once per encounter. This is a Mind-Affecting effect. Prerequisites: , Weaken Resolve Prerequisite: Once per round, when you deal damage equal to or greater than the target's Damage Threshold, you can make a Persuasion check as a Free Action; if the result equals or exceeds the target's Will Defense, you fill the target with terror, causing it to flee from you at top speed for 1 minute. The target can't take Standard Actions, Swift Actions, or Full-Round Actions while fleeing, but the target stops fleeing and can act normally if it is wounded. As a Free Action or Reaction, the target can spend a Force Point (if it has not already spent one earlier in the round) to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your Character Level. This is a Mind-Affecting fear effect. Unlike with other Mind-Affecting effects, you need only to hail a Vehicle to weaken the crew's resolve. When you deal damage that equals or exceeds a Vehicle's Damage Threshold, you may use this Talent; in addition, you may Ready an Action to use this Talent after any Gunner on your Vehicle deals damage that equals or exceeds a Vehicle's Damage Threshold. You make your check against the Vehicle's Commander; all Nonheroic crews are assumed to have a Will Defense of 10. The effect is automatically negated if the target Vehicle's Challenge Level is greater than your Heroic Level or your Vehicle's Challenge Level. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion You get under an opponent's skin. Once per encounter, make a Persuasion check to Intimidate one creature within line of sight as a Standard Action. On a success, instead of the normal effect of an Intimidate application of the Persuasion skill, the affected creature can take only a single Swift Action on its next turn. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion Once per encounter, as a Reaction, you can make a Persuasion check to Intimidate one creature that is making a melee or ranged attack against you, and is within your line of sight. If you succeed, you impose a -5 penalty to that attack roll. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Homebrew Reference Book: Legacy of the Force Sourcebook","description":"Once per encounter, you can make a Persuasion check as a Standard Action to demand surrender from an opponent who has been reduced to one-half or less of its hit points. If your check result equals or exceeds the target's Will Defense, it surrenders to you and your allies, drops any weapons it is holding, and takes no hostile actions. If the target is higher level than you, it gains a +5 bonus to its Will Defense. If you or any of your allies attack it, it no longer submits to your will and can act normally. You can only use this Talent against a particular target once per encounter. This is a Mind-Affecting effect. Prerequisites: , Weaken Resolve Prerequisite: Once per round, when you deal damage equal to or greater than the target's Damage Threshold, you can make a Persuasion check as a Free Action; if the result equals or exceeds the target's Will Defense, you fill the target with terror, causing it to flee from you at top speed for 1 minute. The target can't take Standard Actions, Swift Actions, or Full-Round Actions while fleeing, but the target stops fleeing and can act normally if it is wounded. As a Free Action or Reaction, the target can spend a Force Point (if it has not already spent one earlier in the round) to negate the effect. The effect is automatically negated if the target's level is equal to or higher than your Character Level. This is a Mind-Affecting fear effect. Unlike with other Mind-Affecting effects, you need only to hail a Vehicle to weaken the crew's resolve. When you deal damage that equals or exceeds a Vehicle's Damage Threshold, you may use this Talent; in addition, you may Ready an Action to use this Talent after any Gunner on your Vehicle deals damage that equals or exceeds a Vehicle's Damage Threshold. You make your check against the Vehicle's Commander; all Nonheroic crews are assumed to have a Will Defense of 10. The effect is automatically negated if the target Vehicle's Challenge Level is greater than your Heroic Level or your Vehicle's Challenge Level. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion You get under an opponent's skin. Once per encounter, make a Persuasion check to Intimidate one creature within line of sight as a Standard Action. On a success, instead of the normal effect of an Intimidate application of the Persuasion skill, the affected creature can take only a single Swift Action on its next turn. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Prerequisites: , Trained in Persuasion Once per encounter, as a Reaction, you can make a Persuasion check to Intimidate one creature that is making a melee or ranged attack against you, and is within your line of sight. If you succeed, you impose a -5 penalty to that attack roll. If the target is a higher level than you, it gains a +5 bonus to its Will Defense against the Intimidate check. This is a Mind-Affecting effect. Homebrew Reference Book: Legacy of the Force Sourcebook","class":"Noble","costNumeric":null,"category":"Noble","tree":"Influence","treeId":"8375b9b26b679901","tags":["action-economy","damage-reduction","defender","force","force-defense","force-offense","melee","mobility","noble","positioning","ranged","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.presence"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.ec8f2ba706cc2c05"}}},{"_id":"1ba5e8556e4ccd5a","name":"Stun Baton","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d6+5(Stun)","damageType":"stun","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1.5,"cost":250,"equipped":true,"description":"<p>A non-lethal weapon that delivers an electrical shock to stun targets.</p>\n      <p><strong>Special:</strong> Deals stun damage only. Target must make Fortitude save or be stunned.</p>","properties":["Stun","Non-Lethal"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"simple","subcategory":"simple","costNumeric":250,"category":"simple"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-stun-baton"},"swse":{"npc":{"flatAttackBonus":7,"flatDamageFormula":"2d6+5(Stun)","useFlat":true}}}},{"_id":"61a9bfe72cae9c92","name":"Blaster Pistol","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"3d6+5","damageType":"energy","attackBonus":0,"attackAttribute":"dex","range":"ranged","weight":1,"cost":500,"equipped":true,"description":"<p>The standard sidearm used throughout the galaxy. Reliable, common, and effective at close to medium range.</p>","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"ranged","proficiency":"pistols","subcategory":"pistol","costNumeric":500,"category":"pistol"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-blaster-pistol"},"swse":{"npc":{"flatAttackBonus":5,"flatDamageFormula":"3d6+5","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Large","Species":"Hutt","Nonheroic Level":0,"Class Levels":{"Large Hutt Noble":5,"Scoundrel":2,"Crime Lord":4},"Force Points":3,"Dark Side Points":13,"Languages":["Basic","Huttese"],"Unassigned Languages":8,"Reflex Defense":21,"Flat-Footed Defense":21,"Fortitude Defense":24,"Will Defense":29,"Hit Points":"90","Damage Threshold":29,"Speed":"6 Squares","Melee Weapons":"Stun Baton +7 (2d6+5 ( Stun ))","Ranged Weapons":"Blaster Pistol +5 (3d6+5)","Attack Options":["Stun Baton","Blaster Pistol"],"Force Powers":[],"Force Secrets":[],"Force Techniques":[],"Strength":"10","Dexterity":"6","Constitution":"14","Intelligence":"18","Wisdom":"16","Charisma":"18","Talents":["Attract Minion","Born Leader","Demand Surrender","Fool's Luck","Inspire Fear I","Intimidating Defense","Notorious","Presence"],"Feats":["Improved Defenses","Linguist","Point-Blank Shot","Skill Focus (Deception)","Skill Focus (Gather Information)","Skill Focus (Knowledge (Bureaucracy))","Skill Focus (Knowledge (Galactic Lore))","Skill Focus (Persuasion)","Toughness","Weapon Proficiency (Pistols)","Weapon Proficiency (Simple Weapons)"],"Trained Skills":["Deception","Gather Information","Initiative","Perception","Persuasion"],"Gear":"Blaster Pistol , Stun Baton , Enforcers (several Thugs plus 1 8th-level Minion )","Melee Attack":"","Ranged Attack":"","Species Bonuses":["Attack Bonus"],"Species Traits":["Force Resistance","Supreme Stability","Silver Tongued"]},"mode":"play","sourcePack":"nonheroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1,"statblockAuthority":true,"normalizationVersion":2,"nonheroicLegalSkeletonVersion":1,"nonheroicLegalSkeletonStatus":"heroic-profile"}}}}
