,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Trade attack bonus on melee attacks for a dodge bonus to <a class=\"mw-redirect\" href=\"/wiki/Reflex_Defense\" title=\"Reflex Defense\">Reflex Defense</a>."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"attribute","ability":"int","min":13}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.3a847230d573a623"}}},{"_id":"c552759de182ace8","name":"Rapid Strike","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"When making a full attack with a melee weapon, you may make one additional attack. All attacks take a -2 penalty.","prerequisite":"Dex 13","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["feat-chain","melee","non-force","soldier"],"bonus_feat_for":["Soldier"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Take a -2 penalty on a melee attack roll to deal +1 die of damage."},"prerequisitesStructured":{"type":"all","conditions":[{"type":"bab","min":1}],"_source":"canonical-csv"}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ccb33e58342499a3"}}},{"_id":"85bf7cdae9666da2","name":"Skill Training","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You become trained in one additional skill. You may take this feat multiple times.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":88,"tags":["noble","non-force","scaling","scoundrel","striker"],"bonus_feat_for":["Noble","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"You become <a class=\"mw-redirect\" href=\"/wiki/Trained\" title=\"Trained\">Trained</a> in one Class Skill."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.a9f6de36f24ef202"}}},{"_id":"8decb61d2b1a9a7b","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"50ff14b9215ea8b9","name":"Weapon Proficiency (Pistols)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with pistols and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"3f6b901f04f73c18","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"e72171f92247d557","name":"Improved Sense Force","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may use the Sense Force ability of the Use the Force Skill as a Move Action rather than a Full-Round Action.","prerequisite":"Sense Force","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may use the Sense Force ability of the Use the Force Skill as a Move Action rather than a Full-Round Action.</p><p><strong>Related Power:</strong> Sense Force</p><p><strong>Prerequisites:</strong> Sense Force</p>","relatedPower":"Sense Force"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.ad67b8f3959860f2"}}},{"_id":"780e33ed465801ed","name":"Block","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sith Alchemy","prerequisites":"","benefit":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","description":"Create Sith Amulet: You can create a Sith Amulet. The creation of a Sith Amulet requires 25,000 credits' worth of gems and other raw materials, and the creation process takes 1 week (this work can be spread out over several sessions and need not be consecutive). At the end of the process, you must spend a Force Point to complete the Sith Amulet, after which point it functions exactly as a Sith Amulet. Create Sith Armor: You can transform a suit of normal Battle Armor into the Dark Armor worn by Sith Lords. You must have a suit of Battle Armor to transform into the Dark Armor (Light Battle Armor becomes Light Dark Armor, Battle Armor becomes Dark Armor, and Heavy Battle Armor becomes Heavy Dark Armor). The transformation process takes 1 day for Light Dark Armor, 2 days for Dark Armor, and 3 days for Heavy Dark Armor. You must spend a Force Point at the end of the creation process to complete the Armor's transformation. Create Sith Talisman: You can spend a Force Point to imbue a portable object with the Dark Side, creating a Sith Talisman that provides offensive strength to a Force Power. Creating the Sith Talisman takes a Full-Round Action. While you wear or carry the Sith Talisman on your person, you add 1d6 to your damage with Force Powers. You increase your Dark Side Score by 1 when you first wear or carry a Sith Talisman. You can have only one Sith Talisman active at any given time, and if it is destroyed, you cannot create another one for 24 hours. Create Sith Weapon: You can alchemically treat a Simple Weapon (Melee) or an Advanced Melee Weapon, turning it into a Sith Weapon. You must spend a Force Point and spend 1 hour imbuing the Weapon with the properties of a Sith Alchemical Weapon (see also: Sith Alchemical Weapon Template). A Lightsaber does not ignore the Sith Weapon's DR, and characters who are proficient in the Weapon's use can treat it as a Lightsaber for the purposes of the , Deflect, and Redirect Shot Talents (and any Talents that have these Talents as a prerequisite). Additionally, as a Swift Action, the wielder of a Sith Weapon can spend a Force Point to gain a bonus equal to their Dark Side Score to the damage of their next attack made with the Weapon before the end of the encounter. This increases the wielder's Dark Side Score by 1.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Sith Alchemy","treeId":"a67faf2ae089ab5d","tags":["action-economy","armor","dark-side","defender","force","force-offense","jedi","lightsaber","melee","mobility","ranged","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.block"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9379daa94a228c04"}}},{"_id":"fe68c51240338b18","name":"Clear Mind","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Sentinel","prerequisites":"","benefit":"Force Haze Prerequisites: , Force Haze","description":"Force Haze Prerequisites: , Force Haze","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Sentinel","treeId":"36f18f3e974feb33","tags":["force","jedi","light-side"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.clear_mind"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.8bd201bb22c8da3a"}}},{"_id":"5f333faa40ab8b50","name":"Dastardly Strike","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Misfortune","tree":"Misfortune","prerequisites":"Combat Reflexes","description":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","benefit":"Whenever you deal damage to an opponent denied its Dexterity bonus to its Reflex Defense, you can choose not to move the target down the Condition Track and instead impose a -5 penalty on all your opponent's attack and melee damage rolls until the end of your next turn. Homebrew Reference Book: Legacy of the Force Sourcebook At the start of your turn, you may spend a Force Point. Until the start of your next turn, you can make an Attack of Opportunity against a single opponent that has just taken damage from another character. Homebrew Reference Book: Legacy of the Force Sourcebook When attacking with a Light Melee weapon, a Lightsaber, or any other weapon that benefits from the Weapon Finesse Feat, you may add an additional point of damage on a successful attack.","class":"","category":"","costNumeric":null,"treeId":"67b59e020c1660eb","tags":["condition-removal","controller","defender","feat-chain","force","force-control","force-defense","force-offense","lightsaber","melee","mobility","striker","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9e4345faaaa94dd8"}}},{"_id":"855b274d1351058c","name":"Deflect","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"","benefit":"Redirect Shot","description":"Redirect Shot","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["jedi","lightsaber","melee","ranged"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.deflect"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.72c644f7a09b1186"}}},{"_id":"2977d6fa1f98fdfc","name":"Force Fortification","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Duelist","prerequisites":null,"benefit":"Negate critical hits and take normal damage instead.","description":"When you would suffer a critical hit, negate the critical and take normal damage instead.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Duelist","treeId":"b3c5d90b5036f39b","tags":["force","force-offense","jedi","precision","striker"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"skillSubstitution":true,"substitutionType":"fortitude_to_will","description":"Your Will Defense now functions in place of Fortitude Defense","id":"swse.talent.force_fortification"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.be932caff635f8bc"}}},{"_id":"50f02faaef9f05fc","name":"Force Haze","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Sentinel","prerequisites":"Farseeing","benefit":"You can spend a Force Point as a Standard Action to create a \"Haze\" that hides you and your allies from the perception of others. You can hide a number of creatures in line of sight equal to your Class Level. Make a Use the Force check and compare the result to the Will Defense of any opponent that moves into line of sight of any creature hidden by your . If your check result equals or exceeds the opponent's Will Defense, all hidden creatures are treated as if they had Total Concealment against the opponent. The lasts for up to 1 minute but is dismissed instantly if anyone hidden by the makes an attack. You may use this Talent to hide a single Vehicle while you are on board. The Vehicle can't have a size penalty to Reflex Defense, Initiative, or Pilot checks greater than your Heroic Level. Thus, a Gargantuan Starship (size penalty of -5) can be hidden only by a character of 5th level or higher. Whenever anyone concealed by your use of the Talent attacks, you maintain Total Concealment without having to make another Use the Force check. Only those who do not attack remain concealed; the attacker no longer has Total Concealment, even when using his Talent. Reference Book: Star Wars Saga Edition Galaxy at War When you hit a target with a Lightsaber attack, if the target has not been attacked since the end of your last turn, you deal +1 die of damage. Reference Book: Star Wars Saga Edition Rebellion Era Campaign Guide If you take damage from the use of a Force Power, until the end of the encounter you deal an extra 2 points of damage against the creature that used the Force Power against you. Reference Book: Star Wars Saga Edition Unknown Regions Jedi who spend time in a diverse wilderness learn the nuances of The Living Force at work within a wild ecosystem. When within a natural wilderness area, such as a jungle, a forest, a swamp, or plains, you tap into the vibrant Living Force of the area and can use the Sense Surroundings aspect of the Use the Force skill to detect targets out to a 30-square radius, regardless of line of sight. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Any time you attack a Flat-Footed opponent (or one who is denied its Dexterity bonus to its Reflex Defense against you) with a damage-dealing Force Power, or attack with a Lightsaber, you deal an extra +1d6 points of damage with that attack. This Talent does not affect Force Powers with the [Dark Side] descriptor. Whenever you use the Talent, allies hidden by the can reroll any Perception check, keeping the better of the two results. Additionally, allies hidden by the gain a +2 bonus on all damage rolls against foes that are unaware of them. Homebrew Reference Book: Legacy of the Force Sourcebook You can make a Use the Force check instead of a Survival check to Track. You are considered Trained in the Survival skill for the purposes of this Talent. If you are entitled to a Survival check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Homebrew Reference Book: Legacy of the Force Sourcebook You may substitute your Wisdom modifier for your Dexterity modifier when determining your Reflex Defense. Any condition that would cause you to be denied your Dexterity modifier to Reflex Defense causes you to be denied your Wisdom modifier as well. Homebrew Reference Book: Legacy of the Force Sourcebook You may reroll Perception checks made to Avoid Surprise or Search, keeping the better of the two results.","description":"You can spend a Force Point as a Standard Action to create a \"Haze\" that hides you and your allies from the perception of others. You can hide a number of creatures in line of sight equal to your Class Level. Make a Use the Force check and compare the result to the Will Defense of any opponent that moves into line of sight of any creature hidden by your . If your check result equals or exceeds the opponent's Will Defense, all hidden creatures are treated as if they had Total Concealment against the opponent. The lasts for up to 1 minute but is dismissed instantly if anyone hidden by the makes an attack. You may use this Talent to hide a single Vehicle while you are on board. The Vehicle can't have a size penalty to Reflex Defense, Initiative, or Pilot checks greater than your Heroic Level. Thus, a Gargantuan Starship (size penalty of -5) can be hidden only by a character of 5th level or higher. Whenever anyone concealed by your use of the Talent attacks, you maintain Total Concealment without having to make another Use the Force check. Only those who do not attack remain concealed; the attacker no longer has Total Concealment, even when using his Talent. Reference Book: Star Wars Saga Edition Galaxy at War When you hit a target with a Lightsaber attack, if the target has not been attacked since the end of your last turn, you deal +1 die of damage. Reference Book: Star Wars Saga Edition Rebellion Era Campaign Guide If you take damage from the use of a Force Power, until the end of the encounter you deal an extra 2 points of damage against the creature that used the Force Power against you. Reference Book: Star Wars Saga Edition Unknown Regions Jedi who spend time in a diverse wilderness learn the nuances of The Living Force at work within a wild ecosystem. When within a natural wilderness area, such as a jungle, a forest, a swamp, or plains, you tap into the vibrant Living Force of the area and can use the Sense Surroundings aspect of the Use the Force skill to detect targets out to a 30-square radius, regardless of line of sight. Reference Book: Star Wars Saga Edition Knights of the Old Republic Campaign Guide Any time you attack a Flat-Footed opponent (or one who is denied its Dexterity bonus to its Reflex Defense against you) with a damage-dealing Force Power, or attack with a Lightsaber, you deal an extra +1d6 points of damage with that attack. This Talent does not affect Force Powers with the [Dark Side] descriptor. Whenever you use the Talent, allies hidden by the can reroll any Perception check, keeping the better of the two results. Additionally, allies hidden by the gain a +2 bonus on all damage rolls against foes that are unaware of them. Homebrew Reference Book: Legacy of the Force Sourcebook You can make a Use the Force check instead of a Survival check to Track. You are considered Trained in the Survival skill for the purposes of this Talent. If you are entitled to a Survival check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Homebrew Reference Book: Legacy of the Force Sourcebook You may substitute your Wisdom modifier for your Dexterity modifier when determining your Reflex Defense. Any condition that would cause you to be denied your Dexterity modifier to Reflex Defense causes you to be denied your Wisdom modifier as well. Homebrew Reference Book: Legacy of the Force Sourcebook You may reroll Perception checks made to Avoid Surprise or Search, keeping the better of the two results.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Sentinel","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.clear_mind"}],"_source":"canonical-csv"},"treeId":"36f18f3e974feb33","tags":["action-economy","ambush","battlefield-control","condition-removal","controller","dark-side","defender","evasion","feat-chain","force","force-control","force-defense","force-offense","jedi","light-side","lightsaber","melee","mobility","perception","piloting","positioning","scout","skills","stealth","striker","support","sustained-damage","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_haze"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f098749cb8767a5f"}}},{"_id":"63a0f49bcb3bf4b9","name":"Shii-Cho","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Lightsaber Forms","prerequisites":"Block, Deflect","benefit":"Take only a -2 penalty on Use the Force checks for each Block or Deflect made last turn.","description":"Take only a –2 penalty on Use the Force checks for each Block or Deflect in the previous turn.","class":"Jedi Knight","costNumeric":null,"category":"Jedi Knight","tree":"Lightsaber Forms","treeId":"2bc2572e852832e4","tags":["feat-chain","force","jedi","lightsaber","melee","talent-chain"]},"effects":[{"_id":"e6768174-75e7-4b9d-ac19-c67693139c62","name":"Shii-Cho","icon":"icons/svg/sword.svg","changes":[{"key":"system.attacks.melee","mode":2,"value":"1"},{"key":"system.damage.melee","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Shii-Cho"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.shii_cho"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.c116f6249f4f47c9"}}},{"_id":"922e7b430aa01140","name":"Battle Strike","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You channel the Force to enhance your next melee attack. Your next melee attack this round gains a +1d6 bonus to damage.</p>","special":"<p>This bonus damage is Force damage and bypasses Damage Reduction.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":94,"tags":["enhancement","damage","melee"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.f177dc6d65f76de9"}}},{"_id":"e27d2e963eb61d0e","name":"Farseeing","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"1 minute","range":"Unlimited","target":"Special","duration":"Concentration","effect":"<p>You peer through the Force to see distant locations or events. You can observe a place you've been before or a person you know, regardless of distance.</p>","special":"<p>The GM may require additional checks for very distant or obscured visions.</p>","descriptor":["Mind-Affecting","Scrying"],"dcChart":[],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":95,"tags":["utility","divination","scrying"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.0419ecb55f011f81"}}},{"_id":"89b1f1d0e8f4c644","name":"Force Disarm","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Instantaneous","effect":"<p>You use telekinetic force to wrench a weapon or object from your target's grasp. Make a Use the Force check opposed by the target's Strength check or Will Defense (whichever is higher).</p>","special":"<p>On success, the target drops one held object of your choice.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["combat","disarm","telekinetic"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.18f33f87a1ebee74"}}},{"_id":"fff9722553681ffb","name":"Force Stun","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 round","effect":"<p>You use the Force to overwhelm your target's mind, stunning them. The target must make a Will save (DC = your UTF check) or be stunned for 1 round.</p>","special":"","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":97,"tags":["attack","stun","mind-affecting"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.a214d4f56b4abe11"}}},{"_id":"a37a5f0420d5ddf1","name":"Mind Trick","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telepathic","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 minute or until completed","effect":"<p>You influence a weak mind to believe what you tell them or follow a simple suggestion. The target must make a Will save (DC = your UTF check) or be affected.</p>","special":"<p>The suggestion must be reasonable and the target must be able to understand you.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["mind-control","suggestion","social"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.e6649f366d6c5737"}}},{"_id":"429f1dbc13308f91","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"08138aae56bd6907","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}},{"_id":"464cebc97f148941","name":"Surge","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"vital","useTheForce":15,"time":"Swift Action","range":"Personal","target":"You","duration":"1 round","effect":"<p>You use the Force to push your body beyond normal limits. You gain an additional move action this turn.</p>","special":"<p>This extra move action can be used to move or perform other move-action tasks.</p>","descriptor":["Vital"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["enhancement","action-economy","movement"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.1ac1084ca8f07114"}}},{"_id":"70eae2d55aeed665","name":"Lightsaber","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d8+6","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><str