-5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"04733e85-193e-4f4b-8792-c359083557d1","name":"Weapon Proficiency (Pistols)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Pistols)","effectType":"passive_effect","flagType":"Weapon Proficiency (Pistols)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.e5d361d01d1b44e4"}}},{"_id":"4dbf2419332f3528","name":"Weapon Proficiency (Rifles)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with rifles and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force","ranged","scout","soldier"],"bonus_feat_for":["Soldier","Scout"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"3b695d0d-747b-4081-8b6c-8b5f8584ff43","name":"Weapon Proficiency (Rifles)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Rifles)","effectType":"passive_effect","flagType":"Weapon Proficiency (Rifles)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.765ff8a34e58acac"}}},{"_id":"bd6a6c76cb50dd18","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"cdc94faeb73f55d5","name":"Burning Assault","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Rocket Jumper","prerequisites":"Jet Pack Training","benefit":"Expend a charge to make an attack as a flamethrower; cannot use while flying.","description":"","class":"Soldier","costNumeric":null,"category":"Soldier","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.jet_pack_training"}],"_source":"canonical-csv"},"treeId":"1f50c63b6f08de10","tree":"Rocket Jumper","tags":["feat-chain","heavy-weapons","mobility","ranged","soldier","talent-chain"]},"effects":[{"_id":"47df0bb1-0bd6-47eb-9040-0eed4f41eba3","name":"Burning Assault","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.attacks.flamethrower","mode":2,"value":"1"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Burning Assault"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.burning_assault"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.be617461ca46a5ad"}}},{"_id":"d96423d3c73fb657","name":"Jet Pack Training","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Rocket Jumper","prerequisites":"","benefit":"As a Standard Action you can expend one of your Jet Pack's charges to make an attack with the Jet Pack, treating it as a Flamethrower. You cannot use this Talent when you are flying. You are considered proficient in the Flamethrower for purposes of making this attack. Prerequisite: You always use the proper trajectories to maximize the efficiency of your rocket-pack burn rates. You increase your fly Speed by 2 squares when using a Jet Pack. Prerequisite: Once per encounter, as a Reaction when an opponent moves adjacent to you, you can expend one charge of your Jet Pack to fly and Move your Speed, or Withdraw. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Clones Once per round (as a Reaction), when you are airborne with a Jet Pack or Rocket Pack, you may negate a successful attack by making a Pilot check. The DC of the check is equal to the result of the attack roll you wish to negate. In addition, when flying a Jet Pack, you are considered proficient with its integrated weapons. This includes any piece of equipment integrated to the Jet Pack, though it does not apply to equipment integrated into armor to which the Jet Pack might be mounted. If you have taken the Starship Tactics feat, you may activate Starship Maneuvers as appropriate while flying a Jet Pack.","description":"As a Standard Action you can expend one of your Jet Pack's charges to make an attack with the Jet Pack, treating it as a Flamethrower. You cannot use this Talent when you are flying. You are considered proficient in the Flamethrower for purposes of making this attack. Prerequisite: You always use the proper trajectories to maximize the efficiency of your rocket-pack burn rates. You increase your fly Speed by 2 squares when using a Jet Pack. Prerequisite: Once per encounter, as a Reaction when an opponent moves adjacent to you, you can expend one charge of your Jet Pack to fly and Move your Speed, or Withdraw. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Clones Once per round (as a Reaction), when you are airborne with a Jet Pack or Rocket Pack, you may negate a successful attack by making a Pilot check. The DC of the check is equal to the result of the attack roll you wish to negate. In addition, when flying a Jet Pack, you are considered proficient with its integrated weapons. This includes any piece of equipment integrated to the Jet Pack, though it does not apply to equipment integrated into armor to which the Jet Pack might be mounted. If you have taken the Starship Tactics feat, you may activate Starship Maneuvers as appropriate while flying a Jet Pack.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Rocket Jumper","treeId":"1f50c63b6f08de10","tags":["action-economy","armor","controller","defender","heavy-weapons","mobility","positioning","ranged","soldier","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.jet_pack_training"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d3a642f2ceb21ed4"}}},{"_id":"bba547d79f18a842","name":"Combat Gloves","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d6+3","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unresolved":"Combat Gloves","npc":{"flatAttackBonus":5,"flatDamageFormula":"1d6+3","useFlat":true}}}},{"_id":"c663569bda7a324a","name":"Knife","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+2","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"unreso