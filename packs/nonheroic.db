lect a new opponent on your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Brawler","treeId":"67fdd8dce9abd6c1","tags":["melee","soldier","striker"]},"effects":[{"_id":"45edf98f-a153-47dc-ab62-44370f495321","name":"Expert Grappler","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.grapple.bonus","mode":2,"value":"2"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Expert Grappler","effectType":"grapple_bonus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.expert_grappler"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.916a526d8c166005"}}},{"_id":"b817334c038907de","name":"Melee Smash","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Melee Specialist","prerequisites":"","benefit":"Unrelenting Assault You twirl your Weapon around you in a blur, creating a circle of death around you. Any enemy target that begins its turn adjacent to you takes damage equal to your Strength bonus. You must be wielding a Melee Weapon to be using this Talent.","description":"Unrelenting Assault You twirl your Weapon around you in a blur, creating a circle of death around you. Any enemy target that begins its turn adjacent to you takes damage equal to your Strength bonus. You must be wielding a Melee Weapon to be using this Talent.","class":"Soldier","costNumeric":null,"category":"Soldier","tree":"Melee Specialist","treeId":"fad8118981c532f0","tags":["melee","positioning","soldier","striker","sustained-damage"]},"effects":[{"_id":"2d692811-5c22-48b8-944d-45db89ca5e77","name":"Melee Smash","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.damage.melee","mode":5,"value":"half_level"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Melee Smash"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.melee_smash"},"c