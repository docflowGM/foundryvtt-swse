ption":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"187f764e05ff01c8","name":"Acute Senses","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Master Scout","prerequisites":"","benefit":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","description":"Keen Shot You are skilled at fighting armored characters, taking advantage of their weaknesses. You can use each of the following Actions once per encounter: Binding Hit: You dislodge an enemy's Armor, causing it to hinder the wearer's defenses. Make a melee or ranged attack as a Standard Action. If you hit and damage your target, the target loses its Armor bonus to its Reflex Defense and is Flat-Footed. This effect remains until the target spends a Standard Action to adjust its Armor. Blinding Fire: Make a melee or ranged attack as a Standard Action. If the attack hits and damages the target, the target takes a -2 penalty to all attacks until the end of your next turn. Additionally, all other creatures, Droids, and Vehicles have Concealment from the target until the end of your next turn. Slowing Shot: Your hit damages your target's Armor so that the target's movement is hindered. Make a melee or ranged attack as a Standard Action. If you hit and damage the target, the target's Speed is reduced by two squares until the end of your next turn.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Master Scout","treeId":"dca33c0215264a02","tags":["action-economy","armor","controller","damage-reduction","defender","force","force-control","force-defense","force-offense","melee","mobility","positioning","ranged","scout","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.acute_senses"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.f0166d26d9f6252a"}}},{"_id":"d0e0e0bc551d531d","name":"Keen Shot","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Awareness","prerequisites":"Acute Senses","benefit":"Ignore penalties against opponents with concealment (except total concealment).","description":"Ignore concealment penalties except total concealment.","class":"Scout","costNumeric":null,"category":"Scout","tree":"Awareness","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.acute_senses"}],"_source":"canonical-csv"},"treeId":"1c48d1cd9ab1f5c8","tags":["feat-chain","ranged","scout","talent-chain"]},"effects":[{"_id":"ef19c1fd-23a5-4d9c-9a58-fbe2725f4f2c","name":"Keen Shot","icon":"icons/svg/item-bag.svg","c