:{"value":"Gain +5 competence bonus on <a href=\"/wiki/Skill_Checks\" title=\"Skill Checks\">Skill Checks</a> with one <a class=\"mw-redirect\" href=\"/wiki/Trained_Skill\" title=\"Trained Skill\">Trained Skill</a>."}},"effects":[{"name":"Skill Focus","icon":"icons/svg/upgrade.svg","changes":[{"key":"system.skills.perception.miscMod","mode":2,"value":"5","priority":20}],"disabled":false,"duration":{},"transfer":true,"flags":{"swse":{"type":"skill-bonus","skill":"43c5941072ec78af","source":"Skill Focus"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.1592aaedf4b6e40a"}}},{"_id":"f9708d662c33b355","name":"Weapon Proficiency","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"Ignore -5 penalty on attack rolls with weapons of a particular type.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["non-force"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{"value":"Ignore -5 penalty on attack rolls with weapons of a particular type."}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.ecc2471ac96ec2d4"}}},{"_id":"c2ec52a072a7a0e2","name":"Weapon Proficiency (Simple Weapons)","type":"feat","img":"icons/svg/upgrade.svg","system":{"featType":"general","benefit":"You are proficient with simple weapons and do not take the -5 penalty when using them.","prerequisite":"","special":"","normalText":"","sourcebook":"Saga Edition Core Rulebook","page":87,"tags":["noble","non-force","scoundrel","scout","soldier"],"bonus_feat_for":["Soldier","Scout","Scoundrel","Noble"],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":{}},"effects":[{"_id":"220daaa7-e1b5-440d-98cd-10f5e586ef8b","name":"Weapon Proficiency (Simple Weapons)","icon":"icons/svg/upgrade.svg","changes":[],"disabled":false,"duration":{},"flags":{"swse":{"source":"feat","featName":"Weapon Proficiency (Simple Weapons)","effectType":"passive_effect","flagType":"Weapon Proficiency (Simple Weapons)"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.feats.2d680cc46a7972da"}}},{"_id":"9a107e66f95806eb","name":"Improved Sense Force","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"You may use the Sense Force ability of the Use the Force Skill as a Move Action rather than a Full-Round Action.","prerequisite":"Sense Force","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>You may use the Sense Force ability of the Use the Force Skill as a Move Action rather than a Full-Round Action.</p><p><strong>Related Power:</strong> Sense Force</p><p><strong>Prerequisites:</strong> Sense Force</p>","relatedPower":"Sense Force"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.ad67b8f3959860f2"}}},{"_id":"c446e7cafea87e04","name":"Improved Telepathy","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-technique.png","system":{"featType":"force","benefit":"Whenever you use the Telepathy ability of the Use the Force Skill, you can reroll your Use the Force check, keeping the better of the two results.","prerequisite":"Telepathy","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-technique"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"description":"<p>Whenever you use the Telepathy ability of the Use the Force Skill, you can reroll your Use the Force check, keeping the better of the two results.</p><p><strong>Related Power:</strong> Telepathy</p><p><strong>Prerequisites:</strong> Telepathy</p>","relatedPower":"Telepathy"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcetechniques.53cfa2d1e4fe25ba"}}},{"_id":"dfaa6668f22f60f6","name":"Distant Power","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-secret.png","system":{"featType":"force","benefit":"When using a Force Power that has a range expressed numerically, you can spend a Force Point to multiply the range by 10.","prerequisite":"","special":"This Force Secret does not remove the line of sight requirements.","normalText":"","sourcebook":"Core","page":0,"tags":["force-secret"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":"<p><strong>Cost:</strong> Force Point or Destiny Point</p><p>When using a Force Power that has a range expressed numerically, you can spend a Force Point to multiply the range by 10.</p><p>Alternatively, you can spend a Destiny Point to increase the range to anywhere in the same Star System.</p><p><strong>Special:</strong> This Force Secret does not remove the line of sight requirements.</p>","cost":"Force Point or Destiny Point","alternativeCost":"Alternatively, you can spend a Destiny Point to increase the range to anywhere in the same Star System."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcesecrets.43f9645eabce838e"}}},{"_id":"d56ef580e5d23f6d","name":"Multitarget Power","type":"feat","img":"systems/foundryvtt-swse/assets/icons/force-secret.png","system":{"featType":"force","benefit":"When using a Force Power that affects a single target, you can spend a Force Point to affect one additional target.","prerequisite":"","special":"","normalText":"","sourcebook":"Core","page":0,"tags":["force-secret"],"bonus_feat_for":[],"uses":{"current":0,"max":0,"perDay":false},"costNumeric":null,"description":"<p><strong>Cost:</strong> Force Point or Destiny Point</p><p>When using a Force Power that affects a single target, you can spend a Force Point to affect one additional target.</p><p>Alternatively, you can spend a Destiny Point to affect one target per four Character Levels.</p>","cost":"Force Point or Destiny Point","alternativeCost":"Alternatively, you can spend a Destiny Point to affect one target per four Character Levels."},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcesecrets.af908ace9a361603"}}},{"_id":"1409947b6541877f","name":"Adept Negotiator","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Consular","prerequisites":"","benefit":"You can use your Use the Force modifier instead of your Persuasion check modifier when making a Persuasion check. You are considered Trained in the Persuasion skill. If you are entitled to a Persuasion check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisite: If you successfully use the Talent, your target moves an additional -1 step along the Condition Track. This is a Mind-Affecting effect. You affect the Condition Track of the specific character (usually the Vehicle's Commander), not a Starship. You can spend a Full-Round Action advising an ally, thereby granting them a +5 bonus on their next Skill Check. If you spend a Force Point, the bonus increases to +10. The target must be able to (and willing) to hear and understand your voice. You cannot advise yourself. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual As a Standard Action, you can peer into The Force and search for weaknesses in the defenses of your enemies. Make a Use the Force check against the Will Defense of a target creature within 12 squares of you and in your line of sight. If the Skill Check equals or exceeds the target's Will Defense, that target takes a -2 penalty to their Reflex Defense against you and all allies who can hear and understand you until the end of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever you damage an opponent with a Lightsaber attack, you can Take 10 on any Persuasion checks you make before the end of your next turn, even if you would not normally be able to. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: Once per encounter as a Swift Action, you can choose one ally within your line of sight that can hear and understand you. Until the end of the encounter, that ally adds your Wisdom bonus to its Will Defense against Mind-Affecting effects. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per turn as a Swift Action, you can spend a Force Point to let one adjacent ally use the Aid Another Action (as a Reaction) to assist you with a Skill Check. You must make the Skill Check before the end of your turn, or the benefit of the Aid Another Action is lost. An ally that has already used the Aid Another Action to assist you since the end of your last turn may not be targeted by this Talent. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You gain a +2 insight bonus to your Will Defense. Also, as a Swift Action, you can spend a Force Point to give all allies within 6 squares of you a +2 insight bonus to their Will Defense that lasts for the remainder of the encounter. This bonus does not extend to allies outside the range of the effect, even if they move within 6 squares of you later on. Allies who benefit from this Talent must remain within 6 squares of you to retain the insight bonus, and they lose it if you are knocked unconscious or killed. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Rebellion Era Campaign Guide When you deal damage to a target by making a Lightsaber attack on your turn, you can use a Swift Action before the end of your turn to activate this Talent. If you do so, allies adjacent to the target at the time you make the attack gain a +2 circumstance bonus to melee attack rolls against the target until the start of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","description":"You can use your Use the Force modifier instead of your Persuasion check modifier when making a Persuasion check. You are considered Trained in the Persuasion skill. If you are entitled to a Persuasion check reroll, you may reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisite: If you successfully use the Talent, your target moves an additional -1 step along the Condition Track. This is a Mind-Affecting effect. You affect the Condition Track of the specific character (usually the Vehicle's Commander), not a Starship. You can spend a Full-Round Action advising an ally, thereby granting them a +5 bonus on their next Skill Check. If you spend a Force Point, the bonus increases to +10. The target must be able to (and willing) to hear and understand your voice. You cannot advise yourself. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Jedi Academy Training Manual As a Standard Action, you can peer into The Force and search for weaknesses in the defenses of your enemies. Make a Use the Force check against the Will Defense of a target creature within 12 squares of you and in your line of sight. If the Skill Check equals or exceeds the target's Will Defense, that target takes a -2 penalty to their Reflex Defense against you and all allies who can hear and understand you until the end of your next turn. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Prerequisite: Whenever you damage an opponent with a Lightsaber attack, you can Take 10 on any Persuasion checks you make before the end of your next turn, even if you would not normally be able to. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide Prerequisite: Once per encounter as a Swift Action, you can choose one ally within your line of sight that can hear and understand you. Until the end of the encounter, that ally adds your Wisdom bonus to its Will Defense against Mind-Affecting effects. Reference Book: Star Wars Saga Edition Legacy Era Campaign Guide Once per turn as a Swift Action, you can spend a Force Point to let one adjacent ally use the Aid Another Action (as a Reaction) to assist you with a Skill Check. You must make the Skill Check before the end of your turn, or the benefit of the Aid Another Action is lost. An ally that has already used the Aid Another Action to assist you since the end of your last turn may not be targeted by this Talent. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide You gain a +2 insight bonus to your Will Defense. Also, as a Swift Action, you can spend a Force Point to give all allies within 6 squares of you a +2 insight bonus to their Will Defense that lasts for the remainder of the encounter. This bonus does not extend to allies outside the range of the effect, even if they move within 6 squares of you later on. Allies who benefit from this Talent must remain within 6 squares of you to retain the insight bonus, and they lose it if you are knocked unconscious or killed. This is a Mind-Affecting effect. Reference Book: Star Wars Saga Edition Rebellion Era Campaign Guide When you deal damage to a target by making a Lightsaber attack on your turn, you can use a Swift Action before the end of your turn to activate this Talent. If you do so, allies adjacent to the target at the time you make the attack gain a +2 circumstance bonus to melee attack rolls against the target until the start of your next turn. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Consular","treeId":"e99cfa9db8493573","tags":["action-economy","condition-removal","controller","defender","force","force-control","force-defense","force-offense","jedi","leader","light-side","lightsaber","melee","mobility","positioning","scout","skills","social","striker","support","sustained-damage"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.adept_negotiator"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.7acc479dee2d3b10"}}},{"_id":"2dd3e427e0c26691","name":"Force Focus","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Control","prerequisites":null,"benefit":"DC 15 Use the Force check to regain one Force power.","description":"Make a Use the Force check to regain one expended Force power.","costNumeric":null,"tree":"Control","treeId":"d3661aa9906bdc79","tags":["force"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_focus"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.af51d4e76675b183"}}},{"_id":"82b90e5f576c2029","name":"Force Perception","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sense","prerequisites":"","benefit":"You may spend a Force Point to reroll an Initiative check, keeping the better of the two rolls. Additionally, if you roll a natural 20 on the Initiative check reroll, you immediately regain the Force Point spent to activate this talent. Prerequisite: By focusing on a specific creature in your line of sight, you can gauge how strong in The Force they are. This takes a Standard Action and requires a Use the Force check. If your check result meets or beats the target's Will Defense, you know whether or not they have the Force Sensitivity feat, you know how many Force Powers they know (but not which ones specifically), and you know how many Force Points they currently have. Prerequisites: , Farseeing See also: On the Force, Visions, and Discretion Whenever you use the Farseeing Force Power, you can spend a Force Point as a Swift Action to see into the target's past or future instead of the present. You declare how far into the target's past or future you wish to look, up to a maximum of 1 year per your Character Level. Any information gained about a target's future is subject to change, depending on whether steps are taken to alter that future. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide As a Standard Action, you can spend a Force Point to ignore all Concealment for 1 minute. Prerequisites: , Farseeing As a Swift Action, you can peer into the future in search of signs of danger, removing one use of the Farseeing Force Power from your active Force Power Suite (as though you had just activated the Force Power). Any time before the end of your next turn when you are the target of an attack or Force Power, you can force your attacker to reroll the attack roll (or Use the Force check) against you, keeping the second result. This counts as using the Farseeing Force Power against the attacker, but this Talent replaces the normal rules and effect of that Force Power. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisites: , Farseeing When you use the Farseeing Force Power, you can choose to target an object you hold instead of a character or creature. You can look into the targeted item's past, up to a maximum of 5 years per your Character Level. Any information gained about the object's past is based on the thoughts and emotions of the person holding or carrying the object at the time you perceive, which can skew the results of the vision. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to gain Low-Light Vision (see Visibility) for 1 minute or until the end of the encounter, whichever is longer. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Jedi Padawans Prerequisites: Once per encounter, you may spend a Force Point to gain a +1 insight bonus to your Reflex Defense and Will Defense for the remainder of the encounter, or until you are knocked unconscious.","description":"You may spend a Force Point to reroll an Initiative check, keeping the better of the two rolls. Additionally, if you roll a natural 20 on the Initiative check reroll, you immediately regain the Force Point spent to activate this talent. Prerequisite: By focusing on a specific creature in your line of sight, you can gauge how strong in The Force they are. This takes a Standard Action and requires a Use the Force check. If your check result meets or beats the target's Will Defense, you know whether or not they have the Force Sensitivity feat, you know how many Force Powers they know (but not which ones specifically), and you know how many Force Points they currently have. Prerequisites: , Farseeing See also: On the Force, Visions, and Discretion Whenever you use the Farseeing Force Power, you can spend a Force Point as a Swift Action to see into the target's past or future instead of the present. You declare how far into the target's past or future you wish to look, up to a maximum of 1 year per your Character Level. Any information gained about a target's future is subject to change, depending on whether steps are taken to alter that future. Reference Book: Star Wars Saga Edition Force Unleashed Campaign Guide As a Standard Action, you can spend a Force Point to ignore all Concealment for 1 minute. Prerequisites: , Farseeing As a Swift Action, you can peer into the future in search of signs of danger, removing one use of the Farseeing Force Power from your active Force Power Suite (as though you had just activated the Force Power). Any time before the end of your next turn when you are the target of an attack or Force Power, you can force your attacker to reroll the attack roll (or Use the Force check) against you, keeping the second result. This counts as using the Farseeing Force Power against the attacker, but this Talent replaces the normal rules and effect of that Force Power. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide Prerequisites: , Farseeing When you use the Farseeing Force Power, you can choose to target an object you hold instead of a character or creature. You can look into the targeted item's past, up to a maximum of 5 years per your Character Level. Any information gained about the object's past is based on the thoughts and emotions of the person holding or carrying the object at the time you perceive, which can skew the results of the vision. Reference Book: Star Wars Saga Edition Clone Wars Campaign Guide You can spend a Force Point to gain Low-Light Vision (see Visibility) for 1 minute or until the end of the encounter, whichever is longer. Homebrew Reference Book: Clone Wars Saga Edition Fan Sourcebook - Jedi Padawans Prerequisites: Once per encounter, you may spend a Force Point to gain a +1 insight bonus to your Reflex Defense and Will Defense for the remainder of the encounter, or until you are knocked unconscious.","costNumeric":null,"tree":"Sense","treeId":"d6b4331c0e31f7e3","tags":["action-economy","defender","force","force-defense","force-offense","light-side","mobility","scout","skills","stealth","striker","support"]},"effects":[{"name":"Force Perception (Trained)","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.skills.perception.trained","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Force Perception","effectType":"skill-trained"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_perception"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.a358402a9fc26c02"}}},{"_id":"f12a8979273c3c23","name":"Force Persuasion","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Consular","prerequisites":"Adept Negotiator","benefit":"Use the Force instead of Persuasion for checks; considered trained in Persuasion.","description":"You may use Use the Force instead of Persuasion and are considered trained in Persuasion.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Consular","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.adept_negotiator"}],"_source":"canonical-csv"},"treeId":"e99cfa9db8493573","tags":["feat-chain","force","jedi","light-side","skills","social","talent-chain"]},"effects":[{"_id":"f8c30152-0d87-4368-a330-0f73d55cd21d","name":"Force Persuasion","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.skills.persuasion.substitute","mode":5,"value":"useTheForce"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Force Persuasion"}}},{"name":"Force Persuasion (Trained)","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.skills.persuasion.trained","mode":5,"value":"true"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Force Persuasion","effectType":"skill-trained"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.force_persuasion"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d1fd547124c1901c"}}},{"_id":"73c7ae39def14525","name":"Foresight","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sense","prerequisites":"Force Perception","benefit":"Reroll Initiative; on a natural 20, regain a Force Point.","description":"You may reroll Initiative checks; on a natural 20, regain a Force Point.","costNumeric":null,"tree":"Sense","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.force_perception"}],"_source":"canonical-csv"},"treeId":"d6b4331c0e31f7e3","tags":["feat-chain","force","scout","skills","talent-chain"]},"effects":[{"_id":"b419da31-d0ef-4d1d-8c11-7aaf9f1bab1c","name":"Foresight","icon":"icons/svg/item-bag.svg","changes":[{"key":"system.initiative","mode":5,"value":"reroll"}],"disabled":false,"duration":{},"flags":{"swse":{"source":"talent","talentName":"Foresight"}}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.foresight"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.d10cdcba4faae7bb"}}},{"_id":"cbc121620aa2f834","name":"Gauge Force Potential","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Sense","prerequisites":"Force Perception","benefit":"Use the Force vs Will to detect Force sensitivity, number of powers known, and Force Points.","description":"Use the Force to detect Force sensitivity, powers known, and Force Points.","costNumeric":null,"tree":"Sense","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.force_perception"}],"_source":"canonical-csv"},"treeId":"d6b4331c0e31f7e3","tags":["feat-chain","force","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.gauge_force_potential"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.fdc4061afb97e87f"}}},{"_id":"b62fe57d0ce43c08","name":"Master Negotiator","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Consular","prerequisites":"Adept Negotiator","benefit":"As Adept Negotiator, but target moves two steps down the condition track.","description":"Functions like Adept Negotiator, except the target moves two steps down the condition track.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Consular","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.adept_negotiator"}],"_source":"canonical-csv"},"treeId":"e99cfa9db8493573","tags":["condition-removal","controller","feat-chain","force","force-control","jedi","light-side","mobility","talent-chain"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.master_negotiator"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.9dc39670f94a6ef2"}}},{"_id":"d3aabc0091b72f07","name":"Skilled Advisor","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Jedi Archivist","prerequisites":"","benefit":"You can Aid Another on the Knowledge checks of an ally within 6 squares of you as a Reaction for Knowledge skills you are Trained in. You can make a Use the Force check in place of a Knowledge check for any Knowledge skill you are not Trained in. You are considered Trained in that Knowledge skill for the purposes of using this Talent. If you are entitled to a Knowledge check reroll, you can reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisite: When you use the Talent, the ally you aid gains one temporary Force Point at the end of their next turn. If the Force Point is not spent before the end of the encounter, it is lost. As a Swift Action, you can reroll a Knowledge check and keep the better of the two results. This can be used with any Knowledge skill you are Trained in.","description":"You can Aid Another on the Knowledge checks of an ally within 6 squares of you as a Reaction for Knowledge skills you are Trained in. You can make a Use the Force check in place of a Knowledge check for any Knowledge skill you are not Trained in. You are considered Trained in that Knowledge skill for the purposes of using this Talent. If you are entitled to a Knowledge check reroll, you can reroll your Use the Force check instead (subject to the same circumstances and limitations). Prerequisite: When you use the Talent, the ally you aid gains one temporary Force Point at the end of their next turn. If the Force Point is not spent before the end of the encounter, it is lost. As a Swift Action, you can reroll a Knowledge check and keep the better of the two results. This can be used with any Knowledge skill you are Trained in.","class":"Jedi","costNumeric":null,"category":"Jedi","tree":"Jedi Archivist","treeId":"152047d6ab7896ad","tags":["action-economy","force","jedi","light-side","mobility","positioning","striker","support"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.skilled_advisor"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.35cbdbe9c91ba1d0"}}},{"_id":"d3748049164d1c08","name":"Visions","type":"talent","img":"icons/svg/item-bag.svg","system":{"talent_tree":"Keetael","prerequisites":"","benefit":"Prerequisites: The long-lived Draethos are particularly adept at searching and understanding the past. When using Farseeing to look into the past, reduce your DC numbers by half. Also, you are able to see everything within 6 squares of your target clearly without spending a Force Point.","description":"Prerequisites: The long-lived Draethos are particularly adept at searching and understanding the past. When using Farseeing to look into the past, reduce your DC numbers by half. Also, you are able to see everything within 6 squares of your target clearly without spending a Force Point.","costNumeric":null,"tree":"Keetael","prerequisitesStructured":{"type":"all","conditions":[{"type":"talent","id":"swse.talent.force_perception"}],"_source":"canonical-csv"},"treeId":"dad3c0da191748c1","tags":["damage-reduction","force","positioning"]},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"swse":{"id":"swse.talent.visions"},"core":{"sourceId":"Compendium.foundryvtt-swse.talents.da12fc505efc5eea"}}},{"_id":"fab6afe24628cba4","name":"Farseeing","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"1 minute","range":"Unlimited","target":"Special","duration":"Concentration","effect":"<p>You peer through the Force to see distant locations or events. You can observe a place you've been before or a person you know, regardless of distance.</p>","special":"<p>The GM may require additional checks for very distant or obscured visions.</p>","descriptor":["Mind-Affecting","Scrying"],"dcChart":[],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":95,"tags":["utility","divination","scrying"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.0419ecb55f011f81"}}},{"_id":"026199f879c85b17","name":"Force Disarm","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"Instantaneous","effect":"<p>You use telekinetic force to wrench a weapon or object from your target's grasp. Make a Use the Force check opposed by the target's Strength check or Will Defense (whichever is higher).</p>","special":"<p>On success, the target drops one held object of your choice.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":96,"tags":["combat","disarm","telekinetic"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.18f33f87a1ebee74"}}},{"_id":"584c22367bf0e211","name":"Force Stun","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 round","effect":"<p>You use the Force to overwhelm your target's mind, stunning them. The target must make a Will save (DC = your UTF check) or be stunned for 1 round.</p>","special":"","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":97,"tags":["attack","stun","mind-affecting"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.a214d4f56b4abe11"}}},{"_id":"a7ad85ff11cb5f6b","name":"Mind Trick","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":1,"discipline":"telepathic","useTheForce":15,"time":"Standard Action","range":"6 squares","target":"One creature","duration":"1 minute or until completed","effect":"<p>You influence a weak mind to believe what you tell them or follow a simple suggestion. The target must make a Will save (DC = your UTF check) or be affected.</p>","special":"<p>The suggestion must be reasonable and the target must be able to understand you.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["mind-control","suggestion","social"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.e6649f366d6c5737"}}},{"_id":"f3402ba169f42c5d","name":"Move Object","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":15,"time":"Standard Action","range":"12 squares","target":"One object or creature","duration":"Concentration","effect":"<p>You move objects or creatures through the air using telekinesis. The maximum size/weight you can move depends on your Use the Force check result.</p>","special":"<p>Unwilling creatures can make a Will save (DC = your UTF check) to resist being moved.</p>","descriptor":["Telekinetic"],"dcChart":[{"dc":15,"effect":"Medium (50 kg)","description":"Move objects up to Medium size or 50 kg"},{"dc":20,"effect":"Large (250 kg)","description":"Move objects up to Large size or 250 kg"},{"dc":25,"effect":"Huge (1 ton)","description":"Move objects up to Huge size or 1 metric ton"},{"dc":30,"effect":"Gargantuan (5 tons)","description":"Move objects up to Gargantuan size or 5 metric tons"},{"dc":35,"effect":"Colossal (20 tons)","description":"Move objects up to Colossal size or 20 metric tons (starfighter-sized)"}],"maintainable":true,"sourcebook":"Saga Edition Core Rulebook","page":98,"tags":["telekinetic","movement","utility"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.289013a32bd179ad"}}},{"_id":"aa26ceea6dce3345","name":"Negate Energy","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telekinetic","useTheForce":20,"time":"Reaction","range":"Personal or touch","target":"You or one creature","duration":"Instantaneous","effect":"<p>You use the Force to absorb or deflect energy damage. The target gains energy resistance 20 against one energy attack.</p>","special":"<p>This power can be used as a Reaction when you or an ally is targeted by an energy attack.</p>","descriptor":["Telekinetic"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["defense","energy-resistance","protection"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.be1ae263c498af3b"}}},{"_id":"3b1d43b7d0ea4797","name":"Rebuke","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":2,"discipline":"telepathic","useTheForce":20,"time":"Standard Action","range":"6 squares","target":"One Force-sensitive creature","duration":"1 round","effect":"<p>You overwhelm a Force user with a powerful Force presence. If the target is Force-sensitive, they must make a Will save (DC = your UTF check) or be dazed for 1 round.</p>","special":"<p>This power only affects Force-sensitive creatures.</p>","descriptor":["Mind-Affecting"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","force-user","daze"],"inSuite":true,"uses":{"current":2,"max":2},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.390074b44aedfa2a"}}},{"_id":"70973357b5fd999d","name":"Sever Force","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":6,"discipline":"dark-side","useTheForce":30,"time":"1 minute","range":"Touch","target":"One Force-sensitive creature","duration":"Permanent","effect":"<p>You permanently sever a Force user's connection to the Force. The target loses all Force abilities permanently.</p>","special":"<p>This is an extremely powerful and cruel Dark Side power. Using it gains you 3 Dark Side Points. The target can make a Will save (DC = your UTF check) to resist. Master-level power.</p>","descriptor":["Dark Side","Force Drain"],"dcChart":[],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["debuff","dark-side","permanent","master"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.b52769dd11b4e52c"}}},{"_id":"4205677cb6edd278","name":"Vital Transfer","type":"force-power","img":"icons/svg/item-bag.svg","system":{"powerLevel":3,"discipline":"vital","useTheForce":15,"time":"Standard Action","range":"Touch","target":"One living creature","duration":"Instantaneous","effect":"<p>You channel the Force to heal injuries and restore vitality. The target recovers hit points based on your Use the Force check result.</p>","special":"<p>You cannot heal yourself with this power.</p>","descriptor":["Vital","Healing"],"dcChart":[{"dc":15,"effect":"2d6 healing","description":"Target heals 2d6 hit points"},{"dc":20,"effect":"4d6 healing","description":"Target heals 4d6 hit points"},{"dc":25,"effect":"6d6 healing + condition","description":"Target heals 6d6 hit points and removes one ongoing condition"},{"dc":30,"effect":"8d6 healing + all conditions","description":"Target heals 8d6 hit points and removes all ongoing conditions"}],"maintainable":false,"sourcebook":"Saga Edition Core Rulebook","page":99,"tags":["healing","vital","support"],"inSuite":true,"uses":{"current":1,"max":1},"costNumeric":null},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.forcepowers.00b65e47a4dd7d76"}}},{"_id":"ec96fe00dbab1321","name":"Unarmed","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"1d4+7","damageType":"kinetic","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":0,"equipped":true,"description":"","properties":[],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"simple","proficiency":"simple","subcategory":""},"effects":[],"flags":{"swse":{"placeholder":true,"npc":{"flatAttackBonus":15,"flatDamageFormula":"1d4+7","useFlat":true}}}},{"_id":"6e0704867094542e","name":"Lightsaber","type":"weapon","img":"icons/svg/sword.svg","system":{"damage":"2d8+7","damageType":"energy","attackBonus":0,"attackAttribute":"str","range":"melee","weight":1,"cost":12000,"equipped":true,"description":"<p>The elegant weapon of the Jedi and Sith. A blade of pure energy capable of cutting through nearly anything.</p>\n      <p><strong>Special:</strong> Ignores armor bonuses to Reflex Defense. Can deflect blaster bolts. Critical threat range 19-20. Requires exotic weapon proficiency.</p>","properties":["Lightsaber","Critical 19-20","Exotic","Armor-Piercing"],"ammunition":{"type":"none","current":0,"max":0},"weaponCategory":"melee","proficiency":"exotic","subcategory":"lightsaber","costNumeric":12000,"category":"lightsaber"},"effects":[],"folder":null,"sort":0,"ownership":{"default":0},"flags":{"core":{"sourceId":"Compendium.foundryvtt-swse.weapons.weapon-lightsaber"},"swse":{"npc":{"flatAttackBonus":16,"flatDamageFormula":"2d8+7","useFlat":true}}}}],"effects":[],"flags":{"swse":{"import":{"source":"books","raw":{"Size":"Medium","Species":"Human","Nonheroic Level":0,"Class Levels":{"Medium Jedi":7,"Jedi Knight":5,"Jedi Master":3},"Force Points":6,"Dark Side Points":0,"Languages":["Basic"],"Unassigned Languages":7,"Reflex Defense":29,"Flat-Footed Defense":28,"Fortitude Defense":27,"Will Defense":31,"Hit Points":"92","Damage Threshold":27,"Speed":"6 Squares","Melee Weapons":"Unarmed +15 (1d4+7), Lightsaber +16 (2d8+7)","Ranged Weapons":"By Weapon +16","Attack Options":["Unarmed","Lightsaber","By Weapon"],"Force Powers":["Farseeing","Force Disarm","Force Stun","Force Stun","Mind Trick","Mind Trick","Move Object","Negate Energy","Rebuke","Rebuke","Sever Force","Vital Transfer"],"Force Secrets":["Improved Sense Force","Improved Telepathy"],"Force Techniques":["Distant Power","Multitarget Power"],"Strength":"10","Dexterity":"12","Constitution":"8","Intelligence":"17","Wisdom":"16","Charisma":"15","Talents":["Adept Negotiator","Force Focus","Force Perception","Force Persuasion","Foresight","Gauge Force Potential","Master Negotiator","Skilled Advisor","Visions"],"Feats":["Force Sensitivity","Force Training","(3)","Improved Disarm","Linguist","Melee Defense","Skill Focus (Knowledge (Galactic Lore))","Skill Focus (Knowledge (Physical Sciences))","Skill Focus (Use the Force)","Weapon Proficiency (Lightsabers)","Weapon Proficiency (Simple Weapons)"],"Trained Skills":["Endurance","Use the Force"],"Gear":"Lightsaber ( Self-Built ), Jedi Robes","Melee Attack":"Defense, Defense","Ranged Attack":"","Species Bonuses":["Attack Bonus"]},"mode":"play","sourcePack":"nonheroic","sourceAuthority":"statblock","playReady":true,"normalizedForPlay":true,"playNormalizationVersion":1,"statblockAuthority":true,"normalizationVersion":2,"nonheroicLegalSkeletonVersion":1,"nonheroicLegalSkeletonStatus":"heroic-profile"}}}}
