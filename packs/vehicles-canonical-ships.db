r beam","station":"pilot","attackBonus":1,"damageAsPrinted":"grapple +36","printedMultiplicity":1,"sourcePrintedPage":192,"firingArc":"SOURCE_SILENT_CONFIRMED","physicalMountCount":"NOT_CERTIFIED","batteryComposition":"SOURCE_SILENT_CONFIRMED"}],"sourceConflicts":[],"missingFields":["initiative","reflexDefense","flatFooted","fortitudeDefense","hp","damageThreshold"],"physicalMountCertified":false,"foundryStockAttackTrusted":false}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0}}
{"_id":"swse000000000307","name":"Penumbra-class Attack Shuttle","type":"vehicle","img":"icons/svg/mystery-man.svg","system":{"model":"Penumbra-class Attack Shuttle","sourcebook":"Galaxy at War","page":65,"category":"Space Transport","type":"Space Transport","size":"Colossal space","vehicleBucket":"space-transports","vehicleFamily":"starship","weapons":[],"vehicleHasWeapons":false,"vehicleWeaponDataStatus":"PUBLISHED_GROUPS_NOT_INSTALLED","vehicleCanonicalSourceState":"SOURCE_REVIEWED_PHYSICAL_MOUNTS_UNVERIFIED","challengeLevel":9,"initiative":1,"reflexDefense":17,"flatFooted":12,"fortitudeDefense":25,"damageThreshold":75,"damageReduction":15,"hp":{"value":110,"max":110,"temp":0},"hull":{"value":110,"max":110,"temp":0},"shields":{"value":20,"max":20},"shieldRating":20,"currentSR":20,"vehicleHasShields":true,"characterScaleSpeed":16,"starshipScaleSpeed":4,"maxVelocityKmh":1175,"vehicleMovementRaw":"Speed fly 16 squares (max. velocity 1,175 km/h), fly 4 squares (starship scale)","speed":"Fly 16 squares","starshipSpeed":"Fly 4 squares","crew":"Crew 3; Passengers 10","vehicleCanonicalMissingFields":[]},"flags":{"swse":{"canonicalPublication":{"sourceEntryKey":"gaw-penumbra-class-attack-shuttle","sourceBook":"Galaxy at War","printedPage":65,"sourcePdfSha256":"9829bea74df5dddad946b1f5514caf1838328333979eb573f9b565334258aa4a","originalPrintedFacts":{"challengeLevel":9,"printedTypeLine":"Colossal space transport","sourceTxtNavigationOnly":true,"initiativeAndSenses":"Init +1; Senses Perception +6","defensesAsPrinted":"Defense Ref 17 (flat-footed 12), Fort 25; +12 armor","hitPointsAndShieldsAsPrinted":"hp 110; DR 15; SR 20; Threshold 75","speedAsPrinted":"Speed fly 16 squares (max. velocity 1,175 km/h), fly 4 squares (starship scale)","rangedAttackFirstLine":"Ranged medium laser cannons +6 (see below) and","baseAttackAndGrapple":"Base Atk +2; Grp +37","attackOptions":"Atk Options autofire (medium laser cannons), fire-link (medium laser","crewAndPassengers":"Crew 3; Passengers 10","cargoConsumablesAndCarriedCraft":"Cargo 20 tons; Consumables 1 month; Carried Craft none","payloadAsPrinted":"Payload 12 concussion missiles","economicsAsPrinted":"Availability Restricted; Cost 250,000 (135,000 used)","navigationTextExcerpt":"Penumbra-class Attack Shuttle cL9 \n\nColossal space transport \n\nInit +1; Senses Perception +6 \n\nDefense Ref 17 (flat-footed 12), Fort 25; +12 armor \n\nhp 110; DR 15; SR 20; Threshold 75 \n\nSpeed fly 16 squares (max. velocity 1,175 km/h), fly 4 squares \n(starship scale) \n\nRanged medium laser cannons +6 (see below) and \nmedium concussion missiles +4 (see below) \n\nFighting Space 12x12 or 1 squares (starship scale); Cover total (crew) \n\nBase Atk +2; Grp +37 \n\nAtk Options autofire (medium laser cannons), fire-link (medium laser \ncannons, medium concussion missiles) \n\nAbilities Str 40, Dex 20, Con —, Int 14 \n\nSkills Initiative +1, Mechanics +6, Perception +6, Pilot +1, \nUse Computer +6 . \n\nCrew 3; Passengers 10 \n\nCargo 20 tons; Consumables 1 month; Carried Craft none \n\nPayload 12 concussion missiles \n\nAvailability Restricted; Cost 250,000 (135,000 used) \n\n\nMedium laser cannons (pilot) \nAtk +6 (+1 autofire), Dmg 5d10x2 \nMedium concussion missiles (copilot) \nAtk +4, Dmg 10d10x2 \n\n\nLight Freighter \n\nAnother popular design from the Corellian Engineering Corporation, the \nYU-410 light freighter's name is a bit of a misnomer. Considerably larger than \ntypical light freighters, the YU-410 holds an impressive 250 tons of cargo \nin its spacious twin cargo bays. As a cost-cutting measure, the corporation \nincludes smaller-than-normal engines, giving the YU-410 a low maximum \nvelocity and poor maneuverability. To compensate for the lack of speed, the \nYU-410 has stronger shields and twin double laser cannons to defend itself \nagainst attack—often more than enough to dissuade pirates from assau"},"approvedEffectiveFacts":null,"attackRows":[{"weaponLabel":"medium laser cannons","station":"pilot","attackBonus":6,"damageAsPrinted":"5d10x2","printedMultiplicity":1,"sourcePrintedPage":65,"firingArc":"SOURCE_SILENT_CONFIRMED","physicalMountCount":"NOT_CERTIFIED","batteryComposition":"SOURCE_SILENT_CONFIRMED"},{"weaponLabel":"medium concussion missiles","station":"copilot","attackBonus":4,"damageAsPrinted":"10d10x2","printedMultiplicity":1,"sourcePrintedPage":65,"firingArc":"SOURCE_SILENT_CONFIRMED","physicalMountCount":"NOT_CERTIFIED","batteryComposition":"SOURCE_SILENT_CONFIRMED"}],"sourceConflicts":[],"missingFields":[],"physicalMountCertified":false,"foundryStockAttackTrusted":false}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0}}
{"_id":"swse000000000308","name":"YU-410 Light Freighter","type":"vehicle","img":"icons/svg/mystery-man.svg","system":{"model":"YU-410 Light Freighter","sourcebook":"Galaxy at War","page":65,"category":"Space Transport","type":"Space Transport","size":"Colossal space","vehicleBucket":"space-transports","vehicleFamily":"starship","weapons":[],"vehicleHasWeapons":false,"vehicleWeaponDataStatus":"PUBLISHED_GROUPS_NOT_INSTALLED","vehicleCanonicalSourceState":"SOURCE_REVIEWED_PHYSICAL_MOUNTS_UNVERIFIED","challengeLevel":7,"initiative":-5,"reflexDefense":12,"flatFooted":12,"fortitudeDefense":26,"damageThreshold":76,"damageReduction":15,"hp":{"value":120,"max":120,"temp":0},"hull":{"value":120,"max":120,"temp":0},"characterScaleSpeed":12,"starshipScaleSpeed":2,"maxVelocityKmh":800,"vehicleMovementRaw":"Speed fly 12 squares (max. velocity 800 km/h), fly 2 squares (starship scale)","speed":"Fly 12 squares","starshipSpeed":"Fly 2 squares","crew":"Crew 4 (normal); Passengers 12","vehicleHyperdriveLabel":"Hyperdrive x2 (backup x12), navicomputer","vehicleCanonicalMissingFields":[]},"flags":{"swse":{"canonicalPublication":{"sourceEntryKey":"gaw-yu-410-light-freighter","sourceBook":"Galaxy at War","printedPage":65,"sourcePdfSha256":"9829bea74df5dddad946b1f5514caf1838328333979eb573f9b565334258aa4a","originalPrintedFacts":{"challengeLevel":7,"printedTypeLine":"Colossal space transport","sourceTxtNavigationOnly":true,"initiativeAndSenses":"Init -5; Senses Perception +5","defensesAsPrinted":"Defense Ref 12 (flat-footed 12), Fort 26; +12 armor","hitPointsAndShieldsAsPrinted":"hp 120; DR 15; DR 20; Threshold 76","speedAsPrinted":"Speed fly 12 squares (max. velocity 800 km/h), fly 2 squares (starship scale)","rangedAttackFirstLine":"Ranged double laser cannons +2 (see below)","baseAttackAndGrapple":"Base Atk +0; Grp +36","attackOptions":"Atk Options autofire (double laser cannons)","crewAndPassengers":"Crew 4 (normal); Passengers 12","cargoConsumablesAndCarriedCraft":"Cargo 250 tons; Consumables 2 months; Carried Craft none","hyperdriveAsPrinted":"Hyperdrive x2 (backup x12), navicomputer","economicsAsPrinted":"Availability Licensed; Cost 110,000 (30,000 used)","navigationTextExcerpt":"YU-410 Light Freighter cL7 \n\nColossal space transport \n\nInit —5; Senses Perception +5 \n\nDefense Ref 12 (flat-footed 12), Fort 26; +12 armor \n\nhp 120; DR 15; DR 20; Threshold 76 \n\nSpeed fly 12 squares (max. velocity 800 km/h), fly 2 squares \n(starship scale) \n\nRanged double laser cannons +2 (see below) \n\nFighting Space 12x12 or 1 square (starship scale); Cover total \n\nBase Atk +0; Grp +36 \n\nAtk Options autofire (double laser cannons) \n\nAl s Str 42, Dex 10, Con—, Int 14 \n\nSkills Initiative -2, Mechanics +5, Perception +5, Pilot —5, \nUse Computer +5 \n\nCrew 4 (normal); Passengers 12 \n\nCargo 250 tons; Consumables 2 months; Carried Craft none \n\nHyperdrive x2 (backup x12), navicomputer \n\nAvailability Licensed; Cost 110,000 (30,000 used) \n\n\nDouble laser cannons (gunner) \nAtk +2 (-3 autofire), Dmg 5d10x2 \n\n\nfy) \nr \n> \nq \n4 \nLJ \nBy \n\n\n1 BeidvRS \n\n\nSeVAeEEVH) \n\n\nWayfarer-class Medium Transport \n\nThe unusual design of the Wayforer-class medium transport allows cargo \npods to be attached and detached from the port side of the vessel as needed. \nThis modular design enables a Wayfarer to load a passenger section, hangar \nbay, or cargo module, depending on what is needed at the time. A Wayfarer \nfeatures powerful engines that can handle the large mass of bulk freight \nand that give the vessel surprisingly good speed. However, its unusual \nlayout makes the Wayfarer ungainly and difficult to pilot in anything less \nthan ideal conditions. \n\nThe 82-meter Wayfarer-class medium transport requires a crew of ten for \noptimal operation, but it can be flown effectively with only a pilot and one \noth"},"approvedEffectiveFacts":null,"attackRows":[{"weaponLabel":"double laser cannons","station":"gunner","attackBonus":2,"damageAsPrinted":"5d10x2","printedMultiplicity":1,"sourcePrintedPage":65,"firingArc":"SOURCE_SILENT_CONFIRMED","physicalMountCount":"NOT_CERTIFIED","batteryComposition":"SOURCE_SILENT_CONFIRMED"}],"sourceConflicts":[{"category":"PRINTED_DURABILITY_LABEL_CONFLICT","page":65,"mainRanged":"hp 120; DR 15; DR 20; Threshold 76","detailedWeapon":"Shield description appears in narrative; statblock labels both values DR","resolution":"UNRESOLVED_KEEP_PRINTED_TERMS"}],"missingFields":[],"physicalMountCertified":false,"foundryStockAttackTrusted":false}}},"effects":[],"folder":null,"sort":0,"ownership":{"default":0}}
