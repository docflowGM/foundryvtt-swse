{"_id":"67a08d46f24c4fdd","name":"Crash Landings","type":"talent","img":"icons/svg/item-bag.svg","system":{"prerequisites":"","description":"- If you’re Crash Landing and your jet pack has at least 1 charge left, then as a reaction, you burn 1 charge and cause Falling Damage’s attack roll against you to automatically fail, halving the damage you receive.","benefit":"- If you’re Crash Landing and your jet pack has at least 1 charge left, then as a reaction, you burn 1 charge and cause Falling Damage’s attack roll against you to automatically fail, halving the damage you receive.","class":"","category":"","costNumeric":null,"treeId":"25d99948c9cb41ad","tags":["action_economy","mobility","pilot","reaction","striker","support","survivability","tree_25d99948c9cb41ad","uncategorized_talent","vehicle"],"executionModel":"PASSIVE","subType":"STATE","abilityMeta":{"modifiers":[],"mechanicsMode":"combat_action","applicationScope":"jetpack_runtime_context","staticSheetPolicy":"exclude","requiresRuntimeContext":true,"requiresSelectedChoice":false,"phase24TacticalRangedMilitaryCleanup":{"phase":"T24","tree":"Jumptrooper","status":"cleaned_runtime_context","removedLegacyModifierRows":1,"removedEmbeddedActiveEffects":0,"notes":"Unsafe passive/ActiveEffect data removed. Talent is represented by action cards, attack options, hit/critical riders, or explicit manual metadata as appropriate."},"combatActions":[{"id":"crash-landings","name":"Crash Landings","label":"Crash Landings","actionType":"reaction","cost":1,"manualResolution":true,"resolutionMode":"manual","useLabel":"Use / Note","description":"When crash landing with at least 1 jet-pack charge, burn 1 charge to make the falling-damage attack against you automatically fail, halving the damage.","notes":"When crash landing with at least 1 jet-pack charge, burn 1 charge to make the falling-damage attack against you automatically fail, halving the damage.","relatedSkills":[],"resources":["Reaction","Burn 1 jet-pack charge"],"required