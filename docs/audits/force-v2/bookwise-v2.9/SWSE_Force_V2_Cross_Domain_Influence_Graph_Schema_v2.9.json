{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swse.local/schema/force-v2-influences-v2.9.json",
  "title": "SWSE Force V2 Cross-domain Influence Graph Contract v2.9.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "purpose",
    "applicationOrder",
    "eventSemantics",
    "edges",
    "excludedScope",
    "schemaEvolutionPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.9.0"
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "applicationOrder": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "eventSemantics": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "excludedScope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schemaEvolutionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "newPublicationMayAdd",
        "previousRecordsMustRevalidate",
        "cannotBeAddedAsUntypedFreeText",
        "ambiguousPublishedEffect"
      ],
      "properties": {
        "newPublicationMayAdd": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "previousRecordsMustRevalidate": {
          "type": "boolean"
        },
        "cannotBeAddedAsUntypedFreeText": {
          "type": "boolean"
        },
        "ambiguousPublishedEffect": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "sourceDefinitionId",
        "sourceDomain",
        "sourceName",
        "sourcePage",
        "targetSelector",
        "event",
        "phase",
        "interactionMode",
        "conditions",
        "operations",
        "resourceChoices",
        "testAssertions"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "sourceDefinitionId": {
          "type": "string",
          "minLength": 1
        },
        "sourceDomain": {
          "enum": [
            "feat",
            "force-secret",
            "force-technique",
            "rule",
            "talent",
            "equipment",
            "unleashed-overlay"
          ]
        },
        "sourceName": {
          "type": "string",
          "minLength": 1
        },
        "sourcePage": {
          "type": "integer",
          "minimum": 1
        },
        "targetSelector": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "domain": {
              "type": "string"
            },
            "definitionIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "targeting": {
              "type": "string"
            },
            "requiredDescriptor": {
              "type": "string"
            },
            "baseActionIn": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "checkSkill": {
              "type": "string"
            },
            "chosenDefinitionId": {
              "type": "string"
            },
            "mustDealDamage": {
              "type": "boolean"
            },
            "numericRangeRequired": {
              "type": "boolean"
            },
            "singleTargetOnly": {
              "type": "boolean"
            },
            "areaShape": {
              "type": "string"
            },
            "checkKinds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "resourceSpendMode": {
              "type": "string"
            },
            "useTheForceSkillApplication": {
              "type": "string"
            },
            "rollFamily": {
              "enum": [
                "pilot",
                "weapon-attack",
                "use-the-force"
              ]
            },
            "excludedDescriptors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "actorRole": {
              "enum": [
                "pilot",
                "pilot-or-gunner"
              ]
            }
          }
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "interactionMode": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/influenceOperation"
          }
        },
        "resourceChoices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "resource",
              "trigger",
              "timing",
              "summary",
              "operations"
            ]
          }
        },
        "testAssertions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
